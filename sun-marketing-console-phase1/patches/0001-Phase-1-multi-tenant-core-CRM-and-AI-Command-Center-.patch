index 0000000..2269fa4
--- /dev/null
+++ b/src/lib/ai/openai.ts
@@ -0,0 +1,69 @@
+import "server-only";
+import { ProviderError, type ChatMessage, type ChatModel, type Completion, type ToolSpec } from "./types";
+
+type WireMessage =
+  | { role: "system" | "user"; content: string }
+  | { role: "assistant"; content: string | null; tool_calls?: { id: string; type: "function"; function: { name: string; arguments: string } }[] }
+  | { role: "tool"; content: string; tool_call_id: string };
+
+export function toWire(messages: ChatMessage[]): WireMessage[] {
+  return messages.map((m) => {
+    if (m.role === "tool") return { role: "tool", content: m.content, tool_call_id: m.toolCallId };
+    if (m.role === "assistant") {
+      return {
+        role: "assistant",
+        content: m.content,
+        ...(m.toolCalls?.length
+          ? { tool_calls: m.toolCalls.map((c) => ({ id: c.id, type: "function" as const, function: { name: c.name, arguments: c.arguments } })) }
+          : {}),
+      };
+    }
+    return { role: m.role, content: m.content };
+  });
+}
+
+// OpenAI Chat Completions adapter with function calling. The API key never
+// leaves the server; errors are reduced to safe, actionable messages.
+export class OpenAIChatModel implements ChatModel {
+  readonly provider = "openai";
+  constructor(private apiKey: string, readonly model: string, private baseUrl = "https://api.openai.com/v1") {}
+
+  async complete({ messages, tools, signal }: { messages: ChatMessage[]; tools: ToolSpec[]; signal?: AbortSignal }): Promise<Completion> {
+    let response: Response;
+    try {
+      response = await fetch(`${this.baseUrl}/chat/completions`, {
+        method: "POST",
+        headers: { Authorization: `Bearer ${this.apiKey}`, "Content-Type": "application/json" },
+        body: JSON.stringify({
+          model: this.model,
+          messages: toWire(messages),
+          ...(tools.length
+            ? { tools: tools.map((t) => ({ type: "function", function: { name: t.name, description: t.description, parameters: t.parameters } })), tool_choice: "auto" }
+            : {}),
+        }),
+        signal: signal ?? AbortSignal.timeout(45_000),
+        cache: "no-store",
+      });
+    } catch {
+      throw new ProviderError("The AI provider could not be reached. Try again in a moment.", true);
+    }
+    const body = await response.json().catch(() => ({}));
+    if (!response.ok) {
+      if (response.status === 401 || response.status === 403) throw new ProviderError("The AI provider rejected the API key. Update it in Settings.");
+      if (response.status === 404) throw new ProviderError(`The AI model "${this.model}" is not available to this API key. Set AI_COMMAND_MODEL to a model your account can use.`);
+      if (response.status === 429) throw new ProviderError("The AI provider is rate limiting requests or the account is out of credit.", true);
+      throw new ProviderError(`The AI provider returned an error (HTTP ${response.status}).`, response.status >= 500);
+    }
+    const message = body?.choices?.[0]?.message;
+    if (!message) throw new ProviderError("The AI provider returned an empty response.", true);
+    return {
+      content: typeof message.content === "string" ? message.content : null,
+      toolCalls: Array.isArray(message.tool_calls)
+        ? message.tool_calls
+            .filter((c: { type?: string }) => c.type === "function")
+            .map((c: { id: string; function: { name: string; arguments: string } }) => ({ id: c.id, name: c.function.name, arguments: c.function.arguments || "{}" }))
+        : [],
+      usage: body.usage ? { inputTokens: body.usage.prompt_tokens ?? 0, outputTokens: body.usage.completion_tokens ?? 0 } : undefined,
+    };
+  }
+}
