+  'timeline activity updates contact last_activity_at');
+select pg_temp.expect_error($$update public.opportunities set stage_id = (select s.id from public.pipeline_stages s
+  where s.organization_id = (select v from ids where k = 'client_a1') limit 1) where id = (select v from ids where k = 'opp_a')$$,
