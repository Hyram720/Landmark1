diff --git a/supabase/migrations/20261006120000_phase1_tenancy_crm_ai.sql b/supabase/migrations/20261006120000_phase1_tenancy_crm_ai.sql
new file mode 100644
index 0000000..ecadd89
--- /dev/null
+++ b/supabase/migrations/20261006120000_phase1_tenancy_crm_ai.sql
@@ -0,0 +1,887 @@
+-- Phase 1: multi-tenant core, RBAC, unified CRM, customer timeline, consent,
+-- AI Command Center (policies, conversations, governed actions) and audit log.
+--
+-- Additive only: no existing table, policy or function is changed.
+--
+-- Trust model for every table in this file:
+--   * Rows belong to exactly one organization (organization_id).
+--   * Requests run as the signed-in Supabase user (role "authenticated");
+--     RLS grants access from public.memberships via auth.uid().
+--   * The legacy x-app-secret header grants NOTHING here.
+--   * service_role (background jobs, verified webhooks) bypasses RLS and must
+--     scope every query by organization_id itself.
+--   * Composite foreign keys (id, organization_id) make cross-tenant links
+--     impossible even for buggy server code.
+begin;
+
+create extension if not exists pgcrypto;
+
+-- ---------------------------------------------------------------- helpers
+create or replace function public.tg_set_updated_at() returns trigger
+language plpgsql set search_path = '' as $$
+begin new.updated_at = now(); return new; end $$;
+
+create or replace function public.role_rank(p_role text) returns integer
+language sql immutable set search_path = '' as $$
+  select case p_role
+    when 'owner' then 5 when 'admin' then 4 when 'manager' then 3
+    when 'member' then 2 when 'viewer' then 1 else 0 end
+$$;
+
+-- ---------------------------------------------------------- organizations
+create table public.organizations (
+  id uuid primary key default gen_random_uuid(),
+  kind text not null check (kind in ('agency', 'client')),
+  parent_id uuid references public.organizations(id) on delete restrict,
+  name text not null check (length(btrim(name)) between 1 and 120),
+  slug text not null unique check (slug ~ '^[a-z0-9][a-z0-9-]{1,62}$'),
+  status text not null default 'active' check (status in ('active', 'suspended', 'closed')),
+  plan text not null default 'internal',
+  branding jsonb not null default '{}'::jsonb check (jsonb_typeof(branding) = 'object'),
+  settings jsonb not null default '{}'::jsonb check (jsonb_typeof(settings) = 'object'),
+  timezone text not null default 'America/New_York',
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  -- Agencies are top level; clients always sit under exactly one agency.
+  check ((kind = 'agency' and parent_id is null) or (kind = 'client' and parent_id is not null))
+);
+create index organizations_parent_idx on public.organizations(parent_id);
+create trigger organizations_updated before update on public.organizations
+  for each row execute function public.tg_set_updated_at();
+
+create table public.locations (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  name text not null check (length(btrim(name)) between 1 and 120),
+  phone text,
+  address jsonb not null default '{}'::jsonb,
+  timezone text,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id)
+);
+create index locations_org_idx on public.locations(organization_id);
+create trigger locations_updated before update on public.locations
+  for each row execute function public.tg_set_updated_at();
+
+create table public.memberships (
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  user_id uuid not null,
+  role text not null check (role in ('owner', 'admin', 'manager', 'member', 'viewer')),
+  status text not null default 'active' check (status in ('active', 'disabled')),
+  display_name text,
+  email text,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  primary key (organization_id, user_id)
+);
+create index memberships_user_idx on public.memberships(user_id) where status = 'active';
+create trigger memberships_updated before update on public.memberships
+  for each row execute function public.tg_set_updated_at();
+
+-- Effective rank of the current user in an organization:
+--   direct membership, or membership in the parent agency (capped at admin:
+--   agency staff manage clients but never own them). Suspended organizations
+--   are read-only (viewer); closed organizations are inaccessible.
+create or replace function public.org_rank(p_org uuid) returns integer
+language plpgsql stable security definer set search_path = '' as $$
+declare
+  v_uid uuid := auth.uid();
+  v_org public.organizations;
+  v_parent_status text;
+  v_rank integer := 0;
+begin
+  if v_uid is null or p_org is null then return 0; end if;
+  select * into v_org from public.organizations where id = p_org;
+  if not found or v_org.status = 'closed' then return 0; end if;
+
+  select coalesce(max(public.role_rank(m.role)), 0) into v_rank
+    from public.memberships m
+   where m.organization_id = p_org and m.user_id = v_uid and m.status = 'active';
+
+  if v_org.parent_id is not null then
+    select status into v_parent_status from public.organizations where id = v_org.parent_id;
+    if v_parent_status = 'closed' then return 0; end if;
+    select greatest(v_rank, coalesce(max(least(public.role_rank(m.role), 4)), 0)) into v_rank
+      from public.memberships m
+     where m.organization_id = v_org.parent_id and m.user_id = v_uid and m.status = 'active';
+    if v_parent_status = 'suspended' then v_rank := least(v_rank, 1); end if;
+  end if;
+
+  if v_org.status = 'suspended' then v_rank := least(v_rank, 1); end if;
+  return v_rank;
+end $$;
+
+create or replace function public.has_org_role(p_org uuid, p_min text) returns boolean
+language sql stable security definer set search_path = '' as $$
+  select public.org_rank(p_org) >= public.role_rank(p_min) and public.role_rank(p_min) > 0
+$$;
+
+-- Who may create, change or remove owners: an owner of the organization, or
+-- an admin of the parent agency (agencies appoint their clients' owners).
+create or replace function public.can_manage_owners(p_org uuid) returns boolean
+language sql stable security definer set search_path = '' as $$
+  select public.org_rank(p_org) >= 5
+      or exists (
+        select 1 from public.organizations o
+         where o.id = p_org and o.parent_id is not null and o.status <> 'closed'
+           and public.org_rank(o.parent_id) >= 4)
+$$;
+
+-- Organizations visible to the current user, with effective role. Used by the
+-- organization switcher.
+create or replace function public.my_organizations()
+returns table (id uuid, name text, kind text, parent_id uuid, status text, role text)
+language sql stable security definer set search_path = '' as $$
+  with ranked as (
+    select o.id, o.name, o.kind, o.parent_id, o.status, public.org_rank(o.id) as r
+      from public.organizations o
+     where o.id in (
+       select m.organization_id from public.memberships m
+        where m.user_id = auth.uid() and m.status = 'active'
+       union
+       select c.id from public.organizations c
+         join public.memberships m on m.organization_id = c.parent_id
+        where m.user_id = auth.uid() and m.status = 'active'
+     )
+  )
+  select id, name, kind, parent_id, status,
+         case r when 5 then 'owner' when 4 then 'admin' when 3 then 'manager'
+                when 2 then 'member' else 'viewer' end
+    from ranked where r > 0
+   order by kind, name
+$$;
+
+-- Role changes made through the Data API are bounded by the caller's own rank:
+-- nobody can grant a role above their own, only owners create or remove
+-- owners, and an organization never loses its last owner. Security-definer
+-- functions and service_role run as other database roles and skip this.
+create or replace function public.tg_memberships_guard() returns trigger
+language plpgsql set search_path = '' as $$
+declare
+  v_org uuid := coalesce(new.organization_id, old.organization_id);
+  v_rank integer;
+begin
+  if current_user not in ('authenticated', 'anon') then
+    return coalesce(new, old);
+  end if;
+  v_rank := public.org_rank(v_org);
+  if tg_op in ('INSERT', 'UPDATE') and public.role_rank(new.role) > v_rank
+     and not (new.role = 'owner' and public.can_manage_owners(v_org)) then
+    raise exception 'You cannot grant a role above your own.' using errcode = '42501';
+  end if;
+  if tg_op in ('UPDATE', 'DELETE') and old.role = 'owner' and not public.can_manage_owners(v_org) then
+    raise exception 'Only an owner can change another owner.' using errcode = '42501';
+  end if;
+  if tg_op = 'UPDATE' and (new.organization_id <> old.organization_id or new.user_id <> old.user_id) then
+    raise exception 'Membership identity cannot change.' using errcode = '42501';
+  end if;
+  if tg_op in ('UPDATE', 'DELETE') and old.role = 'owner'
+     and (tg_op = 'DELETE' or new.role <> 'owner' or new.status <> 'active')
+     and not exists (
+       select 1 from public.memberships m
+        where m.organization_id = old.organization_id and m.role = 'owner'
+          and m.status = 'active' and m.user_id <> old.user_id) then
+    raise exception 'An organization must keep at least one active owner.' using errcode = '42501';
+  end if;
+  return coalesce(new, old);
+end $$;
+create trigger memberships_guard before insert or update or delete on public.memberships
+  for each row execute function public.tg_memberships_guard();
+
+-- --------------------------------------------------------------- audit log
+create table public.audit_log (
+  id bigint generated always as identity primary key,
+  organization_id uuid references public.organizations(id) on delete cascade,
+  actor_type text not null check (actor_type in ('user', 'ai', 'system', 'api')),
+  actor_id uuid,
+  action text not null check (length(action) between 1 and 120),
+  target_type text,
+  target_id text,
+  metadata jsonb not null default '{}'::jsonb,
+  created_at timestamptz not null default now()
+);
+create index audit_log_org_created_idx on public.audit_log(organization_id, created_at desc);
+
+-- Append-only for every API role, including service_role.
+create or replace function public.tg_audit_immutable() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user in ('authenticated', 'anon', 'service_role') then
+    raise exception 'Audit log entries are immutable.' using errcode = '42501';
+  end if;
+  return coalesce(new, old);
+end $$;
+create trigger audit_log_immutable before update or delete on public.audit_log
+  for each row execute function public.tg_audit_immutable();
+
+-- The only path for users to write audit entries: actor_id is always the
+-- caller, and the caller must belong to the organization.
+create or replace function public.log_audit(
+  p_org uuid, p_action text, p_target_type text default null, p_target_id text default null,
+  p_metadata jsonb default '{}'::jsonb, p_actor_type text default 'user'
+) returns bigint
+language plpgsql security definer set search_path = '' as $$
+declare v_id bigint;
+begin
+  if auth.uid() is null or public.org_rank(p_org) < 1 then
+    raise exception 'Not a member of this organization.' using errcode = '42501';
+  end if;
+  if p_actor_type not in ('user', 'ai') then
+    raise exception 'Invalid actor type.' using errcode = '22023';
+  end if;
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, target_type, target_id, metadata)
+  values (p_org, p_actor_type, auth.uid(), left(p_action, 120), left(p_target_type, 60),
+          left(p_target_id, 120), coalesce(p_metadata, '{}'::jsonb))
+  returning id into v_id;
+  return v_id;
+end $$;
+
+-- --------------------------------------------------------------------- CRM
+create table public.companies (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  name text not null check (length(btrim(name)) between 1 and 160),
+  domain text,
+  phone text,
+  email text,
+  industry text,
+  address jsonb not null default '{}'::jsonb,
+  custom_fields jsonb not null default '{}'::jsonb check (jsonb_typeof(custom_fields) = 'object'),
+  legacy_business_id uuid,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  unique (organization_id, legacy_business_id)
+);
+create index companies_org_name_idx on public.companies(organization_id, lower(name));
+create trigger companies_updated before update on public.companies
+  for each row execute function public.tg_set_updated_at();
+
+create table public.contacts (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  company_id uuid,
+  location_id uuid,
+  first_name text check (length(first_name) <= 80),
+  last_name text check (length(last_name) <= 80),
+  email text check (email is null or (length(email) <= 254 and email ~ '^[^@\s]+@[^@\s]+\.[^@\s]+$')),
+  phone text check (phone is null or phone ~ '^\+?[0-9() .-]{7,32}$'),
+  source text,
+  owner_id uuid,
+  lifecycle_stage text not null default 'lead'
+    check (lifecycle_stage in ('lead', 'prospect', 'customer', 'churned', 'other')),
+  lead_score integer not null default 0 check (lead_score between 0 and 100),
+  score_factors jsonb not null default '[]'::jsonb,
+  scored_at timestamptz,
+  tags text[] not null default '{}',
+  custom_fields jsonb not null default '{}'::jsonb check (jsonb_typeof(custom_fields) = 'object'),
+  do_not_contact boolean not null default false,
+  last_activity_at timestamptz,
+  erased_at timestamptz,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  check (coalesce(first_name, last_name, email, phone) is not null or erased_at is not null),
+  foreign key (company_id, organization_id) references public.companies(id, organization_id) on delete set null (company_id),
