+import { z } from "zod";
+import { fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { AI_CATEGORIES, AI_MODES } from "@/lib/command/policy";
+
+export const dynamic = "force-dynamic";
+
+export const GET = tenantRoute("crm.read", async (ctx) => {
+  const { data, error } = await ctx.client.from("ai_policies").select("category, mode, updated_at").eq("organization_id", ctx.org.id);
+  fromDb(error);
+  return { policies: data || [] };
+});
+
+export const PUT = tenantRoute("ai.policies", async (ctx, req) => {
+  const input = await readJson(req, z.object({ category: z.enum(AI_CATEGORIES), mode: z.enum(AI_MODES) }));
+  const { error } = await ctx.client
+    .from("ai_policies")
+    .upsert({ organization_id: ctx.org.id, category: input.category, mode: input.mode, updated_by: ctx.session.user.id });
+  fromDb(error);
+  await audit(ctx.client, ctx.org.id, "ai.policy.changed", { type: "ai_policy", id: input.category }, { mode: input.mode });
+  return { ok: true };
+});
diff --git a/src/app/api/command/route.ts b/src/app/api/command/route.ts
new file mode 100644
index 0000000..09a9f27
--- /dev/null
+++ b/src/app/api/command/route.ts
@@ -0,0 +1,53 @@
+import { z } from "zod";
+import { ApiError, fromDb, readJson, scoped, tenantRoute } from "@/lib/tenant/api";
+import { getChatModel } from "@/lib/ai/provider";
+import { runCommand } from "@/lib/command/engine";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+const RATE_PER_MINUTE = 8;
+
+// GET: conversations list, or one conversation's messages (?conversation=id).
+export const GET = tenantRoute("ai.chat", async (ctx, req) => {
+  const conversation = new URL(req.url).searchParams.get("conversation");
+  if (conversation) {
+    const id = z.string().uuid().parse(conversation);
+    const { data, error } = await ctx.client
+      .from("ai_messages").select("id, role, content, metadata, created_at")
+      .eq("organization_id", ctx.org.id).eq("conversation_id", id).in("role", ["user", "assistant"])
+      .order("created_at").limit(200);
+    fromDb(error);
+    return { messages: data || [] };
+  }
+  const { data, error } = await ctx.client
+    .from("ai_conversations").select("id, title, updated_at")
+    .eq("organization_id", ctx.org.id).eq("user_id", ctx.session.user.id)
+    .order("updated_at", { ascending: false }).limit(30);
+  fromDb(error);
+  return { conversations: data || [] };
+});
+
+const ask = z.object({
+  message: z.string().trim().min(1, "Type a request first.").max(4000, "Keep requests under 4,000 characters."),
+  conversationId: z.string().uuid().optional(),
+});
+
+export const POST = tenantRoute("ai.chat", async (ctx, req) => {
+  const input = await readJson(req, ask);
+  const { model, status } = await getChatModel();
+  if (!model) throw new ApiError(status.configured ? "AI is unavailable." : status.reason, 503, "integration_not_configured");
+
+  // Persistent per-user rate limit (works across serverless instances).
+  const since = new Date(Date.now() - 60_000).toISOString();
+  const { count, error } = await ctx.client
+    .from("ai_messages").select("id", { count: "exact", head: true })
+    .eq("organization_id", ctx.org.id).eq("role", "user").gte("created_at", since);
+  fromDb(error);
+  if ((count ?? 0) >= RATE_PER_MINUTE) throw new ApiError("You're sending requests quickly. Wait a minute and try again.", 429, "rate_limited");
+
+  const result = await runCommand({ ...scoped(ctx), orgName: ctx.org.name, role: ctx.org.role }, model, input.message, input.conversationId);
+  // Keep the conversation list ordered by recent use.
+  await ctx.client.from("ai_conversations").update({ updated_at: new Date().toISOString() }).eq("organization_id", ctx.org.id).eq("id", result.conversationId);
+  return result;
+});
