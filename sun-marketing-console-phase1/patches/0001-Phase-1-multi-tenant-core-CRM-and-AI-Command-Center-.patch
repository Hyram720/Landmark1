@@ -0,0 +1,77 @@
+import "server-only";
+import { cache } from "react";
+import { cookies } from "next/headers";
+import { createClient, SupabaseClient } from "@supabase/supabase-js";
+import { AUTH_COOKIE, ORG_COOKIE } from "@/lib/session-cookies";
+import { isRole, Role } from "./rbac";
+
+export { ORG_COOKIE };
+
+export type SessionUser = { id: string; email: string | null };
+export type UserSession = { user: SessionUser; accessToken: string };
+export type OrgSummary = { id: string; name: string; kind: "agency" | "client"; parent_id: string | null; status: string; role: Role };
+export type TenantContext = {
+  session: UserSession;
+  client: SupabaseClient;
+  orgs: OrgSummary[];
+  org: OrgSummary | null;
+  isPlatformStaff: boolean;
+};
+
+function supabaseConfig() {
+  const url = process.env.SUPABASE_URL;
+  const key = process.env.SUPABASE_KEY;
+  return url && key ? { url, key } : null;
+}
+
+export const authConfigured = () => !!supabaseConfig();
+
+// A Data API client that acts as the signed-in user. Every query runs under
+// that user's RLS policies; it deliberately does not send x-app-secret.
+export function userClient(accessToken: string): SupabaseClient {
+  const config = supabaseConfig();
+  if (!config) throw new Error("Supabase is not configured.");
+  return createClient(config.url, config.key, {
+    auth: { persistSession: false, autoRefreshToken: false },
+    global: { headers: { Authorization: `Bearer ${accessToken}` } },
+  });
+}
+
+async function verifyAccessToken(accessToken: string): Promise<SessionUser | null> {
+  const config = supabaseConfig();
+  if (!config) return null;
+  const response = await fetch(`${config.url}/auth/v1/user`, {
+    headers: { apikey: config.key, Authorization: `Bearer ${accessToken}` },
+    cache: "no-store",
+    signal: AbortSignal.timeout(8000),
+  }).catch(() => null);
+  if (!response?.ok) return null;
+  const user = await response.json().catch(() => null);
+  return user?.id ? { id: String(user.id), email: user.email ? String(user.email) : null } : null;
+}
+
+// The signed-in Supabase user for this request, or null (passcode sessions
+// have no user identity and therefore no tenant access).
+export const getUserSession = cache(async (): Promise<UserSession | null> => {
+  const accessToken = (await cookies()).get(AUTH_COOKIE)?.value;
+  if (!accessToken) return null;
+  const user = await verifyAccessToken(accessToken);
+  return user ? { user, accessToken } : null;
+});
+
+export const getTenantContext = cache(async (): Promise<TenantContext | null> => {
+  const session = await getUserSession();
+  if (!session) return null;
+  const client = userClient(session.accessToken);
+  const [{ data, error }, staff] = await Promise.all([
+    client.rpc("my_organizations"),
+    client.from("team_members").select("active").eq("user_id", session.user.id).maybeSingle(),
+  ]);
+  if (error) throw new Error("Your organizations could not be loaded.");
+  const orgs: OrgSummary[] = (data || [])
+    .filter((row: { role: unknown }) => isRole(row.role))
+    .map((row: OrgSummary) => ({ id: row.id, name: row.name, kind: row.kind, parent_id: row.parent_id, status: row.status, role: row.role }));
+  const preferred = (await cookies()).get(ORG_COOKIE)?.value;
+  const org = orgs.find((o) => o.id === preferred) || orgs[0] || null;
+  return { session, client, orgs, org, isPlatformStaff: !!staff.data?.active };
+});
