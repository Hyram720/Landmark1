@@ -0,0 +1,21 @@
+// Provider-neutral chat model contract. The Command Center engine only uses
+// these types, so adding a provider means adding one adapter file.
+export type ToolCall = { id: string; name: string; arguments: string };
+export type ChatMessage =
+  | { role: "system" | "user"; content: string }
+  | { role: "assistant"; content: string | null; toolCalls?: ToolCall[] }
+  | { role: "tool"; content: string; toolCallId: string };
+export type ToolSpec = { name: string; description: string; parameters: Record<string, unknown> };
+export type Completion = { content: string | null; toolCalls: ToolCall[]; usage?: { inputTokens: number; outputTokens: number } };
+
+export interface ChatModel {
+  readonly provider: string;
+  readonly model: string;
+  complete(request: { messages: ChatMessage[]; tools: ToolSpec[]; signal?: AbortSignal }): Promise<Completion>;
+}
+
+export class ProviderError extends Error {
+  constructor(message: string, public retryable = false) {
+    super(message);
+  }
+}
