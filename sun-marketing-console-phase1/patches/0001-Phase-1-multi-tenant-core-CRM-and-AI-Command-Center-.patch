+/* Shared styles for the multi-tenant modules (Command Center, CRM, Organization). */
+/* The dark theme redefines --text on .shell but text otherwise inherits the
+   light body colour; set it explicitly for these modules. */
+.tenant-ui{color:var(--text);display:flex;flex-direction:column;flex:1;min-width:0}
+.tenant-gate{max-width:560px;margin:40px auto}
+.tenant-gate h2{font-size:18px;margin-bottom:8px}
+.org-switch .select{min-width:180px;padding:6px 10px}
+.form-error{color:var(--bad);background:var(--bad-bg);border:1px solid var(--bad-br);border-radius:8px;padding:9px 12px;font-size:13px}
+.link{color:var(--sun-700);font-weight:620}
+.link:hover{text-decoration:underline}
+.notice{border-radius:var(--radius-sm);padding:11px 14px;font-size:13.5px;border:1px solid var(--line);background:var(--panel-2)}
+.notice-warn{background:var(--warn-bg);border-color:var(--warn-br)}
+.notice-info{background:var(--info-bg);border-color:var(--info-br)}
+.spin-dark{border-color:rgba(0,0,0,.15);border-top-color:var(--sun-600)}
+
+/* Command Center */
+.cc-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr);gap:16px;align-items:start}
+.cc-chat{display:flex;flex-direction:column;min-height:560px;max-height:calc(100vh - 150px)}
+.cc-thread{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px}
+.cc-msg{max-width:88%;padding:10px 14px;border-radius:14px;font-size:14px;line-height:1.55;white-space:pre-wrap;word-break:break-word}
+.cc-msg.user{align-self:flex-end;background:linear-gradient(160deg,var(--sun-500),var(--sun-600));color:#fff;border-bottom-right-radius:4px}
+.cc-msg.assistant{align-self:flex-start;background:var(--panel-2);border:1px solid var(--line);border-bottom-left-radius:4px}
+.cc-compose{border-top:1px solid var(--line);padding:12px;display:flex;gap:10px;align-items:flex-end}
+.cc-compose .textarea{min-height:46px;max-height:180px}
+.cc-suggest{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:14px}
+.cc-suggest button{border:1px solid var(--line);background:var(--panel);border-radius:999px;padding:7px 12px;font-size:12.5px;cursor:pointer;text-align:left}
+.cc-suggest button:hover{border-color:var(--sun-400);background:var(--sun-50,#fff7ed)}
+.cc-hero{margin:auto;text-align:center;max-width:520px;padding:30px 10px}
+.cc-hero h2{font-size:20px;margin-bottom:6px}
+.action-card{border:1px solid var(--line);border-radius:var(--radius-sm);padding:11px 12px;display:flex;flex-direction:column;gap:7px;background:var(--panel)}
+.action-card .meta{display:flex;gap:6px;align-items:center;flex-wrap:wrap;font-size:11.5px;color:var(--text-3)}
+.inline-actions{display:flex;gap:6px;flex-wrap:wrap}
+.policy-row{display:grid;grid-template-columns:minmax(0,1fr) 170px;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
+.policy-row:last-child{border-bottom:0}
+
+/* CRM */
+.crm-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
