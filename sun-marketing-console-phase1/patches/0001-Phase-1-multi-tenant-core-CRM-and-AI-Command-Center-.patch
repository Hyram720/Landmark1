diff --git a/tests/support/fake-supabase.ts b/tests/support/fake-supabase.ts
new file mode 100644
index 0000000..bd5997a
--- /dev/null
+++ b/tests/support/fake-supabase.ts
@@ -0,0 +1,126 @@
+// In-memory stand-in for the subset of the supabase-js query builder used by
+// the CRM service and Command Center. It does not emulate RLS; database
+// security is covered by supabase/tests/*.test.sql against real PostgreSQL.
+import { randomUUID } from "node:crypto";
+
+type Row = Record<string, unknown>;
+type Filter = (row: Row) => boolean;
+
+export class FakeDb {
+  tables: Record<string, Row[]> = {};
+  rpcCalls: { name: string; args: unknown }[] = [];
+  // Optional hook to emulate database triggers or failures.
+  onInsert?: (table: string, row: Row) => Row | Error;
+
+  table(name: string) {
+    return (this.tables[name] ||= []);
+  }
+
+  from(name: string) {
+    return new Query(this, name);
+  }
+
+  async rpc(name: string, args: unknown) {
+    this.rpcCalls.push({ name, args });
+    return { data: null, error: null };
+  }
+}
+
+class Query implements PromiseLike<{ data: unknown; error: unknown; count?: number }> {
+  private filters: Filter[] = [];
+  private op: "select" | "insert" | "update" = "select";
+  private payload: Row | Row[] | null = null;
+  private limitN: number | null = null;
+  private mode: "many" | "single" | "maybe" = "many";
+  private head = false;
+
+  constructor(private db: FakeDb, private name: string) {}
+
+  select(_cols?: string, opts?: { count?: string; head?: boolean }) {
+    if (opts?.head) this.head = true;
+    return this;
+  }
+  insert(rows: Row | Row[]) {
+    this.op = "insert";
+    this.payload = rows;
+    return this;
+  }
+  update(patch: Row) {
+    this.op = "update";
+    this.payload = patch;
+    return this;
+  }
+  eq(col: string, val: unknown) {
+    this.filters.push((r) => r[col] === val);
+    return this;
+  }
+  in(col: string, vals: unknown[]) {
+    this.filters.push((r) => vals.includes(r[col]));
+    return this;
+  }
+  is(col: string, val: unknown) {
+    this.filters.push((r) => (r[col] ?? null) === val);
+    return this;
+  }
+  gte(col: string, val: string) {
+    this.filters.push((r) => String(r[col] ?? "") >= val);
+    return this;
+  }
+  ilike(col: string, val: string) {
+    this.filters.push((r) => String(r[col] ?? "").toLowerCase() === val.toLowerCase());
+    return this;
+  }
+  or() {
+    return this;
+  }
+  order() {
+    return this;
+  }
+  range(from: number, to: number) {
+    this.limitN = to - from + 1;
+    return this;
+  }
+  limit(n: number) {
+    this.limitN = n;
+    return this;
+  }
+  single() {
+    this.mode = "single";
+    return this;
+  }
+  maybeSingle() {
+    this.mode = "maybe";
+    return this;
+  }
+
+  private run() {
+    const table = this.db.table(this.name);
+    let rows: Row[];
+    if (this.op === "insert") {
+      rows = [];
+      for (const input of Array.isArray(this.payload) ? this.payload : [this.payload!]) {
+        const base: Row = { id: randomUUID(), created_at: new Date().toISOString(), ...input };
+        const hooked = this.db.onInsert ? this.db.onInsert(this.name, base) : base;
+        if (hooked instanceof Error) return { data: null, error: { code: "42501", message: hooked.message } };
+        table.push(hooked);
+        rows.push(hooked);
+      }
+    } else {
+      rows = table.filter((r) => this.filters.every((f) => f(r)));
+      if (this.op === "update") for (const r of rows) Object.assign(r, this.payload);
+    }
+    if (this.limitN !== null) rows = rows.slice(0, this.limitN);
+    const count = rows.length;
+    if (this.head) return { data: null, error: null, count };
+    if (this.mode === "single") return rows.length === 1 ? { data: { ...rows[0] }, error: null } : { data: null, error: { code: "PGRST116", message: "not single" } };
+    if (this.mode === "maybe") return { data: rows[0] ? { ...rows[0] } : null, error: null };
+    return { data: rows.map((r) => ({ ...r })), error: null, count };
+  }
+
+  then<T1 = { data: unknown; error: unknown; count?: number }, T2 = never>(
+    onfulfilled?: ((value: { data: unknown; error: unknown; count?: number }) => T1 | PromiseLike<T1>) | null,
+    onrejected?: ((reason: unknown) => T2 | PromiseLike<T2>) | null,
+  ): PromiseLike<T1 | T2> {
+    return Promise.resolve(this.run()).then(onfulfilled, onrejected);
+  }
+}
