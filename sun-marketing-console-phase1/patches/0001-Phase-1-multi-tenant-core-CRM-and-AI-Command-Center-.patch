+    for (const s of data?.stages || []) map.set(s.id, []);
+    for (const d of data?.opportunities || []) map.get(d.stage_id)?.push(d);
+    return map;
+  }, [data]);
+
+  async function move(dealId: string, stageId: string) {
+    if (!data) return;
+    const deal = data.opportunities.find((d) => d.id === dealId);
+    if (!deal || deal.stage_id === stageId) return;
+    const previous = data;
+    setData({ ...data, opportunities: data.opportunities.map((d) => (d.id === dealId ? { ...d, stage_id: stageId, stage_entered_at: new Date().toISOString() } : d)) });
+    try {
+      const r = await api<{ stage_name: string }>(`/api/crm/opportunities/${dealId}`, { method: "PATCH", body: { stage_id: stageId } });
+      toast(`Moved to ${r.stage_name}.`);
+    } catch (e) {
+      setData(previous);
+      toast(e instanceof Error ? e.message : "Could not move the deal.");
+    }
+  }
+
+  if (loading && !data) return <div className="card"><Loading /></div>;
+  if (error) return <div className="card"><ErrorState message={error} onRetry={reload} /></div>;
+  if (!data) return null;
+  const open = data.opportunities.filter((d) => d.status === "open");
+
+  return (
+    <>
+      <div className="crm-toolbar">
