+-- The permission ladder is enforced in the database, not just the UI:
+--   observe   -> writes are recorded as blocked
+--   recommend -> recorded as recommendations; never executed
+--   approve   -> pending until a manager approves
+--   auto      -> may be inserted pre-approved and executed immediately
+-- Execution happens with the deciding human's own RLS rights, so an AI action
+-- can never exceed the permissions of the person accountable for it.
+create or replace function public.tg_ai_actions_guard() returns trigger
+language plpgsql set search_path = '' as $$
+declare v_mode text; v_rank integer;
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  v_rank := public.org_rank(new.organization_id);
+
+  if tg_op = 'INSERT' then
+    select mode into v_mode from public.ai_policies
+     where organization_id = new.organization_id and category = new.category;
+    v_mode := coalesce(v_mode, 'recommend');
+    if new.policy_mode <> v_mode then
+      raise exception 'Policy mode does not match the organization policy.' using errcode = '42501';
+    end if;
+    if new.requested_by <> auth.uid() then
+      raise exception 'Actions are requested on behalf of the signed-in user only.' using errcode = '42501';
+    end if;
+    if not (
+      (v_mode = 'observe' and new.status = 'blocked') or
+      (v_mode = 'recommend' and new.status = 'recommended') or
+      (v_mode = 'approve' and new.status = 'pending_approval') or
+      (v_mode = 'auto' and new.status = 'approved')
+    ) then
+      raise exception 'Status % is not allowed under policy %.', new.status, v_mode using errcode = '42501';
+    end if;
+    if new.status = 'approved' then
+      new.decided_by := auth.uid(); new.decided_at := now();
+    else
+      new.decided_by := null; new.decided_at := null;
+    end if;
+    new.result := null; new.error := null; new.executed_at := null;
+    return new;
+  end if;
+
+  -- UPDATE: identity and payload are immutable.
+  if new.organization_id <> old.organization_id or new.tool <> old.tool or new.category <> old.category
+     or new.input <> old.input or new.requested_by <> old.requested_by
+     or new.policy_mode <> old.policy_mode or new.created_at <> old.created_at then
+    raise exception 'AI action payload is immutable.' using errcode = '42501';
+  end if;
+  if new.status = old.status then
+    if new.result is distinct from old.result or new.error is distinct from old.error then
+      raise exception 'Results are recorded only with a status change.' using errcode = '42501';
+    end if;
+    return new;
+  end if;
+  if old.status = 'pending_approval' and new.status in ('approved', 'rejected') then
+    if v_rank < public.role_rank('manager') then
+      raise exception 'Only a manager or above can decide AI actions.' using errcode = '42501';
+    end if;
+    new.decided_by := auth.uid(); new.decided_at := now();
+  elsif old.status = 'recommended' and new.status = 'rejected' then
+    new.decided_by := auth.uid(); new.decided_at := now();
+  elsif old.status = 'approved' and new.status in ('executed', 'failed') then
+    if old.decided_by <> auth.uid() then
+      raise exception 'Only the approver executes an approved action.' using errcode = '42501';
+    end if;
+    new.executed_at := now();
+  else
+    raise exception 'Invalid AI action transition % -> %.', old.status, new.status using errcode = '42501';
+  end if;
+  return new;
+end $$;
+create trigger ai_actions_guard before insert or update on public.ai_actions
+  for each row execute function public.tg_ai_actions_guard();
+
+-- ------------------------------------------------------------ provisioning
+create or replace function public.seed_organization_defaults(p_org uuid) returns void
+language plpgsql security definer set search_path = '' as $$
+declare v_pipeline uuid;
+begin
+  insert into public.pipelines(organization_id, name, is_default)
+  values (p_org, 'Sales pipeline', true) returning id into v_pipeline;
+  insert into public.pipeline_stages(organization_id, pipeline_id, name, position, probability, kind) values
+    (p_org, v_pipeline, 'New lead', 1, 10, 'open'),
+    (p_org, v_pipeline, 'Contacted', 2, 20, 'open'),
+    (p_org, v_pipeline, 'Qualified', 3, 40, 'open'),
+    (p_org, v_pipeline, 'Appointment set', 4, 60, 'open'),
+    (p_org, v_pipeline, 'Proposal sent', 5, 75, 'open'),
+    (p_org, v_pipeline, 'Won', 6, 100, 'won'),
+    (p_org, v_pipeline, 'Lost', 7, 0, 'lost');
+  -- Conservative defaults: the AI may prepare CRM changes for approval and
+  -- only recommends anything that reaches customers or money.
+  insert into public.ai_policies(organization_id, category, mode) values
+    (p_org, 'crm', 'approve'), (p_org, 'pipeline', 'approve'), (p_org, 'tasks', 'approve'),
+    (p_org, 'messaging', 'recommend'), (p_org, 'campaigns', 'recommend'),
+    (p_org, 'workflows', 'recommend'), (p_org, 'reputation', 'recommend'),
+    (p_org, 'billing', 'observe');
+end $$;
+
+-- Agencies are created by platform staff (an active row in team_members).
+-- Client sub-accounts are created by agency admins.
+create or replace function public.create_organization(p_name text, p_kind text, p_parent uuid default null)
+returns uuid
+language plpgsql security definer set search_path = '' as $$
+declare
+  v_uid uuid := auth.uid();
+  v_id uuid;
+  v_name text := btrim(coalesce(p_name, ''));
+  v_slug text;
+begin
+  if v_uid is null then raise exception 'Sign in first.' using errcode = '42501'; end if;
+  if length(v_name) not between 2 and 120 then raise exception 'Organization name must be 2-120 characters.' using errcode = '22023'; end if;
+  if p_kind = 'agency' then
+    if p_parent is not null then raise exception 'Agencies are top-level.' using errcode = '22023'; end if;
+    if not exists (select 1 from public.team_members t where t.user_id = v_uid and t.active) then
+      raise exception 'Only platform staff can create agencies.' using errcode = '42501';
+    end if;
+  elsif p_kind = 'client' then
+    if not exists (select 1 from public.organizations o where o.id = p_parent and o.kind = 'agency' and o.status = 'active')
+       or public.org_rank(p_parent) < 4 then
+      raise exception 'Only agency admins can create client accounts.' using errcode = '42501';
+    end if;
+  else
+    raise exception 'Unknown organization kind.' using errcode = '22023';
+  end if;
+
+  v_slug := trim(both '-' from left(regexp_replace(lower(v_name), '[^a-z0-9]+', '-', 'g'), 40));
+  if length(v_slug) < 2 then v_slug := 'org'; end if;
+  v_slug := v_slug || '-' || substr(encode(extensions.gen_random_bytes(4), 'hex'), 1, 6);
+
+  insert into public.organizations(kind, parent_id, name, slug, created_by)
+  values (p_kind, p_parent, v_name, v_slug, v_uid) returning id into v_id;
+  if p_kind = 'agency' then
+    insert into public.memberships(organization_id, user_id, role)
+    values (v_id, v_uid, 'owner');
+  end if;
+  perform public.seed_organization_defaults(v_id);
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, target_type, target_id, metadata)
+  values (v_id, 'user', v_uid, 'organization.created', 'organization', v_id::text,
+          jsonb_build_object('kind', p_kind, 'parent_id', p_parent));
+  return v_id;
+end $$;
+
+-- Adds an existing Supabase Auth user to an organization by email.
+create or replace function public.add_member_by_email(p_org uuid, p_email text, p_role text)
+returns uuid
+language plpgsql security definer set search_path = '' as $$
+declare v_rank integer := public.org_rank(p_org); v_user uuid;
+begin
+  if v_rank < 4 then raise exception 'Only admins can add members.' using errcode = '42501'; end if;
+  if public.role_rank(p_role) = 0 then raise exception 'Unknown role.' using errcode = '22023'; end if;
+  if public.role_rank(p_role) > v_rank and not (p_role = 'owner' and public.can_manage_owners(p_org)) then raise exception 'You cannot grant a role above your own.' using errcode = '42501'; end if;
+  select id into v_user from auth.users where lower(email) = lower(btrim(p_email)) limit 1;
+  if v_user is null then
+    raise exception 'No account exists for that email. Ask them to sign up first.' using errcode = 'P0002';
+  end if;
+  insert into public.memberships(organization_id, user_id, role, email)
+  values (p_org, v_user, p_role, lower(btrim(p_email)))
+  on conflict (organization_id, user_id) do update set role = excluded.role, status = 'active', email = excluded.email
+  where public.memberships.role <> 'owner';
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, target_type, target_id, metadata)
+  values (p_org, 'user', auth.uid(), 'membership.added', 'user', v_user::text, jsonb_build_object('role', p_role));
+  return v_user;
+end $$;
+
+-- Right to erasure: removes personal data while keeping a tamper-evident trace.
+create or replace function public.erase_contact(p_contact uuid) returns void
+language plpgsql security definer set search_path = '' as $$
+declare v_org uuid;
+begin
+  select organization_id into v_org from public.contacts where id = p_contact;
+  if v_org is null or public.org_rank(v_org) < 4 then
+    raise exception 'Only admins can erase contacts.' using errcode = '42501';
+  end if;
+  update public.contacts set first_name = null, last_name = null, email = null, phone = null,
+         tags = '{}', custom_fields = '{}'::jsonb, score_factors = '[]'::jsonb, lead_score = 0,
+         do_not_contact = true, erased_at = now()
+   where id = p_contact;
+  update public.activities set subject = '[erased]', body = null, metadata = '{}'::jsonb where contact_id = p_contact;
+  insert into public.consents(organization_id, contact_id, channel, status, source, captured_by)
+  select v_org, p_contact, c, 'revoked', 'erasure request', auth.uid() from unnest(array['sms','email','voice','whatsapp']) c;
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, target_type, target_id)
+  values (v_org, 'user', auth.uid(), 'contact.erased', 'contact', p_contact::text);
+end $$;
+
+-- Copies the legacy single-tenant prospect list (public.businesses) into an
+-- organization's CRM. Idempotent; only platform staff who administer the
+-- target organization may run it.
+create or replace function public.import_legacy_businesses(p_org uuid) returns integer
+language plpgsql security definer set search_path = '' as $$
+declare v_count integer;
+begin
+  if public.org_rank(p_org) < 4
+     or not exists (select 1 from public.team_members t where t.user_id = auth.uid() and t.active) then
+    raise exception 'Only platform staff with admin access can import legacy prospects.' using errcode = '42501';
+  end if;
+  with inserted as (
+    insert into public.companies(organization_id, name, domain, phone, email, industry, address, legacy_business_id, created_by)
+    select p_org, left(b.name, 160),
+           nullif(regexp_replace(lower(coalesce(b.website, '')), '^https?://(www\.)?([^/]+).*$', '\2'), ''),
+           b.phone, b.email, b.industry,
+           jsonb_strip_nulls(jsonb_build_object('street', b.address, 'city', b.city, 'state', b.state)),
+           b.id, auth.uid()
+      from public.businesses b
+     where length(btrim(coalesce(b.name, ''))) > 0
+    on conflict (organization_id, legacy_business_id) do nothing
+    returning id, legacy_business_id
+  ), people as (
+    insert into public.contacts(organization_id, company_id, first_name, last_name, email, phone, source, lifecycle_stage, created_by)
+    select p_org, i.id,
+           nullif(split_part(btrim(b.contact_name), ' ', 1), ''),
+           nullif(btrim(substr(btrim(b.contact_name), length(split_part(btrim(b.contact_name), ' ', 1)) + 1)), ''),
+           case when b.email ~ '^[^@\s]+@[^@\s]+\.[^@\s]+$' then lower(b.email) end,
+           case when b.phone ~ '^\+?[0-9() .-]{7,32}$' then b.phone end,
+           coalesce(b.source, 'Legacy import'),
+           case when b.status in ('client', 'won') then 'customer' else 'prospect' end,
+           auth.uid()
+      from inserted i join public.businesses b on b.id = i.legacy_business_id
+     where coalesce(nullif(btrim(b.contact_name), ''),
+                    case when b.email ~ '^[^@\s]+@[^@\s]+\.[^@\s]+$' then b.email end,
+                    case when b.phone ~ '^\+?[0-9() .-]{7,32}$' then b.phone end) is not null
+    returning 1
+  )
+  select count(*) into v_count from inserted;
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, metadata)
+  values (p_org, 'user', auth.uid(), 'crm.legacy_import', jsonb_build_object('companies', v_count));
+  return v_count;
+end $$;
+
+-- ---------------------------------------------------------------- RLS
+alter table public.organizations enable row level security;
+alter table public.locations enable row level security;
+alter table public.memberships enable row level security;
+alter table public.audit_log enable row level security;
+alter table public.companies enable row level security;
+alter table public.contacts enable row level security;
+alter table public.custom_field_definitions enable row level security;
+alter table public.consents enable row level security;
+alter table public.pipelines enable row level security;
+alter table public.pipeline_stages enable row level security;
+alter table public.opportunities enable row level security;
+alter table public.tasks enable row level security;
+alter table public.activities enable row level security;
+alter table public.ai_policies enable row level security;
+alter table public.ai_conversations enable row level security;
+alter table public.ai_messages enable row level security;
+alter table public.ai_actions enable row level security;
+
+create policy organizations_read on public.organizations for select to authenticated
+  using (public.org_rank(id) >= 1);
+create policy organizations_update on public.organizations for update to authenticated
+  using (public.org_rank(id) >= 4) with check (public.org_rank(id) >= 4);
+
+create policy memberships_read on public.memberships for select to authenticated
+  using (user_id = auth.uid() or public.org_rank(organization_id) >= 1);
+create policy memberships_write on public.memberships for all to authenticated
+  using (public.org_rank(organization_id) >= 4) with check (public.org_rank(organization_id) >= 4);
+
+create policy audit_log_read on public.audit_log for select to authenticated
+  using (public.org_rank(organization_id) >= 3);
+
+create policy ai_policies_read on public.ai_policies for select to authenticated
+  using (public.org_rank(organization_id) >= 1);
+create policy ai_policies_write on public.ai_policies for all to authenticated
+  using (public.org_rank(organization_id) >= 4) with check (public.org_rank(organization_id) >= 4);
+
+create policy custom_fields_read on public.custom_field_definitions for select to authenticated
+  using (public.org_rank(organization_id) >= 1);
+create policy custom_fields_write on public.custom_field_definitions for all to authenticated
+  using (public.org_rank(organization_id) >= 4) with check (public.org_rank(organization_id) >= 4);
+
+create policy pipelines_read on public.pipelines for select to authenticated
+  using (public.org_rank(organization_id) >= 1);
+create policy pipelines_write on public.pipelines for all to authenticated
+  using (public.org_rank(organization_id) >= 4) with check (public.org_rank(organization_id) >= 4);
+create policy pipeline_stages_read on public.pipeline_stages for select to authenticated
+  using (public.org_rank(organization_id) >= 1);
+create policy pipeline_stages_write on public.pipeline_stages for all to authenticated
+  using (public.org_rank(organization_id) >= 4) with check (public.org_rank(organization_id) >= 4);
+
+-- Conversations are private to the person who had them.
+create policy ai_conversations_own on public.ai_conversations for all to authenticated
+  using (user_id = auth.uid() and public.org_rank(organization_id) >= 1)
+  with check (user_id = auth.uid() and public.org_rank(organization_id) >= 1);
+create policy ai_messages_own on public.ai_messages for all to authenticated
+  using (exists (select 1 from public.ai_conversations c where c.id = conversation_id and c.user_id = auth.uid())
+         and public.org_rank(organization_id) >= 1)
+  with check (exists (select 1 from public.ai_conversations c where c.id = conversation_id and c.user_id = auth.uid())
+              and public.org_rank(organization_id) >= 2);
+
+create policy ai_actions_read on public.ai_actions for select to authenticated
+  using (public.org_rank(organization_id) >= 1);
+create policy ai_actions_insert on public.ai_actions for insert to authenticated
+  with check (public.org_rank(organization_id) >= 2);
+create policy ai_actions_update on public.ai_actions for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+
+-- Standard record tables: viewers read, members create and edit, managers delete.
+do $$
+declare t text;
+begin
+  foreach t in array array['locations', 'companies', 'contacts', 'consents', 'opportunities', 'tasks', 'activities'] loop
+    execute format('create policy %1$s_read on public.%1$I for select to authenticated using (public.org_rank(organization_id) >= 1)', t);
+    execute format('create policy %1$s_insert on public.%1$I for insert to authenticated with check (public.org_rank(organization_id) >= 2)', t);
+    execute format('create policy %1$s_update on public.%1$I for update to authenticated using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2)', t);
+    execute format('create policy %1$s_delete on public.%1$I for delete to authenticated using (public.org_rank(organization_id) >= 3)', t);
+  end loop;
+end $$;
+
+-- Consent history is append-only for API users.
+drop policy consents_update on public.consents;
+drop policy consents_delete on public.consents;
+
+-- ------------------------------------------------------------- privileges
+do $$
+declare t text;
+begin
+  foreach t in array array['organizations', 'locations', 'memberships', 'audit_log', 'companies', 'contacts',
+                           'custom_field_definitions', 'consents', 'pipelines', 'pipeline_stages', 'opportunities',
+                           'tasks', 'activities', 'ai_policies', 'ai_conversations', 'ai_messages', 'ai_actions'] loop
+    execute format('revoke all on public.%I from anon, authenticated', t);
+    execute format('grant select, insert, update, delete on public.%I to authenticated', t);
+    execute format('grant all on public.%I to service_role', t);
+  end loop;
+end $$;
+revoke insert, update, delete on public.audit_log from authenticated;
+revoke insert on public.organizations from authenticated;
+
+revoke execute on function
+  public.role_rank(text), public.org_rank(uuid), public.has_org_role(uuid, text), public.can_manage_owners(uuid), public.my_organizations(),
+  public.log_audit(uuid, text, text, text, jsonb, text), public.seed_organization_defaults(uuid),
+  public.create_organization(text, text, uuid), public.add_member_by_email(uuid, text, text),
+  public.erase_contact(uuid), public.import_legacy_businesses(uuid)
+from public, anon;
+grant execute on function
+  public.role_rank(text), public.org_rank(uuid), public.has_org_role(uuid, text), public.can_manage_owners(uuid), public.my_organizations(),
+  public.log_audit(uuid, text, text, text, jsonb, text), public.create_organization(text, text, uuid),
+  public.add_member_by_email(uuid, text, text), public.erase_contact(uuid), public.import_legacy_businesses(uuid)
+to authenticated;
+-- Internal only: callable by other security-definer functions and service_role.
+revoke execute on function public.seed_organization_defaults(uuid) from authenticated;
+
+commit;
diff --git a/supabase/tests/phase1_rls.test.sql b/supabase/tests/phase1_rls.test.sql
