diff --git a/scripts/test-db.sh b/scripts/test-db.sh
new file mode 100755
index 0000000..34ff249
--- /dev/null
+++ b/scripts/test-db.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+# Applies every migration to a throwaway local PostgreSQL (with a Supabase
+# stand-in) and runs the SQL security tests. Requires PostgreSQL 15+ binaries.
+#   npm run test:db
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+PGBIN="${PGBIN:-$(ls -d /usr/lib/postgresql/*/bin 2>/dev/null | sort -V | tail -1)}"
+[ -x "$PGBIN/initdb" ] || { echo "PostgreSQL binaries not found; set PGBIN." >&2; exit 2; }
+WORK="$(mktemp -d)"
+PORT="${PGPORT_TEST:-54329}"
+RUN=()
+if [ "$(id -u)" = 0 ]; then chown -R postgres "$WORK"; RUN=(runuser -u postgres --); fi
+cleanup() { "${RUN[@]}" "$PGBIN/pg_ctl" -D "$WORK/data" -m immediate stop >/dev/null 2>&1 || true; rm -rf "$WORK"; }
+trap cleanup EXIT
+"${RUN[@]}" "$PGBIN/initdb" -D "$WORK/data" -U postgres -A trust >/dev/null
+"${RUN[@]}" "$PGBIN/pg_ctl" -D "$WORK/data" -o "-p $PORT -k $WORK -c listen_addresses=''" -l "$WORK/log" -w start >/dev/null
+PSQL=("${RUN[@]}" "$PGBIN/psql" -X -q -v ON_ERROR_STOP=1 -h "$WORK" -p "$PORT" -U postgres -d postgres)
+"${PSQL[@]}" -f "$ROOT/supabase/tests/supabase_stub.sql"
+# Only migrations whose prerequisites exist in the stand-in are applied.
+for m in "$ROOT"/supabase/migrations/2026100*.sql; do
+  echo "applying $(basename "$m")"
+  "${PSQL[@]}" -f "$m"
+done
+for t in "$ROOT"/supabase/tests/*.test.sql; do
+  echo "running $(basename "$t")"
+  "${PSQL[@]}" -f "$t" 2>&1 >/dev/null | sed "s/^psql:[^ ]*: NOTICE:  /  /"
+done
