+-- 3. CRM tenant isolation -------------------------------------------------
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000a');
+with x as (insert into public.companies(organization_id, name)
+  values ((select v from ids where k = 'agency_a'), 'Acme Co') returning id) insert into ids select 'company_a', id from x;
+with x as (insert into public.contacts(organization_id, company_id, first_name, email)
+  values ((select v from ids where k = 'agency_a'), (select v from ids where k = 'company_a'), 'Ada', 'ada@acme.test') returning id) insert into ids select 'contact_a', id from x;
+select pg_temp.expect_error($$insert into public.contacts(organization_id, first_name) values ((select v from ids where k = 'agency_b'), 'Intruder')$$,
+  'cannot insert into another tenant');
+select pg_temp.reset_user();
+
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000b');
+select pg_temp.expect((select count(*) = 0 from public.contacts), 'agency B cannot read agency A contacts');
