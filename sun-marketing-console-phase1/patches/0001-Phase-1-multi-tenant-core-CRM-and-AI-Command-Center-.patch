@@ -0,0 +1,13 @@
+import { z } from "zod";
+import { ApiError, readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { decideAction } from "@/lib/command/actions";
+import { can } from "@/lib/tenant/rbac";
+
+export const dynamic = "force-dynamic";
+
+// Approving requires a manager; anyone who can chat may dismiss a recommendation.
+export const POST = tenantRoute<{ id: string }>("ai.chat", async (ctx, req, { id }) => {
+  const { decision } = await readJson(req, z.object({ decision: z.enum(["approve", "reject"]) }));
+  if (decision === "approve" && !can(ctx.org.role, "ai.decide")) throw new ApiError("Only managers and above can approve AI actions.", 403, "forbidden");
+  return { action: await decideAction(scoped(ctx), uuid.parse(id), decision) };
+});
