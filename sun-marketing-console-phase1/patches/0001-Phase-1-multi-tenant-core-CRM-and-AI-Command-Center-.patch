index 0000000..bfa9b93
--- /dev/null
+++ b/src/components/tenant/TenantGate.tsx
@@ -0,0 +1,155 @@
+"use client";
+import Link from "next/link";
+import { useState } from "react";
+import { api, Org, TenantInfo, useResource } from "./client";
+import "./tenant.css";
+
+type Ready = Extract<TenantInfo, { signedIn: true }> & { org: Org };
+
+export function PageHeader({ title, subtitle, actions }: { title: string; subtitle?: string; actions?: React.ReactNode }) {
+  return (
+    <div className="topbar">
+      <div style={{ flex: 1, minWidth: 0 }}>
+        <h1>{title}</h1>
+        {subtitle && <div className="tiny muted">{subtitle}</div>}
+      </div>
+      {actions}
+    </div>
+  );
+}
+
+export function Loading({ label = "Loading…" }: { label?: string }) {
+  return (
+    <div className="empty" role="status" aria-live="polite">
+      <span className="spin spin-dark" /> <span className="small" style={{ marginLeft: 8 }}>{label}</span>
+    </div>
+  );
+}
+
+export function ErrorState({ message, onRetry }: { message: string; onRetry?: () => void }) {
+  return (
+    <div className="empty" role="alert">
+      <h3>Something went wrong</h3>
+      <p className="small">{message}</p>
+      {onRetry && <button className="btn btn-sm" style={{ marginTop: 12 }} onClick={onRetry}>Try again</button>}
+    </div>
+  );
+}
+
+function OrgSwitcher({ info }: { info: Ready }) {
+  const [busy, setBusy] = useState(false);
+  if (info.orgs.length < 2) return <span className="pill pill-neutral" title="Active organization">{info.org.name}</span>;
+  return (
+    <label className="org-switch">
+      <span className="sr-only">Active organization</span>
+      <select
+        className="select"
+        value={info.org.id}
+        disabled={busy}
+        onChange={async (e) => {
+          setBusy(true);
+          try {
+            await api("/api/tenant", { body: { action: "switch", orgId: e.target.value } });
+            window.location.reload();
+          } catch {
+            setBusy(false);
+          }
+        }}
+      >
+        {info.orgs.map((o) => (
+          <option key={o.id} value={o.id}>{o.kind === "client" ? "↳ " : ""}{o.name}</option>
+        ))}
+      </select>
+    </label>
+  );
+}
+
+function CreateFirstOrganization({ staff }: { staff: boolean }) {
+  const [name, setName] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  if (!staff) {
+    return (
+      <div className="card card-pad tenant-gate">
+        <h2>No organization yet</h2>
+        <p className="muted small">Your account is not a member of any organization. Ask your agency or account owner to add you, then sign in again.</p>
+      </div>
+    );
+  }
+  return (
+    <form
+      className="card card-pad tenant-gate stack"
+      onSubmit={async (e) => {
+        e.preventDefault();
+        setBusy(true);
+        setError("");
+        try {
+          await api("/api/tenant", { body: { action: "create", kind: "agency", name } });
+          window.location.reload();
+        } catch (err) {
+          setError(err instanceof Error ? err.message : "Could not create the organization.");
+          setBusy(false);
+        }
+      }}
+    >
+      <h2>Create your agency workspace</h2>
+      <p className="muted small">This creates a private, isolated workspace with a sales pipeline and conservative AI permissions. You can add client accounts and teammates afterwards.</p>
+      <div className="field">
+        <label htmlFor="org-name">Agency name</label>
+        <input id="org-name" className="input" value={name} onChange={(e) => setName(e.target.value)} placeholder="Sun Marketing" required minLength={2} maxLength={120} />
+      </div>
+      {error && <p className="form-error" role="alert">{error}</p>}
+      <button className="btn btn-primary" disabled={busy || name.trim().length < 2}>{busy ? <span className="spin" /> : "Create workspace"}</button>
+    </form>
+  );
+}
+
+// Renders children only for a signed-in user with an active organization,
+// and explains every other state instead of showing an empty screen.
+export default function TenantGate({ title, subtitle, actions, children }: { title: string; subtitle?: string; actions?: (info: Ready) => React.ReactNode; children: (info: Ready) => React.ReactNode }) {
+  const { data, error, loading, reload } = useResource<TenantInfo>("/api/tenant");
+  const ready = data?.signedIn && data.org ? (data as Ready) : null;
+  return (
+    <div className="tenant-ui">
+      <PageHeader
+        title={title}
+        subtitle={subtitle}
+        actions={ready ? <div className="row">{actions?.(ready)}<OrgSwitcher info={ready} /></div> : undefined}
+      />
+      <div className="page page-wide">
+        {loading && !data ? (
+          <Loading />
+        ) : error ? (
+          <ErrorState message={error} onRetry={reload} />
+        ) : !data?.signedIn ? (
+          <div className="card card-pad tenant-gate">
+            <h2>Sign in with a team account</h2>
+            <p className="muted small">
+              This module keeps every business's data isolated, so it needs a personal team login rather than the shared owner passcode.
+              Each action is recorded under your name.
+            </p>
+            <div className="row" style={{ marginTop: 14 }}>
+              <button className="btn btn-primary" onClick={async () => { await fetch("/api/logout", { method: "POST" }); window.location.href = `/login?next=${encodeURIComponent(window.location.pathname)}`; }}>
+                Switch to team sign-in
+              </button>
+            </div>
+            <p className="tiny muted" style={{ marginTop: 12 }}>Platform owners: create your user in Supabase Auth and add it to <code>team_members</code> once (see docs/architecture/IMPLEMENTATION_PLAN.md).</p>
+          </div>
+        ) : !data.org ? (
+          <CreateFirstOrganization staff={data.isPlatformStaff} />
+        ) : (
+          children(ready!)
+        )}
+      </div>
+    </div>
+  );
+}
+
+export function IntegrationNotConfigured({ name, reason, settingsPath }: { name: string; reason: string; settingsPath: string }) {
+  return (
+    <div className="notice notice-warn" role="status">
+      <strong>{name}: integration not configured.</strong> <span>{reason.replace(/^Integration not configured:\s*/i, "")}</span>{" "}
+      <Link href={settingsPath} className="link">Open Settings →</Link>
+    </div>
+  );
+}
