@@ -0,0 +1,42 @@
+import { z } from "zod";
+import { fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+
+export const dynamic = "force-dynamic";
+
+export const GET = tenantRoute("org.read", async (ctx) => {
+  const { data, error } = await ctx.client
+    .from("memberships")
+    .select("user_id, role, status, email, display_name, created_at")
+    .eq("organization_id", ctx.org.id)
+    .order("created_at");
+  fromDb(error);
+  return { members: data || [] };
+});
+
+const addMember = z.object({
+  email: z.string().trim().email("Enter a valid email address.").max(254),
+  role: z.enum(["owner", "admin", "manager", "member", "viewer"]),
+});
+
+export const POST = tenantRoute("org.manage", async (ctx, req) => {
+  const input = await readJson(req, addMember);
+  const { error } = await ctx.client.rpc("add_member_by_email", { p_org: ctx.org.id, p_email: input.email, p_role: input.role });
+  fromDb(error);
+  return { ok: true };
+});
+
+const changeMember = z.object({
+  user_id: z.string().uuid(),
+  role: z.enum(["owner", "admin", "manager", "member", "viewer"]).optional(),
+  status: z.enum(["active", "disabled"]).optional(),
+});
+
+export const PATCH = tenantRoute("org.manage", async (ctx, req) => {
+  const { user_id, ...patch } = await readJson(req, changeMember);
+  const { data, error } = await ctx.client
+    .from("memberships").update(patch).eq("organization_id", ctx.org.id).eq("user_id", user_id).select("user_id").maybeSingle();
+  fromDb(error);
+  if (data) await audit(ctx.client, ctx.org.id, "membership.changed", { type: "user", id: user_id }, patch);
+  return { ok: !!data };
+});
diff --git a/src/app/api/tenant/route.ts b/src/app/api/tenant/route.ts
new file mode 100644
index 0000000..3b51668
--- /dev/null
+++ b/src/app/api/tenant/route.ts
@@ -0,0 +1,61 @@
+import { NextResponse } from "next/server";
+import { z } from "zod";
+import { ApiError, assertSameOrigin, errorResponse, fromDb, readJson } from "@/lib/tenant/api";
+import { getTenantContext, ORG_COOKIE } from "@/lib/tenant/session";
+import { getChatModel } from "@/lib/ai/provider";
+
+export const dynamic = "force-dynamic";
+
+const cookieOptions = { httpOnly: true, sameSite: "lax" as const, secure: process.env.NODE_ENV === "production", path: "/", maxAge: 60 * 60 * 24 * 180 };
+
+// Who am I, which organizations can I use, and is the AI connected.
+export async function GET() {
+  try {
+    const ctx = await getTenantContext();
+    if (!ctx) return NextResponse.json({ signedIn: false });
+    const { status } = await getChatModel();
+    return NextResponse.json({
+      signedIn: true,
+      user: ctx.session.user,
+      orgs: ctx.orgs,
+      org: ctx.org,
+      isPlatformStaff: ctx.isPlatformStaff,
+      ai: status,
+    });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+const body = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("switch"), orgId: z.string().uuid() }),
+  z.object({
+    action: z.literal("create"),
+    name: z.string().trim().min(2, "Name must be at least 2 characters.").max(120),
+    kind: z.enum(["agency", "client"]),
+    parentId: z.string().uuid().optional(),
+  }),
+]);
+
+export async function POST(req: Request) {
+  try {
+    assertSameOrigin(req);
+    const ctx = await getTenantContext();
+    if (!ctx) throw new ApiError("Sign in with your team account first.", 401, "unauthenticated");
+    const input = await readJson(req, body);
+    let orgId: string;
+    if (input.action === "switch") {
+      if (!ctx.orgs.some((o) => o.id === input.orgId)) throw new ApiError("You do not have access to that organization.", 403, "forbidden");
+      orgId = input.orgId;
+    } else {
+      const { data, error } = await ctx.client.rpc("create_organization", { p_name: input.name, p_kind: input.kind, p_parent: input.parentId ?? null });
+      fromDb(error);
+      orgId = String(data);
+    }
+    const response = NextResponse.json({ ok: true, orgId });
+    response.cookies.set(ORG_COOKIE, orgId, cookieOptions);
+    return response;
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
diff --git a/src/app/command-center/page.tsx b/src/app/command-center/page.tsx
new file mode 100644
index 0000000..d9eb789
--- /dev/null
+++ b/src/app/command-center/page.tsx
@@ -0,0 +1,358 @@
+"use client";
+import { useCallback, useEffect, useRef, useState } from "react";
+import TenantGate, { ErrorState, IntegrationNotConfigured, Loading } from "@/components/tenant/TenantGate";
+import { api, atLeast, Org, relativeTime, useResource } from "@/components/tenant/client";
+import { CATEGORY_INFO, MODE_INFO, STATUS_LABEL, AI_CATEGORIES, AI_MODES, type ActionStatus, type AiCategory, type AiMode } from "@/lib/command/policy";
+import { useToast } from "@/components/ui";
+
+type Action = { id: string; tool: string; category: string; summary: string; status: ActionStatus; error: string | null; created_at: string; decided_at: string | null };
+type Message = { id?: string; role: "user" | "assistant"; content: string; actions?: Action[] };
+type Conversation = { id: string; title: string; updated_at: string };
+type AuditEntry = { id: number; actor_type: string; action: string; target_type: string | null; target_id: string | null; metadata: Record<string, unknown>; created_at: string };
+
+const STATUS_TONE: Record<ActionStatus, string> = {
+  recommended: "pill-info",
+  pending_approval: "pill-warn",
+  approved: "pill-sun",
+  executed: "pill-ok",
+  rejected: "pill-neutral",
+  failed: "pill-bad",
+  blocked: "pill-neutral",
+};
+
+const SUGGESTIONS = [
+  "Who are my hottest leads right now, and why?",
+  "Summarize my pipeline and tell me where deals are stuck.",
+  "Add Jordan Lee (jordan@example.com) as a new roofing lead from our website form and create a call-back task for tomorrow at 10am.",
+  "What follow-ups are overdue?",
+];
+
+function StatusPill({ status }: { status: ActionStatus }) {
+  return <span className={`pill ${STATUS_TONE[status]}`}>{STATUS_LABEL[status]}</span>;
+}
+
+function Chat({ org, aiReady }: { org: Org; aiReady: boolean }) {
+  const [conversationId, setConversationId] = useState<string | undefined>();
+  const [messages, setMessages] = useState<Message[]>([]);
+  const [input, setInput] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const conversations = useResource<{ conversations: Conversation[] }>("/api/command");
+  const threadRef = useRef<HTMLDivElement>(null);
+  const canChat = atLeast(org.role, "member");
+
+  useEffect(() => {
+    threadRef.current?.scrollTo({ top: threadRef.current.scrollHeight, behavior: "smooth" });
+  }, [messages, busy]);
+
+  async function open(id: string) {
+    setError("");
+    if (!id) {
+      setConversationId(undefined);
+      setMessages([]);
+      return;
+    }
+    try {
+      const r = await api<{ messages: Message[] }>(`/api/command?conversation=${id}`);
+      setConversationId(id);
+      setMessages(r.messages);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "Could not open that conversation.");
+    }
+  }
+
+  async function send(text: string) {
+    const message = text.trim();
+    if (!message || busy) return;
+    setBusy(true);
+    setError("");
+    setInput("");
+    setMessages((m) => [...m, { role: "user", content: message }]);
+    try {
+      const r = await api<{ conversationId: string; reply: string; actions: Action[] }>("/api/command", { body: { message, conversationId } });
+      setConversationId(r.conversationId);
+      setMessages((m) => [...m, { role: "assistant", content: r.reply, actions: r.actions }]);
+      if (!conversationId) conversations.reload();
+      window.dispatchEvent(new Event("ai-actions-changed"));
+    } catch (e) {
+      setError(e instanceof Error ? e.message : "The request failed.");
+      setInput(message);
+      setMessages((m) => m.slice(0, -1));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="card cc-chat">
+      <div className="card-head">
+        <div>
+          <h3>AI operator</h3>
+          <div className="sub">Describe an outcome. The operator looks things up and prepares the changes.</div>
+        </div>
+        <div className="row">
+          <label className="sr-only" htmlFor="conv">Conversation</label>
+          <select id="conv" className="select" style={{ minWidth: 170, maxWidth: 240 }} value={conversationId || ""} onChange={(e) => open(e.target.value)}>
+            <option value="">New conversation</option>
+            {conversations.data?.conversations.map((c) => (
+              <option key={c.id} value={c.id}>{c.title.slice(0, 48)}</option>
+            ))}
+          </select>
+        </div>
+      </div>
+      <div className="cc-thread" ref={threadRef} aria-live="polite">
+        {messages.length === 0 && !busy && (
+          <div className="cc-hero">
+            <h2>What should we get done for {org.name}?</h2>
+            <p className="small muted">Ask in plain English. Changes follow your AI permissions on the right, and every step is logged.</p>
+            <div className="cc-suggest">
+              {SUGGESTIONS.map((s) => (
+                <button key={s} type="button" disabled={!aiReady || !canChat} onClick={() => send(s)}>{s}</button>
+              ))}
+            </div>
+          </div>
+        )}
+        {messages.map((m, i) => (
+          <div key={m.id || i} className={`cc-msg ${m.role}`}>
+            {m.content}
+            {!!m.actions?.length && (
+              <div className="stack" style={{ gap: 6, marginTop: 10 }}>
+                {m.actions.map((a) => (
+                  <div key={a.id} className="row small" style={{ gap: 8, flexWrap: "wrap" }}>
+                    <StatusPill status={a.status} /> <span>{a.summary}</span>
+                  </div>
+                ))}
+              </div>
+            )}
+          </div>
+        ))}
+        {busy && (
+          <div className="cc-msg assistant" role="status"><span className="spin spin-dark" /> <span className="muted">Working on it…</span></div>
+        )}
+      </div>
+      {error && <div className="form-error" role="alert" style={{ margin: "0 12px 10px" }}>{error}</div>}
+      <form className="cc-compose" onSubmit={(e) => { e.preventDefault(); send(input); }}>
+        <label className="sr-only" htmlFor="cc-input">Request</label>
+        <textarea
+          id="cc-input"
+          className="textarea"
+          rows={2}
+          maxLength={4000}
+          value={input}
+          disabled={!aiReady || !canChat || busy}
+          placeholder={!canChat ? "Viewers can review activity but not give instructions." : aiReady ? "e.g. Create a follow-up task for every lead I haven't contacted this week" : "Connect an AI provider in Settings to start."}
+          onChange={(e) => setInput(e.target.value)}
+          onKeyDown={(e) => {
+            if (e.key === "Enter" && !e.shiftKey) {
+              e.preventDefault();
+              send(input);
+            }
+          }}
+        />
+        <button className="btn btn-primary" disabled={!aiReady || !canChat || busy || !input.trim()}>{busy ? <span className="spin" /> : "Send"}</button>
+      </form>
+    </div>
+  );
+}
+
+function ActionQueue({ org }: { org: Org }) {
+  const { data, error, loading, reload } = useResource<{ actions: Action[] }>("/api/command/actions");
+  const [working, setWorking] = useState<string | null>(null);
+  const { toast, node } = useToast();
+  const canDecide = atLeast(org.role, "manager");
+
+  useEffect(() => {
+    const h = () => reload();
+    window.addEventListener("ai-actions-changed", h);
+    return () => window.removeEventListener("ai-actions-changed", h);
+  }, [reload]);
+
+  async function decide(id: string, decision: "approve" | "reject") {
+    setWorking(id);
+    try {
+      const r = await api<{ action: Action }>(`/api/command/actions/${id}`, { body: { decision } });
+      toast(r.action.status === "executed" ? "Approved and done." : r.action.status === "failed" ? `Approved, but it failed: ${r.action.error}` : "Dismissed.");
+      reload();
+    } catch (e) {
+      toast(e instanceof Error ? e.message : "That did not work.");
+    } finally {
+      setWorking(null);
+    }
+  }
+
+  if (loading && !data) return <div className="card"><Loading /></div>;
+  if (error) return <div className="card"><ErrorState message={error} onRetry={reload} /></div>;
+  const actions = data?.actions || [];
+  const pending = actions.filter((a) => a.status === "pending_approval");
+  const recommended = actions.filter((a) => a.status === "recommended");
+  const recent = actions.filter((a) => !["pending_approval", "recommended"].includes(a.status)).slice(0, 8);
+
+  return (
+    <>
+      <div className="card">
+        <div className="card-head">
+          <div>
+            <h3>Needs approval {pending.length > 0 && <span className="pill pill-warn">{pending.length}</span>}</h3>
+            <div className="sub">{canDecide ? "Approve to run the change under your name." : "A manager or above approves these."}</div>
+          </div>
+        </div>
+        <div className="card-pad stack" style={{ gap: 8 }}>
+          {pending.length === 0 ? <p className="small muted">Nothing waiting. Prepared changes appear here.</p> : pending.map((a) => (
+            <div key={a.id} className="action-card">
+              <div className="small">{a.summary}</div>
+              <div className="meta"><span>{CATEGORY_INFO[a.category as AiCategory]?.label || a.category}</span>·<span>{relativeTime(a.created_at)}</span></div>
+              <div className="inline-actions">
