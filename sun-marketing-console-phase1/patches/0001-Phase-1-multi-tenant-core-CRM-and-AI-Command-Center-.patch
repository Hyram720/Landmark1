+-- Phase 1 security tests. Run with scripts/test-db.sh.
+-- Each block impersonates an API caller exactly as PostgREST does:
+-- SET ROLE authenticated + request.jwt.claims.
+\set ON_ERROR_STOP 1
+set client_min_messages = notice;
+
+create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, false);
+  execute 'set role authenticated';
+end $$;
+create or replace function pg_temp.reset_user() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', false);
+end $$;
+-- Asserts that a statement fails (permission/RLS/check). Runs it in a
+-- subtransaction so the test continues.
+create or replace function pg_temp.expect_error(p_sql text, p_label text) returns void language plpgsql as $$
+begin
+  begin
+    execute p_sql;
+  exception when others then
+    raise notice 'ok   (denied) %', p_label;
+    return;
+  end;
+  raise exception 'FAIL expected an error: %', p_label;
+end $$;
+create or replace function pg_temp.expect(p_ok boolean, p_label text) returns void language plpgsql as $$
+begin
+  if not coalesce(p_ok, false) then raise exception 'FAIL %', p_label; end if;
+  raise notice 'ok   %', p_label;
+end $$;
+
+-- Fixtures (as database owner).
+insert into auth.users values
+  ('00000000-0000-0000-0000-00000000000a', 'staff@agency.test'),
+  ('00000000-0000-0000-0000-00000000000b', 'other@agency.test'),
+  ('00000000-0000-0000-0000-00000000000c', 'viewer@agency.test'),
+  ('00000000-0000-0000-0000-00000000000d', 'client@client.test'),
+  ('00000000-0000-0000-0000-00000000000e', 'manager@agency.test');
+insert into public.team_members(user_id, email, active) values
+  ('00000000-0000-0000-0000-00000000000a', 'staff@agency.test', true),
+  ('00000000-0000-0000-0000-00000000000b', 'other@agency.test', true);
+insert into public.businesses(name, website, phone, email, contact_name, status) values
+  ('Acme Roofing', 'https://www.acmeroof.test/home', '(856) 555-0100', 'owner@acmeroof.test', 'Pat Smith', 'prospect'),
+  ('No Contact Plumbing', null, null, null, null, 'client');
+
+create temp table ids (k text primary key, v uuid);
+grant all on ids to authenticated;
+
+-- 1. Provisioning ---------------------------------------------------------
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000a');
+insert into ids select 'agency_a', public.create_organization('Agency A', 'agency');
+insert into ids select 'client_a1', public.create_organization('Client A1', 'client', (select v from ids where k = 'agency_a'));
+select pg_temp.expect((select count(*) = 7 from public.pipeline_stages where organization_id = (select v from ids where k = 'agency_a')),
+  'agency gets a default 7-stage pipeline');
+select pg_temp.expect((select mode = 'approve' from public.ai_policies where organization_id = (select v from ids where k = 'agency_a') and category = 'crm'),
+  'default crm policy is approve');
+select pg_temp.expect((select role = 'owner' from public.my_organizations() where id = (select v from ids where k = 'agency_a')),
+  'creator owns the agency');
+select pg_temp.expect((select role = 'admin' from public.my_organizations() where id = (select v from ids where k = 'client_a1')),
+  'agency owner is capped at admin in client accounts');
+select pg_temp.reset_user();
+
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000b');
+insert into ids select 'agency_b', public.create_organization('Agency B', 'agency');
+select pg_temp.expect_error($$select public.create_organization('Sneaky', 'client', (select v from ids where k = 'agency_a'))$$,
+  'cannot create client accounts under another agency');
+select pg_temp.reset_user();
+
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000d');
+select pg_temp.expect_error($$select public.create_organization('Self Serve', 'agency')$$,
+  'non-staff cannot create agencies');
+select pg_temp.expect((select count(*) = 0 from public.organizations), 'non-member sees no organizations');
+select pg_temp.reset_user();
+
+-- 2. Membership ladder ------------------------------------------------------
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000a');
+select public.add_member_by_email((select v from ids where k = 'agency_a'), 'viewer@agency.test', 'viewer');
+select public.add_member_by_email((select v from ids where k = 'agency_a'), 'manager@agency.test', 'manager');
+select public.add_member_by_email((select v from ids where k = 'client_a1'), 'client@client.test', 'owner');
+select pg_temp.expect_error($$select public.add_member_by_email((select v from ids where k = 'agency_a'), 'nobody@x.test', 'member')$$,
+  'unknown emails are rejected');
+select pg_temp.expect_error($$delete from public.memberships where organization_id = (select v from ids where k = 'agency_a') and user_id = '00000000-0000-0000-0000-00000000000a'$$,
+  'the last owner cannot be removed');
