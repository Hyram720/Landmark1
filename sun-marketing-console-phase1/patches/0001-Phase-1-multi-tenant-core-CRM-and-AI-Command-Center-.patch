+                        reload();
+                      } catch (e) {
+                        toast(e instanceof Error ? e.message : "Erase failed.");
+                      }
+                    }}
+                  >
+                    Erase personal data
+                  </button>
+                )}
+                <p className="hint">Erasure removes name, email, phone, tags and message content, and revokes consent on every channel.</p>
+              </div>
+            </details>
+          )}
+        </div>
+      </div>
+      {node}
+    </div>
+  );
+}
+
+export default function ContactPage({ params }: { params: Promise<{ id: string }> }) {
+  const { id } = use(params);
+  return (
+    <TenantGate title="Contact" subtitle="Customer memory">
+      {(info) => <ContactView org={info.org} id={id} />}
+    </TenantGate>
+  );
+}
