+-- Minimal stand-in for the pieces of a Supabase database that the
+-- migrations rely on, so RLS can be tested on a plain local PostgreSQL.
+-- Never apply this file to a real Supabase project.
+create role anon nologin;
+create role authenticated nologin;
+create role service_role nologin bypassrls;
+grant usage on schema public to anon, authenticated, service_role;
+
+create schema extensions;
+create extension pgcrypto with schema extensions;
+grant usage on schema extensions to anon, authenticated, service_role;
+
+create schema auth;
+grant usage on schema auth to anon, authenticated, service_role;
+create table auth.users (id uuid primary key, email text);
+-- Same contract as Supabase: the subject claim of the request JWT.
+create function auth.uid() returns uuid language sql stable as $$
+  select nullif(nullif(current_setting('request.jwt.claims', true), '')::json ->> 'sub', '')::uuid
+$$;
+grant execute on function auth.uid() to anon, authenticated, service_role;
+
+-- Pre-existing production tables referenced by the Phase 1 migration.
+create table public.team_members (
+  user_id uuid primary key, email text, display_name text, role text, active boolean not null default true
+);
+create table public.businesses (
+  id uuid primary key default gen_random_uuid(), name text not null, website text, phone text, email text,
+  contact_name text, address text, city text, state text, industry text, status text, source text
+);
