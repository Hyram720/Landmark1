@@ -0,0 +1,12 @@
+import { scoped, tenantRoute } from "@/lib/tenant/api";
+import { listActions } from "@/lib/command/actions";
+import type { ActionStatus } from "@/lib/command/policy";
+
+export const dynamic = "force-dynamic";
+
+const STATUSES: ActionStatus[] = ["recommended", "pending_approval", "approved", "rejected", "executed", "failed", "blocked"];
+
+export const GET = tenantRoute("crm.read", async (ctx, req) => {
+  const requested = (new URL(req.url).searchParams.get("status") || "").split(",").filter((s): s is ActionStatus => STATUSES.includes(s as ActionStatus));
+  return { actions: await listActions(scoped(ctx), { status: requested, limit: 100 }) };
+});
