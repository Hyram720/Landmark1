+select pg_temp.expect((select first_name = 'Ada' from public.contacts where id = (select v from ids where k = 'contact_a')),
+  'cross-tenant update affected no rows');
+
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000d');
+select pg_temp.expect((select count(*) = 0 from public.contacts where organization_id = (select v from ids where k = 'agency_a')),
