+import { describe, expect, it, vi, afterEach } from "vitest";
+import { atLeast, can, isRole } from "@/lib/tenant/rbac";
+import { scoreLead, scoreBand, type ScoreSignals } from "@/lib/crm/scoring";
+import { initialStatus, outcomeForModel, AI_CATEGORIES, AI_MODES } from "@/lib/command/policy";
+import { listTools, toolSpecs } from "@/lib/command/tools";
+import { searchTerm, contactInput } from "@/lib/crm/service";
+import { OpenAIChatModel, toWire } from "@/lib/ai/openai";
+import { ProviderError } from "@/lib/ai/types";
+
+describe("rbac", () => {
+  it("orders roles", () => {
+    expect(atLeast("owner", "admin")).toBe(true);
+    expect(atLeast("member", "manager")).toBe(false);
+    expect(atLeast(null, "viewer")).toBe(false);
+  });
+  it("maps permissions to minimum roles", () => {
+    expect(can("viewer", "crm.read")).toBe(true);
+    expect(can("viewer", "crm.write")).toBe(false);
+    expect(can("member", "ai.decide")).toBe(false);
+    expect(can("manager", "ai.decide")).toBe(true);
+    expect(can("manager", "ai.policies")).toBe(false);
+    expect(can("admin", "ai.policies")).toBe(true);
+  });
+  it("validates role strings", () => {
+    expect(isRole("admin")).toBe(true);
+    expect(isRole("superuser")).toBe(false);
+  });
+});
+
+const base: ScoreSignals = {
+  hasEmail: false, hasPhone: false, hasConsent: false, doNotContact: false, lifecycleStage: "lead", source: null,
+  daysSinceLastActivity: null, inboundLast30Days: 0, bestOpenStageProbability: null, openPipelineValueCents: 0,
+  hasWonOpportunity: false, allOpportunitiesLost: false,
+};
+
+describe("lead scoring", () => {
+  it("scores an empty lead at zero", () => {
+    expect(scoreLead(base)).toEqual({ score: 0, factors: [] });
+  });
+  it("rewards engagement and intent, with reasons", () => {
+    const r = scoreLead({ ...base, hasEmail: true, hasPhone: true, hasConsent: true, daysSinceLastActivity: 1, inboundLast30Days: 2, bestOpenStageProbability: 60, openPipelineValueCents: 1_200_000, source: "Website form" });
+    expect(r.score).toBe(8 + 8 + 6 + 18 + 10 + 15 + 5 + 6);
+    expect(r.factors[0].points).toBeGreaterThanOrEqual(r.factors[r.factors.length - 1].points);
+    expect(r.factors.map((f) => f.label)).toContain("Active in the last 3 days");
+  });
+  it("caps at 100 and zeroes do-not-contact", () => {
+    const hot = { ...base, hasEmail: true, hasPhone: true, hasConsent: true, daysSinceLastActivity: 0, inboundLast30Days: 9, bestOpenStageProbability: 100, openPipelineValueCents: 9_000_000, hasWonOpportunity: true, source: "referral" };
+    expect(scoreLead(hot).score).toBe(100);
+    expect(scoreLead({ ...hot, doNotContact: true }).score).toBe(0);
+  });
+  it("penalises stale lost leads but never below zero", () => {
+    expect(scoreLead({ ...base, daysSinceLastActivity: 90, allOpportunitiesLost: true }).score).toBe(0);
+  });
+  it("bands scores", () => {
+    expect(scoreBand(80).label).toBe("Hot");
+    expect(scoreBand(10).label).toBe("Cold");
+  });
+});
+
+describe("AI policy ladder", () => {
+  it("maps each mode to the status the database requires", () => {
+    expect(initialStatus("observe")).toBe("blocked");
+    expect(initialStatus("recommend")).toBe("recommended");
+    expect(initialStatus("approve")).toBe("pending_approval");
+    expect(initialStatus("auto")).toBe("approved");
+  });
+  it("never tells the model a pending change is done", () => {
+    expect(outcomeForModel("pending_approval")).toMatch(/^NOT DONE/);
+    expect(outcomeForModel("recommended")).toMatch(/^NOT DONE/);
+    expect(outcomeForModel("blocked")).toMatch(/^NOT DONE/);
+    expect(outcomeForModel("executed")).toMatch(/^DONE/);
+  });
+  it("covers all modes", () => {
+    expect(AI_MODES).toHaveLength(4);
+  });
+});
+
+describe("tool registry", () => {
+  it("has unique, database-valid names and governed categories", () => {
+    const names = listTools().map((t) => t.name);
+    expect(new Set(names).size).toBe(names.length);
+    for (const t of listTools()) {
+      expect(t.name).toMatch(/^[a-z][a-z0-9_]{1,63}$/);
+      if (t.kind === "write") expect(AI_CATEGORIES).toContain(t.category);
+    }
+  });
+  it("produces object JSON schemas for the model", () => {
+    for (const spec of toolSpecs()) {
+      expect(spec.parameters.type).toBe("object");
+      expect(spec.parameters).not.toHaveProperty("$schema");
+    }
+  });
+});
+
+describe("crm input handling", () => {
+  it("strips PostgREST filter syntax from search terms", () => {
+    expect(searchTerm("a,b(c)*d%e")).toBe("a b c d e");
+  });
+  it("requires some way to identify a contact", () => {
+    expect(contactInput.safeParse({ source: "x" }).success).toBe(false);
+    expect(contactInput.safeParse({ email: "  ADA@Example.com " }).data?.email).toBe("ada@example.com");
+    expect(contactInput.safeParse({ phone: "not a phone" }).success).toBe(false);
+    expect(contactInput.safeParse({ first_name: "", phone: "(856) 555-0100" }).data).toEqual({ phone: "(856) 555-0100" });
+  });
+});
+
+describe("OpenAI adapter", () => {
+  afterEach(() => vi.unstubAllGlobals());
+
+  it("converts neutral messages to the wire format", () => {
+    const wire = toWire([
+      { role: "assistant", content: null, toolCalls: [{ id: "c1", name: "pipeline_summary", arguments: "{}" }] },
+      { role: "tool", toolCallId: "c1", content: "{}" },
+    ]);
+    expect(wire[0]).toMatchObject({ tool_calls: [{ id: "c1", type: "function", function: { name: "pipeline_summary" } }] });
+    expect(wire[1]).toEqual({ role: "tool", content: "{}", tool_call_id: "c1" });
+  });
+
+  it("parses tool calls and maps auth errors to safe messages", async () => {
+    const fetchMock = vi.fn()
+      .mockResolvedValueOnce(new Response(JSON.stringify({ choices: [{ message: { content: null, tool_calls: [{ id: "x", type: "function", function: { name: "list_open_tasks", arguments: "{}" } }] } }] }), { status: 200 }))
+      .mockResolvedValueOnce(new Response(JSON.stringify({ error: { message: "secret detail" } }), { status: 401 }));
+    vi.stubGlobal("fetch", fetchMock);
+    const model = new OpenAIChatModel("sk-test", "test-model");
+    const first = await model.complete({ messages: [{ role: "user", content: "hi" }], tools: [] });
+    expect(first.toolCalls).toEqual([{ id: "x", name: "list_open_tasks", arguments: "{}" }]);
+    await expect(model.complete({ messages: [{ role: "user", content: "hi" }], tools: [] })).rejects.toBeInstanceOf(ProviderError);
+    const sent = JSON.parse(fetchMock.mock.calls[0][1].body);
+    expect(sent).not.toHaveProperty("tools");
+  });
+});
diff --git a/tests/unit/engine.test.ts b/tests/unit/engine.test.ts
new file mode 100644
index 0000000..322aa0a
--- /dev/null
+++ b/tests/unit/engine.test.ts
@@ -0,0 +1,117 @@
+import { describe, expect, it, beforeEach } from "vitest";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { runCommand, type CommandContext } from "@/lib/command/engine";
+import { decideAction } from "@/lib/command/actions";
+import type { ChatModel, Completion } from "@/lib/ai/types";
+import { ProviderError } from "@/lib/ai/types";
+import { FakeDb } from "../support/fake-supabase";
+
+const ORG = "11111111-1111-4111-8111-111111111111";
+const USER = "22222222-2222-4222-8222-222222222222";
+
+class ScriptedModel implements ChatModel {
+  provider = "test";
+  model = "scripted";
+  calls: Parameters<ChatModel["complete"]>[0][] = [];
+  constructor(private script: (Completion | Error)[]) {}
+  async complete(req: Parameters<ChatModel["complete"]>[0]) {
+    this.calls.push(JSON.parse(JSON.stringify(req)));
+    const next = this.script.shift();
+    if (!next) throw new Error("script exhausted");
+    if (next instanceof Error) throw next;
+    return next;
+  }
+}
+
+function setup(mode: "observe" | "recommend" | "approve" | "auto") {
+  const db = new FakeDb();
+  db.table("ai_policies").push({ organization_id: ORG, category: "tasks", mode }, { organization_id: ORG, category: "crm", mode: "approve" });
+  const ctx: CommandContext = { client: db as unknown as SupabaseClient, orgId: ORG, userId: USER, orgName: "Acme", role: "owner" };
+  return { db, ctx };
+}
+
+const createTaskCall: Completion = {
+  content: null,
+  toolCalls: [{ id: "call1", name: "create_task", arguments: JSON.stringify({ title: "Call back Ada", priority: "high" }) }],
+};
+const finalReply: Completion = { content: "I prepared a follow-up task.", toolCalls: [] };
+
+describe("command engine", () => {
+  let model: ScriptedModel;
+  beforeEach(() => {
+    model = new ScriptedModel([createTaskCall, finalReply]);
+  });
+
+  it("queues changes for approval and tells the model they are not done", async () => {
+    const { db, ctx } = setup("approve");
+    const result = await runCommand(ctx, model, "Remind me to call Ada back");
+    expect(result.reply).toBe("I prepared a follow-up task.");
+    expect(result.actions).toHaveLength(1);
+    expect(result.actions[0]).toMatchObject({ tool: "create_task", status: "pending_approval", policy_mode: "approve", requested_by: USER });
+    expect(db.table("tasks")).toHaveLength(0);
+    const toolMessage = model.calls[1].messages.find((m) => m.role === "tool");
+    expect(toolMessage?.content).toContain("NOT DONE YET");
+    expect(db.rpcCalls.map((c) => c.name)).toContain("log_audit");
+    // Conversation persisted: user + assistant.
+    expect(db.table("ai_messages").map((m) => m.role)).toEqual(["user", "assistant"]);
+  });
+
+  it("executes immediately under the auto policy", async () => {
+    const { db, ctx } = setup("auto");
+    const result = await runCommand(ctx, model, "Remind me to call Ada back");
+    expect(result.actions[0].status).toBe("executed");
+    expect(db.table("tasks")).toHaveLength(1);
+    expect(db.table("tasks")[0]).toMatchObject({ organization_id: ORG, title: "Call back Ada", priority: "high" });
+    expect(model.calls[1].messages.find((m) => m.role === "tool")?.content).toContain("DONE");
+  });
+
+  it("blocks changes when the organization only allows observing", async () => {
+    const { db, ctx } = setup("observe");
+    const result = await runCommand(ctx, model, "Remind me to call Ada back");
+    expect(result.actions[0].status).toBe("blocked");
+    expect(db.table("tasks")).toHaveLength(0);
+  });
+
+  it("rejects invalid tool arguments without recording an action", async () => {
+    const { db, ctx } = setup("auto");
+    model = new ScriptedModel([{ content: null, toolCalls: [{ id: "c", name: "create_task", arguments: JSON.stringify({ title: "" }) }] }, finalReply]);
+    const result = await runCommand(ctx, model, "x");
+    expect(result.actions).toHaveLength(0);
+    expect(db.table("ai_actions")).toHaveLength(0);
+    expect(model.calls[1].messages.find((m) => m.role === "tool")?.content).toContain("Invalid arguments");
+  });
+
+  it("bounces values the CRM would reject before queueing them for approval", async () => {
+    const { db, ctx } = setup("approve");
+    model = new ScriptedModel([{ content: null, toolCalls: [{ id: "c", name: "create_contact", arguments: JSON.stringify({ first_name: "Al", email: "not-an-email" }) }] }, finalReply]);
+    const result = await runCommand(ctx, model, "x");
+    expect(result.actions).toHaveLength(0);
+    expect(db.table("ai_actions")).toHaveLength(0);
+    expect(model.calls[1].messages.find((m) => m.role === "tool")?.content).toContain("nothing was recorded");
+  });
+
+  it("ignores unknown tools", async () => {
+    const { ctx } = setup("auto");
+    model = new ScriptedModel([{ content: null, toolCalls: [{ id: "c", name: "delete_everything", arguments: "{}" }] }, finalReply]);
+    const result = await runCommand(ctx, model, "x");
+    expect(result.actions).toHaveLength(0);
+    expect(model.calls[1].messages.find((m) => m.role === "tool")?.content).toContain("Unknown tool");
+  });
+
+  it("returns a clear message when the provider fails", async () => {
+    const { ctx } = setup("approve");
+    model = new ScriptedModel([new ProviderError("The AI provider rejected the API key. Update it in Settings.")]);
+    const result = await runCommand(ctx, model, "hello");
+    expect(result.reply).toContain("rejected the API key");
+  });
+
+  it("approval executes the stored action", async () => {
+    const { db, ctx } = setup("approve");
+    const { actions } = await runCommand(ctx, model, "Remind me to call Ada back");
+    // The fake has no trigger, so emulate the database setting the decider.
+    const executed = await decideAction(ctx, actions[0].id, "approve");
+    expect(executed.status).toBe("executed");
+    expect(db.table("tasks")).toHaveLength(1);
+    await expect(decideAction(ctx, actions[0].id, "approve")).rejects.toThrow(/waiting for approval/);
+  });
+});
