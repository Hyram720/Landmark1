@@ -0,0 +1,26 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+
+export type AuditTarget = { type: string; id: string };
+
+// Writes an audit entry as the signed-in user via public.log_audit, which
+// fixes actor_id to auth.uid(). Audit failures are logged, never swallowed
+// silently, but they do not undo the business action that already happened.
+export async function audit(
+  client: SupabaseClient,
+  orgId: string,
+  action: string,
+  target?: AuditTarget | null,
+  metadata: Record<string, unknown> = {},
+  actorType: "user" | "ai" = "user",
+) {
+  const { error } = await client.rpc("log_audit", {
+    p_org: orgId,
+    p_action: action,
+    p_target_type: target?.type ?? null,
+    p_target_id: target?.id ?? null,
+    p_metadata: metadata,
+    p_actor_type: actorType,
+  });
+  if (error) console.error("[audit] failed to record", action, error.code, error.message);
+}
diff --git a/src/lib/tenant/rbac.ts b/src/lib/tenant/rbac.ts
new file mode 100644
index 0000000..a97f76d
--- /dev/null
+++ b/src/lib/tenant/rbac.ts
@@ -0,0 +1,44 @@
+// Role-based access control shared by API routes and UI. The database
+// enforces the same ladder through RLS (public.org_rank); this module exists
+// so the UI can hide what a user cannot do and routes can fail fast with a
+// clear message. It is never the only check.
+
+export const ROLES = ["viewer", "member", "manager", "admin", "owner"] as const;
+export type Role = (typeof ROLES)[number];
+
+const RANK: Record<Role, number> = { viewer: 1, member: 2, manager: 3, admin: 4, owner: 5 };
+
+export function isRole(value: unknown): value is Role {
+  return typeof value === "string" && (ROLES as readonly string[]).includes(value);
+}
+
+export function atLeast(role: Role | null | undefined, min: Role): boolean {
+  return !!role && RANK[role] >= RANK[min];
+}
+
+export const PERMISSIONS = {
+  "crm.read": "viewer",
+  "crm.write": "member",
+  "crm.delete": "manager",
+  "crm.erase": "admin",
+  "ai.chat": "member",
+  "ai.decide": "manager",
+  "ai.policies": "admin",
+  "audit.read": "manager",
+  "org.read": "viewer",
+  "org.manage": "admin",
+} as const satisfies Record<string, Role>;
+
+export type Permission = keyof typeof PERMISSIONS;
+
+export function can(role: Role | null | undefined, permission: Permission): boolean {
+  return atLeast(role, PERMISSIONS[permission]);
+}
+
+export const ROLE_LABEL: Record<Role, string> = {
+  owner: "Owner",
+  admin: "Admin",
+  manager: "Manager",
+  member: "Member",
+  viewer: "Viewer",
+};
