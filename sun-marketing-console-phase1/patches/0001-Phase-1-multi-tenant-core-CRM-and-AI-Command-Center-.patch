+            <label className="sr-only" htmlFor="mem-role">Role</label>
+            <select id="mem-role" className="select" style={{ maxWidth: 150 }} value={role} onChange={(e) => setRole(e.target.value as Role)}>
+              {grantable.map((r) => <option key={r} value={r}>{r[0].toUpperCase() + r.slice(1)}</option>)}
+            </select>
+            <button className="btn btn-primary" disabled={busy || !email}>{busy ? <span className="spin" /> : "Add"}</button>
+          </div>
+          <p className="hint">{ROLE_HELP[role]} The person needs an account first; email invitations arrive with the communications phase.</p>
+        </form>
+      )}
+      {node}
+    </div>
+  );
+}
+
+function ClientAccounts({ info }: { info: Ready }) {
+  const [name, setName] = useState("");
+  const [busy, setBusy] = useState(false);
+  const { toast, node } = useToast();
+  const clients = info.orgs.filter((o) => o.parent_id === info.org.id);
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>Client accounts</h3><div className="sub">Each client gets an isolated workspace. Your team keeps admin access.</div></div></div>
+      <div className="card-pad stack" style={{ gap: 8 }}>
+        {clients.length === 0 ? <p className="small muted">No client accounts yet.</p> : clients.map((c) => (
+          <div key={c.id} className="spread small">
+            <span>{c.name}{c.status !== "active" && <span className="pill pill-warn" style={{ marginLeft: 6 }}>{c.status}</span>}</span>
+            <button className="btn btn-sm" onClick={async () => { await api("/api/tenant", { body: { action: "switch", orgId: c.id } }); window.location.href = "/crm"; }}>Open</button>
+          </div>
+        ))}
+        <form
+          className="row"
+          style={{ marginTop: 6 }}
+          onSubmit={async (e) => {
+            e.preventDefault();
+            setBusy(true);
+            try {
+              await api("/api/tenant", { body: { action: "create", kind: "client", name, parentId: info.org.id } });
+              window.location.reload();
+            } catch (err) {
+              toast(err instanceof Error ? err.message : "Could not create the client account.");
+              setBusy(false);
+            }
+          }}
+        >
+          <label className="sr-only" htmlFor="client-name">Client business name</label>
+          <input id="client-name" className="input" placeholder="Client business name" minLength={2} maxLength={120} value={name} onChange={(e) => setName(e.target.value)} />
+          <button className="btn btn-primary" disabled={busy || name.trim().length < 2}>{busy ? <span className="spin" /> : "Create"}</button>
+        </form>
+      </div>
+      {node}
+    </div>
+  );
+}
+
+function LegacyImport() {
+  const [busy, setBusy] = useState(false);
+  const [result, setResult] = useState<string | null>(null);
+  return (
+    <div className="card card-pad stack" style={{ gap: 8 }}>
+      <strong className="small">Bring in your existing prospect list</strong>
+      <p className="small muted">Copies businesses from the Pipeline / Site Scanner into this organization&apos;s CRM as companies and contacts. Safe to run again; existing records are skipped. The original list is unchanged.</p>
+      <div className="row">
+        <button
+          className="btn"
+          disabled={busy}
+          onClick={async () => {
+            setBusy(true);
+            try {
+              const r = await api<{ imported: number }>("/api/tenant/import-legacy", { method: "POST", body: {} });
+              setResult(r.imported ? `Imported ${r.imported} businesses.` : "Everything was already imported.");
+            } catch (e) {
+              setResult(e instanceof Error ? e.message : "Import failed.");
+            } finally {
+              setBusy(false);
+            }
+          }}
+        >
+          {busy ? <span className="spin spin-dark" /> : "Import prospects"}
+        </button>
+        {result && <span className="small" role="status">{result}</span>}
+      </div>
+    </div>
+  );
+}
+
+export default function OrganizationPage() {
+  return (
+    <TenantGate title="Organization" subtitle="People, client accounts and access.">
+      {(info) => (
+        <div className="grid g2" style={{ alignItems: "start" }}>
+          <div className="stack">
+            <div className="card card-pad">
+              <div className="spread">
+                <div>
+                  <h2 style={{ fontSize: 18 }}>{info.org.name}</h2>
+                  <div className="small muted">{info.org.kind === "agency" ? "Agency" : "Client account"} · your role: {info.org.role}</div>
+                </div>
+                <span className={`pill ${info.org.status === "active" ? "pill-ok" : "pill-warn"}`}>{info.org.status}</span>
+              </div>
+              {info.org.status === "suspended" && <div className="notice notice-warn small" style={{ marginTop: 10 }}>This account is suspended and read-only. Data can still be viewed and exported.</div>}
+            </div>
+            <Members org={info.org} selfId={info.user.id} />
+          </div>
+          <div className="stack">
+            {info.org.kind === "agency" && atLeast(info.org.role, "admin") && <ClientAccounts info={info} />}
+            {info.isPlatformStaff && atLeast(info.org.role, "admin") && <LegacyImport />}
+          </div>
+        </div>
+      )}
+    </TenantGate>
+  );
+}
