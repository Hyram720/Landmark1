+create or replace function public.tg_activity_touch_contact() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if new.contact_id is not null then
+    update public.contacts set last_activity_at = greatest(coalesce(last_activity_at, new.occurred_at), new.occurred_at)
+     where id = new.contact_id and organization_id = new.organization_id;
+  end if;
+  return new;
+end $$;
+create trigger activities_touch_contact after insert on public.activities
+  for each row execute function public.tg_activity_touch_contact();
+
+-- Stage changes keep status in sync with the stage kind and land on the timeline.
+create or replace function public.tg_opportunity_stage() returns trigger
+language plpgsql set search_path = '' as $$
+declare v_stage public.pipeline_stages;
+begin
+  select * into v_stage from public.pipeline_stages where id = new.stage_id;
+  new.status := v_stage.kind;
+  if tg_op = 'INSERT' or new.stage_id is distinct from old.stage_id then
+    new.stage_entered_at := now();
+    new.closed_at := case when v_stage.kind = 'open' then null else now() end;
+  end if;
+  return new;
+end $$;
+create trigger opportunities_stage before insert or update on public.opportunities
+  for each row execute function public.tg_opportunity_stage();
+
+create or replace function public.tg_opportunity_stage_activity() returns trigger
+language plpgsql set search_path = '' as $$
+declare v_from text; v_to text;
+begin
+  if new.stage_id is distinct from old.stage_id then
+    select name into v_from from public.pipeline_stages where id = old.stage_id;
+    select name into v_to from public.pipeline_stages where id = new.stage_id;
+    insert into public.activities(organization_id, contact_id, opportunity_id, kind, direction, subject, metadata, actor_type, actor_id)
+    values (new.organization_id, new.contact_id, new.id, 'stage_change', 'internal',
+            left(format('%s moved from %s to %s', new.title, v_from, v_to), 300),
+            jsonb_build_object('from_stage_id', old.stage_id, 'to_stage_id', new.stage_id),
+            case when auth.uid() is null then 'system' else 'user' end, auth.uid());
+  end if;
+  return new;
+end $$;
+create trigger opportunities_stage_activity after update of stage_id on public.opportunities
+  for each row execute function public.tg_opportunity_stage_activity();
