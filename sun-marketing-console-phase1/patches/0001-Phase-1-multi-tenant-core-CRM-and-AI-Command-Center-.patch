@@ -0,0 +1,30 @@
+import "server-only";
+import { getOpenAIImageCredential } from "@/lib/secrets";
+import { OpenAIChatModel } from "./openai";
+import type { ChatModel } from "./types";
+
+export * from "./types";
+
+export type AiStatus =
+  | { configured: true; provider: string; model: string; source: string }
+  | { configured: false; reason: string; settingsPath: string };
+
+const DEFAULT_OPENAI_MODEL = "gpt-4.1-mini";
+
+// Resolves the configured model. Today: OpenAI, with the key from encrypted
+// Settings storage or the OPENAI_API_KEY environment variable.
+export async function getChatModel(): Promise<{ model: ChatModel | null; status: AiStatus }> {
+  const provider = (process.env.AI_PROVIDER || "openai").toLowerCase();
+  if (provider !== "openai") {
+    return { model: null, status: { configured: false, reason: `AI provider "${provider}" is not supported yet.`, settingsPath: "/settings#ai" } };
+  }
+  const credential = await getOpenAIImageCredential().catch(() => null);
+  if (!credential) {
+    return { model: null, status: { configured: false, reason: "Integration not configured: add an OpenAI API key.", settingsPath: "/settings#ai" } };
+  }
+  const modelName = process.env.AI_COMMAND_MODEL?.trim() || DEFAULT_OPENAI_MODEL;
+  return {
+    model: new OpenAIChatModel(credential.key, modelName),
+    status: { configured: true, provider: "openai", model: modelName, source: credential.source },
+  };
+}
