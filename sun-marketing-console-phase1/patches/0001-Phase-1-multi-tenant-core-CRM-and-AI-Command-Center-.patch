@@ -0,0 +1,26 @@
+import { z } from "zod";
+import { fromDb, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+
+export const dynamic = "force-dynamic";
+
+const consent = z.object({
+  channel: z.enum(["sms", "email", "voice", "whatsapp"]),
+  status: z.enum(["granted", "revoked"]),
+  source: z.string().trim().min(3, "Say how consent was given or withdrawn.").max(200),
+  evidence: z.string().trim().max(2000).optional(),
+});
+
+// Consent is append-only: each change adds a row; the newest row wins.
+export const POST = tenantRoute<{ id: string }>("crm.write", async (ctx, req, { id }) => {
+  const contactId = uuid.parse(id);
+  const input = await readJson(req, consent);
+  const { error } = await ctx.client.from("consents").insert({ organization_id: ctx.org.id, contact_id: contactId, captured_by: ctx.session.user.id, ...input });
+  fromDb(error);
+  await ctx.client.from("activities").insert({
+    organization_id: ctx.org.id, contact_id: contactId, kind: "system", direction: "internal", actor_type: "user", actor_id: ctx.session.user.id,
+    subject: `${input.channel.toUpperCase()} consent ${input.status} (${input.source})`.slice(0, 300),
+  });
+  await audit(ctx.client, ctx.org.id, `consent.${input.status}`, { type: "contact", id: contactId }, { channel: input.channel });
+  return { ok: true };
+});
