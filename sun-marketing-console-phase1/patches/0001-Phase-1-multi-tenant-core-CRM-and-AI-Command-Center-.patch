+-- 6. Audit log ------------------------------------------------------------
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000e');
+select public.log_audit((select v from ids where k = 'agency_a'), 'test.event', 'contact', 'x', '{}', 'ai');
+select pg_temp.expect_error($$select public.log_audit((select v from ids where k = 'agency_a'), 'spoof', null, null, '{}', 'system')$$,
