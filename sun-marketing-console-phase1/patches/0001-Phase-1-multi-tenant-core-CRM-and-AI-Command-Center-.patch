+-- 4. Pipeline + timeline --------------------------------------------------
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000a');
+with x as (insert into public.opportunities(organization_id, pipeline_id, stage_id, contact_id, title, value_cents)
+  select o.v, p.id, s.id, (select v from ids where k = 'contact_a'), 'Roof replacement', 1200000
+    from ids o join public.pipelines p on p.organization_id = o.v
+    join public.pipeline_stages s on s.pipeline_id = p.id and s.position = 1
+   where o.k = 'agency_a' returning id) insert into ids select 'opp_a', id from x;
+update public.opportunities set stage_id = (select s.id from public.pipeline_stages s join public.opportunities o on o.pipeline_id = s.pipeline_id
+  where o.id = (select v from ids where k = 'opp_a') and s.kind = 'won')
+ where id = (select v from ids where k = 'opp_a');
