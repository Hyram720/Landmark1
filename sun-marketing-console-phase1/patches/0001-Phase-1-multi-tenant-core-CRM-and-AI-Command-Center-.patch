diff --git a/src/app/api/crm/contacts/[id]/route.ts b/src/app/api/crm/contacts/[id]/route.ts
new file mode 100644
index 0000000..eb80d56
--- /dev/null
+++ b/src/app/api/crm/contacts/[id]/route.ts
@@ -0,0 +1,30 @@
+import { z } from "zod";
+import { ApiError, fromDb, readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { contactPatch, getContact, rescoreContact, updateContact } from "@/lib/crm/service";
+import { can } from "@/lib/tenant/rbac";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const GET = tenantRoute<P>("crm.read", async (ctx, _req, { id }) => getContact(scoped(ctx), uuid.parse(id)));
+
+export const PATCH = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const contactId = uuid.parse(id);
+  const patch = await readJson(req, contactPatch);
+  await updateContact(scoped(ctx), contactId, patch);
+  await audit(ctx.client, ctx.org.id, "contact.updated", { type: "contact", id: contactId }, { fields: Object.keys(patch) });
+  return { ok: true };
+});
+
+// POST { action: "rescore" } recalculates the lead score; { action: "erase" }
+// permanently removes personal data (admins only).
+export const POST = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const contactId = uuid.parse(id);
+  const { action } = await readJson(req, z.object({ action: z.enum(["rescore", "erase"]) }));
+  if (action === "rescore") return { score: await rescoreContact(scoped(ctx), contactId) };
+  if (!can(ctx.org.role, "crm.erase")) throw new ApiError("Only admins can erase contact data.", 403, "forbidden");
+  const { error } = await ctx.client.rpc("erase_contact", { p_contact: contactId });
+  fromDb(error);
