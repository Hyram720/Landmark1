+select pg_temp.expect((select count(*) = 1 from public.organizations), 'client owner sees only their own organization');
+select pg_temp.reset_user();
+
+select pg_temp.as_user('00000000-0000-0000-0000-00000000000c');
+select pg_temp.expect((select count(*) = 1 from public.contacts), 'viewer can read');
+select pg_temp.expect_error($$insert into public.contacts(organization_id, first_name) values ((select v from ids where k = 'agency_a'), 'Nope')$$,
+  'viewer cannot write');
+select pg_temp.expect((select count(*) = 0 from public.audit_log), 'viewer cannot read audit log');
+select pg_temp.reset_user();
