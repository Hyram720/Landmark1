+            await api("/api/crm/opportunities", {
+              body: { title: String(f.get("title") || ""), value: Number(f.get("value") || 0), stage_name: String(f.get("stage") || "") || undefined },
+            });
+            onCreated();
+          } catch (err) {
+            setError(err instanceof Error ? err.message : "Could not create the deal.");
+          } finally {
+            setBusy(false);
+          }
+        }}
+      >
+        <h3>New deal</h3>
+        <div className="field"><label htmlFor="dt">Title</label><input id="dt" name="title" className="input" required maxLength={160} autoFocus placeholder="Roof replacement — Smith residence" /></div>
+        <div className="grid g2">
