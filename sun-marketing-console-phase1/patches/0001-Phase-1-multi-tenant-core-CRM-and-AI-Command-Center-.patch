+                    </td>
+                    <td><ScorePill score={c.lead_score} /></td>
+                    <td className="small" style={{ textTransform: "capitalize" }}>{c.lifecycle_stage}{c.do_not_contact && <span className="pill pill-bad" style={{ marginLeft: 6 }}>Do not contact</span>}</td>
+                    <td className="small">{c.email || c.phone || "—"}</td>
