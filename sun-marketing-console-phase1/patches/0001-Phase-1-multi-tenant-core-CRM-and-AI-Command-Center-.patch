+          <div className="field"><label htmlFor="ds">Stage</label><select id="ds" name="stage" className="select">{stages.filter((s) => s.kind === "open").map((s) => <option key={s.id} value={s.name}>{s.name}</option>)}</select></div>
+        </div>
+        <p className="hint">To link a contact, create the deal from the contact&apos;s page.</p>
+        {error && <p className="form-error" role="alert">{error}</p>}
+        <div className="row" style={{ justifyContent: "flex-end" }}>
+          <button type="button" className="btn" onClick={onClose}>Cancel</button>
+          <button className="btn btn-primary" disabled={busy}>{busy ? <span className="spin" /> : "Create deal"}</button>
+        </div>
+      </form>
+    </Modal>
+  );
+}
+
+function Tasks({ org }: { org: Org }) {
+  const { data, error, loading, reload, setData } = useResource<{ tasks: Task[] }>("/api/crm/tasks");
+  const { toast, node } = useToast();
+  const canWrite = atLeast(org.role, "member");
+  async function complete(id: string) {
+    if (!data) return;
+    setData({ tasks: data.tasks.filter((t) => t.id !== id) });
+    try {
+      await api(`/api/crm/tasks/${id}`, { method: "PATCH", body: { status: "done" } });
+      toast("Task completed.");
+    } catch (e) {
+      toast(e instanceof Error ? e.message : "Could not complete the task.");
+      reload();
+    }
+  }
+  if (loading && !data) return <div className="card"><Loading /></div>;
+  if (error) return <div className="card"><ErrorState message={error} onRetry={reload} /></div>;
+  return (
+    <div className="card">
+      {!data?.tasks.length ? <div className="empty"><h3>No open tasks</h3><p className="small">Follow-ups you or the AI create will appear here.</p></div> : (
+        <div className="table-wrap">
+          <table>
+            <thead><tr><th>Task</th><th>Contact</th><th>Priority</th><th>Due</th><th /></tr></thead>
+            <tbody>
+              {data.tasks.map((t) => {
+                const overdue = t.due_at && new Date(t.due_at).getTime() < Date.now();
+                return (
+                  <tr key={t.id}>
+                    <td className="small">{t.title}</td>
+                    <td className="small">{t.contact_id ? <Link className="link" href={`/crm/contacts/${t.contact_id}`}>{personName(t.contacts)}</Link> : "—"}</td>
+                    <td><span className={`pill ${t.priority === "high" ? "pill-bad" : t.priority === "low" ? "pill-neutral" : "pill-info"}`}>{t.priority}</span></td>
+                    <td className="small" style={overdue ? { color: "var(--bad)", fontWeight: 620 } : undefined}>{t.due_at ? new Date(t.due_at).toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }) : "—"}{overdue ? " · overdue" : ""}</td>
+                    <td>{canWrite && <button className="btn btn-sm" onClick={() => complete(t.id)}>Done</button>}</td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        </div>
+      )}
+      {node}
+    </div>
+  );
+}
+
+export default function CrmPage() {
+  const [tab, setTab] = useState<"contacts" | "pipeline" | "tasks">("contacts");
+  return (
+    <TenantGate title="CRM" subtitle="Contacts, deals and follow-ups in one place.">
+      {(info) => (
+        <>
+          <div className="tabs" role="tablist">
+            {(["contacts", "pipeline", "tasks"] as const).map((t) => (
+              <button key={t} role="tab" aria-selected={tab === t} className={tab === t ? "on" : ""} onClick={() => setTab(t)} style={{ textTransform: "capitalize" }}>{t}</button>
+            ))}
+          </div>
+          {tab === "contacts" && <Contacts org={info.org} />}
+          {tab === "pipeline" && <Pipeline org={info.org} />}
+          {tab === "tasks" && <Tasks org={info.org} />}
+        </>
+      )}
+    </TenantGate>
+  );
+}
