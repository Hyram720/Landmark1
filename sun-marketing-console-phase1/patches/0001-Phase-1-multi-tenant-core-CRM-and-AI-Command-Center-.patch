+export const GET = tenantRoute("audit.read", async (ctx, req) => {
+  const before = Number(new URL(req.url).searchParams.get("before")) || null;
+  let query = ctx.client
+    .from("audit_log").select("id, actor_type, actor_id, action, target_type, target_id, metadata, created_at")
+    .eq("organization_id", ctx.org.id);
+  if (before) query = query.lt("id", before);
+  const { data, error } = await query.order("id", { ascending: false }).limit(100);
+  fromDb(error);
+  return { entries: data || [] };
+});
