+select pg_temp.expect((select role = 'owner' from public.my_organizations()), 'agency admin appointed the client owner');
+select pg_temp.expect_error($$select public.add_member_by_email((select v from ids where k = 'agency_a'), 'client@client.test', 'viewer')$$,
+  'client owner cannot add members to the agency');
