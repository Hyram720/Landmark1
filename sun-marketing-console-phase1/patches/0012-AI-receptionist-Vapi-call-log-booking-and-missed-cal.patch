+++ b/src/lib/voice/vapi.ts
@@ -0,0 +1,102 @@
+import "server-only";
+
+// Vapi adapter: reads the assistant, lists its phone numbers, and adds (or
+// removes) this platform's tools and webhook on the assistant. Everything else
+// about the assistant (voice, prompt, model) stays as the owner set it up.
+type Fetch = typeof fetch;
+const BASE = "https://api.vapi.ai";
+export const SERVER_MESSAGES = ["tool-calls", "end-of-call-report", "status-update"];
+export const TOOL_PREFIX = "sun_";
+
+export class VapiError extends Error {
+  constructor(message: string, public status: number) { super(message); }
+}
+
+async function vapi<T>(key: string, method: string, path: string, body?: unknown, f: Fetch = fetch): Promise<T> {
+  const r = await f(`${BASE}${path}`, {
+    method, headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json" },
+    body: body === undefined ? undefined : JSON.stringify(body), signal: AbortSignal.timeout(20000),
+  }).catch(() => null);
+  if (!r) throw new VapiError("Vapi did not respond. Try again.", 502);
+  const j = (await r.json().catch(() => ({}))) as { message?: string | string[] };
+  if (r.status === 401 || r.status === 403) throw new VapiError("Vapi rejected the API key. Use the private key from Vapi → Organization → API Keys.", 401);
+  if (r.status === 404) throw new VapiError("Vapi has no assistant with that ID in this account.", 404);
+  if (!r.ok) throw new VapiError(`Vapi error: ${Array.isArray(j.message) ? j.message.join("; ") : j.message || r.status}`, r.status);
+  return j as T;
+}
+
+export type Tool = { type: string; function?: { name: string; description?: string; parameters?: unknown }; [k: string]: unknown };
+export type Assistant = {
+  id: string; name?: string; firstMessage?: string;
+  model?: { tools?: Tool[]; [k: string]: unknown };
+  server?: { url?: string; [k: string]: unknown } | null; serverMessages?: string[];
+  artifactPlan?: { recordingEnabled?: boolean };
+};
+
+export const getAssistant = (key: string, id: string, f?: Fetch) => vapi<Assistant>(key, "GET", `/assistant/${encodeURIComponent(id)}`, undefined, f);
+
+export async function assistantNumbers(key: string, id: string, f?: Fetch) {
+  const list = await vapi<{ number?: string; assistantId?: string }[]>(key, "GET", "/phone-number?limit=100", undefined, f);
+  return (Array.isArray(list) ? list : []).filter((n) => n.assistantId === id && n.number).map((n) => n.number as string);
+}
+
+export type ToolSettings = { transfer_number: string | null; take_messages: boolean; booking: boolean };
+
+// Pure: the tools this platform adds to the assistant.
+export function platformTools(server: { url: string; headers: Record<string, string> }, s: ToolSettings): Tool[] {
+  const fn = (name: string, description: string, properties: Record<string, unknown>, required: string[] = []): Tool => ({
+    type: "function", async: false, server,
+    function: { name: `${TOOL_PREFIX}${name}`, description, parameters: { type: "object", properties, required } },
+  });
+  const tools: Tool[] = [
+    fn("business_info", "Look up the business's approved facts (services, prices, hours, service area, policies). Use it before answering any question about the business. Never guess facts that are not returned.",
+      { question: { type: "string", description: "What the caller wants to know" } }, ["question"]),
+  ];
+  if (s.booking) {
+    tools.push(
+      fn("check_availability", "Get open appointment times. Call it before offering times. Offer two or three of the returned times.",
+        { date: { type: "string", description: "Preferred day as YYYY-MM-DD, if the caller named one" } }),
+      fn("book_appointment", "Book an appointment at one of the times returned by check_availability, after confirming the time and the caller's name.",
+        { first_name: { type: "string" }, last_name: { type: "string" }, email: { type: "string" }, phone: { type: "string", description: "Only if different from the number they are calling from" },
+          start: { type: "string", description: "The exact start value returned by check_availability" }, reason: { type: "string", description: "What the appointment is for" } },
+        ["first_name", "start"]),
+    );
+  }
+  if (s.take_messages) {
+    tools.push(fn("take_message", "Take a message for the team when you cannot help or the caller asks for a person who is unavailable.",
+      { name: { type: "string" }, reason: { type: "string", description: "What they need, in one or two sentences" }, callback_number: { type: "string", description: "Only if different from the number they are calling from" } },
+      ["name", "reason"]));
+  }
+  if (s.transfer_number) {
+    tools.push({ type: "transferCall", destinations: [{ type: "number", number: s.transfer_number, message: "One moment, I'll connect you with the team.", description: "A person on the team" }] } as Tool);
+  }
+  return tools;
+}
+
+const isOurs = (t: Tool) => !!t.function?.name?.startsWith(TOOL_PREFIX);
+
+// Pure: the PATCH body that adds our tools and webhook, keeping theirs.
+export function applyPatch(a: Assistant, tools: Tool[], server: { url: string; headers: Record<string, string> }, previous: { tools: Tool[] | null } | null) {
+  const base = previous ? previous.tools ?? [] : (a.model?.tools ?? []).filter((t) => !isOurs(t));
+  return {
+    model: { ...(a.model ?? {}), tools: [...base, ...tools] },
+    server,
+    serverMessages: Array.from(new Set([...(a.serverMessages ?? []), ...SERVER_MESSAGES])),
+  };
+}
+
+export function snapshot(a: Assistant) {
+  return { tools: (a.model?.tools ?? []).filter((t) => !isOurs(t)), server: a.server ?? null, serverMessages: a.serverMessages ?? null };
+}
+
+export const patchAssistant = (key: string, id: string, body: unknown, f?: Fetch) => vapi<Assistant>(key, "PATCH", `/assistant/${encodeURIComponent(id)}`, body, f);
+
+export function warnings(a: Assistant) {
+  const out: string[] = [];
+  const recording = a.artifactPlan?.recordingEnabled !== false;
+  if (recording && !/record/i.test(a.firstMessage || "")) {
+    out.push("Calls are recorded, but the greeting doesn't say so. Many states require telling callers (for example: \"This call may be recorded.\"). Update the first message in Vapi.");
+  }
+  if (!a.firstMessage) out.push("The assistant has no first message, so callers hear silence until they speak.");
+  return out;
+}
