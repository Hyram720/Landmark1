@@ -0,0 +1,29 @@
+import { NextResponse } from "next/server";
+import { systemClient } from "@/lib/supabase/system";
+import { handleVoiceEvent, loadAgent, SECRET_HEADER, verifySecret } from "@/lib/voice/service";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 30;
+
+// Events and tool calls from the voice provider, authenticated with the
+// per-agent secret header this platform set on the assistant.
+export async function POST(req: Request, { params }: { params: Promise<{ agentId: string }> }) {
+  const id = (await params).agentId;
+  if (!/^[0-9a-f-]{36}$/.test(id)) return NextResponse.json({ error: "Unknown agent." }, { status: 404 });
+  const system = systemClient();
+  if (!system) return NextResponse.json({ error: "Not configured." }, { status: 503 });
+  const agent = await loadAgent(system, id);
+  if (!agent || agent.status === "disabled") return NextResponse.json({ error: "Unknown agent." }, { status: 404 });
+  if (!verifySecret(agent, req.headers.get(SECRET_HEADER))) return NextResponse.json({ error: "Unauthorized." }, { status: 401 });
+  const raw = await req.text();
+  if (raw.length > 2_000_000) return NextResponse.json({ error: "Too large." }, { status: 413 });
+  let body: { message?: Record<string, unknown> };
+  try { body = JSON.parse(raw); } catch { return NextResponse.json({ error: "Invalid JSON." }, { status: 400 }); }
+  try {
+    return NextResponse.json(await handleVoiceEvent(system, agent, body as never));
+  } catch (e) {
+    console.error("[voice webhook]", id, e);
+    await system.from("voice_agents").update({ last_error: "An event could not be processed." }).eq("id", id);
+    return NextResponse.json({ error: "Processing failed." }, { status: 500 });
+  }
+}
