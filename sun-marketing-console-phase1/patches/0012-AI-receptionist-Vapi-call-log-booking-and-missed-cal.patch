+          <div className="field"><label htmlFor="vr-asst">Assistant link or ID</label><input id="vr-asst" className="input" value={f.assistant} onChange={(e) => setF({ ...f, assistant: e.target.value })} placeholder="https://dashboard.vapi.ai/assistants/…" /></div>
+          {fields}
+          <div><button className="btn btn-primary" disabled={busy || f.api_key.length < 20 || !f.assistant.trim()} onClick={() => run(() => api("/api/voice", { body: { api_key: f.api_key.trim(), assistant: f.assistant.trim(), ...settings } }), "Receptionist connected.")}>{busy ? <span className="spin" /> : "Connect"}</button></div>
+          <p className="hint">Connecting changes your Vapi assistant: it adds tools named sun_… and points its webhook here. Disconnecting puts it back.</p>
+        </div> : <div className="card-pad small muted">An admin can connect the AI receptionist.</div>}
+      </div>
+    );
+  }
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>{agent.name}</h3><div className="sub">Vapi assistant {agent.external_assistant_id.slice(0, 8)}… · key ending {agent.credential_hint}</div></div>
+        <span className={`pill ${agent.status === "active" ? "pill-ok" : "pill-warn"}`}>{agent.status === "active" ? "Answering" : "Paused"}</span></div>
+      <div className="card-pad stack">
+        <div className="small">{agent.phone_numbers.length ? <>Answers <strong>{agent.phone_numbers.map(fmtPhone).join(", ")}</strong></> : <span className="muted">No phone number is attached to this assistant in Vapi yet. Buy or import one in Vapi → Phone Numbers and assign this assistant.</span>}</div>
+        <div className="tiny muted">{agent.last_event_at ? `Last call activity ${relativeTime(agent.last_event_at)}` : "No calls yet. Call the number to test it."}</div>
+        {agent.last_error && <p className="notice notice-warn small">{agent.last_error}</p>}
+        {warn.map((w) => <p key={w} className="notice notice-warn small">{w}</p>)}
+        {fields}
+        {admin && <div className="row" style={{ flexWrap: "wrap", gap: 6 }}>
+          <button className="btn btn-sm btn-primary" disabled={busy} onClick={() => run(() => api(`/api/voice/${agent.id}`, { method: "PATCH", body: settings }), "Saved and applied to your assistant.")}>{busy ? <span className="spin" /> : "Save"}</button>
+          <button className="btn btn-sm" disabled={busy} onClick={() => run(() => api(`/api/voice/${agent.id}`, { method: "PATCH", body: { status: agent.status === "active" ? "paused" : "active" } }), agent.status === "active" ? "Paused: tools will tell callers to leave a message." : "Answering again.")}>{agent.status === "active" ? "Pause" : "Resume"}</button>
+          <button className="btn btn-sm btn-ghost" disabled={busy} onClick={() => { if (window.confirm("Disconnect? Your Vapi assistant's tools and webhook are restored to how they were.")) run(() => api(`/api/voice/${agent.id}`, { method: "DELETE" }), "Disconnected."); }}>Disconnect</button>
+        </div>}
+      </div>
+    </div>
+  );
+}
+
+function CallDetail({ c, canWrite, onChanged, toast }: { c: Call; canWrite: boolean; onChanged: () => void; toast: (m: string) => void }) {
+  const [note, setNote] = useState(c.note ?? "");
+  const [showT, setShowT] = useState(false);
+  const save = async (body: Record<string, unknown>, done: string) => { try { await api(`/api/calls/${c.id}`, { method: "PATCH", body }); toast(done); onChanged(); } catch (e) { toast(e instanceof Error ? e.message : "Could not save."); } };
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>{c.contacts ? personName(c.contacts) : fmtPhone(c.from_number)}</h3><div className="sub">{fmtPhone(c.from_number)} · {relativeTime(c.started_at || c.created_at)} · {dur(c.duration_seconds)}</div></div>
+        <span className={`pill ${OUTCOME[c.outcome].pill}`}>{OUTCOME[c.outcome].label}</span></div>
+      <div className="card-pad stack">
+        {c.summary ? <p className="small" style={{ whiteSpace: "pre-wrap" }}>{c.summary}</p> : <p className="small muted">{c.outcome === "missed" ? "The caller hung up before talking." : "No summary."}</p>}
+        <div className="row small" style={{ flexWrap: "wrap", gap: 6 }}>
+          {c.contact_id && <Link className="btn btn-sm" href={`/crm/contacts/${c.contact_id}`}>Open contact</Link>}
+          {c.contact_id && <Link className="btn btn-sm" href={`/inbox?contact=${c.contact_id}&channel=sms`}>Text them</Link>}
+          {c.appointment_id && <Link className="btn btn-sm" href="/calendars">See appointment</Link>}
+          {c.text_back_sent && <span className="pill pill-info">Missed-call text sent</span>}
+        </div>
+        {c.recording_url && <audio controls preload="none" src={c.recording_url} style={{ width: "100%" }} aria-label="Call recording" />}
+        {c.transcript && <div>
+          <button className="btn btn-sm btn-ghost" onClick={() => setShowT(!showT)}>{showT ? "Hide transcript" : "Show transcript"}</button>
+          {showT && <pre className="small" style={{ whiteSpace: "pre-wrap", maxHeight: 340, overflow: "auto", background: "var(--panel-2)", padding: 10, borderRadius: 8 }}>{c.transcript}</pre>}
+        </div>}
+        {canWrite && <div className="stack" style={{ gap: 6 }}>
+          <label className="sr-only" htmlFor={`cn-${c.id}`}>Note</label>
+          <textarea id={`cn-${c.id}`} className="textarea" rows={2} maxLength={2000} placeholder="Note for the team (e.g. called back, quoted $450)" value={note} onChange={(e) => setNote(e.target.value)} />
+          <div className="row" style={{ gap: 6 }}>
+            <button className="btn btn-sm" disabled={note === (c.note ?? "")} onClick={() => save({ note }, "Note saved.")}>Save note</button>
+            <button className="btn btn-sm btn-primary" onClick={() => save({ reviewed: !c.reviewed_at }, c.reviewed_at ? "Marked not done." : "Marked done.")}>{c.reviewed_at ? "Reopen" : "Done"}</button>
+          </div>
+        </div>}
+      </div>
+    </div>
+  );
+}
+
+function Calls({ org }: { org: Org }) {
+  const [filter, setFilter] = useState("all");
+  const [open, setOpen] = useState<string | null>(null);
+  const voice = useResource<VoiceData>("/api/voice");
+  const { data, error, loading, reload } = useResource<{ calls: Call[] }>(`/api/calls${filter === "all" ? "" : `?filter=${filter}`}`);
+  const { toast, node } = useToast();
+  useEffect(() => { const f = new URLSearchParams(window.location.search).get("filter"); if (f) setFilter(f); }, []);
+  useEffect(() => { const t = setInterval(reload, 20000); return () => clearInterval(t); }, [reload]);
+  if ((loading && !data) || (voice.loading && !voice.data)) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  const calls = data?.calls || [];
+  const current = calls.find((c) => c.id === open);
+  return (
+    <div className="split">
+      <div className="stack">
+        <div className="row" style={{ flexWrap: "wrap", gap: 6 }}>
+          {[["all", "All calls"], ["review", "Need a call back"], ["missed", "Missed"], ["booked", "Booked"], ["message", "Messages"]].map(([k, l]) => <button key={k} className={`chip ${filter === k ? "on" : ""}`} onClick={() => { setFilter(k); setOpen(null); }}>{l}</button>)}
+        </div>
+        <div className="card">
+          {calls.length === 0 ? <div className="empty"><h3>No calls here yet</h3><p className="small">Calls answered by your AI receptionist appear here with a summary, transcript and recording.</p></div> : (
+            <div className="home-list">{calls.map((c) => (
+              <button key={c.id} className={`home-item lf-row ${open === c.id ? "on" : ""}`} style={{ background: "none", border: 0, borderTop: "1px solid var(--line)", textAlign: "left", width: "100%", font: "inherit", color: "inherit", cursor: "pointer" }} onClick={() => setOpen(c.id)}>
+                <span className={`pill ${OUTCOME[c.outcome].pill}`}>{OUTCOME[c.outcome].label}</span>
+                <span className="small" style={{ minWidth: 0 }}><strong>{c.contacts ? personName(c.contacts) : fmtPhone(c.from_number)}</strong> <span className="muted home-preview">{c.summary || (c.outcome === "missed" ? "Hung up before talking" : "")}</span></span>
+                <span className="tiny muted" style={{ textAlign: "right" }}>{relativeTime(c.started_at || c.created_at)}{c.reviewed_at ? " · done" : ""}</span>
+              </button>
+            ))}</div>
+          )}
+        </div>
+      </div>
+      <div className="stack">
+        {current ? <CallDetail key={current.id} c={current} canWrite={atLeast(org.role, "member")} onChanged={reload} toast={toast} /> : null}
+        {voice.data && <Setup data={voice.data} admin={atLeast(org.role, "admin")} reload={voice.reload} toast={toast} />}
+      </div>
+      {node}
+    </div>
+  );
+}
+
+export default function CallsPage() {
+  return <TenantGate title="Calls & AI receptionist" subtitle="Every call your AI receptionist answers: what they wanted, what it did, and who needs a call back.">{(info) => <Calls org={info.org} />}</TenantGate>;
+}
