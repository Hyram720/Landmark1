diff --git a/supabase/migrations/20261014120000_voice_receptionist.sql b/supabase/migrations/20261014120000_voice_receptionist.sql
new file mode 100644
index 0000000..1771ec8
--- /dev/null
+++ b/supabase/migrations/20261014120000_voice_receptionist.sql
@@ -0,0 +1,138 @@
+-- AI receptionist: a voice agent (Vapi first, provider-agnostic) answers the
+-- business's phone, uses approved knowledge, books into calendars, takes
+-- messages and transfers. Calls are recorded here from verified webhooks.
+--   * The provider API key and the webhook secret are encrypted by the
+--     application and never readable through the API.
+--   * Calls are written only by the server; people can review and annotate.
+
+create table public.voice_agents (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  provider text not null default 'vapi' check (provider in ('vapi')),
+  name text not null default 'AI receptionist' check (length(btrim(name)) between 1 and 80),
+  encrypted_credentials text not null check (length(encrypted_credentials) between 20 and 8000),
+  credential_hint text check (length(credential_hint) <= 12),
+  external_assistant_id text not null check (external_assistant_id ~ '^[A-Za-z0-9_-]{6,80}$'),
+  phone_numbers text[] not null default '{}',
+  calendar_id uuid,
+  transfer_number text check (transfer_number ~ '^\+[1-9][0-9]{6,14}$'),
+  take_messages boolean not null default true,
+  missed_call_text boolean not null default false,
+  missed_call_message text check (length(missed_call_message) between 10 and 300),
+  -- What the assistant looked like before we added our tools, to restore on disconnect.
+  previous_config jsonb,
+  status text not null default 'active' check (status in ('active', 'paused', 'disabled')),
+  last_event_at timestamptz,
+  last_error text check (length(last_error) <= 500),
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  foreign key (calendar_id, organization_id) references public.calendars(id, organization_id) on delete set null (calendar_id)
+);
+create unique index voice_agents_assistant on public.voice_agents(provider, external_assistant_id) where status <> 'disabled';
+create trigger voice_agents_updated before update on public.voice_agents for each row execute function public.tg_set_updated_at();
+
+create or replace function public.tg_voice_agents_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    new.created_by := auth.uid(); new.last_event_at := null; new.last_error := null;
+    return new;
+  end if;
+  if new.last_event_at is distinct from old.last_event_at or new.last_error is distinct from old.last_error
+     or new.organization_id <> old.organization_id or new.provider <> old.provider or new.external_assistant_id <> old.external_assistant_id
+     or new.previous_config is distinct from old.previous_config then
+    raise exception 'These details are maintained by the server.' using errcode = '42501';
+  end if;
+  return new;
+end $$;
+create trigger voice_agents_guard before insert or update on public.voice_agents
+  for each row execute function public.tg_voice_agents_guard();
+
+create table public.calls (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  agent_id uuid,
+  provider text not null default 'vapi',
+  provider_call_id text not null check (length(provider_call_id) between 4 and 120),
+  direction text not null default 'inbound' check (direction in ('inbound', 'outbound', 'web')),
+  from_number text check (length(from_number) <= 40),
+  to_number text check (length(to_number) <= 40),
+  contact_id uuid,
+  status text not null default 'in_progress' check (status in ('in_progress', 'completed', 'missed', 'transferred', 'failed')),
+  outcome text not null default 'none' check (outcome in ('none', 'booked', 'message', 'transferred', 'info', 'missed')),
+  started_at timestamptz,
+  ended_at timestamptz,
+  duration_seconds integer check (duration_seconds between 0 and 86400),
+  ended_reason text check (length(ended_reason) <= 120),
+  summary text check (length(summary) <= 4000),
+  transcript text check (length(transcript) <= 100000),
+  recording_url text check (recording_url ~ '^https://'),
+  appointment_id uuid,
+  text_back_sent boolean not null default false,
+  reviewed_at timestamptz,
+  reviewed_by uuid,
+  note text check (length(note) <= 2000),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (provider, provider_call_id),
+  foreign key (agent_id, organization_id) references public.voice_agents(id, organization_id) on delete set null (agent_id),
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete set null (contact_id)
+);
+create index calls_org_idx on public.calls(organization_id, created_at desc);
+create index calls_contact_idx on public.calls(organization_id, contact_id, created_at desc);
+create trigger calls_updated before update on public.calls for each row execute function public.tg_set_updated_at();
+
+-- People can mark a call reviewed and add a note; the record itself is the server's.
+create or replace function public.tg_calls_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then raise exception 'Calls are recorded by the phone system.' using errcode = '42501'; end if;
+  if (to_jsonb(new) - array['reviewed_at', 'reviewed_by', 'note', 'contact_id', 'updated_at']) is distinct from (to_jsonb(old) - array['reviewed_at', 'reviewed_by', 'note', 'contact_id', 'updated_at']) then
+    raise exception 'Only the review status, note and linked contact of a call can be changed.' using errcode = '42501';
+  end if;
+  if new.reviewed_at is not null and old.reviewed_at is null then new.reviewed_by := auth.uid(); new.reviewed_at := now(); end if;
+  return new;
+end $$;
+create trigger calls_guard before insert or update on public.calls
+  for each row execute function public.tg_calls_guard();
+
+-- Finished calls go on the contact's timeline and start automations.
+create or replace function public.tg_calls_finished() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if new.status = 'in_progress' or (tg_op = 'UPDATE' and old.status <> 'in_progress') then return new; end if;
+  if new.contact_id is not null then
+    insert into public.activities(organization_id, contact_id, kind, direction, subject, body, metadata, actor_type)
+    values (new.organization_id, new.contact_id, 'call', case when new.direction = 'outbound' then 'outbound' else 'inbound' end,
+            left(case new.outcome when 'booked' then 'Call: booked an appointment' when 'message' then 'Call: left a message'
+                 when 'transferred' then 'Call: transferred to the team' when 'missed' then 'Missed call' else 'Call with the AI receptionist' end, 300),
+            left(new.summary, 20000), jsonb_build_object('call_id', new.id, 'duration_seconds', new.duration_seconds), 'system');
+    update public.contacts set last_activity_at = now() where id = new.contact_id;
+  end if;
+  perform public.emit_event(new.organization_id, 'call.completed', new.contact_id, new.id,
+    jsonb_build_object('outcome', new.outcome, 'missed', new.outcome = 'missed', 'duration_seconds', new.duration_seconds));
+  return new;
+end $$;
+create trigger calls_finished after insert or update of status on public.calls
+  for each row execute function public.tg_calls_finished();
+
+alter table public.voice_agents enable row level security;
+alter table public.calls enable row level security;
+create policy voice_agents_read on public.voice_agents for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy voice_agents_write on public.voice_agents for all to authenticated
+  using (public.org_rank(organization_id) >= 4) with check (public.org_rank(organization_id) >= 4);
+create policy calls_read on public.calls for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy calls_review on public.calls for update to authenticated using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+create policy calls_delete on public.calls for delete to authenticated using (public.org_rank(organization_id) >= 3);
+
+revoke all on public.voice_agents, public.calls from anon, authenticated;
+grant select (id, organization_id, provider, name, credential_hint, external_assistant_id, phone_numbers, calendar_id, transfer_number, take_messages,
+              missed_call_text, missed_call_message, status, last_event_at, last_error, created_by, created_at, updated_at) on public.voice_agents to authenticated;
+grant insert, update, delete on public.voice_agents to authenticated;
+grant select, update, delete on public.calls to authenticated;
+grant all on public.voice_agents, public.calls to service_role;
+revoke execute on function public.tg_calls_finished() from public, anon, authenticated;
