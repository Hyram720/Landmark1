+import { z } from "zod";
+import { ApiError, fromDb, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+
+export const dynamic = "force-dynamic";
+
+export const PATCH = tenantRoute<{ id: string }>("crm.write", async (ctx, req, { id }) => {
+  const input = await readJson(req, z.object({ reviewed: z.boolean().optional(), note: z.string().trim().max(2000).nullable().optional() }));
+  const patch: Record<string, unknown> = {};
+  if (input.reviewed !== undefined) patch.reviewed_at = input.reviewed ? new Date().toISOString() : null;
+  if (input.note !== undefined) patch.note = input.note || null;
+  const { data, error } = await ctx.client.from("calls").update(patch).eq("organization_id", ctx.org.id).eq("id", uuid.parse(id)).select("id, reviewed_at, note").maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Call not found.", 404, "not_found");
+  return { call: data };
+});
