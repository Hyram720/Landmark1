+import { ApiError, fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { publicBaseUrl, systemClient } from "@/lib/supabase/system";
+import { AGENT_COLUMNS, connectAgent, connectInput } from "@/lib/voice/service";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+export const GET = tenantRoute("crm.read", async (ctx) => {
+  const [agents, calendars] = await Promise.all([
+    ctx.client.from("voice_agents").select(AGENT_COLUMNS).eq("organization_id", ctx.org.id).neq("status", "disabled").order("created_at"),
+    ctx.client.from("calendars").select("id, name, status").eq("organization_id", ctx.org.id).order("name"),
+  ]);
+  fromDb(agents.error);
+  return { agents: agents.data || [], calendars: calendars.data || [], ready: { service_role: !!systemClient(), public_url: !!process.env.PUBLIC_APP_URL } };
+});
+
+// Connects a Vapi assistant: validates the key, adds this platform's tools
+// and webhook to the assistant, and lists its phone numbers.
+export const POST = tenantRoute("org.manage", async (ctx, req) => {
+  const input = await readJson(req, connectInput);
+  const system = systemClient();
+  const base = publicBaseUrl(req);
+  if (!system || !base) throw new ApiError("Integration not configured: SUPABASE_SERVICE_ROLE_KEY and PUBLIC_APP_URL are needed for phone calls.", 503, "integration_not_configured");
+  if (!base.startsWith("https://")) throw new ApiError("The console must be reachable over https:// for Vapi to send calls to it (PUBLIC_APP_URL).", 422, "invalid");
+  return connectAgent(ctx.client, system, ctx.org.id, input, base);
+});
