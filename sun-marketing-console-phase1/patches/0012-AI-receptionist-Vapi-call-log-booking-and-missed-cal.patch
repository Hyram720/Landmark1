+-- AI receptionist security tests: voice agents and calls.
+-- Run with scripts/test-db.sh.
+\set ON_ERROR_STOP 1
+set client_min_messages = notice;
+
+create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, false);
+  execute 'set role authenticated';
+end $$;
+create or replace function pg_temp.as_service() returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', '{"role":"service_role"}', false);
+  execute 'set role service_role';
+end $$;
+create or replace function pg_temp.reset_user() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', false);
+end $$;
+create or replace function pg_temp.expect_error(p_sql text, p_label text) returns void language plpgsql as $$
+begin
+  begin execute p_sql; exception when others then raise notice 'ok   (denied) %', p_label; return; end;
+  raise exception 'FAIL expected an error: %', p_label;
+end $$;
+create or replace function pg_temp.expect(p_ok boolean, p_label text) returns void language plpgsql as $$
+begin
+  if not coalesce(p_ok, false) then raise exception 'FAIL %', p_label; end if;
+  raise notice 'ok   %', p_label;
+end $$;
+
+-- 1 = staff owner of agency; 2 = owner of client V; 3 = member of V; 4 = owner of client W
+insert into auth.users values
+  ('63000000-0000-0000-0000-000000000001', 'staff@vr.test'), ('63000000-0000-0000-0000-000000000002', 'owner@vrv.test'),
+  ('63000000-0000-0000-0000-000000000003', 'member@vrv.test'), ('63000000-0000-0000-0000-000000000004', 'owner@vrw.test');
+insert into public.team_members(user_id, email, active) values ('63000000-0000-0000-0000-000000000001', 'staff@vr.test', true);
+create temp table ids (k text primary key, v uuid);
+grant all on ids to authenticated, service_role, anon;
+select pg_temp.as_user('63000000-0000-0000-0000-000000000001');
+insert into ids select 'a', public.create_organization('Agency VR', 'agency');
+insert into ids select 'v', public.create_organization('Client VR V', 'client', (select v from ids where k = 'a'));
+insert into ids select 'w', public.create_organization('Client VR W', 'client', (select v from ids where k = 'a'));
+select public.add_member_by_email((select v from ids where k = 'v'), 'owner@vrv.test', 'owner');
+select public.add_member_by_email((select v from ids where k = 'v'), 'member@vrv.test', 'member');
+select public.add_member_by_email((select v from ids where k = 'w'), 'owner@vrw.test', 'owner');
+select pg_temp.reset_user();
+
+-- 1. Voice agents
+select pg_temp.as_user('63000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$insert into public.voice_agents(organization_id, encrypted_credentials, external_assistant_id) values ((select v from ids where k = 'v'), repeat('x', 40), 'asst_123456')$$, 'members cannot connect a voice agent');
+select pg_temp.reset_user();
+select pg_temp.as_user('63000000-0000-0000-0000-000000000002');
+with a as (insert into public.voice_agents(organization_id, encrypted_credentials, external_assistant_id, last_event_at) values ((select v from ids where k = 'v'), repeat('x', 40), 'asst_123456', now()) returning id)
+insert into ids select 'agent', id from a;
+select pg_temp.expect((select last_event_at is null from public.voice_agents where id = (select v from ids where k = 'agent')), 'event state starts empty');
+select pg_temp.expect_error($$select encrypted_credentials from public.voice_agents$$, 'the provider key is not readable');
+select pg_temp.expect_error($$update public.voice_agents set external_assistant_id = 'asst_other1'$$, 'the assistant cannot be swapped silently');
+select pg_temp.expect_error($$update public.voice_agents set transfer_number = '555-1234'$$, 'transfer numbers must be valid');
+update public.voice_agents set transfer_number = '+18565550100', missed_call_text = true, missed_call_message = 'Sorry we missed your call! How can we help?' where id = (select v from ids where k = 'agent');
+select pg_temp.expect((select missed_call_text from public.voice_agents where id = (select v from ids where k = 'agent')), 'owners change settings');
+select pg_temp.reset_user();
+select pg_temp.as_user('63000000-0000-0000-0000-000000000004');
+select pg_temp.expect_error($$insert into public.voice_agents(organization_id, encrypted_credentials, external_assistant_id) values ((select v from ids where k = 'w'), repeat('y', 40), 'asst_123456')$$, 'one assistant cannot serve two businesses');
+select pg_temp.expect((select count(*) = 0 from public.voice_agents), 'other businesses cannot see the agent');
+select pg_temp.reset_user();
+
+-- 2. Calls
+select pg_temp.as_user('63000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$insert into public.calls(organization_id, provider_call_id) values ((select v from ids where k = 'v'), 'call-forged')$$, 'people cannot create call records');
+select pg_temp.reset_user();
+select pg_temp.as_service();
+with c as (insert into public.contacts(organization_id, first_name, phone) values ((select v from ids where k = 'v'), 'Caller', '+18565550123') returning id) insert into ids select 'contact', id from c;
+with c as (insert into public.calls(organization_id, agent_id, provider_call_id, from_number, contact_id) values ((select v from ids where k = 'v'), (select v from ids where k = 'agent'), 'call-1', '+18565550123', (select v from ids where k = 'contact')) returning id)
+insert into ids select 'call', id from c;
+select pg_temp.expect((select count(*) = 0 from public.activities where contact_id = (select v from ids where k = 'contact') and kind = 'call'), 'calls in progress are not on the timeline yet');
+update public.calls set status = 'completed', outcome = 'booked', summary = 'Booked a roof inspection for Thursday.', duration_seconds = 140, ended_at = now() where id = (select v from ids where k = 'call');
+select pg_temp.expect((select count(*) = 1 from public.activities where contact_id = (select v from ids where k = 'contact') and kind = 'call' and subject = 'Call: booked an appointment'), 'finished calls go on the timeline');
+select pg_temp.expect((select count(*) = 1 from public.domain_events where subject_id = (select v from ids where k = 'call') and type = 'call.completed' and payload ->> 'outcome' = 'booked'), 'finished calls start automations');
+select pg_temp.expect_error($$insert into public.calls(organization_id, provider_call_id) values ((select v from ids where k = 'v'), 'call-1')$$, 'each provider call is stored once');
+select pg_temp.reset_user();
+select pg_temp.as_user('63000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$update public.calls set summary = 'edited' where id = (select v from ids where k = 'call')$$, 'call records cannot be rewritten');
+update public.calls set reviewed_at = now(), note = 'Called back to confirm.' where id = (select v from ids where k = 'call');
+select pg_temp.expect((select reviewed_by = '63000000-0000-0000-0000-000000000003' from public.calls where id = (select v from ids where k = 'call')), 'members mark calls reviewed (and the reviewer is recorded)');
+delete from public.calls where id = (select v from ids where k = 'call');
+select pg_temp.expect((select count(*) = 1 from public.calls where id = (select v from ids where k = 'call')), 'members cannot delete recordings');
+select pg_temp.reset_user();
+select pg_temp.as_user('63000000-0000-0000-0000-000000000004');
+select pg_temp.expect((select count(*) = 0 from public.calls), 'other businesses cannot see calls');
+select pg_temp.reset_user();
+
+\echo 'ALL VOICE RECEPTIONIST TESTS PASSED'
