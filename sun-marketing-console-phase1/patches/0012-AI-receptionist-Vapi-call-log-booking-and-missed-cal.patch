@@ -0,0 +1,308 @@
+import "server-only";
+import { randomBytes, timingSafeEqual } from "node:crypto";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { systemAudit } from "@/lib/tenant/system-audit";
+import { hintFor, openJson, sealJson } from "@/lib/crypto/vault";
+import { toE164 } from "@/lib/comms/address";
+import { findContactByPhone, sendMessage } from "@/lib/comms/service";
+import { availability, book, findOrCreateContact, loadCalendar, notifyAppointment } from "@/lib/calendar/service";
+import { formatInZone, localDate } from "@/lib/time/zones";
+import { applyPatch, assistantNumbers, getAssistant, patchAssistant, platformTools, snapshot, TOOL_PREFIX, VapiError, warnings, type Assistant, type Tool } from "./vapi";
+
+// The AI receptionist: connects a Vapi assistant to this business, answers
+// its tool calls (facts, availability, booking, messages) and records calls.
+export const AGENT_COLUMNS = "id, organization_id, provider, name, credential_hint, external_assistant_id, phone_numbers, calendar_id, transfer_number, take_messages, missed_call_text, missed_call_message, status, last_event_at, last_error, created_at";
+export const SECRET_HEADER = "x-sun-agent-secret";
+const e164 = z.string().trim().transform((v, c) => { const n = toE164(v); if (!n) { c.addIssue({ code: "custom", message: "Enter a full phone number, like (856) 555-0100." }); return z.NEVER; } return n; });
+
+export const settingsInput = z.object({
+  name: z.string().trim().min(1).max(80).optional(),
+  calendar_id: z.string().uuid().nullable().optional(),
+  transfer_number: z.union([e164, z.literal("").transform(() => null), z.null()]).optional(),
+  take_messages: z.boolean().optional(),
+  missed_call_text: z.boolean().optional(),
+  missed_call_message: z.string().trim().min(10).max(300).nullable().optional(),
+});
+export const connectInput = settingsInput.extend({
+  api_key: z.string().trim().min(20, "Paste the private API key from Vapi.").max(200),
+  // The assistant's ID, or the whole dashboard link to it.
+  assistant: z.string().trim().max(300).transform((v, c) => {
+    const id = v.match(/assistants\/([A-Za-z0-9_-]{6,80})/)?.[1] ?? (/^[A-Za-z0-9_-]{6,80}$/.test(v) ? v : null);
+    if (!id) { c.addIssue({ code: "custom", message: "Paste the assistant's ID or its link from the Vapi dashboard." }); return z.NEVER; }
+    return id;
+  }),
+});
+
+type Creds = { api_key: string; webhook_secret: string };
+type Agent = { id: string; organization_id: string; external_assistant_id: string; calendar_id: string | null; transfer_number: string | null; take_messages: boolean; missed_call_text: boolean; missed_call_message: string | null; status: string; encrypted_credentials: string; previous_config: { tools: Tool[] | null; server: unknown; serverMessages: string[] | null } | null };
+
+export const webhookUrl = (base: string, agentId: string) => `${base}/api/webhooks/voice/${agentId}`;
+
+async function hasCalendar(system: SupabaseClient, orgId: string, calendarId: string | null) {
+  if (calendarId) return true;
+  const { data } = await system.from("calendars").select("id").eq("organization_id", orgId).eq("status", "active").limit(1).maybeSingle();
+  return !!data;
+}
+
+// Adds our tools and webhook to the assistant (keeping the owner's own tools).
+async function applyTools(system: SupabaseClient, agent: Agent, base: string, assistant?: Assistant) {
+  const creds = openJson(agent.encrypted_credentials) as Creds;
+  const a = assistant ?? (await getAssistant(creds.api_key, agent.external_assistant_id));
+  const server = { url: webhookUrl(base, agent.id), headers: { [SECRET_HEADER]: creds.webhook_secret } };
+  const tools = platformTools(server, { transfer_number: agent.transfer_number, take_messages: agent.take_messages, booking: await hasCalendar(system, agent.organization_id, agent.calendar_id) });
+  const previous = agent.previous_config ?? snapshot(a);
+  await patchAssistant(creds.api_key, agent.external_assistant_id, applyPatch(a, tools, server, previous));
+  const numbers = await assistantNumbers(creds.api_key, agent.external_assistant_id).catch(() => [] as string[]);
+  await system.from("voice_agents").update({ previous_config: previous, phone_numbers: numbers.slice(0, 20), last_error: null }).eq("id", agent.id);
+  return { warnings: warnings(a), numbers };
+}
+
+const vapiFail = (e: unknown): never => {
+  if (e instanceof VapiError) throw new ApiError(e.message, e.status === 401 ? 422 : e.status === 404 ? 404 : 502, "integration_error");
+  throw e;
+};
+
+export async function connectAgent(client: SupabaseClient, system: SupabaseClient, orgId: string, input: z.infer<typeof connectInput>, base: string) {
+  const assistant = await getAssistant(input.api_key, input.assistant).catch(vapiFail);
+  const secret = randomBytes(24).toString("hex");
+  const { api_key: _k, assistant: _a, ...settings } = input;
+  const { data, error } = await client.from("voice_agents").insert({
+    organization_id: orgId, provider: "vapi", name: settings.name || assistant.name?.slice(0, 80) || "AI receptionist",
+    encrypted_credentials: sealJson({ api_key: input.api_key, webhook_secret: secret }), credential_hint: hintFor(input.api_key),
+    external_assistant_id: input.assistant, calendar_id: settings.calendar_id ?? null, transfer_number: settings.transfer_number ?? null,
+    take_messages: settings.take_messages ?? true, missed_call_text: settings.missed_call_text ?? false, missed_call_message: settings.missed_call_message ?? null,
+  }).select("id").single();
+  if (error?.code === "23505") throw new ApiError("That assistant is already connected to an account.", 409, "conflict");
+  fromDb(error);
+  const agent = await loadAgent(system, data!.id);
+  try {
+    const r = await applyTools(system, agent!, base, assistant);
+    await audit(client, orgId, "voice.connected", { type: "voice_agent", id: data!.id }, { assistant: input.assistant });
+    return { id: data!.id, ...r };
+  } catch (e) {
+    await system.from("voice_agents").delete().eq("id", data!.id);
+    return vapiFail(e);
+  }
+}
+
+export async function loadAgent(system: SupabaseClient, id: string) {
+  const { data } = await system.from("voice_agents").select(`${AGENT_COLUMNS}, encrypted_credentials, previous_config`).eq("id", id).maybeSingle();
+  return data as Agent | null;
+}
+
+export async function updateAgent(client: SupabaseClient, system: SupabaseClient, orgId: string, id: string, input: z.infer<typeof settingsInput> & { status?: "active" | "paused" }, base: string) {
+  const { data, error } = await client.from("voice_agents").update(input).eq("organization_id", orgId).eq("id", id).neq("status", "disabled").select("id").maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Receptionist not found.", 404, "not_found");
+  const agent = await loadAgent(system, id);
+  const r = await applyTools(system, agent!, base).catch(vapiFail);
+  await audit(client, orgId, "voice.updated", { type: "voice_agent", id }, { ...input, missed_call_message: undefined });
+  return r;
+}
+
+export async function disconnectAgent(client: SupabaseClient, system: SupabaseClient, orgId: string, id: string) {
+  const agent = await loadAgent(system, id);
+  if (!agent || agent.organization_id !== orgId) throw new ApiError("Receptionist not found.", 404, "not_found");
+  let restored = true;
+  try {
+    const creds = openJson(agent.encrypted_credentials) as Creds;
+    const a = await getAssistant(creds.api_key, agent.external_assistant_id);
+    const prev = agent.previous_config ?? snapshot(a);
+    await patchAssistant(creds.api_key, agent.external_assistant_id, { model: { ...(a.model ?? {}), tools: prev.tools ?? [] }, server: prev.server ?? null, serverMessages: prev.serverMessages ?? undefined });
+  } catch { restored = false; }
+  const { error } = await client.from("voice_agents").update({ status: "disabled" }).eq("organization_id", orgId).eq("id", id);
+  fromDb(error);
+  await audit(client, orgId, "voice.disconnected", { type: "voice_agent", id }, { restored });
+  return { restored };
+}
+
+export function verifySecret(agent: Pick<Agent, "encrypted_credentials">, header: string | null) {
+  if (!header) return false;
+  let secret: string;
+  try { secret = (openJson(agent.encrypted_credentials) as Creds).webhook_secret; } catch { return false; }
+  const a = Buffer.from(header);
+  const b = Buffer.from(secret);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+// ---------------------------------------------------------------- webhooks
+type VCall = { id?: string; type?: string; customer?: { number?: string }; phoneNumber?: { number?: string }; startedAt?: string };
+type VMessage = {
+  type?: string; call?: VCall; customer?: { number?: string }; phoneNumber?: { number?: string };
+  toolCallList?: { id: string; name?: string; parameters?: Record<string, unknown>; function?: { name?: string; arguments?: string | Record<string, unknown> } }[];
+  endedReason?: string; startedAt?: string; endedAt?: string; durationSeconds?: number; recordingUrl?: string; summary?: string; transcript?: string;
+  artifact?: { transcript?: string; recordingUrl?: string; recording?: { url?: string; mono?: { combinedUrl?: string } }; messages?: { role?: string; message?: string }[] };
+  analysis?: { summary?: string };
+};
+
+const direction = (t?: string) => (t === "outboundPhoneCall" ? "outbound" : t === "webCall" ? "web" : "inbound");
+
+// Pure: what happened on a finished call.
+export function callOutcome(m: VMessage, current: string) {
+  if (current === "booked" || current === "message") return current;
+  const reason = (m.endedReason || "").toLowerCase();
+  if (/forward|transfer/.test(reason)) return "transferred";
+  const spoke = (m.artifact?.messages || []).some((x) => x.role === "user" && (x.message || "").trim().length > 1);
+  if (!spoke) return "missed";
+  return "info";
+}
+
+export function reportFields(m: VMessage) {
+  const rec = m.artifact?.recording?.mono?.combinedUrl || m.artifact?.recording?.url || m.artifact?.recordingUrl || m.recordingUrl || null;
+  const started = m.startedAt || m.call?.startedAt || null;
+  const ended = m.endedAt || null;
+  const duration = typeof m.durationSeconds === "number" ? Math.round(m.durationSeconds)
+    : started && ended ? Math.max(0, Math.round((new Date(ended).getTime() - new Date(started).getTime()) / 1000)) : null;
+  return {
+    started_at: started, ended_at: ended ?? new Date().toISOString(), duration_seconds: duration != null ? Math.min(duration, 86400) : null,
+    ended_reason: (m.endedReason || "").slice(0, 120) || null,
+    summary: (m.analysis?.summary || m.summary || "").slice(0, 4000) || null,
+    transcript: (m.artifact?.transcript || m.transcript || "").slice(0, 100000) || null,
+    recording_url: rec && rec.startsWith("https://") ? rec : null,
+  };
+}
+
+type Ctx = { client: SupabaseClient; orgId: string; userId: null };
+
+async function ensureCall(system: SupabaseClient, agent: Agent, m: VMessage) {
+  const callId = m.call?.id;
+  if (!callId) return null;
+  const { data: existing } = await system.from("calls").select("id, contact_id, outcome, status, from_number").eq("provider", "vapi").eq("provider_call_id", callId).maybeSingle();
+  if (existing) return existing as { id: string; contact_id: string | null; outcome: string; status: string; from_number: string | null };
+  const from = toE164(m.customer?.number || m.call?.customer?.number || "") || null;
+  const contact = from ? await findContactByPhone(system, agent.organization_id, from) : null;
+  const { data, error } = await system.from("calls").insert({
+    organization_id: agent.organization_id, agent_id: agent.id, provider: "vapi", provider_call_id: callId.slice(0, 120), direction: direction(m.call?.type),
+    from_number: from, to_number: (m.phoneNumber?.number || m.call?.phoneNumber?.number || "").slice(0, 40) || null, contact_id: contact?.id ?? null,
+    started_at: m.call?.startedAt ?? new Date().toISOString(), status: "in_progress", outcome: "none",
+  }).select("id, contact_id, outcome, status, from_number").single();
+  if (error?.code === "23505") return ensureCall(system, agent, m);
+  fromDb(error);
+  return data as { id: string; contact_id: string | null; outcome: string; status: string; from_number: string | null };
+}
+
+const args = (t: NonNullable<VMessage["toolCallList"]>[number]) => {
+  if (t.parameters) return t.parameters;
+  const a = t.function?.arguments;
+  if (typeof a === "string") { try { return JSON.parse(a) as Record<string, unknown>; } catch { return {}; } }
+  return a ?? {};
+};
+const str = (v: unknown, max = 200) => (typeof v === "string" ? v.trim().slice(0, max) : "");
+
+async function calendarFor(system: SupabaseClient, agent: Agent) {
+  if (agent.calendar_id) return agent.calendar_id;
+  const { data } = await system.from("calendars").select("id").eq("organization_id", agent.organization_id).eq("status", "active").order("created_at").limit(1).maybeSingle();
+  return (data?.id as string | undefined) ?? null;
+}
+
+export async function runTool(system: SupabaseClient, agent: Agent, call: { id: string; contact_id: string | null; from_number: string | null }, name: string, a: Record<string, unknown>, now = new Date()): Promise<string> {
+  const ctx: Ctx = { client: system, orgId: agent.organization_id, userId: null };
+  switch (name.replace(TOOL_PREFIX, "")) {
+    case "business_info": {
+      const q = str(a.question, 300);
+      const { data } = await system.rpc("search_knowledge", { p_org: agent.organization_id, p_query: q, p_limit: 4 });
+      let items = (data || []) as { title: string; body: string }[];
+      if (!items.length) {
+        const { data: any } = await system.from("knowledge_items").select("title, body").eq("organization_id", agent.organization_id).eq("status", "approved").limit(6);
+        items = (any || []) as { title: string; body: string }[];
+      }
+      if (!items.length) return "There is no approved information about that. Don't guess; offer to take a message so the team can answer.";
+      return items.map((i) => `${i.title}: ${i.body}`).join("\n").slice(0, 2000);
+    }
+    case "check_availability": {
+      const calId = await calendarFor(system, agent);
+      if (!calId) return "Online booking isn't set up. Offer to take a message instead.";
+      const { calendar } = await loadCalendar(system, agent.organization_id, calId);
+      const day = /^\d{4}-\d{2}-\d{2}$/.test(str(a.date)) && str(a.date) >= localDate(now, calendar.timezone) ? str(a.date) : localDate(now, calendar.timezone);
+      const { slots } = await availability(system, agent.organization_id, calId, day, 5, now);
+      if (!slots.length) return "No open times in the next few days. Offer to take a message so the team can call back.";
+      const list = slots.slice(0, 8).map((s) => ({ label: formatInZone(s.start, calendar.timezone, { weekday: "long", month: "long", day: "numeric", hour: "numeric", minute: "2-digit" }), start: s.start }));
+      return JSON.stringify({ timezone: calendar.timezone, slots: list, note: "Offer two or three labels. When booking, pass the matching start value exactly." });
+    }
+    case "book_appointment": {
+      const calId = await calendarFor(system, agent);
+      if (!calId) return "Online booking isn't set up. Offer to take a message instead.";
+      const first = str(a.first_name, 80) || "Caller";
+      const phone = toE164(str(a.phone, 40)) || call.from_number || undefined;
+      const contactId = call.contact_id ?? await findOrCreateContact(ctx, { first_name: first, last_name: str(a.last_name, 80) || undefined, email: str(a.email, 254), phone }, "Phone call (AI receptionist)");
+      try {
+        const { appointment, calendar } = await book(ctx, { calendar_id: calId, contact_id: contactId, starts_at: str(a.start, 40), notes: str(a.reason, 1000) || undefined, title: undefined }, "ai", now);
+        await system.from("calls").update({ contact_id: contactId, outcome: "booked", appointment_id: appointment.id }).eq("id", call.id);
+        call.contact_id = contactId;
+        await notifyAppointment(ctx, appointment, calendar, "booked", { system: true }).catch(() => null);
+        return `Booked for ${formatInZone(appointment.starts_at, calendar.timezone, { weekday: "long", month: "long", day: "numeric", hour: "numeric", minute: "2-digit" })}. A confirmation text is sent when possible.`;
+      } catch (e) {
+        return e instanceof ApiError ? `${e.message} Call check_availability again and offer other times.` : "Booking failed. Offer to take a message instead.";
+      }
+    }
+    case "take_message": {
+      const name = str(a.name, 80) || "Caller";
+      const reason = str(a.reason, 1000) || "Asked for a call back.";
+      const phone = toE164(str(a.callback_number, 40)) || call.from_number || undefined;
+      const contactId = call.contact_id ?? (phone || name !== "Caller" ? await findOrCreateContact(ctx, { first_name: name, email: "", phone }, "Phone call (AI receptionist)") : null);
+      await system.from("tasks").insert({ organization_id: agent.organization_id, title: `Call back ${name}${phone ? ` (${phone})` : ""}`.slice(0, 200), description: reason, priority: "high", due_at: new Date(now.getTime() + 2 * 3600e3).toISOString(), contact_id: contactId });
+      await system.from("calls").update({ contact_id: contactId, outcome: "message" }).eq("id", call.id);
+      call.contact_id = contactId;
+      return "Message taken. Tell the caller the team will call them back as soon as possible.";
+    }
+    default:
+      return "That action isn't available.";
+  }
+}
+
+async function finishCall(system: SupabaseClient, agent: Agent, m: VMessage, now: Date) {
+  const call = await ensureCall(system, agent, m);
+  if (!call) return { stored: false };
+  if (call.status !== "in_progress") return { stored: true, duplicate: true };
+  const outcome = callOutcome(m, call.outcome);
+  let contactId = call.contact_id;
+  if (!contactId && call.from_number) {
+    contactId = (await findContactByPhone(system, agent.organization_id, call.from_number))?.id ?? null;
+    if (!contactId) {
+      const { data } = await system.from("contacts").insert({ organization_id: agent.organization_id, phone: call.from_number, source: "Phone call (AI receptionist)", lifecycle_stage: "lead" }).select("id").single();
+      contactId = data?.id ?? null;
+    }
+  }
+  const { error } = await system.from("calls").update({
+    ...reportFields(m), contact_id: contactId, outcome,
+    status: outcome === "missed" ? "missed" : outcome === "transferred" ? "transferred" : "completed",
+  }).eq("id", call.id).eq("status", "in_progress");
+  fromDb(error);
+  let textBack: string | null = null;
+  if (outcome === "missed" && agent.missed_call_text && contactId && direction(m.call?.type) === "inbound") {
+    const { data: org } = await system.from("organizations").select("name").eq("id", agent.organization_id).maybeSingle();
+    const body = (agent.missed_call_message || `Hi, this is ${org?.name || "our team"}. Sorry we missed your call! How can we help? Reply here and we'll get right back to you.`).slice(0, 300);
+    try {
+      const r = await sendMessage({ client: system, orgId: agent.organization_id, userId: null }, { contact_id: contactId, channel: "sms", purpose: "transactional", body, idempotency_key: `missed-${call.id}` }, { system: true });
+      textBack = r.outcome;
+      if (r.outcome === "sent") await system.from("calls").update({ text_back_sent: true }).eq("id", call.id);
+    } catch (e) { textBack = e instanceof Error ? e.message : "failed"; }
+  }
+  await systemAudit(system, agent.organization_id, "voice.call_recorded", { type: "call", id: call.id }, { outcome, text_back: textBack });
+  return { stored: true, outcome, textBack, at: now.toISOString() };
+}
+
+export async function handleVoiceEvent(system: SupabaseClient, agent: Agent, body: { message?: VMessage }, now = new Date()) {
+  const m = body.message ?? {};
+  await system.from("voice_agents").update({ last_event_at: now.toISOString() }).eq("id", agent.id);
+  if (m.type === "tool-calls") {
+    const list = m.toolCallList || [];
+    if (agent.status !== "active") return { results: list.map((t) => ({ toolCallId: t.id, name: t.name, result: "This service is paused. Offer to take a message." })) };
+    const call = await ensureCall(system, agent, m);
+    const results = [];
+    for (const t of list.slice(0, 5)) {
+      const name = t.name || t.function?.name || "";
+      let result: string;
+      try { result = call ? await runTool(system, agent, call, name, args(t), now) : "Call details are missing."; }
+      catch (e) { console.error("[voice tool]", name, e); result = "Something went wrong. Apologize and offer to take a message."; }
+      results.push({ toolCallId: t.id, name, result });
+    }
+    return { results };
+  }
+  if (m.type === "status-update") { await ensureCall(system, agent, m); return { ok: true }; }
+  if (m.type === "end-of-call-report") return finishCall(system, agent, m, now);
+  return { ok: true };
+}
