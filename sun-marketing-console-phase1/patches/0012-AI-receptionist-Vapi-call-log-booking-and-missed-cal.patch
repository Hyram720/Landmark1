+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { FakeDb } from "../support/fake-supabase";
+import { sealJson } from "@/lib/crypto/vault";
+
+vi.mock("@/lib/comms/service", () => ({
+  findContactByPhone: vi.fn(async (client: { from: (t: string) => { select: () => { eq: (a: string, b: string) => { eq: (a: string, b: string) => { maybeSingle: () => Promise<{ data: unknown }> } } } } }, org: string, phone: string) =>
+    (await client.from("contacts").select().eq("organization_id", org).eq("phone", phone).maybeSingle()).data),
+  sendMessage: vi.fn(async () => ({ outcome: "sent" })),
+}));
+import { sendMessage } from "@/lib/comms/service";
+import { applyPatch, platformTools, snapshot, warnings } from "@/lib/voice/vapi";
+import { callOutcome, connectInput, handleVoiceEvent, reportFields, verifySecret } from "@/lib/voice/service";
+
+const ORG = "11111111-1111-4111-8111-111111111111";
+const db = (d: FakeDb) => d as unknown as SupabaseClient;
+const server = { url: "https://console.test/api/webhooks/voice/a1", headers: { "x-sun-agent-secret": "s3cret" } };
+
+beforeEach(() => vi.stubEnv("APP_ENCRYPTION_KEY", "v".repeat(40)));
+afterEach(() => { vi.unstubAllEnvs(); vi.mocked(sendMessage).mockClear(); });
+
+describe("Vapi assistant setup", () => {
+  it("adds only the tools that fit the settings", () => {
+    const names = (s: Parameters<typeof platformTools>[1]) => platformTools(server, s).map((t) => t.function?.name ?? t.type);
+    expect(names({ transfer_number: null, take_messages: false, booking: false })).toEqual(["sun_business_info"]);
+    expect(names({ transfer_number: "+18565550100", take_messages: true, booking: true })).toEqual(["sun_business_info", "sun_check_availability", "sun_book_appointment", "sun_take_message", "transferCall"]);
+    expect(platformTools(server, { transfer_number: null, take_messages: false, booking: false })[0].server).toEqual(server);
+  });
+  it("keeps the owner's own tools and settings, and re-applying doesn't duplicate ours", () => {
+    const theirs = { type: "function", function: { name: "check_weather" } };
+    const a = { id: "x", model: { provider: "openai", model: "gpt-4o", messages: [{ role: "system", content: "Be nice" }], tools: [theirs] }, serverMessages: ["hang"] };
+    const tools = platformTools(server, { transfer_number: null, take_messages: true, booking: false });
+    const first = applyPatch(a, tools, server, null);
+    expect(first.model).toMatchObject({ provider: "openai", model: "gpt-4o", messages: [{ role: "system", content: "Be nice" }] });
+    expect(first.model.tools.map((t) => t.function?.name)).toEqual(["check_weather", "sun_business_info", "sun_take_message"]);
+    expect(first.serverMessages).toEqual(["hang", "tool-calls", "end-of-call-report", "status-update"]);
+    const again = applyPatch({ ...a, model: first.model }, tools, server, snapshot({ ...a, model: first.model }));
+    expect(again.model.tools.map((t) => t.function?.name)).toEqual(["check_weather", "sun_business_info", "sun_take_message"]);
+  });
+  it("warns when recording isn't disclosed", () => {
+    expect(warnings({ id: "x", firstMessage: "Thanks for calling Acme!" })[0]).toMatch(/recorded/);
+    expect(warnings({ id: "x", firstMessage: "Thanks for calling Acme! This call may be recorded." })).toEqual([]);
+    expect(warnings({ id: "x", firstMessage: "Hi", artifactPlan: { recordingEnabled: false } })).toEqual([]);
+  });
+  it("accepts the assistant's dashboard link or ID", () => {
+    const base = { api_key: "k".repeat(36) };
+    expect(connectInput.parse({ ...base, assistant: "https://dashboard.vapi.ai/assistants/b3a5b35c-f618-4669-8003-4705da3418b3" }).assistant).toBe("b3a5b35c-f618-4669-8003-4705da3418b3");
+    expect(connectInput.parse({ ...base, assistant: "b3a5b35c-f618-4669-8003-4705da3418b3" }).assistant).toBe("b3a5b35c-f618-4669-8003-4705da3418b3");
+    expect(connectInput.safeParse({ ...base, assistant: "not an id!" }).success).toBe(false);
+    expect(connectInput.parse({ ...base, assistant: "abc123def", transfer_number: "(856) 555-0100" }).transfer_number).toBe("+18565550100");
+    expect(connectInput.safeParse({ ...base, assistant: "abc123def", transfer_number: "555" }).success).toBe(false);
+  });
+});
+
+describe("call reports", () => {
+  it("decides what happened on a call", () => {
+    expect(callOutcome({ artifact: { messages: [{ role: "assistant", message: "Hi" }] } }, "none")).toBe("missed");
+    expect(callOutcome({ artifact: { messages: [{ role: "user", message: "Do you fix gutters?" }] } }, "none")).toBe("info");
+    expect(callOutcome({ endedReason: "assistant-forwarded-call", artifact: { messages: [{ role: "user", message: "A person please" }] } }, "none")).toBe("transferred");
+    expect(callOutcome({ artifact: { messages: [] } }, "booked")).toBe("booked");
