+import { fromDb, tenantRoute } from "@/lib/tenant/api";
+
+export const dynamic = "force-dynamic";
+const COLUMNS = "id, direction, from_number, to_number, contact_id, status, outcome, started_at, ended_at, duration_seconds, ended_reason, summary, transcript, recording_url, appointment_id, text_back_sent, reviewed_at, note, created_at, contacts(first_name, last_name, phone, email)";
+
+export const GET = tenantRoute("crm.read", async (ctx, req) => {
+  const f = new URL(req.url).searchParams.get("filter");
+  let q = ctx.client.from("calls").select(COLUMNS).eq("organization_id", ctx.org.id);
+  if (f === "missed") q = q.eq("outcome", "missed");
+  else if (f === "booked") q = q.eq("outcome", "booked");
+  else if (f === "message") q = q.eq("outcome", "message");
+  else if (f === "review") q = q.is("reviewed_at", null).in("outcome", ["missed", "message"]);
+  const { data, error } = await q.order("created_at", { ascending: false }).limit(100);
+  fromDb(error);
+  return { calls: data || [] };
+});
