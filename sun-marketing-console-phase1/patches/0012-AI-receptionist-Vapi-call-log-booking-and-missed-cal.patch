+import { z } from "zod";
+import { ApiError, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { publicBaseUrl, systemClient } from "@/lib/supabase/system";
+import { disconnectAgent, settingsInput, updateAgent } from "@/lib/voice/service";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+type P = { id: string };
+
+function setup(req: Request) {
+  const system = systemClient();
+  const base = publicBaseUrl(req);
+  if (!system || !base) throw new ApiError("Integration not configured: SUPABASE_SERVICE_ROLE_KEY and PUBLIC_APP_URL are needed for phone calls.", 503, "integration_not_configured");
+  return { system, base };
+}
+
+// Settings change (re-applies the tools on the assistant), pause/resume.
+export const PATCH = tenantRoute<P>("org.manage", async (ctx, req, { id }) => {
+  const input = await readJson(req, settingsInput.extend({ status: z.enum(["active", "paused"]).optional() }));
+  const { system, base } = setup(req);
+  return updateAgent(ctx.client, system, ctx.org.id, uuid.parse(id), input, base);
+});
+
+// Removes this platform's tools from the assistant and disconnects it.
+export const DELETE = tenantRoute<P>("org.manage", async (ctx, req, { id }) => {
+  const { system } = setup(req);
+  return disconnectAgent(ctx.client, system, ctx.org.id, uuid.parse(id));
+});
