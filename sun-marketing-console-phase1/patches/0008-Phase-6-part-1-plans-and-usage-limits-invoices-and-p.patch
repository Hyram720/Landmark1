+              try { const r = await api<{ note?: string | null }>("/api/billing/stripe", { body: { secret_key: key, webhook_secret: whsec || undefined } }); setKey(""); setWhsec(""); toast(r.note || "Stripe connected."); reload(); }
+              catch (e) { toast(e instanceof Error ? e.message : "Could not connect."); } finally { setBusy(false); }
+            }}>{busy ? <span className="spin" /> : "Connect Stripe"}</button></div>
+          </> : <p className="small muted">Ask an admin to connect Stripe.</p>}
+        </>}
+      </div>
