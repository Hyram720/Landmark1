+"use client";
+import { use, useEffect, useState } from "react";
+import "@/components/public/public.css";
+
+type Data = {
+  business: string; branding: { display_name?: string; logo_url?: string; color?: string; support_email?: string; support_phone?: string };
+  customer: { name: string } | null;
+  invoice: { kind: string; number: string; status: string; currency: string; line_items: { description: string; quantity: number; unit_cents: number }[]; tax_rate_bp: number; subtotal_cents: number; tax_cents: number; total_cents: number; deposit_cents: number | null; amount_paid_cents: number; due_date: string | null; notes: string | null; created_at: string };
+  amount_due: number; can_pay: boolean;
+};
+const fmt = (c: number, cur: string) => (c / 100).toLocaleString("en-US", { style: "currency", currency: cur.toUpperCase() });
+
+export default function PublicInvoice({ params }: { params: Promise<{ token: string }> }) {
+  const { token } = use(params);
+  const [d, setD] = useState<Data | null>(null);
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [msg, setMsg] = useState("");
+  const [paidReturn, setPaidReturn] = useState(false);
+  const load = () => fetch(`/api/public/invoice/${token}`, { cache: "no-store" }).then(async (r) => { const j = await r.json(); if (!r.ok) throw new Error(j.error || "Not available."); setD(j); }).catch((e) => setError(e.message));
+  useEffect(() => { setPaidReturn(new URLSearchParams(window.location.search).has("paid")); load(); }, [token]); // eslint-disable-line react-hooks/exhaustive-deps
+  const post = async (action: string) => {
+    setBusy(true); setMsg("");
+    try {
+      const r = await fetch(`/api/public/invoice/${token}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action }) });
+      const j = await r.json();
+      if (!r.ok) throw new Error(j.error || "That did not work.");
+      if (j.url) { window.location.href = j.url; return; }
+      setMsg(action === "accept" ? "Thank you! We'll be in touch to schedule the work." : "Thanks for letting us know."); await load();
+    } catch (e) { setMsg(e instanceof Error ? e.message : "That did not work."); }
+    finally { setBusy(false); }
+  };
+  if (error) return <div className="pub"><div className="pub-card narrow"><h1>Not available</h1><p className="lead">{error}</p></div></div>;
+  if (!d) return <div className="pub"><div className="pub-card narrow"><p className="lead">Loading…</p></div></div>;
+  const i = d.invoice;
+  const name = d.branding.display_name || d.business;
+  const est = i.kind === "estimate";
+  const accent = d.branding.color || "#f97316";
+  return (
+    <div className="pub">
+      <div className="pub-card">
+        <div className="row" style={{ justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: 12 }}>
+          <div>{d.branding.logo_url ? <img src={d.branding.logo_url} alt={name} style={{ maxHeight: 48, maxWidth: 180 }} /> : <strong style={{ fontSize: 18 }}>{name}</strong>}
+            <div className="lead" style={{ marginBottom: 0, fontSize: 13 }}>{[d.branding.support_phone, d.branding.support_email].filter(Boolean).join(" · ")}</div></div>
+          <div style={{ textAlign: "right" }}><h1 style={{ marginBottom: 2 }}>{est ? "Estimate" : "Invoice"} {i.number}</h1>
+            <div className="lead" style={{ marginBottom: 0, fontSize: 13 }}>{new Date(i.created_at).toLocaleDateString("en-US")}{i.due_date ? ` · Due ${i.due_date}` : ""}{d.customer?.name ? ` · For ${d.customer.name}` : ""}</div></div>
+        </div>
+        <table style={{ width: "100%", borderCollapse: "collapse", margin: "18px 0", fontSize: 14 }}>
+          <thead><tr style={{ textAlign: "left", color: "#7a7266", fontSize: 12 }}><th style={{ padding: "6px 0" }}>Description</th><th>Qty</th><th style={{ textAlign: "right" }}>Amount</th></tr></thead>
+          <tbody>{i.line_items.map((l, k) => <tr key={k} style={{ borderTop: "1px solid #eee" }}><td style={{ padding: "8px 0" }}>{l.description}</td><td>{l.quantity}</td><td style={{ textAlign: "right" }}>{fmt(Math.round(l.quantity * l.unit_cents), i.currency)}</td></tr>)}</tbody>
+        </table>
+        <div style={{ marginLeft: "auto", maxWidth: 260, fontSize: 14, display: "grid", gridTemplateColumns: "1fr auto", gap: 6 }}>
+          <span>Subtotal</span><span>{fmt(i.subtotal_cents, i.currency)}</span>
+          {i.tax_cents > 0 && <><span>Tax ({i.tax_rate_bp / 100}%)</span><span>{fmt(i.tax_cents, i.currency)}</span></>}
+          <strong>Total</strong><strong>{fmt(i.total_cents, i.currency)}</strong>
+          {!est && i.amount_paid_cents > 0 && <><span>Paid</span><span>{fmt(i.amount_paid_cents, i.currency)}</span></>}
+          {!est && i.status !== "paid" && i.status !== "void" && <><strong>Due now</strong><strong>{fmt(d.amount_due, i.currency)}</strong></>}
+        </div>
+        {i.notes && <p className="lead" style={{ whiteSpace: "pre-wrap", marginTop: 16, fontSize: 14 }}>{i.notes}</p>}
+        <div className="stack" style={{ marginTop: 18 }}>
+          {i.status === "paid" && <p className="notice" role="status">Paid in full. Thank you!</p>}
+          {i.status === "void" && <p className="notice">This {est ? "estimate" : "invoice"} was cancelled.</p>}
+          {paidReturn && i.status !== "paid" && !est && <p className="notice" role="status">Thanks! Your payment is being confirmed; this page will show it shortly.</p>}
+          {d.can_pay && d.amount_due > 0 && <button className="btn btn-primary" style={{ background: accent, borderColor: accent }} disabled={busy} onClick={() => post("pay")}>{busy ? "Opening secure payment…" : `Pay ${fmt(d.amount_due, i.currency)}${i.deposit_cents && i.amount_paid_cents === 0 && d.amount_due < i.total_cents ? " deposit" : ""} by card`}</button>}
+          {!est && !d.can_pay && ["sent", "partially_paid"].includes(i.status) && <p className="lead" style={{ fontSize: 13 }}>Online payment isn&apos;t available for this invoice. Please contact {name} to pay.</p>}
+          {est && i.status === "sent" && <div className="row" style={{ justifyContent: "center", flexWrap: "wrap" }}><button className="btn btn-primary" style={{ background: accent, borderColor: accent }} disabled={busy} onClick={() => post("accept")}>Accept estimate</button><button className="btn" disabled={busy} onClick={() => post("decline")}>Decline</button></div>}
+          {est && ["accepted", "declined"].includes(i.status) && <p className="notice">You {i.status} this estimate.</p>}
+          {msg && <p className="lead" role="status">{msg}</p>}
+        </div>
+      </div>
+      <p className="foot">Payments are processed securely by Stripe on behalf of {name}.</p>
+    </div>
+  );
+}
