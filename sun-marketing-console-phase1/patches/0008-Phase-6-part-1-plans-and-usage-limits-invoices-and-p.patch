new file mode 100644
index 0000000..67f3e6e
--- /dev/null
+++ b/src/lib/sites/domains.ts
@@ -0,0 +1,62 @@
+import "server-only";
+import { resolveTxt } from "node:dns/promises";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import type { CrmContext } from "@/lib/crm/service";
+
+// Custom domains for hosted sites. Ownership is proven with a DNS TXT record
+// at _sun-verify.<domain>; only the server (service role) marks a domain
+// verified, after it has looked the record up itself.
+export const domainInput = z.object({
+  domain: z.string().trim().toLowerCase().transform((v) => v.replace(/^https?:\/\//, "").replace(/\/.*$/, ""))
+    .pipe(z.string().regex(/^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/, "Enter a domain like www.yourbusiness.com.").max(253)),
+});
+
+const RESERVED = /(^|\.)(netlify\.app|netlify\.live|localhost|supabase\.co|vercel\.app)$/;
+
+export async function listDomains(ctx: CrmContext, siteId: string) {
+  const { data, error } = await ctx.client.from("site_domains").select("id, domain, verification_token, status, verified_at, last_checked_at, created_at")
+    .eq("organization_id", ctx.orgId).eq("site_id", siteId).order("created_at");
+  fromDb(error);
+  return data || [];
+}
+
+export async function addDomain(ctx: CrmContext, siteId: string, input: z.infer<typeof domainInput>) {
+  if (RESERVED.test(input.domain)) throw new ApiError("Use a domain you own.", 422, "invalid");
+  const { data, error } = await ctx.client.from("site_domains").insert({ organization_id: ctx.orgId, site_id: siteId, domain: input.domain })
+    .select("id, domain, verification_token, status").single();
+  if (error?.code === "23505") throw new ApiError("That domain is already connected to a site.", 409, "conflict");
+  fromDb(error);
+  await audit(ctx.client, ctx.orgId, "site.domain_added", { type: "site", id: siteId }, { domain: input.domain });
+  return data!;
+}
+
+export async function removeDomain(ctx: CrmContext, id: string) {
+  const { error } = await ctx.client.from("site_domains").delete().eq("organization_id", ctx.orgId).eq("id", id);
+  fromDb(error);
+}
+
+export type TxtLookup = (name: string) => Promise<string[][]>;
+
+export async function verifyDomain(ctx: CrmContext, system: SupabaseClient | null, id: string, lookup: TxtLookup = resolveTxt) {
+  const { data: d, error } = await ctx.client.from("site_domains").select("id, site_id, domain, verification_token, status").eq("organization_id", ctx.orgId).eq("id", id).maybeSingle();
+  fromDb(error);
+  if (!d) throw new ApiError("Domain not found.", 404, "not_found");
+  if (d.status === "verified") return { verified: true, message: "Already verified." };
+  if (!system) throw new ApiError("Integration not configured: SUPABASE_SERVICE_ROLE_KEY is needed to verify domains.", 503, "integration_not_configured");
+  let records: string[] = [];
+  try {
+    records = (await lookup(`_sun-verify.${d.domain}`)).map((parts) => parts.join(""));
+  } catch {
+    records = [];
+  }
+  const ok = records.includes(d.verification_token);
+  await system.from("site_domains").update({ last_checked_at: new Date().toISOString(), ...(ok ? { status: "verified", verified_at: new Date().toISOString() } : {}) })
+    .eq("organization_id", ctx.orgId).eq("id", id);
+  if (ok) await audit(ctx.client, ctx.orgId, "site.domain_verified", { type: "site", id: d.site_id }, { domain: d.domain });
+  return ok
+    ? { verified: true, message: "Verified. Point the domain at the console (see the DNS steps) and it will serve your published site." }
+    : { verified: false, message: records.length ? "A TXT record was found but it doesn't match. Check the value and try again." : "No TXT record found yet. DNS changes can take up to an hour." };
+}
