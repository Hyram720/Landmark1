+-- Phase 6 security tests: governance, plans and limits, invoices and payments, domains.
+-- Run with scripts/test-db.sh.
+\set ON_ERROR_STOP 1
+set client_min_messages = notice;
+
+create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, false);
+  execute 'set role authenticated';
+end $$;
+create or replace function pg_temp.as_service() returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', '{"role":"service_role"}', false);
+  execute 'set role service_role';
+end $$;
+create or replace function pg_temp.reset_user() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', false);
+end $$;
+create or replace function pg_temp.expect_error(p_sql text, p_label text) returns void language plpgsql as $$
+begin
+  begin execute p_sql; exception when others then raise notice 'ok   (denied) %', p_label; return; end;
+  raise exception 'FAIL expected an error: %', p_label;
+end $$;
+create or replace function pg_temp.expect(p_ok boolean, p_label text) returns void language plpgsql as $$
+begin
+  if not coalesce(p_ok, false) then raise exception 'FAIL %', p_label; end if;
+  raise notice 'ok   %', p_label;
+end $$;
+
+-- 1 = owner of agency X (staff), 2 = member of client C, 3 = owner/admin of client C (not staff), 4 = owner of agency Y (staff), 5 = manager of C
+insert into auth.users values
+  ('60000000-0000-0000-0000-000000000001', 'owner@p6x.test'), ('60000000-0000-0000-0000-000000000002', 'member@p6c.test'),
+  ('60000000-0000-0000-0000-000000000003', 'admin@p6c.test'), ('60000000-0000-0000-0000-000000000004', 'owner@p6y.test'),
+  ('60000000-0000-0000-0000-000000000005', 'manager@p6c.test'), ('60000000-0000-0000-0000-000000000006', 'admin@p6y.test');
+insert into public.team_members(user_id, email, active) values
+  ('60000000-0000-0000-0000-000000000001', 'owner@p6x.test', true), ('60000000-0000-0000-0000-000000000004', 'owner@p6y.test', true);
+create temp table ids (k text primary key, v uuid);
+grant all on ids to authenticated, service_role, anon;
+select pg_temp.as_user('60000000-0000-0000-0000-000000000001');
+insert into ids select 'x', public.create_organization('Agency P6X', 'agency');
+insert into ids select 'c', public.create_organization('Client P6C', 'client', (select v from ids where k = 'x'));
+select public.add_member_by_email((select v from ids where k = 'c'), 'admin@p6c.test', 'owner');
+select public.add_member_by_email((select v from ids where k = 'c'), 'member@p6c.test', 'member');
+select public.add_member_by_email((select v from ids where k = 'c'), 'manager@p6c.test', 'manager');
+select pg_temp.reset_user();
+select pg_temp.as_user('60000000-0000-0000-0000-000000000004');
+insert into ids select 'y', public.create_organization('Agency P6Y', 'agency');
+select public.add_member_by_email((select v from ids where k = 'y'), 'admin@p6y.test', 'admin');
+select pg_temp.reset_user();
+
+-- 1. Governance (security fix)
+select pg_temp.as_user('60000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$update public.organizations set parent_id = (select v from ids where k = 'y') where id = (select v from ids where k = 'c')$$,
+  'a client admin cannot move the account to another agency');
+select pg_temp.expect_error($$update public.organizations set plan = 'pro' where id = (select v from ids where k = 'c')$$, 'a client admin cannot change their own plan');
+select pg_temp.expect_error($$select public.govern_organization((select v from ids where k = 'c'), null, 'pro')$$, 'a client owner cannot govern their own account');
+update public.organizations set timezone = 'America/Chicago' where id = (select v from ids where k = 'c');
+select pg_temp.expect(true, 'client admins can still change ordinary settings');
+select pg_temp.reset_user();
+select pg_temp.as_user('60000000-0000-0000-0000-000000000006');
+select pg_temp.expect_error($$select public.govern_organization((select v from ids where k = 'c'), 'suspended')$$, 'another agency''s admin cannot govern the client');
+select pg_temp.reset_user();
+select pg_temp.as_user('60000000-0000-0000-0000-000000000001');
+select public.govern_organization((select v from ids where k = 'c'), null, 'starter');
+select pg_temp.expect((select plan = 'starter' from public.organizations where id = (select v from ids where k = 'c')), 'the managing agency sets the client plan');
+select pg_temp.reset_user();
+
+-- 2. Limits and metering (starter: 3 users already reached? owner+member+manager = 3)
+select pg_temp.as_user('60000000-0000-0000-0000-000000000001');
+select pg_temp.expect_error($$select public.add_member_by_email((select v from ids where k = 'c'), 'owner@p6y.test', 'viewer')$$, 'user limit is enforced');
+update public.plans set limits = limits || '{"contacts": 2, "sms": 1}' where key = 'starter';
+select pg_temp.reset_user();
+select pg_temp.as_user('60000000-0000-0000-0000-000000000002');
+insert into public.contacts(organization_id, first_name, phone) values ((select v from ids where k = 'c'), 'A', '+18565550101'), ((select v from ids where k = 'c'), 'B', '+18565550102');
+select pg_temp.expect_error($$insert into public.contacts(organization_id, first_name) values ((select v from ids where k = 'c'), 'C')$$, 'contact limit is enforced');
+update public.plans set limits = '{}' where key = 'starter';
+select pg_temp.expect((select limits ? 'contacts' from public.plans where key = 'starter'), 'clients cannot edit platform plans');
+select pg_temp.expect((select count(*) = 7 from public.org_usage((select v from ids where k = 'c'))), 'members can see their usage');
+select pg_temp.reset_user();
+select pg_temp.as_service();
+with cv as (insert into public.conversations(organization_id, contact_id, channel) values ((select v from ids where k = 'c'), (select id from public.contacts where first_name = 'A' and organization_id = (select v from ids where k = 'c')), 'sms') returning id)
+insert into ids select 'conv', id from cv;
+with m as (insert into public.messages(organization_id, conversation_id, contact_id, channel, direction, body, status)
+  values ((select v from ids where k = 'c'), (select v from ids where k = 'conv'), (select id from public.contacts where first_name = 'A' and organization_id = (select v from ids where k = 'c')), 'sms', 'outbound', 'Hi', 'queued') returning id)
+insert into ids select 'msg', id from m;
+update public.messages set status = 'sending' where id = (select v from ids where k = 'msg');
+update public.messages set status = 'sent' where id = (select v from ids where k = 'msg');
+select pg_temp.expect((select count(*) = 1 from public.usage_events where organization_id = (select v from ids where k = 'c') and metric = 'sms'), 'sent texts are metered');
+select pg_temp.expect_error($$insert into public.messages(organization_id, conversation_id, contact_id, channel, direction, body, status)
+  values ((select v from ids where k = 'c'), (select v from ids where k = 'conv'), (select id from public.contacts where first_name = 'A' and organization_id = (select v from ids where k = 'c')), 'sms', 'outbound', 'Again', 'queued')$$,
+  'monthly text limit is enforced, even for automations');
+select pg_temp.reset_user();
+select pg_temp.as_user('60000000-0000-0000-0000-000000000001');
+update public.plans set limits = limits - 'contacts' - 'sms' where key = 'starter';
+select pg_temp.reset_user();
+
+-- 3. Invoices and payments
+select pg_temp.as_user('60000000-0000-0000-0000-000000000002');
+with i as (insert into public.invoices(organization_id, line_items, tax_rate_bp, status, amount_paid_cents, total_cents)
+  values ((select v from ids where k = 'c'), '[{"description":"Roof repair","quantity":2,"unit_cents":15000},{"description":"Permit","quantity":1,"unit_cents":5000}]', 650, 'paid', 999999, 1) returning id)
+insert into ids select 'inv', id from i;
+select pg_temp.expect((select status = 'draft' and amount_paid_cents = 0 and subtotal_cents = 35000 and tax_cents = 2275 and total_cents = 37275 and number = 'INV-0001'
+  from public.invoices where id = (select v from ids where k = 'inv')), 'totals and numbers come from the database, not the client');
+select pg_temp.expect_error($$insert into public.invoices(organization_id, line_items) values ((select v from ids where k = 'c'), '[{"description":"Free money","quantity":-1,"unit_cents":100}]')$$,
+  'negative quantities are rejected');
+select pg_temp.expect_error($$update public.invoices set amount_paid_cents = 37275 where id = (select v from ids where k = 'inv')$$, 'staff cannot mark an invoice paid by editing it');
+select pg_temp.expect_error($$insert into public.payments(organization_id, invoice_id, amount_cents, method) values ((select v from ids where k = 'c'), (select v from ids where k = 'inv'), 100, 'manual')$$,
+  'members cannot record payments');
+update public.invoices set status = 'sent' where id = (select v from ids where k = 'inv');
+select pg_temp.expect_error($$update public.invoices set line_items = '[{"description":"x","quantity":1,"unit_cents":1}]' where id = (select v from ids where k = 'inv')$$, 'sent invoices cannot be edited');
+select pg_temp.reset_user();
+select pg_temp.as_user('60000000-0000-0000-0000-000000000005');
+select pg_temp.expect_error($$insert into public.payments(organization_id, invoice_id, amount_cents, method, provider_payment_id) values ((select v from ids where k = 'c'), (select v from ids where k = 'inv'), 100, 'stripe', 'pi_fake')$$,
+  'card payments cannot be faked through the API');
+insert into public.payments(organization_id, invoice_id, amount_cents, method, note) values ((select v from ids where k = 'c'), (select v from ids where k = 'inv'), 10000, 'manual', 'Check #1001');
+select pg_temp.expect((select status = 'partially_paid' and amount_paid_cents = 10000 from public.invoices where id = (select v from ids where k = 'inv')), 'a partial payment marks the invoice partially paid');
+select pg_temp.reset_user();
+select pg_temp.as_service();
+insert into public.payments(organization_id, invoice_id, amount_cents, method, provider_payment_id) values ((select v from ids where k = 'c'), (select v from ids where k = 'inv'), 27275, 'stripe', 'pi_123');
+select pg_temp.expect_error($$insert into public.payments(organization_id, invoice_id, amount_cents, method, provider_payment_id) values ((select v from ids where k = 'c'), (select v from ids where k = 'inv'), 27275, 'stripe', 'pi_123')$$,
