+  );
+}
+
+function Branding({ manage, toast }: { manage: boolean; toast: (m: string) => void }) {
+  const { data } = useResource<{ branding: Record<string, string> }>("/api/organization/branding");
+  const [b, setB] = useState<Record<string, string> | null>(null);
+  const v = b ?? data?.branding ?? {};
+  const set = (k: string, val: string) => setB({ ...v, [k]: val });
+  const fields: [string, string, string][] = [["display_name", "Business name shown to customers", "Smith Plumbing"], ["logo_url", "Logo image address (https)", "https://…/logo.png"], ["color", "Brand color", "#f97316"], ["support_email", "Support email", "hello@…"], ["support_phone", "Support phone", "(555) 555-0100"]];
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>Branding</h3><div className="sub">Used on invoices, estimates and other customer pages.</div></div></div>
+      <div className="card-pad stack">
+        <div className="field-grid">{fields.map(([k, label, ph]) => <div key={k} className="field"><label htmlFor={`br-${k}`}>{label}</label><input id={`br-${k}`} className="input" disabled={!manage} placeholder={ph} value={v[k] ?? ""} onChange={(e) => set(k, e.target.value)} /></div>)}</div>
+        {manage && <div><button className="btn btn-sm btn-primary" disabled={!b} onClick={async () => {
+          const body = Object.fromEntries(Object.entries(v).filter(([, x]) => x && String(x).trim()));
+          try { await api("/api/organization/branding", { method: "PUT", body }); setB(null); toast("Branding saved."); } catch (e) { toast(e instanceof Error ? e.message : "Could not save."); }
+        }}>Save branding</button></div>}
+      </div>
+    </div>
+  );
+}
+
+function Account({ org }: { org: Org }) {
+  const { data, error, loading, reload } = useResource<Billing>("/api/billing");
+  const { toast, node } = useToast();
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return null;
+  const manage = atLeast(org.role, "admin");
+  return (
+    <div className="stack">
+      {data.status === "suspended" && <div className="notice notice-warn small"><strong>This account is suspended.</strong> Contact your provider to reactivate. You can still export your data below.</div>}
+      <div className="card">
+        <div className="card-head"><div><h3>Plan: {data.plan.key === "internal" ? "Unlimited" : data.plan.name}</h3><div className="sub">{data.plan.key === "internal" ? "No plan limits apply to this account." : `${usd(data.plan.price_cents)}/month. When a limit is reached, that action pauses until next month or a plan change.`}</div></div></div>
+        <div className="card-pad stack">{data.usage.map((u) => <Meter key={u.metric} u={u} />)}</div>
+      </div>
+      {data.agency && <Agency b={data.agency} reload={reload} toast={toast} />}
+      <Payments manage={manage} toast={toast} />
+      <Branding manage={manage} toast={toast} />
+      <div className="card card-pad row" style={{ justifyContent: "space-between", flexWrap: "wrap" }}>
+        <div><strong>Export all data</strong><div className="small muted">Download every contact, conversation, invoice, page and record as JSON. Owners and admins only.</div></div>
+        <a className="btn btn-sm" href="/api/organization/export">Download export</a>
+      </div>
+      {node}
+    </div>
+  );
+}
+
+export default function AccountPage() {
+  return <TenantGate title="Plan & account" subtitle="Usage, client plans, payments, branding and data export.">{(info) => <Account org={info.org} />}</TenantGate>;
+}
