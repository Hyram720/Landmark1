+import "server-only";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import type { CrmContext } from "@/lib/crm/service";
+
+// Plans, limits and usage. Limits are enforced by the database; this module
+// shows them and lets agencies manage plans for their client accounts.
+export const METRICS = {
+  sms: { label: "Text messages", period: "month" },
+  email: { label: "Emails", period: "month" },
+  ai_request: { label: "AI requests", period: "month" },
+  outreach_email: { label: "Outreach emails", period: "month" },
+  contacts: { label: "Contacts", period: "total" },
+  users: { label: "Team members", period: "total" },
+  sites: { label: "Websites", period: "total" },
+} as const;
+export type Metric = keyof typeof METRICS;
+
+export const planInput = z.object({
+  key: z.string().trim().toLowerCase().regex(/^[a-z0-9][a-z0-9-]{1,40}$/, "Use lowercase letters, numbers and dashes."),
+  name: z.string().trim().min(1).max(80),
+  description: z.string().trim().max(500).optional(),
+  price_cents: z.number().int().min(0).max(100_000_00),
+  limits: z.partialRecord(z.enum(Object.keys(METRICS) as [Metric, ...Metric[]]), z.number().int().min(0).max(10_000_000)).default({}),
+  active: z.boolean().default(true),
+});
+
+export async function usage(ctx: CrmContext) {
+  const [u, org] = await Promise.all([
+    ctx.client.rpc("org_usage", { p_org: ctx.orgId }),
+    ctx.client.from("organizations").select("plan, status, kind, parent_id").eq("id", ctx.orgId).maybeSingle(),
+  ]);
+  fromDb(u.error);
+  fromDb(org.error);
+  const { data: plan } = await ctx.client.from("plans").select("key, name, description, price_cents, currency, limits, owner_org_id").eq("key", org.data?.plan ?? "internal").maybeSingle();
+  return {
+    plan: plan ?? { key: org.data?.plan, name: org.data?.plan, limits: {} },
+    status: org.data?.status,
+    usage: ((u.data || []) as { metric: Metric; used: number; limit: number | null }[]).map((r) => ({ ...r, label: METRICS[r.metric].label, period: METRICS[r.metric].period })),
+  };
+}
+
+// Plans an agency may assign to its clients: platform plans plus its own.
+export async function availablePlans(ctx: CrmContext, agencyId: string) {
+  const { data, error } = await ctx.client.from("plans").select("key, name, description, price_cents, currency, limits, owner_org_id, active")
+    .or(`owner_org_id.is.null,owner_org_id.eq.${agencyId}`).eq("active", true).order("price_cents");
+  fromDb(error);
+  return (data || []).filter((p) => p.key !== "internal");
+}
+
+export async function savePlan(ctx: CrmContext, agencyId: string, input: z.infer<typeof planInput>) {
+  const key = `${input.key}`;
+  const { data: existing } = await ctx.client.from("plans").select("key, owner_org_id").eq("key", key).maybeSingle();
+  if (existing && existing.owner_org_id !== agencyId) throw new ApiError("That plan key is taken. Choose another.", 409, "conflict");
+  const row = { ...input, owner_org_id: agencyId };
+  const { error } = existing ? await ctx.client.from("plans").update(row).eq("key", key) : await ctx.client.from("plans").insert(row);
+  fromDb(error);
+  await audit(ctx.client, agencyId, existing ? "plan.updated" : "plan.created", { type: "plan", id: key }, { price_cents: input.price_cents });
+  return row;
+}
+
+// Client accounts of an agency with plan, status and current usage.
+export async function clientAccounts(ctx: CrmContext, agencyId: string) {
+  const { data, error } = await ctx.client.from("organizations").select("id, name, status, plan, created_at").eq("parent_id", agencyId).order("name");
+  fromDb(error);
+  const rows = [];
+  for (const o of data || []) {
+    const { data: u } = await ctx.client.rpc("org_usage", { p_org: o.id });
+    rows.push({ ...o, usage: (u || []) as { metric: Metric; used: number; limit: number | null }[] });
+  }
+  return rows;
+}
+
+export async function govern(ctx: CrmContext, orgId: string, change: { status?: "active" | "suspended" | "closed"; plan?: string }) {
+  const { error } = await ctx.client.rpc("govern_organization", { p_org: orgId, p_status: change.status ?? null, p_plan: change.plan ?? null });
+  fromDb(error);
+}
