+}
+
+function Invoices({ org }: { org: Org }) {
+  const [kind, setKind] = useState<"invoice" | "estimate">("invoice");
+  const { data, error, loading, reload } = useResource<{ invoices: Inv[] }>(`/api/invoices?kind=${kind}`);
+  const stripe = useResource<{ account: { label: string } | null }>("/api/billing/stripe");
+  const [open, setOpen] = useState<string | null>(null);
+  const [editing, setEditing] = useState<Detail | "new" | null>(null);
+  const { toast, node } = useToast();
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  const rows = data?.invoices || [];
+  const outstanding = rows.filter((i) => ["sent", "partially_paid"].includes(i.status)).reduce((s, i) => s + i.total_cents - i.amount_paid_cents, 0);
+  return (
+    <div className="stack">
+      {stripe.data && !stripe.data.account && <div className="notice notice-warn small"><strong>Online card payments: integration not configured.</strong> Connect your Stripe account in <a className="link" href="/account">Account</a>. You can still send invoices and record cash or check payments.</div>}
+      <div className="row" style={{ flexWrap: "wrap" }}>
