+
+function Payments({ manage, toast }: { manage: boolean; toast: (m: string) => void }) {
+  const { data, reload } = useResource<{ account: { label: string | null; credential_hint: string | null; created_at: string } | null; webhook_url: string | null }>("/api/billing/stripe");
