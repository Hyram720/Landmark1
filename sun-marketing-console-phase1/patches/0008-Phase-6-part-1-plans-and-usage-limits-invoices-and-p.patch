diff --git a/src/lib/billing/invoices.ts b/src/lib/billing/invoices.ts
new file mode 100644
index 0000000..c5a673c
--- /dev/null
+++ b/src/lib/billing/invoices.ts
@@ -0,0 +1,248 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import type Stripe from "stripe";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { systemAudit } from "@/lib/tenant/system-audit";
+import type { CrmContext } from "@/lib/crm/service";
+import { sendMessage } from "@/lib/comms/service";
+import { openJson } from "@/lib/crypto/vault";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { activeStripe, stripeFor, type StripeCreds } from "@/lib/payments/stripe-accounts";
+
+// Invoices and estimates. Totals and paid amounts are computed by the
+// database; this module drafts, sends, collects and refunds.
+export const INVOICE_COLUMNS =
+  "id, organization_id, kind, number, contact_id, status, currency, line_items, tax_rate_bp, subtotal_cents, tax_cents, total_cents, deposit_cents, amount_paid_cents, due_date, notes, source_estimate_id, sent_at, paid_at, decided_at, created_at, updated_at";
+export type Invoice = {
+  id: string; organization_id: string; kind: "invoice" | "estimate"; number: string; contact_id: string | null; status: string; currency: string;
+  line_items: { description: string; quantity: number; unit_cents: number }[]; tax_rate_bp: number; subtotal_cents: number; tax_cents: number; total_cents: number;
+  deposit_cents: number | null; amount_paid_cents: number; due_date: string | null; notes: string | null; source_estimate_id: string | null;
+  sent_at: string | null; paid_at: string | null; decided_at: string | null; created_at: string;
+};
+
+const line = z.object({ description: z.string().trim().min(1).max(300), quantity: z.number().positive().max(100000), unit_cents: z.number().int().min(0).max(100_000_000) });
+export const invoiceInput = z.object({
+  kind: z.enum(["invoice", "estimate"]).default("invoice"),
+  contact_id: z.string().uuid().nullable().optional(),
+  line_items: z.array(line).min(1, "Add at least one line.").max(100),
+  tax_rate_bp: z.number().int().min(0).max(5000).default(0),
+  deposit_cents: z.number().int().min(0).nullable().optional(),
+  due_date: z.string().regex(/^\d{4}-\d{2}-\d{2}$/).nullable().optional(),
+  notes: z.string().trim().max(4000).nullable().optional(),
+});
+
+// Same arithmetic as the database, for previews.
+export function computeTotals(items: { quantity: number; unit_cents: number }[], taxBp: number) {
+  const subtotal = items.reduce((s, i) => s + Math.round(i.quantity * i.unit_cents), 0);
+  const tax = Math.round((subtotal * taxBp) / 10000);
+  return { subtotal, tax, total: subtotal + tax };
+}
+
+// What the customer owes right now: the deposit first if one is set and
+// nothing is paid yet, otherwise the balance.
+export function amountDue(inv: Pick<Invoice, "total_cents" | "amount_paid_cents" | "deposit_cents">) {
+  const balance = Math.max(0, inv.total_cents - inv.amount_paid_cents);
+  if (inv.deposit_cents && inv.amount_paid_cents === 0) return Math.min(inv.deposit_cents, balance);
+  return balance;
+}
+
+export const money = (cents: number, currency = "usd") => (cents / 100).toLocaleString("en-US", { style: "currency", currency: currency.toUpperCase() });
+
+export async function listInvoices(ctx: CrmContext, opts: { kind?: string; status?: string; contactId?: string } = {}) {
+  let q = ctx.client.from("invoices").select(`${INVOICE_COLUMNS}, contacts(first_name, last_name, email)`).eq("organization_id", ctx.orgId);
+  if (opts.kind) q = q.eq("kind", opts.kind);
+  if (opts.status) q = q.eq("status", opts.status);
+  if (opts.contactId) q = q.eq("contact_id", opts.contactId);
+  const { data, error } = await q.order("created_at", { ascending: false }).limit(300);
+  fromDb(error);
+  return data || [];
+}
+
+export async function getInvoice(client: SupabaseClient, orgId: string, id: string) {
+  const { data, error } = await client.from("invoices").select(INVOICE_COLUMNS).eq("organization_id", orgId).eq("id", id).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Invoice not found.", 404, "not_found");
+  return data as Invoice;
+}
+
+export async function invoiceDetail(ctx: CrmContext, id: string) {
+  const invoice = await getInvoice(ctx.client, ctx.orgId, id);
+  const [{ data: payments }, { data: contact }, { data: token }] = await Promise.all([
+    ctx.client.from("payments").select("id, amount_cents, refunded_cents, method, note, created_at").eq("organization_id", ctx.orgId).eq("invoice_id", id).order("created_at"),
+    invoice.contact_id ? ctx.client.from("contacts").select("id, first_name, last_name, email, phone").eq("organization_id", ctx.orgId).eq("id", invoice.contact_id).maybeSingle() : Promise.resolve({ data: null }),
+    ctx.client.from("invoices").select("public_token").eq("organization_id", ctx.orgId).eq("id", id).single(),
+  ]);
+  return { invoice, payments: payments || [], contact, public_path: `/i/${token?.public_token}`, amount_due: amountDue(invoice) };
+}
+
+export async function createInvoice(ctx: CrmContext, input: z.infer<typeof invoiceInput>, from?: Invoice) {
+  const { data, error } = await ctx.client.from("invoices").insert({
+    organization_id: ctx.orgId, kind: input.kind, contact_id: input.contact_id ?? null, line_items: input.line_items, tax_rate_bp: input.tax_rate_bp,
+    deposit_cents: input.deposit_cents ?? null, due_date: input.due_date ?? null, notes: input.notes ?? null, source_estimate_id: from?.id ?? null,
+  }).select(INVOICE_COLUMNS).single();
+  fromDb(error);
+  await audit(ctx.client, ctx.orgId, `${input.kind}.created`, { type: "invoice", id: data!.id }, { total_cents: data!.total_cents });
+  return data as Invoice;
+}
+
+export async function updateDraft(ctx: CrmContext, id: string, input: z.infer<typeof invoiceInput>) {
+  const { kind: _kind, ...patch } = input;
+  const { data, error } = await ctx.client.from("invoices").update(patch).eq("organization_id", ctx.orgId).eq("id", id).eq("status", "draft").select(INVOICE_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Only drafts can be edited.", 409, "conflict");
+  return data as Invoice;
+}
+
+export async function setStatus(ctx: CrmContext, id: string, status: "sent" | "void" | "accepted" | "declined") {
+  const { data, error } = await ctx.client.from("invoices").update({ status }).eq("organization_id", ctx.orgId).eq("id", id).select(INVOICE_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Invoice not found.", 404, "not_found");
+  await audit(ctx.client, ctx.orgId, `invoice.${status}`, { type: "invoice", id });
+  return data as Invoice;
+}
+
+// Marks sent and emails the customer a link (transactional; the gate applies).
+export async function sendInvoice(ctx: CrmContext, id: string, req?: Request) {
+  const inv = await getInvoice(ctx.client, ctx.orgId, id);
+  if (!inv.contact_id) throw new ApiError("Choose a customer before sending.", 422, "invalid");
+  const base = publicBaseUrl(req);
+  if (!base) throw new ApiError("Integration not configured: set PUBLIC_APP_URL so the invoice link works.", 503, "integration_not_configured");
+  const { data: tok } = await ctx.client.from("invoices").select("public_token").eq("organization_id", ctx.orgId).eq("id", id).single();
+  const { data: org } = await ctx.client.from("organizations").select("name").eq("id", ctx.orgId).single();
+  const updated = inv.status === "draft" ? await setStatus(ctx, id, "sent") : inv;
+  const url = `${base}/i/${tok!.public_token}`;
+  const what = inv.kind === "estimate" ? "estimate" : "invoice";
+  const body = inv.kind === "estimate"
+    ? `Hello,\n\nHere is your estimate ${inv.number} from ${org!.name} for ${money(inv.total_cents, inv.currency)}. You can review and accept it here:\n\n${url}\n\nThank you,\n${org!.name}`
+    : `Hello,\n\nHere is invoice ${inv.number} from ${org!.name} for ${money(inv.total_cents, inv.currency)}${inv.due_date ? `, due ${inv.due_date}` : ""}. You can view and pay it securely here:\n\n${url}\n\nThank you,\n${org!.name}`;
+  const r = await sendMessage(ctx, { contact_id: inv.contact_id, channel: "email", purpose: "transactional", subject: `${what === "estimate" ? "Estimate" : "Invoice"} ${inv.number} from ${org!.name}`, body, idempotency_key: `inv-${id}-${Date.now()}` }, { req });
+  return { invoice: updated, delivery: r.outcome === "blocked" ? { sent: false, reason: r.reason } : { sent: r.outcome === "sent", reason: r.outcome === "failed" ? r.message.error : null }, url };
+}
+
+export async function convertEstimate(ctx: CrmContext, id: string) {
+  const est = await getInvoice(ctx.client, ctx.orgId, id);
+  if (est.kind !== "estimate" || est.status !== "accepted") throw new ApiError("Only accepted estimates become invoices.", 409, "conflict");
+  return createInvoice(ctx, { kind: "invoice", contact_id: est.contact_id, line_items: est.line_items, tax_rate_bp: est.tax_rate_bp, deposit_cents: est.deposit_cents, notes: est.notes }, est);
+}
+
+export const manualPaymentInput = z.object({ amount_cents: z.number().int().positive().max(100_000_000), note: z.string().trim().max(500).optional() });
+
+export async function recordManualPayment(ctx: CrmContext, id: string, input: z.infer<typeof manualPaymentInput>) {
+  const inv = await getInvoice(ctx.client, ctx.orgId, id);
+  if (input.amount_cents > inv.total_cents - inv.amount_paid_cents) throw new ApiError("That is more than the balance.", 422, "invalid");
+  const { error } = await ctx.client.from("payments").insert({ organization_id: ctx.orgId, invoice_id: id, amount_cents: input.amount_cents, method: "manual", note: input.note ?? null });
+  fromDb(error);
+  await audit(ctx.client, ctx.orgId, "payment.recorded", { type: "invoice", id }, { amount_cents: input.amount_cents });
+}
+
+// Refunds a card payment in the organization's Stripe account (managers).
+// The webhook records the refund; we also record it immediately.
+export async function refundPayment(ctx: CrmContext, system: SupabaseClient | null, paymentId: string, amountCents?: number) {
+  const { data: pay, error } = await ctx.client.from("payments").select("id, invoice_id, amount_cents, refunded_cents, method, provider_payment_id").eq("organization_id", ctx.orgId).eq("id", paymentId).maybeSingle();
+  fromDb(error);
+  if (!pay) throw new ApiError("Payment not found.", 404, "not_found");
+  if (pay.method !== "stripe" || !pay.provider_payment_id) throw new ApiError("Only card payments can be refunded here. Record manual refunds with your bank.", 409, "conflict");
+  const remaining = pay.amount_cents - pay.refunded_cents;
+  const amount = amountCents ?? remaining;
+  if (amount <= 0 || amount > remaining) throw new ApiError("Nothing left to refund.", 409, "conflict");
+  if (!system) throw new ApiError("Integration not configured: SUPABASE_SERVICE_ROLE_KEY is needed to record refunds.", 503, "integration_not_configured");
+  const { data: acct } = await ctx.client.from("payment_accounts").select("id").eq("organization_id", ctx.orgId).eq("status", "active").maybeSingle();
+  if (!acct) throw new ApiError("Integration not configured: connect Stripe first.", 503, "integration_not_configured");
+  const { data: secret, error: sErr } = await ctx.client.rpc("payment_secret", { p_account: acct.id });
+  fromDb(sErr);
+  const creds = openJson(String(secret)) as StripeCreds;
+  try {
+    await stripeFor(creds.secret_key).refunds.create({ payment_intent: pay.provider_payment_id, amount }, { idempotencyKey: `refund-${paymentId}-${pay.refunded_cents + amount}` });
+  } catch (e) {
+    throw new ApiError(`Stripe refused the refund: ${e instanceof Error ? e.message : "unknown error"}`, 502, "provider_error");
+  }
+  const { error: uErr } = await system.from("payments").update({ refunded_cents: pay.refunded_cents + amount }).eq("organization_id", ctx.orgId).eq("id", paymentId);
+  fromDb(uErr);
+  await audit(ctx.client, ctx.orgId, "payment.refunded", { type: "payment", id: paymentId }, { amount_cents: amount });
+}
+
+// ----------------------------------------------------------- public side
+export async function publicInvoice(system: SupabaseClient, token: string) {
+  if (!/^[0-9a-f]{36}$/.test(token)) return null;
+  const { data } = await system.from("invoices").select(`${INVOICE_COLUMNS}, public_token`).eq("public_token", token).maybeSingle();
+  if (!data || data.status === "draft") return null;
+  const [{ data: org }, { data: contact }, stripe] = await Promise.all([
+    system.from("organizations").select("name, status, branding").eq("id", data.organization_id).maybeSingle(),
+    data.contact_id ? system.from("contacts").select("first_name, last_name, email").eq("organization_id", data.organization_id).eq("id", data.contact_id).maybeSingle() : Promise.resolve({ data: null }),
+    system.from("payment_accounts").select("id").eq("organization_id", data.organization_id).eq("status", "active").maybeSingle(),
+  ]);
+  if (!org || org.status === "closed") return null;
+  const inv = data as Invoice;
+  return { invoice: inv, business: org.name as string, branding: (org.branding || {}) as Record<string, string>, customer: contact, can_pay: inv.kind === "invoice" && !!stripe.data && ["sent", "partially_paid"].includes(inv.status) && org.status === "active", amount_due: amountDue(inv) };
+}
+
+export async function checkoutUrl(system: SupabaseClient, token: string, req?: Request) {
+  const found = await publicInvoice(system, token);
+  if (!found) throw new ApiError("This invoice is not available.", 404, "not_found");
+  if (!found.can_pay) throw new ApiError("Online payment is not available for this invoice.", 409, "conflict");
+  const due = found.amount_due;
+  if (due < 50) throw new ApiError("Nothing is due on this invoice.", 409, "conflict");
+  const stripe = await activeStripe(system, found.invoice.organization_id);
+  if (!stripe) throw new ApiError("Online payment is not set up.", 503, "integration_not_configured");
+  const base = publicBaseUrl(req);
+  const inv = found.invoice;
+  const label = inv.deposit_cents && inv.amount_paid_cents === 0 && due < inv.total_cents ? `Deposit for invoice ${inv.number}` : `Invoice ${inv.number}`;
+  const session = await stripeFor(stripe.creds.secret_key).checkout.sessions.create({
+    mode: "payment",
+    line_items: [{ quantity: 1, price_data: { currency: inv.currency, unit_amount: due, product_data: { name: `${label} — ${found.business}` } } }],
+    customer_email: found.customer?.email || undefined,
+    metadata: { invoice_id: inv.id, organization_id: inv.organization_id },
+    payment_intent_data: { metadata: { invoice_id: inv.id, organization_id: inv.organization_id } },
+    success_url: `${base}/i/${token}?paid=1`,
+    cancel_url: `${base}/i/${token}`,
+  }, { idempotencyKey: `checkout-${inv.id}-${inv.amount_paid_cents}-${due}-${Math.floor(Date.now() / 600_000)}` });
+  if (!session.url) throw new ApiError("Stripe did not return a payment page.", 502, "provider_error");
+  return session.url;
+}
+
+export async function decideEstimate(system: SupabaseClient, token: string, decision: "accepted" | "declined") {
+  const found = await publicInvoice(system, token);
+  if (!found || found.invoice.kind !== "estimate" || found.invoice.status !== "sent") throw new ApiError("This estimate can no longer be changed.", 409, "conflict");
+  const { error } = await system.from("invoices").update({ status: decision }).eq("organization_id", found.invoice.organization_id).eq("id", found.invoice.id).eq("status", "sent");
+  fromDb(error);
+  if (found.invoice.contact_id) {
+    await system.from("activities").insert({ organization_id: found.invoice.organization_id, contact_id: found.invoice.contact_id, kind: "payment", direction: "inbound", subject: `Estimate ${found.invoice.number} ${decision}`, actor_type: "contact", metadata: { invoice_id: found.invoice.id } });
+  }
+  if (decision === "accepted") {
+    await system.from("tasks").insert({ organization_id: found.invoice.organization_id, contact_id: found.invoice.contact_id, title: `Estimate ${found.invoice.number} accepted — schedule the work and invoice`, priority: "high", due_at: new Date(Date.now() + 86_400_000).toISOString() });
+  }
+  await systemAudit(system, found.invoice.organization_id, `estimate.${decision}`, { type: "invoice", id: found.invoice.id });
+}
+
+// Stripe webhook for one organization's account. Verified with that
+// account's signing secret; the event must refer to the same organization.
+export async function handleStripeEvent(system: SupabaseClient, accountOrg: string, event: Stripe.Event) {
+  if (event.type === "checkout.session.completed") {
+    const s = event.data.object as Stripe.Checkout.Session;
+    if (s.payment_status !== "paid" || s.metadata?.organization_id !== accountOrg || !s.metadata?.invoice_id) return "ignored";
+    const pi = typeof s.payment_intent === "string" ? s.payment_intent : s.payment_intent?.id;
+    if (!pi || !s.amount_total) return "ignored";
+    const { error } = await system.from("payments").insert({ organization_id: accountOrg, invoice_id: s.metadata.invoice_id, amount_cents: s.amount_total, method: "stripe", provider_payment_id: pi });
+    if (error?.code === "23505") return "duplicate";
+    fromDb(error);
+    const inv = await getInvoice(system, accountOrg, s.metadata.invoice_id);
+    if (inv.contact_id) {
+      await system.from("activities").insert({ organization_id: accountOrg, contact_id: inv.contact_id, kind: "payment", direction: "inbound", subject: `Paid ${money(s.amount_total, inv.currency)} on ${inv.number}`, actor_type: "contact", metadata: { invoice_id: inv.id } });
+    }
+    await systemAudit(system, accountOrg, "payment.received", { type: "invoice", id: inv.id }, { amount_cents: s.amount_total });
+    return "recorded";
+  }
+  if (event.type === "charge.refunded") {
+    const c = event.data.object as Stripe.Charge;
+    const pi = typeof c.payment_intent === "string" ? c.payment_intent : c.payment_intent?.id;
+    if (!pi) return "ignored";
+    const { data: pay } = await system.from("payments").select("id, refunded_cents").eq("organization_id", accountOrg).eq("method", "stripe").eq("provider_payment_id", pi).maybeSingle();
+    if (!pay || pay.refunded_cents === c.amount_refunded) return "ignored";
+    const { error } = await system.from("payments").update({ refunded_cents: Math.min(c.amount_refunded, c.amount) }).eq("organization_id", accountOrg).eq("id", pay.id);
+    fromDb(error);
+    return "refund_recorded";
+  }
+  return "ignored";
+}
