+import { ApiError, readJson, scoped, tenantRoute } from "@/lib/tenant/api";
+import { availablePlans, clientAccounts, planInput, savePlan, usage } from "@/lib/billing/plans";
+import { can } from "@/lib/tenant/rbac";
+
+export const dynamic = "force-dynamic";
+
+// Plan and usage for the active organization; agencies also get their client
+// accounts and the plans they can assign.
+export const GET = tenantRoute("org.read", async (ctx) => {
+  const c = scoped(ctx);
+  const mine = await usage(c);
+  if (ctx.org.kind !== "agency" || !can(ctx.org.role, "org.manage")) return { ...mine, agency: null };
+  const [plans, clients] = await Promise.all([availablePlans(c, ctx.org.id), clientAccounts(c, ctx.org.id)]);
+  return { ...mine, agency: { plans, clients } };
+});
+
+// Agencies define their own plans (price and limits) for client accounts.
+export const POST = tenantRoute("org.manage", async (ctx, req) => {
+  if (ctx.org.kind !== "agency") throw new ApiError("Only agencies create plans.", 403, "forbidden");
+  return { plan: await savePlan(scoped(ctx), ctx.org.id, await readJson(req, planInput)) };
+});
