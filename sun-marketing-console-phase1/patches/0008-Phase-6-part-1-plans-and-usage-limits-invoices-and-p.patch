diff --git a/supabase/migrations/20261011120000_phase6_business_layer.sql b/supabase/migrations/20261011120000_phase6_business_layer.sql
new file mode 100644
index 0000000..fabf67c
--- /dev/null
+++ b/supabase/migrations/20261011120000_phase6_business_layer.sql
@@ -0,0 +1,481 @@
+-- Phase 6 (part 1): the SaaS business layer.
+--
+--   * Organization governance (security fix): an organization's kind,
+--     parent, slug, plan and status can no longer be changed through the
+--     API by its own admins. Plan and status are set by the parent agency's
+--     admins (for client accounts) or platform staff, via
+--     govern_organization().
+--   * Plans with limits, usage metering and enforcement. Usage events are
+--     recorded by triggers, and limits are checked before the work happens
+--     (messages, AI requests, outreach, contacts, users, sites), for people,
+--     the AI and automations alike.
+--   * Client billing: invoices and estimates with database-computed totals,
+--     deposits, payments (Stripe through each organization's own account, or
+--     recorded manually), refunds, and a public invoice page.
+--   * Custom domains for hosted sites, verified by DNS on the server.
+begin;
+
+-- ---------------------------------------------------------------- staff
+create or replace function public.is_platform_staff() returns boolean
+language sql stable security definer set search_path = '' as $$
+  select exists (select 1 from public.team_members t where t.user_id = auth.uid() and t.active)
+$$;
+
+-- ----------------------------------------------------------------- plans
+create table public.plans (
+  key text primary key check (key ~ '^[a-z0-9][a-z0-9-]{1,40}$'),
+  name text not null check (length(btrim(name)) between 1 and 80),
+  description text check (length(description) <= 500),
+  -- null: a platform plan. Otherwise an agency's own plan for its clients.
+  owner_org_id uuid references public.organizations(id) on delete cascade,
+  price_cents integer not null default 0 check (price_cents >= 0),
+  currency text not null default 'usd' check (currency ~ '^[a-z]{3}$'),
+  -- Monthly: sms, email, ai_request, outreach_email. Totals: contacts, users, sites.
+  -- A missing key means unlimited.
+  limits jsonb not null default '{}'::jsonb check (jsonb_typeof(limits) = 'object'),
+  features jsonb not null default '[]'::jsonb check (jsonb_typeof(features) = 'array'),
+  active boolean not null default true,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+create trigger plans_updated before update on public.plans for each row execute function public.tg_set_updated_at();
+
+insert into public.plans(key, name, description, price_cents, limits) values
+  ('internal', 'Internal', 'No limits. For the platform owner''s own accounts.', 0, '{}'),
+  ('starter', 'Starter', 'For a single small business getting started.', 9700,
+   '{"contacts": 2500, "users": 3, "sites": 1, "sms": 1000, "email": 5000, "ai_request": 300, "outreach_email": 300}'),
+  ('growth', 'Growth', 'For growing teams with more volume.', 29700,
+   '{"contacts": 15000, "users": 10, "sites": 3, "sms": 5000, "email": 25000, "ai_request": 1500, "outreach_email": 1500}'),
+  ('pro', 'Pro', 'High volume, many locations.', 49700,
+   '{"contacts": 100000, "users": 50, "sites": 10, "sms": 20000, "email": 100000, "ai_request": 6000, "outreach_email": 5000}')
+on conflict (key) do nothing;
+update public.organizations set plan = 'internal' where plan not in (select key from public.plans);
+alter table public.organizations add constraint organizations_plan_fk foreign key (plan) references public.plans(key) on update cascade;
+
+-- --------------------------------------------- organization governance
+create or replace function public.tg_organizations_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if new.kind <> old.kind or new.parent_id is distinct from old.parent_id or new.slug <> old.slug or new.created_by is distinct from old.created_by then
+    raise exception 'An organization''s type, parent and address cannot be changed.' using errcode = '42501';
+  end if;
+  if new.status <> old.status or new.plan <> old.plan then
+    raise exception 'Plan and status are changed by the managing agency.' using errcode = '42501';
+  end if;
+  return new;
+end $$;
+create trigger organizations_guard before update on public.organizations
+  for each row execute function public.tg_organizations_guard();
+
+-- Agency admins govern their client accounts; platform staff govern agencies.
+create or replace function public.govern_organization(p_org uuid, p_status text default null, p_plan text default null) returns void
+language plpgsql security definer set search_path = '' as $$
+declare v_org public.organizations; v_plan public.plans; v_allowed boolean;
+begin
+  select * into v_org from public.organizations where id = p_org;
+  if not found then raise exception 'Organization not found.' using errcode = 'P0002'; end if;
+  v_allowed := public.is_platform_staff() or (v_org.kind = 'client' and exists (
+    select 1 from public.memberships m where m.organization_id = v_org.parent_id and m.user_id = auth.uid() and m.status = 'active' and public.role_rank(m.role) >= 4));
+  if not v_allowed then raise exception 'Only the managing agency''s admins can change this.' using errcode = '42501'; end if;
+  if p_status is not null and p_status not in ('active', 'suspended', 'closed') then raise exception 'Unknown status.' using errcode = '22023'; end if;
+  if p_plan is not null then
+    select * into v_plan from public.plans where key = p_plan and active;
+    if not found or (v_plan.owner_org_id is not null and v_plan.owner_org_id is distinct from v_org.parent_id) then
+      raise exception 'That plan is not available for this account.' using errcode = '22023';
+    end if;
+    if v_plan.key = 'internal' and not public.is_platform_staff() then
+      raise exception 'Only platform staff assign the internal plan.' using errcode = '42501';
+    end if;
+  end if;
+  update public.organizations set status = coalesce(p_status, status), plan = coalesce(p_plan, plan) where id = p_org;
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, metadata)
+  values (p_org, 'user', auth.uid(), 'organization.governed', jsonb_build_object('status', p_status, 'plan', p_plan, 'previous_status', v_org.status, 'previous_plan', v_org.plan));
+end $$;
+
+-- ------------------------------------------------------------- metering
+create table public.usage_events (
+  id bigint generated always as identity primary key,
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  metric text not null check (metric in ('sms', 'email', 'ai_request', 'outreach_email')),
+  quantity integer not null default 1 check (quantity > 0),
+  ref text,
+  occurred_at timestamptz not null default now()
+);
+create index usage_events_org_metric_idx on public.usage_events(organization_id, metric, occurred_at);
+
+create or replace function public.month_start() returns timestamptz
+language sql stable set search_path = '' as $$ select date_trunc('month', now() at time zone 'UTC') at time zone 'UTC' $$;
+
+-- Raises 53400 when adding p_add would exceed the organization's plan.
+create or replace function public.check_plan_limit(p_org uuid, p_metric text, p_add integer default 1) returns void
+language plpgsql security definer set search_path = '' as $$
+declare v_limit bigint; v_used bigint; v_label text;
+begin
+  select (p.limits ->> p_metric)::bigint into v_limit
+    from public.organizations o join public.plans p on p.key = o.plan where o.id = p_org;
+  if v_limit is null then return; end if;
+  v_used := case p_metric
+    when 'contacts' then (select count(*) from public.contacts where organization_id = p_org and erased_at is null)
+    when 'users' then (select count(*) from public.memberships where organization_id = p_org and status = 'active')
+    when 'sites' then (select count(*) from public.sites where organization_id = p_org and status <> 'archived')
+    else (select coalesce(sum(quantity), 0) from public.usage_events where organization_id = p_org and metric = p_metric and occurred_at >= public.month_start())
+  end;
+  if v_used + p_add > v_limit then
+    v_label := case p_metric when 'sms' then 'text messages this month' when 'email' then 'emails this month' when 'ai_request' then 'AI requests this month'
+      when 'outreach_email' then 'outreach emails this month' when 'contacts' then 'contacts' when 'users' then 'team members' when 'sites' then 'websites' else p_metric end;
+    raise exception 'Plan limit reached: % of % %. Ask your agency to upgrade the plan.', v_used, v_limit, v_label using errcode = '53400';
+  end if;
+end $$;
+
+create or replace function public.tg_limit_messages() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if new.direction = 'outbound' and new.status in ('queued', 'scheduled') and (tg_op = 'INSERT' or old.status = 'scheduled') then
+    perform public.check_plan_limit(new.organization_id, new.channel);
+  end if;
+  return new;
+end $$;
+create trigger messages_plan_limit before insert or update of status on public.messages
+  for each row execute function public.tg_limit_messages();
+
+create or replace function public.tg_meter_messages() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if new.direction = 'outbound' and new.status = 'sent' and old.status is distinct from 'sent' then
+    insert into public.usage_events(organization_id, metric, ref) values (new.organization_id, new.channel, new.id::text);
+  end if;
+  return null;
+end $$;
+create trigger messages_meter after update of status on public.messages
+  for each row execute function public.tg_meter_messages();
+
+create or replace function public.tg_limit_meter_ai() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if new.role = 'user' then
+    perform public.check_plan_limit(new.organization_id, 'ai_request');
+    insert into public.usage_events(organization_id, metric, ref) values (new.organization_id, 'ai_request', new.conversation_id::text);
+  end if;
+  return new;
+end $$;
+create trigger ai_messages_plan before insert on public.ai_messages
+  for each row execute function public.tg_limit_meter_ai();
+
+create or replace function public.tg_limit_meter_outreach() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if old.status = 'draft' and new.status = 'sending' then
+    perform public.check_plan_limit(new.organization_id, 'outreach_email');
+  elsif old.status = 'sending' and new.status = 'sent' then
+    insert into public.usage_events(organization_id, metric, ref) values (new.organization_id, 'outreach_email', new.id::text);
+  end if;
+  return new;
+end $$;
+create trigger outreach_plan before update of status on public.outreach_messages
+  for each row execute function public.tg_limit_meter_outreach();
+
+create or replace function public.tg_limit_totals() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if tg_table_name = 'contacts' then perform public.check_plan_limit(new.organization_id, 'contacts');
+  elsif tg_table_name = 'memberships' and new.status = 'active' and (tg_op = 'INSERT' or old.status <> 'active') then perform public.check_plan_limit(new.organization_id, 'users');
+  elsif tg_table_name = 'sites' then perform public.check_plan_limit(new.organization_id, 'sites');
+  end if;
+  return new;
+end $$;
+create trigger contacts_plan_limit before insert on public.contacts for each row execute function public.tg_limit_totals();
+create trigger memberships_plan_limit before insert or update of status on public.memberships for each row execute function public.tg_limit_totals();
+create trigger sites_plan_limit before insert on public.sites for each row execute function public.tg_limit_totals();
+
+-- Usage against limits, for members of the organization.
+create or replace function public.org_usage(p_org uuid)
+returns table (metric text, used bigint, "limit" bigint)
+language plpgsql stable security definer set search_path = '' as $$
+declare v_limits jsonb;
+begin
+  if public.org_rank(p_org) < 1 then raise exception 'Not allowed.' using errcode = '42501'; end if;
+  select p.limits into v_limits from public.organizations o join public.plans p on p.key = o.plan where o.id = p_org;
+  return query
+  select m.metric,
+    case m.metric
+      when 'contacts' then (select count(*) from public.contacts c where c.organization_id = p_org and c.erased_at is null)
+      when 'users' then (select count(*) from public.memberships x where x.organization_id = p_org and x.status = 'active')
+      when 'sites' then (select count(*) from public.sites s where s.organization_id = p_org and s.status <> 'archived')
+      else (select coalesce(sum(u.quantity), 0)::bigint from public.usage_events u where u.organization_id = p_org and u.metric = m.metric and u.occurred_at >= public.month_start())
+    end,
+    (v_limits ->> m.metric)::bigint
+  from unnest(array['sms', 'email', 'ai_request', 'outreach_email', 'contacts', 'users', 'sites']) as m(metric);
+end $$;
+
+-- ----------------------------------------------------- payment accounts
+create table public.payment_accounts (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  provider text not null default 'stripe' check (provider in ('stripe')),
+  label text not null check (length(btrim(label)) between 1 and 80),
+  encrypted_credentials text not null check (length(encrypted_credentials) between 20 and 8000),
+  credential_hint text check (length(credential_hint) <= 12),
+  status text not null default 'active' check (status in ('active', 'disabled')),
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id)
+);
+create unique index payment_accounts_one_active on public.payment_accounts(organization_id, provider) where status = 'active';
+create trigger payment_accounts_updated before update on public.payment_accounts for each row execute function public.tg_set_updated_at();
+
+-- Ciphertext for refunds, to managers of the organization only.
+create or replace function public.payment_secret(p_account uuid) returns text
+language plpgsql stable security definer set search_path = '' as $$
+declare v public.payment_accounts;
+begin
+  select * into v from public.payment_accounts where id = p_account and status = 'active';
+  if not found or public.org_rank(v.organization_id) < 3 then raise exception 'Payment account not available.' using errcode = '42501'; end if;
+  return v.encrypted_credentials;
+end $$;
+
+-- ----------------------------------------------------------- invoices
+create table public.invoices (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  kind text not null default 'invoice' check (kind in ('invoice', 'estimate')),
+  seq integer not null default 0,
+  number text,
+  contact_id uuid,
+  status text not null default 'draft' check (status in ('draft', 'sent', 'partially_paid', 'paid', 'void', 'accepted', 'declined')),
+  currency text not null default 'usd' check (currency ~ '^[a-z]{3}$'),
+  line_items jsonb not null check (jsonb_typeof(line_items) = 'array' and jsonb_array_length(line_items) between 1 and 100),
+  tax_rate_bp integer not null default 0 check (tax_rate_bp between 0 and 5000),
+  subtotal_cents bigint not null default 0,
+  tax_cents bigint not null default 0,
+  total_cents bigint not null default 0,
+  deposit_cents bigint check (deposit_cents >= 0),
+  amount_paid_cents bigint not null default 0,
+  due_date date,
+  notes text check (length(notes) <= 4000),
+  source_estimate_id uuid,
+  public_token text not null unique default encode(extensions.gen_random_bytes(18), 'hex'),
+  sent_at timestamptz,
+  paid_at timestamptz,
+  decided_at timestamptz,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  unique (organization_id, kind, seq),
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete set null (contact_id),
+  check (deposit_cents is null or deposit_cents <= total_cents)
+);
+create index invoices_org_idx on public.invoices(organization_id, created_at desc);
+create trigger invoices_updated before update on public.invoices for each row execute function public.tg_set_updated_at();
+
+-- Totals are always computed here from the line items; the client never
+-- supplies them. Paid amounts come only from payments.
+create or replace function public.tg_invoices_guard() returns trigger
+language plpgsql set search_path = '' as $$
+declare v_api boolean := current_user in ('authenticated', 'anon'); v_item jsonb; v_sub numeric := 0;
+begin
+  for v_item in select * from jsonb_array_elements(new.line_items) loop
+    if jsonb_typeof(v_item) <> 'object' or length(coalesce(v_item ->> 'description', '')) not between 1 and 300
+       or (v_item ->> 'quantity')::numeric <= 0 or (v_item ->> 'quantity')::numeric > 100000
+       or (v_item ->> 'unit_cents')::numeric < 0 or (v_item ->> 'unit_cents')::numeric > 100000000 then
+      raise exception 'Each line needs a description, a positive quantity and a price.' using errcode = '22023';
+    end if;
+    v_sub := v_sub + round((v_item ->> 'quantity')::numeric * (v_item ->> 'unit_cents')::numeric);
+  end loop;
+  if tg_op = 'INSERT' then
+    perform pg_advisory_xact_lock(hashtext(new.organization_id::text || new.kind));
+    select coalesce(max(seq), 0) + 1 into new.seq from public.invoices where organization_id = new.organization_id and kind = new.kind;
+    new.number := case new.kind when 'estimate' then 'EST-' else 'INV-' end || lpad(new.seq::text, 4, '0');
+    if v_api then
+      new.status := 'draft'; new.amount_paid_cents := 0; new.paid_at := null; new.sent_at := null; new.decided_at := null; new.created_by := auth.uid();
+      new.public_token := encode(extensions.gen_random_bytes(18), 'hex');
+    end if;
+  else
+    if new.organization_id <> old.organization_id or new.kind <> old.kind or new.seq <> old.seq or new.number <> old.number or new.public_token <> old.public_token then
+      raise exception 'Invoice identity is immutable.' using errcode = '42501';
+    end if;
+    if old.status <> 'draft' and (new.line_items <> old.line_items or new.tax_rate_bp <> old.tax_rate_bp or new.deposit_cents is distinct from old.deposit_cents
+       or new.contact_id is distinct from old.contact_id or new.currency <> old.currency) then
+      raise exception 'Only drafts can be edited. Void it and create a new one.' using errcode = '42501';
+    end if;
+    if v_api then
+      if new.amount_paid_cents <> old.amount_paid_cents or new.paid_at is distinct from old.paid_at then
+        raise exception 'Payments are recorded as payments.' using errcode = '42501';
+      end if;
+      if new.status <> old.status and not (
+           (old.status = 'draft' and new.status in ('sent', 'void'))
+        or (old.status in ('sent', 'partially_paid') and new.status = 'void' and new.amount_paid_cents = 0)
+        or (new.kind = 'estimate' and old.status = 'sent' and new.status in ('accepted', 'declined'))) then
+        raise exception 'Invalid invoice change % -> %.', old.status, new.status using errcode = '42501';
+      end if;
+      if new.status in ('accepted', 'declined') and old.status <> new.status and public.org_rank(new.organization_id) < 3 then
+        raise exception 'Customers accept estimates on the estimate page; managers can record a decision.' using errcode = '42501';
+      end if;
+    end if;
+    if new.status = 'sent' and old.status = 'draft' then new.sent_at := now(); end if;
+    if new.status in ('accepted', 'declined') and old.status <> new.status then new.decided_at := now(); end if;
+  end if;
+  new.subtotal_cents := v_sub;
+  new.tax_cents := round(v_sub * new.tax_rate_bp / 10000.0);
+  new.total_cents := new.subtotal_cents + new.tax_cents;
+  if new.deposit_cents is not null and new.deposit_cents > new.total_cents then
+    raise exception 'The deposit cannot exceed the total.' using errcode = '22023';
+  end if;
+  return new;
+end $$;
+create trigger invoices_guard before insert or update on public.invoices
+  for each row execute function public.tg_invoices_guard();
+
+create table public.payments (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  invoice_id uuid not null,
+  amount_cents bigint not null check (amount_cents > 0),
+  refunded_cents bigint not null default 0 check (refunded_cents >= 0),
+  method text not null check (method in ('stripe', 'manual')),
+  provider_payment_id text,
+  note text check (length(note) <= 500),
+  recorded_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (method, provider_payment_id),
+  foreign key (invoice_id, organization_id) references public.invoices(id, organization_id) on delete cascade,
+  check (refunded_cents <= amount_cents)
+);
+create index payments_invoice_idx on public.payments(invoice_id);
+create trigger payments_updated before update on public.payments for each row execute function public.tg_set_updated_at();
+
+create or replace function public.tg_payments_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if tg_op = 'INSERT' and exists (select 1 from public.invoices i where i.id = new.invoice_id and (i.kind = 'estimate' or i.status in ('draft', 'void', 'declined'))) then
+    raise exception 'Payments apply to sent invoices only.' using errcode = '22023';
+  end if;
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    if new.method <> 'manual' or public.org_rank(new.organization_id) < 3 then
+      raise exception 'Managers record manual payments; card payments come from the payment provider.' using errcode = '42501';
+    end if;
+    new.recorded_by := auth.uid(); new.refunded_cents := 0; new.provider_payment_id := null;
+    return new;
+  end if;
+  raise exception 'Payments cannot be edited.' using errcode = '42501';
+end $$;
+create trigger payments_guard before insert or update on public.payments
+  for each row execute function public.tg_payments_guard();
+
+-- Keeps the invoice's paid amount and status in step with its payments.
+create or replace function public.tg_payments_apply() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare v_inv uuid := coalesce(new.invoice_id, old.invoice_id); v_paid bigint; v_total bigint; v_status text;
+begin
+  select coalesce(sum(amount_cents - refunded_cents), 0) into v_paid from public.payments where invoice_id = v_inv;
+  select total_cents, status into v_total, v_status from public.invoices where id = v_inv;
+  update public.invoices set amount_paid_cents = v_paid,
+         status = case when v_status in ('void', 'declined') then v_status
+                       when v_paid >= v_total and v_total > 0 then 'paid'
+                       when v_paid > 0 then 'partially_paid'
+                       when v_status in ('paid', 'partially_paid') then 'sent' else v_status end,
+         paid_at = case when v_paid >= v_total and v_total > 0 then coalesce(paid_at, now()) else null end
+   where id = v_inv;
+  return null;
+end $$;
+create trigger payments_apply after insert or update on public.payments
+  for each row execute function public.tg_payments_apply();
+
+-- ---------------------------------------------------------- site domains
+create table public.site_domains (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  site_id uuid not null,
+  domain text not null check (domain ~ '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$' and length(domain) <= 253),
+  verification_token text not null default encode(extensions.gen_random_bytes(16), 'hex'),
+  status text not null default 'pending' check (status in ('pending', 'verified')),
+  verified_at timestamptz,
+  last_checked_at timestamptz,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  foreign key (site_id, organization_id) references public.sites(id, organization_id) on delete cascade
+);
+create unique index site_domains_domain on public.site_domains(domain);
+
+-- Verification is done by the server after a DNS check; people cannot mark a domain verified.
+create or replace function public.tg_site_domains_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    new.status := 'pending'; new.verified_at := null; new.created_by := auth.uid();
+    new.verification_token := encode(extensions.gen_random_bytes(16), 'hex');
+    return new;
+  end if;
+  raise exception 'Domains are verified by the server.' using errcode = '42501';
+end $$;
+create trigger site_domains_guard before insert or update on public.site_domains
+  for each row execute function public.tg_site_domains_guard();
+
+-- Host-name routing for the public site renderer (callable without login).
+create or replace function public.site_slug_for_domain(p_domain text) returns text
+language sql stable security definer set search_path = '' as $$
+  select s.slug from public.site_domains d
+    join public.sites s on s.id = d.site_id and s.status = 'published'
+    join public.organizations o on o.id = d.organization_id and o.status = 'active'
+   where d.domain = lower(btrim(p_domain)) and d.status = 'verified'
+   limit 1
+$$;
+
+-- --------------------------------------------------------------------- RLS
+alter table public.plans enable row level security;
+alter table public.usage_events enable row level security;
+alter table public.payment_accounts enable row level security;
+alter table public.invoices enable row level security;
+alter table public.payments enable row level security;
+alter table public.site_domains enable row level security;
+
+create policy plans_read on public.plans for select to authenticated using (
+  owner_org_id is null or public.org_rank(owner_org_id) >= 1
+  or exists (select 1 from public.organizations o where o.plan = plans.key and public.org_rank(o.id) >= 1));
+create policy plans_write_agency on public.plans for all to authenticated
+  using ((owner_org_id is not null and public.org_rank(owner_org_id) >= 4) or (owner_org_id is null and public.is_platform_staff()))
+  with check ((owner_org_id is not null and public.org_rank(owner_org_id) >= 4
+               and exists (select 1 from public.organizations o where o.id = owner_org_id and o.kind = 'agency'))
+              or (owner_org_id is null and public.is_platform_staff()));
+
+create policy usage_read on public.usage_events for select to authenticated using (public.org_rank(organization_id) >= 1);
+
+create policy payment_accounts_read on public.payment_accounts for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy payment_accounts_write on public.payment_accounts for all to authenticated
+  using (public.org_rank(organization_id) >= 4) with check (public.org_rank(organization_id) >= 4);
+
+create policy invoices_read on public.invoices for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy invoices_insert on public.invoices for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy invoices_update on public.invoices for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+create policy invoices_delete on public.invoices for delete to authenticated using (public.org_rank(organization_id) >= 3 and status = 'draft');
+
+create policy payments_read on public.payments for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy payments_insert on public.payments for insert to authenticated with check (public.org_rank(organization_id) >= 3);
+
+create policy site_domains_read on public.site_domains for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy site_domains_insert on public.site_domains for insert to authenticated with check (public.org_rank(organization_id) >= 3);
+create policy site_domains_delete on public.site_domains for delete to authenticated using (public.org_rank(organization_id) >= 3);
+
+revoke all on public.plans, public.usage_events, public.payment_accounts, public.invoices, public.payments, public.site_domains from anon, authenticated;
+grant all on public.plans, public.usage_events, public.payment_accounts, public.invoices, public.payments, public.site_domains to service_role;
+grant select, insert, update, delete on public.plans, public.invoices to authenticated;
+grant select on public.usage_events to authenticated;
+grant select, insert on public.payments to authenticated;
+grant select, insert, delete on public.site_domains to authenticated;
+grant select (id, organization_id, provider, label, credential_hint, status, created_by, created_at, updated_at) on public.payment_accounts to authenticated;
+grant insert, update, delete on public.payment_accounts to authenticated;
+
+revoke execute on function public.is_platform_staff(), public.govern_organization(uuid, text, text), public.check_plan_limit(uuid, text, integer),
+  public.org_usage(uuid), public.payment_secret(uuid), public.site_slug_for_domain(text), public.month_start() from public, anon;
+grant execute on function public.is_platform_staff(), public.govern_organization(uuid, text, text), public.org_usage(uuid), public.payment_secret(uuid), public.month_start()
+  to authenticated, service_role;
+grant execute on function public.check_plan_limit(uuid, text, integer) to service_role;
+grant execute on function public.site_slug_for_domain(text) to anon, authenticated, service_role;
+
+commit;
diff --git a/supabase/tests/phase6_business.test.sql b/supabase/tests/phase6_business.test.sql
