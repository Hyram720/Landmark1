+          {data.payments.length === 0 ? <span className="small muted">None yet.</span> : data.payments.map((p) => (
+            <div key={p.id} className="row small" style={{ justifyContent: "space-between", flexWrap: "wrap" }}>
+              <span>{fmt(p.amount_cents, i.currency)} · {p.method === "stripe" ? "card" : "recorded by hand"}{p.note ? ` · ${p.note}` : ""} · {relativeTime(p.created_at)}{p.refunded_cents ? <span className="pill pill-warn" style={{ marginLeft: 6 }}>refunded {fmt(p.refunded_cents, i.currency)}</span> : null}</span>
+              {manager && p.method === "stripe" && p.refunded_cents < p.amount_cents && <button className="btn btn-sm btn-ghost" onClick={async () => { if (!window.confirm(`Refund ${fmt(p.amount_cents - p.refunded_cents, i.currency)} to the customer's card?`)) return; try { await api(`/api/invoices/payments/${p.id}`, { body: { action: "refund" } }); toast("Refunded."); reload(); onChanged(); } catch (e) { toast(e instanceof Error ? e.message : "Refund failed."); } }}>Refund</button>}
