+        <div className="table-wrap"><table><thead><tr><th>Description</th><th>Qty</th><th>Price</th><th>Amount</th></tr></thead><tbody>
+          {i.line_items.map((l, k) => <tr key={k}><td className="small">{l.description}</td><td className="small">{l.quantity}</td><td className="small">{fmt(l.unit_cents, i.currency)}</td><td className="small">{fmt(Math.round(l.quantity * l.unit_cents), i.currency)}</td></tr>)}
+        </tbody></table></div>
+        <div className="kv small" style={{ maxWidth: 320, marginLeft: "auto" }}>
+          <dt>Subtotal</dt><dd>{fmt(i.subtotal_cents, i.currency)}</dd><dt>Tax ({i.tax_rate_bp / 100}%)</dt><dd>{fmt(i.tax_cents, i.currency)}</dd>
+          <dt><strong>Total</strong></dt><dd><strong>{fmt(i.total_cents, i.currency)}</strong></dd>
+          {i.deposit_cents ? <><dt>Deposit</dt><dd>{fmt(i.deposit_cents, i.currency)}</dd></> : null}
+          {i.kind === "invoice" && <><dt>Paid</dt><dd>{fmt(i.amount_paid_cents, i.currency)}</dd><dt>Due now</dt><dd>{fmt(data.amount_due, i.currency)}</dd></>}
