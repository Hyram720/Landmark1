+              <td><span className={`pill ${c.status === "active" ? "pill-ok" : "pill-bad"}`}>{c.status}</span>{" "}
+                {c.status === "active" ? <button className="btn btn-sm btn-ghost" onClick={() => { if (window.confirm(`Suspend ${c.name}? Their team loses access to the tools (data is kept).`)) govern(c.id, { status: "suspended" }, "Suspended."); }}>Suspend</button>
+                  : c.status === "suspended" ? <button className="btn btn-sm btn-ghost" onClick={() => govern(c.id, { status: "active" }, "Reactivated.")}>Reactivate</button> : null}</td>
