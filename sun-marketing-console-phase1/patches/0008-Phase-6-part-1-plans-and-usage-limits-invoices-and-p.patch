+        <button className={`chip ${kind === "estimate" ? "on" : ""}`} onClick={() => { setKind("estimate"); setOpen(null); setEditing(null); }}>Estimates</button>
+        <span style={{ flex: 1 }} />
+        {kind === "invoice" && <span className="small muted">Outstanding: <strong>{fmt(outstanding)}</strong></span>}
+        <button className="btn btn-primary btn-sm" onClick={() => { setEditing("new"); setOpen(null); }}>New {kind}</button>
+      </div>
+      <div className="split">
+        <div className="card">
+          {rows.length === 0 ? <div className="empty"><h3>No {kind}s yet</h3></div> : (
+            <div className="table-wrap"><table><thead><tr><th>Number</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead><tbody>
+              {rows.map((i) => (
+                <tr key={i.id} className={`lf-row ${open === i.id ? "on" : ""}`} onClick={() => { setOpen(i.id); setEditing(null); }}>
+                  <td className="small"><strong>{i.number}</strong><div className="tiny muted">{relativeTime(i.created_at)}</div></td>
+                  <td className="small">{i.contacts ? personName(i.contacts) : "—"}</td>
+                  <td className="small">{fmt(i.total_cents, i.currency)}{i.kind === "invoice" && i.amount_paid_cents > 0 && i.status !== "paid" ? <div className="tiny muted">{fmt(i.total_cents - i.amount_paid_cents, i.currency)} left</div> : null}</td>
+                  <td><span className={`pill ${PILL[i.status]}`}>{i.status.replace("_", " ")}</span></td>
+                </tr>
+              ))}
+            </tbody></table></div>
+          )}
+        </div>
+        <div>
+          {editing ? <Editor key={editing === "new" ? "new" : editing.invoice.id} initial={editing === "new" ? null : editing} kind={kind} onCancel={() => setEditing(null)} onSaved={(id) => { setEditing(null); setOpen(id); reload(); toast("Saved."); }} />
+            : open ? <View key={open} id={open} org={org} toast={toast} onEdit={(d) => setEditing(d)} onChanged={(id) => { reload(); if (id && id !== open) setOpen(id); }} />
+            : <div className="card card-pad small muted">Select an {kind} or create a new one. Customers get a secure link to view{kind === "invoice" ? " and pay" : " and accept"} it.</div>}
+        </div>
+      </div>
+      {node}
+    </div>
+  );
+}
+
+export default function InvoicesPage() {
+  return <TenantGate title="Invoices" subtitle="Estimates, invoices, deposits and payments.">{(info) => <Invoices org={info.org} />}</TenantGate>;
+}
