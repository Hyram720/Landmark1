+import { z } from "zod";
+import { fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+
+export const dynamic = "force-dynamic";
+
+const branding = z.object({
+  display_name: z.string().trim().max(120).optional(),
+  logo_url: z.string().trim().max(500).refine((v) => !v || v.startsWith("https://"), "Use an https:// image address.").optional(),
+  color: z.string().regex(/^#[0-9a-fA-F]{6}$/, "Use a color like #f97316.").optional(),
+  support_email: z.string().trim().max(254).optional(),
+  support_phone: z.string().trim().max(40).optional(),
+});
+
+export const GET = tenantRoute("org.read", async (ctx) => {
+  const { data, error } = await ctx.client.from("organizations").select("branding").eq("id", ctx.org.id).single();
+  fromDb(error);
+  return { branding: data?.branding || {} };
+});
+
+// Shown on customer-facing pages (invoices, estimates) instead of the platform's name.
+export const PUT = tenantRoute("org.manage", async (ctx, req) => {
+  const input = await readJson(req, branding);
+  const { error } = await ctx.client.from("organizations").update({ branding: input }).eq("id", ctx.org.id);
+  fromDb(error);
+  await audit(ctx.client, ctx.org.id, "organization.branding", null);
+  return { branding: input };
+});
