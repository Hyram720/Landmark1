@@ -0,0 +1,34 @@
+import { NextResponse } from "next/server";
+import { systemClient } from "@/lib/supabase/system";
+import { openJson } from "@/lib/crypto/vault";
+import { stripeFor, type StripeCreds } from "@/lib/payments/stripe-accounts";
+import { handleStripeEvent } from "@/lib/billing/invoices";
+
+export const dynamic = "force-dynamic";
+
+// Payment events from one organization's own Stripe account, verified with
+// that account's signing secret. Idempotent (payments are unique per intent).
+export async function POST(req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const id = (await params).id;
+  if (!/^[0-9a-f-]{36}$/.test(id)) return NextResponse.json({ error: "Unknown account." }, { status: 404 });
+  const system = systemClient();
+  if (!system) return NextResponse.json({ error: "Not configured." }, { status: 503 });
+  const { data: acct } = await system.from("payment_accounts").select("id, organization_id, encrypted_credentials").eq("id", id).maybeSingle();
+  if (!acct) return NextResponse.json({ error: "Unknown account." }, { status: 404 });
+  let creds: StripeCreds;
+  try { creds = openJson(acct.encrypted_credentials) as StripeCreds; } catch { return NextResponse.json({ error: "Not configured." }, { status: 503 }); }
+  const signature = req.headers.get("stripe-signature");
+  if (!creds.webhook_secret || !signature) return NextResponse.json({ error: "Webhook not configured." }, { status: 400 });
+  const raw = await req.text();
+  if (raw.length > 512_000) return NextResponse.json({ error: "Too large." }, { status: 413 });
+  let event;
+  try { event = stripeFor(creds.secret_key).webhooks.constructEvent(raw, signature, creds.webhook_secret); }
+  catch { return NextResponse.json({ error: "Invalid signature." }, { status: 400 }); }
+  try {
+    const result = await handleStripeEvent(system, acct.organization_id, event);
+    return NextResponse.json({ received: true, result });
+  } catch (e) {
+    console.error("[stripe-account webhook]", id, e);
+    return NextResponse.json({ error: "Processing failed." }, { status: 500 });
+  }
+}
