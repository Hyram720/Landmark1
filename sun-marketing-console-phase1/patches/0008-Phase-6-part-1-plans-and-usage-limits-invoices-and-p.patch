new file mode 100644
index 0000000..d89601a
--- /dev/null
+++ b/src/app/api/organization/export/route.ts
@@ -0,0 +1,38 @@
+import { NextResponse } from "next/server";
+import { ApiError, fromDb, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+const TABLES = [
+  "companies", "contacts", "consents", "opportunities", "tasks", "activities", "conversations", "messages", "suppressions",
+  "calendars", "appointments", "reviews", "review_requests", "workflows", "workflow_versions", "prospects", "outreach_messages",
+  "forms", "form_submissions", "sites", "site_pages", "knowledge_items", "invoices", "payments",
+] as const;
+
+// Full data export for the organization's owners and admins (and the managing
+// agency's admins). Works while an account is suspended, so data is never held hostage.
+export const GET = tenantRoute("org.read", async (ctx) => {
+  const uid = ctx.session.user.id;
+  const { data: org } = await ctx.client.from("organizations").select("id, name, parent_id, plan, status, timezone, created_at").eq("id", ctx.org.id).single();
+  const { data: roles } = await ctx.client.from("memberships").select("organization_id, role").eq("user_id", uid).eq("status", "active")
+    .in("organization_id", [ctx.org.id, org?.parent_id].filter(Boolean) as string[]);
+  if (!(roles || []).some((r) => ["owner", "admin"].includes(r.role))) throw new ApiError("Only owners and admins can export all data.", 403, "forbidden");
+  const out: Record<string, unknown> = { exported_at: new Date().toISOString(), organization: org };
+  for (const t of TABLES) {
+    const rows: unknown[] = [];
+    for (let from = 0; from < 200_000; from += 1000) {
+      const { data, error } = await ctx.client.from(t).select("*").eq("organization_id", ctx.org.id).range(from, from + 999);
+      if (error?.code === "42501" || error?.code === "42P01") break;
+      fromDb(error);
+      rows.push(...(data || []));
+      if (!data || data.length < 1000) break;
+    }
+    out[t] = rows;
+  }
+  await audit(ctx.client, ctx.org.id, "organization.exported", null, { tables: TABLES.length });
+  return new NextResponse(JSON.stringify(out, null, 1), {
+    headers: { "Content-Type": "application/json", "Content-Disposition": `attachment; filename="export-${(org?.name || "organization").replace(/[^a-z0-9]+/gi, "-").toLowerCase()}-${new Date().toISOString().slice(0, 10)}.json"`, "Cache-Control": "no-store" },
+  });
+});
