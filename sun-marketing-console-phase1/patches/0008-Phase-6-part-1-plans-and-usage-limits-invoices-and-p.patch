+          <div className="small"><span className="pill pill-ok">Connected</span> {data.account.label || "Stripe"} · key ending {data.account.credential_hint}</div>
+          {data.webhook_url && <div className="small" style={{ wordBreak: "break-all" }}>Webhook address: <span className="mono">{data.webhook_url}</span> <Copy text={data.webhook_url} /></div>}
+          {manage && <div><button className="btn btn-sm btn-ghost" onClick={async () => { if (!window.confirm("Disconnect Stripe? Customers will not be able to pay by card.")) return; try { await api("/api/billing/stripe", { method: "DELETE" }); reload(); } catch (e) { toast(e instanceof Error ? e.message : "Failed."); } }}>Disconnect</button></div>}
+        </> : <>
+          <p className="notice notice-warn small"><strong>Integration not configured.</strong> Paste a Stripe secret key (or a restricted key with Checkout, Charges, Refunds and Webhook Endpoints access). Use a test key (sk_test_…) first.</p>
+          {manage ? <>
+            <div className="field"><label htmlFor="sk">Stripe secret key</label><input id="sk" className="input" type="password" autoComplete="off" value={key} onChange={(e) => setKey(e.target.value)} placeholder="sk_live_… or rk_live_…" /></div>
+            <div className="field"><label htmlFor="wh">Webhook signing secret (only if your key can&apos;t create webhooks)</label><input id="wh" className="input" type="password" autoComplete="off" value={whsec} onChange={(e) => setWhsec(e.target.value)} placeholder="whsec_… (optional)" /></div>
+            <div><button className="btn btn-primary btn-sm" disabled={busy || key.length < 10} onClick={async () => {
