diff --git a/src/lib/payments/stripe-accounts.ts b/src/lib/payments/stripe-accounts.ts
new file mode 100644
index 0000000..757f0b8
--- /dev/null
+++ b/src/lib/payments/stripe-accounts.ts
@@ -0,0 +1,62 @@
+import "server-only";
+import Stripe from "stripe";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { hintFor, openJson, sealJson, vaultReady } from "@/lib/crypto/vault";
+import { publicBaseUrl } from "@/lib/supabase/system";
+
+// Each organization takes payments into its OWN Stripe account (its secret
+// key, sealed with APP_ENCRYPTION_KEY). The platform never holds client funds.
+export const API_VERSION = "2026-07-29.dahlia" as const;
+export const ACCOUNT_COLUMNS = "id, organization_id, provider, label, credential_hint, status, created_at";
+export type StripeCreds = { secret_key: string; webhook_secret?: string };
+
+export function stripeFor(key: string) {
+  return new Stripe(key, { apiVersion: API_VERSION, maxNetworkRetries: 1, timeout: 15_000 });
+}
+
+export function webhookUrl(base: string, accountId: string) {
+  return `${base}/api/webhooks/stripe-account/${accountId}`;
+}
+
+// Connects a Stripe account: checks the key, then registers our webhook in
+// that account (or accepts a signing secret pasted by the owner).
+export async function connectStripe(client: SupabaseClient, orgId: string, userId: string, input: { secret_key: string; webhook_secret?: string; label?: string }, req?: Request) {
+  if (!vaultReady()) throw new ApiError("Integration not configured: the server's APP_ENCRYPTION_KEY is not set.", 503, "integration_not_configured");
+  if (!/^(sk|rk)_(live|test)_[A-Za-z0-9]{10,}$/.test(input.secret_key)) throw new ApiError("Paste a Stripe secret or restricted key (sk_… or rk_…).", 422, "invalid");
+  const base = publicBaseUrl(req);
+  if (!base?.startsWith("https://")) throw new ApiError("Integration not configured: set PUBLIC_APP_URL to your https address so Stripe can confirm payments.", 503, "integration_not_configured");
+  const stripe = stripeFor(input.secret_key);
+  try {
+    await stripe.balance.retrieve();
+  } catch {
+    throw new ApiError("Stripe rejected that key. Check it in Stripe → Developers → API keys.", 422, "invalid");
+  }
+  const { data: existing } = await client.from("payment_accounts").select("id").eq("organization_id", orgId).eq("status", "active").maybeSingle();
+  if (existing) await client.from("payment_accounts").update({ status: "disabled" }).eq("organization_id", orgId).eq("id", existing.id);
+  const { data: row, error } = await client.from("payment_accounts").insert({
+    organization_id: orgId, provider: "stripe", label: input.label || (input.secret_key.includes("_test_") ? "Stripe (test mode)" : "Stripe"),
+    encrypted_credentials: sealJson({ secret_key: input.secret_key }), credential_hint: hintFor(input.secret_key), created_by: userId,
+  }).select(ACCOUNT_COLUMNS).single();
+  fromDb(error);
+  let webhookSecret = input.webhook_secret?.trim() || "";
+  let note = "";
+  if (!webhookSecret) {
+    try {
+      const endpoint = await stripe.webhookEndpoints.create({ url: webhookUrl(base, row!.id), enabled_events: ["checkout.session.completed", "charge.refunded"], description: "Sun Marketing Console invoices" });
+      webhookSecret = endpoint.secret || "";
+    } catch {
+      note = "This key can't create webhooks. In Stripe, add an endpoint for the address shown and paste its signing secret.";
+    }
+  }
+  const { error: e2 } = await client.from("payment_accounts").update({ encrypted_credentials: sealJson({ secret_key: input.secret_key, ...(webhookSecret ? { webhook_secret: webhookSecret } : {}) }) })
+    .eq("organization_id", orgId).eq("id", row!.id);
+  fromDb(e2);
+  return { account: row!, webhook_url: webhookUrl(base, row!.id), webhook_ready: !!webhookSecret, note };
+}
+
+export async function activeStripe(system: SupabaseClient, orgId: string) {
+  const { data } = await system.from("payment_accounts").select("id, encrypted_credentials").eq("organization_id", orgId).eq("provider", "stripe").eq("status", "active").maybeSingle();
+  if (!data) return null;
+  return { id: data.id as string, creds: openJson(data.encrypted_credentials) as StripeCreds };
+}
