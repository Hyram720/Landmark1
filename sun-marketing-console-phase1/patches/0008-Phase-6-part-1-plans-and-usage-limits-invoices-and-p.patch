+import { z } from "zod";
+import { readJson, scoped, tenantRoute } from "@/lib/tenant/api";
+import { govern } from "@/lib/billing/plans";
+
+export const dynamic = "force-dynamic";
+
+// Agency admins change a client account's plan or suspend/reactivate it.
+// The database decides who may (govern_organization).
+export const POST = tenantRoute("org.manage", async (ctx, req) => {
+  const input = await readJson(req, z.object({ org_id: z.string().uuid(), status: z.enum(["active", "suspended", "closed"]).optional(), plan: z.string().max(41).optional() }));
