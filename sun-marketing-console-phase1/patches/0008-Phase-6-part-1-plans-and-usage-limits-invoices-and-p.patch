+"use client";
+import { useEffect, useState } from "react";
+import TenantGate, { ErrorState, Loading } from "@/components/tenant/TenantGate";
+import ContactPicker, { type PickedContact } from "@/components/tenant/ContactPicker";
+import { api, atLeast, Org, personName, relativeTime, useResource } from "@/components/tenant/client";
+import { Copy, useToast } from "@/components/ui";
+
+type Line = { description: string; quantity: number; unit_cents: number };
+type Inv = {
+  id: string; kind: "invoice" | "estimate"; number: string; contact_id: string | null; status: string; currency: string; line_items: Line[]; tax_rate_bp: number;
+  subtotal_cents: number; tax_cents: number; total_cents: number; deposit_cents: number | null; amount_paid_cents: number; due_date: string | null; notes: string | null;
+  created_at: string; contacts?: { first_name: string | null; last_name: string | null; email: string | null } | null;
+};
+type Detail = { invoice: Inv; payments: { id: string; amount_cents: number; refunded_cents: number; method: string; note: string | null; created_at: string }[]; contact: PickedContact | null; public_path: string; amount_due: number };
+const fmt = (c: number, cur = "usd") => (c / 100).toLocaleString("en-US", { style: "currency", currency: cur.toUpperCase() });
+const PILL: Record<string, string> = { draft: "pill-neutral", sent: "pill-info", partially_paid: "pill-warn", paid: "pill-ok", void: "pill-neutral", accepted: "pill-ok", declined: "pill-bad" };
+const totals = (items: Line[], bp: number) => { const s = items.reduce((a, i) => a + Math.round(i.quantity * i.unit_cents), 0); const t = Math.round((s * bp) / 10000); return { s, t, total: s + t }; };
+
+function Editor({ initial, kind, onSaved, onCancel }: { initial: Detail | null; kind: "invoice" | "estimate"; onSaved: (id: string) => void; onCancel: () => void }) {
+  const inv = initial?.invoice;
+  const [contact, setContact] = useState<PickedContact | null>(initial?.contact ?? null);
+  const [lines, setLines] = useState<{ description: string; quantity: string; price: string }[]>(inv?.line_items.map((l) => ({ description: l.description, quantity: String(l.quantity), price: (l.unit_cents / 100).toFixed(2) })) ?? [{ description: "", quantity: "1", price: "" }]);
+  const [tax, setTax] = useState(inv ? String(inv.tax_rate_bp / 100) : "0");
+  const [deposit, setDeposit] = useState(inv?.deposit_cents ? (inv.deposit_cents / 100).toFixed(2) : "");
+  const [due, setDue] = useState(inv?.due_date ?? "");
+  const [notes, setNotes] = useState(inv?.notes ?? "");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const items: Line[] = lines.filter((l) => l.description.trim()).map((l) => ({ description: l.description.trim(), quantity: Number(l.quantity) || 0, unit_cents: Math.round((Number(l.price) || 0) * 100) }));
+  const bp = Math.round((Number(tax) || 0) * 100);
+  const t = totals(items, bp);
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>{inv ? `Edit ${inv.number}` : `New ${kind}`}</h3><div className="sub">Totals are calculated for you. Drafts can be edited until sent.</div></div></div>
+      <div className="card-pad stack">
+        <div className="field"><label htmlFor="iv-contact">Customer</label><ContactPicker id="iv-contact" value={contact} onChange={setContact} /></div>
+        <div className="table-wrap"><table>
+          <thead><tr><th>Description</th><th style={{ width: 90 }}>Qty</th><th style={{ width: 120 }}>Price</th><th style={{ width: 110 }}>Amount</th><th /></tr></thead>
+          <tbody>{lines.map((l, i) => (
+            <tr key={i}>
+              <td><input className="input" aria-label="Description" value={l.description} maxLength={300} onChange={(e) => setLines(lines.map((x, j) => (j === i ? { ...x, description: e.target.value } : x)))} /></td>
+              <td><input className="input" aria-label="Quantity" inputMode="decimal" value={l.quantity} onChange={(e) => setLines(lines.map((x, j) => (j === i ? { ...x, quantity: e.target.value } : x)))} /></td>
+              <td><input className="input" aria-label="Price" inputMode="decimal" placeholder="0.00" value={l.price} onChange={(e) => setLines(lines.map((x, j) => (j === i ? { ...x, price: e.target.value } : x)))} /></td>
+              <td className="small">{fmt(Math.round((Number(l.quantity) || 0) * Math.round((Number(l.price) || 0) * 100)))}</td>
+              <td><button type="button" className="btn btn-sm btn-ghost" aria-label="Remove line" onClick={() => setLines(lines.filter((_, j) => j !== i))}>✕</button></td>
+            </tr>
+          ))}</tbody>
+        </table></div>
+        <div><button type="button" className="btn btn-sm" onClick={() => setLines([...lines, { description: "", quantity: "1", price: "" }])}>Add line</button></div>
+        <div className="field-grid">
+          <div className="field"><label htmlFor="iv-tax">Tax rate (%)</label><input id="iv-tax" className="input" inputMode="decimal" value={tax} onChange={(e) => setTax(e.target.value)} /></div>
+          <div className="field"><label htmlFor="iv-dep">Deposit due first (optional)</label><input id="iv-dep" className="input" inputMode="decimal" placeholder="0.00" value={deposit} onChange={(e) => setDeposit(e.target.value)} /></div>
+          <div className="field"><label htmlFor="iv-due">Due date</label><input id="iv-due" type="date" className="input" value={due} onChange={(e) => setDue(e.target.value)} /></div>
+        </div>
+        <div className="field"><label htmlFor="iv-notes">Notes for the customer</label><textarea id="iv-notes" className="textarea" rows={2} maxLength={4000} value={notes} onChange={(e) => setNotes(e.target.value)} placeholder="Payment terms, warranty, thank you…" /></div>
+        <div className="kv small" style={{ maxWidth: 320, marginLeft: "auto" }}><dt>Subtotal</dt><dd>{fmt(t.s)}</dd><dt>Tax</dt><dd>{fmt(t.t)}</dd><dt><strong>Total</strong></dt><dd><strong>{fmt(t.total)}</strong></dd></div>
+        {error && <p className="form-error" role="alert">{error}</p>}
+        <div className="row"><button className="btn btn-primary" disabled={busy || !items.length} onClick={async () => {
+          setBusy(true); setError("");
+          try {
+            const body = { kind, contact_id: contact?.id ?? null, line_items: items, tax_rate_bp: bp, deposit_cents: deposit ? Math.round(Number(deposit) * 100) : null, due_date: due || null, notes: notes.trim() || null };
+            const r = inv ? await api<{ invoice: Inv }>(`/api/invoices/${inv.id}`, { method: "PUT", body }) : await api<{ invoice: Inv }>("/api/invoices", { body });
+            onSaved(r.invoice.id);
+          } catch (e) { setError(e instanceof Error ? e.message : "Could not save."); }
+          finally { setBusy(false); }
+        }}>{busy ? <span className="spin" /> : "Save draft"}</button><button className="btn btn-ghost" onClick={onCancel}>Cancel</button></div>
+      </div>
+    </div>
+  );
+}
+
+function View({ id, org, onEdit, onChanged, toast }: { id: string; org: Org; onEdit: (d: Detail) => void; onChanged: (id?: string) => void; toast: (m: string) => void }) {
+  const { data, error, loading, reload } = useResource<Detail>(`/api/invoices/${id}`);
+  const [origin, setOrigin] = useState("");
+  const [payAmount, setPayAmount] = useState("");
+  useEffect(() => setOrigin(window.location.origin), []);
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return null;
+  const i = data.invoice;
+  const manager = atLeast(org.role, "manager");
+  const act = async (body: Record<string, unknown>, done: string) => {
+    try { const r = await api<{ invoice?: { id: string }; delivery?: { sent: boolean; reason: string | null } }>(`/api/invoices/${id}`, { body }); toast(r.delivery && !r.delivery.sent ? `${done} Email not sent: ${r.delivery.reason || "check Channels"}. Copy the link instead.` : done); reload(); onChanged(r.invoice?.id); }
+    catch (e) { toast(e instanceof Error ? e.message : "That did not work."); }
+  };
+  const link = `${origin}${data.public_path}`;
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>{i.number} <span className={`pill ${PILL[i.status]}`}>{i.status.replace("_", " ")}</span></h3><div className="sub">{data.contact ? personName(data.contact) : "No customer"} · created {relativeTime(i.created_at)}{i.due_date ? ` · due ${i.due_date}` : ""}</div></div>
+        <div className="row" style={{ gap: 6, flexWrap: "wrap" }}>
+          {i.status === "draft" && <button className="btn btn-sm" onClick={() => onEdit(data)}>Edit</button>}
+          {i.status === "draft" && <button className="btn btn-sm btn-primary" onClick={() => act({ action: "send" }, "Sent.")}>Send to customer</button>}
+          {["sent", "partially_paid"].includes(i.status) && <button className="btn btn-sm" onClick={() => act({ action: "send" }, "Sent again.")}>Resend</button>}
+          {i.kind === "estimate" && i.status === "accepted" && <button className="btn btn-sm btn-primary" onClick={() => act({ action: "convert" }, "Invoice created from the estimate.")}>Create invoice</button>}
+          {manager && i.kind === "estimate" && i.status === "sent" && <><button className="btn btn-sm" onClick={() => act({ action: "accept" }, "Marked accepted.")}>Accepted</button><button className="btn btn-sm" onClick={() => act({ action: "decline" }, "Marked declined.")}>Declined</button></>}
+          {["draft", "sent"].includes(i.status) && i.amount_paid_cents === 0 && <button className="btn btn-sm btn-ghost" onClick={() => { if (window.confirm(`Void ${i.number}?`)) act({ action: "void" }, "Voided."); }}>Void</button>}
+        </div></div>
+      <div className="card-pad stack">
