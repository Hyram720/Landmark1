+import { describe, expect, it } from "vitest";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import type Stripe from "stripe";
+import { FakeDb } from "../support/fake-supabase";
+import { amountDue, computeTotals, handleStripeEvent, invoiceInput } from "@/lib/billing/invoices";
+import { domainInput, verifyDomain } from "@/lib/sites/domains";
+import { planInput } from "@/lib/billing/plans";
+
+const ORG = "11111111-1111-4111-8111-111111111111";
+const OTHER = "99999999-9999-4999-8999-999999999999";
+const INV = "44444444-4444-4444-8444-444444444444";
+
+describe("invoice math", () => {
+  it("matches the database's rounding", () => {
+    expect(computeTotals([{ quantity: 2, unit_cents: 15000 }, { quantity: 1, unit_cents: 5000 }], 650)).toEqual({ subtotal: 35000, tax: 2275, total: 37275 });
+    expect(computeTotals([{ quantity: 1.5, unit_cents: 333 }], 0)).toEqual({ subtotal: 500, tax: 0, total: 500 });
+  });
+  it("asks for the deposit first, then the balance", () => {
+    expect(amountDue({ total_cents: 100000, amount_paid_cents: 0, deposit_cents: 25000 })).toBe(25000);
+    expect(amountDue({ total_cents: 100000, amount_paid_cents: 25000, deposit_cents: 25000 })).toBe(75000);
+    expect(amountDue({ total_cents: 100000, amount_paid_cents: 100000, deposit_cents: null })).toBe(0);
+  });
+  it("validates input", () => {
+    expect(invoiceInput.safeParse({ line_items: [] }).success).toBe(false);
+    expect(invoiceInput.safeParse({ line_items: [{ description: "Work", quantity: 0, unit_cents: 100 }] }).success).toBe(false);
+    expect(invoiceInput.safeParse({ line_items: [{ description: "Work", quantity: 1, unit_cents: 100 }], tax_rate_bp: 6000 }).success).toBe(false);
+    expect(planInput.safeParse({ key: "Gold Plan", name: "Gold", price_cents: 100 }).success).toBe(false);
+    expect(planInput.safeParse({ key: "gold", name: "Gold", price_cents: 100, limits: { sms: 500, bogus: 1 } }).success).toBe(false);
+  });
+});
+
+function db() {
+  const d = new FakeDb();
+  d.tables.invoices = [{ id: INV, organization_id: ORG, number: "INV-0001", currency: "usd", contact_id: "c1", status: "sent", kind: "invoice" }];
+  d.tables.payments = [];
+  d.tables.activities = [];
+  d.tables.audit_log = [];
+  d.onInsert = (table, row) => {
+    if (table === "payments" && d.table("payments").some((p) => p.method === row.method && p.provider_payment_id === row.provider_payment_id)) return Object.assign(new Error("dup"), { code: "23505" });
+    return row;
+  };
+  return d;
+}
+const session = (org: string, extra: Partial<Stripe.Checkout.Session> = {}) => ({
+  type: "checkout.session.completed",
+  data: { object: { payment_status: "paid", metadata: { organization_id: org, invoice_id: INV }, payment_intent: "pi_1", amount_total: 37275, ...extra } },
+}) as unknown as Stripe.Event;
+
+describe("Stripe events", () => {
+  it("records a paid checkout once, on the right organization", async () => {
+    const d = db();
+    expect(await handleStripeEvent(d as unknown as SupabaseClient, ORG, session(ORG))).toBe("recorded");
+    expect(await handleStripeEvent(d as unknown as SupabaseClient, ORG, session(ORG))).toBe("duplicate");
+    expect(d.table("payments")).toHaveLength(1);
+    expect(d.table("payments")[0]).toMatchObject({ amount_cents: 37275, method: "stripe", provider_payment_id: "pi_1", organization_id: ORG });
+    expect(d.table("activities")[0].subject).toBe("Paid $372.75 on INV-0001");
+  });
+  it("ignores events that name another organization or are unpaid", async () => {
+    const d = db();
+    expect(await handleStripeEvent(d as unknown as SupabaseClient, ORG, session(OTHER))).toBe("ignored");
+    expect(await handleStripeEvent(d as unknown as SupabaseClient, ORG, session(ORG, { payment_status: "unpaid" }))).toBe("ignored");
+    expect(d.table("payments")).toHaveLength(0);
+  });
+  it("records refunds made in Stripe", async () => {
+    const d = db();
+    d.tables.payments = [{ id: "p1", organization_id: ORG, invoice_id: INV, method: "stripe", provider_payment_id: "pi_1", amount_cents: 37275, refunded_cents: 0 }];
+    const ev = { type: "charge.refunded", data: { object: { payment_intent: "pi_1", amount: 37275, amount_refunded: 10000 } } } as unknown as Stripe.Event;
+    expect(await handleStripeEvent(d as unknown as SupabaseClient, ORG, ev)).toBe("refund_recorded");
+    expect(d.table("payments")[0].refunded_cents).toBe(10000);
+    expect(await handleStripeEvent(d as unknown as SupabaseClient, ORG, ev)).toBe("ignored");
+  });
+});
+
+describe("custom domains", () => {
+  it("normalizes and validates domains", () => {
+    expect(domainInput.parse({ domain: " HTTPS://www.Acme-Roofing.com/about " }).domain).toBe("www.acme-roofing.com");
+    expect(domainInput.safeParse({ domain: "not a domain" }).success).toBe(false);
+    expect(domainInput.safeParse({ domain: "localhost" }).success).toBe(false);
+  });
+  it("is verified only when the TXT record matches, by the server", async () => {
+    const d = new FakeDb();
+    d.tables.site_domains = [{ id: "d1", organization_id: ORG, site_id: "s1", domain: "www.acme.test", verification_token: "tok123", status: "pending" }];
+    const ctx = { client: d as unknown as SupabaseClient, orgId: ORG, userId: "u1" };
+    const wrong = await verifyDomain(ctx, d as unknown as SupabaseClient, "d1", async () => [["other"]]);
+    expect(wrong.verified).toBe(false);
+    expect(d.table("site_domains")[0].status).toBe("pending");
+    const asked: string[] = [];
+    const right = await verifyDomain(ctx, d as unknown as SupabaseClient, "d1", async (name) => { asked.push(name); return [["tok", "123"]]; });
+    expect(asked).toEqual(["_sun-verify.www.acme.test"]);
+    expect(right.verified).toBe(true);
+    expect(d.table("site_domains")[0].status).toBe("verified");
+    await expect(verifyDomain(ctx, null, "nope")).rejects.toMatchObject({ status: 404 });
+  });
+});
