index 0000000..2e8ad88
--- /dev/null
+++ b/src/app/api/invoices/[id]/route.ts
@@ -0,0 +1,37 @@
+import { z } from "zod";
+import { ApiError, readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { can } from "@/lib/tenant/rbac";
+import { convertEstimate, invoiceDetail, invoiceInput, manualPaymentInput, recordManualPayment, sendInvoice, setStatus, updateDraft } from "@/lib/billing/invoices";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const GET = tenantRoute<P>("crm.read", async (ctx, _req, { id }) => invoiceDetail(scoped(ctx), uuid.parse(id)));
+export const PUT = tenantRoute<P>("crm.write", async (ctx, req, { id }) => ({ invoice: await updateDraft(scoped(ctx), uuid.parse(id), await readJson(req, invoiceInput)) }));
+
+const action = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("send") }),
+  z.object({ action: z.literal("void") }),
+  z.object({ action: z.literal("accept") }),
+  z.object({ action: z.literal("decline") }),
+  z.object({ action: z.literal("convert") }),
+  z.object({ action: z.literal("record_payment"), ...manualPaymentInput.shape }),
+]);
+
+export const POST = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const input = await readJson(req, action);
+  const c = scoped(ctx);
+  const iid = uuid.parse(id);
+  switch (input.action) {
+    case "send": return sendInvoice(c, iid, req);
+    case "void": return { invoice: await setStatus(c, iid, "void") };
+    case "accept": case "decline":
+      if (!can(ctx.org.role, "crm.delete")) throw new ApiError("A manager records a customer's decision.", 403, "forbidden");
+      return { invoice: await setStatus(c, iid, input.action === "accept" ? "accepted" : "declined") };
+    case "convert": return { invoice: await convertEstimate(c, iid) };
+    case "record_payment":
+      if (!can(ctx.org.role, "crm.delete")) throw new ApiError("A manager records payments.", 403, "forbidden");
+      await recordManualPayment(c, iid, input);
+      return invoiceDetail(c, iid);
+  }
+});
