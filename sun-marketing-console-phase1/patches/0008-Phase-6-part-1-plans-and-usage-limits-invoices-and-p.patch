+        <div className="card-pad stack">
+          {b.plans.map((p) => <div key={p.key} className="small"><strong>{p.name}</strong> <span className="muted">({p.key}{p.owner_org_id ? "" : ", platform"}) · {usd(p.price_cents)}/mo · {Object.entries(p.limits).map(([k, v]) => `${k.replace("_", " ")} ${v.toLocaleString()}`).join(", ") || "unlimited"}</span></div>)}
+          <div className="field-grid">
