+import { z } from "zod";
+import { fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { ACCOUNT_COLUMNS, connectStripe, webhookUrl } from "@/lib/payments/stripe-accounts";
+
+export const dynamic = "force-dynamic";
+
+export const GET = tenantRoute("org.read", async (ctx, req) => {
+  const { data, error } = await ctx.client.from("payment_accounts").select(ACCOUNT_COLUMNS).eq("organization_id", ctx.org.id).eq("status", "active").maybeSingle();
+  fromDb(error);
+  const base = publicBaseUrl(req);
+  return { account: data, webhook_url: data && base ? webhookUrl(base, data.id) : null };
+});
+
+export const POST = tenantRoute("org.manage", async (ctx, req) => {
+  const input = await readJson(req, z.object({ secret_key: z.string().trim().min(10).max(300), webhook_secret: z.string().trim().max(300).optional(), label: z.string().trim().max(80).optional() }));
+  const r = await connectStripe(ctx.client, ctx.org.id, ctx.session.user.id, input, req);
+  await audit(ctx.client, ctx.org.id, "payments.connected", { type: "payment_account", id: r.account.id }, { webhook_ready: r.webhook_ready });
+  return r;
+});
+
+export const DELETE = tenantRoute("org.manage", async (ctx) => {
+  const { error } = await ctx.client.from("payment_accounts").update({ status: "disabled" }).eq("organization_id", ctx.org.id).eq("status", "active");
+  fromDb(error);
+  await audit(ctx.client, ctx.org.id, "payments.disconnected", null);
+  return { ok: true };
+});
