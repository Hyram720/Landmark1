+import { NextResponse } from "next/server";
+import { z } from "zod";
+import { systemClient } from "@/lib/supabase/system";
+import { clientIp, takeLimit } from "@/lib/rate-limit";
+import { ApiError, errorResponse, readJson } from "@/lib/tenant/api";
+import { checkoutUrl, decideEstimate, publicInvoice } from "@/lib/billing/invoices";
+
+export const dynamic = "force-dynamic";
+type P = { params: Promise<{ token: string }> };
+
+async function setup(req: Request) {
+  if (!(await takeLimit("invoice-public", clientIp(req), 60, 600))) throw new ApiError("Too many requests.", 429, "rate_limited");
+  const system = systemClient();
+  if (!system) throw new ApiError("This page is not available right now.", 503, "integration_not_configured");
+  return system;
+}
+
+export async function GET(req: Request, { params }: P) {
+  try {
+    const system = await setup(req);
+    const found = await publicInvoice(system, (await params).token);
+    if (!found) throw new ApiError("This invoice is not available.", 404, "not_found");
+    const { invoice: i } = found;
+    return NextResponse.json({
+      business: found.business, branding: { display_name: found.branding.display_name, logo_url: found.branding.logo_url, color: found.branding.color, support_email: found.branding.support_email, support_phone: found.branding.support_phone },
+      customer: found.customer ? { name: [found.customer.first_name, found.customer.last_name].filter(Boolean).join(" ") } : null,
+      invoice: { kind: i.kind, number: i.number, status: i.status, currency: i.currency, line_items: i.line_items, tax_rate_bp: i.tax_rate_bp, subtotal_cents: i.subtotal_cents, tax_cents: i.tax_cents, total_cents: i.total_cents, deposit_cents: i.deposit_cents, amount_paid_cents: i.amount_paid_cents, due_date: i.due_date, notes: i.notes, created_at: i.created_at },
+      amount_due: found.amount_due, can_pay: found.can_pay,
+    }, { headers: { "Cache-Control": "no-store" } });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
+
+export async function POST(req: Request, { params }: P) {
+  try {
+    const system = await setup(req);
+    const token = (await params).token;
+    const { action } = await readJson(req, z.object({ action: z.enum(["pay", "accept", "decline"]) }));
+    if (action === "pay") return NextResponse.json({ url: await checkoutUrl(system, token, req) });
+    await decideEstimate(system, token, action === "accept" ? "accepted" : "declined");
+    return NextResponse.json({ ok: true });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
