+            <button className="btn btn-sm" disabled={!Number(payAmount)} onClick={async () => { await act({ action: "record_payment", amount_cents: Math.round(Number(payAmount) * 100), note: "Recorded by hand" }, "Payment recorded."); setPayAmount(""); }}>Record cash/check payment</button></div>}
