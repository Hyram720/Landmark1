+import { ApiError, tenantRoute } from "@/lib/tenant/api";
+import { systemClient } from "@/lib/supabase/system";
+import { locationsFor } from "@/lib/reputation/google";
+
+export const dynamic = "force-dynamic";
+
+// Business locations the connected Google account manages.
+export const GET = tenantRoute("org.manage", async (ctx) => {
+  const system = systemClient();
+  if (!system) throw new ApiError("Integration not configured: SUPABASE_SERVICE_ROLE_KEY is needed for Google.", 503, "integration_not_configured");
+  return { locations: await locationsFor(system, ctx.org.id) };
+});
diff --git a/src/app/api/reputation/google/route.ts b/src/app/api/reputation/google/route.ts
new file mode 100644
index 0000000..55cc9de
--- /dev/null
+++ b/src/app/api/reputation/google/route.ts
@@ -0,0 +1,63 @@
+import { z } from "zod";
+import { ApiError, fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { takeLimit } from "@/lib/rate-limit";
+import { publicBaseUrl, systemClient } from "@/lib/supabase/system";
+import { activeConnection, googleConfigured, locationsFor, redirectUri, revokeToken, syncConnection } from "@/lib/reputation/google";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+const COLUMNS = "id, account_email, account_name, location_name, location_title, source_id, status, last_synced_at, last_error, created_at";
+
+export const GET = tenantRoute("crm.read", async (ctx, req) => {
+  const { data, error } = await ctx.client.from("review_connections").select(COLUMNS).eq("organization_id", ctx.org.id).eq("provider", "google").neq("status", "disabled").maybeSingle();
+  fromDb(error);
+  const base = publicBaseUrl(req);
+  return { configured: googleConfigured(), connection: data, redirect_uri: base ? redirectUri(base) : null };
+});
+
+const action = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("select"), location: z.string().regex(/^locations\/[0-9]{1,40}$/) }),
+  z.object({ action: z.literal("sync") }),
+]);
+
+export const POST = tenantRoute("org.manage", async (ctx, req) => {
+  const input = await readJson(req, action);
+  const system = systemClient();
+  if (!system) throw new ApiError("Integration not configured: SUPABASE_SERVICE_ROLE_KEY is needed for Google.", 503, "integration_not_configured");
+  if (input.action === "select") {
+    // Only a location the connected Google account actually manages.
+    const loc = (await locationsFor(system, ctx.org.id)).find((l) => l.location === input.location);
+    if (!loc) throw new ApiError("That location isn't managed by the connected Google account.", 404, "not_found");
+    let sourceId: string | null = null;
+    if (loc.review_url) {
+      const { data: existing } = await ctx.client.from("review_sources").select("id").eq("organization_id", ctx.org.id).eq("platform", "google").limit(1).maybeSingle();
+      if (existing) {
+        sourceId = existing.id;
+        await ctx.client.from("review_sources").update({ review_url: loc.review_url, status: "active" }).eq("organization_id", ctx.org.id).eq("id", existing.id);
+      } else {
+        const { data: s } = await ctx.client.from("review_sources").insert({ organization_id: ctx.org.id, platform: "google", name: "Google", review_url: loc.review_url, position: 0 }).select("id").single();
+        sourceId = s?.id ?? null;
+      }
+    }
+    const { error } = await ctx.client.from("review_connections").update({ account_name: loc.account, location_name: loc.location, location_title: loc.title.slice(0, 200), source_id: sourceId, status: "active" })
+      .eq("organization_id", ctx.org.id).eq("provider", "google").neq("status", "disabled");
+    fromDb(error);
+    await audit(ctx.client, ctx.org.id, "reputation.google_location", null, { location: loc.title });
+  } else if (!(await takeLimit("google-sync", ctx.org.id, 6, 3600))) {
+    throw new ApiError("You can sync a few times an hour; reviews also sync automatically every hour.", 429, "rate_limited");
+  }
+  const conn = await activeConnection(system, ctx.org.id);
+  if (!conn) throw new ApiError("Choose a location first.", 409, "conflict");
+  return { sync: await syncConnection(system, conn) };
+});
+
+export const DELETE = tenantRoute("org.manage", async (ctx) => {
+  const system = systemClient();
+  const { data } = system ? await system.from("review_connections").select("id, encrypted_credentials").eq("organization_id", ctx.org.id).eq("provider", "google").neq("status", "disabled").maybeSingle() : { data: null };
+  if (data) await revokeToken(data.encrypted_credentials);
+  const { error } = await ctx.client.from("review_connections").update({ status: "disabled" }).eq("organization_id", ctx.org.id).eq("provider", "google").neq("status", "disabled");
+  fromDb(error);
+  await audit(ctx.client, ctx.org.id, "reputation.google_disconnected", null);
+  return { ok: true };
+});
diff --git a/src/app/api/reputation/google/start/route.ts b/src/app/api/reputation/google/start/route.ts
