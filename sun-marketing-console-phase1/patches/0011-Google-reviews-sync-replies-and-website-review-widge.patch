@@ -0,0 +1,15 @@
+import { NextResponse } from "next/server";
+import { systemClient } from "@/lib/supabase/system";
+
+export const dynamic = "force-dynamic";
+
+// Data for an embedded review widget. Cached briefly at the edge.
+export async function GET(_req: Request, { params }: { params: Promise<{ token: string }> }) {
+  const token = (await params).token;
+  if (!/^[0-9a-f]{24}$/.test(token)) return NextResponse.json({ error: "Not found." }, { status: 404 });
+  const system = systemClient();
+  if (!system) return NextResponse.json({ error: "Not available." }, { status: 503 });
+  const { data } = await system.rpc("review_widget_data", { p_token: token });
+  if (!data) return NextResponse.json({ error: "Not found." }, { status: 404 });
+  return NextResponse.json(data, { headers: { "Cache-Control": "public, max-age=300", "Access-Control-Allow-Origin": "*" } });
+}
diff --git a/src/app/api/reputation/google/callback/route.ts b/src/app/api/reputation/google/callback/route.ts
new file mode 100644
index 0000000..c70b04f
--- /dev/null
+++ b/src/app/api/reputation/google/callback/route.ts
@@ -0,0 +1,39 @@
+import { NextResponse } from "next/server";
+import { cookies } from "next/headers";
+import { timingSafeEqual } from "node:crypto";
+import { fromDb, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { exchangeCode, sealToken, STATE_COOKIE } from "@/lib/reputation/google";
+
+export const dynamic = "force-dynamic";
+
+const back = (base: string, q: string) => {
+  const res = NextResponse.redirect(`${base}/trust?${q}`);
+  res.cookies.set(STATE_COOKIE, "", { path: "/api/reputation/google", maxAge: 0 });
+  return res;
+};
+
+// Google sends the admin back here with a one-time code.
+export const GET = tenantRoute("org.manage", async (ctx, req) => {
+  const base = publicBaseUrl(req) || new URL(req.url).origin;
+  const url = new URL(req.url);
+  if (url.searchParams.get("error")) return back(base, "google=cancelled");
+  const [state, orgId] = ((await cookies()).get(STATE_COOKIE)?.value || "").split(".");
+  const given = url.searchParams.get("state") || "";
+  const same = state && given.length === state.length && timingSafeEqual(Buffer.from(state), Buffer.from(given));
+  if (!same || orgId !== ctx.org.id) return back(base, "google=expired");
+  const code = url.searchParams.get("code");
+  if (!code) return back(base, "google=cancelled");
+  try {
+    const t = await exchangeCode(code, base);
+    await ctx.client.from("review_connections").update({ status: "disabled" }).eq("organization_id", ctx.org.id).eq("provider", "google").neq("status", "disabled");
+    const { error } = await ctx.client.from("review_connections").insert({ organization_id: ctx.org.id, provider: "google", encrypted_credentials: sealToken(t.refresh_token), account_email: t.email?.slice(0, 254) ?? null });
+    fromDb(error);
+    await audit(ctx.client, ctx.org.id, "reputation.google_connected", null, { account: t.email });
+    return back(base, "google=connected");
+  } catch (e) {
+    console.error("[google oauth]", e);
+    return back(base, "google=failed");
+  }
+});
