+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { FakeDb } from "../support/fake-supabase";
+import { authUrl, listLocations, mapReview, postGoogleReply, sealToken, syncConnection } from "@/lib/reputation/google";
+import { widgetInput } from "@/lib/reputation/widgets";
+
+const ORG = "11111111-1111-4111-8111-111111111111";
+const db = (d: FakeDb) => d as unknown as SupabaseClient;
+const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { "Content-Type": "application/json" } });
+
+beforeEach(() => {
+  vi.stubEnv("APP_ENCRYPTION_KEY", "k".repeat(40));
+  vi.stubEnv("GOOGLE_CLIENT_ID", "cid.apps.googleusercontent.com");
+  vi.stubEnv("GOOGLE_CLIENT_SECRET", "secret");
+});
+afterEach(() => vi.unstubAllEnvs());
+
+describe("Google review mapping", () => {
+  it("maps star ratings, anonymous reviewers and owner replies", () => {
+    expect(mapReview({ reviewId: "r1", starRating: "FOUR", reviewer: { displayName: "Dana Wright" }, comment: " Great work ", createTime: "2026-10-01T10:00:00Z", reviewReply: { comment: "Thanks Dana!" } }))
+      .toMatchObject({ external_id: "r1", rating: 4, author_name: "Dana Wright", body: "Great work", reply: "Thanks Dana!" });
+    expect(mapReview({ reviewId: "r2", starRating: "ONE", reviewer: { isAnonymous: true, displayName: "x" }, createTime: "2026-10-01T10:00:00Z" })).toMatchObject({ rating: 1, author_name: null, body: null, reply: null });
+    expect(mapReview({ reviewId: "r3", starRating: "STAR_RATING_UNSPECIFIED", createTime: "2026-10-01T10:00:00Z" })).toBeNull();
+  });
+  it("asks Google for offline access to business profiles only", () => {
+    const u = new URL(authUrl("st4te", "https://console.test"));
+    expect(u.searchParams.get("scope")).toContain("business.manage");
+    expect(u.searchParams.get("access_type")).toBe("offline");
+    expect(u.searchParams.get("redirect_uri")).toBe("https://console.test/api/reputation/google/callback");
+    expect(u.searchParams.get("state")).toBe("st4te");
+  });
+  it("widget settings are bounded", () => {
+    expect(widgetInput.safeParse({ min_rating: 0 }).success).toBe(false);
+    expect(widgetInput.safeParse({ max_items: 50 }).success).toBe(false);
+    expect(widgetInput.parse({})).toMatchObject({ min_rating: 1, max_items: 6, layout: "grid" });
+  });
+});
+
+describe("Google sync", () => {
+  const conn = () => ({ id: "c1", organization_id: ORG, account_name: "accounts/1", location_name: "locations/2", source_id: "s1", last_synced_at: null, encrypted_credentials: sealToken("refresh-1") });
+  it("adds new reviews, updates edited ones and records replies", async () => {
+    const d = new FakeDb();
+    d.tables.review_connections = [{ id: "c1", status: "active" }];
+    d.tables.reviews = [{ id: "x1", organization_id: ORG, platform: "google", external_id: "old", rating: 2, body: "Slow.", response_body: null, response_status: "none" }];
+    const calls: string[] = [];
+    const f = (async (url: string, init?: RequestInit) => {
+      calls.push(`${init?.method || "GET"} ${url.split("?")[0]}`);
+      if (url.includes("oauth2.googleapis.com/token")) return json({ access_token: "at" });
+      return json({ reviews: [
+        { reviewId: "new", starRating: "FIVE", reviewer: { displayName: "Mia" }, comment: "Perfect.", createTime: "2026-10-05T00:00:00Z" },
+        { reviewId: "old", starRating: "FOUR", reviewer: { displayName: "Sam" }, comment: "Slow, but fixed it.", createTime: "2026-09-01T00:00:00Z", reviewReply: { comment: "Thanks Sam" } },
+      ] });
+    }) as typeof fetch;
+    const r = await syncConnection(db(d), conn(), f, new Date("2026-10-07T00:00:00Z"));
+    expect(r).toMatchObject({ ok: true, added: 1, updated: 1 });
+    expect(d.table("reviews").find((x) => x.external_id === "new")).toMatchObject({ rating: 5, author_name: "Mia", source_id: "s1", platform: "google" });
+    expect(d.table("reviews").find((x) => x.external_id === "old")).toMatchObject({ rating: 4, body: "Slow, but fixed it.", response_status: "posted", response_body: "Thanks Sam" });
+    expect(d.table("review_connections")[0]).toMatchObject({ last_error: null, last_synced_at: "2026-10-07T00:00:00.000Z" });
+    expect(calls).toContain("GET https://mybusiness.googleapis.com/v4/accounts/1/locations/2/reviews");
+  });
+  it("marks the connection for reconnecting when Google access is revoked", async () => {
+    const d = new FakeDb();
+    d.tables.review_connections = [{ id: "c1", status: "active" }];
+    const f = (async () => json({ error: "invalid_grant" }, 400)) as typeof fetch;
+    const r = await syncConnection(db(d), conn(), f);
+    expect(r.ok).toBe(false);
+    expect(d.table("review_connections")[0]).toMatchObject({ status: "error" });
+    expect(String(d.table("review_connections")[0].last_error)).toMatch(/Reconnect Google/);
+  });
+  it("lists locations across accounts with their review links", async () => {
+    const f = (async (url: string) => url.includes("/v1/accounts") && !url.includes("/locations")
+      ? json({ accounts: [{ name: "accounts/1" }] })
+      : json({ locations: [{ name: "locations/2", title: "Acme Roofing", storefrontAddress: { addressLines: ["1 Main St"], locality: "Cherry Hill", administrativeArea: "NJ" }, metadata: { newReviewUri: "https://g.page/r/abc/review" } }] })) as typeof fetch;
+    expect(await listLocations("at", f)).toEqual([{ account: "accounts/1", location: "locations/2", title: "Acme Roofing", address: "1 Main St, Cherry Hill, NJ", review_url: "https://g.page/r/abc/review" }]);
+  });
+  it("posts replies only for Google reviews with an active connection", async () => {
+    const d = new FakeDb();
+    await expect(postGoogleReply(db(d), ORG, { platform: "yelp", external_id: "y" }, "Thanks")).rejects.toMatchObject({ status: 422 });
+    await expect(postGoogleReply(db(d), ORG, { platform: "google", external_id: "r1" }, "Thanks")).rejects.toMatchObject({ code: "integration_not_configured" });
+    d.tables.review_connections = [{ ...conn(), provider: "google", status: "active" }];
+    const sent: { url: string; body: string }[] = [];
+    const f = (async (url: string, init?: RequestInit) => {
+      if (url.includes("/token")) return json({ access_token: "at" });
+      sent.push({ url, body: String(init?.body) });
+      return json({ comment: "Thanks" });
+    }) as typeof fetch;
+    await postGoogleReply(db(d), ORG, { platform: "google", external_id: "r1" }, "Thanks", f);
+    expect(sent).toEqual([{ url: "https://mybusiness.googleapis.com/v4/accounts/1/locations/2/reviews/r1/reply", body: JSON.stringify({ comment: "Thanks" }) }]);
+  });
+});
