+// Embeddable review widget: <iframe src="https://<console>/w/reviews/<token>">.
+// Always shows the true average and count of all reviews.
+function Stars({ n, size = 15 }: { n: number; size?: number }) {
+  return <span aria-label={`${n} out of 5 stars`} style={{ color: "#f5a623", fontSize: size, letterSpacing: 1 }}>{"★★★★★".slice(0, Math.round(n))}<span style={{ color: "#d6d3cc" }}>{"★★★★★".slice(Math.round(n))}</span></span>;
