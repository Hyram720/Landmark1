diff --git a/supabase/migrations/20261013120000_reputation_google.sql b/supabase/migrations/20261013120000_reputation_google.sql
new file mode 100644
index 0000000..c74ac1e
--- /dev/null
+++ b/supabase/migrations/20261013120000_reputation_google.sql
@@ -0,0 +1,141 @@
+-- Reputation: Google Business Profile connection and public review widgets.
+--   * review_connections: one Google connection per organization. The OAuth
+--     refresh token is encrypted by the application (APP_ENCRYPTION_KEY) and
+--     never readable through the API; syncing runs on the server.
+--   * review_widgets: an embeddable list of recent reviews with the true
+--     average and count of all reviews, so a filtered display never
+--     misrepresents the overall rating.
+
+-- Older reviews (imported history, CSV or first sync) go on the timeline but
+-- no longer open tasks or start automations; only fresh reviews do.
+create or replace function public.tg_reviews_created() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare v_label text := coalesce(nullif(new.author_name, ''), 'a customer'); v_fresh boolean := new.published_at >= now() - interval '14 days';
+begin
+  if new.contact_id is not null then
+    insert into public.activities(organization_id, contact_id, kind, direction, subject, body, metadata, actor_type)
+    values (new.organization_id, new.contact_id, 'review', 'inbound', left(format('Left a %s-star %s review', new.rating, initcap(new.platform)), 300),
+            left(new.body, 20000), jsonb_build_object('review_id', new.id), 'contact');
+  end if;
+  if not v_fresh then return null; end if;
+  if new.rating <= 2 then
+    insert into public.tasks(organization_id, title, description, priority, due_at, contact_id)
+    values (new.organization_id, left(format('Respond to %s-star %s review from %s', new.rating, initcap(new.platform), v_label), 200),
+            left(coalesce(new.body, ''), 4000), 'high', now() + interval '24 hours', new.contact_id);
+  end if;
+  perform public.emit_event(new.organization_id, 'review.received', new.contact_id, new.id,
+    jsonb_build_object('rating', new.rating, 'platform', new.platform));
+  return null;
+end $$;
+
+create table public.review_connections (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  provider text not null default 'google' check (provider in ('google')),
+  encrypted_credentials text not null check (length(encrypted_credentials) between 20 and 8000),
+  account_email text check (length(account_email) <= 254),
+  account_name text check (account_name ~ '^accounts/[0-9]{1,40}$'),
+  location_name text check (location_name ~ '^locations/[0-9]{1,40}$'),
+  location_title text check (length(location_title) <= 200),
+  source_id uuid,
+  status text not null default 'choose_location' check (status in ('choose_location', 'active', 'error', 'disabled')),
+  last_synced_at timestamptz,
+  last_error text check (length(last_error) <= 500),
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  check (status <> 'active' or (account_name is not null and location_name is not null)),
+  foreign key (source_id, organization_id) references public.review_sources(id, organization_id) on delete set null (source_id)
+);
+create unique index review_connections_one on public.review_connections(organization_id, provider) where status <> 'disabled';
+create trigger review_connections_updated before update on public.review_connections for each row execute function public.tg_set_updated_at();
+
+-- People choose the location and can disable; sync state is the server's.
+create or replace function public.tg_review_connections_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    new.created_by := auth.uid(); new.last_synced_at := null; new.last_error := null;
+    if new.status not in ('choose_location') then new.status := 'choose_location'; end if;
+    return new;
+  end if;
+  if new.last_synced_at is distinct from old.last_synced_at or new.last_error is distinct from old.last_error
+     or new.organization_id <> old.organization_id or new.provider <> old.provider or new.created_by is distinct from old.created_by then
+    raise exception 'Sync details are maintained by the server.' using errcode = '42501';
+  end if;
+  if new.status = 'error' and old.status <> 'error' then
+    raise exception 'Sync details are maintained by the server.' using errcode = '42501';
+  end if;
+  return new;
+end $$;
+create trigger review_connections_guard before insert or update on public.review_connections
+  for each row execute function public.tg_review_connections_guard();
+
+create table public.review_widgets (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  name text not null default 'Reviews' check (length(btrim(name)) between 1 and 80),
+  public_token text not null unique default encode(extensions.gen_random_bytes(12), 'hex'),
+  min_rating smallint not null default 1 check (min_rating between 1 and 5),
+  max_items smallint not null default 6 check (max_items between 1 and 20),
+  layout text not null default 'grid' check (layout in ('grid', 'list', 'badge')),
+  theme text not null default 'light' check (theme in ('light', 'dark')),
+  status text not null default 'active' check (status in ('active', 'disabled')),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+create trigger review_widgets_updated before update on public.review_widgets for each row execute function public.tg_set_updated_at();
+
+create or replace function public.tg_review_widgets_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user in ('authenticated', 'anon') and tg_op = 'UPDATE' and new.public_token <> old.public_token then
+    raise exception 'The widget address cannot be changed; create a new widget instead.' using errcode = '42501';
+  end if;
+  if current_user in ('authenticated', 'anon') and tg_op = 'INSERT' then
+    new.public_token := encode(extensions.gen_random_bytes(12), 'hex');
+  end if;
+  return new;
+end $$;
+create trigger review_widgets_guard before insert or update on public.review_widgets
+  for each row execute function public.tg_review_widgets_guard();
+
+-- Public widget data: the true average and count of all reviews, plus the
+-- most recent reviews at or above the widget's minimum rating.
+create or replace function public.review_widget_data(p_token text) returns jsonb
+language sql stable security definer set search_path = '' as $$
+  select jsonb_build_object(
+    'business', coalesce(nullif(o.branding ->> 'display_name', ''), o.name),
+    'layout', w.layout, 'theme', w.theme, 'min_rating', w.min_rating,
+    'average', (select round(avg(r.rating)::numeric, 1) from public.reviews r where r.organization_id = w.organization_id),
+    'count', (select count(*) from public.reviews r where r.organization_id = w.organization_id),
+    'review_url', (select s.review_url from public.review_sources s where s.organization_id = w.organization_id and s.status = 'active' order by (s.platform = 'google') desc, s.position limit 1),
+    'reviews', coalesce((select jsonb_agg(x) from (
+        select jsonb_build_object('rating', r.rating, 'author', coalesce(nullif(split_part(btrim(r.author_name), ' ', 1), ''), 'A customer'),
+                                  'body', left(r.body, 600), 'platform', r.platform, 'published_at', r.published_at,
+                                  'reply', case when r.response_status = 'posted' then left(r.response_body, 400) end) as x
+          from public.reviews r
+         where r.organization_id = w.organization_id and r.rating >= w.min_rating and coalesce(btrim(r.body), '') <> ''
+         order by r.published_at desc limit w.max_items) q), '[]'::jsonb))
+  from public.review_widgets w join public.organizations o on o.id = w.organization_id and o.status = 'active'
+  where w.public_token = p_token and w.status = 'active'
+$$;
+
+alter table public.review_connections enable row level security;
+alter table public.review_widgets enable row level security;
+create policy review_connections_read on public.review_connections for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy review_connections_write on public.review_connections for all to authenticated
+  using (public.org_rank(organization_id) >= 4) with check (public.org_rank(organization_id) >= 4);
+create policy review_widgets_read on public.review_widgets for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy review_widgets_write on public.review_widgets for all to authenticated
+  using (public.org_rank(organization_id) >= 3) with check (public.org_rank(organization_id) >= 3);
+
+revoke all on public.review_connections, public.review_widgets from anon, authenticated;
+grant select (id, organization_id, provider, account_email, account_name, location_name, location_title, source_id, status, last_synced_at, last_error, created_by, created_at, updated_at)
+  on public.review_connections to authenticated;
+grant insert, update, delete on public.review_connections to authenticated;
+grant select, insert, update, delete on public.review_widgets to authenticated;
+grant all on public.review_connections, public.review_widgets to service_role;
+revoke execute on function public.review_widget_data(text) from public;
+grant execute on function public.review_widget_data(text) to anon, authenticated, service_role;
diff --git a/supabase/tests/reputation_google.test.sql b/supabase/tests/reputation_google.test.sql
new file mode 100644
index 0000000..d7a72c8
--- /dev/null
+++ b/supabase/tests/reputation_google.test.sql
@@ -0,0 +1,111 @@
+-- Google review connection and review widget security tests.
+-- Run with scripts/test-db.sh.
+\set ON_ERROR_STOP 1
+set client_min_messages = notice;
+
+create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, false);
+  execute 'set role authenticated';
+end $$;
+create or replace function pg_temp.as_service() returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', '{"role":"service_role"}', false);
+  execute 'set role service_role';
+end $$;
+create or replace function pg_temp.reset_user() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', false);
+end $$;
+create or replace function pg_temp.expect_error(p_sql text, p_label text) returns void language plpgsql as $$
+begin
+  begin execute p_sql; exception when others then raise notice 'ok   (denied) %', p_label; return; end;
+  raise exception 'FAIL expected an error: %', p_label;
+end $$;
+create or replace function pg_temp.expect(p_ok boolean, p_label text) returns void language plpgsql as $$
+begin
+  if not coalesce(p_ok, false) then raise exception 'FAIL %', p_label; end if;
+  raise notice 'ok   %', p_label;
+end $$;
+
+-- 1 = staff owner of agency A; 2 = owner of client G; 3 = member of G; 4 = owner of client H
+insert into auth.users values
+  ('62000000-0000-0000-0000-000000000001', 'staff@rg.test'), ('62000000-0000-0000-0000-000000000002', 'owner@rgg.test'),
+  ('62000000-0000-0000-0000-000000000003', 'member@rgg.test'), ('62000000-0000-0000-0000-000000000004', 'owner@rgh.test');
+insert into public.team_members(user_id, email, active) values ('62000000-0000-0000-0000-000000000001', 'staff@rg.test', true);
+create temp table ids (k text primary key, v uuid);
+grant all on ids to authenticated, service_role, anon;
+create temp table toks (k text primary key, v text);
+grant all on toks to authenticated, service_role, anon;
+select pg_temp.as_user('62000000-0000-0000-0000-000000000001');
+insert into ids select 'a', public.create_organization('Agency RG', 'agency');
+insert into ids select 'g', public.create_organization('Client RG G', 'client', (select v from ids where k = 'a'));
+insert into ids select 'h', public.create_organization('Client RG H', 'client', (select v from ids where k = 'a'));
+select public.add_member_by_email((select v from ids where k = 'g'), 'owner@rgg.test', 'owner');
+select public.add_member_by_email((select v from ids where k = 'g'), 'member@rgg.test', 'member');
+select public.add_member_by_email((select v from ids where k = 'h'), 'owner@rgh.test', 'owner');
+select pg_temp.reset_user();
+
+-- 1. Connections
+select pg_temp.as_user('62000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$insert into public.review_connections(organization_id, encrypted_credentials) values ((select v from ids where k = 'g'), repeat('x', 40))$$, 'members cannot connect Google');
+select pg_temp.reset_user();
+select pg_temp.as_user('62000000-0000-0000-0000-000000000002');
+with c as (insert into public.review_connections(organization_id, encrypted_credentials, status, last_synced_at) values ((select v from ids where k = 'g'), repeat('x', 40), 'active', now()) returning id)
+insert into ids select 'conn', id from c;
+select pg_temp.expect((select status = 'choose_location' and last_synced_at is null from public.review_connections where id = (select v from ids where k = 'conn')), 'new connections start by choosing a location');
+select pg_temp.expect_error($$select encrypted_credentials from public.review_connections$$, 'the Google token is not readable');
+select pg_temp.expect_error($$update public.review_connections set last_synced_at = now()$$, 'people cannot fake sync state');
+update public.review_connections set account_name = 'accounts/123', location_name = 'locations/456', location_title = 'G Roofing', status = 'active' where id = (select v from ids where k = 'conn');
+select pg_temp.expect((select status = 'active' from public.review_connections where id = (select v from ids where k = 'conn')), 'owners choose the location');
+select pg_temp.expect_error($$insert into public.review_connections(organization_id, encrypted_credentials) values ((select v from ids where k = 'g'), repeat('y', 40))$$, 'one Google connection per account');
+select pg_temp.reset_user();
+select pg_temp.as_user('62000000-0000-0000-0000-000000000004');
+select pg_temp.expect((select count(*) = 0 from public.review_connections), 'other businesses cannot see the connection');
+select pg_temp.reset_user();
+select pg_temp.as_service();
+update public.review_connections set last_synced_at = now(), last_error = null where id = (select v from ids where k = 'conn');
+select pg_temp.expect((select last_synced_at is not null from public.review_connections where id = (select v from ids where k = 'conn')), 'the server records sync state');
+select pg_temp.reset_user();
+
+-- 2. Widgets show the true average of all reviews
+select pg_temp.as_user('62000000-0000-0000-0000-000000000003');
+insert into public.reviews(organization_id, platform, rating, author_name, body, published_at) values
+  ((select v from ids where k = 'g'), 'google', 5, 'Dana Wright', 'Great crew, fast work.', now() - interval '1 day'),
+  ((select v from ids where k = 'g'), 'google', 1, 'Sam Doe', 'Never showed up.', now() - interval '2 days'),
+  ((select v from ids where k = 'g'), 'google', 4, null, 'Good price.', now() - interval '3 days');
+select pg_temp.expect_error($$insert into public.review_widgets(organization_id, name) values ((select v from ids where k = 'g'), 'Home page')$$, 'members cannot create widgets');
+select pg_temp.reset_user();
+select pg_temp.as_user('62000000-0000-0000-0000-000000000002');
+with w as (insert into public.review_widgets(organization_id, name, min_rating, public_token) values ((select v from ids where k = 'g'), 'Home page', 4, 'chosen-token') returning public_token)
+insert into toks select 'w', public_token from w;
+select pg_temp.expect((select v <> 'chosen-token' from toks where k = 'w'), 'widget addresses are random');
+select pg_temp.expect_error($$update public.review_widgets set public_token = 'x' where organization_id = (select v from ids where k = 'g')$$, 'widget addresses cannot be changed');
+select pg_temp.reset_user();
+set role anon;
+select pg_temp.expect((select (public.review_widget_data((select v from toks where k = 'w')) ->> 'count')::int = 3), 'the widget counts every review');
+select pg_temp.expect((select (public.review_widget_data((select v from toks where k = 'w')) ->> 'average')::numeric = 3.3), 'the widget shows the true average, low ratings included');
+select pg_temp.expect((select jsonb_array_length(public.review_widget_data((select v from toks where k = 'w')) -> 'reviews') = 2), 'the list respects the minimum rating');
+select pg_temp.expect((select public.review_widget_data((select v from toks where k = 'w')) -> 'reviews' -> 0 ->> 'author' = 'Dana'), 'only first names are shown');
+select pg_temp.expect(public.review_widget_data('unknown') is null, 'unknown widgets show nothing');
+reset role;
+select pg_temp.as_user('62000000-0000-0000-0000-000000000002');
+update public.review_widgets set status = 'disabled' where organization_id = (select v from ids where k = 'g');
+select pg_temp.reset_user();
+set role anon;
+select pg_temp.expect(public.review_widget_data((select v from toks where k = 'w')) is null, 'disabled widgets show nothing');
+reset role;
+
+-- 3. Imported history does not flood tasks or automations
+select pg_temp.as_service();
+insert into public.reviews(organization_id, platform, external_id, rating, author_name, body, published_at)
+values ((select v from ids where k = 'h'), 'google', 'old-1', 1, 'Old Timer', 'Bad visit in 2023.', now() - interval '400 days');
+select pg_temp.expect((select count(*) = 0 from public.tasks where organization_id = (select v from ids where k = 'h')), 'old imported reviews do not open tasks');
+insert into public.reviews(organization_id, platform, external_id, rating, author_name, body, published_at)
+values ((select v from ids where k = 'h'), 'google', 'new-1', 2, 'Recent', 'Late again.', now() - interval '1 day');
+select pg_temp.expect((select count(*) = 1 from public.tasks where organization_id = (select v from ids where k = 'h')), 'fresh negative reviews still open a task');
+select pg_temp.expect_error($$insert into public.reviews(organization_id, platform, external_id, rating, published_at) values ((select v from ids where k = 'h'), 'google', 'new-1', 5, now())$$, 'each Google review is stored once');
+select pg_temp.reset_user();
+
+\echo 'ALL REPUTATION GOOGLE TESTS PASSED'
