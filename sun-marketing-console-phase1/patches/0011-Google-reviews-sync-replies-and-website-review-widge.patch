+          {d.reviews.map((r, i) => (
+            <figure key={i} style={{ margin: 0, background: c.card, border: `1px solid ${c.line}`, borderRadius: 12, padding: 12 }}>
+              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", gap: 8 }}><Stars n={r.rating} /><span style={{ color: c.muted, fontSize: 12 }}>{new Date(r.published_at).toLocaleDateString("en-US", { month: "short", year: "numeric" })}</span></div>
+              <blockquote style={{ margin: "8px 0", fontSize: 14, lineHeight: 1.5 }}>{r.body}</blockquote>
+              <figcaption style={{ fontSize: 13, color: c.muted }}>{r.author} · {r.platform === "google" ? "Google" : r.platform[0].toUpperCase() + r.platform.slice(1)}</figcaption>
+              {r.reply && <div style={{ marginTop: 8, borderLeft: `3px solid ${c.line}`, paddingLeft: 8, fontSize: 13, color: c.muted }}><strong>Reply from the owner:</strong> {r.reply}</div>}
+            </figure>
+          ))}
+        </div>
+      )}
+      {d.min_rating > 1 && d.layout !== "badge" && <div style={{ marginTop: 10, fontSize: 11.5, color: c.muted }}>Showing recent {d.min_rating}★ and higher reviews. The rating above includes all {d.count} reviews.{d.review_url ? " " : ""}{d.review_url && <a href={d.review_url.replace("/writereview", "/reviews")} target="_blank" rel="noopener noreferrer" style={{ color: c.muted }}>See all reviews</a>}</div>}
+    </div>
+  );
+}
