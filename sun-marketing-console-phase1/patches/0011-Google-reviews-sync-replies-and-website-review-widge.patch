--- /dev/null
+++ b/src/app/api/reputation/google/start/route.ts
@@ -0,0 +1,19 @@
+import { randomBytes } from "node:crypto";
+import { NextResponse } from "next/server";
+import { ApiError, tenantRoute } from "@/lib/tenant/api";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { authUrl, googleConfigured, STATE_COOKIE } from "@/lib/reputation/google";
+
+export const dynamic = "force-dynamic";
+
+// Sends an admin to Google's consent screen; the state ties the answer to
+// this browser and organization.
+export const GET = tenantRoute("org.manage", async (ctx, req) => {
+  if (!googleConfigured()) throw new ApiError("Integration not configured: set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.", 503, "integration_not_configured");
+  const base = publicBaseUrl(req);
+  if (!base) throw new ApiError("Integration not configured: set PUBLIC_APP_URL.", 503, "integration_not_configured");
+  const state = randomBytes(24).toString("hex");
+  const res = NextResponse.redirect(authUrl(state, base));
+  res.cookies.set(STATE_COOKIE, `${state}.${ctx.org.id}`, { httpOnly: true, secure: process.env.NODE_ENV === "production", sameSite: "lax", path: "/api/reputation/google", maxAge: 600 });
+  return res;
+});
diff --git a/src/app/api/reputation/reviews/[id]/reply/route.ts b/src/app/api/reputation/reviews/[id]/reply/route.ts
new file mode 100644
index 0000000..0cc93e7
--- /dev/null
+++ b/src/app/api/reputation/reviews/[id]/reply/route.ts
@@ -0,0 +1,23 @@
+import { z } from "zod";
+import { ApiError, fromDb, readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { systemClient } from "@/lib/supabase/system";
+import { postGoogleReply } from "@/lib/reputation/google";
+import { updateReview } from "@/lib/reputation/service";
+
+export const dynamic = "force-dynamic";
+
+// Posts the reply publicly on Google, then records it as posted.
+export const POST = tenantRoute<{ id: string }>("crm.write", async (ctx, req, { id }) => {
+  const { text } = await readJson(req, z.object({ text: z.string().trim().min(2, "Write a reply.").max(4000) }));
+  const rid = uuid.parse(id);
+  const { data: review, error } = await ctx.client.from("reviews").select("id, platform, external_id, response_ai_drafted, response_body").eq("organization_id", ctx.org.id).eq("id", rid).maybeSingle();
+  fromDb(error);
+  if (!review) throw new ApiError("Review not found.", 404, "not_found");
+  const system = systemClient();
+  if (!system) throw new ApiError("Integration not configured: SUPABASE_SERVICE_ROLE_KEY is needed for Google.", 503, "integration_not_configured");
+  await postGoogleReply(system, ctx.org.id, review, text);
+  const updated = await updateReview(scoped(ctx), rid, { response_body: text, response_status: "posted" }, { aiDrafted: review.response_ai_drafted && review.response_body === text });
+  await audit(ctx.client, ctx.org.id, "reputation.reply_posted", { type: "review", id: rid }, { platform: "google" });
+  return { review: updated };
+});
