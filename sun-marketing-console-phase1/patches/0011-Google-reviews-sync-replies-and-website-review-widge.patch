+import { fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { WIDGET_COLUMNS, widgetInput } from "@/lib/reputation/widgets";
+
+export const dynamic = "force-dynamic";
+
+export const GET = tenantRoute("crm.read", async (ctx) => {
+  const { data, error } = await ctx.client.from("review_widgets").select(WIDGET_COLUMNS).eq("organization_id", ctx.org.id).order("created_at");
+  fromDb(error);
+  return { widgets: data || [] };
+});
+
+export const POST = tenantRoute("sites.manage", async (ctx, req) => {
+  const input = await readJson(req, widgetInput);
+  const { data, error } = await ctx.client.from("review_widgets").insert({ organization_id: ctx.org.id, ...input }).select(WIDGET_COLUMNS).single();
+  fromDb(error);
+  return { widget: data };
+});
