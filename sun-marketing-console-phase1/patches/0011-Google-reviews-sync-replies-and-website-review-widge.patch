+import { ApiError, fromDb, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { WIDGET_COLUMNS, widgetInput } from "@/lib/reputation/widgets";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const PATCH = tenantRoute<P>("sites.manage", async (ctx, req, { id }) => {
+  const input = await readJson(req, widgetInput.partial());
+  const { data, error } = await ctx.client.from("review_widgets").update(input).eq("organization_id", ctx.org.id).eq("id", uuid.parse(id)).select(WIDGET_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Widget not found.", 404, "not_found");
+  return { widget: data };
+});
+
+export const DELETE = tenantRoute<P>("sites.manage", async (ctx, _req, { id }) => {
+  const { error } = await ctx.client.from("review_widgets").delete().eq("organization_id", ctx.org.id).eq("id", uuid.parse(id));
+  fromDb(error);
+  return { ok: true };
+});
