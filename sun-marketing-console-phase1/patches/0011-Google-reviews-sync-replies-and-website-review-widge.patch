diff --git a/src/lib/reputation/google.ts b/src/lib/reputation/google.ts
new file mode 100644
index 0000000..2c35a03
--- /dev/null
+++ b/src/lib/reputation/google.ts
@@ -0,0 +1,211 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { openJson, sealJson } from "@/lib/crypto/vault";
+import { systemAudit } from "@/lib/tenant/system-audit";
+
+// Google Business Profile: connect with OAuth, pick a location, sync reviews
+// and post replies. Needs GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET and Google's
+// approval for the Business Profile APIs on that Cloud project.
+type Fetch = typeof fetch;
+export const STATE_COOKIE = "sm_goauth";
+export const SCOPE = "https://www.googleapis.com/auth/business.manage openid email";
+const TOKEN_URL = "https://oauth2.googleapis.com/token";
+const ACCOUNTS = "https://mybusinessaccountmanagement.googleapis.com/v1/accounts";
+const INFO = "https://mybusinessbusinessinformation.googleapis.com/v1";
+const V4 = "https://mybusiness.googleapis.com/v4";
+const STARS = { ONE: 1, TWO: 2, THREE: 3, FOUR: 4, FIVE: 5 } as const;
+
+export function googleConfigured() {
+  return !!(process.env.GOOGLE_CLIENT_ID?.trim() && process.env.GOOGLE_CLIENT_SECRET?.trim());
+}
+export const redirectUri = (base: string) => `${base}/api/reputation/google/callback`;
+
+export function authUrl(state: string, base: string) {
+  const p = new URLSearchParams({
+    client_id: process.env.GOOGLE_CLIENT_ID!.trim(), redirect_uri: redirectUri(base), response_type: "code", scope: SCOPE,
+    access_type: "offline", prompt: "consent", include_granted_scopes: "true", state,
+  });
+  return `https://accounts.google.com/o/oauth2/v2/auth?${p}`;
+}
+
+class GoogleError extends Error {
+  constructor(message: string, public status: number, public reauth = false) { super(message); }
+}
+
+async function call<T>(f: Fetch, url: string, init: RequestInit = {}): Promise<T> {
+  const r = await f(url, { ...init, signal: AbortSignal.timeout(20000) }).catch(() => null);
+  if (!r) throw new GoogleError("Google did not respond.", 502);
+  const j = (await r.json().catch(() => ({}))) as { error?: string | { message?: string; status?: string }; error_description?: string };
+  if (!r.ok) {
+    const msg = typeof j.error === "object" ? j.error?.message : j.error_description || j.error;
+    if (r.status === 400 && j.error === "invalid_grant") throw new GoogleError("Google access was revoked or expired. Reconnect Google.", 401, true);
+    if (r.status === 401) throw new GoogleError("Google access was revoked or expired. Reconnect Google.", 401, true);
+    if (r.status === 403) throw new GoogleError(`Google refused access${msg ? `: ${msg}` : ""}. The Business Profile API must be enabled and approved for this app, and the connected Google account must manage the profile.`, 403);
+    throw new GoogleError(msg ? `Google error: ${msg}` : `Google error ${r.status}.`, r.status);
+  }
+  return j as T;
+}
+
+export async function exchangeCode(code: string, base: string, f: Fetch = fetch) {
+  const body = new URLSearchParams({ code, client_id: process.env.GOOGLE_CLIENT_ID!.trim(), client_secret: process.env.GOOGLE_CLIENT_SECRET!.trim(), redirect_uri: redirectUri(base), grant_type: "authorization_code" });
+  const t = await call<{ access_token: string; refresh_token?: string; id_token?: string }>(f, TOKEN_URL, { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body });
+  if (!t.refresh_token) throw new ApiError("Google did not grant offline access. Remove this app's access in your Google account settings and connect again.", 400, "invalid");
+  let email: string | null = null;
+  try { email = JSON.parse(Buffer.from((t.id_token || "").split(".")[1] || "", "base64url").toString()).email ?? null; } catch { email = null; }
+  return { refresh_token: t.refresh_token, access_token: t.access_token, email };
+}
+
+export async function accessToken(refresh: string, f: Fetch = fetch) {
+  const body = new URLSearchParams({ refresh_token: refresh, client_id: process.env.GOOGLE_CLIENT_ID!.trim(), client_secret: process.env.GOOGLE_CLIENT_SECRET!.trim(), grant_type: "refresh_token" });
+  return (await call<{ access_token: string }>(f, TOKEN_URL, { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body })).access_token;
+}
+
+export type GLocation = { account: string; location: string; title: string; address: string; review_url: string | null };
+
+export async function listLocations(token: string, f: Fetch = fetch): Promise<GLocation[]> {
+  const auth = { Authorization: `Bearer ${token}` };
+  const { accounts = [] } = await call<{ accounts?: { name: string }[] }>(f, ACCOUNTS, { headers: auth });
+  const out: GLocation[] = [];
+  for (const a of accounts.slice(0, 20)) {
+    let pageToken = "";
+    for (let page = 0; page < 5; page++) {
+      const q = new URLSearchParams({ readMask: "name,title,storefrontAddress,metadata", pageSize: "100", ...(pageToken ? { pageToken } : {}) });
+      const r = await call<{ locations?: { name: string; title?: string; storefrontAddress?: { addressLines?: string[]; locality?: string; administrativeArea?: string }; metadata?: { newReviewUri?: string } }[]; nextPageToken?: string }>(f, `${INFO}/${a.name}/locations?${q}`, { headers: auth });
+      for (const l of r.locations || []) {
+        const ad = l.storefrontAddress;
+        out.push({ account: a.name, location: l.name, title: l.title || "Unnamed location", address: [ad?.addressLines?.join(" "), ad?.locality, ad?.administrativeArea].filter(Boolean).join(", "),
+          review_url: l.metadata?.newReviewUri?.startsWith("https://") ? l.metadata.newReviewUri : null });
+      }
+      if (!r.nextPageToken) break;
+      pageToken = r.nextPageToken;
+    }
+  }
+  return out;
+}
+
+export type GReview = { reviewId: string; reviewer?: { displayName?: string; isAnonymous?: boolean }; starRating?: keyof typeof STARS | string; comment?: string; createTime: string; updateTime?: string; reviewReply?: { comment?: string; updateTime?: string } };
+
+// Pure: a Google review as a row for our reviews table.
+export function mapReview(r: GReview) {
+  const rating = STARS[r.starRating as keyof typeof STARS];
+  if (!rating || !r.reviewId) return null;
+  const body = (r.comment || "").trim();
+  return {
+    external_id: r.reviewId.slice(0, 200), rating,
+    author_name: r.reviewer?.isAnonymous ? null : (r.reviewer?.displayName || "").slice(0, 120) || null,
+    body: body ? body.slice(0, 10000) : null, published_at: r.createTime,
+    reply: r.reviewReply?.comment?.trim() ? r.reviewReply.comment.trim().slice(0, 4000) : null,
+    updated_at: r.updateTime || r.createTime,
+  };
+}
+
+type Conn = { id: string; organization_id: string; account_name: string; location_name: string; source_id: string | null; last_synced_at: string | null; encrypted_credentials: string };
+
+async function connectionToken(conn: Conn, f: Fetch) {
+  let refresh: string;
+  try { refresh = openJson(conn.encrypted_credentials).refresh_token; } catch { throw new GoogleError("The saved Google connection cannot be read (APP_ENCRYPTION_KEY changed?). Reconnect Google.", 401, true); }
+  return accessToken(refresh, f);
+}
+
+// Pulls new and changed reviews. Stops once it reaches reviews older than the
+// last sync (with a day of overlap), at most 10 pages per run.
+export async function syncConnection(system: SupabaseClient, conn: Conn, f: Fetch = fetch, now = new Date()) {
+  const stats = { added: 0, updated: 0, pages: 0 };
+  try {
+    const token = await connectionToken(conn, f);
+    const since = conn.last_synced_at ? new Date(new Date(conn.last_synced_at).getTime() - 86400000).toISOString() : null;
+    let pageToken = "";
+    for (let page = 0; page < 10; page++) {
+      stats.pages++;
+      const q = new URLSearchParams({ pageSize: "50", orderBy: "updateTime desc", ...(pageToken ? { pageToken } : {}) });
+      const r = await call<{ reviews?: GReview[]; nextPageToken?: string }>(f, `${V4}/${conn.account_name}/${conn.location_name}/reviews?${q}`, { headers: { Authorization: `Bearer ${token}` } });
+      const mapped = (r.reviews || []).map(mapReview).filter((x): x is NonNullable<ReturnType<typeof mapReview>> => !!x);
+      if (mapped.length) {
+        const { data: existing } = await system.from("reviews").select("id, external_id, rating, body, response_body, response_status")
+          .eq("organization_id", conn.organization_id).eq("platform", "google").in("external_id", mapped.map((m) => m.external_id));
+        const byId = new Map((existing || []).map((e) => [e.external_id as string, e]));
+        for (const m of mapped) {
+          const e = byId.get(m.external_id);
+          if (!e) {
+            const { error } = await system.from("reviews").insert({
+              organization_id: conn.organization_id, platform: "google", external_id: m.external_id, source_id: conn.source_id, rating: m.rating,
+              author_name: m.author_name, body: m.body, published_at: m.published_at,
+              ...(m.reply ? { response_body: m.reply, response_status: "posted" } : {}),
+            });
+            if (error && error.code !== "23505") fromDb(error);
+            if (!error) stats.added++;
+            continue;
+          }
+          const patch: Record<string, unknown> = {};
+          if (e.rating !== m.rating) patch.rating = m.rating;
+          if ((e.body ?? null) !== m.body) patch.body = m.body;
+          if (m.reply && (e.response_status !== "posted" || e.response_body !== m.reply)) { patch.response_body = m.reply; patch.response_status = "posted"; }
+          if (Object.keys(patch).length) {
+            const { error } = await system.from("reviews").update(patch).eq("organization_id", conn.organization_id).eq("id", e.id);
+            fromDb(error);
+            stats.updated++;
+          }
+        }
+      }
+      const oldest = mapped[mapped.length - 1]?.updated_at;
+      if (!r.nextPageToken || (since && oldest && oldest < since)) break;
+      pageToken = r.nextPageToken;
+    }
+    await system.from("review_connections").update({ last_synced_at: now.toISOString(), last_error: null, status: "active" }).eq("id", conn.id);
+    if (stats.added) await systemAudit(system, conn.organization_id, "reputation.google_synced", null, stats);
+    return { ok: true as const, ...stats };
+  } catch (e) {
+    const message = e instanceof Error ? e.message.slice(0, 480) : "Sync failed.";
+    const reauth = e instanceof GoogleError && e.reauth;
+    await system.from("review_connections").update({ last_error: message, ...(reauth ? { status: "error" } : {}), last_synced_at: now.toISOString() }).eq("id", conn.id);
+    return { ok: false as const, error: message, ...stats };
+  }
+}
+
+const CONN_COLUMNS = "id, organization_id, account_name, location_name, source_id, last_synced_at, encrypted_credentials";
+
+export async function activeConnection(system: SupabaseClient, orgId: string) {
+  const { data } = await system.from("review_connections").select(CONN_COLUMNS).eq("organization_id", orgId).eq("provider", "google").eq("status", "active").maybeSingle();
+  return data as Conn | null;
+}
+
+// Scheduler: sync each active connection about once an hour.
+export async function syncDue(system: SupabaseClient, now = new Date(), f: Fetch = fetch, limit = 20) {
+  if (!googleConfigured()) return { synced: 0 };
+  const before = new Date(now.getTime() - 55 * 60000).toISOString();
+  const { data } = await system.from("review_connections").select(CONN_COLUMNS).eq("provider", "google").eq("status", "active")
+    .or(`last_synced_at.is.null,last_synced_at.lt.${before}`).limit(limit);
+  let synced = 0;
+  for (const c of (data || []) as Conn[]) { await syncConnection(system, c, f, now); synced++; }
+  return { synced };
+}
+
+export const sealToken = (refresh: string) => sealJson({ refresh_token: refresh });
+
+export async function locationsFor(system: SupabaseClient, orgId: string, f: Fetch = fetch) {
+  const { data } = await system.from("review_connections").select(CONN_COLUMNS).eq("organization_id", orgId).eq("provider", "google").neq("status", "disabled").maybeSingle();
+  if (!data) throw new ApiError("Connect Google first.", 404, "not_found");
+  try { return await listLocations(await connectionToken(data as Conn, f), f); }
+  catch (e) { if (e instanceof GoogleError) throw new ApiError(e.message, e.status === 401 ? 409 : 502, "integration_error"); throw e; }
+}
+
+// Posts (or replaces) the public reply on Google, then records it.
+export async function postGoogleReply(system: SupabaseClient, orgId: string, review: { external_id: string | null; platform: string }, text: string, f: Fetch = fetch) {
+  if (review.platform !== "google" || !review.external_id) throw new ApiError("Only Google reviews can be answered from here.", 422, "invalid");
+  const conn = await activeConnection(system, orgId);
+  if (!conn) throw new ApiError("Integration not configured: connect Google in Reputation → Review sites.", 409, "integration_not_configured");
+  try {
+    const token = await connectionToken(conn, f);
+    await call(f, `${V4}/${conn.account_name}/${conn.location_name}/reviews/${encodeURIComponent(review.external_id)}/reply`, {
+      method: "PUT", headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" }, body: JSON.stringify({ comment: text }),
+    });
+  } catch (e) {
+    if (e instanceof GoogleError) throw new ApiError(e.message, e.status === 401 ? 409 : 502, "integration_error");
+    throw e;
+  }
+}
+
+export async function revokeToken(encrypted: string, f: Fetch = fetch) {
+  try { await f(`https://oauth2.googleapis.com/revoke?token=${encodeURIComponent(openJson(encrypted).refresh_token)}`, { method: "POST", signal: AbortSignal.timeout(10000) }); } catch { /* best effort */ }
+}
