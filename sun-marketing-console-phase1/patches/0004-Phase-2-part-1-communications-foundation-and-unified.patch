diff --git a/supabase/migrations/20261007120000_phase2_communications.sql b/supabase/migrations/20261007120000_phase2_communications.sql
new file mode 100644
index 0000000..8332cd9
--- /dev/null
+++ b/supabase/migrations/20261007120000_phase2_communications.sql
@@ -0,0 +1,299 @@
+-- Phase 2: communications foundation.
+-- Per-organization provider accounts (SMS/email), conversations and messages
+-- (the unified inbox), an opt-out suppression list, and webhook idempotency.
+--
+-- Security model (same as Phase 1, plus):
+--   * provider credentials are encrypted by the application with
+--     APP_ENCRYPTION_KEY; the ciphertext column is not readable through the
+--     Data API and is handed out only by provider_secret() to members who may
+--     send for that organization.
+--   * inbound webhooks and scheduled dispatch run with the service role and
+--     must scope every write by organization_id.
+--   * a message's history cannot be rewritten through the API: allowed status
+--     transitions are enforced by a trigger.
+begin;
+
+-- ------------------------------------------------------- provider accounts
+create table public.provider_accounts (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  channel text not null check (channel in ('sms', 'email')),
+  provider text not null check (provider in ('telnyx', 'twilio', 'resend')),
+  label text not null check (length(btrim(label)) between 1 and 80),
+  -- The sending address: an E.164 phone number for SMS, an email address for email.
+  address text not null check (
+    (channel = 'sms' and address ~ '^\+[1-9][0-9]{6,14}$') or
+    (channel = 'email' and address ~ '^[^@\s]+@[^@\s]+\.[^@\s]+$')),
+  encrypted_credentials text not null check (length(encrypted_credentials) between 20 and 8000),
+  credential_hint text check (length(credential_hint) <= 12),
+  -- Non-secret settings: messaging profile id, webhook public key, sender name, mailing address.
+  config jsonb not null default '{}'::jsonb check (jsonb_typeof(config) = 'object'),
+  is_default boolean not null default false,
+  status text not null default 'active' check (status in ('active', 'disabled')),
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id)
+);
+-- One number/address belongs to exactly one organization (inbound routing depends on it).
+create unique index provider_accounts_address on public.provider_accounts(channel, lower(address)) where status = 'active';
+create unique index provider_accounts_one_default on public.provider_accounts(organization_id, channel) where is_default and status = 'active';
+create trigger provider_accounts_updated before update on public.provider_accounts
+  for each row execute function public.tg_set_updated_at();
+
+-- Ciphertext for sending. Useless without APP_ENCRYPTION_KEY, which only the
+-- server holds; still only released to people allowed to send for the org.
+create or replace function public.provider_secret(p_account uuid) returns text
+language plpgsql stable security definer set search_path = '' as $$
+declare v public.provider_accounts;
+begin
+  select * into v from public.provider_accounts where id = p_account and status = 'active';
+  if not found or public.org_rank(v.organization_id) < 2 then
+    raise exception 'Provider account not available.' using errcode = '42501';
+  end if;
+  return v.encrypted_credentials;
+end $$;
+
+-- ------------------------------------------------------------ conversations
+create table public.conversations (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  contact_id uuid not null,
+  channel text not null check (channel in ('sms', 'email')),
+  status text not null default 'open' check (status in ('open', 'closed')),
+  assignee_id uuid,
+  last_message_at timestamptz,
+  last_message_preview text check (length(last_message_preview) <= 200),
+  last_direction text check (last_direction in ('inbound', 'outbound')),
+  unread_count integer not null default 0 check (unread_count >= 0),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  unique (organization_id, contact_id, channel),
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete cascade
+);
+create index conversations_inbox_idx on public.conversations(organization_id, status, last_message_at desc nulls last);
+create trigger conversations_updated before update on public.conversations
+  for each row execute function public.tg_set_updated_at();
+
+-- ----------------------------------------------------------------- messages
+create table public.messages (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  conversation_id uuid not null,
+  contact_id uuid not null,
+  channel text not null check (channel in ('sms', 'email')),
+  direction text not null check (direction in ('inbound', 'outbound')),
+  purpose text not null default 'conversational' check (purpose in ('conversational', 'marketing', 'transactional')),
+  subject text check (length(subject) <= 300),
+  body text not null check (length(body) between 1 and 20000),
+  status text not null check (status in ('scheduled', 'queued', 'sending', 'sent', 'delivered', 'failed', 'received', 'blocked', 'cancelled')),
+  block_reason text check (length(block_reason) <= 300),
+  error text check (length(error) <= 1000),
+  provider text,
+  provider_account_id uuid,
+  provider_message_id text,
+  from_address text,
+  to_address text,
+  ai_generated boolean not null default false,
+  sent_by uuid,
+  idempotency_key text check (length(idempotency_key) <= 100),
+  scheduled_for timestamptz,
+  sent_at timestamptz,
+  delivered_at timestamptz,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (provider, provider_message_id),
+  unique (organization_id, idempotency_key),
+  foreign key (conversation_id, organization_id) references public.conversations(id, organization_id) on delete cascade,
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete cascade,
+  foreign key (provider_account_id, organization_id) references public.provider_accounts(id, organization_id) on delete set null (provider_account_id),
+  check (status <> 'scheduled' or scheduled_for is not null),
+  check ((direction = 'inbound') = (status = 'received'))
+);
+create index messages_conversation_idx on public.messages(conversation_id, created_at);
+create index messages_due_idx on public.messages(status, scheduled_for) where status = 'scheduled';
+create trigger messages_updated before update on public.messages
+  for each row execute function public.tg_set_updated_at();
+
+-- Through the Data API, people can only create outbound messages and walk
+-- them forward; delivery receipts and inbound messages come from verified
+-- webhooks (service role). Content is frozen once a message leaves 'scheduled'.
+create or replace function public.tg_messages_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    if new.direction <> 'outbound' or new.status not in ('queued', 'scheduled', 'blocked') then
+      raise exception 'Messages are created as queued, scheduled or blocked.' using errcode = '42501';
+    end if;
+    if new.sent_by is distinct from auth.uid() then
+      raise exception 'Messages are sent on behalf of the signed-in user only.' using errcode = '42501';
+    end if;
+    new.provider_message_id := null; new.sent_at := null; new.delivered_at := null;
+    return new;
+  end if;
+  if new.organization_id <> old.organization_id or new.contact_id <> old.contact_id or new.conversation_id <> old.conversation_id
+     or new.channel <> old.channel or new.direction <> old.direction or new.sent_by is distinct from old.sent_by then
+    raise exception 'Message identity is immutable.' using errcode = '42501';
+  end if;
+  if old.status <> 'scheduled' and (new.body <> old.body or new.subject is distinct from old.subject) then
+    raise exception 'A message cannot be edited after it is sent.' using errcode = '42501';
+  end if;
+  if new.status = old.status then return new; end if;
+  if not ((old.status = 'queued' and new.status = 'sending')
+       or (old.status = 'sending' and new.status in ('sent', 'failed'))
+       or (old.status = 'scheduled' and new.status in ('cancelled', 'queued'))) then
+    raise exception 'Invalid message transition % -> %.', old.status, new.status using errcode = '42501';
+  end if;
+  if new.status = 'sent' then new.sent_at := now(); end if;
+  return new;
+end $$;
+create trigger messages_guard before insert or update on public.messages
+  for each row execute function public.tg_messages_guard();
+
+-- Every message lands on the contact's timeline and refreshes the inbox row.
+create or replace function public.tg_messages_timeline() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare v_subject text;
+begin
+  v_subject := case
+    when new.direction = 'inbound' then case new.channel when 'sms' then 'Text message received' else coalesce(new.subject, 'Email received') end
+    when new.status = 'blocked' then 'Message not sent: ' || coalesce(new.block_reason, 'blocked by compliance rules')
+    when new.status = 'scheduled' then 'Message scheduled for ' || to_char(new.scheduled_for at time zone 'UTC', 'YYYY-MM-DD HH24:MI') || ' UTC'
+    else case new.channel when 'sms' then 'Text message' else coalesce(new.subject, 'Email') end
+  end;
+  insert into public.activities(organization_id, contact_id, kind, direction, subject, body, metadata, actor_type, actor_id, occurred_at)
+  values (new.organization_id, new.contact_id, new.channel, new.direction, left(v_subject, 300), left(new.body, 20000),
+          jsonb_build_object('message_id', new.id, 'status', new.status, 'purpose', new.purpose),
+          case when new.direction = 'inbound' then 'contact' when new.ai_generated then 'ai' when new.sent_by is null then 'system' else 'user' end,
+          new.sent_by, new.created_at);
+  if new.status not in ('blocked', 'scheduled', 'cancelled') then
+    update public.conversations
+       set last_message_at = new.created_at,
+           last_message_preview = left(regexp_replace(new.body, '\s+', ' ', 'g'), 200),
+           last_direction = new.direction,
+           unread_count = case when new.direction = 'inbound' then unread_count + 1 else unread_count end,
+           status = case when new.direction = 'inbound' then 'open' else status end
+     where id = new.conversation_id and organization_id = new.organization_id;
+  end if;
+  return new;
+end $$;
+create trigger messages_timeline after insert on public.messages
+  for each row execute function public.tg_messages_timeline();
+
+-- -------------------------------------------------------------- suppressions
+create table public.suppressions (
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  channel text not null check (channel in ('sms', 'email', 'voice')),
+  address text not null check (length(address) between 3 and 254),
+  reason text not null check (reason in ('opt_out', 'bounce', 'complaint', 'manual')),
+  source text not null check (length(source) between 1 and 200),
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  primary key (organization_id, channel, address)
+);
+
+-- Records an opt-out: suppression + revoked consent + timeline entry, atomically.
+-- Members can record one; verified inbound STOP messages call it as the service role.
+create or replace function public.apply_opt_out(
+  p_org uuid, p_contact uuid, p_channel text, p_address text, p_source text, p_reason text default 'opt_out'
+) returns void
+language plpgsql security definer set search_path = '' as $$
+declare v_system boolean := current_setting('role', true) = 'service_role';
+begin
+  if not v_system and public.org_rank(p_org) < 2 then
+    raise exception 'Not allowed.' using errcode = '42501';
+  end if;
+  if p_contact is not null and not exists (select 1 from public.contacts where id = p_contact and organization_id = p_org) then
+    raise exception 'Contact not found.' using errcode = 'P0002';
+  end if;
+  insert into public.suppressions(organization_id, channel, address, reason, source, created_by)
+  values (p_org, p_channel, lower(btrim(p_address)), coalesce(p_reason, 'opt_out'), left(p_source, 200), auth.uid())
+  on conflict (organization_id, channel, address) do nothing;
+  if p_contact is not null then
+    insert into public.consents(organization_id, contact_id, channel, status, source, captured_by)
+    values (p_org, p_contact, p_channel, 'revoked', left(p_source, 200), auth.uid());
+    insert into public.activities(organization_id, contact_id, kind, direction, subject, actor_type, actor_id)
+    values (p_org, p_contact, 'system', 'internal', left(upper(p_channel) || ' opt-out recorded (' || p_source || ')', 300),
+            case when v_system then 'contact' else 'user' end, auth.uid());
+  end if;
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, target_type, target_id, metadata)
+  values (p_org, case when v_system then 'system' else 'user' end, auth.uid(), 'consent.opt_out', 'contact', p_contact::text,
+          jsonb_build_object('channel', p_channel, 'reason', p_reason));
+end $$;
+
+-- Re-subscribing needs the person's own action (a START text, via the
+-- service role) or an admin with a documented source.
+create or replace function public.clear_opt_out(p_org uuid, p_contact uuid, p_channel text, p_address text, p_source text) returns void
+language plpgsql security definer set search_path = '' as $$
+declare v_system boolean := current_setting('role', true) = 'service_role';
+begin
+  if not v_system and public.org_rank(p_org) < 4 then
+    raise exception 'Only admins can lift an opt-out.' using errcode = '42501';
+  end if;
+  delete from public.suppressions where organization_id = p_org and channel = p_channel and address = lower(btrim(p_address));
+  if p_contact is not null then
+    insert into public.consents(organization_id, contact_id, channel, status, source, captured_by)
+    values (p_org, p_contact, p_channel, 'granted', left(p_source, 200), auth.uid());
+    insert into public.activities(organization_id, contact_id, kind, direction, subject, actor_type, actor_id)
+    values (p_org, p_contact, 'system', 'internal', left(upper(p_channel) || ' opt-in recorded (' || p_source || ')', 300),
+            case when v_system then 'contact' else 'user' end, auth.uid());
+  end if;
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, target_type, target_id, metadata)
+  values (p_org, case when v_system then 'system' else 'user' end, auth.uid(), 'consent.opt_in', 'contact', p_contact::text,
+          jsonb_build_object('channel', p_channel, 'source', p_source));
+end $$;
+
+-- ------------------------------------------------------------ webhook events
+create table public.webhook_events (
+  id bigint generated always as identity primary key,
+  provider text not null,
+  event_id text not null check (length(event_id) between 1 and 200),
+  organization_id uuid references public.organizations(id) on delete cascade,
+  received_at timestamptz not null default now(),
+  processed_at timestamptz,
+  error text,
+  unique (provider, event_id)
+);
+
+-- --------------------------------------------------------------------- RLS
+alter table public.provider_accounts enable row level security;
+alter table public.conversations enable row level security;
+alter table public.messages enable row level security;
+alter table public.suppressions enable row level security;
+alter table public.webhook_events enable row level security; -- no policies: service role only
+
+create policy provider_accounts_read on public.provider_accounts for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy provider_accounts_write on public.provider_accounts for all to authenticated
+  using (public.org_rank(organization_id) >= 4) with check (public.org_rank(organization_id) >= 4);
+
+create policy conversations_read on public.conversations for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy conversations_insert on public.conversations for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy conversations_update on public.conversations for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+
+create policy messages_read on public.messages for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy messages_insert on public.messages for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy messages_update on public.messages for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+
+create policy suppressions_read on public.suppressions for select to authenticated using (public.org_rank(organization_id) >= 1);
+-- Inserts and removals go through apply_opt_out / clear_opt_out.
+
+revoke all on public.provider_accounts, public.conversations, public.messages, public.suppressions, public.webhook_events from anon, authenticated;
+grant all on public.provider_accounts, public.conversations, public.messages, public.suppressions, public.webhook_events to service_role;
+-- Credentials are writable by admins but never readable through the API.
+grant select (id, organization_id, channel, provider, label, address, credential_hint, config, is_default, status, created_by, created_at, updated_at)
+  on public.provider_accounts to authenticated;
+grant insert, update, delete on public.provider_accounts to authenticated;
+grant select, insert, update on public.conversations to authenticated;
+grant select, insert, update on public.messages to authenticated;
+grant select on public.suppressions to authenticated;
+
+revoke execute on function public.provider_secret(uuid), public.apply_opt_out(uuid, uuid, text, text, text, text),
+  public.clear_opt_out(uuid, uuid, text, text, text) from public, anon;
+grant execute on function public.provider_secret(uuid), public.apply_opt_out(uuid, uuid, text, text, text, text),
+  public.clear_opt_out(uuid, uuid, text, text, text) to authenticated, service_role;
+
+commit;
diff --git a/supabase/tests/phase2_comms.test.sql b/supabase/tests/phase2_comms.test.sql
new file mode 100644
index 0000000..b85c4ce
--- /dev/null
+++ b/supabase/tests/phase2_comms.test.sql
@@ -0,0 +1,147 @@
+-- Phase 2 communications security tests. Run with scripts/test-db.sh.
+\set ON_ERROR_STOP 1
+set client_min_messages = notice;
+
+create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, false);
+  execute 'set role authenticated';
+end $$;
+create or replace function pg_temp.as_service() returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', '{"role":"service_role"}', false);
+  execute 'set role service_role';
+end $$;
+create or replace function pg_temp.reset_user() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', false);
+end $$;
+create or replace function pg_temp.expect_error(p_sql text, p_label text) returns void language plpgsql as $$
+begin
+  begin execute p_sql; exception when others then raise notice 'ok   (denied) %', p_label; return; end;
+  raise exception 'FAIL expected an error: %', p_label;
+end $$;
+create or replace function pg_temp.expect(p_ok boolean, p_label text) returns void language plpgsql as $$
+begin
+  if not coalesce(p_ok, false) then raise exception 'FAIL %', p_label; end if;
+  raise notice 'ok   %', p_label;
+end $$;
+
+-- Users: 1 = owner of agency X (staff), 2 = member of X, 3 = viewer of X, 4 = owner of agency Y (staff)
+insert into auth.users values
+  ('20000000-0000-0000-0000-000000000001', 'owner@x.test'), ('20000000-0000-0000-0000-000000000002', 'member@x.test'),
+  ('20000000-0000-0000-0000-000000000003', 'viewer@x.test'), ('20000000-0000-0000-0000-000000000004', 'owner@y.test');
+insert into public.team_members(user_id, email, active) values
+  ('20000000-0000-0000-0000-000000000001', 'owner@x.test', true), ('20000000-0000-0000-0000-000000000004', 'owner@y.test', true);
+create temp table ids (k text primary key, v uuid);
+grant all on ids to authenticated, service_role;
+
+select pg_temp.as_user('20000000-0000-0000-0000-000000000001');
+insert into ids select 'x', public.create_organization('Agency X', 'agency');
+select public.add_member_by_email((select v from ids where k = 'x'), 'member@x.test', 'member');
+select public.add_member_by_email((select v from ids where k = 'x'), 'viewer@x.test', 'viewer');
+with c as (insert into public.contacts(organization_id, first_name, phone, email)
+  values ((select v from ids where k = 'x'), 'Pat', '+18565550100', 'pat@x.test') returning id)
+insert into ids select 'pat', id from c;
+-- 1. Provider accounts: admins create; credentials never readable through the API.
+with a as (insert into public.provider_accounts(organization_id, channel, provider, label, address, encrypted_credentials, credential_hint, is_default)
+  values ((select v from ids where k = 'x'), 'sms', 'telnyx', 'Main line', '+18565550199', 'v2.k1.ciphertext-ciphertext', '…1234', true) returning id)
+insert into ids select 'acct', id from a;
+select pg_temp.reset_user();
+
+select pg_temp.as_user('20000000-0000-0000-0000-000000000004');
+insert into ids select 'y', public.create_organization('Agency Y', 'agency');
+select pg_temp.expect_error($$insert into public.provider_accounts(organization_id, channel, provider, label, address, encrypted_credentials)
+  values ((select v from ids where k = 'y'), 'sms', 'twilio', 'Hijack', '+18565550199', 'v2.k1.ciphertext-ciphertext')$$,
+  'a phone number can belong to only one organization');
+select pg_temp.expect_error($$select public.provider_secret((select v from ids where k = 'acct'))$$, 'other tenants cannot obtain credentials');
+select pg_temp.expect((select count(*) = 0 from public.provider_accounts), 'other tenants cannot see provider accounts');
+select pg_temp.reset_user();
+
+select pg_temp.as_user('20000000-0000-0000-0000-000000000002');
+select pg_temp.expect((select label = 'Main line' from public.provider_accounts), 'members see account settings');
+select pg_temp.expect_error($$select encrypted_credentials from public.provider_accounts$$, 'members cannot read the credential column');
+select pg_temp.expect((select public.provider_secret((select v from ids where k = 'acct')) like 'v2.%'), 'members may obtain ciphertext to send');
+select pg_temp.expect_error($$insert into public.provider_accounts(organization_id, channel, provider, label, address, encrypted_credentials)
+  values ((select v from ids where k = 'x'), 'email', 'resend', 'x', 'hi@x.test', 'v2.k1.ciphertext-ciphertext')$$, 'members cannot add provider accounts');
+select pg_temp.reset_user();
+
+select pg_temp.as_user('20000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$select public.provider_secret((select v from ids where k = 'acct'))$$, 'viewers cannot obtain credentials');
+select pg_temp.reset_user();
+
+-- 2. Messages: members create outbound messages and walk them forward only.
+select pg_temp.as_user('20000000-0000-0000-0000-000000000002');
+with c as (insert into public.conversations(organization_id, contact_id, channel)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'pat'), 'sms') returning id)
+insert into ids select 'conv', id from c;
+with m as (insert into public.messages(organization_id, conversation_id, contact_id, channel, direction, body, status, sent_by, to_address)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'conv'), (select v from ids where k = 'pat'), 'sms', 'outbound',
+          'Hi Pat, your estimate is ready.', 'queued', '20000000-0000-0000-0000-000000000002', '+18565550100') returning id)
+insert into ids select 'msg', id from m;
+select pg_temp.expect_error($$insert into public.messages(organization_id, conversation_id, contact_id, channel, direction, body, status, sent_by)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'conv'), (select v from ids where k = 'pat'), 'sms', 'outbound', 'fake', 'delivered', '20000000-0000-0000-0000-000000000002')$$,
+  'cannot insert a message as already delivered');
+select pg_temp.expect_error($$insert into public.messages(organization_id, conversation_id, contact_id, channel, direction, body, status)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'conv'), (select v from ids where k = 'pat'), 'sms', 'inbound', 'forged', 'received')$$,
+  'cannot forge inbound messages');
+select pg_temp.expect_error($$insert into public.messages(organization_id, conversation_id, contact_id, channel, direction, body, status, sent_by)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'conv'), (select v from ids where k = 'pat'), 'sms', 'outbound', 'x', 'queued', '20000000-0000-0000-0000-000000000001')$$,
+  'cannot send in someone else''s name');
+select pg_temp.expect_error($$update public.messages set status = 'sent' where id = (select v from ids where k = 'msg')$$, 'cannot skip from queued to sent');
+update public.messages set status = 'sending' where id = (select v from ids where k = 'msg');
+update public.messages set status = 'sent', provider = 'telnyx', provider_message_id = 'tx-1' where id = (select v from ids where k = 'msg');
+select pg_temp.expect((select status = 'sent' and sent_at is not null from public.messages where id = (select v from ids where k = 'msg')), 'queued -> sending -> sent');
+select pg_temp.expect_error($$update public.messages set body = 'rewritten' where id = (select v from ids where k = 'msg')$$, 'sent messages cannot be edited');
+select pg_temp.expect_error($$update public.messages set status = 'delivered' where id = (select v from ids where k = 'msg')$$, 'members cannot fake delivery receipts');
+select pg_temp.expect((select count(*) = 1 from public.activities where contact_id = (select v from ids where k = 'pat') and kind = 'sms' and direction = 'outbound'),
+  'outbound message is on the contact timeline');
+select pg_temp.expect((select last_direction = 'outbound' and unread_count = 0 from public.conversations where id = (select v from ids where k = 'conv')), 'inbox row updated');
+select pg_temp.reset_user();
+
+select pg_temp.as_user('20000000-0000-0000-0000-000000000004');
+select pg_temp.expect((select count(*) = 0 from public.messages), 'other tenants cannot read messages');
+select pg_temp.expect_error($$insert into public.conversations(organization_id, contact_id, channel)
+  values ((select v from ids where k = 'y'), (select v from ids where k = 'pat'), 'email')$$, 'cannot open a conversation with another tenant''s contact');
+select pg_temp.reset_user();
+
+-- 3. Webhook path (service role): inbound and delivery receipts.
+select pg_temp.as_service();
+insert into public.messages(organization_id, conversation_id, contact_id, channel, direction, body, status, provider, provider_message_id, from_address)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'conv'), (select v from ids where k = 'pat'), 'sms', 'inbound', 'Sounds good, thanks!', 'received', 'telnyx', 'tx-in-1', '+18565550100');
+update public.messages set status = 'delivered', delivered_at = now() where provider = 'telnyx' and provider_message_id = 'tx-1';
+select pg_temp.expect_error($$insert into public.messages(organization_id, conversation_id, contact_id, channel, direction, body, status, provider, provider_message_id)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'conv'), (select v from ids where k = 'pat'), 'sms', 'inbound', 'dup', 'received', 'telnyx', 'tx-in-1')$$,
+  'provider message ids are unique (webhook replays cannot duplicate)');
+insert into public.webhook_events(provider, event_id) values ('telnyx', 'evt-1');
+select pg_temp.expect_error($$insert into public.webhook_events(provider, event_id) values ('telnyx', 'evt-1')$$, 'webhook events are idempotent');
+select pg_temp.reset_user();
+select pg_temp.expect((select unread_count = 1 and last_direction = 'inbound' from public.conversations where id = (select v from ids where k = 'conv')), 'inbound message increments unread');
+
+select pg_temp.as_user('20000000-0000-0000-0000-000000000002');
+select pg_temp.expect_error($$select * from public.webhook_events$$, 'webhook log is not readable through the API');
+-- 4. Opt-outs
+select public.apply_opt_out((select v from ids where k = 'x'), (select v from ids where k = 'pat'), 'sms', '+18565550100', 'Replied STOP');
+select pg_temp.expect((select count(*) = 1 from public.suppressions where address = '+18565550100'), 'opt-out suppresses the number');
+select pg_temp.expect((select status = 'revoked' from public.consents where contact_id = (select v from ids where k = 'pat') and channel = 'sms' order by captured_at desc limit 1),
+  'opt-out revokes SMS consent');
