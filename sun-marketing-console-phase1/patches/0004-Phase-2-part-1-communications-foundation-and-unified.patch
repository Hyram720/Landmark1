@@ -0,0 +1,36 @@
+import { NextResponse } from "next/server";
+import { systemClient } from "@/lib/supabase/system";
+import { parseTelnyxEvent, verifyTelnyxSignature } from "@/lib/comms/providers/telnyx";
+import { accountForAddress, processSmsEvent } from "@/lib/comms/inbound";
+
+export const dynamic = "force-dynamic";
+
+// Inbound texts and delivery receipts from Telnyx. The payload is used only to
+// find which organization's number it concerns; nothing is written until the
+// ed25519 signature is verified with that account's public key.
+export async function POST(req: Request) {
+  const system = systemClient();
+  if (!system) return NextResponse.json({ error: "Integration not configured: SUPABASE_SERVICE_ROLE_KEY is not set." }, { status: 503 });
+  const raw = await req.text();
+  if (raw.length > 200_000) return NextResponse.json({ error: "Too large." }, { status: 413 });
+  let body: unknown;
+  try {
+    body = JSON.parse(raw);
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON." }, { status: 400 });
+  }
+  const event = parseTelnyxEvent(body as Parameters<typeof parseTelnyxEvent>[0]);
+  if (!event) return NextResponse.json({ ok: true, ignored: true });
+  const account = await accountForAddress(system, "telnyx", event.kind === "inbound" ? event.to : event.ourAddress);
+  if (!account) return NextResponse.json({ ok: true, ignored: true });
+  const publicKey = account.config?.webhookPublicKey;
+  if (!publicKey) return NextResponse.json({ error: "Webhook public key is not configured for this number." }, { status: 503 });
+  const ok = verifyTelnyxSignature(raw, req.headers.get("telnyx-timestamp") || "", req.headers.get("telnyx-signature-ed25519") || "", publicKey);
+  if (!ok) return NextResponse.json({ error: "Invalid signature." }, { status: 401 });
+  try {
+    return NextResponse.json({ ok: true, ...(await processSmsEvent(system, "telnyx", event, account)) });
+  } catch (e) {
+    console.error("[webhook:telnyx]", e);
+    return NextResponse.json({ error: "Processing failed; retry." }, { status: 500 });
+  }
+}
diff --git a/src/app/api/webhooks/twilio/sms/route.ts b/src/app/api/webhooks/twilio/sms/route.ts
new file mode 100644
index 0000000..df2c2d9
--- /dev/null
+++ b/src/app/api/webhooks/twilio/sms/route.ts
@@ -0,0 +1,42 @@
+import { NextResponse } from "next/server";
+import { publicBaseUrl, systemClient } from "@/lib/supabase/system";
+import { openJson } from "@/lib/crypto/vault";
+import { parseTwilioEvent, verifyTwilioSignature } from "@/lib/comms/providers/twilio";
+import { accountForAddress, processSmsEvent } from "@/lib/comms/inbound";
+
+export const dynamic = "force-dynamic";
+
+const twiml = (status = 200) => new NextResponse("<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response></Response>", { status, headers: { "Content-Type": "text/xml" } });
+
+// Inbound texts and status callbacks from Twilio, verified with the account's
+// auth token against the exact URL Twilio called.
+export async function POST(req: Request) {
+  const system = systemClient();
+  if (!system) return NextResponse.json({ error: "Integration not configured: SUPABASE_SERVICE_ROLE_KEY is not set." }, { status: 503 });
+  const raw = await req.text();
+  if (raw.length > 100_000) return NextResponse.json({ error: "Too large." }, { status: 413 });
+  const params = Object.fromEntries(new URLSearchParams(raw));
+  const event = parseTwilioEvent(params);
+  if (!event) return twiml();
+  const account = await accountForAddress(system, "twilio", event.kind === "inbound" ? event.to : event.ourAddress, true);
+  if (!account?.encrypted_credentials) return twiml();
+  let authToken = "";
+  try {
+    authToken = openJson(account.encrypted_credentials).authToken || "";
+  } catch {
+    return NextResponse.json({ error: "Stored Twilio credentials cannot be read; re-enter them in Channels." }, { status: 503 });
+  }
+  const url = new URL(req.url);
+  const signedUrl = `${publicBaseUrl(req) ?? url.origin}${url.pathname}${url.search}`;
+  if (!verifyTwilioSignature(signedUrl, params, req.headers.get("x-twilio-signature") || "", authToken)) {
+    return NextResponse.json({ error: "Invalid signature." }, { status: 401 });
+  }
+  const { encrypted_credentials: _secret, ...safeAccount } = account;
+  try {
+    await processSmsEvent(system, "twilio", event, safeAccount);
+    return twiml();
+  } catch (e) {
+    console.error("[webhook:twilio]", e);
+    return NextResponse.json({ error: "Processing failed; retry." }, { status: 500 });
+  }
+}
