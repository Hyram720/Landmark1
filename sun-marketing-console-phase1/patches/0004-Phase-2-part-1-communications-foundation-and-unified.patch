+        <div className="card">
+          {loading && !data ? <Loading /> : error ? <ErrorState message={error} onRetry={reload} /> : !data?.conversations.length ? (
+            <div className="empty"><h3>No conversations</h3><p className="small">Texts and emails with your contacts appear here.</p></div>
+          ) : (
+            <ul className="convo-list">
+              {data.conversations.map((c) => (
+                <li key={c.id}>
+                  <button type="button" className={`convo${target?.conversationId === c.id ? " on" : ""}`}
+                    onClick={() => setTarget({ contactId: c.contact_id, channel: c.channel, conversationId: c.id, person: c.contacts })}>
+                    <div className="spread">
+                      <strong className="small">{personName(c.contacts)}</strong>
+                      <span className="tiny muted">{relativeTime(c.last_message_at)}</span>
+                    </div>
+                    <div className="spread">
+                      <span className="tiny muted convo-preview">{c.last_direction === "outbound" ? "You: " : ""}{c.last_message_preview || "No messages yet"}</span>
+                      <span className="row" style={{ gap: 4 }}>
+                        <span className="pill pill-neutral">{channelLabel(c.channel)}</span>
+                        {c.unread_count > 0 && <span className="pill pill-sun">{c.unread_count}</span>}
+                      </span>
+                    </div>
+                  </button>
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+      </div>
+      {target ? <Thread key={`${target.contactId}:${target.channel}`} org={org} target={target} onChanged={reload} /> : (
+        <div className="card empty"><h3>Pick a conversation</h3><p className="small">Or start a new one with any contact.</p></div>
+      )}
+    </div>
+  );
+}
+
+export default function InboxPage() {
+  return (
+    <TenantGate title="Conversations" subtitle="Every text and email with your customers, in one place.">
+      {(info) => <Suspense fallback={<Loading />}><Inbox org={info.org} /></Suspense>}
+    </TenantGate>
+  );
+}
