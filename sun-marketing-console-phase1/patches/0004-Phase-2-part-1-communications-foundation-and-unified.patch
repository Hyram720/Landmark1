+++ b/src/app/api/channels/route.ts
@@ -0,0 +1,74 @@
+import { z } from "zod";
+import { ApiError, fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { can } from "@/lib/tenant/rbac";
+import { hintFor, sealJson, vaultReady } from "@/lib/crypto/vault";
+import { normalizeAddress } from "@/lib/comms/address";
+import { adapterFor, providerCatalog } from "@/lib/comms/providers";
+import { ACCOUNT_COLUMNS } from "@/lib/comms/service";
+import { DEFAULT_QUIET_HOURS } from "@/lib/comms/compliance";
+import { publicBaseUrl, systemClient } from "@/lib/supabase/system";
+
+export const dynamic = "force-dynamic";
+
+export const GET = tenantRoute("org.read", async (ctx, req) => {
+  const [accounts, org] = await Promise.all([
+    ctx.client.from("provider_accounts").select(ACCOUNT_COLUMNS).eq("organization_id", ctx.org.id).order("channel").order("created_at"),
+    ctx.client.from("organizations").select("timezone, settings").eq("id", ctx.org.id).maybeSingle(),
+  ]);
+  fromDb(accounts.error);
+  fromDb(org.error);
+  const base = publicBaseUrl(req);
+  const settings = (org.data?.settings || {}) as { quiet_hours?: { start: number; end: number } };
+  return {
+    accounts: accounts.data || [],
+    catalog: providerCatalog(),
+    canManage: can(ctx.org.role, "org.manage"),
+    readiness: { encryption: vaultReady(), webhooks: !!systemClient(), publicUrl: base },
+    webhookUrls: base ? { telnyx: `${base}/api/webhooks/telnyx/sms`, twilio: `${base}/api/webhooks/twilio/sms` } : null,
+    settings: { timezone: org.data?.timezone || "America/New_York", quiet_hours: settings.quiet_hours || DEFAULT_QUIET_HOURS },
+  };
+});
+
+const createAccount = z.object({
+  channel: z.enum(["sms", "email"]),
+  provider: z.enum(["telnyx", "twilio", "resend"]),
+  label: z.string().trim().min(1, "Give the account a name.").max(80),
+  address: z.string().trim().min(3).max(254),
+  credentials: z.record(z.string(), z.string().trim().max(2000)),
+  config: z.record(z.string(), z.string().trim().max(2000)).default({}),
+  is_default: z.boolean().default(false),
+});
+
+export const POST = tenantRoute("org.manage", async (ctx, req) => {
+  const input = await readJson(req, createAccount);
+  if (!vaultReady()) throw new ApiError("Integration not configured: set APP_ENCRYPTION_KEY (32+ random characters) on the server first.", 503, "integration_not_configured");
+  const adapter = adapterFor(input.channel, input.provider);
+  if (!adapter) throw new ApiError(`${input.provider} does not support ${input.channel}.`, 422, "invalid");
+  const address = normalizeAddress(input.channel, input.address);
+  if (!address) throw new ApiError(input.channel === "sms" ? "Enter the number in a valid format, e.g. +18565550199." : "Enter a valid sender email address.", 422, "invalid");
+  const creds: Record<string, string> = {};
+  for (const f of adapter.credentialFields) {
+    const v = input.credentials[f.key];
+    if (f.required && !v) throw new ApiError(`${f.label} is required.`, 422, "invalid");
+    if (v) creds[f.key] = v;
+  }
+  const config: Record<string, string> = {};
+  for (const f of adapter.configFields) {
+    const v = input.config[f.key];
+    if (f.required && !v) throw new ApiError(`${f.label} is required.`, 422, "invalid");
+    if (v) config[f.key] = v;
+  }
+  const mainSecret = creds.apiKey || creds.authToken || Object.values(creds)[0] || "";
+  if (input.is_default) {
+    await ctx.client.from("provider_accounts").update({ is_default: false }).eq("organization_id", ctx.org.id).eq("channel", input.channel);
+  }
+  const { data, error } = await ctx.client.from("provider_accounts").insert({
+    organization_id: ctx.org.id, channel: input.channel, provider: input.provider, label: input.label, address,
+    encrypted_credentials: sealJson(creds), credential_hint: hintFor(mainSecret), config, is_default: input.is_default, created_by: ctx.session.user.id,
+  }).select(ACCOUNT_COLUMNS).single();
+  if (error?.code === "23505") throw new ApiError("That number or address is already connected (here or in another account).", 409, "conflict");
+  fromDb(error);
+  await audit(ctx.client, ctx.org.id, "channel.added", { type: "provider_account", id: data!.id }, { provider: input.provider, channel: input.channel, address });
+  return { account: data };
+});
