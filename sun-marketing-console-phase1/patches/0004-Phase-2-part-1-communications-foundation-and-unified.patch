+++ b/src/lib/comms/inbound.ts
@@ -0,0 +1,70 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { fromDb } from "@/lib/tenant/api";
+import { keywordOf, toE164 } from "./address";
+import { ACCOUNT_COLUMNS, ensureConversation, findContactByPhone, type Account } from "./service";
+import type { SmsEvent } from "./providers";
+
+// Finds the organization's account that owns a number we send from/receive on.
+export async function accountForAddress(system: SupabaseClient, provider: string, address: string, withSecret = false) {
+  const e164 = toE164(address);
+  if (!e164) return null;
+  const { data, error } = await system
+    .from("provider_accounts").select(withSecret ? `${ACCOUNT_COLUMNS}, encrypted_credentials` : ACCOUNT_COLUMNS)
+    .eq("channel", "sms").eq("provider", provider).eq("status", "active").eq("address", e164).maybeSingle();
+  fromDb(error);
+  return (data as unknown as (Account & { encrypted_credentials?: string }) | null) ?? null;
+}
+
+// Applies one verified SMS webhook event. Safe to receive more than once:
+// the (provider, event id) pair is recorded first and replays are ignored.
+export async function processSmsEvent(system: SupabaseClient, provider: string, event: SmsEvent, account: Account) {
+  const org = account.organization_id;
+  const { data: logged, error: logError } = await system
+    .from("webhook_events").insert({ provider, event_id: event.eventId, organization_id: org }).select("id").single();
+  if (logError?.code === "23505") return { result: "duplicate" as const };
+  fromDb(logError);
+  try {
+    let result: "received" | "status" | "ignored" = "ignored";
+    if (event.kind === "inbound") {
+      const from = toE164(event.from);
+      if (!from) throw new Error("Inbound message has no usable sender number.");
+      let contact = await findContactByPhone(system, org, from);
+      if (!contact) {
+        const { data, error } = await system.from("contacts").insert({ organization_id: org, phone: from, source: "Inbound text", lifecycle_stage: "lead" })
+          .select("id, phone, erased_at, created_at").single();
+        fromDb(error);
+        contact = data!;
+      }
+      const conversationId = await ensureConversation(system, org, contact.id, "sms");
+      const { error } = await system.from("messages").insert({
+        organization_id: org, conversation_id: conversationId, contact_id: contact.id, channel: "sms", direction: "inbound",
+        body: event.text.slice(0, 20000) || "(empty message)", status: "received", provider, provider_account_id: account.id,
+        provider_message_id: event.providerMessageId, from_address: from, to_address: account.address,
+      });
+      if (error && error.code !== "23505") fromDb(error);
+      const keyword = keywordOf(event.text);
+      if (keyword === "stop") {
+        const { error: e } = await system.rpc("apply_opt_out", { p_org: org, p_contact: contact.id, p_channel: "sms", p_address: from, p_source: "Replied STOP", p_reason: "opt_out" });
+        fromDb(e);
+      } else if (keyword === "start") {
+        const { error: e } = await system.rpc("clear_opt_out", { p_org: org, p_contact: contact.id, p_channel: "sms", p_address: from, p_source: "Replied START" });
+        fromDb(e);
+      }
+      result = "received";
+    } else {
+      // Never move a message backwards (e.g. a late "sent" after "delivered").
+      const from = event.status === "sent" ? ["sending"] : ["sending", "sent"];
+      const { error } = await system.from("messages")
+        .update({ status: event.status, ...(event.status === "delivered" ? { delivered_at: new Date().toISOString() } : {}), ...(event.error ? { error: event.error } : {}) })
+        .eq("organization_id", org).eq("provider", provider).eq("provider_message_id", event.providerMessageId).eq("direction", "outbound").in("status", from);
+      fromDb(error);
+      result = "status";
+    }
+    await system.from("webhook_events").update({ processed_at: new Date().toISOString() }).eq("id", logged!.id);
+    return { result };
+  } catch (e) {
+    await system.from("webhook_events").update({ error: e instanceof Error ? e.message.slice(0, 500) : "error" }).eq("id", logged!.id);
+    throw e;
+  }
+}
diff --git a/src/lib/comms/providers/index.ts b/src/lib/comms/providers/index.ts
new file mode 100644
