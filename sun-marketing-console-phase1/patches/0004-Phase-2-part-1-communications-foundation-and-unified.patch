diff --git a/tests/unit/comms-core.test.ts b/tests/unit/comms-core.test.ts
new file mode 100644
index 0000000..ecb8086
--- /dev/null
+++ b/tests/unit/comms-core.test.ts
@@ -0,0 +1,108 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { keywordOf, normalizeEmail, toE164 } from "@/lib/comms/address";
+import { evaluateSend, localHour, type GateInput } from "@/lib/comms/compliance";
+
+describe("address normalization", () => {
+  it.each([
+    ["(856) 555-0100", "+18565550100"], ["856.555.0100", "+18565550100"], ["1-856-555-0100", "+18565550100"],
+    ["+44 20 7946 0958", "+442079460958"], ["+1 (856) 555-0100", "+18565550100"],
+  ])("normalizes %s", (raw, e164) => expect(toE164(raw)).toBe(e164));
+  it.each(["555-0100", "0123456789", "+0123456789", "", "call me", "+1234"])("rejects %s", (raw) => expect(toE164(raw)).toBeNull());
+  it("normalizes email", () => {
+    expect(normalizeEmail("  Pat@Example.COM ")).toBe("pat@example.com");
+    expect(normalizeEmail("nope")).toBeNull();
+  });
+  it("recognizes carrier keywords only as whole messages", () => {
+    expect(keywordOf("STOP")).toBe("stop");
+    expect(keywordOf(" unsubscribe. ")).toBe("stop");
+    expect(keywordOf("Start")).toBe("start");
+    expect(keywordOf("HELP?")).toBe("help");
+    expect(keywordOf("please stop by tomorrow")).toBeNull();
+  });
+});
+
+// 2026-10-06T18:00Z is 2pm in New York.
+const NOON_NY = new Date("2026-10-06T18:00:00Z");
+const base: GateInput = {
+  channel: "sms", purpose: "conversational", body: "Your estimate is ready.",
+  contact: { phone: "(856) 555-0100", email: "pat@example.com", doNotContact: false, erased: false },
+  consent: "granted", suppressed: false, lastInboundAt: null, now: NOON_NY, timezone: "America/New_York", quietHours: { start: 8, end: 21 },
+};
+const gate = (over: Partial<GateInput> = {}) => evaluateSend({ ...base, ...over, contact: { ...base.contact, ...(over.contact || {}) } });
+
+describe("compliance gate", () => {
+  it("allows a consented text during business hours and normalizes the number", () => {
+    expect(gate()).toEqual({ ok: true, to: "+18565550100", body: "Your estimate is ready.", notes: [] });
+  });
+  it.each([
+    [{ contact: { erased: true } as GateInput["contact"] }, "erased"],
+    [{ contact: { doNotContact: true } as GateInput["contact"] }, "do_not_contact"],
+    [{ contact: { phone: "555" } as GateInput["contact"] }, "no_address"],
+    [{ suppressed: true }, "opted_out"],
+    [{ consent: "revoked" as const }, "consent_revoked"],
+    [{ body: "   " }, "empty"],
+    [{ body: "x".repeat(1601) }, "too_long"],
+  ])("blocks %j", (over, code) => {
+    const r = gate(over);
+    expect(r.ok).toBe(false);
+    expect(!r.ok && r.code).toBe(code);
+  });
+  it("needs consent for SMS unless replying within 24 hours", () => {
+    expect(gate({ consent: null }).ok).toBe(false);
+    const reply = gate({ consent: null, lastInboundAt: new Date(NOON_NY.getTime() - 3 * 3600e3) });
+    expect(reply.ok && reply.notes).toContain("Sent as a reply to their recent text.");
+    expect(gate({ consent: null, lastInboundAt: new Date(NOON_NY.getTime() - 25 * 3600e3) }).ok).toBe(false);
+  });
+  it("never lets a recent reply substitute for marketing consent", () => {
+    const r = gate({ consent: null, purpose: "marketing", lastInboundAt: new Date(NOON_NY.getTime() - 60e3) });
+    expect(!r.ok && r.code).toBe("no_consent");
+  });
+  it("adds opt-out instructions to marketing texts", () => {
+    const r = gate({ purpose: "marketing", body: "20% off gutter guards this week!" });
+    expect(r.ok && r.body).toBe("20% off gutter guards this week!\nReply STOP to opt out.");
+    const already = gate({ purpose: "marketing", body: "Sale! Text STOP to opt out." });
+    expect(already.ok && already.body).toBe("Sale! Text STOP to opt out.");
+  });
+  it("enforces quiet hours in the business time zone and suggests the next send time", () => {
+    const late = new Date("2026-10-07T02:30:00Z"); // 10:30pm New York
+    expect(localHour(late, "America/New_York")).toBe(22);
+    const r = gate({ now: late });
+    expect(!r.ok && r.code).toBe("quiet_hours");
+    expect(!r.ok && r.retryAt && localHour(r.retryAt, "America/New_York")).toBe(8);
+    // Same instant is mid-afternoon in Tokyo.
+    expect(gate({ now: late, timezone: "Asia/Tokyo" }).ok).toBe(true);
+  });
+  it("lets you answer someone who just texted, even during quiet hours", () => {
+    const late = new Date("2026-10-07T02:30:00Z");
+    expect(gate({ now: late, lastInboundAt: new Date(late.getTime() - 20 * 60e3) }).ok).toBe(true);
+  });
+  it("handles overnight allowed windows", () => {
+    expect(gate({ quietHours: { start: 22, end: 6 } }).ok).toBe(false);
+  });
+  it("routes marketing email to Email Marketing and allows conversational email without consent", () => {
+    expect(gate({ channel: "email", purpose: "marketing" }).ok).toBe(false);
+    const r = gate({ channel: "email", consent: null });
+    expect(r.ok && r.to).toBe("pat@example.com");
+    expect(gate({ channel: "email", consent: "revoked" }).ok).toBe(false);
+    expect(gate({ channel: "email", contact: { email: "nope" } as GateInput["contact"] }).ok).toBe(false);
+  });
+  it("quiet hours do not apply to email", () => {
+    expect(gate({ channel: "email", now: new Date("2026-10-07T07:00:00Z") }).ok).toBe(true);
+  });
+});
+
+describe("vault", () => {
+  afterEach(() => vi.unstubAllEnvs());
+  it("round-trips credentials and detects a different key", async () => {
+    vi.stubEnv("APP_ENCRYPTION_KEY", "a".repeat(40));
+    const { sealJson, openJson, vaultReady } = await import("@/lib/crypto/vault");
+    expect(vaultReady()).toBe(true);
+    const sealed = sealJson({ apiKey: "KEY_secret_value" });
+    expect(sealed).not.toContain("secret");
+    expect(openJson(sealed)).toEqual({ apiKey: "KEY_secret_value" });
+    vi.stubEnv("APP_ENCRYPTION_KEY", "b".repeat(40));
+    expect(() => openJson(sealed)).toThrow(/different APP_ENCRYPTION_KEY/);
+    vi.stubEnv("APP_ENCRYPTION_KEY", "short");
+    expect(vaultReady()).toBe(false);
+  });
+});
