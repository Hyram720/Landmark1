+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createHmac, generateKeyPairSync, sign } from "node:crypto";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { FakeDb } from "../support/fake-supabase";
+import { parseTelnyxEvent, telnyx, verifyTelnyxSignature } from "@/lib/comms/providers/telnyx";
+import { parseTwilioEvent, twilio, verifyTwilioSignature } from "@/lib/comms/providers/twilio";
+import { ProviderSendError } from "@/lib/comms/providers/types";
+
+const ORG = "11111111-1111-4111-8111-111111111111";
+const USER = "22222222-2222-4222-8222-222222222222";
+const CONTACT = "33333333-3333-4333-8333-333333333333";
+
+describe("Telnyx", () => {
+  const { publicKey, privateKey } = generateKeyPairSync("ed25519");
+  const pubB64 = publicKey.export({ format: "der", type: "spki" }).subarray(12).toString("base64");
+  const raw = JSON.stringify({ data: { id: "evt-1", event_type: "message.received", payload: { id: "m-1", text: "Hi", from: { phone_number: "+18565550100" }, to: [{ phone_number: "+18565550199" }] } } });
+  const ts = String(Math.floor(Date.now() / 1000));
+  const sig = sign(null, Buffer.from(`${ts}|${raw}`), privateKey).toString("base64");
+
+  it("verifies genuine webhooks and rejects tampered, stale or unsigned ones", () => {
+    expect(verifyTelnyxSignature(raw, ts, sig, pubB64)).toBe(true);
+    expect(verifyTelnyxSignature(raw.replace("Hi", "Ha"), ts, sig, pubB64)).toBe(false);
+    expect(verifyTelnyxSignature(raw, String(Number(ts) - 600), sig, pubB64)).toBe(false);
+    expect(verifyTelnyxSignature(raw, ts, "", pubB64)).toBe(false);
+    expect(verifyTelnyxSignature(raw, ts, sig, "")).toBe(false);
+  });
+  it("parses inbound messages and delivery receipts", () => {
+    expect(parseTelnyxEvent(JSON.parse(raw))).toEqual({ kind: "inbound", eventId: "evt-1", providerMessageId: "m-1", from: "+18565550100", to: "+18565550199", text: "Hi" });
+    const fin = parseTelnyxEvent({ data: { id: "evt-2", event_type: "message.finalized", payload: { id: "m-9", from: { phone_number: "+18565550199" }, to: [{ phone_number: "+18565550100", status: "delivery_failed" }], errors: [{ title: "Unreachable" }] } } });
+    expect(fin).toMatchObject({ kind: "status", status: "failed", error: "Unreachable", ourAddress: "+18565550199" });
+    expect(parseTelnyxEvent({ data: { id: "x", event_type: "call.initiated", payload: { id: "c" } } })).toBeNull();
+  });
+});
+
+describe("Twilio", () => {
+  it("verifies the signature over the exact URL and sorted parameters", () => {
+    const url = "https://console.example.com/api/webhooks/twilio/sms";
+    const params = { MessageSid: "SM1", From: "+18565550100", To: "+18565550199", Body: "STOP", SmsStatus: "received" };
+    const data = url + Object.keys(params).sort().map((k) => k + params[k as keyof typeof params]).join("");
+    const good = createHmac("sha1", "tok").update(data).digest("base64");
+    expect(verifyTwilioSignature(url, params, good, "tok")).toBe(true);
+    expect(verifyTwilioSignature(url + "?x=1", params, good, "tok")).toBe(false);
+    expect(verifyTwilioSignature(url, { ...params, Body: "START" }, good, "tok")).toBe(false);
+    expect(verifyTwilioSignature(url, params, good, "other")).toBe(false);
+    expect(parseTwilioEvent(params)).toMatchObject({ kind: "inbound", eventId: "SM1:received", text: "STOP" });
+    expect(parseTwilioEvent({ MessageSid: "SM2", MessageStatus: "undelivered", From: "+18565550199", ErrorCode: "30003" })).toMatchObject({ kind: "status", status: "failed", error: "Twilio error 30003" });
+  });
+});
+
+describe("adapters", () => {
+  afterEach(() => vi.unstubAllGlobals());
+  it("sends through Telnyx and Twilio with the right shape", async () => {
+    const f = vi.fn()
+      .mockResolvedValueOnce(new Response(JSON.stringify({ data: { id: "tx-1" } }), { status: 200 }))
+      .mockResolvedValueOnce(new Response(JSON.stringify({ sid: "SM-1" }), { status: 201 }));
+    vi.stubGlobal("fetch", f);
+    await expect(telnyx.send({ apiKey: "K" }, { messagingProfileId: "mp" }, { from: "+1", to: "+2", text: "hi" })).resolves.toEqual({ providerMessageId: "tx-1" });
+    expect(JSON.parse(f.mock.calls[0][1].body)).toEqual({ from: "+1", to: "+2", text: "hi", messaging_profile_id: "mp" });
+    await expect(twilio.send({ accountSid: "AC1", authToken: "T" }, {}, { from: "+1", to: "+2", text: "hi" })).resolves.toEqual({ providerMessageId: "SM-1" });
+    expect(String(f.mock.calls[1][1].body)).toBe("To=%2B2&From=%2B1&Body=hi");
+  });
+  it("classifies failures: credentials are permanent, outages are retryable", async () => {
+    vi.stubGlobal("fetch", vi.fn().mockResolvedValueOnce(new Response("{}", { status: 401 })).mockResolvedValueOnce(new Response("{}", { status: 503 })).mockRejectedValueOnce(new Error("net")));
