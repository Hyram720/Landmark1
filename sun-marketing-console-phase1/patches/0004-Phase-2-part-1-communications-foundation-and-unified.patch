+import { z } from "zod";
+import { fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+
+export const dynamic = "force-dynamic";
+
+const validZone = (tz: string) => {
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: tz });
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+const settings = z.object({
+  timezone: z.string().trim().max(64).refine(validZone, "Choose a valid time zone."),
+  quiet_start: z.number().int().min(0).max(23),
+  quiet_end: z.number().int().min(1).max(24),
+}).refine((s) => s.quiet_start !== s.quiet_end, { message: "The sending window must not be empty." });
+
+// Business time zone and the hours texts may go out.
+export const PUT = tenantRoute("org.manage", async (ctx, req) => {
+  const input = await readJson(req, settings);
+  const { data: org, error } = await ctx.client.from("organizations").select("settings").eq("id", ctx.org.id).single();
+  fromDb(error);
+  const next = { ...(org?.settings || {}), quiet_hours: { start: input.quiet_start, end: input.quiet_end } };
+  const { error: e } = await ctx.client.from("organizations").update({ timezone: input.timezone, settings: next }).eq("id", ctx.org.id);
+  fromDb(e);
+  await audit(ctx.client, ctx.org.id, "channel.settings_changed", { type: "organization", id: ctx.org.id }, { timezone: input.timezone, quiet_hours: next.quiet_hours });
+  return { ok: true };
+});
