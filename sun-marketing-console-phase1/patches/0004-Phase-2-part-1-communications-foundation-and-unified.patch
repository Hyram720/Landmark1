+  });
+
+  it("does not fail over on a permanent error and explains the failure", async () => {
+    seed(db, { consent: "granted", accounts: 2 });
+    const f = vi.fn().mockResolvedValue(new Response("{}", { status: 401 }));
+    vi.stubGlobal("fetch", f);
+    const { sendMessage } = await import("@/lib/comms/service");
+    const r = await sendMessage(ctx, { contact_id: CONTACT, channel: "sms", body: "hi" });
