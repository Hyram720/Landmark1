+import { fromDb, tenantRoute } from "@/lib/tenant/api";
+
+export const dynamic = "force-dynamic";
+
+// Inbox list: open/closed/all, optionally only mine or only unread.
+export const GET = tenantRoute("crm.read", async (ctx, req) => {
+  const url = new URL(req.url);
+  const status = url.searchParams.get("status") || "open";
+  let query = ctx.client
+    .from("conversations")
+    .select("id, contact_id, channel, status, assignee_id, last_message_at, last_message_preview, last_direction, unread_count, contacts(first_name, last_name, phone, email)")
+    .eq("organization_id", ctx.org.id);
+  if (status === "open" || status === "closed") query = query.eq("status", status);
+  if (url.searchParams.get("mine") === "1") query = query.eq("assignee_id", ctx.session.user.id);
+  if (url.searchParams.get("unread") === "1") query = query.gt("unread_count", 0);
+  const { data, error } = await query.order("last_message_at", { ascending: false, nullsFirst: false }).limit(200);
+  fromDb(error);
+  return { conversations: data || [] };
+});
