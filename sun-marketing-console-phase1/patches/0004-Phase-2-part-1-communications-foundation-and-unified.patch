+                })}</tbody>
+              </table></div>
+            )}
+          </div>
+          {data.canManage ? <AddChannel catalog={data.catalog} onAdded={() => { toast("Connected. Use Test to check the credentials."); reload(); }} /> : <div className="notice notice-info small">Admins connect numbers and senders for {org.name}.</div>}
+        </div>
+        <div className="stack">
+          <div className="card">
+            <div className="card-head"><div><h3>Receive replies</h3><div className="sub">Point your provider at these addresses so replies, delivery receipts and STOP requests reach the inbox.</div></div></div>
