new file mode 100644
index 0000000..278902f
--- /dev/null
+++ b/src/app/api/channels/[id]/route.ts
@@ -0,0 +1,51 @@
+import { z } from "zod";
+import { ApiError, fromDb, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { openJson, VaultError } from "@/lib/crypto/vault";
+import { adapterFor } from "@/lib/comms/providers";
+import { ACCOUNT_COLUMNS, type Account } from "@/lib/comms/service";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+async function load(ctx: Parameters<Parameters<typeof tenantRoute>[1]>[0], id: string) {
+  const { data, error } = await ctx.client.from("provider_accounts").select(ACCOUNT_COLUMNS).eq("organization_id", ctx.org.id).eq("id", uuid.parse(id)).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Channel not found.", 404, "not_found");
+  return data as Account;
+}
+
+const patch = z.object({ is_default: z.boolean().optional(), status: z.enum(["active", "disabled"]).optional(), label: z.string().trim().min(1).max(80).optional() });
+
+export const PATCH = tenantRoute<P>("org.manage", async (ctx, req, { id }) => {
+  const account = await load(ctx, id);
+  const input = await readJson(req, patch);
+  if (input.is_default) await ctx.client.from("provider_accounts").update({ is_default: false }).eq("organization_id", ctx.org.id).eq("channel", account.channel);
+  const { error } = await ctx.client.from("provider_accounts").update(input).eq("organization_id", ctx.org.id).eq("id", account.id);
+  fromDb(error);
+  await audit(ctx.client, ctx.org.id, "channel.changed", { type: "provider_account", id: account.id }, input);
+  return { ok: true };
+});
+
+export const DELETE = tenantRoute<P>("org.manage", async (ctx, _req, { id }) => {
+  const account = await load(ctx, id);
+  const { error } = await ctx.client.from("provider_accounts").delete().eq("organization_id", ctx.org.id).eq("id", account.id);
+  fromDb(error);
+  await audit(ctx.client, ctx.org.id, "channel.removed", { type: "provider_account", id: account.id }, { address: account.address });
+  return { ok: true };
+});
+
+// Checks the stored credentials against the provider without sending anything.
+export const POST = tenantRoute<P>("org.manage", async (ctx, req, { id }) => {
+  await readJson(req, z.object({ action: z.literal("test") }));
+  const account = await load(ctx, id);
+  const { data: sealed, error } = await ctx.client.rpc("provider_secret", { p_account: account.id });
+  fromDb(error);
+  try {
+    const adapter = adapterFor(account.channel, account.provider);
+    return await adapter.verifyCredentials(openJson(String(sealed)), account.config, account.address);
+  } catch (e) {
+    if (e instanceof VaultError) return { ok: false, message: e.message };
+    throw e;
+  }
+});
