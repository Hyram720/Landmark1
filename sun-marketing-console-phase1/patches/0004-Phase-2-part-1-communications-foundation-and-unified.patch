@@ -0,0 +1,201 @@
+"use client";
+import { useState } from "react";
+import TenantGate, { ErrorState, Loading } from "@/components/tenant/TenantGate";
+import { api, Org, useResource } from "@/components/tenant/client";
+import { Copy, useToast } from "@/components/ui";
+
+type Field = { key: string; label: string; secret?: boolean; required: boolean; help?: string };
+type Provider = { id: string; label: string; channel: "sms" | "email"; credentialFields: Field[]; configFields: Field[] };
+type Account = { id: string; channel: "sms" | "email"; provider: string; label: string; address: string; credential_hint: string | null; is_default: boolean; status: string };
+type Data = {
+  accounts: Account[]; catalog: Provider[]; canManage: boolean;
+  readiness: { encryption: boolean; webhooks: boolean; publicUrl: string | null };
+  webhookUrls: { telnyx: string; twilio: string } | null;
+  settings: { timezone: string; quiet_hours: { start: number; end: number } };
+};
+
+const ZONES = ["America/New_York", "America/Chicago", "America/Denver", "America/Phoenix", "America/Los_Angeles", "America/Anchorage", "Pacific/Honolulu", "America/Puerto_Rico", "Europe/London", "UTC"];
+const hourLabel = (h: number) => (h === 0 || h === 24 ? "12 am" : h === 12 ? "12 pm" : h < 12 ? `${h} am` : `${h - 12} pm`);
+
+function AddChannel({ catalog, onAdded }: { catalog: Provider[]; onAdded: () => void }) {
+  const [channel, setChannel] = useState<"sms" | "email">("sms");
+  const options = catalog.filter((p) => p.channel === channel);
+  const [providerId, setProviderId] = useState(options[0]?.id ?? "");
+  const provider = catalog.find((p) => p.id === providerId && p.channel === channel) ?? options[0];
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  return (
+    <form
+      className="card"
+      onSubmit={async (e) => {
+        e.preventDefault();
+        if (!provider) return;
+        const f = new FormData(e.currentTarget);
+        const pick = (fields: Field[], prefix: string) => Object.fromEntries(fields.map((x) => [x.key, String(f.get(`${prefix}${x.key}`) || "").trim()]).filter(([, v]) => v));
+        setBusy(true);
+        setError("");
+        try {
+          await api("/api/channels", {
+            body: {
+              channel, provider: provider.id, label: String(f.get("label") || ""), address: String(f.get("address") || ""),
+              credentials: pick(provider.credentialFields, "cred-"), config: pick(provider.configFields, "cfg-"), is_default: f.get("is_default") === "on",
+            },
+          });
+          (e.target as HTMLFormElement).reset();
+          onAdded();
+        } catch (err) {
+          setError(err instanceof Error ? err.message : "Could not add the channel.");
+        } finally {
+          setBusy(false);
+        }
+      }}
+    >
+      <div className="card-head"><div><h3>Connect a number or sender</h3><div className="sub">Credentials are encrypted on the server and never shown again.</div></div></div>
+      <div className="card-pad stack">
+        <div className="field-grid">
+          <div className="field"><label htmlFor="ch-channel">Channel</label>
+            <select id="ch-channel" className="select" value={channel} onChange={(e) => { const c = e.target.value as "sms" | "email"; setChannel(c); setProviderId(catalog.find((p) => p.channel === c)?.id ?? ""); }}>
+              <option value="sms">Text messages (SMS)</option><option value="email">Email</option>
+            </select></div>
+          <div className="field"><label htmlFor="ch-provider">Provider</label>
+            <select id="ch-provider" className="select" value={provider?.id} onChange={(e) => setProviderId(e.target.value)}>
+              {options.map((p) => <option key={p.id} value={p.id}>{p.label}</option>)}
+            </select></div>
+          <div className="field"><label htmlFor="ch-label">Name</label><input id="ch-label" name="label" className="input" required maxLength={80} placeholder={channel === "sms" ? "Main line" : "Office email"} /></div>
+          <div className="field"><label htmlFor="ch-address">{channel === "sms" ? "Phone number" : "Sender address"}</label>
+            <input id="ch-address" name="address" className="input" required placeholder={channel === "sms" ? "+18565550199" : "hello@yourbusiness.com"} /></div>
+          {provider?.credentialFields.map((x) => (
+            <div className="field" key={`c-${provider.id}-${x.key}`}><label htmlFor={`cred-${x.key}`}>{x.label}{x.required ? "" : " (optional)"}</label>
+              <input id={`cred-${x.key}`} name={`cred-${x.key}`} className="input mono" type={x.secret ? "password" : "text"} autoComplete="off" required={x.required} />
+              {x.help && <span className="hint">{x.help}</span>}</div>
+          ))}
+          {provider?.configFields.map((x) => (
+            <div className="field" key={`f-${provider.id}-${x.key}`}><label htmlFor={`cfg-${x.key}`}>{x.label}{x.required ? "" : " (optional)"}</label>
+              <input id={`cfg-${x.key}`} name={`cfg-${x.key}`} className="input" required={x.required} autoComplete="off" />
+              {x.help && <span className="hint">{x.help}</span>}</div>
+          ))}
+        </div>
+        <label className="row small"><input type="checkbox" name="is_default" defaultChecked /> Use as the default for {channel === "sms" ? "texts" : "email"}</label>
+        {error && <p className="form-error" role="alert">{error}</p>}
+        <div><button className="btn btn-primary" disabled={busy}>{busy ? <span className="spin" /> : "Connect"}</button></div>
+      </div>
+    </form>
+  );
+}
+
+function Settings({ data, onSaved }: { data: Data; onSaved: () => void }) {
+  const [tz, setTz] = useState(data.settings.timezone);
+  const [start, setStart] = useState(data.settings.quiet_hours.start);
+  const [end, setEnd] = useState(data.settings.quiet_hours.end);
+  const [msg, setMsg] = useState("");
+  return (
+    <div className="card">
