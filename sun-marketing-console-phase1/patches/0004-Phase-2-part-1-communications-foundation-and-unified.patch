+import { z } from "zod";
+import { ApiError, fromDb, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { MESSAGE_COLUMNS } from "@/lib/comms/service";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+// One conversation with its messages; opening it marks it read.
+export const GET = tenantRoute<P>("crm.read", async (ctx, _req, { id }) => {
+  const convId = uuid.parse(id);
+  const { data: conversation, error } = await ctx.client
+    .from("conversations")
+    .select("id, contact_id, channel, status, assignee_id, unread_count, last_message_at, contacts(id, first_name, last_name, phone, email, do_not_contact)")
+    .eq("organization_id", ctx.org.id).eq("id", convId).maybeSingle();
+  fromDb(error);
+  if (!conversation) throw new ApiError("Conversation not found.", 404, "not_found");
+  const { data: messages, error: mError } = await ctx.client
+    .from("messages").select(MESSAGE_COLUMNS).eq("organization_id", ctx.org.id).eq("conversation_id", convId)
+    .order("created_at", { ascending: true }).limit(500);
+  fromDb(mError);
+  if (conversation.unread_count > 0 && ctx.org.role !== "viewer") {
+    await ctx.client.from("conversations").update({ unread_count: 0 }).eq("organization_id", ctx.org.id).eq("id", convId);
+  }
+  return { conversation, messages: messages || [] };
+});
+
+const change = z.object({ action: z.enum(["close", "reopen", "assign_me", "unassign"]) });
+
+export const POST = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const { action } = await readJson(req, change);
+  const patch = action === "close" ? { status: "closed" } : action === "reopen" ? { status: "open" }
+    : action === "assign_me" ? { assignee_id: ctx.session.user.id } : { assignee_id: null };
+  const { data, error } = await ctx.client.from("conversations").update(patch).eq("organization_id", ctx.org.id).eq("id", uuid.parse(id)).select("id").maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Conversation not found.", 404, "not_found");
+  return { ok: true };
+});
