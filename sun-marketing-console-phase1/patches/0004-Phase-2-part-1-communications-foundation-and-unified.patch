+import { z } from "zod";
+import { ApiError, fromDb, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { normalizeAddress } from "@/lib/comms/address";
+
+export const dynamic = "force-dynamic";
+
+// Record that a person asked not to be messaged on a channel (e.g. said so on a call).
+export const POST = tenantRoute<{ id: string }>("crm.write", async (ctx, req, { id }) => {
+  const input = await readJson(req, z.object({ channel: z.enum(["sms", "email"]), source: z.string().trim().min(3).max(200) }));
+  const contactId = uuid.parse(id);
+  const { data: contact, error } = await ctx.client.from("contacts").select("phone, email").eq("organization_id", ctx.org.id).eq("id", contactId).maybeSingle();
+  fromDb(error);
+  if (!contact) throw new ApiError("Contact not found.", 404, "not_found");
+  const address = normalizeAddress(input.channel, input.channel === "sms" ? contact.phone : contact.email);
+  if (!address) throw new ApiError(`This contact has no valid ${input.channel === "sms" ? "mobile number" : "email address"}.`, 422, "invalid");
+  const { error: rpcError } = await ctx.client.rpc("apply_opt_out", {
+    p_org: ctx.org.id, p_contact: contactId, p_channel: input.channel, p_address: address, p_source: input.source, p_reason: "opt_out",
+  });
+  fromDb(rpcError);
+  return { ok: true };
+});
