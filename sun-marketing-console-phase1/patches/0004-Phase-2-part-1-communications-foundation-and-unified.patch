@@ -0,0 +1,34 @@
+import { providerFailure, type EmailAdapter } from "./types";
+
+export const resend: EmailAdapter = {
+  id: "resend",
+  label: "Resend",
+  credentialFields: [{ key: "apiKey", label: "API key", secret: true, required: true, help: "resend.com → API Keys (sending access is enough)" }],
+  configFields: [{ key: "fromName", label: "Sender name", required: false, help: "Shown as the From name, e.g. Acme Roofing." }],
+  async send(creds, config, msg) {
+    const from = msg.fromName || config.fromName ? `${(msg.fromName || config.fromName)!.replace(/[<>"]/g, "")} <${msg.from}>` : msg.from;
+    const response = await fetch("https://api.resend.com/emails", {
+      method: "POST",
+      headers: { Authorization: `Bearer ${creds.apiKey}`, "Content-Type": "application/json", "Idempotency-Key": msg.idempotencyKey },
+      body: JSON.stringify({ from, to: [msg.to], subject: msg.subject, text: msg.text }),
+      signal: AbortSignal.timeout(15_000),
+    }).catch(() => null);
+    if (!response?.ok) throw await providerFailure("Resend", response);
+    const body = (await response.json()) as { id?: string };
+    if (!body.id) throw await providerFailure("Resend", null);
+    return { providerMessageId: body.id };
+  },
+  async verifyCredentials(creds, _config, address) {
+    const response = await fetch("https://api.resend.com/domains", { headers: { Authorization: `Bearer ${creds.apiKey}` }, signal: AbortSignal.timeout(12_000) }).catch(() => null);
+    if (!response) return { ok: false, message: "Resend could not be reached." };
+    const body = (await response.json().catch(() => ({}))) as { name?: string; data?: { name?: string; status?: string }[] };
+    // Sending-only keys may not list domains; that is fine for sending.
+    if (body.name === "restricted_api_key") return { ok: true, message: "Key accepted (sending-only key, so the domain could not be checked)." };
+    if (response.status === 401 || response.status === 403) return { ok: false, message: "Resend rejected the API key." };
+    if (!response.ok) return { ok: false, message: `Resend returned HTTP ${response.status}.` };
+    const domain = address.split("@")[1]?.toLowerCase();
+    const match = body.data?.find((d) => d.name?.toLowerCase() === domain);
+    if (!match) return { ok: false, message: `The key works, but ${domain} is not a domain on this Resend account.` };
+    return match.status === "verified" ? { ok: true, message: `Connected. ${domain} is verified.` } : { ok: false, message: `${domain} is on Resend but not verified yet (status: ${match.status}).` };
+  },
+};
diff --git a/src/lib/comms/providers/telnyx.ts b/src/lib/comms/providers/telnyx.ts
new file mode 100644
index 0000000..b1f5a74
--- /dev/null
+++ b/src/lib/comms/providers/telnyx.ts
@@ -0,0 +1,82 @@
+import { createPublicKey, verify } from "node:crypto";
+import { providerFailure, type SmsAdapter, type SmsEvent } from "./types";
+
+const API = "https://api.telnyx.com/v2";
+
+export const telnyx: SmsAdapter = {
+  id: "telnyx",
+  label: "Telnyx",
+  credentialFields: [{ key: "apiKey", label: "API key", secret: true, required: true, help: "Mission Control → API Keys" }],
+  configFields: [
+    { key: "messagingProfileId", label: "Messaging profile ID", required: false, help: "Optional; Telnyx uses the number's profile otherwise." },
+    { key: "webhookPublicKey", label: "Webhook public key", required: true, help: "Mission Control → Keys & Credentials → Public Key. Used to verify incoming texts." },
+  ],
+  async send(creds, config, msg) {
+    const response = await fetch(`${API}/messages`, {
+      method: "POST",
+      headers: { Authorization: `Bearer ${creds.apiKey}`, "Content-Type": "application/json" },
+      body: JSON.stringify({
+        from: msg.from, to: msg.to, text: msg.text,
+        ...(config.messagingProfileId ? { messaging_profile_id: config.messagingProfileId } : {}),
+        ...(msg.statusCallbackUrl ? { webhook_url: msg.statusCallbackUrl } : {}),
+      }),
+      signal: AbortSignal.timeout(15_000),
+    }).catch(() => null);
+    if (!response?.ok) throw await providerFailure("Telnyx", response);
+    const body = (await response.json()) as { data?: { id?: string } };
+    if (!body.data?.id) throw await providerFailure("Telnyx", null);
+    return { providerMessageId: body.data.id };
+  },
+  async verifyCredentials(creds, _config, address) {
+    const response = await fetch(`${API}/phone_numbers?filter[phone_number]=${encodeURIComponent(address)}`, {
+      headers: { Authorization: `Bearer ${creds.apiKey}` },
+      signal: AbortSignal.timeout(12_000),
+    }).catch(() => null);
+    if (!response) return { ok: false, message: "Telnyx could not be reached." };
+    if (response.status === 401 || response.status === 403) return { ok: false, message: "Telnyx rejected the API key." };
+    const body = (await response.json().catch(() => ({}))) as { data?: unknown[] };
+    if (!response.ok) return { ok: false, message: `Telnyx returned HTTP ${response.status}.` };
+    return body.data?.length ? { ok: true, message: `Connected. ${address} is on this Telnyx account.` } : { ok: false, message: `The key works, but ${address} is not a number on this Telnyx account.` };
+  },
+};
+
+// Telnyx signs `${timestamp}|${rawBody}` with ed25519; the public key is base64.
+export function verifyTelnyxSignature(rawBody: string, timestamp: string, signature: string, publicKeyB64: string, now = Date.now()) {
+  if (!/^\d+$/.test(timestamp) || Math.abs(now / 1000 - Number(timestamp)) > 300 || !signature || !publicKeyB64) return false;
+  try {
+    const key = createPublicKey({
+      key: Buffer.concat([Buffer.from("302a300506032b6570032100", "hex"), Buffer.from(publicKeyB64, "base64")]),
+      format: "der",
+      type: "spki",
+    });
+    return verify(null, Buffer.from(`${timestamp}|${rawBody}`), key, Buffer.from(signature, "base64"));
+  } catch {
+    return false;
+  }
+}
+
+type TelnyxBody = {
+  data?: {
+    id?: string;
+    event_type?: string;
+    payload?: { id?: string; text?: string; from?: { phone_number?: string }; to?: { phone_number?: string; status?: string }[]; errors?: { title?: string }[] };
+  };
+};
+
+export function parseTelnyxEvent(body: TelnyxBody): SmsEvent | null {
+  const d = body.data;
+  const p = d?.payload;
+  if (!d?.id || !p?.id) return null;
+  if (d.event_type === "message.received") {
+    const to = p.to?.[0]?.phone_number;
+    if (!p.from?.phone_number || !to) return null;
+    return { kind: "inbound", eventId: d.id, providerMessageId: p.id, from: p.from.phone_number, to, text: String(p.text ?? "") };
+  }
+  if (d.event_type === "message.sent" || d.event_type === "message.finalized") {
+    const raw = p.to?.[0]?.status || "";
+    const status = raw === "delivered" ? "delivered" : /fail|undeliverable|rejected/.test(raw) ? "failed" : "sent";
+    if (!p.from?.phone_number) return null;
+    return { kind: "status", eventId: d.id, providerMessageId: p.id, status, error: status === "failed" ? String(p.errors?.[0]?.title || raw).slice(0, 200) : undefined, ourAddress: p.from.phone_number };
+  }
+  return null;
+}
diff --git a/src/lib/comms/providers/twilio.ts b/src/lib/comms/providers/twilio.ts
new file mode 100644
index 0000000..78c3f81
--- /dev/null
+++ b/src/lib/comms/providers/twilio.ts
@@ -0,0 +1,64 @@
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { providerFailure, type SmsAdapter, type SmsEvent } from "./types";
+
+const API = "https://api.twilio.com/2010-04-01";
+const auth = (sid: string, token: string) => `Basic ${Buffer.from(`${sid}:${token}`).toString("base64")}`;
+
+export const twilio: SmsAdapter = {
+  id: "twilio",
+  label: "Twilio",
+  credentialFields: [
+    { key: "accountSid", label: "Account SID", secret: false, required: true },
+    { key: "authToken", label: "Auth token", secret: true, required: true, help: "Also used to verify incoming webhooks." },
+  ],
+  configFields: [],
+  async send(creds, _config, msg) {
+    const form = new URLSearchParams({ To: msg.to, From: msg.from, Body: msg.text });
+    if (msg.statusCallbackUrl) form.set("StatusCallback", msg.statusCallbackUrl);
+    const response = await fetch(`${API}/Accounts/${encodeURIComponent(creds.accountSid)}/Messages.json`, {
+      method: "POST",
+      headers: { Authorization: auth(creds.accountSid, creds.authToken), "Content-Type": "application/x-www-form-urlencoded" },
+      body: form,
+      signal: AbortSignal.timeout(15_000),
+    }).catch(() => null);
+    if (!response?.ok) throw await providerFailure("Twilio", response);
+    const body = (await response.json()) as { sid?: string };
+    if (!body.sid) throw await providerFailure("Twilio", null);
+    return { providerMessageId: body.sid };
+  },
+  async verifyCredentials(creds, _config, address) {
+    const response = await fetch(`${API}/Accounts/${encodeURIComponent(creds.accountSid)}/IncomingPhoneNumbers.json?PhoneNumber=${encodeURIComponent(address)}`, {
+      headers: { Authorization: auth(creds.accountSid, creds.authToken) },
+      signal: AbortSignal.timeout(12_000),
+    }).catch(() => null);
+    if (!response) return { ok: false, message: "Twilio could not be reached." };
+    if (response.status === 401 || response.status === 403 || response.status === 404) return { ok: false, message: "Twilio rejected the Account SID or auth token." };
+    const body = (await response.json().catch(() => ({}))) as { incoming_phone_numbers?: unknown[] };
+    if (!response.ok) return { ok: false, message: `Twilio returned HTTP ${response.status}.` };
+    return body.incoming_phone_numbers?.length ? { ok: true, message: `Connected. ${address} is on this Twilio account.` } : { ok: false, message: `The credentials work, but ${address} is not on this Twilio account.` };
+  },
+};
+
+// X-Twilio-Signature = base64(HMAC-SHA1(authToken, url + sorted(key+value)...)).
+// The URL must be exactly what Twilio requested (scheme, host, path, query).
+export function verifyTwilioSignature(url: string, params: Record<string, string>, signature: string, authToken: string) {
+  if (!signature || !authToken) return false;
+  const data = url + Object.keys(params).sort().map((k) => k + params[k]).join("");
+  const expected = createHmac("sha1", authToken).update(data, "utf8").digest();
+  const given = Buffer.from(signature, "base64");
+  return given.length === expected.length && timingSafeEqual(given, expected);
+}
+
+export function parseTwilioEvent(p: Record<string, string>): SmsEvent | null {
+  const sid = p.MessageSid || p.SmsSid;
+  if (!sid) return null;
+  const status = (p.MessageStatus || p.SmsStatus || "").toLowerCase();
+  if (status === "received" && p.From && p.To) {
+    return { kind: "inbound", eventId: `${sid}:received`, providerMessageId: sid, from: p.From, to: p.To, text: p.Body ?? "" };
+  }
+  if (["sent", "delivered", "failed", "undelivered"].includes(status) && p.From) {
+    const mapped = status === "delivered" ? "delivered" : status === "sent" ? "sent" : "failed";
+    return { kind: "status", eventId: `${sid}:${status}`, providerMessageId: sid, status: mapped, error: mapped === "failed" ? `Twilio error ${p.ErrorCode || status}` : undefined, ourAddress: p.From };
+  }
+  return null;
+}
diff --git a/src/lib/comms/providers/types.ts b/src/lib/comms/providers/types.ts
new file mode 100644
index 0000000..2cec4f7
--- /dev/null
+++ b/src/lib/comms/providers/types.ts
@@ -0,0 +1,52 @@
+// Provider-neutral contracts for messaging. Domain code (send service, inbox,
+// AI tools) depends only on these; each vendor is one adapter file.
+
+export type SmsProviderId = "telnyx" | "twilio";
+export type EmailProviderId = "resend";
+export type ProviderId = SmsProviderId | EmailProviderId;
+
+export type Credentials = Record<string, string>;
+export type AccountConfig = Record<string, string | undefined>;
+
+export class ProviderSendError extends Error {
+  constructor(message: string, public retryable: boolean) {
+    super(message);
+  }
+}
+
+export type InboundSms = { kind: "inbound"; eventId: string; providerMessageId: string; from: string; to: string; text: string };
+export type StatusUpdate = { kind: "status"; eventId: string; providerMessageId: string; status: "sent" | "delivered" | "failed"; error?: string; ourAddress: string };
+export type SmsEvent = InboundSms | StatusUpdate;
+
+export interface SmsAdapter {
+  id: SmsProviderId;
+  label: string;
+  credentialFields: { key: string; label: string; secret: boolean; required: boolean; help?: string }[];
+  configFields: { key: string; label: string; required: boolean; help?: string }[];
+  send(creds: Credentials, config: AccountConfig, msg: { from: string; to: string; text: string; statusCallbackUrl?: string }): Promise<{ providerMessageId: string }>;
+  verifyCredentials(creds: Credentials, config: AccountConfig, address: string): Promise<{ ok: boolean; message: string }>;
+}
+
+export interface EmailAdapter {
+  id: EmailProviderId;
+  label: string;
+  credentialFields: SmsAdapter["credentialFields"];
+  configFields: SmsAdapter["configFields"];
+  send(
+    creds: Credentials,
+    config: AccountConfig,
+    msg: { from: string; fromName?: string; to: string; subject: string; text: string; idempotencyKey: string },
+  ): Promise<{ providerMessageId: string }>;
+  verifyCredentials(creds: Credentials, config: AccountConfig, address: string): Promise<{ ok: boolean; message: string }>;
+}
+
+// Maps an HTTP failure to a safe, actionable error. 5xx/429/network errors are retryable.
+export async function providerFailure(vendor: string, response: Response | null): Promise<ProviderSendError> {
+  if (!response) return new ProviderSendError(`${vendor} could not be reached.`, true);
+  const body = (await response.json().catch(() => null)) as { errors?: { detail?: string; title?: string }[]; message?: string } | null;
+  const detail = String(body?.errors?.[0]?.detail || body?.errors?.[0]?.title || body?.message || "").slice(0, 200);
+  if (response.status === 401 || response.status === 403) return new ProviderSendError(`${vendor} rejected the credentials. Update them in Channels.`, false);
+  if (response.status === 429) return new ProviderSendError(`${vendor} is rate limiting this account.`, true);
+  if (response.status >= 500) return new ProviderSendError(`${vendor} had a temporary error (HTTP ${response.status}).`, true);
+  return new ProviderSendError(`${vendor} refused the message${detail ? `: ${detail}` : ` (HTTP ${response.status})`}.`, false);
+}
diff --git a/src/lib/comms/service.ts b/src/lib/comms/service.ts
new file mode 100644
index 0000000..6beecf8
--- /dev/null
+++ b/src/lib/comms/service.ts
@@ -0,0 +1,310 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import type { CrmContext } from "@/lib/crm/service";
+import { openJson, vaultReady, VaultError } from "@/lib/crypto/vault";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { normalizeAddress, toE164, type Channel } from "./address";
+import { DEFAULT_QUIET_HOURS, evaluateSend, type GateResult, type Purpose } from "./compliance";
+import { EMAIL_ADAPTERS, ProviderSendError, SMS_ADAPTERS } from "./providers";
+
+export const ACCOUNT_COLUMNS = "id, organization_id, channel, provider, label, address, credential_hint, config, is_default, status, created_at";
+export const MESSAGE_COLUMNS =
+  "id, organization_id, conversation_id, contact_id, channel, direction, purpose, subject, body, status, block_reason, error, provider, provider_message_id, from_address, to_address, ai_generated, sent_by, scheduled_for, sent_at, delivered_at, created_at";
+
+export type Account = {
+  id: string; organization_id: string; channel: Channel; provider: "telnyx" | "twilio" | "resend"; label: string; address: string;
+  credential_hint: string | null; config: Record<string, string>; is_default: boolean; status: string; created_at: string;
+};
+export type Message = {
+  id: string; organization_id: string; conversation_id: string; contact_id: string; channel: Channel; direction: "inbound" | "outbound";
+  purpose: Purpose; subject: string | null; body: string; status: string; block_reason: string | null; error: string | null;
+  provider: string | null; provider_message_id: string | null; from_address: string | null; to_address: string | null;
+  ai_generated: boolean; sent_by: string | null; scheduled_for: string | null; sent_at: string | null; delivered_at: string | null; created_at: string;
+};
+type SecretFetcher = (accountId: string) => Promise<string>;
+
+export const messageInput = z.object({
+  contact_id: z.string().uuid(),
+  channel: z.enum(["sms", "email"]),
+  body: z.string().trim().min(1, "Write a message first.").max(4000, "Keep messages under 4,000 characters."),
+  subject: z.string().trim().max(200).optional(),
+  purpose: z.enum(["conversational", "marketing", "transactional"]).optional(),
+  scheduled_for: z.string().datetime({ offset: true }).optional(),
+  idempotency_key: z.string().trim().min(8).max(100).optional(),
+});
+export type MessageInput = z.infer<typeof messageInput>;
+
+export async function activeAccounts(client: SupabaseClient, orgId: string, channel: Channel): Promise<Account[]> {
+  const { data, error } = await client
+    .from("provider_accounts").select(ACCOUNT_COLUMNS)
+    .eq("organization_id", orgId).eq("channel", channel).eq("status", "active")
+    .order("is_default", { ascending: false }).order("created_at");
+  fromDb(error);
+  return (data || []) as Account[];
+}
+
+type GateContext = {
+  contact: { id: string; first_name: string | null; phone: string | null; email: string | null; do_not_contact: boolean; erased_at: string | null };
+  consent: "granted" | "revoked" | null;
+  suppressed: boolean;
+  lastInboundAt: Date | null;
+  timezone: string;
+  quietHours: { start: number; end: number };
+  orgName: string;
+};
+
+// Everything the compliance gate needs, read fresh at send time.
+export async function loadGateContext(client: SupabaseClient, orgId: string, contactId: string, channel: Channel): Promise<GateContext> {
+  const [contact, org, consent, inbound] = await Promise.all([
+    client.from("contacts").select("id, first_name, phone, email, do_not_contact, erased_at").eq("organization_id", orgId).eq("id", contactId).maybeSingle(),
+    client.from("organizations").select("name, timezone, settings").eq("id", orgId).maybeSingle(),
+    client.from("consents").select("status").eq("organization_id", orgId).eq("contact_id", contactId).eq("channel", channel)
+      .order("captured_at", { ascending: false }).limit(1).maybeSingle(),
+    client.from("messages").select("created_at").eq("organization_id", orgId).eq("contact_id", contactId).eq("channel", channel)
+      .eq("direction", "inbound").order("created_at", { ascending: false }).limit(1).maybeSingle(),
+  ]);
+  for (const r of [contact, org, consent, inbound]) fromDb(r.error);
+  if (!contact.data) throw new ApiError("Contact not found.", 404, "not_found");
+  const address = normalizeAddress(channel, channel === "sms" ? contact.data.phone : contact.data.email);
+  let suppressed = false;
+  if (address) {
+    const { data, error } = await client.from("suppressions").select("address").eq("organization_id", orgId).eq("channel", channel).eq("address", address.toLowerCase()).maybeSingle();
+    fromDb(error);
+    suppressed = !!data;
+  }
+  const settings = (org.data?.settings || {}) as { quiet_hours?: { start?: number; end?: number } };
+  const qh = settings.quiet_hours;
+  return {
+    contact: contact.data,
+    consent: (consent.data?.status as "granted" | "revoked" | undefined) ?? null,
+    suppressed,
+    lastInboundAt: inbound.data ? new Date(inbound.data.created_at) : null,
+    timezone: org.data?.timezone || "America/New_York",
+    quietHours: qh && Number.isInteger(qh.start) && Number.isInteger(qh.end) ? { start: qh.start!, end: qh.end! } : DEFAULT_QUIET_HOURS,
+    orgName: org.data?.name || "our team",
+  };
+}
+
+export function gate(ctx: GateContext, channel: Channel, purpose: Purpose, body: string, now: Date): GateResult {
+  return evaluateSend({
+    channel, purpose, body, now,
+    contact: { phone: ctx.contact.phone, email: ctx.contact.email, doNotContact: ctx.contact.do_not_contact, erased: !!ctx.contact.erased_at },
+    consent: ctx.consent, suppressed: ctx.suppressed, lastInboundAt: ctx.lastInboundAt, timezone: ctx.timezone, quietHours: ctx.quietHours,
+  });
+}
+
+export async function ensureConversation(client: SupabaseClient, orgId: string, contactId: string, channel: Channel): Promise<string> {
+  const find = () => client.from("conversations").select("id").eq("organization_id", orgId).eq("contact_id", contactId).eq("channel", channel).maybeSingle();
+  const existing = await find();
+  fromDb(existing.error);
+  if (existing.data) return existing.data.id;
+  const { data, error } = await client.from("conversations").insert({ organization_id: orgId, contact_id: contactId, channel }).select("id").single();
+  if (error?.code === "23505") {
+    const again = await find();
+    fromDb(again.error);
+    return again.data!.id;
+  }
+  fromDb(error);
+  return data!.id;
+}
+
+function safeSendError(e: unknown) {
+  if (e instanceof ProviderSendError || e instanceof VaultError) return e.message;
+  console.error("[comms] unexpected send error", e);
+  return "The message could not be sent.";
+}
+
+// Claims a queued message and sends it, failing over to the next account on
+// temporary provider errors. The claim (queued -> sending) guarantees one send.
+export async function deliver(client: SupabaseClient, msg: Message, accounts: Account[], getSecret: SecretFetcher, req?: Request) {
+  const { data: claimed, error } = await client
+    .from("messages").update({ status: "sending" }).eq("organization_id", msg.organization_id).eq("id", msg.id).eq("status", "queued")
+    .select(MESSAGE_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!claimed) return null; // someone else is sending it
+  const base = publicBaseUrl(req);
+  let lastError: unknown = null;
+  for (const account of accounts) {
+    try {
+      const creds = openJson(await getSecret(account.id));
+      let providerMessageId: string;
+      if (msg.channel === "sms") {
+        const adapter = SMS_ADAPTERS[account.provider];
+        if (!adapter) throw new ProviderSendError(`${account.provider} is not an SMS provider.`, false);
+        ({ providerMessageId } = await adapter.send(creds, account.config, {
+          from: account.address, to: msg.to_address!, text: msg.body,
+          statusCallbackUrl: base?.startsWith("https://") ? `${base}/api/webhooks/${account.provider}/sms` : undefined,
+        }));
+      } else {
+        const adapter = EMAIL_ADAPTERS[account.provider];
+        if (!adapter) throw new ProviderSendError(`${account.provider} is not an email provider.`, false);
+        ({ providerMessageId } = await adapter.send(creds, account.config, {
+          from: account.address, to: msg.to_address!, subject: msg.subject || "A message for you", text: msg.body, idempotencyKey: `msg-${msg.id}`,
+        }));
+      }
+      const { data: sent, error: sentError } = await client
+        .from("messages")
+        .update({ status: "sent", provider: account.provider, provider_account_id: account.id, provider_message_id: providerMessageId, from_address: account.address, to_address: msg.to_address })
+        .eq("organization_id", msg.organization_id).eq("id", msg.id).select(MESSAGE_COLUMNS).single();
+      fromDb(sentError);
+      return sent as Message;
+    } catch (e) {
+      lastError = e;
+      if (!(e instanceof ProviderSendError && e.retryable)) break;
+    }
+  }
+  const reason = safeSendError(lastError);
+  const { data: failed, error: failError } = await client
+    .from("messages").update({ status: "failed", error: reason }).eq("organization_id", msg.organization_id).eq("id", msg.id)
+    .select(MESSAGE_COLUMNS).single();
+  fromDb(failError);
+  await client.from("activities").insert({
+    organization_id: msg.organization_id, contact_id: msg.contact_id, kind: msg.channel, direction: "outbound",
+    subject: `Message failed: ${reason}`.slice(0, 300), actor_type: "system", metadata: { message_id: msg.id },
+  });
+  return failed as Message;
+}
+
+export type SendOutcome =
+  | { outcome: "sent" | "failed" | "scheduled" | "duplicate"; message: Message; notes: string[] }
+  | { outcome: "blocked"; message: Message; reason: string; code: string; retryAt?: string };
+
+// Sends (or schedules) a message as the signed-in user.
+export async function sendMessage(ctx: CrmContext, input: MessageInput, opts: { aiGenerated?: boolean; req?: Request } = {}): Promise<SendOutcome> {
+  const accounts = await activeAccounts(ctx.client, ctx.orgId, input.channel);
+  if (!accounts.length) {
+    throw new ApiError(`Integration not configured: add ${input.channel === "sms" ? "an SMS number" : "an email sender"} in Channels.`, 503, "integration_not_configured");
+  }
+  if (!vaultReady()) throw new ApiError("Integration not configured: the server's APP_ENCRYPTION_KEY is not set.", 503, "integration_not_configured");
+
+  const now = new Date();
+  const when = input.scheduled_for ? new Date(input.scheduled_for) : null;
+  if (when && when.getTime() < now.getTime() + 60_000) throw new ApiError("Pick a time at least a minute from now.", 422, "invalid");
+  if (when && when.getTime() > now.getTime() + 90 * 86_400_000) throw new ApiError("Messages can be scheduled up to 90 days ahead.", 422, "invalid");
+
+  const purpose: Purpose = input.purpose ?? "conversational";
+  const g = await loadGateContext(ctx.client, ctx.orgId, input.contact_id, input.channel);
+  const result = gate(g, input.channel, purpose, input.body, when ?? now);
+  const conversationId = await ensureConversation(ctx.client, ctx.orgId, input.contact_id, input.channel);
+  const base = {
+    organization_id: ctx.orgId, conversation_id: conversationId, contact_id: input.contact_id, channel: input.channel, direction: "outbound",
+    purpose, subject: input.channel === "email" ? input.subject || `A message from ${g.orgName}` : null, sent_by: ctx.userId,
+    ai_generated: !!opts.aiGenerated, idempotency_key: input.idempotency_key ?? null,
+  };
+
+  const insert = async (row: Record<string, unknown>) => {
+    const { data, error } = await ctx.client.from("messages").insert({ ...base, ...row }).select(MESSAGE_COLUMNS).single();
+    if (error?.code === "23505" && input.idempotency_key) {
+      const prior = await ctx.client.from("messages").select(MESSAGE_COLUMNS).eq("organization_id", ctx.orgId).eq("idempotency_key", input.idempotency_key).single();
+      fromDb(prior.error);
+      return { message: prior.data as Message, duplicate: true };
+    }
+    fromDb(error);
+    return { message: data as Message, duplicate: false };
+  };
+
+  if (!result.ok) {
+    const { message, duplicate } = await insert({ body: input.body, status: "blocked", block_reason: result.reason });
+    if (duplicate) return { outcome: "duplicate", message, notes: [] };
+    await audit(ctx.client, ctx.orgId, "message.blocked", { type: "message", id: message.id }, { code: result.code, channel: input.channel }, opts.aiGenerated ? "ai" : "user");
+    return { outcome: "blocked", message, reason: result.reason, code: result.code, retryAt: result.retryAt?.toISOString() };
+  }
+
+  if (when) {
+    const { message, duplicate } = await insert({ body: result.body, status: "scheduled", scheduled_for: when.toISOString(), to_address: result.to });
+    if (!duplicate) await audit(ctx.client, ctx.orgId, "message.scheduled", { type: "message", id: message.id }, { at: when.toISOString() }, opts.aiGenerated ? "ai" : "user");
+    return { outcome: duplicate ? "duplicate" : "scheduled", message, notes: [...result.notes, "Rules are checked again at send time."] };
+  }
+
+  const { message, duplicate } = await insert({ body: result.body, status: "queued", to_address: result.to });
+  if (duplicate) return { outcome: "duplicate", message, notes: [] };
+  const getSecret: SecretFetcher = async (accountId) => {
+    const { data, error } = await ctx.client.rpc("provider_secret", { p_account: accountId });
+    fromDb(error);
+    return String(data);
+  };
+  const done = (await deliver(ctx.client, message, accounts, getSecret, opts.req)) ?? message;
+  await audit(ctx.client, ctx.orgId, done.status === "sent" ? "message.sent" : "message.failed", { type: "message", id: done.id },
+    { channel: done.channel, provider: done.provider, error: done.error }, opts.aiGenerated ? "ai" : "user");
+  return { outcome: done.status === "sent" ? "sent" : "failed", message: done, notes: result.notes };
+}
+
+// What would happen if this contact were messaged now (for the composer).
+export async function previewSend(ctx: CrmContext, contactId: string, channel: Channel, purpose: Purpose) {
+  const [accounts, g] = await Promise.all([activeAccounts(ctx.client, ctx.orgId, channel), loadGateContext(ctx.client, ctx.orgId, contactId, channel)]);
+  const result = gate(g, channel, purpose, "preview", new Date());
+  return {
+    providerReady: accounts.length > 0 && vaultReady(),
+    from: accounts[0]?.address ?? null,
+    to: normalizeAddress(channel, channel === "sms" ? g.contact.phone : g.contact.email),
+    allowed: result.ok,
+    reason: result.ok ? null : result.reason,
+    code: result.ok ? null : result.code,
+    retryAt: !result.ok && result.retryAt ? result.retryAt.toISOString() : null,
+    consent: g.consent,
+  };
+}
+
+// Scheduled messages (run by the scheduler with the service role). Each one is
+// re-checked against the rules at send time: consent can change after scheduling.
+export async function dispatchDue(system: SupabaseClient, now = new Date(), limit = 25) {
+  const { data, error } = await system.from("messages").select(MESSAGE_COLUMNS).eq("status", "scheduled").lte("scheduled_for", now.toISOString())
+    .order("scheduled_for").limit(limit);
+  fromDb(error);
+  const summary = { sent: 0, failed: 0, blocked: 0, rescheduled: 0, skipped: 0 };
+  for (const row of (data || []) as Message[]) {
+    const { data: claimed } = await system.from("messages").update({ status: "queued" }).eq("id", row.id).eq("organization_id", row.organization_id)
+      .eq("status", "scheduled").select(MESSAGE_COLUMNS).maybeSingle();
+    if (!claimed) { summary.skipped++; continue; }
+    const msg = claimed as Message;
+    try {
+      const g = await loadGateContext(system, msg.organization_id, msg.contact_id, msg.channel);
+      const result = gate(g, msg.channel, msg.purpose, msg.body, now);
+      if (!result.ok) {
+        if (result.code === "quiet_hours" && result.retryAt) {
+          await system.from("messages").update({ status: "scheduled", scheduled_for: result.retryAt.toISOString() }).eq("id", msg.id);
+          summary.rescheduled++;
+        } else {
+          await system.from("messages").update({ status: "blocked", block_reason: result.reason }).eq("id", msg.id);
+          await system.from("activities").insert({ organization_id: msg.organization_id, contact_id: msg.contact_id, kind: msg.channel, direction: "outbound",
+            subject: `Scheduled message not sent: ${result.reason}`.slice(0, 300), actor_type: "system", metadata: { message_id: msg.id } });
+          summary.blocked++;
+        }
+        continue;
+      }
+      const accounts = await activeAccounts(system, msg.organization_id, msg.channel);
+      const getSecret: SecretFetcher = async (accountId) => {
+        const { data: acct, error: e } = await system.from("provider_accounts").select("encrypted_credentials")
+          .eq("organization_id", msg.organization_id).eq("id", accountId).single();
+        fromDb(e);
+        return acct!.encrypted_credentials as string;
+      };
+      const done = accounts.length ? await deliver(system, { ...msg, to_address: result.to, body: result.body }, accounts, getSecret) : null;
+      if (!accounts.length) {
+        await system.from("messages").update({ status: "failed", error: "No active sending account for this channel." }).eq("id", msg.id);
+        summary.failed++;
+      } else if (done?.status === "sent") {
+        summary.sent++;
+        await system.from("conversations").update({ last_message_at: now.toISOString(), last_message_preview: done.body.slice(0, 200), last_direction: "outbound" })
+          .eq("id", done.conversation_id).eq("organization_id", done.organization_id);
+      } else summary.failed++;
+    } catch (e) {
+      console.error("[dispatch] message", msg.id, e);
+      await system.from("messages").update({ status: "failed", error: "Dispatch error." }).eq("id", msg.id).in("status", ["queued", "sending"]);
+      summary.failed++;
+    }
+  }
+  return summary;
+}
+
+// Finds a contact in an organization by phone number regardless of formatting.
+export async function findContactByPhone(client: SupabaseClient, orgId: string, e164: string) {
+  const last4 = e164.slice(-4);
+  const { data, error } = await client.from("contacts").select("id, phone, erased_at, created_at").eq("organization_id", orgId)
+    .is("erased_at", null).ilike("phone", `%${last4.slice(0, 2)}%${last4.slice(2)}`).order("created_at").limit(100);
+  fromDb(error);
+  return (data || []).find((c) => toE164(c.phone) === e164) ?? null;
+}
diff --git a/src/lib/crypto/vault.ts b/src/lib/crypto/vault.ts
new file mode 100644
index 0000000..ac24aed
--- /dev/null
+++ b/src/lib/crypto/vault.ts
@@ -0,0 +1,45 @@
+import "server-only";
+import { createCipheriv, createDecipheriv, createHash, randomBytes } from "crypto";
+
+// Encryption for tenant provider credentials. Uses APP_ENCRYPTION_KEY, which is
+// deliberately separate from the database access secret (SECURITY_PLAN S2).
+// Format: v2.<keyId>.<iv>.<tag>.<ciphertext>; the key id detects a rotated or
+// wrong key instead of failing with an opaque authentication error.
+
+export class VaultError extends Error {}
+
+function material() {
+  const raw = process.env.APP_ENCRYPTION_KEY?.trim();
+  if (!raw || raw.length < 32) return null;
+  const key = createHash("sha256").update(`sun-marketing:vault:v2:${raw}`).digest();
+  const keyId = createHash("sha256").update(key).digest("hex").slice(0, 8);
+  return { key, keyId };
+}
+
+export const vaultReady = () => material() !== null;
+
+export function sealJson(value: Record<string, string>): string {
+  const m = material();
+  if (!m) throw new VaultError("APP_ENCRYPTION_KEY is not set (32+ characters).");
+  const iv = randomBytes(12);
+  const cipher = createCipheriv("aes-256-gcm", m.key, iv);
+  const body = Buffer.concat([cipher.update(JSON.stringify(value), "utf8"), cipher.final()]);
+  return ["v2", m.keyId, iv.toString("base64url"), cipher.getAuthTag().toString("base64url"), body.toString("base64url")].join(".");
+}
+
+export function openJson(sealed: string): Record<string, string> {
+  const m = material();
+  if (!m) throw new VaultError("APP_ENCRYPTION_KEY is not set (32+ characters).");
+  const [version, keyId, iv, tag, body] = sealed.split(".");
+  if (version !== "v2" || !iv || !tag || !body) throw new VaultError("Unsupported credential format.");
+  if (keyId !== m.keyId) throw new VaultError("These credentials were saved with a different APP_ENCRYPTION_KEY. Re-enter them in Channels.");
+  const decipher = createDecipheriv("aes-256-gcm", m.key, Buffer.from(iv, "base64url"));
+  decipher.setAuthTag(Buffer.from(tag, "base64url"));
+  const text = Buffer.concat([decipher.update(Buffer.from(body, "base64url")), decipher.final()]).toString("utf8");
+  return JSON.parse(text);
+}
+
+// Last four characters of the main secret, for display only.
+export function hintFor(secret: string) {
+  return secret.length >= 8 ? `…${secret.slice(-4)}` : "…";
+}
diff --git a/src/lib/supabase/system.ts b/src/lib/supabase/system.ts
new file mode 100644
index 0000000..044e50e
--- /dev/null
+++ b/src/lib/supabase/system.ts
@@ -0,0 +1,27 @@
+import "server-only";
+import { createClient, SupabaseClient } from "@supabase/supabase-js";
+
+// Service-role client for work no signed-in person initiates: verified
+// webhooks and scheduled dispatch. It bypasses RLS, so every query made with
+// it must filter by organization_id explicitly. Never use it for requests a
+// user makes directly.
+let cached: SupabaseClient | null = null;
+
+export function systemClient(): SupabaseClient | null {
+  if (cached) return cached;
+  const url = process.env.SUPABASE_URL;
+  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
+  if (!url || !key) return null;
+  cached = createClient(url, key, { auth: { persistSession: false, autoRefreshToken: false } });
+  return cached;
+}
+
+// Public base URL used for provider callbacks and webhook signature checks.
+export function publicBaseUrl(req?: Request) {
+  const configured = (process.env.PUBLIC_APP_URL || process.env.URL || "").trim().replace(/\/$/, "");
+  if (configured) return configured;
+  if (!req) return null;
+  const host = req.headers.get("x-forwarded-host") || req.headers.get("host");
+  const proto = req.headers.get("x-forwarded-proto") || "https";
+  return host ? `${proto}://${host}` : null;
+}
