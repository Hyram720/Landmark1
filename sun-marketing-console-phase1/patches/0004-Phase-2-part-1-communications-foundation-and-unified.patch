+++ b/src/lib/comms/providers/index.ts
@@ -0,0 +1,21 @@
+import { resend } from "./resend";
+import { telnyx } from "./telnyx";
+import { twilio } from "./twilio";
+import type { EmailAdapter, ProviderId, SmsAdapter } from "./types";
+
+export * from "./types";
+
+export const SMS_ADAPTERS: Record<string, SmsAdapter> = { telnyx, twilio };
+export const EMAIL_ADAPTERS: Record<string, EmailAdapter> = { resend };
+
+export function adapterFor(channel: "sms" | "email", provider: ProviderId) {
+  return channel === "sms" ? SMS_ADAPTERS[provider] : EMAIL_ADAPTERS[provider];
+}
+
+// Field descriptions for the Channels settings form (no secrets involved).
+export function providerCatalog() {
+  const describe = (a: SmsAdapter | EmailAdapter, channel: "sms" | "email") => ({
+    id: a.id, label: a.label, channel, credentialFields: a.credentialFields, configFields: a.configFields,
+  });
+  return [...Object.values(SMS_ADAPTERS).map((a) => describe(a, "sms")), ...Object.values(EMAIL_ADAPTERS).map((a) => describe(a, "email"))];
+}
