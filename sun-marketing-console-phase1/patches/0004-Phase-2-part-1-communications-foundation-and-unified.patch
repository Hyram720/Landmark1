+    for (let i = 0; i < 3; i++) errs.push(await telnyx.send({ apiKey: "K" }, {}, { from: "+1", to: "+2", text: "x" }).catch((e) => e));
+    expect(errs.map((e) => e instanceof ProviderSendError && e.retryable)).toEqual([false, true, true]);
+    expect(errs[0].message).toMatch(/rejected the credentials/);
+  });
