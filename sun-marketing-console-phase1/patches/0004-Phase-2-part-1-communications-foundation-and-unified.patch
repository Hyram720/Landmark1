diff --git a/src/lib/comms/address.ts b/src/lib/comms/address.ts
new file mode 100644
index 0000000..a90bc05
--- /dev/null
+++ b/src/lib/comms/address.ts
@@ -0,0 +1,36 @@
+// Address normalization shared by sending, inbound matching and suppression.
+
+// Normalizes a phone number to E.164. Numbers without a country code are
+// treated as North American (+1), the platform's launch market.
+export function toE164(raw: string | null | undefined): string | null {
+  if (!raw) return null;
+  const text = String(raw).trim();
+  const digits = text.replace(/\D/g, "");
+  if (text.startsWith("+")) return digits.length >= 8 && digits.length <= 15 && digits[0] !== "0" ? `+${digits}` : null;
+  if (digits.length === 10 && /^[2-9]/.test(digits)) return `+1${digits}`;
+  if (digits.length === 11 && digits.startsWith("1") && /^[2-9]/.test(digits[1])) return `+${digits}`;
+  return null;
+}
+
+export function normalizeEmail(raw: string | null | undefined): string | null {
+  const value = String(raw ?? "").trim().toLowerCase();
+  return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value) && value.length <= 254 ? value : null;
+}
+
+export type Channel = "sms" | "email";
+
+export function normalizeAddress(channel: Channel, raw: string | null | undefined) {
+  return channel === "sms" ? toE164(raw) : normalizeEmail(raw);
+}
+
+// Carrier-standard opt-out / opt-in keywords (CTIA). Matched on the whole message.
+const STOP = /^\s*(stop|stopall|unsubscribe|cancel|end|quit|revoke|optout|opt out)\s*[.!]*\s*$/i;
+const START = /^\s*(start|unstop|subscribe|yes)\s*[.!]*\s*$/i;
+const HELP = /^\s*(help|info)\s*[.!?]*\s*$/i;
+
+export function keywordOf(text: string): "stop" | "start" | "help" | null {
+  if (STOP.test(text)) return "stop";
+  if (START.test(text)) return "start";
+  if (HELP.test(text)) return "help";
+  return null;
+}
diff --git a/src/lib/comms/compliance.ts b/src/lib/comms/compliance.ts
new file mode 100644
index 0000000..4780349
--- /dev/null
+++ b/src/lib/comms/compliance.ts
@@ -0,0 +1,112 @@
+import { normalizeAddress, type Channel } from "./address";
+
+// The compliance gate. Every outbound message, from a person, the AI operator
+// or the scheduler, is checked here immediately before it is sent. It is a
+// pure function so the rules are easy to read, test and audit.
+//
+// Rules (conservative by design; see SECURITY_PLAN §4):
+//  - erased, do-not-contact, missing/invalid address, or a suppressed address: never send
+//  - revoked consent on the channel: never send
+//  - SMS marketing needs recorded consent; other SMS needs consent or a text
+//    from the person in the last 24 hours (a reply in an ongoing conversation)
+//  - email conversations are allowed unless revoked; marketing email belongs
+//    in Email Marketing, which adds the unsubscribe link and mailing address
+//  - SMS respects quiet hours in the business's time zone, except for a reply
+//    within an hour of the person's own message
+//  - marketing SMS always carries opt-out instructions
+
+export type Purpose = "conversational" | "marketing" | "transactional";
+
+export type GateInput = {
+  channel: Channel;
+  purpose: Purpose;
+  body: string;
+  contact: { phone: string | null; email: string | null; doNotContact: boolean; erased: boolean };
+  consent: "granted" | "revoked" | null;
+  suppressed: boolean;
+  lastInboundAt: Date | null;
+  now: Date;
+  timezone: string;
+  quietHours: { start: number; end: number }; // allowed window [start, end) in local hours
+};
+
+export type GateCode =
+  | "erased" | "do_not_contact" | "no_address" | "opted_out" | "consent_revoked"
+  | "no_consent" | "marketing_email" | "quiet_hours" | "too_long" | "empty";
+
+export type GateResult =
+  | { ok: true; to: string; body: string; notes: string[] }
+  | { ok: false; code: GateCode; reason: string; retryAt?: Date };
+
+export const DEFAULT_QUIET_HOURS = { start: 8, end: 21 };
+const SMS_MAX = 1600;
+const OPT_OUT_TEXT = "Reply STOP to opt out.";
+
+export function localHour(now: Date, timezone: string) {
+  try {
+    const parts = new Intl.DateTimeFormat("en-US", { timeZone: timezone, hour: "numeric", hourCycle: "h23" }).formatToParts(now);
+    return Number(parts.find((p) => p.type === "hour")?.value ?? now.getUTCHours());
+  } catch {
+    return now.getUTCHours();
+  }
+}
+
+// Next moment the local clock reaches `hour`, searched in 15-minute steps (DST-safe).
+function nextLocalHour(now: Date, timezone: string, hour: number) {
+  const t = new Date(now);
+  t.setUTCMinutes(Math.ceil(t.getUTCMinutes() / 15) * 15, 0, 0);
+  for (let i = 0; i < 4 * 48; i++) {
+    if (localHour(t, timezone) === hour) return t;
+    t.setUTCMinutes(t.getUTCMinutes() + 15);
+  }
+  return t;
+}
+
+export function evaluateSend(input: GateInput): GateResult {
+  const body = input.body.trim();
+  if (!body) return { ok: false, code: "empty", reason: "Write a message first." };
+  if (input.contact.erased) return { ok: false, code: "erased", reason: "This contact's data was erased." };
+  if (input.contact.doNotContact) return { ok: false, code: "do_not_contact", reason: "This contact is marked do-not-contact." };
+
+  const to = normalizeAddress(input.channel, input.channel === "sms" ? input.contact.phone : input.contact.email);
+  if (!to) {
+    return { ok: false, code: "no_address", reason: input.channel === "sms" ? "This contact has no valid mobile number." : "This contact has no valid email address." };
+  }
+  if (input.suppressed) return { ok: false, code: "opted_out", reason: `This ${input.channel === "sms" ? "number" : "address"} opted out. Only the person can opt back in (for SMS, by texting START).` };
+  if (input.consent === "revoked") return { ok: false, code: "consent_revoked", reason: `${input.channel === "sms" ? "SMS" : "Email"} consent was withdrawn.` };
+
+  const sinceInbound = input.lastInboundAt ? input.now.getTime() - input.lastInboundAt.getTime() : Infinity;
+  const notes: string[] = [];
+  let finalBody = body;
+
+  if (input.channel === "email" && input.purpose === "marketing") {
+    return { ok: false, code: "marketing_email", reason: "Send marketing email from Email Marketing, which adds the unsubscribe link and mailing address the law requires." };
+  }
+
+  if (input.channel === "sms") {
+    if (input.purpose === "marketing" && input.consent !== "granted") {
+      return { ok: false, code: "no_consent", reason: "Marketing texts need recorded SMS consent from this person." };
+    }
+    if (input.purpose !== "marketing" && input.consent !== "granted" && sinceInbound > 24 * 3600e3) {
+      return { ok: false, code: "no_consent", reason: "No SMS consent is recorded and they haven't texted you in the last 24 hours. Record their consent first." };
+    }
+    if (input.consent !== "granted") notes.push("Sent as a reply to their recent text.");
+    if (finalBody.length > SMS_MAX) return { ok: false, code: "too_long", reason: `Texts are limited to ${SMS_MAX} characters.` };
+
+    const replying = sinceInbound <= 3600e3;
+    const hour = localHour(input.now, input.timezone);
+    const { start, end } = input.quietHours;
+    const allowed = start <= end ? hour >= start && hour < end : hour >= start || hour < end;
+    if (!allowed && !replying) {
+      const retryAt = nextLocalHour(input.now, input.timezone, start);
+      return { ok: false, code: "quiet_hours", reason: `Quiet hours: texts go out between ${start}:00 and ${end}:00 (${input.timezone}). Schedule it instead.`, retryAt };
+    }
+    if (input.purpose === "marketing" && !/\bstop\b/i.test(finalBody)) {
+      finalBody = `${finalBody}\n${OPT_OUT_TEXT}`;
+      if (finalBody.length > SMS_MAX) return { ok: false, code: "too_long", reason: `Texts are limited to ${SMS_MAX} characters including opt-out instructions.` };
+      notes.push("Opt-out instructions added.");
+    }
+  }
+
+  return { ok: true, to, body: finalBody, notes };
+}
diff --git a/src/lib/comms/inbound.ts b/src/lib/comms/inbound.ts
