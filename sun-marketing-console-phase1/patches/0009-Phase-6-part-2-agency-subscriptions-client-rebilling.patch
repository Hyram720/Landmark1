+        <div className="field"><label htmlFor="nc-owner">Client owner&apos;s email (invite)</label><input id="nc-owner" className="input" type="email" maxLength={254} placeholder="optional" value={f.owner} onChange={(e) => set("owner", e.target.value)} /></div>
+      </div>
+      <label className="row small" style={{ gap: 6 }}><input type="checkbox" checked={f.website} onChange={(e) => set("website", e.target.checked)} /> Draft a website from the industry template (not published)</label>
+      <div><button className="btn btn-primary" disabled={f.name.trim().length < 2}>Set up account</button></div>
+    </form>
