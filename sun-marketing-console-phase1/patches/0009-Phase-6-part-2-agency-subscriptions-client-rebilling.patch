@@ -0,0 +1,30 @@
+import { z } from "zod";
+import { ApiError, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { billingInput, invoiceAllClients, invoiceClientMonth, listClientBilling, periodInput, previousMonth, saveClientBilling } from "@/lib/billing/rebilling";
+
+export const dynamic = "force-dynamic";
+
+function agencyOnly(kind: string) {
+  if (kind !== "agency") throw new ApiError("Client billing is for agencies.", 403, "forbidden");
+}
+
+export const GET = tenantRoute("org.manage", async (ctx) => {
+  agencyOnly(ctx.org.kind);
+  return { ...(await listClientBilling(ctx.client, ctx.org.id)), last_month: previousMonth() };
+});
+
+export const PUT = tenantRoute("org.manage", async (ctx, req) => {
+  agencyOnly(ctx.org.kind);
+  const { client_org_id, ...rest } = await readJson(req, billingInput.extend({ client_org_id: uuid }));
+  await saveClientBilling(ctx.client, ctx.org.id, client_org_id, billingInput.parse(rest));
+  return { ok: true };
+});
+
+// Drafts invoices for a finished month: one client, or every billed client.
+export const POST = tenantRoute("org.manage", async (ctx, req) => {
+  agencyOnly(ctx.org.kind);
+  const input = await readJson(req, z.object({ period: periodInput, client_org_id: uuid.optional() }));
+  const actor = { client: ctx.client, system: false };
+  if (input.client_org_id) return { results: [{ client_org_id: input.client_org_id, status: (await invoiceClientMonth(actor, ctx.org.id, input.client_org_id, input.period)).status }] };
+  return { results: await invoiceAllClients(actor, ctx.org.id, input.period) };
+});
