+}
+
+function ClientBilling({ clients, toast }: { clients: Client[]; toast: (m: string) => void }) {
+  const { data, error, reload } = useResource<Runs>("/api/billing/clients");
+  const [edit, setEdit] = useState<string | null>(null);
+  const [form, setForm] = useState<{ contact: PickedContact | null; fee: string; rates: Record<string, string>; tax: string; auto: boolean }>({ contact: null, fee: "", rates: {}, tax: "0", auto: false });
+  const [busy, setBusy] = useState(false);
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return <Loading />;
+  const byClient = new Map(data.billing.map((b) => [b.client_org_id, b]));
+  const open = (c: Client) => {
+    const b = byClient.get(c.id);
+    setEdit(c.id);
+    setForm({ contact: b ? { id: b.contact_id, first_name: b.contacts?.first_name ?? null, last_name: b.contacts?.last_name ?? null, email: b.contacts?.email ?? null, phone: null } : null, fee: b?.plan_fee_cents != null ? (b.plan_fee_cents / 100).toFixed(2) : "",
+      rates: Object.fromEntries(Object.entries(b?.rates || {}).map(([k, v]) => [k, String(v)])), tax: String((b?.tax_rate_bp ?? 0) / 100), auto: !!b?.auto_invoice });
+  };
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>Bill your clients</h3><div className="sub">A monthly plan fee plus usage at your rates. Each month becomes a draft invoice in <a className="link" href="/invoices">Invoices</a> that you review and send.</div></div>
+        {data.billing.some((b) => b.active) && <button className="btn btn-sm btn-primary" disabled={busy} onClick={async () => {
+          setBusy(true);
+          try { const r = await api<{ results: { status: string }[] }>("/api/billing/clients", { body: { period: data.last_month } }); const n = r.results.filter((x) => x.status === "created").length; toast(n ? `${n} draft invoice${n === 1 ? "" : "s"} created for ${month(data.last_month)}.` : `Nothing new to invoice for ${month(data.last_month)}.`); reload(); }
+          catch (e) { toast(e instanceof Error ? e.message : "Failed."); } finally { setBusy(false); }
+        }}>{busy ? <span className="spin" /> : `Invoice ${month(data.last_month)}`}</button>}
+      </div>
+      {clients.length === 0 ? <div className="empty"><h3>No client accounts yet</h3></div> : <div className="table-wrap"><table><thead><tr><th>Client</th><th>Bill to</th><th>Plan fee</th><th>Usage rates</th><th>Last invoiced</th><th /></tr></thead><tbody>
+        {clients.map((c) => { const b = byClient.get(c.id); const last = data.runs.find((r) => r.client_org_id === c.id); return (
+          <tr key={c.id}>
+            <td className="small"><strong>{c.name}</strong>{b && !b.active ? <div className="tiny muted">paused</div> : null}{b?.auto_invoice ? <div className="tiny muted">automatic monthly</div> : null}</td>
+            <td className="small">{b ? personName(b.contacts) : <span className="muted">Not billed</span>}</td>
+            <td className="small">{b ? (b.plan_fee_cents != null ? usd(b.plan_fee_cents) : "Plan price") : "—"}</td>
+            <td className="tiny">{b ? Object.entries(b.rates).filter(([, v]) => v > 0).map(([k, v]) => `${k.replace("_", " ")} ${v}¢`).join(", ") || "—" : "—"}</td>
+            <td className="tiny muted">{last ? `${month(last.period_start)} · ${relativeTime(last.created_at)}` : "—"}</td>
+            <td><button className="btn btn-sm" onClick={() => open(c)}>{b ? "Edit" : "Set up"}</button></td>
+          </tr>
+        ); })}
+      </tbody></table></div>}
+      {edit && <div className="card-pad stack" style={{ borderTop: "1px solid var(--line)" }}>
+        <strong className="small">Billing for {clients.find((c) => c.id === edit)?.name}</strong>
+        <div className="field"><label htmlFor="cb-contact">Send invoices to (a contact in your agency&apos;s CRM)</label><ContactPicker id="cb-contact" value={form.contact} onChange={(contact) => setForm({ ...form, contact })} /></div>
+        <div className="field-grid">
+          <div className="field"><label htmlFor="cb-fee">Monthly fee ($, blank = plan price)</label><input id="cb-fee" className="input" inputMode="decimal" value={form.fee} onChange={(e) => setForm({ ...form, fee: e.target.value })} /></div>
+          {RATES.map(([k, label]) => <div key={k} className="field"><label htmlFor={`cb-${k}`}>{label}</label><input id={`cb-${k}`} className="input" inputMode="decimal" placeholder="0" value={form.rates[k] ?? ""} onChange={(e) => setForm({ ...form, rates: { ...form.rates, [k]: e.target.value } })} /></div>)}
+          <div className="field"><label htmlFor="cb-tax">Tax rate (%)</label><input id="cb-tax" className="input" inputMode="decimal" value={form.tax} onChange={(e) => setForm({ ...form, tax: e.target.value })} /></div>
+        </div>
+        <label className="row small" style={{ gap: 6 }}><input type="checkbox" checked={form.auto} onChange={(e) => setForm({ ...form, auto: e.target.checked })} /> Draft the invoice automatically at the start of each month</label>
+        <div className="row"><button className="btn btn-primary btn-sm" disabled={!form.contact} onClick={async () => {
