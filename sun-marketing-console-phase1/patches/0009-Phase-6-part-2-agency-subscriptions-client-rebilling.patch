+            toast("Billing saved."); setEdit(null); reload();
+          } catch (e) { toast(e instanceof Error ? e.message : "Could not save."); }
+        }}>Save</button><button className="btn btn-sm btn-ghost" onClick={() => setEdit(null)}>Cancel</button></div>
+      </div>}
+    </div>
+  );
+}
+
+type Domain = { id: string; domain: string; verification_token: string; status: string; last_checked_at: string | null };
+function ConsoleDomain({ toast }: { toast: (m: string) => void }) {
+  const { data, reload } = useResource<{ domains: Domain[] }>("/api/organization/domains");
+  const [domain, setDomain] = useState("");
+  const [host, setHost] = useState("");
+  useEffect(() => setHost(window.location.host), []);
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>Your own console address</h3><div className="sub">Your team and clients sign in at your domain (like app.youragency.com) and see your name, logo and color from <a className="link" href="/account">Branding</a>.</div></div></div>
+      <div className="card-pad stack">
+        {(data?.domains || []).map((d) => (
+          <div key={d.id} className="stack" style={{ gap: 6 }}>
+            <div className="row" style={{ justifyContent: "space-between", flexWrap: "wrap" }}>
+              <span><strong>{d.domain}</strong> <span className={`pill ${d.status === "verified" ? "pill-ok" : "pill-warn"}`}>{d.status === "verified" ? "verified" : "waiting for DNS"}</span></span>
+              <span className="row" style={{ gap: 6 }}>
+                {d.status !== "verified" && <button className="btn btn-sm btn-primary" onClick={async () => { try { const r = await api<{ message: string }>(`/api/organization/domains/${d.id}`, { body: { action: "verify" } }); toast(r.message); reload(); } catch (e) { toast(e instanceof Error ? e.message : "Check failed."); } }}>Verify</button>}
+                <button className="btn btn-sm btn-ghost" onClick={async () => { if (!window.confirm(`Disconnect ${d.domain}?`)) return; try { await api(`/api/organization/domains/${d.id}`, { method: "DELETE" }); reload(); } catch (e) { toast(e instanceof Error ? e.message : "Failed."); } }}>Remove</button>
+              </span>
+            </div>
+            <ol className="small" style={{ margin: 0, paddingLeft: 18, overflowWrap: "anywhere" }}>
+              <li>Add a <strong>TXT</strong> record <span className="mono">_sun-verify.{d.domain}</span> with value <span className="mono">{d.verification_token}</span> <Copy text={d.verification_token} />, then press Verify.</li>
+              <li>Add a <strong>CNAME</strong> from <span className="mono">{d.domain}</span> to <span className="mono">{host || "the console address"}</span>.</li>
+              <li>HTTPS is set up automatically when hosting automation is configured; otherwise your platform administrator adds the domain alias.</li>
+            </ol>
+          </div>
+        ))}
+        <div className="row"><label className="sr-only" htmlFor="cd">Domain</label><input id="cd" className="input" placeholder="app.youragency.com" value={domain} onChange={(e) => setDomain(e.target.value)} style={{ maxWidth: 260 }} />
+          <button className="btn btn-sm" disabled={!domain.trim()} onClick={async () => { try { await api("/api/organization/domains", { body: { domain } }); setDomain(""); reload(); } catch (e) { toast(e instanceof Error ? e.message : "Could not add."); } }}>Add domain</button></div>
+      </div>
+    </div>
+  );
+}
+
+function Agency({ org, staff }: { org: Org; staff: boolean }) {
+  const { data, error, loading, reload } = useResource<{ agency: { clients: Client[] } | null }>("/api/billing");
+  const { toast, node } = useToast();
+  if (org.kind !== "agency") return <div className="card card-pad small muted">This page is for agencies. Client accounts manage their plan in <a className="link" href="/account">Plan &amp; account</a>.</div>;
+  if (!atLeast(org.role, "admin")) return <div className="card card-pad small muted">Agency billing and settings are for admins.</div>;
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  const clients = data?.agency?.clients || [];
+  return (
+    <div className="stack">
+      <Subscription org={org} staff={staff} toast={toast} />
+      <ClientBilling clients={clients} toast={toast} />
+      <div className="split">
+        <ConsoleDomain toast={toast} />
+        <Transfers org={org} clients={clients} toast={toast} />
+      </div>
+      {node}
+    </div>
+  );
+}
+
+export default function AgencyPage() {
+  return <TenantGate title="Agency" subtitle="Your subscription, client billing, your own console address and account transfers.">{(info) => <Agency org={info.org} staff={info.isPlatformStaff} />}</TenantGate>;
+}
diff --git a/src/app/api/billing/clients/route.ts b/src/app/api/billing/clients/route.ts
