diff --git a/src/app/organization/new-client/page.tsx b/src/app/organization/new-client/page.tsx
new file mode 100644
index 0000000..857be93
--- /dev/null
+++ b/src/app/organization/new-client/page.tsx
@@ -0,0 +1,99 @@
+"use client";
+import { useEffect, useState } from "react";
+import TenantGate, { Loading } from "@/components/tenant/TenantGate";
+import { api, atLeast, Org, useResource } from "@/components/tenant/client";
+
+type Plan = { key: string; name: string; price_cents: number };
+type Step = { label: string; state: "waiting" | "running" | "done" | "skipped" | "failed"; note?: string };
+const ZONES = ["America/New_York", "America/Chicago", "America/Denver", "America/Phoenix", "America/Los_Angeles", "America/Anchorage", "Pacific/Honolulu"];
+const usd = (c: number) => (c / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
+const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 50);
+
+// Sets up a new client account in one pass: the account, its time zone,
+// approved business facts, plan, a draft website and the owner's invitation.
+function Wizard({ org }: { org: Org }) {
+  const billing = useResource<{ agency: { plans: Plan[] } | null }>("/api/billing");
+  const sites = useResource<{ industries: { key: string; label: string }[] }>("/api/sites");
+  const [f, setF] = useState({ name: "", industry: "general", city: "", phone: "", email: "", timezone: "America/New_York", hours: "", services: "", plan: "", website: true, owner: "" });
+  const [steps, setSteps] = useState<Step[] | null>(null);
+  const [newOrg, setNewOrg] = useState<string | null>(null);
+  const [inviteLink, setInviteLink] = useState<string | null>(null);
+  useEffect(() => { try { setF((x) => ({ ...x, timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || x.timezone })); } catch { /* keep default */ } }, []);
+  if (org.kind !== "agency" || !atLeast(org.role, "admin")) return <div className="card card-pad small muted">Switch to your agency (as an admin) to set up client accounts.</div>;
+  if (billing.loading || sites.loading) return <Loading />;
+  const plans = billing.data?.agency?.plans || [];
+  const set = (k: keyof typeof f, v: string | boolean) => setF({ ...f, [k]: v });
+  const run = async () => {
+    const list: Step[] = [
+      { label: "Create the account", state: "waiting" }, { label: "Set the time zone", state: "waiting" }, { label: "Save business facts", state: "waiting" },
+      { label: "Assign the plan", state: "waiting" }, { label: "Draft the website", state: "waiting" }, { label: "Invite the owner", state: "waiting" },
+    ];
+    const upd = (i: number, state: Step["state"], note?: string) => { list[i] = { ...list[i], state, note }; setSteps([...list]); };
+    setSteps([...list]);
+    let id: string;
+    try { upd(0, "running"); id = (await api<{ orgId: string }>("/api/tenant", { body: { action: "create", kind: "client", name: f.name.trim(), parentId: org.id } })).orgId; setNewOrg(id); upd(0, "done"); }
+    catch (e) { upd(0, "failed", e instanceof Error ? e.message : "Failed."); return; }
+    // The new account is now the active one; the remaining steps act inside it.
+    const attempt = async (i: number, skip: boolean, fn: () => Promise<string | void>) => {
+      if (skip) return upd(i, "skipped");
+      upd(i, "running");
+      try { upd(i, "done", (await fn()) || undefined); } catch (e) { upd(i, "failed", e instanceof Error ? e.message : "Failed."); }
+    };
+    await attempt(1, false, async () => { await api("/api/channels/settings", { method: "PUT", body: { timezone: f.timezone, quiet_start: 8, quiet_end: 21 } }); });
+    await attempt(2, !f.hours.trim() && !f.services.trim(), async () => {
+      if (f.hours.trim()) await api("/api/knowledge", { body: { kind: "hours", title: "Business hours", body: f.hours.trim(), status: "approved" } });
+      for (const s of f.services.split("\n").map((x) => x.trim()).filter(Boolean).slice(0, 12)) await api("/api/knowledge", { body: { kind: "service", title: s.slice(0, 200), body: s, status: "approved" } });
+    });
+    await attempt(3, !f.plan, async () => { await api("/api/billing/govern", { body: { org_id: id, plan: f.plan } }); });
+    await attempt(4, !f.website, async () => {
+      const slug = `${slugify(f.name) || "site"}-${Math.random().toString(36).slice(2, 6)}`;
+      await api("/api/sites", { body: { name: f.name.trim(), slug, industry: f.industry, business_name: f.name.trim(), phone: f.phone.trim() || undefined, email: f.email.trim() || undefined, location: f.city.trim() || undefined, hours: f.hours.trim().slice(0, 300) || undefined } });
+      return "Draft only; publish it when the client approves.";
+    });
+    await attempt(5, !f.owner.trim(), async () => {
+      const r = await api<{ link: string; delivery: { sent: boolean; reason: string | null } }>("/api/tenant/invitations", { body: { email: f.owner.trim(), role: "owner" } });
+      if (!r.delivery.sent) { setInviteLink(r.link); return `Email not sent (${r.delivery.reason}). Copy the link below.`; }
+      return `Emailed to ${f.owner.trim()}.`;
+    });
+  };
+  if (steps) return (
+    <div className="card card-pad stack" style={{ maxWidth: 640 }}>
+      <h3>Setting up {f.name}</h3>
+      {steps.map((s, i) => <div key={i} className="row small" style={{ gap: 8, alignItems: "flex-start" }}>
+        <span className={`pill ${s.state === "done" ? "pill-ok" : s.state === "failed" ? "pill-bad" : "pill-neutral"}`} style={{ minWidth: 70, textAlign: "center" }}>{s.state === "running" ? "working…" : s.state}</span>
+        <span>{s.label}{s.note ? <div className="tiny muted">{s.note}</div> : null}</span>
+      </div>)}
+      {inviteLink && <div className="notice small" style={{ overflowWrap: "anywhere" }}>Owner invitation link (share only with them): <span className="mono">{inviteLink}</span></div>}
+      {newOrg && steps.every((s) => s.state !== "running" && s.state !== "waiting") && <div className="row" style={{ flexWrap: "wrap" }}>
+        <a className="btn btn-primary" href="/command-center">Open {f.name}</a><a className="btn" href="/sites">Review the website</a><a className="btn btn-ghost" href="/organization">Back to agency</a>
+      </div>}
+      {steps.some((s) => s.state === "failed") && newOrg && <p className="small muted">Anything that failed can be finished from the account&apos;s own pages.</p>}
+    </div>
+  );
+  return (
+    <form className="card card-pad stack" style={{ maxWidth: 720 }} onSubmit={(e) => { e.preventDefault(); run(); }}>
+      <h3>New client account</h3>
+      <div className="field-grid">
+        <div className="field"><label htmlFor="nc-name">Business name</label><input id="nc-name" className="input" required minLength={2} maxLength={120} value={f.name} onChange={(e) => set("name", e.target.value)} /></div>
+        <div className="field"><label htmlFor="nc-ind">Industry</label><select id="nc-ind" className="select" value={f.industry} onChange={(e) => set("industry", e.target.value)}>{(sites.data?.industries || [{ key: "general", label: "Other local business" }]).map((i) => <option key={i.key} value={i.key}>{i.label}</option>)}</select></div>
+        <div className="field"><label htmlFor="nc-city">City / service area</label><input id="nc-city" className="input" maxLength={120} value={f.city} onChange={(e) => set("city", e.target.value)} /></div>
+        <div className="field"><label htmlFor="nc-tz">Time zone</label><select id="nc-tz" className="select" value={f.timezone} onChange={(e) => set("timezone", e.target.value)}>{Array.from(new Set([f.timezone, ...ZONES])).map((z) => <option key={z} value={z}>{z.replace("_", " ")}</option>)}</select></div>
+        <div className="field"><label htmlFor="nc-phone">Business phone</label><input id="nc-phone" className="input" maxLength={40} value={f.phone} onChange={(e) => set("phone", e.target.value)} /></div>
+        <div className="field"><label htmlFor="nc-email">Business email</label><input id="nc-email" className="input" type="email" maxLength={254} value={f.email} onChange={(e) => set("email", e.target.value)} /></div>
+      </div>
