+              {owner && !live && <button className="btn btn-sm btn-primary" disabled={!p.purchasable || !data.configured} onClick={() => go({ action: "subscribe", plan: p.key })}>{p.purchasable ? "Subscribe" : "Not available yet"}</button>}
+              {staff && <div className="row" style={{ gap: 6 }}><label className="sr-only" htmlFor={`pp-${p.key}`}>Stripe price for {p.name}</label><input id={`pp-${p.key}`} className="input" placeholder="price_…" value={prices[p.key] ?? p.stripe_price_id ?? ""} onChange={(e) => setPrices({ ...prices, [p.key]: e.target.value })} />
+                <button className="btn btn-sm" onClick={async () => { try { await api("/api/billing/platform-plans", { method: "PUT", body: { key: p.key, stripe_price_id: (prices[p.key] ?? p.stripe_price_id ?? "").trim() || null } }); toast("Price linked."); reload(); } catch (e) { toast(e instanceof Error ? e.message : "Failed."); } }}>Save</button></div>}
+            </div>
+          ))}
+        </div>
+        {owner && s && <div><button className="btn btn-sm" onClick={() => go({ action: "portal" })}>Manage billing and invoices</button></div>}
+        {!owner && <p className="small muted">Only owners change the subscription.</p>}
+      </div>
