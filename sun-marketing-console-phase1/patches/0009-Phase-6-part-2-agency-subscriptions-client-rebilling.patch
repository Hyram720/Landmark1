+++ b/src/app/api/tenant/invitations/accept/route.ts
@@ -0,0 +1,23 @@
+import { NextResponse } from "next/server";
+import { z } from "zod";
+import { ApiError, assertSameOrigin, errorResponse, readJson } from "@/lib/tenant/api";
+import { getUserSession, ORG_COOKIE, userClient } from "@/lib/tenant/session";
+import { acceptAs } from "@/lib/tenant/invitations";
+
+export const dynamic = "force-dynamic";
+
+// A signed-in person accepts an invitation sent to their email address.
+export async function POST(req: Request) {
+  try {
+    assertSameOrigin(req);
+    const session = await getUserSession();
+    if (!session) throw new ApiError("Sign in first.", 401, "unauthenticated");
+    const { token } = await readJson(req, z.object({ token: z.string().max(100) }));
+    const orgId = await acceptAs(userClient(session.accessToken), token);
+    const res = NextResponse.json({ ok: true, orgId });
+    res.cookies.set(ORG_COOKIE, orgId, { httpOnly: true, sameSite: "lax", secure: process.env.NODE_ENV === "production", path: "/", maxAge: 60 * 60 * 24 * 180 });
+    return res;
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
