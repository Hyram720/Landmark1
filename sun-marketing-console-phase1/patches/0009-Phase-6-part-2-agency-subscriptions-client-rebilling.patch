+import { z } from "zod";
+import { ApiError, readJson, tenantRoute } from "@/lib/tenant/api";
+import { publicBaseUrl, systemClient } from "@/lib/supabase/system";
+import { agencyPlans, platformBillingStatus, portalUrl, startSubscription, subscriptionFor } from "@/lib/billing/platform";
+
+export const dynamic = "force-dynamic";
+
+// The agency's own subscription to the platform.
+export const GET = tenantRoute("org.read", async (ctx) => {
+  if (ctx.org.kind !== "agency") return { applicable: false };
+  const [subscription, plans] = await Promise.all([subscriptionFor(ctx.client, ctx.org.id), agencyPlans(ctx.client)]);
+  return { applicable: true, ...platformBillingStatus(), subscription, plans: plans.map((p) => ({ ...p, purchasable: !!p.stripe_price_id })) };
+});
+
+export const POST = tenantRoute("org.manage", async (ctx, req) => {
+  const input = await readJson(req, z.discriminatedUnion("action", [
+    z.object({ action: z.literal("subscribe"), plan: z.string().max(41) }),
+    z.object({ action: z.literal("portal") }),
+  ]));
+  const base = publicBaseUrl(req);
+  if (!base) throw new ApiError("Integration not configured: set PUBLIC_APP_URL.", 503, "integration_not_configured");
+  if (ctx.org.role !== "owner") throw new ApiError("Only owners manage the subscription.", 403, "forbidden");
+  if (input.action === "portal") return portalUrl(systemClient(), ctx.org.id, base);
+  return startSubscription(systemClient(), ctx.org, ctx.session.user.email, input.plan, base);
+});
