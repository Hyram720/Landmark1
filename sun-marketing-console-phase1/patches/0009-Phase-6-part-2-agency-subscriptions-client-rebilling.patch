@@ -0,0 +1,59 @@
+"use client";
+import { useState } from "react";
+import { api, atLeast, Org, relativeTime, useResource } from "./client";
+
+type Transfer = { id: string; organization_id: string; organization_name: string; from_name: string; to_name: string; from_agency_id: string; to_agency_id: string; status: string; client_approved_at: string | null; agency_accepted_at: string | null; note: string | null; created_at: string };
+
+// Moving a client account to another agency. Needs the receiving agency's
+// acceptance and the client owner's consent; the database checks every step.
+export default function Transfers({ org, clients, toast }: { org: Org; clients?: { id: string; name: string }[]; toast: (m: string) => void }) {
+  const { data, reload } = useResource<{ transfers: Transfer[]; account_id: string | null }>("/api/organization/transfers");
+  const [target, setTarget] = useState("");
+  const [orgId, setOrgId] = useState(org.kind === "client" ? org.id : "");
+  const [note, setNote] = useState("");
+  const decide = async (id: string, decision: string, done: string) => { try { const r = await api<{ status: string }>(`/api/organization/transfers/${id}`, { body: { decision } }); toast(r.status === "completed" ? "Transfer completed." : done); reload(); } catch (e) { toast(e instanceof Error ? e.message : "That did not work."); } };
+  const canStart = org.kind === "client" ? org.role === "owner" : atLeast(org.role, "admin");
+  const pending = (data?.transfers || []).filter((t) => t.status === "pending");
+  const past = (data?.transfers || []).filter((t) => t.status !== "pending").slice(0, 5);
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>Account transfers</h3><div className="sub">Move a client account to another agency. The receiving agency accepts, and the client&apos;s owner consents.</div></div></div>
+      <div className="card-pad stack">
+        {data?.account_id && <div className="small">Your agency account ID (give it to an agency transferring a client to you): <span className="mono">{data.account_id}</span></div>}
+        {pending.map((t) => {
+          const incoming = t.to_agency_id === org.id;
+          return (
+            <div key={t.id} className="stack" style={{ gap: 6, border: "1px solid var(--line)", borderRadius: 8, padding: 10 }}>
+              <div className="small"><strong>{t.organization_name}</strong>: {t.from_name} → {t.to_name} · {relativeTime(t.created_at)}{t.note ? ` · “${t.note}”` : ""}</div>
+              <div className="tiny muted">Client consent: {t.client_approved_at ? "given" : "waiting"} · Receiving agency: {t.agency_accepted_at ? "accepted" : "waiting"}</div>
+              <div className="row" style={{ gap: 6, flexWrap: "wrap" }}>
+                {incoming && !t.agency_accepted_at && <button className="btn btn-sm btn-primary" onClick={() => decide(t.id, "accept", "Accepted. Waiting for the client's consent.")}>Accept client</button>}
+                {org.kind === "client" && org.role === "owner" && !t.client_approved_at && <button className="btn btn-sm btn-primary" onClick={() => { if (window.confirm(`Move ${t.organization_name} to ${t.to_name}? They will manage your account and see its data.`)) decide(t.id, "approve", "Consent given."); }}>Consent to move</button>}
+                {(incoming || org.kind === "client") && <button className="btn btn-sm" onClick={() => decide(t.id, "decline", "Declined.")}>Decline</button>}
+                {!incoming && <button className="btn btn-sm btn-ghost" onClick={() => decide(t.id, "cancel", "Cancelled.")}>Cancel request</button>}
+              </div>
+            </div>
+          );
+        })}
+        {canStart && (org.kind === "client" || (clients && clients.length > 0)) && (
+          <div className="stack" style={{ gap: 6 }}>
+            <strong className="small">Start a transfer</strong>
+            <div className="row" style={{ flexWrap: "wrap" }}>
+              {org.kind === "agency" && <><label className="sr-only" htmlFor="tr-org">Client account</label><select id="tr-org" className="select" style={{ maxWidth: 220 }} value={orgId} onChange={(e) => setOrgId(e.target.value)}><option value="">Choose a client…</option>{clients!.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}</select></>}
+              <label className="sr-only" htmlFor="tr-to">Receiving agency account ID</label>
+              <input id="tr-to" className="input" style={{ maxWidth: 240 }} placeholder="Receiving agency's account ID" value={target} onChange={(e) => setTarget(e.target.value)} />
+              <label className="sr-only" htmlFor="tr-note">Note</label>
+              <input id="tr-note" className="input" style={{ maxWidth: 220 }} placeholder="Note (optional)" value={note} maxLength={500} onChange={(e) => setNote(e.target.value)} />
+              <button className="btn btn-sm" disabled={!orgId || target.trim().length < 3} onClick={async () => {
+                try { await api("/api/organization/transfers", { body: { organization_id: orgId, to_agency: target.trim(), note: note.trim() || undefined } }); setTarget(""); setNote(""); toast("Transfer requested."); reload(); }
+                catch (e) { toast(e instanceof Error ? e.message : "Could not start the transfer."); }
+              }}>Request transfer</button>
+            </div>
+          </div>
+        )}
+        {!pending.length && !canStart && <p className="small muted">No pending transfers.</p>}
+        {past.length > 0 && <div className="tiny muted">{past.map((t) => `${t.organization_name} → ${t.to_name}: ${t.status}`).join(" · ")}</div>}
+      </div>
+    </div>
+  );
+}
