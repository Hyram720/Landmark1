new file mode 100644
index 0000000..44c3442
--- /dev/null
+++ b/src/lib/billing/platform.ts
@@ -0,0 +1,109 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import type Stripe from "stripe";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { systemAudit } from "@/lib/tenant/system-audit";
+import { stripeClient } from "@/lib/stripe";
+
+// Agencies subscribe to the platform through the platform's own Stripe
+// account (Stripe Billing). The verified webhook is the only writer of
+// subscription state and of the agency's plan.
+export const ACTIVE = ["trialing", "active", "past_due"] as const;
+export const INACTIVE_PLAN = "agency-inactive";
+
+export function platformBillingStatus() {
+  return { configured: !!stripeClient() && !!process.env.STRIPE_PLATFORM_WEBHOOK_SECRET };
+}
+
+export async function subscriptionFor(client: SupabaseClient, orgId: string) {
+  const { data, error } = await client.from("platform_subscriptions").select("plan_key, status, current_period_end, cancel_at_period_end, updated_at").eq("organization_id", orgId).maybeSingle();
+  fromDb(error);
+  return data;
+}
+
+export async function agencyPlans(client: SupabaseClient) {
+  const { data, error } = await client.from("plans").select("key, name, description, price_cents, limits, stripe_price_id")
+    .is("owner_org_id", null).eq("audience", "agency").eq("active", true).order("price_cents");
+  fromDb(error);
+  return data || [];
+}
+
+async function customerFor(stripe: Stripe, system: SupabaseClient, org: { id: string; name: string }, email: string | null) {
+  const { data } = await system.from("platform_subscriptions").select("stripe_customer_id").eq("organization_id", org.id).maybeSingle();
+  if (data?.stripe_customer_id) return data.stripe_customer_id as string;
+  const c = await stripe.customers.create({ name: org.name, email: email || undefined, metadata: { organization_id: org.id } }, { idempotencyKey: `platform-customer-${org.id}` });
+  const { error } = await system.from("platform_subscriptions").insert({ organization_id: org.id, stripe_customer_id: c.id, status: "incomplete" });
+  if (error && error.code !== "23505") fromDb(error);
+  return c.id;
+}
+
+// Checkout for a new subscription, or the billing portal to change or cancel one.
+export async function startSubscription(system: SupabaseClient | null, org: { id: string; name: string; kind: string }, email: string | null, planKey: string, base: string) {
+  const stripe = stripeClient();
+  if (!stripe || !system) throw new ApiError("Integration not configured: the platform's STRIPE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY are needed for subscriptions.", 503, "integration_not_configured");
+  if (org.kind !== "agency") throw new ApiError("Only agencies subscribe to the platform.", 403, "forbidden");
+  const { data: plan } = await system.from("plans").select("key, stripe_price_id, audience, owner_org_id, active").eq("key", planKey).maybeSingle();
+  if (!plan || plan.audience !== "agency" || plan.owner_org_id || !plan.active) throw new ApiError("That plan is not available.", 422, "invalid");
+  if (!plan.stripe_price_id) throw new ApiError("Integration not configured: this plan has no Stripe price yet. Platform staff set it in Plan & account.", 503, "integration_not_configured");
+  const existing = await subscriptionFor(system, org.id);
+  const customer = await customerFor(stripe, system, org, email);
+  if (existing && (ACTIVE as readonly string[]).includes(existing.status)) {
+    const portal = await stripe.billingPortal.sessions.create({ customer, return_url: `${base}/account` });
+    return { url: portal.url };
+  }
+  const session = await stripe.checkout.sessions.create({
+    mode: "subscription", customer, line_items: [{ price: plan.stripe_price_id, quantity: 1 }],
+    success_url: `${base}/account?subscribed=1`, cancel_url: `${base}/account`,
+    client_reference_id: org.id, subscription_data: { metadata: { organization_id: org.id } }, metadata: { organization_id: org.id },
+  });
+  if (!session.url) throw new ApiError("Stripe did not return a checkout link.", 502, "server_error");
+  return { url: session.url };
+}
+
+export async function portalUrl(system: SupabaseClient | null, orgId: string, base: string) {
+  const stripe = stripeClient();
+  if (!stripe || !system) throw new ApiError("Integration not configured: platform Stripe keys are missing.", 503, "integration_not_configured");
+  const { data } = await system.from("platform_subscriptions").select("stripe_customer_id").eq("organization_id", orgId).maybeSingle();
+  if (!data) throw new ApiError("No subscription yet.", 404, "not_found");
+  return { url: (await stripe.billingPortal.sessions.create({ customer: data.stripe_customer_id, return_url: `${base}/account` })).url };
+}
+
+// Applies a subscription's state: active/trialing/past_due keep the paid plan,
+// anything else moves the agency to the inactive plan (existing clients keep
+// working; no new client accounts).
+export async function applySubscription(system: SupabaseClient, sub: Pick<Stripe.Subscription, "id" | "status" | "customer" | "cancel_at_period_end" | "metadata"> & { items: { data: { price: { id: string }; current_period_end?: number }[] } }) {
+  const customer = typeof sub.customer === "string" ? sub.customer : sub.customer.id;
+  const { data: row } = await system.from("platform_subscriptions").select("organization_id").eq("stripe_customer_id", customer).maybeSingle();
+  const orgId = row?.organization_id ?? sub.metadata?.organization_id;
+  if (!orgId) return "unknown_customer";
+  const item = sub.items.data[0];
+  const { data: plan } = item ? await system.from("plans").select("key").eq("stripe_price_id", item.price.id).is("owner_org_id", null).eq("audience", "agency").maybeSingle() : { data: null };
+  const periodEnd = item?.current_period_end ? new Date(item.current_period_end * 1000).toISOString() : null;
+  const { error } = await system.from("platform_subscriptions").upsert({
+    organization_id: orgId, stripe_customer_id: customer, stripe_subscription_id: sub.id, plan_key: plan?.key ?? null, status: sub.status,
+    current_period_end: periodEnd, cancel_at_period_end: !!sub.cancel_at_period_end, updated_at: new Date().toISOString(),
+  });
+  fromDb(error);
+  const live = (ACTIVE as readonly string[]).includes(sub.status);
+  const nextPlan = live && plan ? plan.key : live ? null : INACTIVE_PLAN;
+  if (nextPlan) {
+    const { data: org } = await system.from("organizations").select("plan, kind").eq("id", orgId).maybeSingle();
+    if (org?.kind === "agency" && org.plan !== nextPlan && org.plan !== "internal") {
+      const { error: e2 } = await system.from("organizations").update({ plan: nextPlan }).eq("id", orgId);
+      fromDb(e2);
+      await systemAudit(system, orgId, "subscription.plan_changed", null, { from: org.plan, to: nextPlan, status: sub.status });
+    }
+  }
+  return "applied";
+}
+
+export async function handlePlatformEvent(system: SupabaseClient, event: Stripe.Event) {
+  switch (event.type) {
+    case "customer.subscription.created":
+    case "customer.subscription.updated":
+    case "customer.subscription.deleted":
+      return applySubscription(system, event.data.object as Stripe.Subscription);
+    default:
+      return "ignored";
+  }
+}
diff --git a/src/lib/billing/rebilling.ts b/src/lib/billing/rebilling.ts
new file mode 100644
index 0000000..8713b4d
--- /dev/null
+++ b/src/lib/billing/rebilling.ts
@@ -0,0 +1,130 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { systemAudit } from "@/lib/tenant/system-audit";
+import { INVOICE_COLUMNS, type Invoice } from "@/lib/billing/invoices";
+
+// Agencies bill their client accounts: a monthly plan fee plus metered usage
+// at the agency's own per-unit rates. Each month becomes a draft invoice in
+// the agency's account, which the agency reviews and sends.
+export const RATED = { sms: "Text messages", email: "Emails", ai_request: "AI requests", outreach_email: "Outreach emails" } as const;
+export type Rated = keyof typeof RATED;
+
+export const billingInput = z.object({
+  contact_id: z.string().uuid("Choose who receives the invoice."),
+  plan_fee_cents: z.number().int().min(0).max(10_000_000).nullable().default(null),
+  rates: z.partialRecord(z.enum(Object.keys(RATED) as [Rated, ...Rated[]]), z.number().min(0).max(1000)).default({}),
+  tax_rate_bp: z.number().int().min(0).max(5000).default(0),
+  auto_invoice: z.boolean().default(false),
+  active: z.boolean().default(true),
+});
+
+export const periodInput = z.string().regex(/^\d{4}-(0[1-9]|1[0-2])$/, "Use a month like 2026-09.");
+
+export function previousMonth(now = new Date()) {
+  const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, 1));
+  return d.toISOString().slice(0, 7);
+}
+export const monthLabel = (period: string) => new Date(`${period}-01T12:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
+
+// 3 → "$0.03", 0.5 → "$0.005", 125 → "$1.25"
+export function fmtRate(cents: number) {
+  const [whole, frac = ""] = (cents / 100).toFixed(5).split(".");
+  const trimmed = frac.replace(/0+$/, "").padEnd(2, "0");
+  return `$${whole}.${trimmed}`;
+}
+
+// Pure: the invoice lines for one client and month.
+export function rebillLines(input: { planName: string; feeCents: number; rates: Partial<Record<Rated, number>>; usage: Partial<Record<Rated, number>>; period: string }) {
+  const lines: { description: string; quantity: number; unit_cents: number }[] = [];
+  if (input.feeCents > 0) lines.push({ description: `${input.planName} plan, ${monthLabel(input.period)}`, quantity: 1, unit_cents: input.feeCents });
+  for (const k of Object.keys(RATED) as Rated[]) {
+    const rate = input.rates[k] ?? 0;
+    const used = input.usage[k] ?? 0;
+    if (rate <= 0 || used <= 0) continue;
+    const amount = Math.round(used * rate);
+    if (amount <= 0) continue;
+    lines.push({ description: `${RATED[k]}: ${used.toLocaleString("en-US")} × ${fmtRate(rate)}`, quantity: 1, unit_cents: amount });
+  }
+  return lines;
+}
+
+export async function listClientBilling(client: SupabaseClient, agencyId: string) {
+  const [{ data: rows, error }, { data: runs }] = await Promise.all([
+    client.from("client_billing").select("client_org_id, contact_id, plan_fee_cents, rates, tax_rate_bp, auto_invoice, active, contacts(first_name, last_name, email)").eq("agency_org_id", agencyId),
+    client.from("client_billing_runs").select("client_org_id, period_start, invoice_id, created_at").eq("agency_org_id", agencyId).order("period_start", { ascending: false }).limit(200),
+  ]);
+  fromDb(error);
+  return { billing: rows || [], runs: runs || [] };
+}
+
+export async function saveClientBilling(client: SupabaseClient, agencyId: string, clientOrgId: string, input: z.infer<typeof billingInput>) {
+  const { error } = await client.from("client_billing").upsert({ client_org_id: clientOrgId, agency_org_id: agencyId, ...input });
+  if (error?.code === "42501") throw new ApiError("Billing can be set only for your own client accounts.", 403, "forbidden");
+  fromDb(error);
+  await audit(client, agencyId, "client_billing.saved", { type: "organization", id: clientOrgId }, { fee: input.plan_fee_cents, rates: input.rates });
+}
+
+type Actor = { client: SupabaseClient; system: boolean };
+
+// Creates the month's draft invoice for one client (idempotent per month).
+export async function invoiceClientMonth(actor: Actor, agencyId: string, clientOrgId: string, period: string) {
+  const c = actor.client;
+  const periodStart = `${periodInput.parse(period)}-01`;
+  if (periodStart >= new Date().toISOString().slice(0, 7) + "-01") throw new ApiError("Only finished months can be invoiced.", 422, "invalid");
+  const { data: b, error } = await c.from("client_billing").select("client_org_id, contact_id, plan_fee_cents, rates, tax_rate_bp, active").eq("agency_org_id", agencyId).eq("client_org_id", clientOrgId).maybeSingle();
+  fromDb(error);
+  if (!b || !b.active) return { status: "not_billed" as const };
+  const { data: existing } = await c.from("client_billing_runs").select("invoice_id").eq("client_org_id", clientOrgId).eq("period_start", periodStart).maybeSingle();
+  if (existing) return { status: "already_invoiced" as const, invoice_id: existing.invoice_id as string | null };
+  const [{ data: org }, { data: used, error: uErr }] = await Promise.all([
+    c.from("organizations").select("name, plan, parent_id").eq("id", clientOrgId).maybeSingle(),
+    c.rpc("usage_for_period", { p_org: clientOrgId, p_period: periodStart }),
+  ]);
+  fromDb(uErr);
+  if (!org || org.parent_id !== agencyId) return { status: "not_billed" as const };
+  const { data: plan } = await c.from("plans").select("name, price_cents").eq("key", org.plan).maybeSingle();
+  const usage = Object.fromEntries(((used || []) as { metric: string; quantity: number }[]).map((u) => [u.metric, Number(u.quantity)]));
+  const lines = rebillLines({ planName: plan?.name ?? org.plan, feeCents: b.plan_fee_cents ?? (org.plan === "internal" ? 0 : plan?.price_cents ?? 0), rates: b.rates, usage, period: periodStart.slice(0, 7) });
+  if (!lines.length) return { status: "nothing_to_bill" as const };
+  const { data: inv, error: iErr } = await c.from("invoices").insert({
+    organization_id: agencyId, kind: "invoice", contact_id: b.contact_id, line_items: lines, tax_rate_bp: b.tax_rate_bp,
+    notes: `${org.name}: services for ${monthLabel(periodStart.slice(0, 7))}.`,
+  }).select(INVOICE_COLUMNS).single();
+  fromDb(iErr);
+  const { error: rErr } = await c.from("client_billing_runs").insert({ agency_org_id: agencyId, client_org_id: clientOrgId, period_start: periodStart, invoice_id: inv!.id });
+  if (rErr?.code === "23505") {
+    await c.from("invoices").delete().eq("organization_id", agencyId).eq("id", inv!.id).eq("status", "draft");
+    return { status: "already_invoiced" as const };
+  }
+  fromDb(rErr);
+  const target = { type: "invoice", id: inv!.id };
+  if (actor.system) await systemAudit(c, agencyId, "client_billing.invoiced", target, { client: clientOrgId, period: periodStart });
+  else await audit(c, agencyId, "client_billing.invoiced", target, { client: clientOrgId, period: periodStart });
+  return { status: "created" as const, invoice: inv as Invoice };
+}
+
+export async function invoiceAllClients(actor: Actor, agencyId: string, period: string, onlyAuto = false) {
+  let q = actor.client.from("client_billing").select("client_org_id").eq("agency_org_id", agencyId).eq("active", true);
+  if (onlyAuto) q = q.eq("auto_invoice", true);
+  const { data, error } = await q;
+  fromDb(error);
+  const results: { client_org_id: string; status: string }[] = [];
+  for (const r of data || []) {
+    try { results.push({ client_org_id: r.client_org_id, status: (await invoiceClientMonth(actor, agencyId, r.client_org_id, period)).status }); }
+    catch (e) { results.push({ client_org_id: r.client_org_id, status: e instanceof ApiError ? e.message : "failed" }); }
+  }
+  return results;
+}
+
+// Scheduler: in the first days of a month, draft last month's invoices for
+// clients whose agency turned on automatic invoicing.
+export async function autoInvoiceTick(system: SupabaseClient, now = new Date()) {
+  if (now.getUTCDate() > 5) return { agencies: 0 };
+  const { data } = await system.from("client_billing").select("agency_org_id").eq("active", true).eq("auto_invoice", true).limit(1000);
+  const agencies = Array.from(new Set((data || []).map((r) => r.agency_org_id as string)));
+  for (const a of agencies) await invoiceAllClients({ client: system, system: true }, a, previousMonth(now), true);
+  return { agencies: agencies.length };
+}
