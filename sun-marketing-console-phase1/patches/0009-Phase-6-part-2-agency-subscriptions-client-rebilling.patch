+
+export const dynamic = "force-dynamic";
+
+// Branding for the host being visited: an agency's verified console domain, or none.
+export async function GET(req: Request) {
+  const host = req.headers.get("x-forwarded-host") || req.headers.get("host") || "";
+  const brand = await brandForHost(systemClient(), host).catch(() => null);
+  return NextResponse.json({ brand }, { headers: { "Cache-Control": "private, max-age=300" } });
+}
