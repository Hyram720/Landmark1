new file mode 100644
index 0000000..4da5296
--- /dev/null
+++ b/src/app/api/webhooks/stripe-platform/route.ts
@@ -0,0 +1,28 @@
+import { NextResponse } from "next/server";
+import { systemClient } from "@/lib/supabase/system";
+import { stripeClient } from "@/lib/stripe";
+import { handlePlatformEvent } from "@/lib/billing/platform";
+
+export const dynamic = "force-dynamic";
+
+// Subscription events from the platform's Stripe account, verified with
+// STRIPE_PLATFORM_WEBHOOK_SECRET. Applying the same event twice is harmless.
+export async function POST(req: Request) {
+  const stripe = stripeClient();
+  const secret = process.env.STRIPE_PLATFORM_WEBHOOK_SECRET;
+  const system = systemClient();
+  if (!stripe || !secret || !system) return NextResponse.json({ error: "Not configured." }, { status: 503 });
+  const signature = req.headers.get("stripe-signature");
+  if (!signature) return NextResponse.json({ error: "Missing signature." }, { status: 400 });
+  const raw = await req.text();
+  if (raw.length > 512_000) return NextResponse.json({ error: "Too large." }, { status: 413 });
+  let event;
+  try { event = stripe.webhooks.constructEvent(raw, signature, secret); }
+  catch { return NextResponse.json({ error: "Invalid signature." }, { status: 400 }); }
+  try {
+    return NextResponse.json({ received: true, result: await handlePlatformEvent(system, event) });
+  } catch (e) {
+    console.error("[stripe-platform webhook]", event.id, e);
+    return NextResponse.json({ error: "Processing failed." }, { status: 500 });
+  }
+}
