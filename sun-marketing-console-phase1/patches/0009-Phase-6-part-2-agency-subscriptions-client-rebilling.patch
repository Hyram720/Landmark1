+import { z } from "zod";
+import { readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { invite, inviteInput, listInvitations, revokeInvitation } from "@/lib/tenant/invitations";
+
+export const dynamic = "force-dynamic";
+
+export const GET = tenantRoute("org.manage", async (ctx) => ({ invitations: await listInvitations(ctx.client, ctx.org.id) }));
+
+// Emails an invitation link; returns the link too so it can be shared another way.
+export const POST = tenantRoute("org.manage", async (ctx, req) => invite(ctx.client, ctx.org.id, await readJson(req, inviteInput), req));
+
+export const DELETE = tenantRoute("org.manage", async (ctx, req) => {
+  const { id } = await readJson(req, z.object({ id: uuid }));
+  await revokeInvitation(ctx.client, ctx.org.id, id);
+  return { ok: true };
+});
