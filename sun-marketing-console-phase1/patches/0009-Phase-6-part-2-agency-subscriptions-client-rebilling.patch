@@ -0,0 +1,27 @@
+import "server-only";
+
+// Platform email for account messages (invitations). Uses the platform's own
+// Resend key and sender, not a client's channels.
+export function platformEmailConfigured() {
+  return !!(process.env.RESEND_API_KEY?.trim() && (process.env.PLATFORM_FROM_EMAIL || process.env.OUTREACH_FROM_EMAIL));
+}
+
+export async function sendPlatformEmail(to: string, subject: string, text: string, fromName?: string): Promise<{ sent: boolean; reason: string | null }> {
+  const key = process.env.RESEND_API_KEY?.trim();
+  const address = process.env.PLATFORM_FROM_EMAIL || process.env.OUTREACH_FROM_EMAIL;
+  if (!key || !address) return { sent: false, reason: "Integration not configured: set RESEND_API_KEY and PLATFORM_FROM_EMAIL." };
+  const name = (fromName || "").replace(/[<>"\r\n]/g, "").slice(0, 60).trim();
+  const bare = address.replace(/^.*<([^>]+)>.*$/, "$1");
+  const r = await fetch("https://api.resend.com/emails", {
+    method: "POST",
+    headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json" },
+    body: JSON.stringify({ from: name ? `${name} <${bare}>` : address, to: [to], subject, text }),
+    signal: AbortSignal.timeout(15000),
+  }).catch(() => null);
+  if (!r) return { sent: false, reason: "The email service did not respond." };
+  if (!r.ok) {
+    const j = await r.json().catch(() => ({}));
+    return { sent: false, reason: (j as { message?: string }).message || `Email service error ${r.status}.` };
+  }
+  return { sent: true, reason: null };
+}
