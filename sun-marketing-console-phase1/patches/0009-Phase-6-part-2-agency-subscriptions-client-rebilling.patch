--- /dev/null
+++ b/src/app/api/public/invitation/[token]/route.ts
@@ -0,0 +1,53 @@
+import { NextResponse } from "next/server";
+import { ApiError, assertSameOrigin, errorResponse, readJson } from "@/lib/tenant/api";
+import { systemClient } from "@/lib/supabase/system";
+import { clientIp, takeLimit } from "@/lib/rate-limit";
+import { ORG_COOKIE, userClient } from "@/lib/tenant/session";
+import { setSessionCookies } from "@/lib/session-cookies";
+import { joinInput, joinWithNewAccount, previewInvitation } from "@/lib/tenant/invitations";
+
+export const dynamic = "force-dynamic";
+type P = { params: Promise<{ token: string }> };
+
+async function setup(req: Request, bucket: string, max: number) {
+  if (!(await takeLimit(bucket, clientIp(req), max, 600))) throw new ApiError("Too many attempts. Try again in a few minutes.", 429, "rate_limited");
+  const system = systemClient();
+  if (!system) throw new ApiError("Invitations are not available right now.", 503, "integration_not_configured");
+  return system;
+}
+
+export async function GET(req: Request, { params }: P) {
+  try {
+    const system = await setup(req, "invite-view", 60);
+    const p = await previewInvitation(system, (await params).token);
+    if (!p) throw new ApiError("This invitation link is not valid.", 404, "not_found");
+    return NextResponse.json(p, { headers: { "Cache-Control": "no-store" } });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
+
+// Creates the invited person's account, signs them in and accepts.
+export async function POST(req: Request, { params }: P) {
+  try {
+    assertSameOrigin(req);
+    const system = await setup(req, "invite-join", 10);
+    const input = await readJson(req, joinInput);
+    const url = process.env.SUPABASE_URL!;
+    const key = process.env.SUPABASE_KEY!;
+    const signIn = async (email: string, password: string) => {
+      const r = await fetch(`${url}/auth/v1/token?grant_type=password`, { method: "POST", headers: { apikey: key, "Content-Type": "application/json" }, body: JSON.stringify({ email, password }) }).catch(() => null);
+      return r?.ok ? ((await r.json()) as { access_token: string; refresh_token: string; expires_in: number }) : null;
+    };
+    const token = (await params).token;
+    const session = await joinWithNewAccount(system, token, input, signIn, userClient);
+    const { data: p } = await system.rpc("invitation_preview", { p_token: token });
+    const res = NextResponse.json({ ok: true });
+    setSessionCookies(res, session);
+    const orgId = (p as { organization_id: string }[] | null)?.[0]?.organization_id;
+    if (orgId) res.cookies.set(ORG_COOKIE, orgId, { httpOnly: true, sameSite: "lax", secure: process.env.NODE_ENV === "production", path: "/", maxAge: 60 * 60 * 24 * 180 });
+    return res;
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
diff --git a/src/app/api/tenant/invitations/accept/route.ts b/src/app/api/tenant/invitations/accept/route.ts
new file mode 100644
