+import { z } from "zod";
+import { ApiError, fromDb, readJson, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+
+export const dynamic = "force-dynamic";
+
+// Platform staff link platform plans to their Stripe prices.
+export const PUT = tenantRoute("org.read", async (ctx, req) => {
+  if (!ctx.isPlatformStaff) throw new ApiError("Only platform staff manage platform plans.", 403, "forbidden");
+  const input = await readJson(req, z.object({ key: z.string().max(41), stripe_price_id: z.string().trim().regex(/^price_[A-Za-z0-9]{3,100}$/, "Paste a Stripe price ID (price_…).").nullable() }));
+  const { data, error } = await ctx.client.from("plans").update({ stripe_price_id: input.stripe_price_id }).eq("key", input.key).is("owner_org_id", null).select("key").maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Plan not found.", 404, "not_found");
+  await audit(ctx.client, ctx.org.id, "platform_plan.price_linked", { type: "plan", id: input.key }, { stripe_price_id: input.stripe_price_id });
+  return { ok: true };
+});
