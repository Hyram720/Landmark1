diff --git a/supabase/migrations/20261012120000_phase6b_agency_operations.sql b/supabase/migrations/20261012120000_phase6b_agency_operations.sql
new file mode 100644
index 0000000..55a6133
--- /dev/null
+++ b/supabase/migrations/20261012120000_phase6b_agency_operations.sql
@@ -0,0 +1,446 @@
+-- Phase 6 part 2: agency operations.
+--   * Platform subscriptions: agencies pay the platform (Stripe Billing);
+--     agency plans limit the number of client accounts.
+--   * Client rebilling: agencies bill clients a plan fee plus metered usage
+--     at their own rates, as draft invoices they review.
+--   * Invitations by email with hashed, expiring tokens.
+--   * Account transfer between agencies, with the client's consent.
+--   * White-label app domains for agencies (branded sign-in).
+
+-- ------------------------------------------------------------------ plans
+alter table public.plans add column audience text not null default 'client' check (audience in ('client', 'agency'));
+alter table public.plans add column stripe_price_id text check (stripe_price_id ~ '^price_[A-Za-z0-9]{3,100}$');
+alter table public.plans add constraint plans_agency_owned_client check (owner_org_id is null or (audience = 'client' and stripe_price_id is null));
+
+insert into public.plans(key, name, description, price_cents, limits, audience, active) values
+  ('agency-solo', 'Agency Solo', 'Up to 5 client accounts.', 9700, '{"client_accounts": 5}', 'agency', true),
+  ('agency-growth', 'Agency Growth', 'Up to 25 client accounts.', 29700, '{"client_accounts": 25}', 'agency', true),
+  ('agency-scale', 'Agency Scale', 'Up to 100 client accounts.', 59700, '{"client_accounts": 100}', 'agency', true),
+  ('agency-inactive', 'No active subscription', 'Existing client accounts keep working; new ones need a subscription.', 0, '{"client_accounts": 0}', 'agency', false)
+on conflict (key) do nothing;
+
+create or replace function public.check_plan_limit(p_org uuid, p_metric text, p_add integer default 1) returns void
+language plpgsql security definer set search_path = '' as $$
+declare v_limit bigint; v_used bigint; v_label text;
+begin
+  select (p.limits ->> p_metric)::bigint into v_limit
+    from public.organizations o join public.plans p on p.key = o.plan where o.id = p_org;
+  if v_limit is null then return; end if;
+  v_used := case p_metric
+    when 'contacts' then (select count(*) from public.contacts where organization_id = p_org and erased_at is null)
+    when 'users' then (select count(*) from public.memberships where organization_id = p_org and status = 'active')
+    when 'sites' then (select count(*) from public.sites where organization_id = p_org and status <> 'archived')
+    when 'client_accounts' then (select count(*) from public.organizations where parent_id = p_org and status <> 'closed')
+    else (select coalesce(sum(quantity), 0) from public.usage_events where organization_id = p_org and metric = p_metric and occurred_at >= public.month_start())
+  end;
+  if v_used + p_add > v_limit then
+    v_label := case p_metric when 'sms' then 'text messages this month' when 'email' then 'emails this month' when 'ai_request' then 'AI requests this month'
+      when 'outreach_email' then 'outreach emails this month' when 'contacts' then 'contacts' when 'users' then 'team members' when 'sites' then 'websites'
+      when 'client_accounts' then 'client accounts' else p_metric end;
+    raise exception 'Plan limit reached: % of % %. Upgrade the plan to add more.', v_used, v_limit, v_label using errcode = '53400';
+  end if;
+end $$;
+
+create or replace function public.org_usage(p_org uuid)
+returns table (metric text, used bigint, "limit" bigint)
+language plpgsql stable security definer set search_path = '' as $$
+declare v_limits jsonb; v_kind text;
+begin
+  if public.org_rank(p_org) < 1 then raise exception 'Not allowed.' using errcode = '42501'; end if;
+  select p.limits, o.kind into v_limits, v_kind from public.organizations o join public.plans p on p.key = o.plan where o.id = p_org;
+  return query
+  select m.metric,
+    case m.metric
+      when 'contacts' then (select count(*) from public.contacts c where c.organization_id = p_org and c.erased_at is null)
+      when 'users' then (select count(*) from public.memberships x where x.organization_id = p_org and x.status = 'active')
+      when 'sites' then (select count(*) from public.sites s where s.organization_id = p_org and s.status <> 'archived')
+      when 'client_accounts' then (select count(*) from public.organizations o where o.parent_id = p_org and o.status <> 'closed')
+      else (select coalesce(sum(u.quantity), 0)::bigint from public.usage_events u where u.organization_id = p_org and u.metric = m.metric and u.occurred_at >= public.month_start())
+    end,
+    (v_limits ->> m.metric)::bigint
+  from unnest(array['sms', 'email', 'ai_request', 'outreach_email', 'contacts', 'users', 'sites'] || case when v_kind = 'agency' then array['client_accounts'] else array[]::text[] end) as m(metric);
+end $$;
+
+-- New client accounts count against the agency's plan.
+create or replace function public.tg_limit_client_accounts() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if new.kind = 'client' and new.parent_id is not null and (tg_op = 'INSERT' or new.parent_id is distinct from old.parent_id) then
+    perform public.check_plan_limit(new.parent_id, 'client_accounts');
+  end if;
+  return new;
+end $$;
+create trigger organizations_client_limit before insert or update of parent_id on public.organizations
+  for each row execute function public.tg_limit_client_accounts();
+
+-- Plans must match the kind of account they are assigned to.
+create or replace function public.govern_organization(p_org uuid, p_status text default null, p_plan text default null) returns void
+language plpgsql security definer set search_path = '' as $$
+declare v_org public.organizations; v_plan public.plans; v_allowed boolean;
+begin
+  select * into v_org from public.organizations where id = p_org;
+  if not found then raise exception 'Organization not found.' using errcode = 'P0002'; end if;
+  v_allowed := public.is_platform_staff() or (v_org.kind = 'client' and exists (
+    select 1 from public.memberships m where m.organization_id = v_org.parent_id and m.user_id = auth.uid() and m.status = 'active' and public.role_rank(m.role) >= 4));
+  if not v_allowed then raise exception 'Only the managing agency''s admins can change this.' using errcode = '42501'; end if;
+  if p_status is not null and p_status not in ('active', 'suspended', 'closed') then raise exception 'Unknown status.' using errcode = '22023'; end if;
+  if p_plan is not null then
+    -- Staff may also assign inactive plans (e.g. "No active subscription").
+    select * into v_plan from public.plans where key = p_plan and (active or public.is_platform_staff());
+    if not found or (v_plan.owner_org_id is not null and v_plan.owner_org_id is distinct from v_org.parent_id) then
+      raise exception 'That plan is not available for this account.' using errcode = '22023';
+    end if;
+    if v_plan.key = 'internal' and not public.is_platform_staff() then
+      raise exception 'Only platform staff assign the internal plan.' using errcode = '42501';
+    end if;
+    if v_plan.key <> 'internal' and v_plan.audience <> (case v_org.kind when 'agency' then 'agency' else 'client' end) then
+      raise exception 'That plan is for a different kind of account.' using errcode = '22023';
+    end if;
+  end if;
+  update public.organizations set status = coalesce(p_status, status), plan = coalesce(p_plan, plan) where id = p_org;
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, metadata)
+  values (p_org, 'user', auth.uid(), 'organization.governed', jsonb_build_object('status', p_status, 'plan', p_plan, 'previous_status', v_org.status, 'previous_plan', v_org.plan));
+end $$;
+
+-- ------------------------------------------------- platform subscriptions
+-- Written only by the server from verified Stripe webhooks.
+create table public.platform_subscriptions (
+  organization_id uuid primary key references public.organizations(id) on delete cascade,
+  stripe_customer_id text not null unique check (stripe_customer_id ~ '^cus_[A-Za-z0-9]+$'),
+  stripe_subscription_id text unique,
+  plan_key text references public.plans(key),
+  status text not null default 'incomplete' check (status in ('incomplete', 'incomplete_expired', 'trialing', 'active', 'past_due', 'canceled', 'unpaid', 'paused')),
+  current_period_end timestamptz,
+  cancel_at_period_end boolean not null default false,
+  updated_at timestamptz not null default now()
+);
+
+-- --------------------------------------------------------- client billing
+create table public.client_billing (
+  client_org_id uuid primary key references public.organizations(id) on delete cascade,
+  agency_org_id uuid not null references public.organizations(id) on delete cascade,
+  contact_id uuid not null,
+  plan_fee_cents integer check (plan_fee_cents between 0 and 10000000),
+  rates jsonb not null default '{}' check (jsonb_typeof(rates) = 'object'),
+  tax_rate_bp integer not null default 0 check (tax_rate_bp between 0 and 5000),
+  auto_invoice boolean not null default false,
+  active boolean not null default true,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  foreign key (contact_id, agency_org_id) references public.contacts(id, organization_id) on delete restrict
+);
+create index client_billing_agency_idx on public.client_billing(agency_org_id);
+create trigger client_billing_updated before update on public.client_billing for each row execute function public.tg_set_updated_at();
+
+create or replace function public.tg_client_billing_guard() returns trigger
+language plpgsql set search_path = '' as $$
+declare v_key text; v_val jsonb;
+begin
+  if not exists (select 1 from public.organizations o where o.id = new.client_org_id and o.kind = 'client' and o.parent_id = new.agency_org_id) then
+    raise exception 'Billing can be set only for your own client accounts.' using errcode = '42501';
+  end if;
+  for v_key, v_val in select * from jsonb_each(new.rates) loop
+    if v_key not in ('sms', 'email', 'ai_request', 'outreach_email') then raise exception 'Unknown usage type %.', v_key using errcode = '22023'; end if;
+    if jsonb_typeof(v_val) <> 'number' or v_val::numeric < 0 or v_val::numeric > 1000 then
+      raise exception 'Rates are cents per unit between 0 and 1000.' using errcode = '22023';
+    end if;
+  end loop;
+  return new;
+end $$;
+create trigger client_billing_guard before insert or update on public.client_billing
+  for each row execute function public.tg_client_billing_guard();
+
+create table public.client_billing_runs (
+  id uuid primary key default gen_random_uuid(),
+  agency_org_id uuid not null references public.organizations(id) on delete cascade,
+  client_org_id uuid not null references public.organizations(id) on delete cascade,
+  period_start date not null check (extract(day from period_start) = 1),
+  invoice_id uuid,
+  created_at timestamptz not null default now(),
+  unique (client_org_id, period_start),
+  foreign key (invoice_id, agency_org_id) references public.invoices(id, organization_id) on delete set null (invoice_id)
+);
+
+-- Metered usage of a client for one calendar month (UTC).
+create or replace function public.usage_for_period(p_org uuid, p_period date)
+returns table (metric text, quantity bigint)
+language plpgsql stable security definer set search_path = '' as $$
+begin
+  if coalesce(current_setting('role', true), '') <> 'service_role' and public.org_rank(p_org) < 1 then
+    raise exception 'Not allowed.' using errcode = '42501';
+  end if;
+  return query
+  select u.metric, sum(u.quantity)::bigint from public.usage_events u
+   where u.organization_id = p_org
+     and u.occurred_at >= (date_trunc('month', p_period::timestamp) at time zone 'UTC')
+     and u.occurred_at < ((date_trunc('month', p_period::timestamp) + interval '1 month') at time zone 'UTC')
+   group by u.metric;
+end $$;
+
+-- ------------------------------------------------------------ invitations
+create table public.invitations (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  email text not null check (email = lower(btrim(email)) and email ~ '^[^@\s]+@[^@\s]+\.[^@\s]+$' and length(email) <= 254),
+  role text not null check (role in ('owner', 'admin', 'manager', 'member', 'viewer')),
+  token_hash text not null unique,
+  status text not null default 'pending' check (status in ('pending', 'accepted', 'revoked')),
+  expires_at timestamptz not null default now() + interval '7 days',
+  invited_by uuid,
+  accepted_by uuid,
+  accepted_at timestamptz,
+  created_at timestamptz not null default now()
+);
+create unique index invitations_pending on public.invitations(organization_id, email) where status = 'pending';
+
+-- Returns the raw token once; only its hash is stored.
+create or replace function public.create_invitation(p_org uuid, p_email text, p_role text) returns text
+language plpgsql security definer set search_path = '' as $$
+declare v_rank integer := public.org_rank(p_org); v_token text := encode(extensions.gen_random_bytes(24), 'hex'); v_email text := lower(btrim(p_email));
+begin
+  if v_rank < 4 then raise exception 'Only admins can invite people.' using errcode = '42501'; end if;
+  if public.role_rank(p_role) = 0 then raise exception 'Unknown role.' using errcode = '22023'; end if;
+  if public.role_rank(p_role) > v_rank and not (p_role = 'owner' and public.can_manage_owners(p_org)) then
+    raise exception 'You cannot grant a role above your own.' using errcode = '42501';
+  end if;
+  if exists (select 1 from public.organizations where id = p_org and status <> 'active') then
+    raise exception 'This account is not active.' using errcode = '42501';
+  end if;
+  perform public.check_plan_limit(p_org, 'users');
+  update public.invitations set status = 'revoked' where organization_id = p_org and email = v_email and status = 'pending';
+  insert into public.invitations(organization_id, email, role, token_hash, invited_by)
+  values (p_org, v_email, p_role, encode(extensions.digest(v_token, 'sha256'), 'hex'), auth.uid());
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, metadata)
+  values (p_org, 'user', auth.uid(), 'invitation.created', jsonb_build_object('email', v_email, 'role', p_role));
+  return v_token;
+end $$;
+
+-- What a token holder may see before accepting (server use only).
+create or replace function public.invitation_preview(p_token text)
+returns table (id uuid, organization_id uuid, organization_name text, email text, role text, valid boolean)
+language sql stable security definer set search_path = '' as $$
+  select i.id, i.organization_id, o.name, i.email, i.role, (i.status = 'pending' and i.expires_at > now() and o.status = 'active')
+    from public.invitations i join public.organizations o on o.id = i.organization_id
+   where i.token_hash = encode(extensions.digest(coalesce(p_token, ''), 'sha256'), 'hex')
+$$;
+
+-- Whether an account already exists for an invited address (server use only).
+create or replace function public.auth_email_exists(p_email text) returns boolean
+language sql stable security definer set search_path = '' as $$
+  select exists (select 1 from auth.users u where lower(u.email) = lower(btrim(p_email)))
+$$;
+
+-- The signed-in person accepts; their account email must match the invitation.
+create or replace function public.accept_invitation(p_token text) returns uuid
+language plpgsql security definer set search_path = '' as $$
+declare v_inv public.invitations; v_email text;
+begin
+  if auth.uid() is null then raise exception 'Sign in first.' using errcode = '42501'; end if;
+  select * into v_inv from public.invitations where token_hash = encode(extensions.digest(coalesce(p_token, ''), 'sha256'), 'hex') for update;
+  if not found or v_inv.status <> 'pending' or v_inv.expires_at <= now() then
+    raise exception 'This invitation is no longer valid. Ask for a new one.' using errcode = 'P0002';
+  end if;
+  select lower(u.email) into v_email from auth.users u where u.id = auth.uid();
+  if v_email is distinct from v_inv.email then
+    raise exception 'This invitation was sent to a different email address.' using errcode = '42501';
+  end if;
+  insert into public.memberships(organization_id, user_id, role, email) values (v_inv.organization_id, auth.uid(), v_inv.role, v_inv.email)
+  on conflict (organization_id, user_id) do update set role = excluded.role, status = 'active', email = excluded.email
+  where public.memberships.role <> 'owner';
+  update public.invitations set status = 'accepted', accepted_by = auth.uid(), accepted_at = now() where id = v_inv.id;
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, target_type, target_id, metadata)
+  values (v_inv.organization_id, 'user', auth.uid(), 'invitation.accepted', 'user', auth.uid()::text, jsonb_build_object('role', v_inv.role));
+  return v_inv.organization_id;
+end $$;
+
+-- ------------------------------------------------------- account transfer
+create table public.org_transfers (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  from_agency_id uuid not null references public.organizations(id) on delete cascade,
+  to_agency_id uuid not null references public.organizations(id) on delete cascade,
+  status text not null default 'pending' check (status in ('pending', 'completed', 'declined', 'cancelled')),
+  client_approved_at timestamptz,
+  client_approved_by uuid,
+  agency_accepted_at timestamptz,
+  agency_accepted_by uuid,
+  requested_by uuid not null,
+  note text check (length(note) <= 500),
+  created_at timestamptz not null default now(),
+  decided_at timestamptz,
+  check (from_agency_id <> to_agency_id)
+);
+create unique index org_transfers_pending on public.org_transfers(organization_id) where status = 'pending';
+
+create or replace function public.is_direct_admin(p_org uuid, p_min integer default 4) returns boolean
+language sql stable security definer set search_path = '' as $$
+  select exists (select 1 from public.memberships m where m.organization_id = p_org and m.user_id = auth.uid() and m.status = 'active' and public.role_rank(m.role) >= p_min)
+$$;
+
+create or replace function public.tg_finish_transfer() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare v_plan public.plans;
+begin
+  if new.status = 'pending' and new.client_approved_at is not null and new.agency_accepted_at is not null then
+    perform public.check_plan_limit(new.to_agency_id, 'client_accounts');
+    select p.* into v_plan from public.organizations o join public.plans p on p.key = o.plan where o.id = new.organization_id;
+    update public.organizations set parent_id = new.to_agency_id,
+      plan = case when v_plan.owner_org_id is not null then 'starter' else plan end
+     where id = new.organization_id;
+    delete from public.client_billing where client_org_id = new.organization_id;
+    new.status := 'completed'; new.decided_at := now();
+    insert into public.audit_log(organization_id, actor_type, actor_id, action, metadata)
+    values (new.organization_id, 'user', auth.uid(), 'organization.transferred', jsonb_build_object('from', new.from_agency_id, 'to', new.to_agency_id));
+  end if;
+  return new;
+end $$;
+create trigger org_transfers_finish before insert or update on public.org_transfers
+  for each row execute function public.tg_finish_transfer();
+
+-- Started by the current agency's admins or the client's owner. Needs the
+-- receiving agency's acceptance and, if the client has an owner, their consent.
+create or replace function public.request_transfer(p_org uuid, p_to_agency_slug text, p_note text default null) returns uuid
+language plpgsql security definer set search_path = '' as $$
+declare v_org public.organizations; v_to uuid; v_id uuid; v_client_owner boolean; v_has_owner boolean;
+begin
+  select * into v_org from public.organizations where id = p_org and kind = 'client';
+  if not found then raise exception 'Client account not found.' using errcode = 'P0002'; end if;
+  v_client_owner := public.is_direct_admin(p_org, 5);
+  if not (v_client_owner or public.is_direct_admin(v_org.parent_id, 4) or public.is_platform_staff()) then
+    raise exception 'Only the managing agency''s admins or the account owner can start a transfer.' using errcode = '42501';
+  end if;
+  select id into v_to from public.organizations where slug = lower(btrim(p_to_agency_slug)) and kind = 'agency' and status = 'active';
+  if v_to is null then raise exception 'No active agency has that account ID.' using errcode = 'P0002'; end if;
+  if v_to = v_org.parent_id then raise exception 'The account already belongs to that agency.' using errcode = '22023'; end if;
+  v_has_owner := exists (select 1 from public.memberships m where m.organization_id = p_org and m.role = 'owner' and m.status = 'active');
+  insert into public.org_transfers(organization_id, from_agency_id, to_agency_id, requested_by, note, client_approved_at, client_approved_by)
+  values (p_org, v_org.parent_id, v_to, auth.uid(), nullif(btrim(p_note), ''),
+          case when v_client_owner or not v_has_owner then now() end, case when v_client_owner then auth.uid() end)
+  returning id into v_id;
+  insert into public.audit_log(organization_id, actor_type, actor_id, action, metadata)
+  values (p_org, 'user', auth.uid(), 'organization.transfer_requested', jsonb_build_object('to', v_to));
+  return v_id;
+exception when unique_violation then
+  raise exception 'A transfer is already pending for this account.' using errcode = '23505';
+end $$;
+
+-- p_decision: 'approve' (client owner), 'accept' (receiving agency admin),
+-- 'decline' (either), 'cancel' (the requesting side).
+create or replace function public.decide_transfer(p_id uuid, p_decision text) returns text
+language plpgsql security definer set search_path = '' as $$
+declare v_t public.org_transfers; v_client boolean; v_receiver boolean; v_sender boolean;
+begin
+  select * into v_t from public.org_transfers where id = p_id for update;
+  if not found or v_t.status <> 'pending' then raise exception 'This transfer is no longer pending.' using errcode = 'P0002'; end if;
+  v_client := public.is_direct_admin(v_t.organization_id, 5);
+  v_receiver := public.is_direct_admin(v_t.to_agency_id, 4);
+  v_sender := public.is_direct_admin(v_t.from_agency_id, 4) or v_t.requested_by = auth.uid();
+  if p_decision = 'approve' and v_client then
+    update public.org_transfers set client_approved_at = now(), client_approved_by = auth.uid() where id = p_id;
+  elsif p_decision = 'accept' and v_receiver then
+    update public.org_transfers set agency_accepted_at = now(), agency_accepted_by = auth.uid() where id = p_id;
+  elsif p_decision = 'decline' and (v_client or v_receiver) then
+    update public.org_transfers set status = 'declined', decided_at = now() where id = p_id;
+  elsif p_decision = 'cancel' and (v_sender or v_client) then
+    update public.org_transfers set status = 'cancelled', decided_at = now() where id = p_id;
+  else
+    raise exception 'You cannot do that for this transfer.' using errcode = '42501';
+  end if;
+  return (select status from public.org_transfers where id = p_id);
+end $$;
+
+-- ------------------------------------------------- white-label app domains
+create table public.app_domains (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  domain text not null check (domain ~ '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$' and length(domain) <= 253),
+  verification_token text not null default encode(extensions.gen_random_bytes(16), 'hex'),
+  status text not null default 'pending' check (status in ('pending', 'verified')),
+  verified_at timestamptz,
+  last_checked_at timestamptz,
+  created_by uuid,
+  created_at timestamptz not null default now()
+);
+create unique index app_domains_domain on public.app_domains(domain);
+
+create or replace function public.tg_app_domains_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    if not exists (select 1 from public.organizations o where o.id = new.organization_id and o.kind = 'agency') then
+      raise exception 'Only agencies use their own sign-in domain.' using errcode = '42501';
+    end if;
+    new.status := 'pending'; new.verified_at := null; new.created_by := auth.uid();
+    new.verification_token := encode(extensions.gen_random_bytes(16), 'hex');
+    return new;
+  end if;
+  raise exception 'Domains are verified by the server.' using errcode = '42501';
+end $$;
+create trigger app_domains_guard before insert or update on public.app_domains
+  for each row execute function public.tg_app_domains_guard();
+
+-- A host name serves either a client website or an agency's console, never both.
+create or replace function public.tg_domain_unique_across() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if (tg_table_name = 'app_domains' and exists (select 1 from public.site_domains where domain = new.domain))
+     or (tg_table_name = 'site_domains' and exists (select 1 from public.app_domains where domain = new.domain)) then
+    raise exception 'That domain is already connected.' using errcode = '23505';
+  end if;
+  return new;
+end $$;
+create trigger app_domains_unique before insert on public.app_domains for each row execute function public.tg_domain_unique_across();
+create trigger site_domains_unique before insert on public.site_domains for each row execute function public.tg_domain_unique_across();
+
+-- Public branding for the sign-in page on an agency's verified domain.
+create or replace function public.brand_for_domain(p_domain text) returns jsonb
+language sql stable security definer set search_path = '' as $$
+  select jsonb_build_object('name', coalesce(nullif(o.branding ->> 'display_name', ''), o.name), 'logo_url', o.branding ->> 'logo_url',
+                            'color', o.branding ->> 'color', 'support_email', o.branding ->> 'support_email')
+    from public.app_domains d join public.organizations o on o.id = d.organization_id and o.status = 'active' and o.kind = 'agency'
+   where d.domain = lower(btrim(p_domain)) and d.status = 'verified'
+   limit 1
+$$;
+
+-- ---------------------------------------------------------------------- RLS
+alter table public.platform_subscriptions enable row level security;
+alter table public.client_billing enable row level security;
+alter table public.client_billing_runs enable row level security;
+alter table public.invitations enable row level security;
+alter table public.org_transfers enable row level security;
+alter table public.app_domains enable row level security;
+
+create policy platform_subscriptions_read on public.platform_subscriptions for select to authenticated
+  using (public.org_rank(organization_id) >= 4 or public.is_platform_staff());
+create policy client_billing_agency on public.client_billing for all to authenticated
+  using (public.org_rank(agency_org_id) >= 4) with check (public.org_rank(agency_org_id) >= 4);
+create policy client_billing_runs_agency on public.client_billing_runs for all to authenticated
+  using (public.org_rank(agency_org_id) >= 4)
+  with check (public.org_rank(agency_org_id) >= 4 and exists (select 1 from public.organizations o where o.id = client_org_id and o.parent_id = agency_org_id));
+create policy invitations_admin_read on public.invitations for select to authenticated using (public.org_rank(organization_id) >= 4);
+create policy invitations_admin_revoke on public.invitations for update to authenticated
+  using (public.org_rank(organization_id) >= 4 and status = 'pending') with check (status = 'revoked');
+create policy org_transfers_read on public.org_transfers for select to authenticated using (
+  public.org_rank(organization_id) >= 4 or public.is_direct_admin(to_agency_id, 4) or public.is_direct_admin(from_agency_id, 4));
+create policy app_domains_read on public.app_domains for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy app_domains_write on public.app_domains for insert to authenticated with check (public.org_rank(organization_id) >= 4);
+create policy app_domains_delete on public.app_domains for delete to authenticated using (public.org_rank(organization_id) >= 4);
+
+revoke all on public.platform_subscriptions, public.client_billing, public.client_billing_runs, public.invitations, public.org_transfers, public.app_domains from anon, authenticated;
+grant select on public.platform_subscriptions, public.org_transfers to authenticated;
+grant select, insert, update, delete on public.client_billing to authenticated;
+grant select, insert, delete on public.client_billing_runs to authenticated;
+grant select (id, organization_id, email, role, status, expires_at, invited_by, accepted_by, accepted_at, created_at) on public.invitations to authenticated;
+grant update (status) on public.invitations to authenticated;
+grant select, insert, delete on public.app_domains to authenticated;
+grant all on public.platform_subscriptions, public.client_billing, public.client_billing_runs, public.invitations, public.org_transfers, public.app_domains to service_role;
+
+revoke execute on function public.usage_for_period(uuid, date), public.create_invitation(uuid, text, text), public.invitation_preview(text),
+  public.accept_invitation(text), public.is_direct_admin(uuid, integer), public.request_transfer(uuid, text, text), public.decide_transfer(uuid, text),
+  public.brand_for_domain(text), public.auth_email_exists(text), public.tg_limit_client_accounts(), public.tg_finish_transfer(), public.tg_domain_unique_across() from public, anon;
+revoke execute on function public.auth_email_exists(text) from authenticated;
+grant execute on function public.usage_for_period(uuid, date), public.create_invitation(uuid, text, text), public.accept_invitation(text),
+  public.is_direct_admin(uuid, integer), public.request_transfer(uuid, text, text), public.decide_transfer(uuid, text) to authenticated;
+grant execute on function public.usage_for_period(uuid, date), public.invitation_preview(text), public.auth_email_exists(text), public.brand_for_domain(text) to service_role;
+grant execute on function public.brand_for_domain(text) to anon, authenticated;
diff --git a/supabase/tests/phase6b_agency.test.sql b/supabase/tests/phase6b_agency.test.sql
new file mode 100644
index 0000000..c7c4eb4
--- /dev/null
+++ b/supabase/tests/phase6b_agency.test.sql
@@ -0,0 +1,194 @@
+-- Phase 6 part 2 security tests: agency plans, rebilling, invitations, transfers, app domains.
+-- Run with scripts/test-db.sh.
+\set ON_ERROR_STOP 1
+set client_min_messages = notice;
+
+create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, false);
+  execute 'set role authenticated';
+end $$;
+create or replace function pg_temp.as_service() returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', '{"role":"service_role"}', false);
+  execute 'set role service_role';
+end $$;
+create or replace function pg_temp.reset_user() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', false);
+end $$;
+create or replace function pg_temp.expect_error(p_sql text, p_label text) returns void language plpgsql as $$
+begin
+  begin execute p_sql; exception when others then raise notice 'ok   (denied) %', p_label; return; end;
+  raise exception 'FAIL expected an error: %', p_label;
+end $$;
+create or replace function pg_temp.expect(p_ok boolean, p_label text) returns void language plpgsql as $$
+begin
+  if not coalesce(p_ok, false) then raise exception 'FAIL %', p_label; end if;
+  raise notice 'ok   %', p_label;
+end $$;
+
+-- 1 = staff, owner of agencies X and Y; 2 = owner of client C; 3 = admin of Y; 4 = admin of X; 5 = member of C; 6 = invitee
+insert into auth.users values
+  ('61000000-0000-0000-0000-000000000001', 'staff@p6b.test'), ('61000000-0000-0000-0000-000000000002', 'owner@p6bc.test'),
+  ('61000000-0000-0000-0000-000000000003', 'admin@p6by.test'), ('61000000-0000-0000-0000-000000000004', 'admin@p6bx.test'),
+  ('61000000-0000-0000-0000-000000000005', 'member@p6bc.test'), ('61000000-0000-0000-0000-000000000006', 'new@p6b.test');
+insert into public.team_members(user_id, email, active) values ('61000000-0000-0000-0000-000000000001', 'staff@p6b.test', true);
+create temp table ids (k text primary key, v uuid);
+grant all on ids to authenticated, service_role, anon;
+create temp table toks (k text primary key, v text);
+grant all on toks to authenticated, service_role, anon;
+select pg_temp.as_user('61000000-0000-0000-0000-000000000001');
+insert into ids select 'x', public.create_organization('Agency B X', 'agency');
+insert into ids select 'y', public.create_organization('Agency B Y', 'agency');
+select public.add_member_by_email((select v from ids where k = 'x'), 'admin@p6bx.test', 'admin');
+select public.add_member_by_email((select v from ids where k = 'y'), 'admin@p6by.test', 'admin');
+insert into toks select 'yslug', slug from public.organizations where id = (select v from ids where k = 'y');
+select pg_temp.reset_user();
+select pg_temp.as_user('61000000-0000-0000-0000-000000000004');
+insert into ids select 'c', public.create_organization('Client B C', 'client', (select v from ids where k = 'x'));
+select public.add_member_by_email((select v from ids where k = 'c'), 'owner@p6bc.test', 'admin');
+select pg_temp.reset_user();
+select pg_temp.as_user('61000000-0000-0000-0000-000000000001');
+select public.add_member_by_email((select v from ids where k = 'c'), 'owner@p6bc.test', 'owner');
+select public.add_member_by_email((select v from ids where k = 'c'), 'member@p6bc.test', 'member');
+select pg_temp.reset_user();
+
+-- 1. Agency plans and the client-account limit
+select pg_temp.as_user('61000000-0000-0000-0000-000000000004');
+select pg_temp.expect_error($$select public.govern_organization((select v from ids where k = 'c'), null, 'agency-solo')$$, 'agency plans cannot be assigned to clients');
+select pg_temp.expect((select count(*) = 8 from public.org_usage((select v from ids where k = 'x'))), 'agencies see their client-account usage');
+select pg_temp.expect((select count(*) = 7 from public.org_usage((select v from ids where k = 'c'))), 'clients do not get the client-account metric');
+select pg_temp.reset_user();
+select pg_temp.as_user('61000000-0000-0000-0000-000000000001');
+select public.govern_organization((select v from ids where k = 'x'), null, 'agency-solo');
+select pg_temp.expect_error($$select public.govern_organization((select v from ids where k = 'x'), null, 'starter')$$, 'client plans cannot be assigned to agencies');
+select pg_temp.reset_user();
+select pg_temp.as_service();
+update public.organizations set plan = 'agency-inactive' where id = (select v from ids where k = 'x');
+select pg_temp.reset_user();
+select pg_temp.as_user('61000000-0000-0000-0000-000000000004');
+select pg_temp.expect_error($$select public.create_organization('Client B Over', 'client', (select v from ids where k = 'x'))$$, 'the client-account limit is enforced');
+select pg_temp.reset_user();
+select pg_temp.as_service();
+update public.organizations set plan = 'internal' where id = (select v from ids where k = 'x');
+select pg_temp.reset_user();
+
+select pg_temp.as_user('61000000-0000-0000-0000-000000000001');
+select public.govern_organization((select v from ids where k = 'y'), null, 'agency-inactive');
+select pg_temp.expect((select plan = 'agency-inactive' from public.organizations where id = (select v from ids where k = 'y')), 'staff can mark an agency as needing a subscription');
+select public.govern_organization((select v from ids where k = 'y'), null, 'agency-scale');
+select pg_temp.reset_user();
+
+-- 2. Platform subscriptions are written by the server only
+select pg_temp.as_user('61000000-0000-0000-0000-000000000004');
+select pg_temp.expect_error($$insert into public.platform_subscriptions(organization_id, stripe_customer_id, status) values ((select v from ids where k = 'x'), 'cus_fake', 'active')$$,
+  'agencies cannot write their own subscription');
+select pg_temp.reset_user();
+
+-- 3. Client rebilling
+select pg_temp.as_user('61000000-0000-0000-0000-000000000004');
+with c as (insert into public.contacts(organization_id, first_name, email) values ((select v from ids where k = 'x'), 'Client C billing', 'billing@p6bc.test') returning id)
+insert into ids select 'xc', id from c;
+insert into public.client_billing(client_org_id, agency_org_id, contact_id, plan_fee_cents, rates)
+values ((select v from ids where k = 'c'), (select v from ids where k = 'x'), (select v from ids where k = 'xc'), 19700, '{"sms": 3, "ai_request": 0.5}');
+select pg_temp.expect((select count(*) = 1 from public.client_billing), 'agency admins set billing for their client');
+select pg_temp.expect_error($$update public.client_billing set rates = '{"sms": -1}'$$, 'negative rates are rejected');
+select pg_temp.expect_error($$update public.client_billing set rates = '{"minutes": 1}'$$, 'unknown usage types are rejected');
+insert into public.client_billing_runs(agency_org_id, client_org_id, period_start) values ((select v from ids where k = 'x'), (select v from ids where k = 'c'), '2026-09-01');
+select pg_temp.expect_error($$insert into public.client_billing_runs(agency_org_id, client_org_id, period_start) values ((select v from ids where k = 'x'), (select v from ids where k = 'c'), '2026-09-01')$$,
+  'a client is billed once per month');
+select pg_temp.reset_user();
+select pg_temp.as_user('61000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$insert into public.client_billing(client_org_id, agency_org_id, contact_id) values ((select v from ids where k = 'c'), (select v from ids where k = 'y'), (select v from ids where k = 'xc'))$$,
+  'another agency cannot bill the client');
+select pg_temp.reset_user();
+select pg_temp.as_user('61000000-0000-0000-0000-000000000002');
+select pg_temp.expect((select count(*) = 0 from public.client_billing), 'clients do not see the agency''s rates');
+select pg_temp.expect((select count(*) >= 0 from public.usage_for_period((select v from ids where k = 'c'), '2026-10-01')), 'clients can see their own monthly usage');
+select pg_temp.reset_user();
+select pg_temp.as_user('61000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$select * from public.usage_for_period((select v from ids where k = 'c'), '2026-10-01')$$, 'outsiders cannot read a client''s usage');
+select pg_temp.reset_user();
+
+select pg_temp.as_service();
+select pg_temp.expect((select count(*) >= 0 from public.usage_for_period((select v from ids where k = 'c'), '2026-10-01')), 'the scheduler can read monthly usage');
+select pg_temp.reset_user();
+
+-- 4. Invitations
+select pg_temp.as_user('61000000-0000-0000-0000-000000000005');
+select pg_temp.expect_error($$select public.create_invitation((select v from ids where k = 'c'), 'new@p6b.test', 'member')$$, 'members cannot invite');
