+        {s && <div className="small">Status: <span className={`pill ${live ? (s.status === "past_due" ? "pill-warn" : "pill-ok") : "pill-bad"}`}>{s.status.replace("_", " ")}</span>{s.plan_key ? ` · ${data.plans.find((p) => p.key === s.plan_key)?.name ?? s.plan_key}` : ""}{s.current_period_end ? ` · ${s.cancel_at_period_end ? "ends" : "renews"} ${new Date(s.current_period_end).toLocaleDateString()}` : ""}</div>}
