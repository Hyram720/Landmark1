@@ -0,0 +1,37 @@
+import "server-only";
+
+// Adds or removes a domain alias on the Netlify site that serves the console,
+// so a verified custom domain gets an HTTPS certificate without manual steps.
+// Optional: without NETLIFY_API_TOKEN and NETLIFY_SITE_ID the UI shows the manual step.
+type Result = { configured: boolean; ok: boolean; message: string };
+type Fetch = typeof fetch;
+
+export function netlifyConfigured() {
+  return !!(process.env.NETLIFY_API_TOKEN?.trim() && process.env.NETLIFY_SITE_ID?.trim());
+}
+
+async function aliases(op: "add" | "remove", domain: string, f: Fetch = fetch): Promise<Result> {
+  const token = process.env.NETLIFY_API_TOKEN?.trim();
+  const site = process.env.NETLIFY_SITE_ID?.trim();
+  if (!token || !site) return { configured: false, ok: false, message: "Add the domain as a domain alias in Netlify (automatic setup not configured: NETLIFY_API_TOKEN, NETLIFY_SITE_ID)." };
+  if (!/^[A-Za-z0-9-]{3,64}$/.test(site)) return { configured: true, ok: false, message: "NETLIFY_SITE_ID looks wrong." };
+  const url = `https://api.netlify.com/api/v1/sites/${site}`;
+  const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };
+  try {
+    const r = await f(url, { headers, signal: AbortSignal.timeout(15000) });
+    if (!r.ok) return { configured: true, ok: false, message: `Netlify refused the request (${r.status}). Check the token's access.` };
+    const s = (await r.json()) as { custom_domain?: string | null; domain_aliases?: string[] };
+    const current = (s.domain_aliases || []).map((d) => d.toLowerCase());
+    if (s.custom_domain?.toLowerCase() === domain) return { configured: true, ok: true, message: "Already the site's main domain." };
+    const next = op === "add" ? Array.from(new Set([...current, domain])) : current.filter((d) => d !== domain);
+    if (next.length === current.length && next.every((d, i) => d === current[i])) return { configured: true, ok: true, message: op === "add" ? "Already set up on Netlify." : "Not on Netlify." };
+    const u = await f(url, { method: "PATCH", headers, body: JSON.stringify({ domain_aliases: next }), signal: AbortSignal.timeout(15000) });
+    if (!u.ok) return { configured: true, ok: false, message: `Netlify could not ${op} the domain (${u.status}).` };
+    return { configured: true, ok: true, message: op === "add" ? "Added on Netlify; the HTTPS certificate is issued automatically within minutes." : "Removed from Netlify." };
+  } catch {
+    return { configured: true, ok: false, message: "Netlify did not respond. Try again." };
+  }
+}
+
+export const addDomainAlias = (domain: string, f?: Fetch) => aliases("add", domain, f);
+export const removeDomainAlias = (domain: string, f?: Fetch) => aliases("remove", domain, f);
