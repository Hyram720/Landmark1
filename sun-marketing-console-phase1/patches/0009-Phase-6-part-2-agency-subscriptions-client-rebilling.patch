diff --git a/src/lib/tenant/agency.ts b/src/lib/tenant/agency.ts
new file mode 100644
index 0000000..dfdb639
--- /dev/null
+++ b/src/lib/tenant/agency.ts
@@ -0,0 +1,72 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { domainInput } from "@/lib/sites/domains";
+
+// Account transfers between agencies and white-label console domains.
+export const transferInput = z.object({
+  organization_id: z.string().uuid(),
+  to_agency: z.string().trim().toLowerCase().regex(/^[a-z0-9-]{3,60}$/, "Enter the receiving agency's account ID."),
+  note: z.string().trim().max(500).optional(),
+});
+export const decisionInput = z.object({ decision: z.enum(["approve", "accept", "decline", "cancel"]) });
+
+export async function listTransfers(client: SupabaseClient) {
+  const { data, error } = await client.from("org_transfers")
+    .select("id, organization_id, from_agency_id, to_agency_id, status, client_approved_at, agency_accepted_at, note, created_at, decided_at")
+    .order("created_at", { ascending: false }).limit(50);
+  fromDb(error);
+  const ids = Array.from(new Set((data || []).flatMap((t) => [t.organization_id, t.from_agency_id, t.to_agency_id])));
+  const { data: orgs } = ids.length ? await client.from("organizations").select("id, name").in("id", ids) : { data: [] };
+  const name = new Map((orgs || []).map((o) => [o.id, o.name as string]));
+  return (data || []).map((t) => ({ ...t, organization_name: name.get(t.organization_id) ?? "Client account", from_name: name.get(t.from_agency_id) ?? "Current agency", to_name: name.get(t.to_agency_id) ?? "Receiving agency" }));
+}
+
+export async function requestTransfer(client: SupabaseClient, input: z.infer<typeof transferInput>) {
+  const { data, error } = await client.rpc("request_transfer", { p_org: input.organization_id, p_to_agency_slug: input.to_agency, p_note: input.note ?? null });
+  if (error?.code === "P0002") throw new ApiError(error.message, 404, "not_found");
+  if (error?.code === "23505") throw new ApiError("A transfer is already pending for this account.", 409, "conflict");
+  fromDb(error);
+  return String(data);
+}
+
+export async function decideTransfer(client: SupabaseClient, id: string, decision: z.infer<typeof decisionInput>["decision"]) {
+  const { data, error } = await client.rpc("decide_transfer", { p_id: id, p_decision: decision });
+  if (error?.code === "P0002") throw new ApiError("This transfer is no longer pending.", 409, "conflict");
+  if (error?.code === "53400") throw new ApiError("The receiving agency has reached its client-account limit.", 402, "plan_limit");
+  fromDb(error);
+  return String(data);
+}
+
+export async function listAppDomains(client: SupabaseClient, orgId: string) {
+  const { data, error } = await client.from("app_domains").select("id, domain, verification_token, status, verified_at, last_checked_at, created_at").eq("organization_id", orgId).order("created_at");
+  fromDb(error);
+  return data || [];
+}
+
+export async function addAppDomain(client: SupabaseClient, orgId: string, input: z.infer<typeof domainInput>) {
+  const { data, error } = await client.from("app_domains").insert({ organization_id: orgId, domain: input.domain }).select("id, domain, verification_token, status").single();
+  if (error?.code === "23505") throw new ApiError("That domain is already connected.", 409, "conflict");
+  if (error?.code === "42501") throw new ApiError("Only agencies can use their own sign-in domain.", 403, "forbidden");
+  fromDb(error);
+  await audit(client, orgId, "organization.domain_added", null, { domain: input.domain });
+  return data!;
+}
+
+export type Brand = { name: string; logo_url?: string | null; color?: string | null; support_email?: string | null };
+
+// Branding for a host name (an agency's verified console domain), cached briefly.
+const cache = new Map<string, { brand: Brand | null; until: number }>();
+export async function brandForHost(system: SupabaseClient | null, host: string): Promise<Brand | null> {
+  const h = host.toLowerCase().split(":")[0];
+  if (!system || !/^[a-z0-9.-]{3,253}$/.test(h)) return null;
+  const hit = cache.get(h);
+  if (hit && hit.until > Date.now()) return hit.brand;
+  const { data } = await system.rpc("brand_for_domain", { p_domain: h });
+  const brand = (data as Brand | null) ?? null;
+  if (cache.size > 1000) cache.clear();
+  cache.set(h, { brand, until: Date.now() + 60_000 });
+  return brand;
+}
diff --git a/src/lib/tenant/invitations.ts b/src/lib/tenant/invitations.ts
new file mode 100644
index 0000000..b2adf73
--- /dev/null
+++ b/src/lib/tenant/invitations.ts
@@ -0,0 +1,89 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { sendPlatformEmail } from "@/lib/platform/email";
+
+// Email invitations. The database creates the token, stores only its hash,
+// checks the inviter's rights and the plan's seat limit, and requires the
+// accepting account's email to match.
+export const inviteInput = z.object({
+  email: z.string().trim().toLowerCase().email("Enter a valid email address.").max(254),
+  role: z.enum(["owner", "admin", "manager", "member", "viewer"]),
+});
+export const TOKEN = /^[0-9a-f]{48}$/;
+
+export async function listInvitations(client: SupabaseClient, orgId: string) {
+  const { data, error } = await client.from("invitations").select("id, email, role, status, expires_at, created_at, accepted_at")
+    .eq("organization_id", orgId).order("created_at", { ascending: false }).limit(50);
+  fromDb(error);
+  return data || [];
+}
+
+export async function invite(client: SupabaseClient, orgId: string, input: z.infer<typeof inviteInput>, req?: Request) {
+  const base = publicBaseUrl(req);
+  if (!base) throw new ApiError("Integration not configured: set PUBLIC_APP_URL so invitation links work.", 503, "integration_not_configured");
+  const { data: token, error } = await client.rpc("create_invitation", { p_org: orgId, p_email: input.email, p_role: input.role });
+  fromDb(error);
+  const { data: org } = await client.from("organizations").select("name, branding, parent_id").eq("id", orgId).single();
+  const brand = await senderBrand(client, org);
+  const link = `${base}/join/${token}`;
+  const text = `Hello,\n\nYou've been invited to join ${org!.name} on ${brand} as ${input.role === "admin" || input.role === "owner" ? "an" : "a"} ${input.role}.\n\nAccept the invitation here (the link works for 7 days):\n${link}\n\nIf you weren't expecting this, you can ignore this email.`;
+  const delivery = await sendPlatformEmail(input.email, `You're invited to ${org!.name}`, text, brand);
+  return { link, delivery };
+}
+
+// The name invitations come from: the managing agency's brand, else the platform's.
+async function senderBrand(client: SupabaseClient, org: { name: string; branding: Record<string, string> | null; parent_id: string | null } | null) {
+  if (org?.parent_id) {
+    const { data: parent } = await client.from("organizations").select("name, branding").eq("id", org.parent_id).maybeSingle();
+    if (parent) return (parent.branding as Record<string, string> | null)?.display_name || parent.name;
+  }
+  return org?.branding?.display_name || process.env.PLATFORM_NAME || "Sun Marketing";
+}
+
+export async function revokeInvitation(client: SupabaseClient, orgId: string, id: string) {
+  const { data, error } = await client.from("invitations").update({ status: "revoked" }).eq("organization_id", orgId).eq("id", id).eq("status", "pending").select("id").maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("That invitation is no longer pending.", 409, "conflict");
+}
+
+export async function previewInvitation(system: SupabaseClient, token: string) {
+  if (!TOKEN.test(token)) return null;
+  const { data, error } = await system.rpc("invitation_preview", { p_token: token });
+  fromDb(error);
+  const row = (data as { organization_id: string; organization_name: string; email: string; role: string; valid: boolean }[] | null)?.[0];
+  if (!row) return null;
+  const { data: exists } = await system.rpc("auth_email_exists", { p_email: row.email });
+  return { organization: row.organization_name, email: row.email, role: row.role, valid: row.valid, account_exists: exists === true };
+}
+
+export const joinInput = z.object({
+  password: z.string().min(10, "Use at least 10 characters.").max(200),
+  name: z.string().trim().max(120).optional(),
+});
+
+type Session = { access_token: string; refresh_token: string; expires_in: number };
+
+// New person: creates their account (the invitation link proves the email,
+// since it was sent there), signs them in and accepts as them.
+export async function joinWithNewAccount(system: SupabaseClient, token: string, input: z.infer<typeof joinInput>, signIn: (email: string, password: string) => Promise<Session | null>, asUser: (accessToken: string) => SupabaseClient) {
+  const p = await previewInvitation(system, token);
+  if (!p || !p.valid) throw new ApiError("This invitation is no longer valid. Ask for a new one.", 410, "not_found");
+  if (p.account_exists) throw new ApiError("You already have an account. Sign in to accept.", 409, "conflict");
+  const { error } = await system.auth.admin.createUser({ email: p.email, password: input.password, email_confirm: true, user_metadata: input.name ? { full_name: input.name } : undefined });
+  if (error) throw new ApiError(/already/i.test(error.message) ? "You already have an account. Sign in to accept." : "Your account could not be created.", 409, "conflict");
+  const session = await signIn(p.email, input.password);
+  if (!session) throw new ApiError("Your account was created, but signing in failed. Sign in to accept.", 502, "server_error");
+  await acceptAs(asUser(session.access_token), token);
+  return session;
+}
+
+export async function acceptAs(client: SupabaseClient, token: string) {
+  if (!TOKEN.test(token)) throw new ApiError("This invitation is no longer valid.", 410, "not_found");
+  const { data, error } = await client.rpc("accept_invitation", { p_token: token });
+  if (error?.code === "P0002") throw new ApiError("This invitation is no longer valid. Ask for a new one.", 410, "not_found");
+  fromDb(error);
+  return String(data);
+}
