+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { isValidTimeZone, zonedParts, zonedToUtc } from "@/lib/time/zones";
+
+// The home screen: what needs attention today, a few numbers, and what is
+// left to set up. Every query runs as the signed-in person (RLS applies).
+export type Attention = { key: string; tone: "bad" | "warn" | "info"; text: string; href: string; count: number };
+export type SetupStep = { key: string; label: string; done: boolean; href: string; why: string };
+
+export function dayBounds(now: Date, tz: string) {
+  const zone = isValidTimeZone(tz) ? tz : "America/New_York";
+  const p = zonedParts(now, zone);
+  const start = zonedToUtc(p.year, p.month, p.day, 0, 0, zone);
+  const tomorrow = new Date(Date.UTC(p.year, p.month - 1, p.day + 1));
+  const end = zonedToUtc(tomorrow.getUTCFullYear(), tomorrow.getUTCMonth() + 1, tomorrow.getUTCDate(), 0, 0, zone);
+  return { start, end, hour: p.hour, zone };
+}
+
+export function greeting(hour: number) {
+  return hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
+}
+
+// Pure: turns counts into an ordered "needs attention" list (most urgent first).
+export function attentionList(c: { unread: number; overdueTasks: number; dueToday: number; negativeUnanswered: number; unansweredReviews: number; approvals: number; overdueInvoices: number; nearLimits: string[] }): Attention[] {
+  const out: Attention[] = [];
+  const s = (n: number, one: string, many: string) => (n === 1 ? one : many);
+  if (c.negativeUnanswered) out.push({ key: "negative", tone: "bad", count: c.negativeUnanswered, href: "/trust", text: `${c.negativeUnanswered} unhappy ${s(c.negativeUnanswered, "review needs", "reviews need")} a reply` });
+  if (c.unread) out.push({ key: "unread", tone: "bad", count: c.unread, href: "/inbox", text: `${c.unread} ${s(c.unread, "conversation is", "conversations are")} waiting for a reply` });
+  if (c.overdueTasks) out.push({ key: "overdue", tone: "warn", count: c.overdueTasks, href: "/crm?view=tasks", text: `${c.overdueTasks} overdue ${s(c.overdueTasks, "task", "tasks")}` });
+  if (c.approvals) out.push({ key: "approvals", tone: "warn", count: c.approvals, href: "/command-center", text: `${c.approvals} AI ${s(c.approvals, "action waits", "actions wait")} for approval` });
+  if (c.overdueInvoices) out.push({ key: "invoices", tone: "warn", count: c.overdueInvoices, href: "/invoices", text: `${c.overdueInvoices} ${s(c.overdueInvoices, "invoice is", "invoices are")} past due` });
+  if (c.nearLimits.length) out.push({ key: "limits", tone: "warn", count: c.nearLimits.length, href: "/account", text: `Close to your plan limit: ${c.nearLimits.join(", ")}` });
+  const otherReviews = c.unansweredReviews - c.negativeUnanswered;
+  if (otherReviews > 0) out.push({ key: "reviews", tone: "info", count: otherReviews, href: "/trust", text: `${otherReviews} ${s(otherReviews, "review", "reviews")} without a reply` });
+  if (c.dueToday) out.push({ key: "today", tone: "info", count: c.dueToday, href: "/crm?view=tasks", text: `${c.dueToday} ${s(c.dueToday, "task", "tasks")} due today` });
+  return out;
+}
+
+const count = async (q: PromiseLike<{ count: number | null; error: unknown }>) => {
+  const r = await q;
+  return r.error ? 0 : r.count ?? 0;
+};
+
+export async function homeSummary(client: SupabaseClient, org: { id: string; kind: string }, userId: string, now = new Date()) {
+  const o = org.id;
+  const { data: orgRow } = await client.from("organizations").select("name, timezone").eq("id", o).maybeSingle();
+  const { start, end, hour, zone } = dayBounds(now, orgRow?.timezone || "America/New_York");
+  const iso = (d: Date) => d.toISOString();
+  const week = new Date(now.getTime() - 7 * 86400000).toISOString();
+  const prevWeek = new Date(now.getTime() - 14 * 86400000).toISOString();
+  const month = new Date(now.getTime() - 30 * 86400000).toISOString();
+  const head = { count: "exact" as const, head: true };
+
+  const [
+    newLeads, prevLeads, unread, overdueTasks, dueToday, approvals, negativeUnanswered, unansweredReviews,
+    apptsRes, tasksRes, convRes, reviewsRes, invoicesRes, usageRes, leadsRes,
+    smsAcct, emailAcct, calendars, forms, liveSites, knowledge, payAcct, workflows, members,
+  ] = await Promise.all([
+    count(client.from("contacts").select("id", head).eq("organization_id", o).is("erased_at", null).gte("created_at", week)),
+    count(client.from("contacts").select("id", head).eq("organization_id", o).is("erased_at", null).gte("created_at", prevWeek).lt("created_at", week)),
+    count(client.from("conversations").select("id", head).eq("organization_id", o).eq("status", "open").gt("unread_count", 0)),
+    count(client.from("tasks").select("id", head).eq("organization_id", o).eq("status", "open").lt("due_at", iso(start))),
+    count(client.from("tasks").select("id", head).eq("organization_id", o).eq("status", "open").gte("due_at", iso(start)).lt("due_at", iso(end))),
+    count(client.from("ai_actions").select("id", head).eq("organization_id", o).eq("status", "pending_approval")),
+    count(client.from("reviews").select("id", head).eq("organization_id", o).eq("response_status", "none").lte("rating", 2)),
+    count(client.from("reviews").select("id", head).eq("organization_id", o).eq("response_status", "none").gte("published_at", month)),
+    client.from("appointments").select("id, starts_at, ends_at, status, title, contacts(first_name, last_name)").eq("organization_id", o)
+      .in("status", ["booked", "confirmed"]).gte("starts_at", iso(now)).order("starts_at").limit(6),
+    client.from("tasks").select("id, title, due_at, priority, contact_id").eq("organization_id", o).eq("status", "open").lt("due_at", iso(end))
+      .order("due_at").limit(6),
+    client.from("conversations").select("id, contact_id, channel, last_message_at, last_message_preview, unread_count, contacts(first_name, last_name, email, phone)")
+      .eq("organization_id", o).eq("status", "open").gt("unread_count", 0).order("last_message_at", { ascending: false }).limit(5),
+    client.from("reviews").select("rating, published_at").eq("organization_id", o).gte("published_at", new Date(now.getTime() - 90 * 86400000).toISOString()).limit(2000),
+    client.from("invoices").select("total_cents, amount_paid_cents, due_date, status").eq("organization_id", o).eq("kind", "invoice").in("status", ["sent", "partially_paid"]).limit(1000),
+    client.rpc("org_usage", { p_org: o }),
+    client.from("contacts").select("id, first_name, last_name, email, phone, source, created_at").eq("organization_id", o).is("erased_at", null)
+      .order("created_at", { ascending: false }).limit(5),
+    count(client.from("provider_accounts").select("id", head).eq("organization_id", o).eq("status", "active").eq("channel", "sms")),
+    count(client.from("provider_accounts").select("id", head).eq("organization_id", o).eq("status", "active").eq("channel", "email")),
+    count(client.from("calendars").select("id", head).eq("organization_id", o)),
+    count(client.from("forms").select("id", head).eq("organization_id", o).eq("status", "active")),
+    count(client.from("sites").select("id", head).eq("organization_id", o).eq("status", "published")),
+    count(client.from("knowledge_items").select("id", head).eq("organization_id", o).eq("status", "approved")),
+    count(client.from("payment_accounts").select("id", head).eq("organization_id", o).eq("status", "active")),
+    count(client.from("workflows").select("id", head).eq("organization_id", o).eq("status", "active")),
+    count(client.from("memberships").select("user_id", head).eq("organization_id", o).eq("status", "active")),
+  ]);
+
+  const ratings = ((reviewsRes.data || []) as { rating: number }[]).map((r) => r.rating);
+  const today = now.toISOString().slice(0, 10);
+  const open = (invoicesRes.data || []) as { total_cents: number; amount_paid_cents: number; due_date: string | null }[];
+  const outstanding = open.reduce((s, i) => s + i.total_cents - i.amount_paid_cents, 0);
+  const overdueInvoices = open.filter((i) => i.due_date && i.due_date < today).length;
+  const nearLimits = ((usageRes.data || []) as { metric: string; used: number; limit: number | null }[])
+    .filter((u) => u.limit != null && u.limit > 0 && u.used / u.limit >= 0.8)
+    .map((u) => u.metric.replace("_", " "));
+  const todayAppts = ((apptsRes.data || []) as { starts_at: string }[]).filter((a) => a.starts_at < iso(end)).length;
+
+  const setup: SetupStep[] = [
