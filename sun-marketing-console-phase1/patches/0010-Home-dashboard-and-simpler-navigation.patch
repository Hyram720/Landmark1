diff --git a/src/app/home/page.tsx b/src/app/home/page.tsx
new file mode 100644
index 0000000..a8e6982
--- /dev/null
+++ b/src/app/home/page.tsx
@@ -0,0 +1,144 @@
+"use client";
+import Link from "next/link";
+import TenantGate, { ErrorState, Loading } from "@/components/tenant/TenantGate";
+import { Org, personName, relativeTime, useResource } from "@/components/tenant/client";
+
+type Person = { first_name: string | null; last_name: string | null; email?: string | null; phone?: string | null };
+type Home = {
+  greeting: string; organization: string; timezone: string;
+  numbers: { new_leads: number; previous_leads: number; appointments_today: number; unread: number; rating: number | null; reviews_90d: number; outstanding_cents: number };
+  attention: { key: string; tone: "bad" | "warn" | "info"; text: string; href: string }[];
+  appointments: { id: string; starts_at: string; status: string; title: string | null; contacts: Person | null }[];
+  tasks: { id: string; title: string; due_at: string | null; priority: string }[];
+  conversations: { id: string; contact_id: string; channel: string; last_message_at: string | null; last_message_preview: string | null; unread_count: number; contacts: Person | null }[];
+  leads: (Person & { id: string; source: string | null; created_at: string })[];
+  setup: { key: string; label: string; done: boolean; href: string; why: string }[];
+  is_agency: boolean;
+};
+const usd = (c: number) => (c / 100).toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
+const TONE = { bad: "pill-bad", warn: "pill-warn", info: "pill-info" } as const;
+const TONE_LABEL = { bad: "Urgent", warn: "Soon", info: "FYI" } as const;
+
+function Tile({ label, value, detail, href }: { label: string; value: string; detail: string; href: string }) {
+  return (
+    <Link href={href} className="card stat home-tile">
+      <div className="k">{label}</div>
+      <div className="v">{value}</div>
+      <div className="d">{detail}</div>
+    </Link>
+  );
+}
+
+function trend(now: number, before: number) {
+  if (!before && !now) return "None in the last 2 weeks";
+  if (!before) return "Up from none the week before";
+  const pct = Math.round(((now - before) / before) * 100);
+  return pct === 0 ? "Same as the week before" : `${pct > 0 ? "▲ Up" : "▼ Down"} ${Math.abs(pct)}% from the week before`;
+}
+
+function Dashboard({ org }: { org: Org }) {
+  const { data, error, loading, reload } = useResource<Home>("/api/home");
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return null;
+  const n = data.numbers;
+  const left = data.setup.filter((s) => !s.done);
+  const time = (iso: string) => new Date(iso).toLocaleString("en-US", { timeZone: data.timezone, weekday: "short", hour: "numeric", minute: "2-digit" });
+  return (
+    <div className="stack home">
+      <div className="spread" style={{ flexWrap: "wrap" }}>
+        <div><h2 style={{ fontSize: 22 }}>{data.greeting}</h2><div className="small muted">Here&apos;s what&apos;s happening at {data.organization} today.</div></div>
+        <div className="row home-actions">
+          <Link className="btn btn-sm btn-primary" href="/command-center">Ask the AI</Link>
+          <Link className="btn btn-sm" href="/crm?new=1">Add contact</Link>
+          <Link className="btn btn-sm" href="/inbox">Send a message</Link>
+          <Link className="btn btn-sm" href="/calendars">Book appointment</Link>
+          <Link className="btn btn-sm" href="/invoices">New invoice</Link>
+        </div>
+      </div>
+
+      <div className="home-tiles">
+        <Tile label="New leads (7 days)" value={String(n.new_leads)} detail={trend(n.new_leads, n.previous_leads)} href="/crm" />
+        <Tile label="Appointments today" value={String(n.appointments_today)} detail={data.appointments.length ? `Next: ${time(data.appointments[0].starts_at)}` : "Nothing booked yet"} href="/calendars" />
+        <Tile label="Waiting for a reply" value={String(n.unread)} detail={n.unread ? "Reply fast to win the job" : "Inbox is clear"} href="/inbox" />
+        <Tile label="Star rating (90 days)" value={n.rating != null ? `${n.rating.toFixed(1)} ★` : "—"} detail={`${n.reviews_90d} ${n.reviews_90d === 1 ? "review" : "reviews"}`} href="/trust" />
+        <Tile label="Owed to you" value={usd(n.outstanding_cents)} detail="Open invoices" href="/invoices" />
+      </div>
+
+      <div className="card">
+        <div className="card-head"><div><h3>Needs your attention</h3><div className="sub">Most urgent first.</div></div></div>
+        {data.attention.length === 0 ? <div className="card-pad small">You&apos;re all caught up. Nice work.</div> : (
+          <div className="home-list">
+            {data.attention.map((a) => (
+              <Link key={a.key} href={a.href} className="home-item">
+                <span className={`pill ${TONE[a.tone]}`}>{TONE_LABEL[a.tone]}</span>
+                <span className="small">{a.text}</span>
+                <span className="small muted" aria-hidden>›</span>
+              </Link>
+            ))}
+          </div>
+        )}
+      </div>
+
+      <div className="grid g2 home-grid">
+        <div className="card">
+          <div className="card-head"><div><h3>Coming up</h3><div className="sub">Next appointments</div></div><Link className="link small" href="/calendars">Calendar</Link></div>
+          {data.appointments.length === 0 ? <div className="card-pad small muted">No upcoming appointments. Share your booking link to fill the calendar.</div> : (
+            <div className="home-list">{data.appointments.map((a) => (
+              <div key={a.id} className="home-item static"><strong className="small" style={{ minWidth: 92 }}>{time(a.starts_at)}</strong><span className="small">{a.title || "Appointment"} · {personName(a.contacts)}</span>{a.status === "confirmed" ? <span className="pill pill-ok">confirmed</span> : <span />}</div>
+            ))}</div>
+          )}
+        </div>
+        <div className="card">
+          <div className="card-head"><div><h3>Tasks due</h3><div className="sub">Today and overdue</div></div><Link className="link small" href="/crm?view=tasks">All tasks</Link></div>
+          {data.tasks.length === 0 ? <div className="card-pad small muted">Nothing due. Follow-ups you or the AI create show up here.</div> : (
+            <div className="home-list">{data.tasks.map((t) => {
+              const overdue = t.due_at && new Date(t.due_at) < new Date(new Date().setHours(0, 0, 0, 0));
+              return <Link key={t.id} href="/crm?view=tasks" className="home-item"><span className={`pill ${overdue ? "pill-bad" : "pill-neutral"}`}>{overdue ? "overdue" : "today"}</span><span className="small">{t.title}</span><span className="tiny muted">{t.priority === "high" ? "high priority" : ""}</span></Link>;
+            })}</div>
+          )}
+        </div>
+        <div className="card">
+          <div className="card-head"><div><h3>Waiting for a reply</h3><div className="sub">Newest first</div></div><Link className="link small" href="/inbox">Inbox</Link></div>
+          {data.conversations.length === 0 ? <div className="card-pad small muted">No unanswered messages.</div> : (
+            <div className="home-list">{data.conversations.map((c) => (
+              <Link key={c.id} href={`/inbox?contact=${c.contact_id}&channel=${c.channel}`} className="home-item"><span className="pill pill-neutral">{c.channel === "sms" ? "text" : "email"}</span><span className="small" style={{ minWidth: 0 }}><strong>{personName(c.contacts)}</strong> <span className="muted home-preview">{c.last_message_preview}</span></span><span className="tiny muted">{relativeTime(c.last_message_at)}</span></Link>
+            ))}</div>
+          )}
+        </div>
+        <div className="card">
+          <div className="card-head"><div><h3>Newest leads</h3><div className="sub">Latest contacts</div></div><Link className="link small" href="/crm">CRM</Link></div>
+          {data.leads.length === 0 ? <div className="card-pad small muted">No contacts yet. Add a lead form to your website to start collecting them.</div> : (
+            <div className="home-list">{data.leads.map((l) => (
+              <Link key={l.id} href={`/crm/contacts/${l.id}`} className="home-item"><span className="small"><strong>{personName(l)}</strong></span><span className="tiny muted">{l.source || ""}</span><span className="tiny muted">{relativeTime(l.created_at)}</span></Link>
+            ))}</div>
+          )}
+        </div>
+      </div>
+
+      {left.length > 0 && (
+        <div className="card">
+          <div className="card-head"><div><h3>Finish setting up</h3><div className="sub">{data.setup.length - left.length} of {data.setup.length} done</div></div></div>
+          <div className="card-pad stack" style={{ gap: 10 }}>
+            <div className="home-progress" role="progressbar" aria-valuemin={0} aria-valuemax={data.setup.length} aria-valuenow={data.setup.length - left.length} aria-label="Setup progress">
+              <div style={{ width: `${Math.round(((data.setup.length - left.length) / data.setup.length) * 100)}%` }} />
+            </div>
+            <div className="home-setup">
+              {data.setup.map((s) => (
+                <Link key={s.key} href={s.href} className={`home-step ${s.done ? "done" : ""}`}>
+                  <span aria-hidden className="home-check">{s.done ? "✓" : ""}</span>
+                  <span><span className="small"><strong>{s.label}</strong>{s.done ? <span className="sr-only"> (done)</span> : null}</span><span className="tiny muted" style={{ display: "block" }}>{s.why}</span></span>
+                </Link>
+              ))}
+            </div>
+          </div>
+        </div>
+      )}
+      {data.is_agency && org.kind === "agency" && <div className="card card-pad small">Managing clients? Switch accounts from the menu at the top, or set up a new one with <Link className="link" href="/organization/new-client">Guided setup</Link>.</div>}
+    </div>
+  );
+}
+
+export default function HomePage() {
+  return <TenantGate title="Home" subtitle="Your day at a glance.">{(info) => <Dashboard org={info.org} />}</TenantGate>;
+}
