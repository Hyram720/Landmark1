+import { describe, expect, it } from "vitest";
+import { attentionList, dayBounds, greeting } from "@/lib/home/service";
+
+const none = { unread: 0, overdueTasks: 0, dueToday: 0, negativeUnanswered: 0, unansweredReviews: 0, approvals: 0, overdueInvoices: 0, nearLimits: [] as string[] };
+
+describe("home dashboard", () => {
+  it("lists what needs attention, most urgent first", () => {
+    const list = attentionList({ ...none, unread: 3, overdueTasks: 1, dueToday: 2, negativeUnanswered: 1, unansweredReviews: 4, approvals: 2, overdueInvoices: 1, nearLimits: ["sms"] });
+    expect(list.map((a) => a.key)).toEqual(["negative", "unread", "overdue", "approvals", "invoices", "limits", "reviews", "today"]);
+    expect(list[0]).toMatchObject({ tone: "bad", href: "/trust", text: "1 unhappy review needs a reply" });
+    expect(list.find((a) => a.key === "reviews")?.text).toBe("3 reviews without a reply");
+    expect(list.find((a) => a.key === "unread")?.text).toBe("3 conversations are waiting for a reply");
+    expect(attentionList(none)).toEqual([]);
+  });
+  it("uses the business's time zone for 'today'", () => {
+    // 03:30 UTC on Oct 8 is still Oct 7 in New York.
+    const { start, end, hour } = dayBounds(new Date("2026-10-08T03:30:00Z"), "America/New_York");
+    expect(start.toISOString()).toBe("2026-10-07T04:00:00.000Z");
+    expect(end.toISOString()).toBe("2026-10-08T04:00:00.000Z");
+    expect(hour).toBe(23);
+    expect(dayBounds(new Date("2026-10-08T03:30:00Z"), "Not/AZone").zone).toBe("America/New_York");
+  });
+  it("greets by time of day", () => {
+    expect(greeting(8)).toBe("Good morning");
+    expect(greeting(13)).toBe("Good afternoon");
+    expect(greeting(20)).toBe("Good evening");
+  });
+});
