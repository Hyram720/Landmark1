+    expect(formInput.safeParse({ name: "Q", slug: "quote", fields: [...DEFAULT_FIELDS, { ...DEFAULT_FIELDS[1] }] }).success).toBe(false);
+    expect(formInput.safeParse({ name: "Q", slug: "quote", fields: [...DEFAULT_FIELDS, { key: "size", label: "Size", type: "select", maps_to: "none" }] }).success).toBe(false);
+    expect(formInput.safeParse({ name: "Q", slug: "quote", fields: DEFAULT_FIELDS, settings: { redirect_url: "http://x.test" } }).success).toBe(false);
+  });
