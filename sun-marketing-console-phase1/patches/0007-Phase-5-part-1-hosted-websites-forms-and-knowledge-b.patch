+import { ApiError, fromDb, readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { formInput } from "@/lib/forms/definition";
+import { FORM_COLUMNS, listSubmissions, saveForm } from "@/lib/forms/service";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const GET = tenantRoute<P>("crm.read", async (ctx, _req, { id }) => {
+  const { data, error } = await ctx.client.from("forms").select(FORM_COLUMNS).eq("organization_id", ctx.org.id).eq("id", uuid.parse(id)).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Form not found.", 404, "not_found");
+  return { form: data, submissions: await listSubmissions(scoped(ctx), data.id) };
+});
+
+export const PUT = tenantRoute<P>("sites.manage", async (ctx, req, { id }) => {
+  const form = await saveForm(scoped(ctx), await readJson(req, formInput), uuid.parse(id));
+  await audit(ctx.client, ctx.org.id, "form.updated", { type: "form", id: form.id });
+  return { form };
+});
+
+export const DELETE = tenantRoute<P>("sites.manage", async (ctx, _req, { id }) => {
+  const { error } = await ctx.client.from("forms").delete().eq("organization_id", ctx.org.id).eq("id", uuid.parse(id));
+  fromDb(error);
+  await audit(ctx.client, ctx.org.id, "form.deleted", { type: "form", id });
+  return { ok: true };
+});
