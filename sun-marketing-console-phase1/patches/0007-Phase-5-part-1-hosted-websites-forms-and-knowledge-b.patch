+import { z } from "zod";
+import { ApiError, readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { can } from "@/lib/tenant/rbac";
+import { deletePage, getPage, pagePatch, publishPage, savePage, unpublishPage } from "@/lib/sites/service";
+
+export const dynamic = "force-dynamic";
+type P = { pageId: string };
+
+export const GET = tenantRoute<P>("crm.read", async (ctx, _req, { pageId }) => ({ page: await getPage(scoped(ctx), uuid.parse(pageId)) }));
+
+// Saves the draft (and title, description, address). The live page is untouched.
+export const PATCH = tenantRoute<P>("crm.write", async (ctx, req, { pageId }) => ({ page: await savePage(scoped(ctx), uuid.parse(pageId), await readJson(req, pagePatch)) }));
+
+export const POST = tenantRoute<P>("crm.write", async (ctx, req, { pageId }) => {
+  const { action } = await readJson(req, z.object({ action: z.enum(["publish", "unpublish"]) }));
+  if (!can(ctx.org.role, "sites.manage")) throw new ApiError("Only a manager or above can publish.", 403, "forbidden");
+  if (action === "publish") await publishPage(scoped(ctx), uuid.parse(pageId));
+  else await unpublishPage(scoped(ctx), uuid.parse(pageId));
+  return { ok: true };
+});
+
+export const DELETE = tenantRoute<P>("sites.manage", async (ctx, _req, { pageId }) => {
+  await deletePage(scoped(ctx), uuid.parse(pageId));
+  return { ok: true };
+});
