+import { z } from "zod";
+import { ApiError, readJson, scoped, tenantRoute } from "@/lib/tenant/api";
+import { takeLimit } from "@/lib/rate-limit";
+import { createSite, listSites, siteInput } from "@/lib/sites/service";
+import { INDUSTRIES } from "@/lib/sites/templates";
+import { draftSiteContent } from "@/lib/sites/drafter";
+import { searchKnowledge } from "@/lib/knowledge/service";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+export const GET = tenantRoute("crm.read", async (ctx) => ({ sites: await listSites(scoped(ctx)), industries: INDUSTRIES.map((i) => ({ key: i.key, label: i.label })) }));
+
+// Creates a site with a home page draft from the industry template, or with
+// AI-written copy based on approved knowledge. Nothing is live until published.
+export const POST = tenantRoute("crm.write", async (ctx, req) => {
+  const input = await readJson(req, siteInput.extend({ use_ai: z.boolean().optional(), notes: z.string().trim().max(2000).optional() }));
+  const c = scoped(ctx);
+  let content;
+  let model: string | null = null;
+  if (input.use_ai) {
+    if (!(await takeLimit("site-draft", ctx.session.user.id, 10, 3600))) throw new ApiError("Too many AI drafts this hour.", 429, "rate_limited");
+    const knowledge = await searchKnowledge(c, "", 25);
+    const drafted = await draftSiteContent({ business: input.business_name, industry: INDUSTRIES.find((i) => i.key === input.industry)?.label || "local", location: input.location, notes: input.notes, knowledge });
+    ({ model, ...content } = drafted);
+  }
+  const site = await createSite(c, input, content, { aiGenerated: !!input.use_ai });
+  return { site, ai_model: model };
+});
