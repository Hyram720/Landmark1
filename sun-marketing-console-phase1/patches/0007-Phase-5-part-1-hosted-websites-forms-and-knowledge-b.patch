+"use client";
+import { useEffect, useState } from "react";
+
+type Field = { key: string; label: string; type: string; required: boolean; options?: string[]; placeholder?: string };
+type PublicForm = { name: string; business: string; fields: Field[]; submit_label: string; heading?: string; intro?: string; consent_sms_text: string | null; consent_email_text: string | null };
+
+// Renders a hosted form (on /f/<slug> or inside a site page) and submits it.
+// A hidden "website" field catches simple bots.
+export default function EmbeddedForm({ slug, showHeading = true, dark = false }: { slug: string; showHeading?: boolean; dark?: boolean }) {
+  const [form, setForm] = useState<PublicForm | null>(null);
