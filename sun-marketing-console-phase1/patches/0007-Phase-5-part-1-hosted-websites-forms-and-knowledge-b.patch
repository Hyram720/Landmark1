@@ -0,0 +1,56 @@
+import "server-only";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import type { CrmContext } from "@/lib/crm/service";
+
+// The knowledge base: the business's own facts, approved by a manager before
+// the AI or generated website copy may rely on them.
+export const KINDS = ["service", "pricing", "hours", "faq", "policy", "script", "brand_voice", "other"] as const;
+export const KNOWLEDGE_COLUMNS = "id, organization_id, kind, title, body, status, version, ai_generated, approved_by, approved_at, created_by, updated_at, created_at";
+
+export const knowledgeInput = z.object({
+  kind: z.enum(KINDS),
+  title: z.string().trim().min(1, "Give it a title.").max(200),
+  body: z.string().trim().min(1, "Write the details.").max(8000),
+  status: z.enum(["draft", "approved", "archived"]).optional(),
+});
+
+export async function listKnowledge(ctx: CrmContext, opts: { status?: string; kind?: string } = {}) {
+  let q = ctx.client.from("knowledge_items").select(KNOWLEDGE_COLUMNS).eq("organization_id", ctx.orgId);
+  if (opts.status) q = q.eq("status", opts.status);
+  else q = q.neq("status", "archived");
+  if (opts.kind) q = q.eq("kind", opts.kind);
+  const { data, error } = await q.order("kind").order("title").limit(500);
+  fromDb(error);
+  return data || [];
+}
+
+export async function createKnowledge(ctx: CrmContext, input: z.infer<typeof knowledgeInput>, opts: { aiGenerated?: boolean } = {}) {
+  const { data, error } = await ctx.client.from("knowledge_items").insert({ ...input, status: input.status ?? "draft", organization_id: ctx.orgId, ai_generated: !!opts.aiGenerated })
+    .select(KNOWLEDGE_COLUMNS).single();
+  fromDb(error);
+  await audit(ctx.client, ctx.orgId, "knowledge.created", { type: "knowledge", id: data!.id }, { kind: input.kind, status: data!.status }, opts.aiGenerated ? "ai" : "user");
+  return data!;
+}
+
+export async function updateKnowledge(ctx: CrmContext, id: string, patch: Partial<z.infer<typeof knowledgeInput>>) {
+  const { data, error } = await ctx.client.from("knowledge_items").update(patch).eq("organization_id", ctx.orgId).eq("id", id).select(KNOWLEDGE_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Not found.", 404, "not_found");
+  await audit(ctx.client, ctx.orgId, patch.status === "approved" ? "knowledge.approved" : "knowledge.updated", { type: "knowledge", id }, { status: data.status, version: data.version });
+  return data;
+}
+
+export async function deleteKnowledge(ctx: CrmContext, id: string) {
+  const { error } = await ctx.client.from("knowledge_items").delete().eq("organization_id", ctx.orgId).eq("id", id);
+  fromDb(error);
+  await audit(ctx.client, ctx.orgId, "knowledge.deleted", { type: "knowledge", id });
+}
+
+// Approved items only (the database function enforces it).
+export async function searchKnowledge(ctx: { client: CrmContext["client"]; orgId: string }, query: string, limit = 8) {
+  const { data, error } = await ctx.client.rpc("search_knowledge", { p_org: ctx.orgId, p_query: query.slice(0, 200), p_limit: limit });
+  fromDb(error);
+  return (data || []) as { id: string; kind: string; title: string; body: string; rank: number }[];
+}
