+"use client";
+import { useEffect, useState } from "react";
+import TenantGate, { ErrorState, Loading } from "@/components/tenant/TenantGate";
+import { api, atLeast, Org, relativeTime, useResource } from "@/components/tenant/client";
+import { Copy, useToast } from "@/components/ui";
+
+type Site = { id: string; name: string; slug: string; status: string; pages: number; unpublished_changes: boolean; published_at: string | null; updated_at: string };
+type Opt = { slug: string; name: string };
+const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60);
+
+function NewSite({ industries, onCreated, onCancel }: { industries: { key: string; label: string }[]; onCreated: (id: string) => void; onCancel: () => void }) {
+  const forms = useResource<{ forms: Opt[] }>("/api/forms");
+  const cals = useResource<{ calendars: (Opt & { is_public: boolean })[] }>("/api/calendars");
+  const [v, setV] = useState({ business_name: "", name: "", slug: "", industry: "general", phone: "", email: "", location: "", hours: "", primary: "#0f172a", accent: "#f97316", form_slug: "", calendar_slug: "", notes: "" });
+  const [ai, setAi] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const set = (k: keyof typeof v, val: string) => setV((x) => ({ ...x, [k]: val }));
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>New website</h3><div className="sub">You get an editable draft. Nothing is public until a manager publishes it.</div></div></div>
+      <div className="card-pad stack">
+        <div className="field-grid">
+          <div className="field"><label htmlFor="ns-biz">Business name</label><input id="ns-biz" className="input" value={v.business_name} maxLength={120} onChange={(e) => { const b = e.target.value; setV((x) => ({ ...x, business_name: b, name: x.name && x.name !== x.business_name ? x.name : b, slug: x.slug && x.slug !== slugify(x.business_name) ? x.slug : slugify(b) })); }} /></div>
+          <div className="field"><label htmlFor="ns-ind">Industry</label><select id="ns-ind" className="select" value={v.industry} onChange={(e) => set("industry", e.target.value)}>{industries.map((i) => <option key={i.key} value={i.key}>{i.label}</option>)}</select></div>
+          <div className="field"><label htmlFor="ns-slug">Address</label><input id="ns-slug" className="input mono" value={v.slug} onChange={(e) => set("slug", e.target.value.toLowerCase())} /><span className="hint">/s/{v.slug || "your-site"} (custom domains come later)</span></div>
+          <div className="field"><label htmlFor="ns-phone">Phone</label><input id="ns-phone" className="input" value={v.phone} maxLength={40} onChange={(e) => set("phone", e.target.value)} /></div>
+          <div className="field"><label htmlFor="ns-email">Email</label><input id="ns-email" className="input" value={v.email} maxLength={254} onChange={(e) => set("email", e.target.value)} /></div>
+          <div className="field"><label htmlFor="ns-loc">Service area</label><input id="ns-loc" className="input" value={v.location} maxLength={120} onChange={(e) => set("location", e.target.value)} placeholder="Cherry Hill, NJ" /></div>
+          <div className="field"><label htmlFor="ns-form">Lead form</label><select id="ns-form" className="select" value={v.form_slug} onChange={(e) => set("form_slug", e.target.value)}><option value="">None</option>{forms.data?.forms.map((f) => <option key={f.slug} value={f.slug}>{f.name}</option>)}</select></div>
+          <div className="field"><label htmlFor="ns-cal">Online booking</label><select id="ns-cal" className="select" value={v.calendar_slug} onChange={(e) => set("calendar_slug", e.target.value)}><option value="">None</option>{cals.data?.calendars.filter((c) => c.is_public).map((c) => <option key={c.slug} value={c.slug}>{c.name}</option>)}</select></div>
+          <div className="field"><label htmlFor="ns-p">Main color</label><input id="ns-p" type="color" className="input" value={v.primary} onChange={(e) => set("primary", e.target.value)} /></div>
+          <div className="field"><label htmlFor="ns-a">Accent color</label><input id="ns-a" type="color" className="input" value={v.accent} onChange={(e) => set("accent", e.target.value)} /></div>
+          <div className="field" style={{ gridColumn: "1 / -1" }}><label htmlFor="ns-hours">Hours (one per line)</label><textarea id="ns-hours" className="textarea" rows={2} value={v.hours} maxLength={300} onChange={(e) => set("hours", e.target.value)} placeholder={"Mon–Fri 8am–6pm\nSat 9am–1pm"} /></div>
+        </div>
+        <label className="row small"><input type="checkbox" checked={ai} onChange={(e) => setAi(e.target.checked)} /> Have the AI write the copy from your approved Knowledge base</label>
+        {ai && <div className="field"><label htmlFor="ns-notes">Anything the AI should emphasize?</label><textarea id="ns-notes" className="textarea" rows={2} value={v.notes} maxLength={2000} onChange={(e) => set("notes", e.target.value)} placeholder="Family-owned, focus on storm repairs, mention financing" /><span className="hint">It only uses facts from approved knowledge items; anything else stays generic so you never publish a claim you can't back up.</span></div>}
+        {error && <p className="form-error" role="alert">{error}</p>}
+        <div className="row"><button className="btn btn-primary" disabled={busy || !v.business_name.trim() || v.slug.length < 3} onClick={async () => {
+          setBusy(true); setError("");
+          try {
+            const body = Object.fromEntries(Object.entries({ ...v, use_ai: ai }).filter(([, x]) => x !== ""));
+            const r = await api<{ site: { id: string } }>("/api/sites", { body });
+            onCreated(r.site.id);
+          } catch (e) { setError(e instanceof Error ? e.message : "Could not create the site."); }
+          finally { setBusy(false); }
+        }}>{busy ? <span className="spin" /> : ai ? "Write my site" : "Create site"}</button><button className="btn btn-ghost" onClick={onCancel}>Cancel</button></div>
+      </div>
+    </div>
+  );
+}
+
+function Sites({ org }: { org: Org }) {
+  const { data, error, loading, reload } = useResource<{ sites: Site[]; industries: { key: string; label: string }[] }>("/api/sites");
+  const [creating, setCreating] = useState(false);
+  const [origin, setOrigin] = useState("");
+  const { node } = useToast();
+  useEffect(() => setOrigin(window.location.origin), []);
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return null;
+  if (creating) return <NewSite industries={data.industries} onCancel={() => setCreating(false)} onCreated={(id) => { window.location.href = `/sites/${id}`; }} />;
+  return (
+    <div className="stack">
+      <div className="card">
+        <div className="card-head"><div><h3>Websites</h3><div className="sub">Hosted sites with your forms and booking built in.</div></div>{atLeast(org.role, "member") && <button className="btn btn-sm btn-primary" onClick={() => setCreating(true)}>New website</button>}</div>
+        {data.sites.length === 0 ? <div className="empty"><h3>No websites yet</h3><p className="small">Start from an industry template or let the AI write a first draft.</p></div> : (
+          <div className="table-wrap"><table><thead><tr><th>Site</th><th>Address</th><th>Status</th><th /></tr></thead><tbody>
+            {data.sites.map((s) => (
+              <tr key={s.id}>
+                <td className="small"><strong>{s.name}</strong><div className="tiny muted">{s.pages} page{s.pages === 1 ? "" : "s"} · updated {relativeTime(s.updated_at)}</div></td>
+                <td className="small">{s.status === "published" ? <div className="row" style={{ gap: 6 }}><a className="link mono tiny" href={`/s/${s.slug}`} target="_blank" rel="noreferrer">/s/{s.slug}</a><Copy text={`${origin}/s/${s.slug}`} /></div> : <span className="mono tiny muted">/s/{s.slug}</span>}</td>
+                <td><span className={`pill ${s.status === "published" ? "pill-ok" : "pill-neutral"}`}>{s.status === "published" ? "Live" : "Draft"}</span>{s.status === "published" && s.unpublished_changes && <span className="pill pill-warn" style={{ marginLeft: 4 }}>Unpublished edits</span>}</td>
+                <td><a className="btn btn-sm" href={`/sites/${s.id}`}>Open</a></td>
+              </tr>
+            ))}
+          </tbody></table></div>
+        )}
+      </div>
+      {node}
+    </div>
+  );
+}
+
+export default function SitesPage() {
+  return <TenantGate title="Websites" subtitle="Build, edit and publish your business website.">{(info) => <Sites org={info.org} />}</TenantGate>;
+}
