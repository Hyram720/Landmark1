+import { ApiError, readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { can } from "@/lib/tenant/rbac";
+import { deleteKnowledge, knowledgeInput, updateKnowledge } from "@/lib/knowledge/service";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const PATCH = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const patch = await readJson(req, knowledgeInput.partial());
+  if (patch.status === "approved" && !can(ctx.org.role, "sites.manage")) throw new ApiError("Only a manager or above can approve knowledge.", 403, "forbidden");
+  return { item: await updateKnowledge(scoped(ctx), uuid.parse(id), patch) };
+});
+
+export const DELETE = tenantRoute<P>("crm.delete", async (ctx, _req, { id }) => {
+  await deleteKnowledge(scoped(ctx), uuid.parse(id));
+  return { ok: true };
+});
