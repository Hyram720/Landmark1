+import { clientIp, takeLimit } from "@/lib/rate-limit";
+import { ApiError, errorResponse } from "@/lib/tenant/api";
+import { EMAIL_CONSENT, SMS_CONSENT } from "@/lib/forms/definition";
+import { publicForm, submitForm } from "@/lib/forms/service";
+
+export const dynamic = "force-dynamic";
+type P = { params: Promise<{ slug: string }> };
+
+async function load(slug: string) {
+  const system = systemClient();
+  if (!system) throw new ApiError("This form is not available right now.", 503, "integration_not_configured");
+  const found = await publicForm(system, slug);
+  if (!found) throw new ApiError("This form is not available.", 404, "not_found");
+  return { system, ...found };
+}
+
+export async function GET(req: Request, { params }: P) {
+  try {
+    if (!(await takeLimit("form-view", clientIp(req), 240, 600))) throw new ApiError("Too many requests.", 429, "rate_limited");
+    const { form, business } = await load((await params).slug);
+    return NextResponse.json({
+      name: form.name, business, submit_label: form.settings.submit_label || "Send", heading: form.settings.heading, intro: form.settings.intro,
+      fields: form.fields.map(({ key, label, type, required, options, placeholder }) => ({ key, label, type, required, options, placeholder })),
+      consent_sms_text: form.settings.consent_sms ? SMS_CONSENT(business) : null,
+      consent_email_text: form.settings.consent_email ? EMAIL_CONSENT(business) : null,
+    }, { headers: { "Cache-Control": "no-store" } });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
+
+export async function POST(req: Request, { params }: P) {
+  try {
+    const ip = clientIp(req);
+    if (!(await takeLimit("form-submit", ip, 8, 3600))) throw new ApiError("Too many submissions from this connection. Please call us instead.", 429, "rate_limited");
+    const { system, form, business } = await load((await params).slug);
+    const raw = await req.text();
+    if (raw.length > 32_000) throw new ApiError("That is too long.", 413, "too_large");
+    let body: { values?: Record<string, unknown>; consent_sms?: boolean; consent_email?: boolean; website?: string; page_url?: string };
+    try { body = JSON.parse(raw); } catch { throw new ApiError("Invalid request.", 400, "invalid"); }
+    // Honeypot: real visitors never fill the hidden field. Pretend success.
+    if (body.website) return NextResponse.json({ ok: true, message: form.settings.success_message, redirect_url: null });
+    const pageUrl = typeof body.page_url === "string" && /^https?:\/\//.test(body.page_url) ? body.page_url : null;
+    const result = await submitForm(system, form, business, { ...(body.values || {}), consent_sms: body.consent_sms === true, consent_email: body.consent_email === true }, {
+      ip, userAgent: req.headers.get("user-agent"), pageUrl,
+    });
+    return NextResponse.json({ ok: true, ...result });
+  } catch (e) {
+    if (e instanceof ApiError && (e as ApiError & { errors?: Record<string, string> }).errors) {
+      return NextResponse.json({ error: e.message, code: e.code, errors: (e as ApiError & { errors?: Record<string, string> }).errors }, { status: e.status });
+    }
+    return errorResponse(e);
+  }
+}
