+  const url = new URL(req.url);
+  return { items: await listKnowledge(scoped(ctx), { status: url.searchParams.get("status") || undefined, kind: url.searchParams.get("kind") || undefined }) };
+});
+
+// Members add drafts; a manager's "approved" is honored, anyone else's becomes a draft.
+export const POST = tenantRoute("crm.write", async (ctx, req) => ({ item: await createKnowledge(scoped(ctx), await readJson(req, knowledgeInput)) }));
