diff --git a/src/lib/forms/definition.ts b/src/lib/forms/definition.ts
new file mode 100644
index 0000000..ae3f6c9
--- /dev/null
+++ b/src/lib/forms/definition.ts
@@ -0,0 +1,96 @@
+import { z } from "zod";
+
+// Form definitions and submission validation. Pure: shared by the form
+// builder, the public form page and the server.
+
+export const FIELD_TYPES = ["text", "email", "phone", "textarea", "select", "checkbox"] as const;
+export const MAPS_TO = ["none", "first_name", "last_name", "email", "phone", "company", "message"] as const;
+
+export const fieldSchema = z.object({
+  key: z.string().regex(/^[a-z][a-z0-9_]{0,39}$/, "Field keys use lowercase letters, numbers and underscores."),
+  label: z.string().trim().min(1).max(120),
+  type: z.enum(FIELD_TYPES),
+  required: z.boolean().default(false),
+  options: z.array(z.string().trim().min(1).max(80)).max(30).optional(),
+  placeholder: z.string().trim().max(120).optional(),
+  maps_to: z.enum(MAPS_TO).default("none"),
+}).strict();
+export type FormField = z.infer<typeof fieldSchema>;
+
+export const settingsSchema = z.object({
+  submit_label: z.string().trim().min(1).max(40).default("Send"),
+  success_message: z.string().trim().min(1).max(500).default("Thanks! We'll be in touch shortly."),
+  redirect_url: z.string().trim().url().max(500).refine((u) => u.startsWith("https://"), "Use an https:// address.").optional(),
+  consent_sms: z.boolean().default(false),
+  consent_email: z.boolean().default(false),
+  tag: z.string().trim().min(1).max(40).optional(),
+  create_task: z.boolean().default(true),
+  heading: z.string().trim().max(120).optional(),
+  intro: z.string().trim().max(500).optional(),
+}).strict();
+export type FormSettings = z.infer<typeof settingsSchema>;
+
+export const formInput = z.object({
+  name: z.string().trim().min(1, "Name the form.").max(120),
+  slug: z.string().trim().toLowerCase().regex(/^[a-z0-9][a-z0-9-]{2,62}$/, "Use 3-63 lowercase letters, numbers and dashes."),
+  status: z.enum(["active", "inactive"]).default("active"),
+  fields: z.array(fieldSchema).min(1, "Add at least one field.").max(30),
+  settings: settingsSchema.prefault({}),
+}).superRefine((f, ctx) => {
+  const keys = new Set<string>();
+  for (const [i, field] of f.fields.entries()) {
+    if (keys.has(field.key)) ctx.addIssue({ code: "custom", path: ["fields", i, "key"], message: `Two fields use the key "${field.key}".` });
+    keys.add(field.key);
+    if (field.type === "select" && !field.options?.length) ctx.addIssue({ code: "custom", path: ["fields", i, "options"], message: `"${field.label}" needs at least one choice.` });
+  }
+  if (!f.fields.some((x) => x.maps_to === "email" || x.maps_to === "phone")) {
+    ctx.addIssue({ code: "custom", path: ["fields"], message: "Include an email or phone field so you can reply." });
+  }
+});
+export type FormDefinition = z.infer<typeof formInput>;
+
+export const SMS_CONSENT = (business: string) =>
+  `I agree to receive text messages from ${business} about my request. Message frequency varies. Msg & data rates may apply. Reply STOP to opt out, HELP for help. Consent is not a condition of purchase.`;
+export const EMAIL_CONSENT = (business: string) => `Send me occasional emails with news and offers from ${business}. I can unsubscribe at any time.`;
+
+const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+const PHONE_RE = /^\+?[0-9() .-]{7,32}$/;
+
+export type Parsed = {
+  values: Record<string, string>;
+  contact: { first_name?: string; last_name?: string; email?: string; phone?: string; company?: string; message?: string };
+};
+
+// Validates a public submission against the form. Unknown keys are dropped.
+export function parseSubmission(fields: FormField[], raw: Record<string, unknown>): { ok: true; data: Parsed } | { ok: false; errors: Record<string, string> } {
+  const errors: Record<string, string> = {};
+  const values: Record<string, string> = {};
+  const contact: Parsed["contact"] = {};
+  for (const f of fields) {
+    const v = raw[f.key];
+    let s = f.type === "checkbox" ? (v === true || v === "on" || v === "true" ? "yes" : "") : typeof v === "string" ? v.trim() : "";
+    const max = f.type === "textarea" ? 4000 : 300;
+    if (s.length > max) s = s.slice(0, max);
+    if (!s) {
+      if (f.required) errors[f.key] = `${f.label} is required.`;
+      continue;
+    }
+    if (f.type === "email") {
+      s = s.toLowerCase();
+      if (!EMAIL_RE.test(s) || s.length > 254) { errors[f.key] = "Enter a valid email address."; continue; }
+    }
+    if (f.type === "phone" && !PHONE_RE.test(s)) { errors[f.key] = "Enter a valid phone number."; continue; }
+    if (f.type === "select" && !f.options?.includes(s)) { errors[f.key] = "Choose one of the options."; continue; }
+    values[f.key] = s;
+    if (f.maps_to !== "none") contact[f.maps_to] = f.maps_to === "first_name" || f.maps_to === "last_name" ? s.slice(0, 80) : s;
+  }
+  if (!Object.keys(errors).length && !contact.email && !contact.phone) errors._form = "Add an email address or phone number so we can reply.";
+  return Object.keys(errors).length ? { ok: false, errors } : { ok: true, data: { values, contact } };
+}
+
+export const DEFAULT_FIELDS: FormField[] = [
+  { key: "name", label: "Your name", type: "text", required: true, maps_to: "first_name" },
+  { key: "email", label: "Email", type: "email", required: true, maps_to: "email" },
+  { key: "phone", label: "Mobile phone", type: "phone", required: false, maps_to: "phone" },
+  { key: "message", label: "How can we help?", type: "textarea", required: false, maps_to: "message" },
+];
diff --git a/src/lib/forms/service.ts b/src/lib/forms/service.ts
new file mode 100644
index 0000000..a5c63b0
--- /dev/null
+++ b/src/lib/forms/service.ts
@@ -0,0 +1,115 @@
+import "server-only";
+import { createHash } from "node:crypto";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import type { CrmContext } from "@/lib/crm/service";
+import { findContactByPhone } from "@/lib/comms/service";
+import { toE164 } from "@/lib/comms/address";
+import { EMAIL_CONSENT, formInput, parseSubmission, SMS_CONSENT, type FormDefinition, type FormField, type FormSettings } from "./definition";
+
+export const FORM_COLUMNS = "id, organization_id, name, slug, status, fields, settings, submit_count, created_at, updated_at";
+export type FormRow = { id: string; organization_id: string; name: string; slug: string; status: string; fields: FormField[]; settings: FormSettings; submit_count: number };
+
+export async function listForms(ctx: CrmContext) {
+  const { data, error } = await ctx.client.from("forms").select(FORM_COLUMNS).eq("organization_id", ctx.orgId).order("created_at", { ascending: false });
+  fromDb(error);
+  return (data || []) as FormRow[];
+}
+
+export async function saveForm(ctx: CrmContext, input: FormDefinition, id?: string) {
+  const row = { ...formInput.parse(input), organization_id: ctx.orgId };
+  const q = id
+    ? ctx.client.from("forms").update(row).eq("organization_id", ctx.orgId).eq("id", id).select(FORM_COLUMNS).maybeSingle()
+    : ctx.client.from("forms").insert({ ...row, created_by: ctx.userId }).select(FORM_COLUMNS).single();
+  const { data, error } = await q;
+  if (error?.code === "23505") throw new ApiError("That form link is taken. Choose another.", 409, "conflict");
+  fromDb(error);
+  if (!data) throw new ApiError("Form not found.", 404, "not_found");
+  return data as FormRow;
+}
+
+export async function listSubmissions(ctx: CrmContext, formId: string, limit = 100) {
+  const { data, error } = await ctx.client.from("form_submissions").select("id, contact_id, data, consent, page_url, created_at, contacts(first_name, last_name, email, phone)")
+    .eq("organization_id", ctx.orgId).eq("form_id", formId).order("created_at", { ascending: false }).limit(limit);
+  fromDb(error);
+  return data || [];
+}
+
+// Public form definition (no internal settings beyond what the page needs).
+export async function publicForm(system: SupabaseClient, slug: string) {
+  if (!/^[a-z0-9][a-z0-9-]{2,62}$/.test(slug)) return null;
+  const { data } = await system.from("forms").select(FORM_COLUMNS).eq("slug", slug).eq("status", "active").maybeSingle();
+  if (!data) return null;
+  const { data: org } = await system.from("organizations").select("name, status").eq("id", data.organization_id).maybeSingle();
+  if (!org || org.status !== "active") return null;
+  const form = data as FormRow;
+  return { form, business: org.name as string };
+}
+
+function splitName(c: { first_name?: string; last_name?: string }) {
+  if (c.first_name && !c.last_name && c.first_name.includes(" ")) {
+    const [first, ...rest] = c.first_name.split(/\s+/);
+    return { first_name: first.slice(0, 80), last_name: rest.join(" ").slice(0, 80) };
+  }
+  return { first_name: c.first_name, last_name: c.last_name };
+}
+
+// Records a public submission with the service role: finds or creates the
+// contact (exact email, or phone when the contact has no different email),
+// stores consent with its exact wording, tags the contact and opens a task.
+export async function submitForm(system: SupabaseClient, form: FormRow, business: string, raw: Record<string, unknown>, meta: { ip: string; userAgent: string | null; pageUrl: string | null }) {
+  const parsed = parseSubmission(form.fields, raw);
+  if (!parsed.ok) throw Object.assign(new ApiError(Object.values(parsed.errors)[0], 422, "invalid"), { errors: parsed.errors });
+  const { values, contact } = parsed.data;
+  const orgId = form.organization_id;
+  const names = splitName(contact);
+  let contactId: string | null = null;
+  if (contact.email) {
+    const { data } = await system.from("contacts").select("id").eq("organization_id", orgId).is("erased_at", null).eq("email", contact.email).limit(1).maybeSingle();
+    contactId = data?.id ?? null;
+  }
+  const e164 = contact.phone ? toE164(contact.phone) : null;
+  if (!contactId && e164) {
+    const match = await findContactByPhone(system, orgId, e164);
+    if (match) {
+      const { data } = await system.from("contacts").select("id, email").eq("organization_id", orgId).eq("id", match.id).maybeSingle();
+      if (data && (!data.email || data.email === contact.email)) contactId = data.id;
+    }
+  }
+  if (!contactId) {
+    const { data, error } = await system.from("contacts").insert({
+      organization_id: orgId, first_name: names.first_name ?? null, last_name: names.last_name ?? null, email: contact.email ?? null,
+      phone: contact.phone ?? null, source: `Form: ${form.name}`.slice(0, 100), lifecycle_stage: "lead", tags: form.settings.tag ? [form.settings.tag] : [],
+    }).select("id").single();
+    fromDb(error);
+    contactId = data!.id;
+  } else if (form.settings.tag) {
+    const { data } = await system.from("contacts").select("tags").eq("organization_id", orgId).eq("id", contactId).maybeSingle();
+    const tags = (data?.tags as string[] | undefined) || [];
+    if (!tags.includes(form.settings.tag)) await system.from("contacts").update({ tags: [...tags, form.settings.tag].slice(0, 20) }).eq("organization_id", orgId).eq("id", contactId);
+  }
+  const at = new Date().toISOString();
+  const consent: Record<string, string> = {};
+  const evidence = (text: string) => JSON.stringify({ text, form: form.name, page: meta.pageUrl, ip: meta.ip, user_agent: meta.userAgent?.slice(0, 200), at }).slice(0, 2000);
+  if (form.settings.consent_sms && raw.consent_sms === true && contact.phone) {
+    await system.from("consents").insert({ organization_id: orgId, contact_id: contactId, channel: "sms", status: "granted", source: `Web form: ${form.name}`.slice(0, 200), evidence: evidence(SMS_CONSENT(business)) });
+    consent.sms = "granted";
+  }
+  if (form.settings.consent_email && raw.consent_email === true && contact.email) {
+    await system.from("consents").insert({ organization_id: orgId, contact_id: contactId, channel: "email", status: "granted", source: `Web form: ${form.name}`.slice(0, 200), evidence: evidence(EMAIL_CONSENT(business)) });
+    consent.email = "granted";
+  }
+  const { error: sErr } = await system.from("form_submissions").insert({
+    organization_id: orgId, form_id: form.id, contact_id: contactId, data: values, consent, page_url: meta.pageUrl?.slice(0, 500) ?? null,
+    ip_hash: createHash("sha256").update(`${orgId}:${meta.ip}`).digest("hex").slice(0, 32),
+  });
+  fromDb(sErr);
+  if (form.settings.create_task) {
+    const who = [names.first_name, names.last_name].filter(Boolean).join(" ") || contact.email || contact.phone;
+    await system.from("tasks").insert({
+      organization_id: orgId, contact_id: contactId, title: `Reply to ${form.name} from ${who}`.slice(0, 200), priority: "high",
+      due_at: new Date(Date.now() + 3600_000).toISOString(), description: contact.message?.slice(0, 4000) ?? null,
+    });
+  }
+  return { message: form.settings.success_message, redirect_url: form.settings.redirect_url ?? null };
+}
