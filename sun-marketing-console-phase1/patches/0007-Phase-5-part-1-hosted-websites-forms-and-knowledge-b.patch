+  if (!form) return <p style={{ color }}>Loading…</p>;
+  if (done) return <div role="status" style={{ padding: 18, borderRadius: 14, background: dark ? "rgba(255,255,255,.08)" : "#f0fdf4", color: dark ? "#fff" : "#14532d", fontWeight: 600 }}>{done}</div>;
+  const input: React.CSSProperties = { width: "100%", padding: "11px 13px", borderRadius: 10, border: "1px solid #cbd5e1", font: "inherit", fontSize: 15, background: "#fff", color: "#0f172a" };
+  return (
+    <form noValidate className="sm-form" style={{ display: "grid", gap: 12, textAlign: "left" }} onSubmit={async (e) => {
+      e.preventDefault();
+      const fd = new FormData(e.currentTarget);
+      const values: Record<string, unknown> = {};
+      for (const f of form.fields) values[f.key] = f.type === "checkbox" ? fd.get(f.key) === "on" : String(fd.get(f.key) || "");
+      setBusy(true); setErrors({}); setError("");
+      try {
+        const r = await fetch(`/api/public/forms/${encodeURIComponent(slug)}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({
+          values, consent_sms: fd.get("consent_sms") === "on", consent_email: fd.get("consent_email") === "on", website: String(fd.get("website") || ""), page_url: window.location.href,
+        }) });
+        const j = await r.json();
+        if (!r.ok) { setErrors(j.errors || {}); setError(j.error || "Please check the form."); return; }
+        if (j.redirect_url) window.location.href = j.redirect_url; else setDone(j.message);
+      } catch { setError("Could not send. Please try again."); }
+      finally { setBusy(false); }
+    }}>
+      {showHeading && form.heading && <h3 style={{ margin: 0, color: dark ? "#fff" : "#0f172a" }}>{form.heading}</h3>}
+      {showHeading && form.intro && <p style={{ margin: 0, color }}>{form.intro}</p>}
+      <div aria-hidden="true" style={{ position: "absolute", left: -10000, width: 1, height: 1, overflow: "hidden" }}><label>Website<input name="website" tabIndex={-1} autoComplete="off" /></label></div>
+      {form.fields.map((f) => {
+        const id = `ff-${slug}-${f.key}`;
+        return (
+          <div key={f.key} style={{ display: "grid", gap: 5 }}>
+            {f.type === "checkbox" ? (
+              <label htmlFor={id} style={{ display: "flex", gap: 8, alignItems: "flex-start", color, fontSize: 14 }}><input id={id} name={f.key} type="checkbox" required={f.required} /> {f.label}</label>
+            ) : (<>
+              <label htmlFor={id} style={{ fontSize: 13, fontWeight: 650, color }}>{f.label}{f.required ? " *" : ""}</label>
+              {f.type === "textarea" ? <textarea id={id} name={f.key} rows={4} required={f.required} placeholder={f.placeholder} style={input} maxLength={4000} />
+                : f.type === "select" ? <select id={id} name={f.key} required={f.required} style={input} defaultValue=""><option value="" disabled>Choose…</option>{f.options?.map((o) => <option key={o}>{o}</option>)}</select>
+                : <input id={id} name={f.key} type={f.type === "email" ? "email" : f.type === "phone" ? "tel" : "text"} autoComplete={f.type === "email" ? "email" : f.type === "phone" ? "tel" : undefined} required={f.required} placeholder={f.placeholder} style={input} maxLength={300} />}
+            </>)}
+            {errors[f.key] && <span role="alert" style={{ color: "#dc2626", fontSize: 13 }}>{errors[f.key]}</span>}
+          </div>
+        );
+      })}
+      {form.consent_sms_text && <label style={{ display: "flex", gap: 8, alignItems: "flex-start", fontSize: 12, color, lineHeight: 1.45 }}><input type="checkbox" name="consent_sms" style={{ marginTop: 2 }} /> <span>{form.consent_sms_text}</span></label>}
+      {form.consent_email_text && <label style={{ display: "flex", gap: 8, alignItems: "flex-start", fontSize: 12, color, lineHeight: 1.45 }}><input type="checkbox" name="consent_email" style={{ marginTop: 2 }} /> <span>{form.consent_email_text}</span></label>}
+      {error && <p role="alert" style={{ color: "#dc2626", margin: 0, fontSize: 14 }}>{error}</p>}
+      <button disabled={busy} style={{ padding: "13px 20px", borderRadius: 999, border: 0, fontWeight: 800, fontSize: 15, background: "#f97316", color: "#111827", cursor: "pointer" }}>{busy ? "Sending…" : form.submit_label}</button>
+    </form>
+  );
+}
