diff --git a/supabase/migrations/20261010120000_phase5_sites_forms_knowledge.sql b/supabase/migrations/20261010120000_phase5_sites_forms_knowledge.sql
new file mode 100644
index 0000000..18103f4
--- /dev/null
+++ b/supabase/migrations/20261010120000_phase5_sites_forms_knowledge.sql
@@ -0,0 +1,262 @@
+-- Phase 5 (part 1): hosted websites, forms and the knowledge base.
+--
+--   * forms + form_submissions: hosted and embeddable lead forms. Each
+--     submission lands on a contact's timeline, records consent with its
+--     evidence when the visitor ticks the box, and emits form.submitted for
+--     automations. Public submissions are written with the service role.
+--   * sites + site_pages: multi-page sites built with the visual editor.
+--     Edits change the draft; only managers publish, and publishing copies
+--     the draft to the live version.
+--   * knowledge_items: business facts (services, pricing, hours, FAQs,
+--     policies, scripts, brand voice). Only approved items are used by the
+--     AI; editing an approved item sends it back for approval.
+begin;
+
+-- --------------------------------------------------------------------- forms
+create table public.forms (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  name text not null check (length(btrim(name)) between 1 and 120),
+  slug text not null unique check (slug ~ '^[a-z0-9][a-z0-9-]{2,62}$'),
+  status text not null default 'active' check (status in ('active', 'inactive')),
+  fields jsonb not null check (jsonb_typeof(fields) = 'array' and jsonb_array_length(fields) between 1 and 30),
+  settings jsonb not null default '{}'::jsonb check (jsonb_typeof(settings) = 'object'),
+  submit_count integer not null default 0,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id)
+);
+create trigger forms_updated before update on public.forms
+  for each row execute function public.tg_set_updated_at();
+
+create table public.form_submissions (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  form_id uuid not null,
+  contact_id uuid,
+  data jsonb not null check (jsonb_typeof(data) = 'object' and length(data::text) <= 20000),
+  consent jsonb not null default '{}'::jsonb,
+  page_url text check (length(page_url) <= 500),
+  ip_hash text check (length(ip_hash) <= 64),
+  created_at timestamptz not null default now(),
+  foreign key (form_id, organization_id) references public.forms(id, organization_id) on delete cascade,
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete set null (contact_id)
+);
+create index form_submissions_form_idx on public.form_submissions(form_id, created_at desc);
+
+create or replace function public.tg_form_submission_created() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare v_name text;
+begin
+  update public.forms set submit_count = submit_count + 1 where id = new.form_id returning name into v_name;
+  if new.contact_id is not null then
+    insert into public.activities(organization_id, contact_id, kind, direction, subject, body, metadata, actor_type)
+    values (new.organization_id, new.contact_id, 'form', 'inbound', left('Submitted form: ' || coalesce(v_name, 'form'), 300),
+            left((select string_agg(key || ': ' || value, E'\n') from jsonb_each_text(new.data)), 20000),
+            jsonb_build_object('form_id', new.form_id, 'submission_id', new.id), 'contact');
+    perform public.emit_event(new.organization_id, 'form.submitted', new.contact_id, new.id,
+      jsonb_build_object('form_id', new.form_id, 'form_name', v_name));
+  end if;
+  return null;
+end $$;
+create trigger form_submissions_created after insert on public.form_submissions
+  for each row execute function public.tg_form_submission_created();
+
+-- --------------------------------------------------------------------- sites
+create table public.sites (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  name text not null check (length(btrim(name)) between 1 and 120),
+  slug text not null unique check (slug ~ '^[a-z0-9][a-z0-9-]{2,62}$'),
+  status text not null default 'draft' check (status in ('draft', 'published', 'archived')),
+  settings jsonb not null default '{}'::jsonb check (jsonb_typeof(settings) = 'object'),
+  published_at timestamptz,
+  published_by uuid,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id)
+);
+create trigger sites_updated before update on public.sites
+  for each row execute function public.tg_set_updated_at();
+
+create table public.site_pages (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  site_id uuid not null,
+  path text not null default '' check (path = '' or path ~ '^[a-z0-9][a-z0-9-]{0,62}$'),
+  title text not null check (length(btrim(title)) between 1 and 120),
+  meta_description text check (length(meta_description) <= 300),
+  draft jsonb not null default '{"root":{"props":{}},"content":[]}'::jsonb check (jsonb_typeof(draft) = 'object' and length(draft::text) <= 400000),
+  published jsonb check (published is null or jsonb_typeof(published) = 'object'),
+  published_title text,
+  published_meta_description text,
+  published_at timestamptz,
+  published_by uuid,
+  position integer not null default 0,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (site_id, path),
+  foreign key (site_id, organization_id) references public.sites(id, organization_id) on delete cascade
+);
+create trigger site_pages_updated before update on public.site_pages
+  for each row execute function public.tg_set_updated_at();
+
+-- Members edit drafts; going live is a manager's decision and always
+-- publishes exactly the current draft.
+create or replace function public.tg_site_pages_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    new.published := null; new.published_title := null; new.published_meta_description := null; new.published_at := null; new.published_by := null;
+    return new;
+  end if;
+  if new.site_id <> old.site_id or new.organization_id <> old.organization_id then
+    raise exception 'Page identity is immutable.' using errcode = '42501';
+  end if;
+  if new.published is distinct from old.published or new.published_title is distinct from old.published_title
+     or new.published_meta_description is distinct from old.published_meta_description then
+    if public.org_rank(new.organization_id) < 3 then
+      raise exception 'Only a manager or above can publish.' using errcode = '42501';
+    end if;
+    if new.published is not null and (new.published <> new.draft or new.published_title <> new.title
+       or new.published_meta_description is distinct from new.meta_description) then
+      raise exception 'Publishing copies the current draft exactly.' using errcode = '42501';
+    end if;
+    new.published_at := case when new.published is null then null else now() end;
+    new.published_by := auth.uid();
+  end if;
+  return new;
+end $$;
+create trigger site_pages_guard before insert or update on public.site_pages
+  for each row execute function public.tg_site_pages_guard();
+
+create or replace function public.tg_sites_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    new.status := 'draft'; new.published_at := null; new.published_by := null; new.created_by := auth.uid();
+    return new;
+  end if;
+  if new.status <> old.status and (new.status = 'published' or old.status = 'published') then
+    if public.org_rank(new.organization_id) < 3 then
+      raise exception 'Only a manager or above can publish or unpublish a site.' using errcode = '42501';
+    end if;
+    if new.status = 'published' then new.published_at := now(); new.published_by := auth.uid(); end if;
+  end if;
+  return new;
+end $$;
+create trigger sites_guard before insert or update on public.sites
+  for each row execute function public.tg_sites_guard();
+
+-- ---------------------------------------------------------------- knowledge
+create table public.knowledge_items (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  kind text not null check (kind in ('service', 'pricing', 'hours', 'faq', 'policy', 'script', 'brand_voice', 'other')),
+  title text not null check (length(btrim(title)) between 1 and 200),
+  body text not null check (length(btrim(body)) between 1 and 8000),
+  status text not null default 'draft' check (status in ('draft', 'approved', 'archived')),
+  version integer not null default 1,
+  ai_generated boolean not null default false,
+  approved_by uuid,
+  approved_at timestamptz,
+  created_by uuid,
+  updated_by uuid,
+  search tsvector generated always as (to_tsvector('english', coalesce(title, '') || ' ' || coalesce(body, ''))) stored,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+create index knowledge_items_search_idx on public.knowledge_items using gin(search);
+create index knowledge_items_org_idx on public.knowledge_items(organization_id, status, kind);
+create trigger knowledge_items_updated before update on public.knowledge_items
+  for each row execute function public.tg_set_updated_at();
+
+create or replace function public.tg_knowledge_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    new.created_by := auth.uid(); new.updated_by := auth.uid(); new.version := 1;
+    if new.status = 'approved' and public.org_rank(new.organization_id) < 3 then new.status := 'draft'; end if;
+    if new.status = 'approved' then new.approved_by := auth.uid(); new.approved_at := now(); else new.approved_by := null; new.approved_at := null; end if;
+    return new;
+  end if;
+  if new.organization_id <> old.organization_id then raise exception 'Immutable.' using errcode = '42501'; end if;
+  new.updated_by := auth.uid();
+  if new.title <> old.title or new.body <> old.body or new.kind <> old.kind then
+    new.version := old.version + 1;
+    -- Changed facts need a fresh approval unless a manager approves them in the same edit.
+    if not (new.status = 'approved' and public.org_rank(new.organization_id) >= 3) then
+      if new.status = 'approved' then new.status := 'draft'; end if;
+    end if;
+  else
+    new.version := old.version;
+  end if;
+  if new.status = 'approved' and (old.status <> 'approved' or new.version <> old.version) then
+    if public.org_rank(new.organization_id) < 3 then
+      raise exception 'Only a manager or above can approve knowledge.' using errcode = '42501';
+    end if;
+    new.approved_by := auth.uid(); new.approved_at := now();
+  elsif new.status <> 'approved' then
+    new.approved_by := null; new.approved_at := null;
+  end if;
+  return new;
+end $$;
+create trigger knowledge_items_guard before insert or update on public.knowledge_items
+  for each row execute function public.tg_knowledge_guard();
+
+-- Approved knowledge only, ranked by full-text relevance.
+create or replace function public.search_knowledge(p_org uuid, p_query text, p_limit integer default 8)
+returns table (id uuid, kind text, title text, body text, rank real)
+language sql stable security invoker set search_path = '' as $$
+  select k.id, k.kind, k.title, k.body,
+         ts_rank(k.search, websearch_to_tsquery('english', coalesce(p_query, ''))) as rank
+    from public.knowledge_items k
+   where k.organization_id = p_org and k.status = 'approved'
+     and (coalesce(btrim(p_query), '') = '' or k.search @@ websearch_to_tsquery('english', p_query))
+   order by rank desc, k.updated_at desc
+   limit least(greatest(coalesce(p_limit, 8), 1), 25)
+$$;
+
+-- --------------------------------------------------------------------- RLS
+alter table public.forms enable row level security;
+alter table public.form_submissions enable row level security;
+alter table public.sites enable row level security;
+alter table public.site_pages enable row level security;
+alter table public.knowledge_items enable row level security;
+
+create policy forms_read on public.forms for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy forms_write on public.forms for all to authenticated
+  using (public.org_rank(organization_id) >= 3) with check (public.org_rank(organization_id) >= 3);
+create policy form_submissions_read on public.form_submissions for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy form_submissions_delete on public.form_submissions for delete to authenticated using (public.org_rank(organization_id) >= 3);
+
+create policy sites_read on public.sites for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy sites_insert on public.sites for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy sites_update on public.sites for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+create policy sites_delete on public.sites for delete to authenticated using (public.org_rank(organization_id) >= 3);
+create policy site_pages_read on public.site_pages for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy site_pages_insert on public.site_pages for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy site_pages_update on public.site_pages for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+create policy site_pages_delete on public.site_pages for delete to authenticated using (public.org_rank(organization_id) >= 3);
+
+create policy knowledge_read on public.knowledge_items for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy knowledge_insert on public.knowledge_items for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy knowledge_update on public.knowledge_items for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+create policy knowledge_delete on public.knowledge_items for delete to authenticated using (public.org_rank(organization_id) >= 3);
+
+revoke all on public.forms, public.form_submissions, public.sites, public.site_pages, public.knowledge_items from anon, authenticated;
+grant all on public.forms, public.form_submissions, public.sites, public.site_pages, public.knowledge_items to service_role;
+grant select, insert, update, delete on public.forms, public.sites, public.site_pages, public.knowledge_items to authenticated;
+grant select, delete on public.form_submissions to authenticated;
+revoke execute on function public.search_knowledge(uuid, text, integer) from public, anon;
+grant execute on function public.search_knowledge(uuid, text, integer) to authenticated, service_role;
+
+commit;
diff --git a/supabase/tests/phase5_sites.test.sql b/supabase/tests/phase5_sites.test.sql
new file mode 100644
index 0000000..4ba8018
--- /dev/null
+++ b/supabase/tests/phase5_sites.test.sql
@@ -0,0 +1,120 @@
+-- Phase 5 security tests: forms, sites and knowledge.
+-- Run with scripts/test-db.sh.
+\set ON_ERROR_STOP 1
+set client_min_messages = notice;
+
+create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, false);
+  execute 'set role authenticated';
+end $$;
+create or replace function pg_temp.as_service() returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', '{"role":"service_role"}', false);
+  execute 'set role service_role';
+end $$;
+create or replace function pg_temp.reset_user() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', false);
+end $$;
+create or replace function pg_temp.expect_error(p_sql text, p_label text) returns void language plpgsql as $$
+begin
+  begin execute p_sql; exception when others then raise notice 'ok   (denied) %', p_label; return; end;
+  raise exception 'FAIL expected an error: %', p_label;
+end $$;
+create or replace function pg_temp.expect(p_ok boolean, p_label text) returns void language plpgsql as $$
+begin
+  if not coalesce(p_ok, false) then raise exception 'FAIL %', p_label; end if;
+  raise notice 'ok   %', p_label;
+end $$;
+
+insert into auth.users values
+  ('50000000-0000-0000-0000-000000000001', 'owner@p5x.test'), ('50000000-0000-0000-0000-000000000002', 'member@p5x.test'),
+  ('50000000-0000-0000-0000-000000000003', 'manager@p5x.test'), ('50000000-0000-0000-0000-000000000004', 'owner@p5y.test');
+insert into public.team_members(user_id, email, active) values
+  ('50000000-0000-0000-0000-000000000001', 'owner@p5x.test', true), ('50000000-0000-0000-0000-000000000004', 'owner@p5y.test', true);
+create temp table ids (k text primary key, v uuid);
+grant all on ids to authenticated, service_role;
+select pg_temp.as_user('50000000-0000-0000-0000-000000000001');
+insert into ids select 'x', public.create_organization('Agency P5X', 'agency');
+select public.add_member_by_email((select v from ids where k = 'x'), 'member@p5x.test', 'member');
+select public.add_member_by_email((select v from ids where k = 'x'), 'manager@p5x.test', 'manager');
+select pg_temp.reset_user();
+select pg_temp.as_user('50000000-0000-0000-0000-000000000004');
+insert into ids select 'y', public.create_organization('Agency P5Y', 'agency');
+select pg_temp.reset_user();
+
+-- 1. Forms
+select pg_temp.as_user('50000000-0000-0000-0000-000000000002');
+select pg_temp.expect_error($$insert into public.forms(organization_id, name, slug, fields) values ((select v from ids where k = 'x'), 'F', 'member-form', '[{"key":"email"}]')$$,
+  'members cannot create forms');
+select pg_temp.reset_user();
+select pg_temp.as_user('50000000-0000-0000-0000-000000000003');
+with f as (insert into public.forms(organization_id, name, slug, fields) values ((select v from ids where k = 'x'), 'Free quote', 'p5x-quote', '[{"key":"email","type":"email"}]') returning id)
+insert into ids select 'form', id from f;
+select pg_temp.expect_error($$insert into public.forms(organization_id, name, slug, fields) values ((select v from ids where k = 'x'), 'Empty', 'p5x-empty', '[]')$$, 'a form needs at least one field');
+with c as (insert into public.contacts(organization_id, email) values ((select v from ids where k = 'x'), 'lead@p5x.test') returning id) insert into ids select 'lead', id from c;
+select pg_temp.expect_error($$insert into public.form_submissions(organization_id, form_id, data) values ((select v from ids where k = 'x'), (select v from ids where k = 'form'), '{}')$$,
+  'submissions cannot be forged through the API');
+select pg_temp.reset_user();
+select pg_temp.as_service();
+insert into public.form_submissions(organization_id, form_id, contact_id, data) values ((select v from ids where k = 'x'), (select v from ids where k = 'form'), (select v from ids where k = 'lead'), '{"email":"lead@p5x.test","message":"Leaky roof"}');
+select pg_temp.reset_user();
+select pg_temp.expect((select submit_count = 1 from public.forms where id = (select v from ids where k = 'form')), 'submissions are counted');
+select pg_temp.expect((select count(*) = 1 from public.activities where kind = 'form' and contact_id = (select v from ids where k = 'lead') and body like '%Leaky roof%'), 'submissions land on the timeline');
+select pg_temp.expect((select count(*) = 1 from public.domain_events where type = 'form.submitted' and contact_id = (select v from ids where k = 'lead')), 'submissions emit form.submitted');
+select pg_temp.as_user('50000000-0000-0000-0000-000000000004');
+select pg_temp.expect((select count(*) = 0 from public.form_submissions) and (select count(*) = 0 from public.forms), 'other tenants see no forms or submissions');
+select pg_temp.reset_user();
+
+-- 2. Sites: members edit drafts, managers publish exactly the draft
+select pg_temp.as_user('50000000-0000-0000-0000-000000000002');
+with s as (insert into public.sites(organization_id, name, slug, status) values ((select v from ids where k = 'x'), 'Main site', 'p5x-site', 'published') returning id)
