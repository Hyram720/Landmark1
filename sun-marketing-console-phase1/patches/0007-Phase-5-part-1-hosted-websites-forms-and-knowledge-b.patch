+import { z } from "zod";
+import { fromDb, readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { getSite, setSiteStatus } from "@/lib/sites/service";
+import { can } from "@/lib/tenant/rbac";
+import { ApiError } from "@/lib/tenant/api";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const GET = tenantRoute<P>("crm.read", async (ctx, _req, { id }) => getSite(scoped(ctx), uuid.parse(id)));
+
+export const PATCH = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const input = await readJson(req, z.object({ name: z.string().trim().min(1).max(120) }));
+  const { error } = await ctx.client.from("sites").update(input).eq("organization_id", ctx.org.id).eq("id", uuid.parse(id));
+  fromDb(error);
+  return { ok: true };
+});
+
+// { action: "publish" } publishes every changed page and the site; "unpublish" takes it offline.
+export const POST = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const { action } = await readJson(req, z.object({ action: z.enum(["publish", "unpublish", "archive"]) }));
+  if (!can(ctx.org.role, "sites.manage")) throw new ApiError("Only a manager or above can publish or take a site offline.", 403, "forbidden");
+  return { site: await setSiteStatus(scoped(ctx), uuid.parse(id), action === "publish" ? "published" : action === "unpublish" ? "draft" : "archived") };
+});
