@@ -0,0 +1,128 @@
+"use client";
+import { useEffect, useState } from "react";
+import TenantGate, { ErrorState, Loading } from "@/components/tenant/TenantGate";
+import { api, atLeast, Org, personName, relativeTime, useResource } from "@/components/tenant/client";
+import { Copy, useToast } from "@/components/ui";
+import { DEFAULT_FIELDS, FIELD_TYPES, MAPS_TO, type FormField, type FormSettings } from "@/lib/forms/definition";
+
+type FormRow = { id: string; name: string; slug: string; status: string; fields: FormField[]; settings: FormSettings; submit_count: number; updated_at: string };
+type Submission = { id: string; contact_id: string | null; data: Record<string, string>; consent: Record<string, string>; page_url: string | null; created_at: string; contacts: { first_name: string | null; last_name: string | null; email: string | null; phone: string | null } | null };
+const MAP_LABEL: Record<string, string> = { none: "—", first_name: "First name (or full name)", last_name: "Last name", email: "Email", phone: "Phone", company: "Company", message: "Message" };
+const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60);
+
+function Builder({ initial, onSaved, onCancel }: { initial: FormRow | null; onSaved: () => void; onCancel: () => void }) {
+  const [name, setName] = useState(initial?.name || "");
+  const [slug, setSlug] = useState(initial?.slug || "");
+  const [status, setStatus] = useState(initial?.status || "active");
+  const [fields, setFields] = useState<FormField[]>(initial?.fields || DEFAULT_FIELDS);
+  const [settings, setSettings] = useState<Partial<FormSettings>>(initial?.settings || { submit_label: "Send", success_message: "Thanks! We'll be in touch shortly.", consent_sms: true, consent_email: false, create_task: true });
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const set = (i: number, patch: Partial<FormField>) => setFields((f) => f.map((x, j) => (j === i ? { ...x, ...patch } : x)));
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>{initial ? `Edit ${initial.name}` : "New form"}</h3><div className="sub">Every submission becomes a contact with a timeline entry and, if you like, a follow-up task.</div></div></div>
+      <div className="card-pad stack">
+        <div className="field-grid">
+          <div className="field"><label htmlFor="fm-name">Name</label><input id="fm-name" className="input" value={name} maxLength={120} onChange={(e) => { setName(e.target.value); if (!initial && (!slug || slug === slugify(name))) setSlug(slugify(e.target.value)); }} placeholder="Free quote request" /></div>
+          <div className="field"><label htmlFor="fm-slug">Form link</label><input id="fm-slug" className="input mono" value={slug} onChange={(e) => setSlug(e.target.value.toLowerCase())} /><span className="hint">/f/{slug || "your-form"}</span></div>
+        </div>
+        {fields.map((f, i) => (
+          <div key={i} className="step">
+            <div className="step-head"><span className="step-num">{i + 1}</span>
+              <input className="input" aria-label="Label" style={{ flex: 2, minWidth: 140 }} value={f.label} maxLength={120} onChange={(e) => set(i, { label: e.target.value })} />
+              <select className="select" aria-label="Type" style={{ width: "auto" }} value={f.type} onChange={(e) => set(i, { type: e.target.value as FormField["type"] })}>{FIELD_TYPES.map((t) => <option key={t}>{t}</option>)}</select>
+              <button type="button" className="btn btn-sm btn-ghost" aria-label="Remove field" onClick={() => setFields(fields.filter((_, j) => j !== i))}>✕</button></div>
+            <div className="row small" style={{ flexWrap: "wrap" }}>
+              <label className="row"><input type="checkbox" checked={f.required} onChange={(e) => set(i, { required: e.target.checked })} /> Required</label>
+              <label htmlFor={`map-${i}`} className="muted">Saves to</label>
+              <select id={`map-${i}`} className="select" style={{ width: "auto" }} value={f.maps_to} onChange={(e) => set(i, { maps_to: e.target.value as FormField["maps_to"] })}>{MAPS_TO.map((m) => <option key={m} value={m}>{MAP_LABEL[m]}</option>)}</select>
+              <label htmlFor={`key-${i}`} className="muted">Key</label><input id={`key-${i}`} className="input mono" style={{ maxWidth: 140 }} value={f.key} onChange={(e) => set(i, { key: e.target.value.toLowerCase().replace(/[^a-z0-9_]/g, "_") })} />
+            </div>
+            {f.type === "select" && <input className="input" aria-label="Choices" placeholder="Choices, separated by commas" value={(f.options || []).join(", ")} onChange={(e) => set(i, { options: e.target.value.split(",").map((x) => x.trim()).filter(Boolean) })} />}
+          </div>
+        ))}
+        <div><button type="button" className="btn btn-sm" disabled={fields.length >= 30} onClick={() => setFields([...fields, { key: `field_${fields.length + 1}`, label: "New question", type: "text", required: false, maps_to: "none" }])}>Add field</button></div>
+        <div className="field-grid">
+          <div className="field"><label htmlFor="fm-btn">Button text</label><input id="fm-btn" className="input" value={settings.submit_label || ""} maxLength={40} onChange={(e) => setSettings({ ...settings, submit_label: e.target.value })} /></div>
+          <div className="field"><label htmlFor="fm-tag">Tag new contacts</label><input id="fm-tag" className="input" value={settings.tag || ""} maxLength={40} onChange={(e) => setSettings({ ...settings, tag: e.target.value || undefined })} placeholder="website-lead" /></div>
+          <div className="field" style={{ gridColumn: "1 / -1" }}><label htmlFor="fm-ok">Thank-you message</label><input id="fm-ok" className="input" value={settings.success_message || ""} maxLength={500} onChange={(e) => setSettings({ ...settings, success_message: e.target.value })} /></div>
+          <div className="field" style={{ gridColumn: "1 / -1" }}><label htmlFor="fm-redirect">Or send people to a thank-you page (optional)</label><input id="fm-redirect" className="input" value={settings.redirect_url || ""} onChange={(e) => setSettings({ ...settings, redirect_url: e.target.value || undefined })} placeholder="https://…" /></div>
+        </div>
+        <label className="row small"><input type="checkbox" checked={!!settings.consent_sms} onChange={(e) => setSettings({ ...settings, consent_sms: e.target.checked })} /> Offer an optional &ldquo;text me&rdquo; consent box (records SMS consent with its exact wording)</label>
+        <label className="row small"><input type="checkbox" checked={!!settings.consent_email} onChange={(e) => setSettings({ ...settings, consent_email: e.target.checked })} /> Offer an optional marketing-email consent box</label>
+        <label className="row small"><input type="checkbox" checked={settings.create_task !== false} onChange={(e) => setSettings({ ...settings, create_task: e.target.checked })} /> Create a follow-up task for each submission</label>
+        <label className="row small"><input type="checkbox" checked={status === "active"} onChange={(e) => setStatus(e.target.checked ? "active" : "inactive")} /> Accepting submissions</label>
+        {error && <p className="form-error" role="alert">{error}</p>}
+        <div className="row"><button className="btn btn-primary" disabled={busy} onClick={async () => {
+          setBusy(true); setError("");
+          try {
+            const body = { name, slug, status, fields, settings };
+            if (initial) await api(`/api/forms/${initial.id}`, { method: "PUT", body }); else await api("/api/forms", { body });
+            onSaved();
+          } catch (e) { setError(e instanceof Error ? e.message : "Could not save."); }
+          finally { setBusy(false); }
+        }}>{busy ? <span className="spin" /> : "Save form"}</button><button className="btn btn-ghost" onClick={onCancel}>Cancel</button></div>
+      </div>
+    </div>
+  );
+}
+
+function Submissions({ form }: { form: FormRow }) {
+  const { data, error, loading } = useResource<{ submissions: Submission[] }>(`/api/forms/${form.id}`);
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} />;
+  const subs = data?.submissions || [];
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>{form.name}: submissions</h3><div className="sub">{form.submit_count} total</div></div></div>
+      {subs.length === 0 ? <div className="empty"><h3>No submissions yet</h3></div> : subs.map((s) => (
+        <div key={s.id} className="review-item">
+          <div className="row" style={{ justifyContent: "space-between", flexWrap: "wrap" }}>
+            <span className="small">{s.contact_id ? <a className="link" href={`/crm/contacts/${s.contact_id}`}>{personName(s.contacts)}</a> : "Unknown"} <span className="tiny muted">{relativeTime(s.created_at)}</span></span>
+            <span className="row" style={{ gap: 4 }}>{s.consent.sms && <span className="pill pill-ok">Texts OK</span>}{s.consent.email && <span className="pill pill-ok">Emails OK</span>}</span>
+          </div>
+          <div className="tiny">{Object.entries(s.data).map(([k, v]) => <div key={k}><span className="muted">{form.fields.find((f) => f.key === k)?.label || k}:</span> {v}</div>)}</div>
+        </div>
+      ))}
+    </div>
+  );
+}
+
+function Forms({ org }: { org: Org }) {
+  const { data, error, loading, reload } = useResource<{ forms: FormRow[] }>("/api/forms");
+  const [editing, setEditing] = useState<FormRow | "new" | null>(null);
+  const [viewing, setViewing] = useState<FormRow | null>(null);
+  const [origin, setOrigin] = useState("");
+  const { toast, node } = useToast();
+  useEffect(() => setOrigin(window.location.origin), []);
+  const canManage = atLeast(org.role, "manager");
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (editing) return <>{<Builder initial={editing === "new" ? null : editing} onCancel={() => setEditing(null)} onSaved={() => { setEditing(null); toast("Form saved."); reload(); }} />}{node}</>;
+  return (
+    <div className="split">
+      <div className="card">
+        <div className="card-head"><div><h3>Forms</h3><div className="sub">Share the link, or add a Lead form section to a site page.</div></div>{canManage && <button className="btn btn-sm btn-primary" onClick={() => setEditing("new")}>New form</button>}</div>
+        {!data?.forms.length ? <div className="empty"><h3>No forms yet</h3><p className="small">{canManage ? "Create a quote or contact form." : "A manager creates forms."}</p></div> : (
+          <div className="table-wrap"><table><thead><tr><th>Form</th><th>Link</th><th>Submissions</th><th /></tr></thead><tbody>
+            {data.forms.map((f) => (
+              <tr key={f.id}>
+                <td className="small"><strong>{f.name}</strong> {f.status !== "active" && <span className="pill pill-neutral">off</span>}<div className="tiny muted">{f.fields.length} fields · updated {relativeTime(f.updated_at)}</div></td>
+                <td className="small"><div className="row" style={{ gap: 6 }}><a className="link mono tiny" href={`/f/${f.slug}`} target="_blank" rel="noreferrer">/f/{f.slug}</a><Copy text={`${origin}/f/${f.slug}`} /></div></td>
+                <td className="small">{f.submit_count}</td>
+                <td><div className="row" style={{ gap: 4, justifyContent: "flex-end" }}><button className="btn btn-sm" onClick={() => setViewing(f)}>Submissions</button>{canManage && <button className="btn btn-sm" onClick={() => setEditing(f)}>Edit</button>}</div></td>
+              </tr>
+            ))}
+          </tbody></table></div>
+        )}
+      </div>
+      <div>{viewing ? <Submissions key={viewing.id} form={viewing} /> : <div className="card card-pad small muted">Pick a form to see its submissions. To act on new submissions automatically, use the &ldquo;Form submitted&rdquo; trigger in Automations.</div>}</div>
+      {node}
+    </div>
+  );
+}
+
+export default function FormsPage() {
+  return <TenantGate title="Forms" subtitle="Quote, contact and booking-request forms that feed your CRM.">{(info) => <Forms org={info.org} />}</TenantGate>;
+}
