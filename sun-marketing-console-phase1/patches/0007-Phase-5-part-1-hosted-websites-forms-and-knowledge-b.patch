+        </div></section>
+      ),
+    },
+    SiteFooter: {
+      label: "Footer",
+      fields: { businessName: text, description: area, phone: text, email: text, location: text, hours: area, primary: text },
+      defaultProps: { businessName: "Your business", description: "", phone: "", email: "", location: "", hours: "", primary: "#020617" },
+      render: (p: P) => (
+        <footer className="smb-footer" style={{ background: p.primary }}>
+          <div style={{ ...section, paddingTop: 56, paddingBottom: 36 }}>
+            <div><h3>{p.businessName}</h3><p>{p.description}</p></div>
+            <div><strong>Contact</strong>{p.phone && <a href={tel(p.phone)}>{p.phone}</a>}{p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}{p.location && <span>{p.location}</span>}</div>
+            <div><strong>Hours</strong>{lines(p.hours).map((h, i) => <span key={i} style={{ display: "block", marginTop: 8 }}>{h}</span>)}</div>
+          </div>
+          <small>© {new Date().getFullYear()} {p.businessName}</small>
+        </footer>
+      ),
+    },
+  },
+};
