@@ -0,0 +1,37 @@
+import type { Metadata } from "next";
+import { notFound } from "next/navigation";
+import type { Data } from "@puckeditor/core";
+import { systemClient } from "@/lib/supabase/system";
+import { publishedPage } from "@/lib/sites/service";
+import SiteRenderer from "@/components/public/SiteRenderer";
+
+export const dynamic = "force-dynamic";
+type Params = { params: Promise<{ site: string; path?: string[] }> };
+
+async function load({ params }: Params) {
+  const { site, path } = await params;
+  if ((path?.length ?? 0) > 1) return null;
+  const system = systemClient();
+  if (!system) return null;
+  return publishedPage(system, site, path?.[0] ?? "");
+}
+
+export async function generateMetadata(p: Params): Promise<Metadata> {
+  const found = await load(p);
+  if (!found) return { title: "Page not found", robots: { index: false } };
+  const settings = (found.site.settings || {}) as { business_name?: string };
+  return {
+    title: found.page.published_title || settings.business_name || found.site.name,
+    description: found.page.published_meta_description || undefined,
+    openGraph: { title: found.page.published_title || found.site.name, description: found.page.published_meta_description || undefined },
+  };
+}
+
+// Published client sites. Only the published copy of a page on a published
+// site of an active organization is ever shown.
+export default async function PublicSitePage(p: Params) {
+  const found = await load(p);
+  if (!found) notFound();
+  const { site } = await p.params;
+  return <SiteRenderer data={found.page.published as Data} siteSlug={site} nav={found.nav.map((n) => ({ path: n.path, title: n.published_title || n.path || "Home" }))} />;
+}
