+"use client";
+import { useState } from "react";
+import TenantGate, { ErrorState, Loading } from "@/components/tenant/TenantGate";
+import { api, atLeast, Org, relativeTime, useResource } from "@/components/tenant/client";
+import { useToast } from "@/components/ui";
+
+type Item = { id: string; kind: string; title: string; body: string; status: "draft" | "approved" | "archived"; version: number; ai_generated: boolean; approved_at: string | null; updated_at: string };
+const KINDS: [string, string][] = [["service", "Service"], ["pricing", "Pricing"], ["hours", "Hours & area"], ["faq", "FAQ"], ["policy", "Policy"], ["script", "Phone/chat script"], ["brand_voice", "Brand voice"], ["other", "Other"]];
+const kindLabel = (k: string) => KINDS.find(([v]) => v === k)?.[1] || k;
+
+function Editor({ item, canApprove, onDone, toast }: { item: Item | null; canApprove: boolean; onDone: () => void; toast: (m: string) => void }) {
+  const [kind, setKind] = useState(item?.kind || "service");
+  const [title, setTitle] = useState(item?.title || "");
+  const [body, setBody] = useState(item?.body || "");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const save = async (approve: boolean) => {
+    setBusy(true); setError("");
+    try {
+      const payload = { kind, title, body, ...(approve ? { status: "approved" } : item?.status === "approved" ? {} : {}) };
+      if (item) await api(`/api/knowledge/${item.id}`, { method: "PATCH", body: payload }); else await api("/api/knowledge", { body: payload });
+      toast(approve ? "Saved and approved." : canApprove ? "Saved as a draft." : "Saved. A manager approves it before the AI uses it.");
+      onDone();
+    } catch (e) { setError(e instanceof Error ? e.message : "Could not save."); }
+    finally { setBusy(false); }
+  };
+  return (
+    <div className="card card-pad stack">
+      <div className="field-grid">
+        <div className="field"><label htmlFor="kb-kind">Type</label><select id="kb-kind" className="select" value={kind} onChange={(e) => setKind(e.target.value)}>{KINDS.map(([v, l]) => <option key={v} value={v}>{l}</option>)}</select></div>
+        <div className="field"><label htmlFor="kb-title">Title</label><input id="kb-title" className="input" value={title} maxLength={200} onChange={(e) => setTitle(e.target.value)} placeholder="Roof inspection pricing" /></div>
+      </div>
+      <div className="field"><label htmlFor="kb-body">Details</label><textarea id="kb-body" className="textarea" rows={6} value={body} maxLength={8000} onChange={(e) => setBody(e.target.value)} placeholder="Facts only: what, price, area, conditions. The AI repeats this to customers." /></div>
+      {item?.status === "approved" && <span className="hint">Changing an approved item sends it back for approval{canApprove ? " unless you approve it now" : ""}.</span>}
+      {error && <p className="form-error" role="alert">{error}</p>}
+      <div className="row">
+        <button className="btn" disabled={busy || !title.trim() || !body.trim()} onClick={() => save(false)}>Save draft</button>
+        {canApprove && <button className="btn btn-primary" disabled={busy || !title.trim() || !body.trim()} onClick={() => save(true)}>Save & approve</button>}
+        <button className="btn btn-ghost" onClick={onDone}>Cancel</button>
+      </div>
+    </div>
+  );
+}
+
+function Knowledge({ org }: { org: Org }) {
+  const [filter, setFilter] = useState("");
+  const { data, error, loading, reload } = useResource<{ items: Item[] }>(`/api/knowledge${filter ? `?status=${filter}` : ""}`);
+  const [editing, setEditing] = useState<Item | "new" | null>(null);
+  const { toast, node } = useToast();
+  const canApprove = atLeast(org.role, "manager");
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  const items = data?.items || [];
+  const pending = items.filter((i) => i.status === "draft").length;
+  return (
+    <div className="stack">
+      <div className="notice notice-info small">The AI operator and AI-written website copy use only <strong>approved</strong> items. Write facts the way you want customers to hear them; a manager approves each one.</div>
+      {editing ? <Editor item={editing === "new" ? null : editing} canApprove={canApprove} toast={toast} onDone={() => { setEditing(null); reload(); }} /> : (
+        <div className="row" style={{ flexWrap: "wrap" }}>
+          <button className="btn btn-primary" onClick={() => setEditing("new")}>Add knowledge</button>
+          {[["", "All"], ["draft", `Waiting for approval${pending ? ` (${pending})` : ""}`], ["approved", "Approved"], ["archived", "Archived"]].map(([v, l]) => <button key={v} className={`chip ${filter === v ? "on" : ""}`} onClick={() => setFilter(v)}>{l}</button>)}
+        </div>
+      )}
+      <div className="card">
+        {items.length === 0 ? <div className="empty"><h3>Nothing here yet</h3><p className="small">Add your services, prices, hours, service area and common questions.</p></div> :
+          items.map((i) => (
+            <div key={i.id} className="review-item">
+              <div className="row" style={{ justifyContent: "space-between", flexWrap: "wrap" }}>
+                <div className="small"><span className="pill pill-neutral">{kindLabel(i.kind)}</span> <strong>{i.title}</strong> <span className="tiny muted">v{i.version} · {relativeTime(i.updated_at)}{i.ai_generated ? " · AI-drafted" : ""}</span></div>
+                <div className="row" style={{ gap: 6 }}>
+                  <span className={`pill ${i.status === "approved" ? "pill-ok" : i.status === "draft" ? "pill-warn" : "pill-neutral"}`}>{i.status === "draft" ? "Needs approval" : i.status}</span>
+                  {canApprove && i.status === "draft" && <button className="btn btn-sm btn-primary" onClick={async () => { try { await api(`/api/knowledge/${i.id}`, { method: "PATCH", body: { status: "approved" } }); toast("Approved."); reload(); } catch (e) { toast(e instanceof Error ? e.message : "Failed."); } }}>Approve</button>}
+                  <button className="btn btn-sm" onClick={() => setEditing(i)}>Edit</button>
+                  {i.status !== "archived" && <button className="btn btn-sm btn-ghost" onClick={async () => { try { await api(`/api/knowledge/${i.id}`, { method: "PATCH", body: { status: "archived" } }); reload(); } catch (e) { toast(e instanceof Error ? e.message : "Failed."); } }}>Archive</button>}
+                </div>
+              </div>
+              <div className="text small">{i.body}</div>
+            </div>
+          ))}
+      </div>
+      {node}
+    </div>
+  );
+}
+
+export default function KnowledgePage() {
+  return <TenantGate title="Knowledge base" subtitle="The facts your AI and website rely on: services, prices, hours, policies.">{(info) => <Knowledge org={info.org} />}</TenantGate>;
+}
diff --git a/src/app/s/[site]/[[...path]]/page.tsx b/src/app/s/[site]/[[...path]]/page.tsx
