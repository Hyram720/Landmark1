+import { useToast } from "@/components/ui";
+import { tenantSiteConfig } from "@/lib/sites/config";
+
+type Page = { id: string; path: string; title: string; meta_description: string | null; published_at: string | null; updated_at: string };
+type SiteDetail = { site: { id: string; name: string; slug: string; status: string; published_at: string | null }; pages: Page[] };
+type FullPage = Page & { draft: Data; published: Data | null };
+
+function PageEditor({ pageId, canPublish, onChanged, toast }: { pageId: string; canPublish: boolean; onChanged: () => void; toast: (m: string) => void }) {
+  const { data, error, loading, reload } = useResource<{ page: FullPage }>(`/api/sites/pages/${pageId}`);
+  const latest = useRef<Data | null>(null);
+  const [dirty, setDirty] = useState(false);
+  const [busy, setBusy] = useState("");
+  const [meta, setMeta] = useState<{ title: string; meta_description: string } | null>(null);
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return null;
+  const page = data.page;
+  const m = meta ?? { title: page.title, meta_description: page.meta_description || "" };
+  const save = async () => {
+    setBusy("save");
+    try {
+      await api(`/api/sites/pages/${pageId}`, { method: "PATCH", body: { ...(latest.current ? { draft: latest.current } : {}), title: m.title, meta_description: m.meta_description || null } });
+      setDirty(false); toast("Draft saved."); onChanged(); reload();
+    } catch (e) { toast(e instanceof Error ? e.message : "Could not save."); }
+    finally { setBusy(""); }
+  };
+  const publish = async () => {
+    if (dirty) await save();
+    setBusy("publish");
+    try { await api(`/api/sites/pages/${pageId}`, { body: { action: "publish" } }); toast("Published."); onChanged(); reload(); }
+    catch (e) { toast(e instanceof Error ? e.message : "Could not publish."); }
+    finally { setBusy(""); }
+  };
+  return (
+    <div className="stack">
+      <div className="card card-pad">
+        <div className="field-grid">
+          <div className="field"><label htmlFor="pg-title">Page title (shown in Google and the browser tab)</label><input id="pg-title" className="input" value={m.title} maxLength={120} onChange={(e) => { setMeta({ ...m, title: e.target.value }); setDirty(true); }} /></div>
+          <div className="field"><label htmlFor="pg-meta">Description for search results</label><input id="pg-meta" className="input" value={m.meta_description} maxLength={300} onChange={(e) => { setMeta({ ...m, meta_description: e.target.value }); setDirty(true); }} placeholder="One or two sentences, about 150 characters." /></div>
+        </div>
+        <div className="row" style={{ marginTop: 10, flexWrap: "wrap" }}>
+          <button className="btn" disabled={!!busy || !dirty} onClick={save}>{busy === "save" ? <span className="spin spin-dark" /> : dirty ? "Save draft" : "Saved"}</button>
+          {canPublish && <button className="btn btn-primary" disabled={!!busy} onClick={publish}>{busy === "publish" ? <span className="spin" /> : "Publish this page"}</button>}
+          <span className="tiny muted">{page.published_at ? `Live version from ${relativeTime(page.published_at)}${new Date(page.updated_at) > new Date(page.published_at) ? " · draft has newer edits" : ""}` : "Not published yet"}</span>
+        </div>
+      </div>
+      <div className="smb-editor" style={{ height: "calc(100vh - 140px)", minHeight: 640, borderRadius: 12, overflow: "hidden" }}>
+        <Puck
+          key={page.id}
+          config={tenantSiteConfig}
+          data={page.draft}
+          headerTitle={page.title}
+          onChange={(d) => { latest.current = d; setDirty(true); }}
+          overrides={{ headerActions: () => <button className="btn btn-sm btn-primary" disabled={!!busy} onClick={save}>{busy === "save" ? <span className="spin" /> : "Save draft"}</button> }}
+        />
+      </div>
+    </div>
+  );
+}
+
+function SiteEditor({ id, org }: { id: string; org: Org }) {
+  const { data, error, loading, reload } = useResource<SiteDetail>(`/api/sites/${id}`);
+  const [pageId, setPageId] = useState<string | null>(null);
+  const [adding, setAdding] = useState(false);
+  const [newPage, setNewPage] = useState({ title: "", path: "" });
+  const { toast, node } = useToast();
+  const canPublish = atLeast(org.role, "manager");
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return null;
+  const current = pageId ?? data.pages.find((p) => p.path === "")?.id ?? data.pages[0]?.id;
+  const live = data.site.status === "published";
+  const siteAction = async (action: string, done: string) => { try { await api(`/api/sites/${id}`, { body: { action } }); toast(done); reload(); } catch (e) { toast(e instanceof Error ? e.message : "That did not work."); } };
+  return (
+    <div className="stack">
+      <div className="card card-pad">
+        <div className="row" style={{ justifyContent: "space-between", flexWrap: "wrap" }}>
+          <div className="row" style={{ flexWrap: "wrap", gap: 6 }}>
+            <a className="btn btn-sm btn-ghost" href="/sites">← Websites</a>
+            <strong>{data.site.name}</strong>
+            <span className={`pill ${live ? "pill-ok" : "pill-neutral"}`}>{live ? "Live" : "Draft"}</span>
+            {live && <a className="link small" href={`/s/${data.site.slug}`} target="_blank" rel="noreferrer">View live site ↗</a>}
+          </div>
+          {canPublish && <div className="row" style={{ gap: 6 }}>
+            <button className="btn btn-sm btn-primary" onClick={() => { if (window.confirm("Publish every page's current draft and make the site public?")) siteAction("publish", "Site is live."); }}>{live ? "Publish all changes" : "Publish site"}</button>
+            {live && <button className="btn btn-sm" onClick={() => { if (window.confirm("Take the whole site offline?")) siteAction("unpublish", "Site is offline."); }}>Take offline</button>}
+          </div>}
+        </div>
+        <div className="row" style={{ flexWrap: "wrap", gap: 6, marginTop: 10 }}>
+          {data.pages.map((p) => <button key={p.id} className={`chip ${p.id === current ? "on" : ""}`} onClick={() => setPageId(p.id)}>{p.title}{p.path ? ` (/${p.path})` : " (home)"}{!p.published_at ? " · draft" : new Date(p.updated_at) > new Date(p.published_at) ? " · edited" : ""}</button>)}
+          {!adding ? <button className="chip" onClick={() => setAdding(true)}>+ Add page</button> : (
+            <span className="row" style={{ gap: 6 }}>
+              <input className="input" aria-label="New page title" placeholder="Services" value={newPage.title} onChange={(e) => setNewPage({ title: e.target.value, path: e.target.value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") })} style={{ maxWidth: 160 }} />
+              <button className="btn btn-sm" disabled={!newPage.path} onClick={async () => { try { const r = await api<{ page: { id: string } }>(`/api/sites/${id}/pages`, { body: { ...newPage, copy_from: current } }); setAdding(false); setNewPage({ title: "", path: "" }); setPageId(r.page.id); reload(); } catch (e) { toast(e instanceof Error ? e.message : "Failed."); } }}>Add (copy of this page)</button>
+              <button className="btn btn-sm btn-ghost" onClick={() => setAdding(false)}>Cancel</button>
+            </span>
+          )}
+        </div>
+      </div>
+      {current && <PageEditor key={current} pageId={current} canPublish={canPublish} onChanged={reload} toast={toast} />}
+      {node}
+    </div>
+  );
+}
+
+export default function SitePage({ params }: { params: Promise<{ id: string }> }) {
+  const { id } = use(params);
+  return <TenantGate title="Website editor" subtitle="Drag sections, edit text, save drafts; managers publish.">{(info) => <SiteEditor id={id} org={info.org} />}</TenantGate>;
+}
