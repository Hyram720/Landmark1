@@ -0,0 +1,55 @@
+import type { Data } from "@puckeditor/core";
+import { professionImages } from "@/lib/site-builder-config";
+
+// Industry starting points for hosted sites. Copy avoids claims a business
+// would have to prove (years, awards, licenses, prices); owners add those.
+export type SiteContent = {
+  eyebrow: string; headline: string; subheadline: string; about_heading: string; about: string;
+  services: { title: string; description: string }[]; proof_points: string[];
+  process: { title: string; description: string }[]; faqs: { q: string; a: string }[]; cta_heading: string; cta_body: string;
+};
+type Industry = { key: string; label: string; profession: string; content: SiteContent };
+
+const svc = (rows: string[]) => rows.map((r) => { const [title, description] = r.split("|"); return { title, description }; });
+const steps = (rows: string[]) => svc(rows);
+const faqs = (rows: string[]) => rows.map((r) => { const [q, a] = r.split("|"); return { q, a }; });
+const common = {
+  proof_points: ["Clear, upfront quotes", "Friendly local team", "Fast replies", "Easy online booking"],
+  process: steps(["Tell us what you need|Call, book online or send the form.", "Get a clear plan|We explain options and price before any work starts.", "We get it done|On time, tidy, and checked with you at the end."]),
+};
+
+export const INDUSTRIES: Industry[] = [
+  { key: "roofing", label: "Roofing", profession: "roofing", content: { eyebrow: "ROOFING · REPAIRS · REPLACEMENTS", headline: "A roof you don't have to think about.", subheadline: "Inspections, repairs and full replacements with clear quotes and tidy crews.", about_heading: "Local roofers who explain before they climb", about: "We inspect, show you photos of what we find, and give you options in plain language.", services: svc(["Roof repairs|Leaks, missing shingles, flashing and storm damage.", "Roof replacement|Full tear-off and new roof with clean-up included.", "Inspections|Photo report of your roof's condition.", "Gutters|Cleaning, repairs and new gutter systems."]), faqs: faqs(["Do you offer free inspections?|Ask us about inspections in your area.", "How long does a replacement take?|Most homes take one to three days, depending on size and weather."]), cta_heading: "Worried about your roof?", cta_body: "Book an inspection and get a clear answer.", ...common } },
+  { key: "plumbing", label: "Plumbing", profession: "plumbing", content: { eyebrow: "PLUMBING · DRAINS · WATER HEATERS", headline: "Plumbing fixed right the first time.", subheadline: "Repairs, drains, water heaters and installations with upfront pricing.", about_heading: "Plumbers who show up and clean up", about: "We arrive when we say, explain the fix, and leave your home the way we found it.", services: svc(["Leak repair|Pipes, faucets, toilets and fixtures.", "Drain cleaning|Kitchen, bath and main line clogs.", "Water heaters|Repair and replacement, tank and tankless.", "Installations|Fixtures, disposals and appliance hookups."]), faqs: faqs(["Do you handle emergencies?|Call us and we'll tell you how soon we can get there.", "Do you charge for estimates?|Ask us when you call; we'll explain any fees upfront."]), cta_heading: "Got a leak or a clog?", cta_body: "Tell us what's happening and we'll get you sorted.", ...common } },
+  { key: "hvac", label: "Heating & cooling", profession: "hvac", content: { eyebrow: "HEATING · COOLING · AIR QUALITY", headline: "Comfortable all year, without surprises.", subheadline: "Repairs, maintenance and new systems with honest recommendations.", about_heading: "Straight answers about your system", about: "We'll tell you whether a repair makes sense or a replacement will save you money.", services: svc(["AC repair|Diagnosis and repair of all major brands.", "Furnace & heat pumps|Repair, tune-ups and replacement.", "Maintenance plans|Seasonal checkups that catch problems early.", "New systems|Sizing, quotes and installation."]), faqs: faqs(["How often should my system be serviced?|Most systems benefit from a check before each heating and cooling season.", "Do you work on all brands?|We service most major brands; ask us about yours."]), cta_heading: "Too hot, too cold, or too loud?", cta_body: "Book a visit and we'll find the cause.", ...common } },
+  { key: "dental", label: "Dental", profession: "dental", content: { eyebrow: "FAMILY · COSMETIC · PREVENTIVE", headline: "Dental care that feels easy.", subheadline: "Cleanings, fillings, whitening and more for the whole family.", about_heading: "A calm, welcoming practice", about: "We take time to explain your options and keep visits comfortable.", services: svc(["Cleanings & exams|Preventive care for every age.", "Fillings & crowns|Natural-looking repairs.", "Whitening|Brighter smiles, safely.", "Emergency visits|Tooth pain? Call us first."]), faqs: faqs(["Do you accept insurance?|Call us with your plan and we'll check for you.", "Are you taking new patients?|Book online or call to see the next available times."]), cta_heading: "Due for a checkup?", cta_body: "Book your visit online in a minute.", ...common, proof_points: ["New patients welcome", "Family friendly", "Online booking", "Gentle care"] } },
+  { key: "landscaping", label: "Landscaping", profession: "landscaping", content: { eyebrow: "LAWN · LANDSCAPE · HARDSCAPE", headline: "A yard you're proud of.", subheadline: "Lawn care, planting, design and seasonal clean-ups.", about_heading: "Local crews who care about the details", about: "From weekly mowing to new patios, we keep your outdoor space looking its best.", services: svc(["Lawn care|Mowing, edging and fertilization.", "Landscape design|Planting plans and installation.", "Hardscaping|Patios, walkways and walls.", "Clean-ups|Spring and fall clean-ups."]), faqs: faqs(["Do you offer weekly service?|Yes, ask about weekly and bi-weekly plans.", "Do you provide free estimates?|Ask us about estimates for your property."]), cta_heading: "Ready for a better yard?", cta_body: "Tell us about your property and we'll send a quote.", ...common } },
+  { key: "cleaning", label: "Cleaning", profession: "cleaning", content: { eyebrow: "HOMES · OFFICES · MOVE-OUTS", headline: "Come home to clean.", subheadline: "Reliable home and office cleaning on your schedule.", about_heading: "Cleaners you can trust with your keys", about: "Consistent teams, clear checklists and easy rescheduling.", services: svc(["Recurring cleaning|Weekly, bi-weekly or monthly.", "Deep cleaning|Top-to-bottom detail work.", "Move-in / move-out|Get your deposit back.", "Office cleaning|After-hours service for small offices."]), faqs: faqs(["Do I need to be home?|No. Many clients give us a key or door code.", "Do you bring supplies?|Yes, we bring everything we need."]), cta_heading: "Want your weekends back?", cta_body: "Get a quote in a minute.", ...common } },
+  { key: "general", label: "Other local business", profession: "professional", content: { eyebrow: "LOCAL · TRUSTED · RESPONSIVE", headline: "Helping our neighbors, one customer at a time.", subheadline: "Tell people what you do, who it's for and how to get started.", about_heading: "About us", about: "Share your story: who you are, what you care about, and why customers choose you.", services: svc(["Main service|What it is and why it helps.", "Second service|What it is and why it helps.", "Third service|What it is and why it helps."]), faqs: faqs(["How do I get started?|Call us, book online or send the form and we'll reply quickly."]), cta_heading: "Let's get started", cta_body: "Reach out today and we'll take it from there.", ...common } },
+];
+
+export type SiteBasics = { business: string; phone?: string; email?: string; location?: string; hours?: string; primary?: string; accent?: string; formSlug?: string; calendarSlug?: string };
+
+export function makeSiteData(industryKey: string, basics: SiteBasics, content?: Partial<SiteContent>): Data {
+  const ind = INDUSTRIES.find((i) => i.key === industryKey) ?? INDUSTRIES[INDUSTRIES.length - 1];
+  const c = { ...ind.content, ...content };
+  const img = professionImages(ind.profession);
+  const primary = basics.primary || "#0f172a";
+  const accent = basics.accent || "#f97316";
+  let n = 0;
+  const id = () => `${industryKey}-${++n}`;
+  const blocks: Data["content"] = [
+    { type: "Hero", props: { id: id(), eyebrow: c.eyebrow, headline: c.headline, body: c.subheadline, primaryCta: basics.calendarSlug ? "Book online" : "Get a free quote", primaryLink: basics.calendarSlug ? `/book/${basics.calendarSlug}` : "#contact", phone: basics.phone || "", primary, accent, imageUrl: img.hero, imageAlt: img.alt } },
+    { type: "ProofBar", props: { id: id(), items: c.proof_points.join("\n"), tone: "light" } },
+    { type: "Services", props: { id: id(), eyebrow: "SERVICES", heading: "What we do", intro: c.subheadline, items: c.services.map((s) => `${s.title}|${s.description}`).join("\n"), columns: c.services.length === 4 ? "2" : "3" } },
+    { type: "Story", props: { id: id(), eyebrow: "ABOUT", heading: c.about_heading, body: c.about, imageUrl: img.story, imageAlt: img.alt, stat: "Local", statLabel: basics.location ? `Serving ${basics.location}` : "Serving our community", reverse: "no" } },
+    { type: "Process", props: { id: id(), eyebrow: "HOW IT WORKS", heading: "Simple from start to finish", steps: c.process.map((s) => `${s.title}|${s.description}`).join("\n") } },
+    { type: "Faq", props: { id: id(), heading: "Questions we hear often", items: c.faqs.map((f) => `${f.q}|${f.a}`).join("\n") } },
+  ];
+  if (basics.calendarSlug) blocks.push({ type: "BookingCta", props: { id: id(), heading: c.cta_heading, body: c.cta_body, buttonLabel: "Book now", calendarSlug: basics.calendarSlug, primary, accent } });
+  blocks.push(basics.formSlug
+    ? { type: "LeadForm", props: { id: id(), heading: basics.calendarSlug ? "Prefer to send a message?" : c.cta_heading, intro: c.cta_body, formSlug: basics.formSlug } }
+    : { type: "CallToAction", props: { id: id(), heading: c.cta_heading, body: c.cta_body, buttonLabel: basics.phone ? "Call us" : "Contact us", buttonLink: basics.phone ? `tel:${basics.phone.replace(/[^0-9+]/g, "")}` : basics.email ? `mailto:${basics.email}` : "#contact", phone: basics.phone || "", primary, accent } });
+  blocks.push({ type: "SiteFooter", props: { id: id(), businessName: basics.business, description: c.subheadline, phone: basics.phone || "", email: basics.email || "", location: basics.location || "", hours: basics.hours || "", primary: "#020617" } });
+  return { root: { props: {} }, content: blocks };
+}
