+        </div>
+        <div className="card">
+          <div className="card-head"><div><h3>Runs</h3><div className="sub">The last 50 people who entered this automation.</div></div><button className="btn btn-sm" onClick={reload}>Refresh</button></div>
+          {data.runs.length === 0 ? <div className="empty"><h3>No runs yet</h3><p className="small">{w.status === "active" ? "Runs start when the trigger happens. The scheduler checks every 15 minutes." : "Switch it on to start."}</p></div> :
+            data.runs.map((r) => (
+              <div key={r.id} className="review-item">
