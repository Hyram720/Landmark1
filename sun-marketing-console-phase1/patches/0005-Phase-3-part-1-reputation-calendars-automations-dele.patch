+"use client";
+import { useEffect, useState } from "react";
+import { api, personName } from "./client";
+
+export type PickedContact = { id: string; first_name: string | null; last_name: string | null; email: string | null; phone: string | null };
+
+// Search-as-you-type contact selector backed by /api/crm/contacts.
+export default function ContactPicker({ value, onChange, id = "contact-picker" }: { value: PickedContact | null; onChange: (c: PickedContact | null) => void; id?: string }) {
+  const [q, setQ] = useState("");
+  const [rows, setRows] = useState<PickedContact[]>([]);
+  const [open, setOpen] = useState(false);
+  useEffect(() => {
+    if (!open) return;
+    const ctrl = new AbortController();
+    const t = setTimeout(() => {
+      api<{ rows: PickedContact[] }>(`/api/crm/contacts?limit=8&sort=recent&q=${encodeURIComponent(q)}`, { signal: ctrl.signal })
+        .then((r) => setRows(r.rows)).catch(() => undefined);
+    }, 200);
+    return () => { clearTimeout(t); ctrl.abort(); };
+  }, [q, open]);
+  if (value) {
+    return (
+      <div className="row" style={{ justifyContent: "space-between", border: "1px solid var(--line)", borderRadius: 8, padding: "7px 10px" }}>
+        <span className="small"><strong>{personName(value)}</strong> <span className="muted">{value.phone || value.email || ""}</span></span>
+        <button type="button" className="btn btn-sm btn-ghost" onClick={() => onChange(null)}>Change</button>
+      </div>
+    );
+  }
+  return (
+    <div className="picker">
+      <input id={id} className="input" placeholder="Search contacts by name, phone or email" value={q} autoComplete="off"
+        onChange={(e) => setQ(e.target.value)} onFocus={() => setOpen(true)} onBlur={() => setTimeout(() => setOpen(false), 150)} />
+      {open && rows.length > 0 && (
+        <ul className="picker-list" role="listbox">
+          {rows.map((c) => (
+            <li key={c.id}><button type="button" onMouseDown={(e) => e.preventDefault()} onClick={() => { onChange(c); setOpen(false); }}>
+              <strong>{personName(c)}</strong> <span className="muted tiny">{c.phone || c.email || ""}</span>
+            </button></li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
