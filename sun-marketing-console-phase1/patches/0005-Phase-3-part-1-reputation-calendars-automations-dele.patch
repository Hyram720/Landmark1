+import "server-only";
+import { randomBytes } from "node:crypto";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { systemAudit } from "@/lib/tenant/system-audit";
+import { sendMessage, type SendContext } from "@/lib/comms/service";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { healthScore, type ReviewFact } from "./score";
+import { PLATFORMS, reviewsFromCsv } from "./csv";
+
+export const SOURCE_COLUMNS = "id, organization_id, platform, name, review_url, position, status, created_at";
+export const REVIEW_COLUMNS =
+  "id, organization_id, source_id, platform, external_id, contact_id, rating, author_name, body, published_at, sentiment, status, response_body, response_status, response_ai_drafted, responded_at, created_at";
+
+type Ctx = SendContext;
+
+export const sourceInput = z.object({
+  platform: z.enum(PLATFORMS),
+  name: z.string().trim().min(1, "Name the review site.").max(80),
+  review_url: z.string().trim().max(500).url("Enter the full review link.").refine((u) => u.startsWith("https://"), "The link must start with https://"),
+  position: z.number().int().min(0).max(100).optional(),
+  status: z.enum(["active", "disabled"]).optional(),
+});
+
+export const reviewInput = z.object({
+  platform: z.enum(PLATFORMS),
+  rating: z.number().int().min(1).max(5),
+  author_name: z.string().trim().max(120).optional(),
+  body: z.string().trim().max(10000).optional(),
+  published_at: z.string().datetime({ offset: true }).optional(),
+  contact_id: z.string().uuid().optional(),
+  source_id: z.string().uuid().optional(),
+  external_id: z.string().trim().max(200).optional(),
+});
+
+export const reviewPatch = z.object({
+  status: z.enum(["new", "acknowledged", "resolved"]).optional(),
+  response_body: z.string().trim().min(1).max(4000).optional(),
+  response_status: z.enum(["none", "draft", "posted"]).optional(),
+  contact_id: z.string().uuid().nullable().optional(),
+});
+
+export async function listSources(ctx: Ctx, activeOnly = false) {
+  let q = ctx.client.from("review_sources").select(SOURCE_COLUMNS).eq("organization_id", ctx.orgId);
+  if (activeOnly) q = q.eq("status", "active");
+  const { data, error } = await q.order("position").order("created_at");
+  fromDb(error);
+  return data || [];
+}
+
+export async function createSource(ctx: Ctx, input: z.infer<typeof sourceInput>) {
+  const { data, error } = await ctx.client.from("review_sources").insert({ ...input, organization_id: ctx.orgId }).select(SOURCE_COLUMNS).single();
+  fromDb(error);
+  return data!;
+}
+
+export async function updateSource(ctx: Ctx, id: string, patch: Partial<z.infer<typeof sourceInput>>) {
+  const { data, error } = await ctx.client.from("review_sources").update(patch).eq("organization_id", ctx.orgId).eq("id", id).select(SOURCE_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Review site not found.", 404, "not_found");
+  return data;
+}
+
+export async function deleteSource(ctx: Ctx, id: string) {
+  const { error } = await ctx.client.from("review_sources").delete().eq("organization_id", ctx.orgId).eq("id", id);
+  fromDb(error);
+}
+
+export async function listReviews(ctx: Ctx, opts: { ratingMax?: number; status?: string; needsReply?: boolean; limit?: number; offset?: number } = {}) {
+  let q = ctx.client.from("reviews").select(`${REVIEW_COLUMNS}, contacts(first_name, last_name)`, { count: "exact" }).eq("organization_id", ctx.orgId);
+  if (opts.ratingMax) q = q.lte("rating", opts.ratingMax);
+  if (opts.status) q = q.eq("status", opts.status);
+  if (opts.needsReply) q = q.neq("response_status", "posted");
+  const limit = Math.min(Math.max(opts.limit ?? 50, 1), 200);
+  const offset = Math.max(opts.offset ?? 0, 0);
+  const { data, error, count } = await q.order("published_at", { ascending: false }).range(offset, offset + limit - 1);
+  fromDb(error);
+  return { rows: data || [], total: count ?? 0 };
+}
+
+export async function createReview(ctx: Ctx, input: z.infer<typeof reviewInput>) {
+  const { data, error } = await ctx.client.from("reviews").insert({ ...input, organization_id: ctx.orgId, published_at: input.published_at ?? new Date().toISOString() })
+    .select(REVIEW_COLUMNS).single();
+  fromDb(error);
+  return data!;
+}
+
+export async function importReviews(ctx: Ctx, csv: string, platform: (typeof PLATFORMS)[number]) {
+  const { rows, errors } = reviewsFromCsv(csv, platform);
+  if (!rows.length) throw new ApiError(errors[0] || "No reviews found in the file.", 422, "invalid");
+  let imported = 0;
+  let duplicates = 0;
+  for (let i = 0; i < rows.length; i += 100) {
+    const batch = rows.slice(i, i + 100).map((r) => ({ ...r, organization_id: ctx.orgId }));
+    for (const row of batch) {
+      const { error } = await ctx.client.from("reviews").insert(row);
+      if (error?.code === "23505") duplicates++;
+      else {
+        fromDb(error);
+        imported++;
+      }
+    }
+  }
+  return { imported, duplicates, skipped: errors.length, errors };
+}
+
+export async function updateReview(ctx: Ctx, id: string, patch: z.infer<typeof reviewPatch>, opts: { aiDrafted?: boolean } = {}) {
+  const row: Record<string, unknown> = { ...patch };
+  if (patch.response_body !== undefined) {
+    row.response_ai_drafted = !!opts.aiDrafted;
+    if (!patch.response_status) row.response_status = "draft";
+  }
+  const { data, error } = await ctx.client.from("reviews").update(row).eq("organization_id", ctx.orgId).eq("id", id).select(REVIEW_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Review not found.", 404, "not_found");
+  return data;
+}
+
+export async function reputationSummary(ctx: Ctx, now = new Date()) {
+  const since = new Date(now.getTime() - 90 * 86_400_000).toISOString();
+  const [reviews, requests, sources] = await Promise.all([
+    ctx.client.from("reviews").select("rating, published_at, status, response_status, responded_at").eq("organization_id", ctx.orgId).order("published_at", { ascending: false }).limit(5000),
+    ctx.client.from("review_requests").select("status, rating").eq("organization_id", ctx.orgId).gte("created_at", since).limit(5000),
+    listSources(ctx),
+  ]);
+  fromDb(reviews.error);
+  fromDb(requests.error);
+  const reqs = requests.data || [];
+  return {
+    health: healthScore((reviews.data || []) as ReviewFact[], now),
+    requests90: {
+      sent: reqs.length,
+      opened: reqs.filter((r) => r.status !== "sent").length,
+      rated: reqs.filter((r) => r.rating !== null).length,
+      clickedPublic: reqs.filter((r) => r.status === "clicked").length,
+      privateNegative: reqs.filter((r) => r.rating !== null && r.rating <= 3).length,
+    },
+    sources,
+  };
+}
+
+export const reviewRequestInput = z.object({
+  contact_id: z.string().uuid(),
+  channel: z.enum(["sms", "email"]),
+  force: z.boolean().optional(),
+});
+
+export function reviewRequestText(channel: "sms" | "email", firstName: string | null, business: string, url: string) {
+  const hi = firstName ? `Hi ${firstName}, ` : "Hi, ";
+  return channel === "sms"
+    ? `${hi}thanks for choosing ${business}! How did we do? It takes 30 seconds: ${url} Reply STOP to opt out.`
+    : `${hi}\n\nThank you for choosing ${business}. Would you tell us how we did? It takes about 30 seconds:\n\n${url}\n\nYour honest feedback helps us improve, and you can post it publicly or send it to us privately.\n\n${business}`;
+}
+
+// Sends a review request. The public page always offers every review site;
+// private feedback is an extra option, never a filter (no review gating).
+// Review requests are relationship messages: SMS still needs consent or a
+// recent text from the customer, and opt-outs always win.
+export async function sendReviewRequest(ctx: Ctx, input: z.infer<typeof reviewRequestInput>, opts: { system?: boolean; aiGenerated?: boolean; req?: Request; now?: Date } = {}) {
+  const now = opts.now ?? new Date();
+  const sources = await listSources(ctx, true);
+  if (!sources.length) throw new ApiError("Integration not configured: add at least one review site (Google, Facebook…) in Reputation settings.", 503, "integration_not_configured");
+  const base = publicBaseUrl(opts.req);
+  if (!base) throw new ApiError("Integration not configured: set PUBLIC_APP_URL so review links can be built.", 503, "integration_not_configured");
+  if (!input.force) {
+    const { data, error } = await ctx.client.from("review_requests").select("id, created_at").eq("organization_id", ctx.orgId).eq("contact_id", input.contact_id)
+      .gte("created_at", new Date(now.getTime() - 30 * 86_400_000).toISOString()).limit(1).maybeSingle();
+    fromDb(error);
+    if (data) return { outcome: "skipped" as const, reason: "This person was already asked for a review in the last 30 days." };
+  }
+  const [{ data: contact }, { data: org }] = await Promise.all([
+    ctx.client.from("contacts").select("first_name").eq("organization_id", ctx.orgId).eq("id", input.contact_id).maybeSingle(),
+    ctx.client.from("organizations").select("name").eq("id", ctx.orgId).maybeSingle(),
+  ]);
+  if (!contact) throw new ApiError("Contact not found.", 404, "not_found");
+  const token = randomBytes(18).toString("hex");
+  const url = `${base}/review/${token}`;
+  const result = await sendMessage(ctx, {
+    contact_id: input.contact_id, channel: input.channel, purpose: "transactional",
+    body: reviewRequestText(input.channel, contact.first_name, org?.name || "our team", url),
+    subject: input.channel === "email" ? `How did we do, ${contact.first_name || "friend"}?` : undefined,
+  }, { system: opts.system, aiGenerated: opts.aiGenerated, req: opts.req });
+  if (result.outcome === "blocked") return { outcome: "blocked" as const, reason: result.reason };
+  if (result.outcome === "failed") return { outcome: "failed" as const, reason: result.message.error || "The provider refused the message." };
+  const { data, error } = await ctx.client.from("review_requests").insert({
+    organization_id: ctx.orgId, contact_id: input.contact_id, channel: input.channel, token, message_id: result.message.id,
+  }).select("id, status, created_at").single();
+  fromDb(error);
+  const target = { type: "review_request", id: data!.id };
+  if (opts.system) await systemAudit(ctx.client, ctx.orgId, "reputation.request_sent", target, { channel: input.channel });
+  else await audit(ctx.client, ctx.orgId, "reputation.request_sent", target, { channel: input.channel }, opts.aiGenerated ? "ai" : "user");
+  return { outcome: "sent" as const, request: data, message_status: result.message.status };
+}
+
+export async function listRequests(ctx: Ctx, limit = 50) {
+  const { data, error } = await ctx.client.from("review_requests")
+    .select("id, contact_id, channel, status, rating, feedback, opened_at, rated_at, clicked_at, created_at, contacts(first_name, last_name), review_sources(name)")
+    .eq("organization_id", ctx.orgId).order("created_at", { ascending: false }).limit(limit);
+  fromDb(error);
+  return data || [];
+}
