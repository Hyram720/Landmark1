+  if (view.kind === "edit") return <>{<Editor draft={view.draft} canManage={canManage} toast={toast} onCancel={() => setView(view.draft.id ? { kind: "detail", id: view.draft.id } : { kind: "list" })} onSaved={(id) => { reload(); setView({ kind: "detail", id }); }} />}{node}</>;
