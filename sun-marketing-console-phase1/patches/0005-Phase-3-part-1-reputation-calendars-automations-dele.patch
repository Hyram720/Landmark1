+                <input type="time" className="input" aria-label={`${l} end`} disabled={!r} value={r?.[1] ?? ""} onChange={(e) => set("working_hours", { ...c.working_hours, [d]: [[r![0], e.target.value]] })} />
+              </div>
+            );
+          })}
+        </fieldset>
+        {c.kind !== "resource" && (
+          <fieldset className="stack" style={{ gap: 6, border: 0, padding: 0, margin: 0 }}>
+            <legend className="small" style={{ fontWeight: 620, marginBottom: 6 }}>Team members on this calendar</legend>
+            {members.map((m) => <label key={m.user_id} className="row small"><input type="checkbox" checked={c.member_ids.includes(m.user_id)} onChange={(e) => set("member_ids", e.target.checked ? [...c.member_ids, m.user_id] : c.member_ids.filter((x) => x !== m.user_id))} />{m.display_name || m.email}</label>)}
+          </fieldset>
+        )}
+        <div className="field"><label htmlFor="cf-confirm">Extra confirmation text (optional)</label><input id="cf-confirm" className="input" maxLength={1000} value={c.confirmation_message ?? ""} onChange={(e) => set("confirmation_message", e.target.value)} placeholder="Please have your roof photos ready." /></div>
+        <label className="row small"><input type="checkbox" checked={c.is_public} onChange={(e) => set("is_public", e.target.checked)} /> Customers can book online at the booking link</label>
+        <label className="row small"><input type="checkbox" checked={c.status === "active"} onChange={(e) => set("status", e.target.checked ? "active" : "inactive")} /> Taking bookings</label>
+        {error && <p className="form-error" role="alert">{error}</p>}
+        <div className="row"><button className="btn btn-primary" disabled={busy}>{busy ? <span className="spin" /> : "Save calendar"}</button><button type="button" className="btn btn-ghost" onClick={onCancel}>Cancel</button></div>
+      </div>
+    </form>
+  );
+}
+
+const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60);
+
+function Calendars({ org }: { org: Org }) {
+  const { data, error, loading, reload } = useResource<{ calendars: Calendar[]; members: Member[] }>("/api/calendars");
+  const [tab, setTab] = useState<"agenda" | "calendars">("agenda");
+  const [editing, setEditing] = useState<Calendar | "new" | null>(null);
+  const [agendaKey, setAgendaKey] = useState(0);
+  const { toast, node } = useToast();
+  const [origin, setOrigin] = useState("");
+  useEffect(() => setOrigin(window.location.origin), []);
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return null;
+  const canManage = atLeast(org.role, "manager");
+  const canWrite = atLeast(org.role, "member");
+  return (
+    <div className="stack">
+      <div className="tabs" role="tablist">
+        <button role="tab" aria-selected={tab === "agenda"} className={tab === "agenda" ? "on" : ""} onClick={() => setTab("agenda")}>Agenda</button>
+        <button role="tab" aria-selected={tab === "calendars"} className={tab === "calendars" ? "on" : ""} onClick={() => setTab("calendars")}>Calendars ({data.calendars.length})</button>
+      </div>
+      {tab === "agenda" ? (
+        <div className="split">
+          <Agenda key={agendaKey} calendars={data.calendars} members={data.members} canWrite={canWrite} toast={toast} />
+          <div className="stack">
+            {canWrite && <BookPanel calendars={data.calendars} onBooked={() => setAgendaKey((k) => k + 1)} toast={toast} />}
+            <div className="notice notice-info small"><strong>Google and Microsoft calendar sync: not connected yet.</strong> It arrives in a later update. Until then, block personal time by booking it here so customers can&apos;t take it.</div>
+          </div>
+        </div>
+      ) : editing ? (
+        <CalendarForm initial={editing === "new" ? null : editing} members={data.members} onCancel={() => setEditing(null)} onSaved={() => { setEditing(null); toast("Calendar saved."); reload(); }} />
+      ) : (
+        <div className="card">
+          <div className="card-head"><div><h3>Calendars</h3><div className="sub">Each calendar has its own hours, length, team and booking link.</div></div>{canManage && <button className="btn btn-primary btn-sm" onClick={() => setEditing("new")}>New calendar</button>}</div>
+          {data.calendars.length === 0 ? <div className="empty"><h3>No calendars yet</h3><p className="small">{canManage ? "Create one for each kind of appointment you offer." : "A manager creates calendars."}</p></div> : (
+            <div className="table-wrap"><table><thead><tr><th>Calendar</th><th>Hours</th><th>Booking link</th><th>Status</th><th /></tr></thead><tbody>
+              {data.calendars.map((c) => {
+                const url = `${origin}/book/${c.slug}`;
+                return (
+                  <tr key={c.id}>
+                    <td className="small"><strong>{c.name}</strong><div className="tiny muted">{c.duration_minutes} min · {c.kind === "round_robin" ? "Round robin" : c.kind === "resource" ? "Resource" : "One person"} · {c.member_ids.map((id) => memberName(data.members, id)).filter(Boolean).join(", ")}</div></td>
+                    <td className="tiny">{DAYS.filter(([d]) => c.working_hours[d]?.length).map(([d, l]) => `${l} ${c.working_hours[d]![0][0]}–${c.working_hours[d]![0][1]}`).join(", ") || "None"}<div className="muted">{c.timezone}</div></td>
+                    <td className="small">{c.is_public ? <div className="row" style={{ gap: 6 }}><a className="link mono tiny" href={url} target="_blank" rel="noreferrer">/book/{c.slug}</a><Copy text={url} /></div> : <span className="muted tiny">Staff only</span>}</td>
+                    <td><span className={`pill ${c.status === "active" ? "pill-ok" : "pill-neutral"}`}>{c.status}</span></td>
+                    <td>{canManage && <button className="btn btn-sm" onClick={() => setEditing(c)}>Edit</button>}</td>
+                  </tr>
+                );
+              })}
+            </tbody></table></div>
+          )}
+        </div>
+      )}
+      {node}
+    </div>
+  );
+}
+
+export default function CalendarsPage() {
+  return (
+    <TenantGate title="Calendars" subtitle="Appointments, availability and online booking.">
+      {(info) => <Calendars org={info.org} />}
+    </TenantGate>
+  );
+}
