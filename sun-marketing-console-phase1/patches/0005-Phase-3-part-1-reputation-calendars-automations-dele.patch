new file mode 100644
index 0000000..837f143
--- /dev/null
+++ b/src/lib/calendar/availability.ts
@@ -0,0 +1,88 @@
+import { addDays, localDate, zonedParts, zonedToUtc } from "@/lib/time/zones";
+
+// Pure availability engine shared by the staff calendar, the public booking
+// page and the AI. The database still prevents double booking on its own;
+// this only decides which times to offer.
+
+export const DAY_KEYS = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"] as const;
+export type DayKey = (typeof DAY_KEYS)[number];
+export type WorkingHours = Partial<Record<DayKey, [string, string][]>>;
+
+export type CalendarRules = {
+  timezone: string;
+  duration_minutes: number;
+  slot_interval_minutes: number;
+  buffer_before_minutes: number;
+  buffer_after_minutes: number;
+  min_notice_minutes: number;
+  max_days_ahead: number;
+  daily_limit: number | null;
+  working_hours: WorkingHours;
+};
+// Existing commitments. `who` is a team member id, or "calendar" for appointments
+// that hold the calendar itself (resource calendars or unassigned bookings).
+export type Busy = { who: string; start: Date; end: Date; calendarDay?: string };
+export type Slot = { start: string; end: string; available: string[] };
+
+const HHMM = /^([01]\d|2[0-3]):([0-5]\d)$/;
+
+export function validWorkingHours(value: unknown): value is WorkingHours {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  for (const [k, ranges] of Object.entries(value as Record<string, unknown>)) {
+    if (!(DAY_KEYS as readonly string[]).includes(k) || !Array.isArray(ranges) || ranges.length > 4) return false;
+    for (const r of ranges) {
+      if (!Array.isArray(r) || r.length !== 2 || !HHMM.test(r[0]) || !HHMM.test(r[1]) || r[0] >= r[1]) return false;
+    }
+  }
+  return true;
+}
+
+const minutesOf = (hhmm: string) => +hhmm.slice(0, 2) * 60 + +hhmm.slice(3, 5);
+
+// Offers start times between `fromDay` and `toDay` (inclusive, YYYY-MM-DD in
+// the calendar's zone). `people` are the members who can take a booking; an
+// empty list means the calendar itself is the resource.
+export function computeSlots(rules: CalendarRules, people: string[], busy: Busy[], fromDay: string, toDay: string, now: Date): Slot[] {
+  const tz = rules.timezone;
+  const earliest = now.getTime() + rules.min_notice_minutes * 60_000;
+  const lastDay = addDays(localDate(now, tz), rules.max_days_ahead);
+  const holders = people.length ? people : ["calendar"];
+  const slots: Slot[] = [];
+  const perDay = new Map<string, number>();
+  for (const b of busy) if (b.calendarDay) perDay.set(b.calendarDay, (perDay.get(b.calendarDay) ?? 0) + 1);
+
+  for (let day = fromDay; day <= toDay && day <= lastDay; day = addDays(day, 1)) {
+    if (rules.daily_limit && (perDay.get(day) ?? 0) >= rules.daily_limit) continue;
+    const [y, m, d] = day.split("-").map(Number);
+    const weekday = DAY_KEYS[new Date(Date.UTC(y, m - 1, d)).getUTCDay()];
+    for (const [open, close] of rules.working_hours[weekday] ?? []) {
+      const closeMin = minutesOf(close);
+      for (let t = minutesOf(open); t + rules.duration_minutes <= closeMin; t += rules.slot_interval_minutes) {
+        const start = zonedToUtc(y, m, d, Math.floor(t / 60), t % 60, tz);
+        // A DST gap can move a local time to another wall-clock hour; skip those.
+        const p = zonedParts(start, tz);
+        if (p.hour * 60 + p.minute !== t) continue;
+        if (start.getTime() < earliest) continue;
+        const end = new Date(start.getTime() + rules.duration_minutes * 60_000);
+        // Between two appointments there must be the "after" buffer of the
+        // first plus the "before" buffer of the second, in either order.
+        const gap = (rules.buffer_before_minutes + rules.buffer_after_minutes) * 60_000;
+        const blockStart = start.getTime() - gap;
+        const blockEnd = end.getTime() + gap;
+        // Bookings that hold the calendar itself block everyone on it.
+        const available = holders.filter(
+          (who) => !busy.some((b) => (b.who === who || b.who === "calendar") && b.start.getTime() < blockEnd && b.end.getTime() > blockStart),
+        );
+        if (available.length) slots.push({ start: start.toISOString(), end: end.toISOString(), available });
+      }
+    }
+  }
+  return slots;
+}
+
+// Round robin: the free person with the fewest upcoming bookings, ties broken
+// by calendar order. Deterministic, so two simultaneous requests agree.
+export function pickAssignee(available: string[], order: string[], load: Map<string, number>): string | null {
+  if (!available.length) return null;
+  return [...available].sort((a, b) => (load.get(a) ?? 0) - (load.get(b) ?? 0) || order.indexOf(a) - order.indexOf(b))[0];
+}
diff --git a/src/lib/calendar/service.ts b/src/lib/calendar/service.ts
new file mode 100644
index 0000000..6ff8ba9
--- /dev/null
+++ b/src/lib/calendar/service.ts
@@ -0,0 +1,369 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { normalizeAddress, toE164 } from "@/lib/comms/address";
+import { activeAccounts, findContactByPhone, sendMessage, type SendContext } from "@/lib/comms/service";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { addDays, formatInZone, isValidTimeZone, localDate } from "@/lib/time/zones";
+import { computeSlots, pickAssignee, validWorkingHours, type Busy, type CalendarRules, type Slot, type WorkingHours } from "./availability";
+
+// Calendars and appointments. Functions take a client + organization so the
+// same code serves signed-in staff (RLS applies), the AI operator (as the
+// accountable user) and the public booking page (service role, explicitly
+// scoped to the calendar's organization).
+export type Ctx = { client: SupabaseClient; orgId: string; userId: string | null };
+
+export const CALENDAR_COLUMNS =
+  "id, organization_id, name, slug, description, kind, timezone, duration_minutes, slot_interval_minutes, buffer_before_minutes, buffer_after_minutes, min_notice_minutes, max_days_ahead, daily_limit, working_hours, location, confirmation_message, is_public, status, created_at";
+export const APPOINTMENT_COLUMNS =
+  "id, organization_id, calendar_id, contact_id, assigned_user_id, starts_at, ends_at, status, title, notes, location, source, cancel_reason, reminder_sent_at, manage_token, created_at";
+
+export type Calendar = CalendarRules & {
+  id: string; organization_id: string; name: string; slug: string; description: string | null; kind: "personal" | "round_robin" | "resource";
+  location: string | null; confirmation_message: string | null; is_public: boolean; status: "active" | "inactive"; created_at: string;
+};
+export type Appointment = {
+  id: string; organization_id: string; calendar_id: string; contact_id: string; assigned_user_id: string | null; starts_at: string; ends_at: string;
+  status: "booked" | "confirmed" | "cancelled" | "completed" | "no_show"; title: string | null; notes: string | null; location: string | null;
+  source: string; cancel_reason: string | null; reminder_sent_at: string | null; manage_token: string; created_at: string;
+};
+
+const minutes = (min: number, max: number) => z.number().int().min(min).max(max);
+export const calendarInput = z.object({
+  name: z.string().trim().min(1, "Name the calendar.").max(80),
+  slug: z.string().trim().toLowerCase().regex(/^[a-z0-9][a-z0-9-]{2,62}$/, "Use 3-63 lowercase letters, numbers and dashes."),
+  description: z.string().trim().max(1000).optional().nullable(),
+  kind: z.enum(["personal", "round_robin", "resource"]).default("personal"),
+  timezone: z.string().refine(isValidTimeZone, "Unknown time zone."),
+  duration_minutes: minutes(5, 480).default(30),
+  slot_interval_minutes: minutes(5, 240).default(30),
+  buffer_before_minutes: minutes(0, 240).default(0),
+  buffer_after_minutes: minutes(0, 240).default(0),
+  min_notice_minutes: minutes(0, 43200).default(120),
+  max_days_ahead: minutes(1, 365).default(30),
+  daily_limit: z.number().int().min(1).max(100).nullable().optional(),
+  working_hours: z.custom<WorkingHours>(validWorkingHours, "Working hours must be HH:MM ranges, start before end."),
+  location: z.string().trim().max(300).optional().nullable(),
+  confirmation_message: z.string().trim().max(1000).optional().nullable(),
+  is_public: z.boolean().default(false),
+  status: z.enum(["active", "inactive"]).default("active"),
+  member_ids: z.array(z.string().uuid()).max(50).default([]),
+});
+export const calendarPatch = calendarInput.partial();
+
+export const bookingInput = z.object({
+  calendar_id: z.string().uuid(),
+  contact_id: z.string().uuid(),
+  starts_at: z.string().datetime({ offset: true }),
+  assigned_user_id: z.string().uuid().optional(),
+  title: z.string().trim().max(200).optional(),
+  notes: z.string().trim().max(4000).optional(),
+  // Staff may book outside the published hours (e.g. a call-back at 7am).
+  outside_hours: z.boolean().optional(),
+  notify: z.boolean().optional(),
+});
+export type BookingInput = z.infer<typeof bookingInput>;
+
+function conflict(error: { code?: string } | null) {
+  if (error?.code === "23P01") throw new ApiError("That time was just taken. Pick another time.", 409, "conflict");
+}
+
+export async function loadCalendar(client: SupabaseClient, orgId: string, id: string) {
+  const [cal, members] = await Promise.all([
+    client.from("calendars").select(CALENDAR_COLUMNS).eq("organization_id", orgId).eq("id", id).maybeSingle(),
+    client.from("calendar_members").select("user_id, position").eq("organization_id", orgId).eq("calendar_id", id).order("position"),
+  ]);
+  fromDb(cal.error);
+  fromDb(members.error);
+  if (!cal.data) throw new ApiError("Calendar not found.", 404, "not_found");
+  return { calendar: cal.data as Calendar, members: (members.data || []).map((m) => m.user_id as string) };
+}
+
+export async function listCalendars(ctx: Ctx) {
+  const [cals, members] = await Promise.all([
+    ctx.client.from("calendars").select(CALENDAR_COLUMNS).eq("organization_id", ctx.orgId).order("created_at"),
+    ctx.client.from("calendar_members").select("calendar_id, user_id, position").eq("organization_id", ctx.orgId).order("position"),
+  ]);
+  fromDb(cals.error);
+  fromDb(members.error);
+  return ((cals.data || []) as Calendar[]).map((c) => ({
+    ...c, member_ids: (members.data || []).filter((m) => m.calendar_id === c.id).map((m) => m.user_id as string),
+  }));
+}
+
+async function setMembers(ctx: Ctx, calendarId: string, ids: string[]) {
+  const del = await ctx.client.from("calendar_members").delete().eq("organization_id", ctx.orgId).eq("calendar_id", calendarId);
+  fromDb(del.error);
+  if (!ids.length) return;
+  const { error } = await ctx.client.from("calendar_members").insert(
+    [...new Set(ids)].map((user_id, position) => ({ calendar_id: calendarId, organization_id: ctx.orgId, user_id, position })),
+  );
+  if (error?.code === "23514") throw new ApiError("Only team members can be added to a calendar.", 422, "invalid");
+  fromDb(error);
+}
+
+export async function createCalendar(ctx: Ctx, input: z.infer<typeof calendarInput>) {
+  const { member_ids, ...row } = input;
+  if (row.kind !== "resource" && !member_ids.length) throw new ApiError("Add at least one team member who takes these appointments.", 422, "invalid");
+  const { data, error } = await ctx.client.from("calendars").insert({ ...row, organization_id: ctx.orgId, created_by: ctx.userId }).select(CALENDAR_COLUMNS).single();
+  if (error?.code === "23505") throw new ApiError("That booking link is taken. Choose another.", 409, "conflict");
+  fromDb(error);
+  await setMembers(ctx, data!.id, row.kind === "resource" ? [] : member_ids);
+  return data as Calendar;
+}
+
+export async function updateCalendar(ctx: Ctx, id: string, patch: z.infer<typeof calendarPatch>) {
+  const { member_ids, ...row } = patch;
+  if (Object.keys(row).length) {
+    const { error } = await ctx.client.from("calendars").update(row).eq("organization_id", ctx.orgId).eq("id", id);
+    if (error?.code === "23505") throw new ApiError("That booking link is taken. Choose another.", 409, "conflict");
+    fromDb(error);
+  }
+  if (member_ids) await setMembers(ctx, id, member_ids);
+  return loadCalendar(ctx.client, ctx.orgId, id);
+}
+
+// Commitments that matter for this calendar's offer: anything assigned to its
+// members (on any of the organization's calendars) and bookings that hold the
+// calendar itself.
+async function busyFor(client: SupabaseClient, cal: Calendar, members: string[], from: Date, to: Date, excludeId?: string): Promise<Busy[]> {
+  const pad = 12 * 3600_000;
+  let q = client.from("appointments").select("id, calendar_id, assigned_user_id, starts_at, ends_at")
+    .eq("organization_id", cal.organization_id).in("status", ["booked", "confirmed"])
+    .lt("starts_at", new Date(to.getTime() + pad).toISOString()).gt("ends_at", new Date(from.getTime() - pad).toISOString());
+  q = members.length ? q.or(`calendar_id.eq.${cal.id},assigned_user_id.in.(${members.join(",")})`) : q.eq("calendar_id", cal.id);
+  const { data, error } = await q.limit(2000);
+  fromDb(error);
+  const busy: Busy[] = [];
+  for (const a of data || []) {
+    if (a.id === excludeId) continue;
+    const who = a.assigned_user_id ?? (a.calendar_id === cal.id ? "calendar" : null);
+    if (!who) continue;
+    const start = new Date(a.starts_at);
+    busy.push({ who, start, end: new Date(a.ends_at), calendarDay: a.calendar_id === cal.id ? localDate(start, cal.timezone) : undefined });
+  }
+  return busy;
+}
+
+export async function availability(client: SupabaseClient, orgId: string, calendarId: string, fromDay: string, days: number, now = new Date(), excludeId?: string) {
+  const { calendar, members } = await loadCalendar(client, orgId, calendarId);
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(fromDay)) throw new ApiError("Dates look like 2030-01-31.", 422, "invalid");
+  const toDay = addDays(fromDay, Math.min(Math.max(days, 1), 31) - 1);
+  if (calendar.status !== "active") return { calendar, members, slots: [] as Slot[] };
+  const from = new Date(`${fromDay}T00:00:00Z`);
+  const to = new Date(`${addDays(toDay, 1)}T00:00:00Z`);
+  const busy = await busyFor(client, calendar, members, from, to, excludeId);
+  return { calendar, members, slots: computeSlots(calendar, calendar.kind === "resource" ? [] : members, busy, fromDay, toDay, now) };
+}
+
+async function upcomingLoad(client: SupabaseClient, orgId: string, members: string[], now: Date) {
+  const load = new Map<string, number>();
+  if (!members.length) return load;
+  const { data, error } = await client.from("appointments").select("assigned_user_id").eq("organization_id", orgId)
+    .in("status", ["booked", "confirmed"]).gte("starts_at", now.toISOString()).in("assigned_user_id", members).limit(5000);
+  fromDb(error);
+  for (const r of data || []) load.set(r.assigned_user_id, (load.get(r.assigned_user_id) ?? 0) + 1);
+  return load;
+}
+
+// Books an appointment after re-checking that the time is still offered.
+// The exclusion constraint is the final word if two people race for it.
+export async function book(ctx: Ctx, input: BookingInput, source: "staff" | "public" | "ai" | "workflow", now = new Date()) {
+  const start = new Date(input.starts_at);
+  const { calendar, members } = await loadCalendar(ctx.client, ctx.orgId, input.calendar_id);
+  if (calendar.status !== "active") throw new ApiError("This calendar is not taking bookings.", 409, "conflict");
+  const day = localDate(start, calendar.timezone);
+  const { slots } = await availability(ctx.client, ctx.orgId, calendar.id, day, 1, now);
+  const slot = slots.find((s) => new Date(s.start).getTime() === start.getTime());
+  const people = calendar.kind === "resource" ? [] : members;
+  let assignee: string | null = null;
+  if (!slot) {
+    if (!(input.outside_hours && source === "staff")) throw new ApiError("That time is not available. Pick one of the offered times.", 409, "conflict");
+    assignee = input.assigned_user_id ?? (calendar.kind === "personal" ? people[0] ?? null : null);
+  } else if (people.length) {
+    if (input.assigned_user_id) {
+      if (!slot.available.includes(input.assigned_user_id)) throw new ApiError("That person is busy then. Pick another time or person.", 409, "conflict");
+      assignee = input.assigned_user_id;
+    } else {
+      assignee = calendar.kind === "round_robin" ? pickAssignee(slot.available, people, await upcomingLoad(ctx.client, ctx.orgId, people, now)) : slot.available[0];
+    }
+  }
+  const ends = new Date(start.getTime() + calendar.duration_minutes * 60_000);
+  const { data, error } = await ctx.client.from("appointments").insert({
+    organization_id: ctx.orgId, calendar_id: calendar.id, contact_id: input.contact_id, assigned_user_id: assignee,
+    starts_at: start.toISOString(), ends_at: ends.toISOString(), status: "booked", title: input.title || calendar.name,
+    notes: input.notes || null, location: calendar.location, source, booked_by: source === "public" || source === "workflow" ? null : ctx.userId,
+  }).select(APPOINTMENT_COLUMNS).single();
+  conflict(error);
+  fromDb(error);
+  return { appointment: data as Appointment, calendar };
+}
+
+export async function getAppointment(client: SupabaseClient, orgId: string, id: string) {
+  const { data, error } = await client.from("appointments").select(APPOINTMENT_COLUMNS).eq("organization_id", orgId).eq("id", id).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Appointment not found.", 404, "not_found");
+  return data as Appointment;
+}
+
+export const appointmentChange = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("status"), status: z.enum(["confirmed", "cancelled", "completed", "no_show"]), reason: z.string().trim().max(500).optional() }),
+  z.object({ action: z.literal("reschedule"), starts_at: z.string().datetime({ offset: true }), outside_hours: z.boolean().optional() }),
+]);
+
+export async function changeAppointment(ctx: Ctx, id: string, change: z.infer<typeof appointmentChange>, now = new Date(), actor: "staff" | "public" = "staff") {
+  const appt = await getAppointment(ctx.client, ctx.orgId, id);
+  if (change.action === "status") {
+    if (actor === "public" && change.status !== "cancelled") throw new ApiError("Not allowed.", 403, "forbidden");
+    const { data, error } = await ctx.client.from("appointments").update({ status: change.status, cancel_reason: change.reason ?? appt.cancel_reason })
+      .eq("organization_id", ctx.orgId).eq("id", id).select(APPOINTMENT_COLUMNS).single();
+    fromDb(error);
+    return data as Appointment;
+  }
+  if (!["booked", "confirmed"].includes(appt.status)) throw new ApiError("Only upcoming appointments can be moved.", 409, "conflict");
+  const start = new Date(change.starts_at);
+  const { calendar: cal } = await loadCalendar(ctx.client, ctx.orgId, appt.calendar_id);
+  const { calendar, slots } = await availability(ctx.client, ctx.orgId, appt.calendar_id, localDate(start, cal.timezone), 1, now, appt.id);
+  const slot = slots.find((s) => new Date(s.start).getTime() === start.getTime());
+  if (!slot && !(change.outside_hours && actor === "staff")) throw new ApiError("That time is not available.", 409, "conflict");
+  let assignee = appt.assigned_user_id;
+  if (slot && assignee && !slot.available.includes(assignee)) assignee = slot.available[0] ?? assignee;
+  const { data, error } = await ctx.client.from("appointments").update({
+    starts_at: start.toISOString(), ends_at: new Date(start.getTime() + calendar.duration_minutes * 60_000).toISOString(), assigned_user_id: assignee,
+  }).eq("organization_id", ctx.orgId).eq("id", id).select(APPOINTMENT_COLUMNS).single();
+  conflict(error);
+  fromDb(error);
+  return data as Appointment;
+}
+
+export async function listAppointments(ctx: Ctx, opts: { from: string; to: string; calendarId?: string; contactId?: string }) {
+  let q = ctx.client.from("appointments").select(`${APPOINTMENT_COLUMNS}, contacts(first_name, last_name, phone, email), calendars(name, timezone)`)
+    .eq("organization_id", ctx.orgId).gte("starts_at", opts.from).lt("starts_at", opts.to);
+  if (opts.calendarId) q = q.eq("calendar_id", opts.calendarId);
+  if (opts.contactId) q = q.eq("contact_id", opts.contactId);
+  const { data, error } = await q.order("starts_at").limit(500);
+  fromDb(error);
+  return data || [];
+}
+
+// --------------------------------------------------------- public booking
+export const publicBookingInput = z.object({
+  starts_at: z.string().datetime({ offset: true }),
+  first_name: z.string().trim().min(1, "Enter your first name.").max(80),
+  last_name: z.string().trim().max(80).optional(),
+  email: z.string().trim().toLowerCase().email("Enter a valid email.").max(254),
+  phone: z.string().trim().regex(/^\+?[0-9() .-]{7,32}$/, "Enter a valid phone number.").optional().or(z.literal("")),
+  notes: z.string().trim().max(1000).optional(),
+  sms_consent: z.boolean().optional(),
+});
+export const SMS_CONSENT_TEXT = (business: string) =>
+  `I agree to receive appointment texts from ${business}. Message frequency varies. Msg & data rates may apply. Reply STOP to opt out, HELP for help. Consent is not a condition of purchase.`;
+
+// Matches an online booker to an existing contact only on an exact email
+// match, or on phone when that contact has no email (or the same one). A
+// stranger typing someone's phone number next to a different email gets a
+// new contact instead of attaching bookings and consent to that person.
+export async function findOrCreateContact(ctx: Ctx, person: { first_name: string; last_name?: string; email: string; phone?: string }, source: string) {
+  const email = normalizeAddress("email", person.email)?.toLowerCase() ?? null;
+  if (email) {
+    const { data, error } = await ctx.client.from("contacts").select("id, phone").eq("organization_id", ctx.orgId).is("erased_at", null).eq("email", email).limit(1).maybeSingle();
+    fromDb(error);
+    if (data) {
+      if (!data.phone && person.phone) await ctx.client.from("contacts").update({ phone: person.phone }).eq("organization_id", ctx.orgId).eq("id", data.id);
+      return data.id as string;
+    }
+  }
+  const e164 = person.phone ? toE164(person.phone) : null;
+  if (e164) {
+    const match = await findContactByPhone(ctx.client, ctx.orgId, e164);
+    if (match) {
+      const { data, error } = await ctx.client.from("contacts").select("id, email").eq("organization_id", ctx.orgId).eq("id", match.id).maybeSingle();
+      fromDb(error);
+      if (data && !data.email) {
+        if (email) await ctx.client.from("contacts").update({ email }).eq("organization_id", ctx.orgId).eq("id", data.id);
+        return data.id as string;
+      }
+    }
+  }
+  const { data, error } = await ctx.client.from("contacts").insert({
+    organization_id: ctx.orgId, first_name: person.first_name, last_name: person.last_name || null, email,
+    phone: person.phone || null, source, lifecycle_stage: "lead",
+  }).select("id").single();
+  fromDb(error);
+  return data!.id as string;
+}
+
+// ------------------------------------------------------------ notifications
+type NoticeKind = "booked" | "reminder" | "cancelled" | "rescheduled";
+
+export function appointmentText(kind: NoticeKind, a: { starts_at: string; location: string | null }, cal: { name: string; timezone: string; confirmation_message?: string | null }, firstName: string | null, business: string, manageUrl: string | null) {
+  const when = formatInZone(a.starts_at, cal.timezone);
+  const hi = firstName ? `Hi ${firstName}, ` : "";
+  const where = a.location ? ` Location: ${a.location}.` : "";
+  const manage = manageUrl ? ` Reschedule or cancel: ${manageUrl}` : "";
+  switch (kind) {
+    case "booked":
+      return `${hi}you're booked with ${business} for ${cal.name} on ${when}.${where}${cal.confirmation_message ? ` ${cal.confirmation_message}` : ""}${manage}`;
+    case "reminder":
+      return `${hi}reminder: ${cal.name} with ${business} on ${when}.${where}${manage}`;
+    case "rescheduled":
+      return `${hi}your ${cal.name} with ${business} is now on ${when}.${where}${manage}`;
+    case "cancelled":
+      return `${hi}your ${cal.name} with ${business} on ${when} has been cancelled.`;
+  }
+}
+
+// Sends an appointment notice by text when allowed, otherwise by email.
+// Appointment notices are transactional; the compliance gate still applies.
+export async function notifyAppointment(ctx: SendContext, appt: Appointment, cal: Pick<Calendar, "name" | "timezone" | "confirmation_message">, kind: NoticeKind, opts: { system?: boolean; req?: Request } = {}) {
+  const [{ data: contact }, { data: org }] = await Promise.all([
+    ctx.client.from("contacts").select("first_name, phone, email").eq("organization_id", ctx.orgId).eq("id", appt.contact_id).maybeSingle(),
+    ctx.client.from("organizations").select("name").eq("id", ctx.orgId).maybeSingle(),
+  ]);
+  if (!contact) return { sent: false, reason: "Contact not found." };
+  const base = publicBaseUrl(opts.req);
+  const manageUrl = base && kind !== "cancelled" ? `${base}/appointment/${appt.manage_token}` : null;
+  const body = appointmentText(kind, appt, cal, contact.first_name, org?.name || "our team", manageUrl);
+  const reasons: string[] = [];
+  for (const channel of ["sms", "email"] as const) {
+    if (!(channel === "sms" ? contact.phone : contact.email)) continue;
+    if (!(await activeAccounts(ctx.client, ctx.orgId, channel)).length) { reasons.push(`no ${channel} channel connected`); continue; }
+    try {
+      const r = await sendMessage(ctx, {
+        contact_id: appt.contact_id, channel, body, purpose: "transactional",
+        subject: channel === "email" ? `${kind === "reminder" ? "Reminder: " : ""}${cal.name} — ${formatInZone(appt.starts_at, cal.timezone)}` : undefined,
+        idempotency_key: `appt-${kind}-${appt.id}-${channel}-${appt.starts_at}`.slice(0, 100),
+      }, { system: opts.system, req: opts.req });
+      if (r.outcome === "sent" || r.outcome === "duplicate") return { sent: true, channel };
+      reasons.push(r.outcome === "blocked" ? r.reason : `${channel} ${r.outcome}`);
+    } catch (e) {
+      reasons.push(e instanceof Error ? e.message : `${channel} failed`);
+    }
+  }
+  return { sent: false, reason: reasons.join("; ") || "No phone or email on file." };
+}
+
+// Reminders for appointments 1-24 hours away (scheduler, service role).
+export async function sendReminders(system: SupabaseClient, now = new Date(), limit = 50) {
+  const { data, error } = await system.from("appointments").select(`${APPOINTMENT_COLUMNS}, calendars(name, timezone, confirmation_message)`)
+    .in("status", ["booked", "confirmed"]).is("reminder_sent_at", null)
+    .gte("starts_at", new Date(now.getTime() + 3600_000).toISOString()).lte("starts_at", new Date(now.getTime() + 24 * 3600_000).toISOString())
+    .order("starts_at").limit(limit);
+  fromDb(error);
+  const summary = { reminded: 0, skipped: 0 };
+  for (const row of data || []) {
+    const { data: claimed } = await system.from("appointments").update({ reminder_sent_at: now.toISOString() })
+      .eq("id", row.id).eq("organization_id", row.organization_id).is("reminder_sent_at", null).select("id").maybeSingle();
+    if (!claimed) continue;
+    const cal = (Array.isArray(row.calendars) ? row.calendars[0] : row.calendars) as Pick<Calendar, "name" | "timezone" | "confirmation_message">;
+    const r = await notifyAppointment({ client: system, orgId: row.organization_id, userId: null }, row as Appointment, cal, "reminder", { system: true });
+    if (r.sent) summary.reminded++;
+    else summary.skipped++;
+  }
+  return summary;
+}
+
+export function todayIn(tz: string, now = new Date()) {
+  return localDate(now, tz);
+}
