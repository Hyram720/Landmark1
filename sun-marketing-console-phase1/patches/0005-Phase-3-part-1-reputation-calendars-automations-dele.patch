+"use client";
+import { use, useCallback, useEffect, useState } from "react";
+import "@/components/public/public.css";
+
+type Info = { business: string; status: string; starts_at: string; location: string | null; calendar: { name: string; timezone: string; can_reschedule: boolean }; can_change: boolean; slots?: { start: string }[] };
+const fmt = (iso: string, tz: string, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat("en-US", { ...o, timeZone: tz }).format(new Date(iso));
+
+export default function ManageAppointment({ params }: { params: Promise<{ token: string }> }) {
+  const { token } = use(params);
+  const [info, setInfo] = useState<Info | null>(null);
+  const [error, setError] = useState("");
+  const [mode, setMode] = useState<"view" | "move" | "cancel">("view");
+  const [busy, setBusy] = useState(false);
+  const [msg, setMsg] = useState("");
+  const load = useCallback(async (withSlots = false) => {
+    try {
+      const today = new Date().toISOString().slice(0, 10);
+      const r = await fetch(`/api/public/appointment/${token}${withSlots ? `?from=${today}` : ""}`, { cache: "no-store" });
+      const j = await r.json();
+      if (!r.ok) throw new Error(j.error || "This link is not valid.");
+      setInfo(j);
+    } catch (e) { setError(e instanceof Error ? e.message : "This link is not valid."); }
+  }, [token]);
+  useEffect(() => { load(); }, [load]);
+  const post = async (body: Record<string, unknown>, done: string) => {
+    setBusy(true); setMsg("");
+    try {
+      const r = await fetch(`/api/public/appointment/${token}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
+      const j = await r.json();
+      if (!r.ok) throw new Error(j.error || "That did not work.");
+      setMsg(done); setMode("view"); await load();
+    } catch (e) { setMsg(e instanceof Error ? e.message : "That did not work."); }
+    finally { setBusy(false); }
+  };
+  if (error) return <div className="pub"><div className="pub-card narrow"><h1>Link not valid</h1><p className="lead">{error}</p></div></div>;
+  if (!info) return <div className="pub"><div className="pub-card narrow"><p className="lead">Loading…</p></div></div>;
+  const tz = info.calendar.timezone;
+  return (
+    <div className="pub"><div className="pub-card narrow">
+      <h1>{info.calendar.name}</h1>
+      <p className="lead">{info.business}</p>
+      <p style={{ fontSize: 17, fontWeight: 650 }}>{fmt(info.starts_at, tz, { weekday: "long", month: "long", day: "numeric", hour: "numeric", minute: "2-digit", timeZoneName: "short" })}</p>
+      {info.location && <p className="lead">{info.location}</p>}
+      <p><span className={`pill ${info.status === "cancelled" ? "pill-neutral" : info.status === "confirmed" ? "pill-ok" : "pill-info"}`}>{info.status === "booked" ? "Booked" : info.status.replace("_", "-")}</span></p>
+      {msg && <p className="lead" role="status" style={{ marginTop: 10 }}>{msg}</p>}
+      {info.can_change && mode === "view" && <div className="row" style={{ justifyContent: "center", marginTop: 14, flexWrap: "wrap" }}>
+        {info.calendar.can_reschedule && <button className="btn" onClick={async () => { setMode("move"); await load(true); }}>Reschedule</button>}
+        <button className="btn btn-ghost" onClick={() => setMode("cancel")}>Cancel appointment</button>
+      </div>}
+      {mode === "move" && <div className="stack" style={{ marginTop: 14 }}>
+        <strong style={{ fontSize: 14 }}>Pick a new time (next 7 days)</strong>
+        {!info.slots ? <p className="lead">Loading times…</p> : info.slots.length === 0 ? <p className="lead">No open times this week. Please call us.</p> :
+          <div className="times">{info.slots.slice(0, 40).map((s) => <button key={s.start} className="time" disabled={busy} onClick={() => post({ action: "reschedule", starts_at: s.start }, "Rescheduled. We'll send you the new time.")}>{fmt(s.start, tz, { weekday: "short", hour: "numeric", minute: "2-digit" })}</button>)}</div>}
+        <button className="btn btn-ghost btn-sm" onClick={() => setMode("view")}>Keep current time</button>
+      </div>}
+      {mode === "cancel" && <form className="stack" style={{ marginTop: 14 }} onSubmit={(e) => { e.preventDefault(); const f = new FormData(e.currentTarget); post({ action: "cancel", reason: String(f.get("reason") || "").trim() || undefined }, "Cancelled. Thanks for letting us know."); }}>
+        <div className="field"><label htmlFor="c-reason">Reason (optional)</label><input id="c-reason" name="reason" className="input" maxLength={500} /></div>
+        <div className="row" style={{ justifyContent: "center" }}><button className="btn btn-danger" disabled={busy}>Cancel appointment</button><button type="button" className="btn btn-ghost" onClick={() => setMode("view")}>Keep it</button></div>
+      </form>}
+    </div></div>
+  );
+}
