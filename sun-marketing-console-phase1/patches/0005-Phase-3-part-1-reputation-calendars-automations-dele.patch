+          <div className="step-head"><span className="pill pill-sun">When</span>
+            <select className="select" aria-label="Trigger" value={def.trigger.type} onChange={(e) => setDef({ ...def, trigger: { type: e.target.value as TriggerType, filters: {} } })}>
+              {Object.entries(TRIGGERS).map(([k, v]) => <option key={k} value={k}>{v.label}</option>)}</select></div>
+          {trig.filters.length > 0 && <div className="row small" style={{ flexWrap: "wrap" }}>
+            <span className="muted">Only if</span>
+            {(trig.filters as readonly string[]).includes("tag") && <input className="input" style={{ maxWidth: 160 }} aria-label="Tag" placeholder="tag (any)" value={filters.tag ?? ""} onChange={(e) => setFilter("tag", e.target.value)} />}
+            {(trig.filters as readonly string[]).includes("source") && <input className="input" style={{ maxWidth: 180 }} aria-label="Source" placeholder="source (any)" value={filters.source ?? ""} onChange={(e) => setFilter("source", e.target.value)} />}
+            {(trig.filters as readonly string[]).includes("stage_name") && <input className="input" style={{ maxWidth: 180 }} aria-label="Deal stage" placeholder="deal stage name (any)" value={filters.stage_name ?? ""} onChange={(e) => setFilter("stage_name", e.target.value)} />}
+            {(trig.filters as readonly string[]).includes("lifecycle_stage") && <select className="select" aria-label="New stage" value={filters.lifecycle_stage ?? ""} onChange={(e) => setFilter("lifecycle_stage", e.target.value)}><option value="">any stage</option>{STAGES.map((s) => <option key={s} value={s}>{s}</option>)}</select>}
+            {(trig.filters as readonly string[]).includes("channel") && <select className="select" aria-label="Channel" value={filters.channel ?? ""} onChange={(e) => setFilter("channel", e.target.value)}><option value="">text or email</option><option value="sms">text</option><option value="email">email</option></select>}
+            {(trig.filters as readonly string[]).includes("rating_max") && <select className="select" aria-label="Rating" value={filters.rating_max ?? ""} onChange={(e) => setFilter("rating_max", e.target.value ? Number(e.target.value) : undefined)}><option value="">any rating</option>{[1, 2, 3, 4].map((n) => <option key={n} value={n}>{n} star{n > 1 ? "s" : ""} or lower</option>)}</select>}
+          </div>}
+        </div>
+        {def.steps.map((s, i) => (
+          <div key={i} className="step">
+            <div className="step-head"><span className="step-num">{i + 1}</span><strong className="small">{STEP_LABELS[s.type]}</strong>
+              <span style={{ flex: 1 }} />
