+import { readJson, scoped, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { book, bookingInput, listAppointments, notifyAppointment } from "@/lib/calendar/service";
+
+export const dynamic = "force-dynamic";
+
+export const GET = tenantRoute("crm.read", async (ctx, req) => {
+  const url = new URL(req.url);
+  const from = url.searchParams.get("from") || new Date(Date.now() - 86_400_000).toISOString();
+  const to = url.searchParams.get("to") || new Date(Date.now() + 30 * 86_400_000).toISOString();
+  if (Number.isNaN(Date.parse(from)) || Number.isNaN(Date.parse(to))) return { appointments: [] };
+  return { appointments: await listAppointments(scoped(ctx), { from, to, calendarId: url.searchParams.get("calendar") || undefined, contactId: url.searchParams.get("contact") || undefined }) };
+});
+
+// Staff booking. Confirmations go out only if asked and only if the
+// customer's contact rules allow it.
+export const POST = tenantRoute("crm.write", async (ctx, req) => {
+  const input = await readJson(req, bookingInput);
+  const { appointment, calendar } = await book(scoped(ctx), input, "staff");
+  await audit(ctx.client, ctx.org.id, "appointment.booked", { type: "appointment", id: appointment.id }, { calendar: calendar.name, outside_hours: !!input.outside_hours });
+  const notice = input.notify ? await notifyAppointment(scoped(ctx), appointment, calendar, "booked", { req }) : null;
+  return { appointment, notice };
+});
