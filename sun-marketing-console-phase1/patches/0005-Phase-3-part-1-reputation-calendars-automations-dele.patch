+          </div>
+        ))}
+        <div className="row"><select className="select" aria-label="Step type" value={addType} onChange={(e) => setAddType(e.target.value as Step["type"])}>{Object.entries(STEP_LABELS).map(([k, l]) => <option key={k} value={k}>{l}</option>)}</select>
