+-- Phase 3 security tests: reputation, calendars, workflows, domain events.
+-- Run with scripts/test-db.sh.
+\set ON_ERROR_STOP 1
+set client_min_messages = notice;
+
+create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, false);
+  execute 'set role authenticated';
+end $$;
+create or replace function pg_temp.as_service() returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', '{"role":"service_role"}', false);
+  execute 'set role service_role';
+end $$;
+create or replace function pg_temp.reset_user() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', false);
+end $$;
+create or replace function pg_temp.expect_error(p_sql text, p_label text) returns void language plpgsql as $$
+begin
+  begin execute p_sql; exception when others then raise notice 'ok   (denied) %', p_label; return; end;
+  raise exception 'FAIL expected an error: %', p_label;
+end $$;
+create or replace function pg_temp.expect(p_ok boolean, p_label text) returns void language plpgsql as $$
+begin
+  if not coalesce(p_ok, false) then raise exception 'FAIL %', p_label; end if;
+  raise notice 'ok   %', p_label;
+end $$;
+
+-- Users: 1 = owner of agency X (staff), 2 = member of X, 3 = manager of X, 4 = owner of agency Y (staff)
+insert into auth.users values
+  ('30000000-0000-0000-0000-000000000001', 'owner@p3x.test'), ('30000000-0000-0000-0000-000000000002', 'member@p3x.test'),
+  ('30000000-0000-0000-0000-000000000003', 'manager@p3x.test'), ('30000000-0000-0000-0000-000000000004', 'owner@p3y.test');
+insert into public.team_members(user_id, email, active) values
+  ('30000000-0000-0000-0000-000000000001', 'owner@p3x.test', true), ('30000000-0000-0000-0000-000000000004', 'owner@p3y.test', true);
+create temp table ids (k text primary key, v uuid);
+grant all on ids to authenticated, service_role;
+
+select pg_temp.as_user('30000000-0000-0000-0000-000000000001');
+insert into ids select 'x', public.create_organization('Agency P3X', 'agency');
+select public.add_member_by_email((select v from ids where k = 'x'), 'member@p3x.test', 'member');
+select public.add_member_by_email((select v from ids where k = 'x'), 'manager@p3x.test', 'manager');
+with c as (insert into public.contacts(organization_id, first_name, phone, email)
+  values ((select v from ids where k = 'x'), 'Robin', '+18565550111', 'robin@p3x.test') returning id)
+insert into ids select 'robin', id from c;
+select pg_temp.reset_user();
+
+select pg_temp.as_user('30000000-0000-0000-0000-000000000004');
+insert into ids select 'y', public.create_organization('Agency P3Y', 'agency');
+select pg_temp.reset_user();
+
+-- 1. Domain events: emitted by triggers, never written through the API.
+select pg_temp.expect((select count(*) = 1 from public.domain_events where type = 'contact.created' and contact_id = (select v from ids where k = 'robin')),
+  'creating a contact emits contact.created');
+select pg_temp.as_user('30000000-0000-0000-0000-000000000002');
+update public.contacts set tags = array['vip'] where id = (select v from ids where k = 'robin');
+select pg_temp.expect_error($$insert into public.domain_events(organization_id, type) values ((select v from ids where k = 'x'), 'contact.created')$$,
+  'members cannot forge domain events');
+select pg_temp.expect_error($$select public.emit_event((select v from ids where k = 'x'), 'contact.created', null, null, '{}')$$,
+  'emit_event is not callable through the API');
+select pg_temp.expect((select count(*) = 0 from public.domain_events), 'members cannot read the event stream');
+select pg_temp.reset_user();
+select pg_temp.expect((select count(*) = 1 from public.domain_events where type = 'contact.tag_added' and payload ->> 'tag' = 'vip'),
+  'adding a tag emits contact.tag_added');
+select pg_temp.as_user('30000000-0000-0000-0000-000000000001');
+insert into public.contacts(organization_id, first_name, source)
+  select (select v from ids where k = 'x'), 'Bulk ' || g, 'CSV import' from generate_series(1, 30) g;
+select pg_temp.reset_user();
+select pg_temp.expect((select count(*) = 0 from public.domain_events where type = 'contact.created' and payload ->> 'source' = 'CSV import'),
+  'bulk imports do not start automations');
+
+-- 2. Reputation
+select pg_temp.as_user('30000000-0000-0000-0000-000000000002');
+select pg_temp.expect_error($$insert into public.review_sources(organization_id, platform, name, review_url)
+  values ((select v from ids where k = 'x'), 'google', 'Google', 'https://g.page/r/abc/review')$$, 'members cannot configure review sites');
+with r as (insert into public.reviews(organization_id, platform, rating, author_name, body, contact_id)
+  values ((select v from ids where k = 'x'), 'google', 2, 'Robin', 'Showed up late.', (select v from ids where k = 'robin')) returning id)
+insert into ids select 'review', id from r;
+select pg_temp.expect((select count(*) = 1 from public.tasks where title like 'Respond to 2-star Google review%' and priority = 'high'),
+  'a negative review opens a high-priority task');
+select pg_temp.expect_error($$update public.reviews set rating = 5 where id = (select v from ids where k = 'review')$$, 'a customer''s review cannot be edited');
+update public.reviews set response_body = 'We are sorry, Robin.', response_status = 'posted' where id = (select v from ids where k = 'review');
+select pg_temp.expect((select responded_by = '30000000-0000-0000-0000-000000000002' and responded_at is not null from public.reviews where id = (select v from ids where k = 'review')),
