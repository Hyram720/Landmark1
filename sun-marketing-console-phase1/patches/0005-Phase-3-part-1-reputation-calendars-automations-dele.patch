@@ -0,0 +1,32 @@
+import { NextResponse } from "next/server";
+import { systemClient } from "@/lib/supabase/system";
+import { sameSecret } from "@/lib/rate-limit";
+import { enrollFromEvents, advanceRuns } from "@/lib/workflows/engine";
+import { sendReminders } from "@/lib/calendar/service";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+// Background work for Phase 3, called by the scheduler with AUTOMATION_SECRET:
+// start automations from new events, advance due runs, send appointment reminders.
+export async function POST(req: Request) {
+  const secret = process.env.AUTOMATION_SECRET;
+  if (!secret || !sameSecret(req.headers.get("authorization") || "", `Bearer ${secret}`)) return NextResponse.json({ error: "Unauthorized." }, { status: 401 });
+  const system = systemClient();
+  if (!system) return NextResponse.json({ error: "Integration not configured: SUPABASE_SERVICE_ROLE_KEY is not set." }, { status: 503 });
+  const now = new Date();
+  const result: Record<string, unknown> = {};
+  for (const [name, job] of [
+    ["events", () => enrollFromEvents(system, now)],
+    ["runs", () => advanceRuns(system, now)],
+    ["reminders", () => sendReminders(system, now)],
+  ] as const) {
+    try {
+      result[name] = await job();
+    } catch (e) {
+      console.error(`[jobs] ${name}`, e);
+      result[name] = { error: "failed" };
+    }
+  }
+  return NextResponse.json(result);
+}
