+  });
+  it("explains every factor and rewards replies and resolved complaints", () => {
+    const base = Array.from({ length: 12 }, (_, i) => ({ rating: 5, published_at: day(i * 5), status: "new", response_status: "none", responded_at: null }));
+    const bad = { rating: 1, published_at: day(3), status: "new", response_status: "none", responded_at: null };
+    const ignored = healthScore([...base, bad], at);
+    const cared = healthScore([
+      ...base.map((r) => ({ ...r, response_status: "posted", responded_at: new Date(new Date(r.published_at).getTime() + 3600_000).toISOString() })),
+      { ...bad, status: "resolved", response_status: "posted", responded_at: day(2) },
