diff --git a/supabase/migrations/20261008120000_phase3_reputation_calendars_workflows.sql b/supabase/migrations/20261008120000_phase3_reputation_calendars_workflows.sql
new file mode 100644
index 0000000..73ad129
--- /dev/null
+++ b/supabase/migrations/20261008120000_phase3_reputation_calendars_workflows.sql
@@ -0,0 +1,684 @@
+-- Phase 3: reputation, calendars and workflow automation.
+--
+--   * domain_events: an outbox of business events (new contact, tag added,
+--     stage change, inbound message, appointment states, reviews, private
+--     feedback). Written only by triggers; the workflow engine consumes it
+--     with the service role.
+--   * reputation: review sources, reviews (manual entry/import now; platform
+--     sync through adapters later), review requests with a public, non-gated
+--     landing page. Negative reviews and complaints become tasks.
+--   * calendars: calendars, members (round robin), appointments. Double
+--     booking is impossible at the database level (exclusion constraint).
+--   * workflows: versioned, immutable definitions; only managers activate a
+--     version; runs and their step logs are written by the engine.
+begin;
+
+create extension if not exists btree_gist with schema extensions;
+
+-- ------------------------------------------------------------ domain events
+create table public.domain_events (
+  id bigint generated always as identity primary key,
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  type text not null check (type ~ '^[a-z_]+\.[a-z_]+$'),
+  contact_id uuid,
+  subject_id uuid,
+  payload jsonb not null default '{}'::jsonb check (jsonb_typeof(payload) = 'object'),
+  occurred_at timestamptz not null default now(),
+  processed_at timestamptz
+);
+create index domain_events_pending_idx on public.domain_events(id) where processed_at is null;
+create index domain_events_org_idx on public.domain_events(organization_id, occurred_at desc);
+
+create or replace function public.emit_event(p_org uuid, p_type text, p_contact uuid, p_subject uuid, p_payload jsonb default '{}'::jsonb)
+returns void language sql security definer set search_path = '' as $$
+  insert into public.domain_events(organization_id, type, contact_id, subject_id, payload)
+  values (p_org, p_type, p_contact, p_subject, coalesce(p_payload, '{}'::jsonb));
+$$;
+
+-- New contacts. Bulk inserts (imports of more than 25 rows in one statement)
+-- never start automations, so an import cannot trigger a messaging blast.
+create or replace function public.tg_contacts_created_events() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if (select count(*) from new_rows) > 25 then return null; end if;
+  insert into public.domain_events(organization_id, type, contact_id, subject_id, payload)
+  select n.organization_id, 'contact.created', n.id, n.id, jsonb_build_object('source', n.source, 'lifecycle_stage', n.lifecycle_stage)
+    from new_rows n where n.erased_at is null;
+  return null;
+end $$;
+create trigger contacts_created_events after insert on public.contacts
+  referencing new table as new_rows for each statement execute function public.tg_contacts_created_events();
+
+create or replace function public.tg_contacts_changed_events() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare v_tag text;
+begin
+  if new.erased_at is not null then return null; end if;
+  for v_tag in select unnest(new.tags) except select unnest(old.tags) loop
+    perform public.emit_event(new.organization_id, 'contact.tag_added', new.id, new.id, jsonb_build_object('tag', v_tag));
+  end loop;
+  if new.lifecycle_stage is distinct from old.lifecycle_stage then
+    perform public.emit_event(new.organization_id, 'contact.stage_changed', new.id, new.id,
+      jsonb_build_object('from', old.lifecycle_stage, 'to', new.lifecycle_stage));
+  end if;
+  return null;
+end $$;
+create trigger contacts_changed_events after update of tags, lifecycle_stage on public.contacts
+  for each row execute function public.tg_contacts_changed_events();
+
+create or replace function public.tg_opportunity_stage_event() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare v_name text;
+begin
+  if new.stage_id is distinct from old.stage_id then
+    select name into v_name from public.pipeline_stages where id = new.stage_id;
+    perform public.emit_event(new.organization_id, 'deal.stage_changed', new.contact_id, new.id,
+      jsonb_build_object('stage_id', new.stage_id, 'stage_name', v_name, 'status', new.status));
+  end if;
+  return null;
+end $$;
+create trigger opportunities_stage_event after update of stage_id on public.opportunities
+  for each row execute function public.tg_opportunity_stage_event();
+
+create or replace function public.tg_messages_received_event() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  perform public.emit_event(new.organization_id, 'message.received', new.contact_id, new.id, jsonb_build_object('channel', new.channel));
+  return null;
+end $$;
+create trigger messages_received_event after insert on public.messages
+  for each row when (new.direction = 'inbound') execute function public.tg_messages_received_event();
+
+-- --------------------------------------------------------------- reputation
+create table public.review_sources (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  platform text not null check (platform in ('google', 'facebook', 'yelp', 'bbb', 'trustpilot', 'other')),
+  name text not null check (length(btrim(name)) between 1 and 80),
+  -- Where customers leave a public review. Always shown on the request page.
+  review_url text not null check (length(review_url) between 12 and 500 and review_url ~ '^https://[^\s]+$'),
+  position integer not null default 0,
+  status text not null default 'active' check (status in ('active', 'disabled')),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id)
+);
+create trigger review_sources_updated before update on public.review_sources
+  for each row execute function public.tg_set_updated_at();
+
+create table public.reviews (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  source_id uuid,
+  platform text not null check (platform in ('google', 'facebook', 'yelp', 'bbb', 'trustpilot', 'other')),
+  external_id text check (length(external_id) <= 200),
+  contact_id uuid,
+  rating smallint not null check (rating between 1 and 5),
+  author_name text check (length(author_name) <= 120),
+  body text check (length(body) <= 10000),
+  published_at timestamptz not null default now(),
+  sentiment text generated always as (case when rating >= 4 then 'positive' when rating = 3 then 'neutral' else 'negative' end) stored,
+  status text not null default 'new' check (status in ('new', 'acknowledged', 'resolved')),
+  response_body text check (length(response_body) <= 4000),
+  response_status text not null default 'none' check (response_status in ('none', 'draft', 'posted')),
+  response_ai_drafted boolean not null default false,
+  responded_at timestamptz,
+  responded_by uuid,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  foreign key (source_id, organization_id) references public.review_sources(id, organization_id) on delete set null (source_id),
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete set null (contact_id),
+  check (response_status <> 'posted' or response_body is not null)
+);
+create unique index reviews_external_idx on public.reviews(organization_id, platform, external_id) where external_id is not null;
+create index reviews_org_published_idx on public.reviews(organization_id, published_at desc);
+create trigger reviews_updated before update on public.reviews
+  for each row execute function public.tg_set_updated_at();
+
+create or replace function public.tg_reviews_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if tg_op = 'INSERT' then
+    if current_user in ('authenticated', 'anon') then new.created_by := auth.uid(); end if;
+    return new;
+  end if;
+  if new.organization_id <> old.organization_id or new.rating <> old.rating or new.platform <> old.platform
+     or new.published_at <> old.published_at or new.body is distinct from old.body or new.author_name is distinct from old.author_name then
+    if current_user in ('authenticated', 'anon') then
+      raise exception 'A customer''s review cannot be edited.' using errcode = '42501';
+    end if;
+  end if;
+  if new.response_status = 'posted' and old.response_status <> 'posted' then
+    new.responded_at := now();
+    new.responded_by := auth.uid();
+  end if;
+  return new;
+end $$;
+create trigger reviews_guard before insert or update on public.reviews
+  for each row execute function public.tg_reviews_guard();
+
+-- New reviews: timeline, event for automations, and an escalation task for
+-- negative ones (complaint handling starts the moment the review lands).
+create or replace function public.tg_reviews_created() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare v_label text := coalesce(nullif(new.author_name, ''), 'a customer');
+begin
+  if new.contact_id is not null then
+    insert into public.activities(organization_id, contact_id, kind, direction, subject, body, metadata, actor_type)
+    values (new.organization_id, new.contact_id, 'review', 'inbound', left(format('Left a %s-star %s review', new.rating, initcap(new.platform)), 300),
+            left(new.body, 20000), jsonb_build_object('review_id', new.id), 'contact');
+  end if;
+  if new.rating <= 2 then
+    insert into public.tasks(organization_id, title, description, priority, due_at, contact_id)
+    values (new.organization_id, left(format('Respond to %s-star %s review from %s', new.rating, initcap(new.platform), v_label), 200),
+            left(coalesce(new.body, ''), 4000), 'high', now() + interval '24 hours', new.contact_id);
+  end if;
+  perform public.emit_event(new.organization_id, 'review.received', new.contact_id, new.id,
+    jsonb_build_object('rating', new.rating, 'platform', new.platform));
+  return null;
+end $$;
+create trigger reviews_created after insert on public.reviews
+  for each row execute function public.tg_reviews_created();
+
+create table public.review_requests (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  contact_id uuid not null,
+  channel text not null check (channel in ('sms', 'email')),
+  token text not null unique default encode(extensions.gen_random_bytes(18), 'hex'),
+  message_id uuid,
+  status text not null default 'sent' check (status in ('sent', 'opened', 'rated', 'clicked')),
+  rating smallint check (rating between 1 and 5),
+  feedback text check (length(feedback) <= 2000),
+  clicked_source_id uuid,
+  opened_at timestamptz,
+  rated_at timestamptz,
+  clicked_at timestamptz,
+  expires_at timestamptz not null default now() + interval '60 days',
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete cascade,
+  foreign key (message_id) references public.messages(id) on delete set null,
+  foreign key (clicked_source_id, organization_id) references public.review_sources(id, organization_id) on delete set null (clicked_source_id)
+);
+create index review_requests_org_idx on public.review_requests(organization_id, created_at desc);
+create index review_requests_contact_idx on public.review_requests(contact_id, created_at desc);
+
+create or replace function public.tg_review_requests_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if new.message_id is not null and not exists (
+    select 1 from public.messages m where m.id = new.message_id and m.organization_id = new.organization_id and m.contact_id = new.contact_id) then
+    raise exception 'That message does not belong to this contact.' using errcode = '23503';
+  end if;
+  if tg_op = 'INSERT' then
+    new.created_by := auth.uid();
+    new.status := 'sent'; new.rating := null; new.feedback := null; new.clicked_source_id := null;
+    new.opened_at := null; new.rated_at := null; new.clicked_at := null;
+    return new;
+  end if;
+  -- Staff may only attach the message that carried the request.
+  if (to_jsonb(new) - 'message_id') <> (to_jsonb(old) - 'message_id') or old.message_id is not null then
+    raise exception 'Review request responses come from the customer only.' using errcode = '42501';
+  end if;
+  return new;
+end $$;
+create trigger review_requests_guard before insert or update on public.review_requests
+  for each row execute function public.tg_review_requests_guard();
+
+-- The customer's side of a review request (public page, service role only).
+-- Every public review link stays available whatever the rating: the private
+-- feedback form is offered alongside them, never instead of them.
+create or replace function public.review_request_respond(
+  p_token text, p_event text, p_rating integer default null, p_feedback text default null, p_source uuid default null
+) returns jsonb
+language plpgsql security definer set search_path = '' as $$
+declare
+  r public.review_requests;
+  v_name text;
+  v_source public.review_sources;
+begin
+  select * into r from public.review_requests where token = p_token and expires_at > now() for update;
+  if not found then raise exception 'This link has expired.' using errcode = 'P0002'; end if;
+  select coalesce(nullif(btrim(concat_ws(' ', first_name, last_name)), ''), 'A customer') into v_name
+    from public.contacts where id = r.contact_id;
+
+  if p_event = 'open' then
+    update public.review_requests set opened_at = coalesce(opened_at, now()),
+      status = case when status = 'sent' then 'opened' else status end where id = r.id;
+  elsif p_event = 'rate' then
+    if p_rating is null or p_rating not between 1 and 5 then raise exception 'Choose 1 to 5 stars.' using errcode = '22023'; end if;
+    if r.rated_at is not null then return jsonb_build_object('organization_id', r.organization_id, 'status', r.status, 'already', true); end if;
+    update public.review_requests set rating = p_rating, feedback = nullif(left(btrim(coalesce(p_feedback, '')), 2000), ''),
+      rated_at = now(), opened_at = coalesce(opened_at, now()),
+      status = case when status = 'clicked' then status else 'rated' end where id = r.id;
+    insert into public.activities(organization_id, contact_id, kind, direction, subject, body, metadata, actor_type)
+    values (r.organization_id, r.contact_id, 'review', 'inbound', format('Rated their experience %s/5 (private feedback)', p_rating),
+            nullif(left(btrim(coalesce(p_feedback, '')), 2000), ''), jsonb_build_object('review_request_id', r.id), 'contact');
+    if p_rating <= 3 then
+      insert into public.tasks(organization_id, title, description, priority, due_at, contact_id)
+      values (r.organization_id, left(format('Follow up on %s-star private feedback from %s', p_rating, v_name), 200),
+              nullif(left(btrim(coalesce(p_feedback, '')), 2000), ''), case when p_rating <= 2 then 'high' else 'normal' end,
+              now() + interval '24 hours', r.contact_id);
+    end if;
+    perform public.emit_event(r.organization_id, 'review.feedback', r.contact_id, r.id, jsonb_build_object('rating', p_rating));
+  elsif p_event = 'click' then
+    select * into v_source from public.review_sources where id = p_source and organization_id = r.organization_id and status = 'active';
+    if not found then raise exception 'Unknown review site.' using errcode = 'P0002'; end if;
+    update public.review_requests set clicked_at = coalesce(clicked_at, now()), clicked_source_id = v_source.id,
+      opened_at = coalesce(opened_at, now()), status = 'clicked' where id = r.id;
+    if r.clicked_at is null then
+      insert into public.activities(organization_id, contact_id, kind, direction, subject, metadata, actor_type)
+      values (r.organization_id, r.contact_id, 'review', 'inbound', left(format('Opened the %s review page', v_source.name), 300),
+              jsonb_build_object('review_request_id', r.id, 'source_id', v_source.id), 'contact');
+    end if;
+  else
+    raise exception 'Unknown event.' using errcode = '22023';
+  end if;
+  select * into r from public.review_requests where id = r.id;
+  return jsonb_build_object('organization_id', r.organization_id, 'status', r.status, 'rating', r.rating);
+end $$;
+
+-- ---------------------------------------------------------------- calendars
+create table public.calendars (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  name text not null check (length(btrim(name)) between 1 and 80),
+  slug text not null unique check (slug ~ '^[a-z0-9][a-z0-9-]{2,62}$'),
+  description text check (length(description) <= 1000),
+  kind text not null default 'personal' check (kind in ('personal', 'round_robin', 'resource')),
+  timezone text not null default 'America/New_York',
+  duration_minutes integer not null default 30 check (duration_minutes between 5 and 480),
+  slot_interval_minutes integer not null default 30 check (slot_interval_minutes between 5 and 240),
+  buffer_before_minutes integer not null default 0 check (buffer_before_minutes between 0 and 240),
+  buffer_after_minutes integer not null default 0 check (buffer_after_minutes between 0 and 240),
+  min_notice_minutes integer not null default 120 check (min_notice_minutes between 0 and 43200),
+  max_days_ahead integer not null default 30 check (max_days_ahead between 1 and 365),
+  daily_limit integer check (daily_limit between 1 and 100),
+  -- {"mon": [["09:00","17:00"]], "tue": [...], ...} in the calendar's time zone.
+  working_hours jsonb not null default '{"mon":[["09:00","17:00"]],"tue":[["09:00","17:00"]],"wed":[["09:00","17:00"]],"thu":[["09:00","17:00"]],"fri":[["09:00","17:00"]]}'::jsonb
+    check (jsonb_typeof(working_hours) = 'object'),
+  location text check (length(location) <= 300),
+  confirmation_message text check (length(confirmation_message) <= 1000),
+  is_public boolean not null default false,
+  status text not null default 'active' check (status in ('active', 'inactive')),
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id)
+);
+create trigger calendars_updated before update on public.calendars
+  for each row execute function public.tg_set_updated_at();
+
+create table public.calendar_members (
+  calendar_id uuid not null,
+  organization_id uuid not null,
+  user_id uuid not null,
+  position integer not null default 0,
+  created_at timestamptz not null default now(),
+  primary key (calendar_id, user_id),
+  foreign key (calendar_id, organization_id) references public.calendars(id, organization_id) on delete cascade
+);
+
+create or replace function public.tg_calendar_members_check() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if not exists (
+    select 1 from public.memberships m
+     where m.user_id = new.user_id and m.status = 'active'
+       and (m.organization_id = new.organization_id
+            or m.organization_id = (select parent_id from public.organizations where id = new.organization_id))
+  ) then
+    raise exception 'Only team members can be added to a calendar.' using errcode = '23514';
+  end if;
+  return new;
+end $$;
+create trigger calendar_members_check before insert or update on public.calendar_members
+  for each row execute function public.tg_calendar_members_check();
+
+create table public.appointments (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  calendar_id uuid not null,
+  contact_id uuid not null,
+  assigned_user_id uuid,
+  -- What may not overlap: the assigned person, or the calendar itself when nobody is assigned.
+  resource_key uuid generated always as (coalesce(assigned_user_id, calendar_id)) stored,
+  starts_at timestamptz not null,
+  ends_at timestamptz not null,
+  status text not null default 'booked' check (status in ('booked', 'confirmed', 'cancelled', 'completed', 'no_show')),
+  title text check (length(title) <= 200),
+  notes text check (length(notes) <= 4000),
+  location text check (length(location) <= 300),
+  source text not null default 'staff' check (source in ('staff', 'public', 'ai', 'workflow')),
+  manage_token text not null unique default encode(extensions.gen_random_bytes(18), 'hex'),
+  cancel_reason text check (length(cancel_reason) <= 500),
+  reminder_sent_at timestamptz,
+  booked_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  foreign key (calendar_id, organization_id) references public.calendars(id, organization_id) on delete cascade,
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete cascade,
+  check (ends_at > starts_at and ends_at - starts_at <= interval '12 hours'),
+  constraint appointments_no_overlap exclude using gist (resource_key with =, tstzrange(starts_at, ends_at) with &&)
+    where (status in ('booked', 'confirmed'))
+);
+create index appointments_calendar_idx on public.appointments(calendar_id, starts_at);
+create index appointments_org_idx on public.appointments(organization_id, starts_at);
+create index appointments_contact_idx on public.appointments(contact_id, starts_at desc);
+create index appointments_reminder_idx on public.appointments(starts_at) where status in ('booked', 'confirmed') and reminder_sent_at is null;
+create trigger appointments_updated before update on public.appointments
+  for each row execute function public.tg_set_updated_at();
+
+create or replace function public.tg_appointments_guard() returns trigger
+language plpgsql set search_path = '' as $$
+declare v_api boolean := current_user in ('authenticated', 'anon');
+begin
+  if new.assigned_user_id is not null and (tg_op = 'INSERT' or new.assigned_user_id is distinct from old.assigned_user_id)
+     and not exists (select 1 from public.calendar_members cm where cm.calendar_id = new.calendar_id and cm.user_id = new.assigned_user_id) then
+    raise exception 'That person is not on this calendar.' using errcode = '23514';
+  end if;
+  if tg_op = 'INSERT' then
+    if v_api then
+      if new.status not in ('booked', 'confirmed') or new.source not in ('staff', 'ai') then
+        raise exception 'Appointments are created as booked or confirmed.' using errcode = '42501';
+      end if;
+      new.booked_by := auth.uid(); new.reminder_sent_at := null;
+    end if;
+    return new;
+  end if;
+  if new.organization_id <> old.organization_id or new.calendar_id <> old.calendar_id or new.contact_id <> old.contact_id
+     or new.manage_token <> old.manage_token or new.source <> old.source or new.booked_by is distinct from old.booked_by then
+    raise exception 'Appointment identity is immutable.' using errcode = '42501';
+  end if;
+  if (new.starts_at <> old.starts_at or new.ends_at <> old.ends_at or new.assigned_user_id is distinct from old.assigned_user_id)
+     and old.status not in ('booked', 'confirmed') then
+    raise exception 'Only upcoming appointments can be rescheduled.' using errcode = '42501';
+  end if;
+  if new.starts_at <> old.starts_at then new.reminder_sent_at := null; end if;
+  if v_api and new.reminder_sent_at is distinct from old.reminder_sent_at and new.starts_at = old.starts_at then
+    raise exception 'Reminders are recorded by the system.' using errcode = '42501';
+  end if;
+  if new.status <> old.status and not (
+       (old.status = 'booked' and new.status in ('confirmed', 'cancelled', 'completed', 'no_show'))
+    or (old.status = 'confirmed' and new.status in ('cancelled', 'completed', 'no_show'))
+    or (old.status in ('completed', 'no_show') and new.status in ('completed', 'no_show'))) then
+    raise exception 'Invalid appointment change % -> %.', old.status, new.status using errcode = '42501';
+  end if;
+  return new;
+end $$;
+create trigger appointments_guard before insert or update on public.appointments
+  for each row execute function public.tg_appointments_guard();
+
+create or replace function public.tg_appointments_timeline() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare
+  v_cal public.calendars;
+  v_when text;
+  v_subject text;
+  v_event text;
+  v_actor text := case when auth.uid() is not null then 'user' when new.source = 'public' then 'contact' else 'system' end;
+begin
+  select * into v_cal from public.calendars where id = new.calendar_id;
+  v_when := to_char(new.starts_at at time zone v_cal.timezone, 'Dy Mon DD, HH12:MI AM');
+  if tg_op = 'INSERT' then
+    v_subject := format('Appointment booked: %s, %s', v_cal.name, v_when); v_event := 'appointment.booked';
+  elsif new.status <> old.status then
+    v_subject := format('Appointment %s: %s, %s', replace(new.status, '_', '-'), v_cal.name, v_when);
+    v_event := 'appointment.' || new.status;
+  elsif new.starts_at <> old.starts_at then
+    v_subject := format('Appointment rescheduled to %s (%s)', v_when, v_cal.name); v_event := 'appointment.rescheduled';
+  else
+    return null;
+  end if;
+  insert into public.activities(organization_id, contact_id, kind, direction, subject, body, metadata, actor_type, actor_id)
+  values (new.organization_id, new.contact_id, 'meeting', 'internal', left(v_subject, 300), new.cancel_reason,
+          jsonb_build_object('appointment_id', new.id, 'status', new.status, 'starts_at', new.starts_at), v_actor, auth.uid());
+  perform public.emit_event(new.organization_id, v_event, new.contact_id, new.id,
+    jsonb_build_object('calendar_id', new.calendar_id, 'starts_at', new.starts_at, 'source', new.source));
+  return null;
+end $$;
+create trigger appointments_timeline after insert or update on public.appointments
+  for each row execute function public.tg_appointments_timeline();
+
+-- ---------------------------------------------------------------- workflows
+create table public.workflows (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  name text not null check (length(btrim(name)) between 1 and 120),
+  description text check (length(description) <= 1000),
+  status text not null default 'draft' check (status in ('draft', 'active', 'paused', 'archived')),
+  active_version_id uuid,
+  trigger_type text,
+  activated_by uuid,
+  activated_at timestamptz,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  check (status <> 'active' or active_version_id is not null)
+);
+create index workflows_match_idx on public.workflows(organization_id, trigger_type) where status = 'active';
+create trigger workflows_updated before update on public.workflows
+  for each row execute function public.tg_set_updated_at();
+
+create table public.workflow_versions (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  workflow_id uuid not null,
+  version integer not null default 0,
+  definition jsonb not null check (
+    jsonb_typeof(definition) = 'object' and jsonb_typeof(definition -> 'trigger') = 'object'
+    and jsonb_typeof(definition -> 'steps') = 'array'
+    and jsonb_array_length(definition -> 'steps') between 1 and 25
+    and length(definition::text) <= 65536),
+  notes text check (length(notes) <= 500),
+  ai_generated boolean not null default false,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  unique (workflow_id, version),
+  unique (id, workflow_id),
+  foreign key (workflow_id, organization_id) references public.workflows(id, organization_id) on delete cascade
+);
+alter table public.workflows add constraint workflows_active_version_fk
+  foreign key (active_version_id, id) references public.workflow_versions(id, workflow_id);
+
+create or replace function public.tg_workflow_versions_number() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  perform 1 from public.workflows where id = new.workflow_id for update;
+  select coalesce(max(version), 0) + 1 into new.version from public.workflow_versions where workflow_id = new.workflow_id;
+  if current_user in ('authenticated', 'anon') then new.created_by := auth.uid(); end if;
+  return new;
+end $$;
+create trigger workflow_versions_number before insert on public.workflow_versions
+  for each row execute function public.tg_workflow_versions_number();
+
+-- Activation is a human decision: it records who switched it on, and the
+-- trigger type always comes from the version actually running.
+create or replace function public.tg_workflows_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if tg_op = 'INSERT' then
+    if current_user in ('authenticated', 'anon') then new.created_by := auth.uid(); end if;
+    new.status := 'draft'; new.active_version_id := null; new.trigger_type := null;
+    new.activated_by := null; new.activated_at := null;
+    return new;
+  end if;
+  if new.organization_id <> old.organization_id or new.created_by is distinct from old.created_by then
+    raise exception 'Workflow identity is immutable.' using errcode = '42501';
+  end if;
+  if new.active_version_id is distinct from old.active_version_id or (new.status = 'active' and old.status <> 'active') then
+    if current_user in ('authenticated', 'anon') then
+      if public.org_rank(new.organization_id) < 3 then
+        raise exception 'Only a manager or above can switch on an automation.' using errcode = '42501';
+      end if;
+      new.activated_by := auth.uid();
+    end if;
+    new.activated_at := now();
+  end if;
+  new.trigger_type := (select definition -> 'trigger' ->> 'type' from public.workflow_versions where id = new.active_version_id);
+  return new;
+end $$;
+create trigger workflows_guard before insert or update on public.workflows
+  for each row execute function public.tg_workflows_guard();
+
+create table public.workflow_runs (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  workflow_id uuid not null,
+  version_id uuid not null,
+  contact_id uuid not null,
+  event_id bigint,
+  status text not null default 'running' check (status in ('running', 'waiting', 'completed', 'failed', 'cancelled')),
+  step_index integer not null default 0 check (step_index between 0 and 25),
+  next_run_at timestamptz,
+  last_error text check (length(last_error) <= 1000),
+  started_at timestamptz not null default now(),
+  finished_at timestamptz,
+  updated_at timestamptz not null default now(),
+  foreign key (workflow_id, organization_id) references public.workflows(id, organization_id) on delete cascade,
+  foreign key (version_id, workflow_id) references public.workflow_versions(id, workflow_id),
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete cascade
+);
+-- A contact is in at most one active run of the same automation.
+create unique index workflow_runs_one_active on public.workflow_runs(workflow_id, contact_id) where status in ('running', 'waiting');
+create index workflow_runs_due_idx on public.workflow_runs(next_run_at) where status in ('running', 'waiting');
+create index workflow_runs_org_idx on public.workflow_runs(organization_id, started_at desc);
+create trigger workflow_runs_updated before update on public.workflow_runs
+  for each row execute function public.tg_set_updated_at();
+
+create or replace function public.tg_workflow_runs_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  -- People can only stop a run; the engine does everything else.
+  if not (old.status in ('running', 'waiting') and new.status = 'cancelled'
+          and (to_jsonb(new) - array['status', 'finished_at', 'updated_at', 'next_run_at']) = (to_jsonb(old) - array['status', 'finished_at', 'updated_at', 'next_run_at'])) then
+    raise exception 'Runs can only be stopped.' using errcode = '42501';
+  end if;
+  new.finished_at := now(); new.next_run_at := null;
+  return new;
+end $$;
+create trigger workflow_runs_guard before update on public.workflow_runs
+  for each row execute function public.tg_workflow_runs_guard();
+
+create table public.workflow_run_logs (
+  id bigint generated always as identity primary key,
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  run_id uuid not null references public.workflow_runs(id) on delete cascade,
+  step_index integer not null,
+  action text not null,
+  status text not null check (status in ('ok', 'skipped', 'blocked', 'failed', 'waiting', 'stopped')),
+  detail text check (length(detail) <= 1000),
+  created_at timestamptz not null default now()
+);
+create index workflow_run_logs_run_idx on public.workflow_run_logs(run_id, id);
+
+-- ------------------------------------------------- AI permission: calendar
+alter table public.ai_policies drop constraint ai_policies_category_check;
+alter table public.ai_policies add constraint ai_policies_category_check check (category in
+  ('crm', 'pipeline', 'tasks', 'messaging', 'campaigns', 'workflows', 'reputation', 'billing', 'calendar'));
+insert into public.ai_policies(organization_id, category, mode)
+  select id, 'calendar', 'approve' from public.organizations on conflict do nothing;
+
+create or replace function public.seed_organization_defaults(p_org uuid) returns void
+language plpgsql security definer set search_path = '' as $$
+declare v_pipeline uuid;
+begin
+  insert into public.pipelines(organization_id, name, is_default)
+  values (p_org, 'Sales pipeline', true) returning id into v_pipeline;
+  insert into public.pipeline_stages(organization_id, pipeline_id, name, position, probability, kind) values
+    (p_org, v_pipeline, 'New lead', 1, 10, 'open'),
+    (p_org, v_pipeline, 'Contacted', 2, 20, 'open'),
+    (p_org, v_pipeline, 'Qualified', 3, 40, 'open'),
+    (p_org, v_pipeline, 'Appointment set', 4, 60, 'open'),
+    (p_org, v_pipeline, 'Proposal sent', 5, 75, 'open'),
+    (p_org, v_pipeline, 'Won', 6, 100, 'won'),
+    (p_org, v_pipeline, 'Lost', 7, 0, 'lost');
+  -- Conservative defaults: the AI may prepare CRM changes and bookings for
+  -- approval and only recommends anything that reaches customers or money.
+  insert into public.ai_policies(organization_id, category, mode) values
+    (p_org, 'crm', 'approve'), (p_org, 'pipeline', 'approve'), (p_org, 'tasks', 'approve'),
+    (p_org, 'calendar', 'approve'),
+    (p_org, 'messaging', 'recommend'), (p_org, 'campaigns', 'recommend'),
+    (p_org, 'workflows', 'recommend'), (p_org, 'reputation', 'recommend'),
+    (p_org, 'billing', 'observe');
+end $$;
+revoke execute on function public.seed_organization_defaults(uuid) from public, anon, authenticated;
+
+-- --------------------------------------------------------------------- RLS
+alter table public.domain_events enable row level security;
+alter table public.review_sources enable row level security;
+alter table public.reviews enable row level security;
+alter table public.review_requests enable row level security;
+alter table public.calendars enable row level security;
+alter table public.calendar_members enable row level security;
+alter table public.appointments enable row level security;
+alter table public.workflows enable row level security;
+alter table public.workflow_versions enable row level security;
+alter table public.workflow_runs enable row level security;
+alter table public.workflow_run_logs enable row level security;
+
+create policy domain_events_read on public.domain_events for select to authenticated using (public.org_rank(organization_id) >= 3);
+
+create policy review_sources_read on public.review_sources for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy review_sources_write on public.review_sources for all to authenticated
+  using (public.org_rank(organization_id) >= 3) with check (public.org_rank(organization_id) >= 3);
+
+create policy reviews_read on public.reviews for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy reviews_insert on public.reviews for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy reviews_update on public.reviews for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+create policy reviews_delete on public.reviews for delete to authenticated using (public.org_rank(organization_id) >= 3);
+
+create policy review_requests_read on public.review_requests for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy review_requests_insert on public.review_requests for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy review_requests_update on public.review_requests for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+
+create policy calendars_read on public.calendars for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy calendars_write on public.calendars for all to authenticated
+  using (public.org_rank(organization_id) >= 3) with check (public.org_rank(organization_id) >= 3);
+create policy calendar_members_read on public.calendar_members for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy calendar_members_write on public.calendar_members for all to authenticated
+  using (public.org_rank(organization_id) >= 3) with check (public.org_rank(organization_id) >= 3);
+
+create policy appointments_read on public.appointments for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy appointments_insert on public.appointments for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy appointments_update on public.appointments for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+
+create policy workflows_read on public.workflows for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy workflows_insert on public.workflows for insert to authenticated with check (public.org_rank(organization_id) >= 3);
+create policy workflows_update on public.workflows for update to authenticated
+  using (public.org_rank(organization_id) >= 3) with check (public.org_rank(organization_id) >= 3);
+create policy workflow_versions_read on public.workflow_versions for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy workflow_versions_insert on public.workflow_versions for insert to authenticated with check (public.org_rank(organization_id) >= 3);
+create policy workflow_runs_read on public.workflow_runs for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy workflow_runs_update on public.workflow_runs for update to authenticated
+  using (public.org_rank(organization_id) >= 3) with check (public.org_rank(organization_id) >= 3);
+create policy workflow_run_logs_read on public.workflow_run_logs for select to authenticated using (public.org_rank(organization_id) >= 1);
+
+revoke all on public.domain_events, public.review_sources, public.reviews, public.review_requests, public.calendars,
+  public.calendar_members, public.appointments, public.workflows, public.workflow_versions, public.workflow_runs,
+  public.workflow_run_logs from anon, authenticated;
+grant all on public.domain_events, public.review_sources, public.reviews, public.review_requests, public.calendars,
+  public.calendar_members, public.appointments, public.workflows, public.workflow_versions, public.workflow_runs,
+  public.workflow_run_logs to service_role;
+grant select on public.domain_events, public.workflow_run_logs to authenticated;
+grant select, insert, update, delete on public.review_sources, public.reviews, public.calendars, public.calendar_members to authenticated;
+grant select, insert, update on public.review_requests, public.appointments, public.workflows to authenticated;
+grant select, insert on public.workflow_versions to authenticated;
+grant select, update on public.workflow_runs to authenticated;
+
+revoke execute on function public.emit_event(uuid, text, uuid, uuid, jsonb),
+  public.review_request_respond(text, text, integer, text, uuid) from public, anon, authenticated;
+grant execute on function public.emit_event(uuid, text, uuid, uuid, jsonb),
+  public.review_request_respond(text, text, integer, text, uuid) to service_role;
+
+commit;
