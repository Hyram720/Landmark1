index 0000000..bc1071f
--- /dev/null
+++ b/src/lib/workflows/definition.ts
@@ -0,0 +1,176 @@
+import { z } from "zod";
+
+// Workflow definitions: a trigger (a business event plus optional filters)
+// and an ordered list of steps. Stored as immutable versions; validated here
+// on save and again before every run.
+
+export const TRIGGERS = {
+  "contact.created": { label: "New contact added", filters: ["source"] },
+  "contact.tag_added": { label: "Tag added to a contact", filters: ["tag"] },
+  "contact.stage_changed": { label: "Lifecycle stage changed", filters: ["lifecycle_stage"] },
+  "deal.stage_changed": { label: "Deal moved to a stage", filters: ["stage_name"] },
+  "message.received": { label: "Customer sent a message", filters: ["channel"] },
+  "appointment.booked": { label: "Appointment booked", filters: [] },
+  "appointment.cancelled": { label: "Appointment cancelled", filters: [] },
+  "appointment.completed": { label: "Appointment completed", filters: [] },
+  "appointment.no_show": { label: "Appointment no-show", filters: [] },
+  "review.received": { label: "New review received", filters: ["rating_max", "rating_min"] },
+  "review.feedback": { label: "Private feedback received", filters: ["rating_max", "rating_min"] },
+} as const;
+export type TriggerType = keyof typeof TRIGGERS;
+export const TRIGGER_TYPES = Object.keys(TRIGGERS) as TriggerType[];
+
+const text = (max: number) => z.string().trim().min(1).max(max);
+const purpose = z.enum(["marketing", "transactional"]).default("marketing");
+
+export const triggerSchema = z.object({
+  type: z.enum(TRIGGER_TYPES as [TriggerType, ...TriggerType[]]),
+  filters: z.object({
+    tag: text(40).optional(),
+    source: text(100).optional(),
+    lifecycle_stage: z.enum(["lead", "prospect", "customer", "churned", "other"]).optional(),
+    stage_name: text(60).optional(),
+    channel: z.enum(["sms", "email"]).optional(),
+    rating_max: z.number().int().min(1).max(5).optional(),
+    rating_min: z.number().int().min(1).max(5).optional(),
+  }).strict().default({}),
+}).strict();
+
+export const conditionSchema = z.discriminatedUnion("kind", [
+  z.object({ kind: z.literal("replied") }).strict(),
+  z.object({ kind: z.literal("appointment_booked") }).strict(),
+  z.object({ kind: z.literal("has_tag"), tag: text(40) }).strict(),
+  z.object({ kind: z.literal("lifecycle_is"), stage: z.enum(["lead", "prospect", "customer", "churned", "other"]) }).strict(),
+]);
+
+export const stepSchema = z.discriminatedUnion("type", [
+  z.object({ type: z.literal("wait"), minutes: z.number().int().min(1).max(60 * 24 * 90) }).strict(),
+  z.object({ type: z.literal("send_sms"), body: text(1000), purpose }).strict(),
+  z.object({ type: z.literal("send_email"), subject: text(200), body: text(10000), purpose }).strict(),
+  z.object({ type: z.literal("create_task"), title: text(200), due_in_minutes: z.number().int().min(0).max(60 * 24 * 90).optional(), priority: z.enum(["low", "normal", "high"]).default("normal") }).strict(),
+  z.object({ type: z.literal("add_tag"), tag: text(40) }).strict(),
+  z.object({ type: z.literal("remove_tag"), tag: text(40) }).strict(),
+  z.object({ type: z.literal("set_lifecycle"), stage: z.enum(["lead", "prospect", "customer", "churned", "other"]) }).strict(),
+  z.object({ type: z.literal("add_note"), body: text(2000) }).strict(),
+  z.object({ type: z.literal("request_review"), channel: z.enum(["sms", "email"]) }).strict(),
+  z.object({ type: z.literal("stop_if"), condition: conditionSchema }).strict(),
+  z.object({ type: z.literal("webhook"), url: z.string().trim().url().max(500).refine((u) => u.startsWith("https://"), "Webhook URLs must use https://") }).strict(),
+]);
+
+export const definitionSchema = z.object({
+  trigger: triggerSchema,
+  steps: z.array(stepSchema).min(1, "Add at least one step.").max(25, "Use 25 steps or fewer."),
+}).strict();
+
+export type Definition = z.infer<typeof definitionSchema>;
+export type Step = z.infer<typeof stepSchema>;
+export type Condition = z.infer<typeof conditionSchema>;
+
+export const STEP_LABELS: Record<Step["type"], string> = {
+  wait: "Wait",
+  send_sms: "Send text",
+  send_email: "Send email",
+  create_task: "Create task",
+  add_tag: "Add tag",
+  remove_tag: "Remove tag",
+  set_lifecycle: "Set lifecycle stage",
+  add_note: "Add note",
+  request_review: "Request a review",
+  stop_if: "Stop if",
+  webhook: "Call webhook",
+};
+
+export function describeStep(s: Step): string {
+  switch (s.type) {
+    case "wait": return s.minutes % 1440 === 0 ? `Wait ${s.minutes / 1440} day(s)` : s.minutes % 60 === 0 ? `Wait ${s.minutes / 60} hour(s)` : `Wait ${s.minutes} minute(s)`;
+    case "send_sms": return `Text: "${s.body.slice(0, 80)}${s.body.length > 80 ? "…" : ""}"`;
+    case "send_email": return `Email: "${s.subject}"`;
+    case "create_task": return `Task: ${s.title}`;
+    case "add_tag": return `Add tag "${s.tag}"`;
+    case "remove_tag": return `Remove tag "${s.tag}"`;
+    case "set_lifecycle": return `Set stage to ${s.stage}`;
+    case "add_note": return `Note: ${s.body.slice(0, 80)}`;
+    case "request_review": return `Request a review by ${s.channel === "sms" ? "text" : "email"}`;
+    case "stop_if": return `Stop if ${s.condition.kind === "replied" ? "they replied" : s.condition.kind === "appointment_booked" ? "they booked an appointment" : s.condition.kind === "has_tag" ? `tagged "${s.condition.tag}"` : `stage is ${s.condition.stage}`}`;
+    case "webhook": return `POST to ${new URL(s.url).host}`;
+  }
+}
+
+// Does a domain event satisfy a trigger?
+export type EventRow = { type: string; payload: Record<string, unknown>; contact_id: string | null };
+export function matches(trigger: Definition["trigger"], event: EventRow): boolean {
+  if (trigger.type !== event.type) return false;
+  const f = trigger.filters || {};
+  const p = event.payload || {};
+  const eq = (a: unknown, b: string) => String(a ?? "").toLowerCase() === b.toLowerCase();
+  if (f.tag && !eq(p.tag, f.tag)) return false;
+  if (f.source && !eq(p.source, f.source)) return false;
+  if (f.lifecycle_stage && !eq(p.to ?? p.lifecycle_stage, f.lifecycle_stage)) return false;
+  if (f.stage_name && !eq(p.stage_name, f.stage_name)) return false;
+  if (f.channel && !eq(p.channel, f.channel)) return false;
+  const rating = Number(p.rating);
+  if (f.rating_max && !(rating <= f.rating_max)) return false;
+  if (f.rating_min && !(rating >= f.rating_min)) return false;
+  return true;
+}
+
+// {{first_name}}, {{last_name}}, {{business_name}}, {{booking_link}}
+export function render(template: string, vars: Record<string, string | null | undefined>) {
+  return template.replace(/\{\{\s*([a-z_]+)\s*\}\}/g, (_, k: string) => vars[k] ?? "").replace(/[ \t]{2,}/g, " ").trim();
+}
+
+export const TEMPLATES: { key: string; name: string; description: string; definition: Definition }[] = [
+  {
+    key: "speed_to_lead",
+    name: "New lead follow-up",
+    description: "Text a new lead right away, nudge once if they don't reply, then hand off to a person.",
+    definition: {
+      trigger: { type: "contact.created", filters: {} },
+      steps: [
+        { type: "send_sms", purpose: "marketing", body: "Hi {{first_name}}, thanks for reaching out to {{business_name}}! Want to pick a time to talk? {{booking_link}}" },
+        { type: "wait", minutes: 1440 },
+        { type: "stop_if", condition: { kind: "replied" } },
+        { type: "stop_if", condition: { kind: "appointment_booked" } },
+        { type: "send_sms", purpose: "marketing", body: "Hi {{first_name}}, just checking in. Happy to answer any questions. {{booking_link}}" },
+        { type: "wait", minutes: 2880 },
+        { type: "stop_if", condition: { kind: "replied" } },
+        { type: "create_task", title: "Call new lead who hasn't replied", priority: "normal", due_in_minutes: 60 },
+      ],
+    },
+  },
+  {
+    key: "no_show",
+    name: "No-show recovery",
+    description: "When someone misses an appointment, offer to rebook and create a call-back task.",
+    definition: {
+      trigger: { type: "appointment.no_show", filters: {} },
+      steps: [
+        { type: "send_sms", purpose: "transactional", body: "Hi {{first_name}}, we missed you today. Want to pick a new time? {{booking_link}}" },
+        { type: "wait", minutes: 1440 },
+        { type: "stop_if", condition: { kind: "appointment_booked" } },
+        { type: "create_task", title: "Call to rebook a missed appointment", priority: "high", due_in_minutes: 0 },
+      ],
+    },
+  },
+  {
+    key: "review_after_visit",
+    name: "Review request after a visit",
+    description: "Two hours after an appointment is marked complete, ask how it went.",
+    definition: {
+      trigger: { type: "appointment.completed", filters: {} },
+      steps: [{ type: "wait", minutes: 120 }, { type: "request_review", channel: "sms" }],
+    },
+  },
+  {
+    key: "complaint_escalation",
+    name: "Unhappy customer escalation",
+    description: "When private feedback is 1-2 stars, tag the customer and add a note for the manager.",
+    definition: {
+      trigger: { type: "review.feedback", filters: { rating_max: 2 } },
+      steps: [
+        { type: "add_tag", tag: "at-risk" },
+        { type: "add_note", body: "Unhappy feedback received. A follow-up task was created automatically; call within 24 hours." },
+      ],
+    },
+  },
+];
diff --git a/src/lib/workflows/drafter.ts b/src/lib/workflows/drafter.ts
new file mode 100644
index 0000000..886cc37
--- /dev/null
+++ b/src/lib/workflows/drafter.ts
@@ -0,0 +1,42 @@
+import "server-only";
+import { z } from "zod";
+import { ApiError } from "@/lib/tenant/api";
+import { getChatModel } from "@/lib/ai/provider";
+import { definitionSchema, TRIGGERS, type Definition } from "./definition";
+
+// "Describe it in English": the model proposes an automation; nothing is
+// saved. The person reviews it in the editor, saves it as a draft and a
+// manager switches it on.
+const proposal = z.object({ name: z.string().min(1).max(120), description: z.string().max(1000).optional(), definition: definitionSchema });
+
+export async function draftFromDescription(description: string, orgName: string): Promise<z.infer<typeof proposal> & { model: string }> {
+  const { model, status } = await getChatModel();
+  if (!model) throw new ApiError(status.configured ? "AI is unavailable." : status.reason, 503, "integration_not_configured");
+  const parameters = z.toJSONSchema(proposal, { io: "input", unrepresentable: "any" }) as Record<string, unknown>;
+  delete parameters.$schema;
+  const system = [
+    `You design marketing and operations automations for "${orgName}", a local business.`,
+    "Call propose_workflow exactly once. Use only the triggers and step types in the schema.",
+    `Triggers: ${Object.entries(TRIGGERS).map(([k, v]) => `${k} (${v.label})`).join("; ")}.`,
+    "Wait minutes: 60 = 1 hour, 1440 = 1 day. Message bodies may use {{first_name}}, {{business_name}} and {{booking_link}}.",
+    "Text messages must be short, friendly and honest. Promotions use purpose 'marketing' (requires consent); appointment, order or service updates use 'transactional'.",
+    "Add stop_if steps (replied, appointment_booked) before follow-ups so people who already responded are not chased.",
+    "Never design cold outreach to people who have not engaged with the business, and never more than one text per day.",
+  ].join("\n");
+  let lastError = "";
+  const messages: Parameters<typeof model.complete>[0]["messages"] = [{ role: "system", content: system }, { role: "user", content: description.slice(0, 2000) }];
+  for (let attempt = 0; attempt < 2; attempt++) {
+    const completion = await model.complete({ messages, tools: [{ name: "propose_workflow", description: "Propose an automation for review.", parameters }] });
+    const call = completion.toolCalls.find((c) => c.name === "propose_workflow");
+    if (!call) throw new ApiError("The AI did not propose an automation. Try describing it differently.", 422, "invalid");
+    let raw: unknown;
+    try { raw = JSON.parse(call.arguments); } catch { raw = null; }
+    const parsed = proposal.safeParse(raw);
+    if (parsed.success) return { ...parsed.data, model: model.model };
+    lastError = parsed.error.issues.slice(0, 3).map((i) => `${i.path.join(".")}: ${i.message}`).join("; ");
+    messages.push({ role: "assistant", content: null, toolCalls: [call] }, { role: "tool", toolCallId: call.id, content: `Invalid: ${lastError}. Fix and call propose_workflow again.` });
+  }
+  throw new ApiError(`The AI's draft was not valid (${lastError}). Try again or build it by hand.`, 422, "invalid");
+}
+
+export type { Definition };
diff --git a/src/lib/workflows/engine.ts b/src/lib/workflows/engine.ts
new file mode 100644
index 0000000..7396181
--- /dev/null
+++ b/src/lib/workflows/engine.ts
@@ -0,0 +1,290 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { sendMessage } from "@/lib/comms/service";
+import { sendReviewRequest } from "@/lib/reputation/service";
+import { BlockedAddressError, publicFetch } from "@/lib/net/public-network";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { definitionSchema, matches, render, type Condition, type Definition, type EventRow, type Step } from "./definition";
+import { signWebhook, webhookSecret } from "./webhook";
+
+// The workflow engine. Runs with the service role from the scheduler, so
+// every query is explicitly scoped to the run's organization. Messages go
+// through the same compliance gate as everything else.
+//
+//   enrollFromEvents: domain events -> new runs (one active run per contact
+//                     per automation; at most 3 enrollments a day, which also
+//                     stops automations from feeding each other forever)
+//   advanceRuns:      executes due runs step by step until a wait or the end
+
+export type Deps = {
+  send: typeof sendMessage;
+  requestReview: typeof sendReviewRequest;
+  fetch: (url: string, init: { method: string; headers: Record<string, string>; body: string; signal?: AbortSignal }) => Promise<Response>;
+};
+const defaultDeps: Deps = { send: sendMessage, requestReview: sendReviewRequest, fetch: publicFetch };
+
+const LEASE_MS = 10 * 60_000;
+const MAX_DAILY_ENROLLMENTS = 3;
+
+type WorkflowRow = { id: string; organization_id: string; status: string; trigger_type: string | null; active_version_id: string | null };
+
+export async function enrollFromEvents(system: SupabaseClient, now = new Date(), limit = 200) {
+  const { data: pending, error } = await system.from("domain_events").select("id").is("processed_at", null).order("id").limit(limit);
+  fromDb(error);
+  const ids = (pending || []).map((e) => e.id);
+  if (!ids.length) return { events: 0, enrolled: 0 };
+  const { data: claimed, error: claimError } = await system.from("domain_events").update({ processed_at: now.toISOString() })
+    .in("id", ids).is("processed_at", null).select("id, organization_id, type, contact_id, payload");
+  fromDb(claimError);
+  const events = (claimed || []) as (EventRow & { id: number; organization_id: string })[];
+  let enrolled = 0;
+  const byOrg = new Map<string, typeof events>();
+  for (const e of events) byOrg.set(e.organization_id, [...(byOrg.get(e.organization_id) || []), e]);
+
+  for (const [orgId, orgEvents] of byOrg) {
+    const types = [...new Set(orgEvents.map((e) => e.type))];
+    const { data: flows, error: flowError } = await system.from("workflows").select("id, organization_id, status, trigger_type, active_version_id")
+      .eq("organization_id", orgId).eq("status", "active").in("trigger_type", types);
+    fromDb(flowError);
+    if (!flows?.length) continue;
+    const versionIds = (flows as WorkflowRow[]).map((f) => f.active_version_id!).filter(Boolean);
+    const { data: versions, error: vError } = await system.from("workflow_versions").select("id, definition").eq("organization_id", orgId).in("id", versionIds);
+    fromDb(vError);
+    const defs = new Map<string, Definition>();
+    for (const v of versions || []) {
+      const parsed = definitionSchema.safeParse(v.definition);
+      if (parsed.success) defs.set(v.id, parsed.data);
+    }
+    for (const event of orgEvents) {
+      if (!event.contact_id) continue;
+      for (const flow of flows as WorkflowRow[]) {
+        const def = flow.active_version_id ? defs.get(flow.active_version_id) : undefined;
+        if (!def || !matches(def.trigger, event)) continue;
+        const { count, error: countError } = await system.from("workflow_runs").select("id", { count: "exact", head: true })
+          .eq("organization_id", orgId).eq("workflow_id", flow.id).eq("contact_id", event.contact_id)
+          .gte("started_at", new Date(now.getTime() - 86_400_000).toISOString());
+        fromDb(countError);
+        if ((count ?? 0) >= MAX_DAILY_ENROLLMENTS) continue;
+        const { error: runError } = await system.from("workflow_runs").insert({
+          organization_id: orgId, workflow_id: flow.id, version_id: flow.active_version_id, contact_id: event.contact_id,
+          event_id: event.id, status: "running", step_index: 0, next_run_at: now.toISOString(),
+        });
+        if (runError?.code === "23505") continue; // already in an active run
+        fromDb(runError);
+        enrolled++;
+      }
+    }
+  }
+  return { events: events.length, enrolled };
+}
+
+type Run = { id: string; organization_id: string; workflow_id: string; version_id: string; contact_id: string; status: string; step_index: number; next_run_at: string; started_at: string };
+type Contact = { id: string; first_name: string | null; last_name: string | null; email: string | null; phone: string | null; tags: string[]; lifecycle_stage: string; owner_id: string | null; erased_at: string | null };
+type StepResult = { status: "ok" | "skipped" | "blocked" | "failed" | "stopped" | "waiting"; detail: string; resumeAt?: Date; retry?: boolean };
+
+export async function advanceRuns(system: SupabaseClient, now = new Date(), limit = 50, deps: Deps = defaultDeps) {
+  const { data, error } = await system.from("workflow_runs").select("id, organization_id, workflow_id, version_id, contact_id, status, step_index, next_run_at, started_at")
+    .in("status", ["running", "waiting"]).lte("next_run_at", now.toISOString()).order("next_run_at").limit(limit);
+  fromDb(error);
+  const summary = { advanced: 0, completed: 0, failed: 0, waiting: 0 };
+  for (const row of (data || []) as Run[]) {
+    // Lease the run so a second scheduler instance skips it; a crash resumes after the lease.
+    const { data: leased } = await system.from("workflow_runs").update({ status: "running", next_run_at: new Date(now.getTime() + LEASE_MS).toISOString() })
+      .eq("id", row.id).eq("organization_id", row.organization_id).eq("status", row.status).eq("next_run_at", row.next_run_at).select("id").maybeSingle();
+    if (!leased) continue;
+    summary.advanced++;
+    try {
+      const outcome = await executeRun(system, row, now, deps);
+      summary[outcome]++;
+    } catch (e) {
+      console.error("[workflows] run", row.id, e);
+      await finish(system, row, "failed", e instanceof ApiError ? e.message : "Unexpected error while running this automation.");
+      summary.failed++;
+    }
+  }
+  return summary;
+}
+
+async function log(system: SupabaseClient, run: Run, index: number, action: string, r: StepResult) {
+  await system.from("workflow_run_logs").insert({ organization_id: run.organization_id, run_id: run.id, step_index: index, action, status: r.status, detail: r.detail.slice(0, 1000) });
+}
+
+async function finish(system: SupabaseClient, run: Run, status: "completed" | "failed" | "cancelled", error?: string, stepIndex?: number) {
+  await system.from("workflow_runs").update({
+    status, finished_at: new Date().toISOString(), next_run_at: null, last_error: error?.slice(0, 1000) ?? null, ...(stepIndex !== undefined ? { step_index: stepIndex } : {}),
+  }).eq("id", run.id).eq("organization_id", run.organization_id);
+}
+
+async function executeRun(system: SupabaseClient, run: Run, now: Date, deps: Deps): Promise<"completed" | "failed" | "waiting"> {
+  const [flow, version, contact, org, calendar] = await Promise.all([
+    system.from("workflows").select("status").eq("organization_id", run.organization_id).eq("id", run.workflow_id).maybeSingle(),
+    system.from("workflow_versions").select("definition").eq("organization_id", run.organization_id).eq("id", run.version_id).maybeSingle(),
+    system.from("contacts").select("id, first_name, last_name, email, phone, tags, lifecycle_stage, owner_id, erased_at").eq("organization_id", run.organization_id).eq("id", run.contact_id).maybeSingle(),
+    system.from("organizations").select("name, status").eq("id", run.organization_id).maybeSingle(),
+    system.from("calendars").select("slug").eq("organization_id", run.organization_id).eq("is_public", true).eq("status", "active").order("created_at").limit(1).maybeSingle(),
+  ]);
+  if (flow.data?.status === "paused" || org.data?.status === "suspended") {
+    await system.from("workflow_runs").update({ status: "waiting", next_run_at: new Date(now.getTime() + 3600_000).toISOString() }).eq("id", run.id).eq("organization_id", run.organization_id);
+    return "waiting";
+  }
+  if (!flow.data || flow.data.status === "archived" || !org.data || org.data.status === "closed") {
+    await finish(system, run, "cancelled", "The automation was archived.");
+    return "completed";
+  }
+  if (!contact.data || contact.data.erased_at) {
+    await finish(system, run, "cancelled", "The contact no longer exists.");
+    return "completed";
+  }
+  const parsed = definitionSchema.safeParse(version.data?.definition);
+  if (!parsed.success) {
+    await finish(system, run, "failed", "This version of the automation is not valid. Edit and re-activate it.");
+    return "failed";
+  }
+  const steps = parsed.data.steps;
+  const base = publicBaseUrl();
+  const vars = {
+    first_name: contact.data.first_name || "there",
+    last_name: contact.data.last_name,
+    business_name: org.data.name,
+    booking_link: calendar.data && base ? `${base}/book/${calendar.data.slug}` : "",
+  };
+  const c: Contact = contact.data as Contact;
+
+  for (let i = run.step_index; i < steps.length; i++) {
+    const step = steps[i];
+    let result: StepResult;
+    try {
+      result = await runStep(system, run, c, step, i, vars, now, deps);
+    } catch (e) {
+      result = { status: "failed", detail: e instanceof ApiError ? e.message : "Step failed unexpectedly." };
+      if (!(e instanceof ApiError)) console.error("[workflows] step", run.id, i, e);
+    }
+    await log(system, run, i, step.type, result);
+    if (result.status === "stopped") {
+      await finish(system, run, "completed", undefined, i + 1);
+      return "completed";
+    }
+    if (result.status === "waiting" && result.resumeAt) {
+      await system.from("workflow_runs").update({ status: "waiting", step_index: result.retry ? i : i + 1, next_run_at: result.resumeAt.toISOString() })
+        .eq("id", run.id).eq("organization_id", run.organization_id);
+      return "waiting";
+    }
+    // Blocked or failed steps are logged and the automation continues: a
+    // customer who cannot be texted can still get a task or an email.
+    if (step.type === "add_tag" || step.type === "remove_tag" || step.type === "set_lifecycle") {
+      const { data } = await system.from("contacts").select("tags, lifecycle_stage").eq("organization_id", run.organization_id).eq("id", c.id).maybeSingle();
+      if (data) Object.assign(c, data);
+    }
+  }
+  await finish(system, run, "completed", undefined, steps.length);
+  return "completed";
+}
+
+async function conditionMet(system: SupabaseClient, run: Run, c: Contact, cond: Condition) {
+  switch (cond.kind) {
+    case "has_tag":
+      return c.tags.map((t) => t.toLowerCase()).includes(cond.tag.toLowerCase());
+    case "lifecycle_is":
+      return c.lifecycle_stage === cond.stage;
+    case "replied": {
+      const { data, error } = await system.from("messages").select("id").eq("organization_id", run.organization_id).eq("contact_id", c.id)
+        .eq("direction", "inbound").gte("created_at", run.started_at).limit(1).maybeSingle();
+      fromDb(error);
+      return !!data;
+    }
+    case "appointment_booked": {
+      const { data, error } = await system.from("appointments").select("id").eq("organization_id", run.organization_id).eq("contact_id", c.id)
+        .in("status", ["booked", "confirmed", "completed"]).gte("created_at", run.started_at).limit(1).maybeSingle();
+      fromDb(error);
+      return !!data;
+    }
+  }
+}
+
+async function runStep(system: SupabaseClient, run: Run, c: Contact, step: Step, index: number, vars: Record<string, string | null>, now: Date, deps: Deps): Promise<StepResult> {
+  const ctx = { client: system, orgId: run.organization_id, userId: null };
+  switch (step.type) {
+    case "wait":
+      return { status: "waiting", detail: `Waiting ${step.minutes} minute(s).`, resumeAt: new Date(now.getTime() + step.minutes * 60_000) };
+    case "send_sms":
+    case "send_email": {
+      const channel = step.type === "send_sms" ? "sms" : "email";
+      const r = await deps.send(ctx, {
+        contact_id: c.id, channel, purpose: step.purpose, body: render(step.body, vars),
+        subject: step.type === "send_email" ? render(step.subject, vars) : undefined,
+        // One message per step attempt, even if two workers race on the same run.
+        idempotency_key: `wf-${run.id}-${index}-${new Date(run.next_run_at).getTime()}`.slice(0, 100),
+      }, { system: true });
+      if (r.outcome === "blocked") {
+        if (r.code === "quiet_hours" && r.retryAt) return { status: "waiting", detail: `${r.reason} Will retry.`, resumeAt: new Date(r.retryAt), retry: true };
+        return { status: "blocked", detail: r.reason };
+      }
+      if (r.outcome === "failed") return { status: "failed", detail: r.message.error || "The provider refused the message." };
+      if (r.outcome === "duplicate") return { status: "skipped", detail: "Already sent for this step." };
+      return { status: "ok", detail: `${channel === "sms" ? "Text" : "Email"} sent to ${r.message.to_address}.` };
+    }
+    case "create_task": {
+      const { error } = await system.from("tasks").insert({
+        organization_id: run.organization_id, title: render(step.title, vars).slice(0, 200), priority: step.priority, contact_id: c.id, assignee_id: c.owner_id,
+        due_at: step.due_in_minutes !== undefined ? new Date(now.getTime() + step.due_in_minutes * 60_000).toISOString() : null,
+        description: "Created by an automation.",
+      });
+      fromDb(error);
+      return { status: "ok", detail: `Task created: ${step.title}` };
+    }
+    case "add_tag":
+    case "remove_tag": {
+      const has = c.tags.some((t) => t.toLowerCase() === step.tag.toLowerCase());
+      if ((step.type === "add_tag") === has) return { status: "skipped", detail: `Tag "${step.tag}" ${has ? "already present" : "not present"}.` };
+      const tags = step.type === "add_tag" ? [...c.tags, step.tag].slice(0, 20) : c.tags.filter((t) => t.toLowerCase() !== step.tag.toLowerCase());
+      const { error } = await system.from("contacts").update({ tags }).eq("organization_id", run.organization_id).eq("id", c.id);
+      fromDb(error);
+      return { status: "ok", detail: `${step.type === "add_tag" ? "Added" : "Removed"} tag "${step.tag}".` };
+    }
+    case "set_lifecycle": {
+      if (c.lifecycle_stage === step.stage) return { status: "skipped", detail: `Already ${step.stage}.` };
+      const { error } = await system.from("contacts").update({ lifecycle_stage: step.stage }).eq("organization_id", run.organization_id).eq("id", c.id);
+      fromDb(error);
+      return { status: "ok", detail: `Stage set to ${step.stage}.` };
+    }
+    case "add_note": {
+      const { error } = await system.from("activities").insert({
+        organization_id: run.organization_id, contact_id: c.id, kind: "note", direction: "internal", subject: "Automation note",
+        body: render(step.body, vars), actor_type: "system", metadata: { workflow_run_id: run.id },
+      });
+      fromDb(error);
+      return { status: "ok", detail: "Note added." };
+    }
+    case "request_review": {
+      const r = await deps.requestReview(ctx, { contact_id: c.id, channel: step.channel }, { system: true, now });
+      if (r.outcome === "sent") return { status: "ok", detail: "Review request sent." };
+      return { status: r.outcome === "skipped" ? "skipped" : r.outcome === "blocked" ? "blocked" : "failed", detail: r.reason };
+    }
+    case "stop_if": {
+      const met = await conditionMet(system, run, c, step.condition);
+      return met ? { status: "stopped", detail: "Condition met; automation finished." } : { status: "ok", detail: "Condition not met; continuing." };
+    }
+    case "webhook": {
+      const secret = webhookSecret(run.organization_id);
+      if (!secret) return { status: "failed", detail: "Integration not configured: the server's APP_ENCRYPTION_KEY is not set." };
+      const body = JSON.stringify({
+        type: "workflow.step", workflow_id: run.workflow_id, run_id: run.id, occurred_at: now.toISOString(),
+        contact: { id: c.id, first_name: c.first_name, last_name: c.last_name, email: c.email, phone: c.phone, tags: c.tags, lifecycle_stage: c.lifecycle_stage },
+      });
+      const controller = new AbortController();
+      const timer = setTimeout(() => controller.abort(), 10_000);
+      try {
+        const res = await deps.fetch(step.url, {
+          method: "POST", body, signal: controller.signal,
+          headers: { "Content-Type": "application/json", "User-Agent": "SunMarketing-Workflows/1", "X-Sun-Signature": signWebhook(secret, body, now) },
+        });
+        return res.status >= 200 && res.status < 300 ? { status: "ok", detail: `Webhook answered ${res.status}.` } : { status: "failed", detail: `Webhook answered ${res.status}.` };
+      } catch (e) {
+        return { status: "failed", detail: e instanceof BlockedAddressError ? "Webhook address is not a public internet address." : "Webhook could not be reached." };
+      } finally {
+        clearTimeout(timer);
+      }
+    }
+  }
+}
diff --git a/src/lib/workflows/service.ts b/src/lib/workflows/service.ts
new file mode 100644
index 0000000..827225a
--- /dev/null
+++ b/src/lib/workflows/service.ts
@@ -0,0 +1,112 @@
+import "server-only";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import type { CrmContext } from "@/lib/crm/service";
+import { definitionSchema, type Definition } from "./definition";
+
+// Managing automations as the signed-in user (RLS: managers and above write).
+export const WORKFLOW_COLUMNS = "id, organization_id, name, description, status, active_version_id, trigger_type, activated_by, activated_at, created_at, updated_at";
+
+export const workflowInput = z.object({
+  name: z.string().trim().min(1, "Name the automation.").max(120),
+  description: z.string().trim().max(1000).optional(),
+  definition: definitionSchema,
+  notes: z.string().trim().max(500).optional(),
+});
+
+export function parseDefinition(value: unknown): Definition {
+  const r = definitionSchema.safeParse(value);
+  if (!r.success) {
+    const issue = r.error.issues[0];
+    throw new ApiError(`${issue?.path?.length ? `${issue.path.join(".")}: ` : ""}${issue?.message || "Invalid automation."}`, 422, "invalid");
+  }
+  return r.data;
+}
+
+export async function listWorkflows(ctx: CrmContext) {
+  const [flows, runs] = await Promise.all([
+    ctx.client.from("workflows").select(WORKFLOW_COLUMNS).eq("organization_id", ctx.orgId).neq("status", "archived").order("created_at", { ascending: false }),
+    ctx.client.from("workflow_runs").select("workflow_id, status").eq("organization_id", ctx.orgId)
+      .gte("started_at", new Date(Date.now() - 30 * 86_400_000).toISOString()).limit(5000),
+  ]);
+  fromDb(flows.error);
+  fromDb(runs.error);
+  return (flows.data || []).map((f) => {
+    const mine = (runs.data || []).filter((r) => r.workflow_id === f.id);
+    return { ...f, runs30: mine.length, active_runs: mine.filter((r) => r.status === "running" || r.status === "waiting").length, failed30: mine.filter((r) => r.status === "failed").length };
+  });
+}
+
+export async function getWorkflow(ctx: CrmContext, id: string) {
+  const [flow, versions, runs] = await Promise.all([
+    ctx.client.from("workflows").select(WORKFLOW_COLUMNS).eq("organization_id", ctx.orgId).eq("id", id).maybeSingle(),
+    ctx.client.from("workflow_versions").select("id, version, definition, notes, ai_generated, created_by, created_at").eq("organization_id", ctx.orgId).eq("workflow_id", id).order("version", { ascending: false }).limit(50),
+    ctx.client.from("workflow_runs").select("id, contact_id, status, step_index, next_run_at, last_error, started_at, finished_at, version_id, contacts(first_name, last_name)")
+      .eq("organization_id", ctx.orgId).eq("workflow_id", id).order("started_at", { ascending: false }).limit(50),
+  ]);
+  for (const r of [flow, versions, runs]) fromDb(r.error);
+  if (!flow.data) throw new ApiError("Automation not found.", 404, "not_found");
+  return { workflow: flow.data, versions: versions.data || [], runs: runs.data || [] };
+}
+
+export async function runLog(ctx: CrmContext, runId: string) {
+  const { data, error } = await ctx.client.from("workflow_run_logs").select("step_index, action, status, detail, created_at")
+    .eq("organization_id", ctx.orgId).eq("run_id", runId).order("id").limit(200);
+  fromDb(error);
+  return data || [];
+}
+
+export async function createWorkflow(ctx: CrmContext, input: z.infer<typeof workflowInput>, opts: { aiGenerated?: boolean } = {}) {
+  const { data: flow, error } = await ctx.client.from("workflows").insert({ organization_id: ctx.orgId, name: input.name, description: input.description || null })
+    .select(WORKFLOW_COLUMNS).single();
+  fromDb(error);
+  const version = await saveVersion(ctx, flow!.id, input.definition, input.notes, opts);
+  await audit(ctx.client, ctx.orgId, "workflow.created", { type: "workflow", id: flow!.id }, { name: input.name, ai_generated: !!opts.aiGenerated }, opts.aiGenerated ? "ai" : "user");
+  return { workflow: flow, version };
+}
+
+export async function saveVersion(ctx: CrmContext, workflowId: string, definition: Definition, notes?: string, opts: { aiGenerated?: boolean } = {}) {
+  const { data, error } = await ctx.client.from("workflow_versions").insert({
+    organization_id: ctx.orgId, workflow_id: workflowId, definition: parseDefinition(definition), notes: notes || null, ai_generated: !!opts.aiGenerated,
+  }).select("id, version, created_at").single();
+  fromDb(error);
+  return data!;
+}
+
+// Switching an automation on is always a person's decision (manager+), and
+// always names the exact version that will run.
+export async function setStatus(ctx: CrmContext, id: string, status: "active" | "paused" | "archived", versionId?: string) {
+  const patch: Record<string, unknown> = { status };
+  if (status === "active") {
+    let vid = versionId;
+    if (!vid) {
+      const { data, error } = await ctx.client.from("workflow_versions").select("id").eq("organization_id", ctx.orgId).eq("workflow_id", id).order("version", { ascending: false }).limit(1).maybeSingle();
+      fromDb(error);
+      vid = data?.id;
+    }
+    if (!vid) throw new ApiError("Save the automation before switching it on.", 422, "invalid");
+    const { data: v, error: vError } = await ctx.client.from("workflow_versions").select("definition").eq("organization_id", ctx.orgId).eq("workflow_id", id).eq("id", vid).maybeSingle();
+    fromDb(vError);
+    if (!v) throw new ApiError("Version not found.", 404, "not_found");
+    parseDefinition(v.definition);
+    patch.active_version_id = vid;
+  }
+  const { data, error } = await ctx.client.from("workflows").update(patch).eq("organization_id", ctx.orgId).eq("id", id).select(WORKFLOW_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Automation not found.", 404, "not_found");
+  if (status === "archived") {
+    await ctx.client.from("workflow_runs").update({ status: "cancelled" }).eq("organization_id", ctx.orgId).eq("workflow_id", id).in("status", ["running", "waiting"]);
+  }
+  await audit(ctx.client, ctx.orgId, `workflow.${status === "active" ? "activated" : status}`, { type: "workflow", id }, { version_id: patch.active_version_id ?? null });
+  return data;
+}
+
+export async function cancelRun(ctx: CrmContext, runId: string) {
+  const { data, error } = await ctx.client.from("workflow_runs").update({ status: "cancelled" }).eq("organization_id", ctx.orgId).eq("id", runId)
+    .in("status", ["running", "waiting"]).select("id, status").maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("That run has already finished.", 409, "conflict");
+  await audit(ctx.client, ctx.orgId, "workflow.run_cancelled", { type: "workflow_run", id: runId });
+  return data;
+}
diff --git a/src/lib/workflows/webhook.ts b/src/lib/workflows/webhook.ts
new file mode 100644
index 0000000..3e11ec0
--- /dev/null
+++ b/src/lib/workflows/webhook.ts
@@ -0,0 +1,16 @@
+import "server-only";
+import { createHmac } from "node:crypto";
+
+// Per-organization signing secret for outgoing workflow webhooks, derived from
+// APP_ENCRYPTION_KEY so nothing extra is stored. Receivers verify
+// X-Sun-Signature: t=<unix seconds>,v1=<hex HMAC-SHA256 of "t.body">.
+export function webhookSecret(orgId: string): string | null {
+  const raw = process.env.APP_ENCRYPTION_KEY?.trim();
+  if (!raw || raw.length < 32) return null;
+  return "whsec_" + createHmac("sha256", raw).update(`sun-marketing:webhook:v1:${orgId}`).digest("hex").slice(0, 48);
+}
+
+export function signWebhook(secret: string, body: string, now = new Date()) {
+  const t = Math.floor(now.getTime() / 1000);
+  return `t=${t},v1=${createHmac("sha256", secret).update(`${t}.${body}`).digest("hex")}`;
+}
