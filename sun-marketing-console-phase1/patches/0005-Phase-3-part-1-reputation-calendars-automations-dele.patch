new file mode 100644
index 0000000..5dfd580
--- /dev/null
+++ b/src/app/api/public/booking/[slug]/route.ts
@@ -0,0 +1,64 @@
+import { NextResponse } from "next/server";
+import { systemClient } from "@/lib/supabase/system";
+import { clientIp, takeLimit } from "@/lib/rate-limit";
+import { ApiError, errorResponse, readJson } from "@/lib/tenant/api";
+import { systemAudit } from "@/lib/tenant/system-audit";
+import { availability, book, CALENDAR_COLUMNS, findOrCreateContact, notifyAppointment, publicBookingInput, SMS_CONSENT_TEXT, todayIn, type Calendar } from "@/lib/calendar/service";
+import { publicBaseUrl } from "@/lib/supabase/system";
+
+export const dynamic = "force-dynamic";
+type P = { params: Promise<{ slug: string }> };
+
+async function load(slug: string) {
+  const system = systemClient();
+  if (!system) throw new ApiError("Online booking is not available right now.", 503, "integration_not_configured");
+  if (!/^[a-z0-9][a-z0-9-]{2,62}$/.test(slug)) throw new ApiError("This booking page does not exist.", 404, "not_found");
+  const { data: cal } = await system.from("calendars").select(CALENDAR_COLUMNS).eq("slug", slug).eq("is_public", true).eq("status", "active").maybeSingle();
+  if (!cal) throw new ApiError("This booking page does not exist.", 404, "not_found");
+  const { data: org } = await system.from("organizations").select("name, status").eq("id", cal.organization_id).maybeSingle();
+  if (!org || org.status !== "active") throw new ApiError("This booking page is not available.", 404, "not_found");
+  return { system, calendar: cal as Calendar, business: org.name as string };
+}
+
+// Open times for the next 7 days. Team member identities are never exposed.
+export async function GET(req: Request, { params }: P) {
+  try {
+    if (!(await takeLimit("booking-view", clientIp(req), 120, 600))) throw new ApiError("Too many requests. Try again in a few minutes.", 429, "rate_limited");
+    const { system, calendar, business } = await load((await params).slug);
+    const from = new URL(req.url).searchParams.get("from") || todayIn(calendar.timezone);
+    const { slots } = await availability(system, calendar.organization_id, calendar.id, from, 7);
+    return NextResponse.json({
+      business,
+      calendar: { name: calendar.name, description: calendar.description, duration_minutes: calendar.duration_minutes, timezone: calendar.timezone, location: calendar.location, max_days_ahead: calendar.max_days_ahead },
+      slots: slots.map((s) => ({ start: s.start, end: s.end })),
+      sms_consent_text: SMS_CONSENT_TEXT(business),
+    });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
+
+export async function POST(req: Request, { params }: P) {
+  try {
+    if (!(await takeLimit("booking-create", clientIp(req), 5, 3600))) throw new ApiError("Too many bookings from this connection. Please call us instead.", 429, "rate_limited");
+    const { system, calendar, business } = await load((await params).slug);
+    const input = await readJson(req, publicBookingInput);
+    const ctx = { client: system, orgId: calendar.organization_id, userId: null };
+    const contactId = await findOrCreateContact(ctx, { first_name: input.first_name, last_name: input.last_name, email: input.email, phone: input.phone || undefined }, "Online booking");
+    if (input.sms_consent && input.phone) {
+      await system.from("consents").insert({
+        organization_id: calendar.organization_id, contact_id: contactId, channel: "sms", status: "granted",
+        source: `Online booking form: ${calendar.name}`.slice(0, 200),
+        evidence: JSON.stringify({ text: SMS_CONSENT_TEXT(business), phone: input.phone, ip: clientIp(req), user_agent: req.headers.get("user-agent")?.slice(0, 200), at: new Date().toISOString() }).slice(0, 2000),
+      });
+    }
+    const { appointment } = await book(ctx, { calendar_id: calendar.id, contact_id: contactId, starts_at: input.starts_at, notes: input.notes }, "public");
+    await systemAudit(system, calendar.organization_id, "appointment.booked_online", { type: "appointment", id: appointment.id }, { calendar: calendar.name });
+    const notice = await notifyAppointment(ctx, appointment, calendar, "booked", { system: true, req }).catch(() => ({ sent: false }));
+    const base = publicBaseUrl(req);
+    return NextResponse.json({ ok: true, starts_at: appointment.starts_at, timezone: calendar.timezone, confirmation_sent: notice.sent, manage_url: base ? `${base}/appointment/${appointment.manage_token}` : `/appointment/${appointment.manage_token}` });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
+
