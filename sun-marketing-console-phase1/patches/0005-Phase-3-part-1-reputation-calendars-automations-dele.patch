+import { z } from "zod";
+import { readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { definitionSchema } from "@/lib/workflows/definition";
+import { getWorkflow, runLog, saveVersion, setStatus } from "@/lib/workflows/service";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const GET = tenantRoute<P>("crm.read", async (ctx, req, { id }) => {
+  const run = new URL(req.url).searchParams.get("run");
+  if (run) return { log: await runLog(scoped(ctx), uuid.parse(run)) };
+  return getWorkflow(scoped(ctx), uuid.parse(id));
+});
+
+const action = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("save"), definition: definitionSchema, notes: z.string().trim().max(500).optional(), name: z.string().trim().min(1).max(120).optional(), description: z.string().trim().max(1000).optional() }),
+  z.object({ action: z.literal("activate"), version_id: z.string().uuid().optional() }),
+  z.object({ action: z.literal("pause") }),
+  z.object({ action: z.literal("archive") }),
+]);
+
+// Saving creates a new immutable version; it never changes what is running
+// until a manager activates that version.
+export const POST = tenantRoute<P>("automation.manage", async (ctx, req, { id }) => {
+  const input = await readJson(req, action);
+  const wid = uuid.parse(id);
+  const c = scoped(ctx);
+  if (input.action === "save") {
+    if (input.name || input.description !== undefined) {
+      await ctx.client.from("workflows").update({ ...(input.name ? { name: input.name } : {}), ...(input.description !== undefined ? { description: input.description } : {}) })
+        .eq("organization_id", ctx.org.id).eq("id", wid);
+    }
+    const version = await saveVersion(c, wid, input.definition, input.notes);
+    await audit(ctx.client, ctx.org.id, "workflow.version_saved", { type: "workflow", id: wid }, { version: version.version });
+    return { version };
+  }
+  const status = input.action === "activate" ? "active" : input.action === "pause" ? "paused" : "archived";
+  return { workflow: await setStatus(c, wid, status, input.action === "activate" ? input.version_id : undefined) };
+});
