+        <p className="hint">Every text and email still passes the compliance check (consent, opt-outs, texting hours). A blocked message is logged and the automation continues; texts held by texting hours wait and retry. A contact is in one run of an automation at a time, at most three times a day.</p>
+        {error && <p className="form-error" role="alert">{error}</p>}
+        <div className="row">{canManage && <button className="btn btn-primary" disabled={busy} onClick={save}>{busy ? <span className="spin" /> : d.id ? "Save new version" : "Save draft"}</button>}<button className="btn btn-ghost" onClick={onCancel}>Close</button></div>
+      </div>
+    </div>
+  );
+}
+
+function RunLog({ flowId, runId }: { flowId: string; runId: string }) {
+  const { data, error, loading } = useResource<{ log: { step_index: number; action: string; status: string; detail: string | null; created_at: string }[] }>(`/api/workflows/${flowId}?run=${runId}`);
+  if (loading && !data) return <span className="tiny muted">Loading…</span>;
+  if (error) return <span className="form-error">{error}</span>;
+  if (!data?.log.length) return <span className="tiny muted">No steps yet.</span>;
+  return <div>{data.log.map((l, i) => <div key={i} className="log"><span>{l.step_index + 1}</span><span>{STEP_LABELS[l.action as Step["type"]] || l.action}</span><span><span className={`pill ${l.status === "ok" ? "pill-ok" : l.status === "failed" ? "pill-bad" : l.status === "blocked" ? "pill-warn" : "pill-neutral"}`}>{l.status}</span></span><span className="muted">{l.detail}</span></div>)}</div>;
+}
+
+function FlowDetail({ id, canManage, onEdit, onBack, toast }: { id: string; canManage: boolean; onEdit: (d: Draft) => void; onBack: () => void; toast: (m: string) => void }) {
+  const { data, error, loading, reload } = useResource<Detail>(`/api/workflows/${id}`);
+  const [open, setOpen] = useState<string | null>(null);
+  if (loading && !data) return <Loading />;
+  if (error) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return null;
+  const w = data.workflow;
+  const latest = data.versions[0];
+  const act = async (body: Record<string, unknown>, done: string) => { try { await api(`/api/workflows/${id}`, { body }); toast(done); reload(); } catch (e) { toast(e instanceof Error ? e.message : "That did not work."); } };
+  return (
+    <div className="split">
+      <div className="stack">
+        <div className="card">
+          <div className="card-head"><div><h3>{w.name} <span className={`pill ${STATUS_PILL[w.status]}`}>{w.status}</span></h3><div className="sub">{w.description || TRIGGERS[latest?.definition.trigger.type as TriggerType]?.label}</div></div>
+            <div className="row" style={{ gap: 6, flexWrap: "wrap" }}>
+              <button className="btn btn-sm btn-ghost" onClick={onBack}>All automations</button>
+              {canManage && latest && <button className="btn btn-sm" onClick={() => onEdit({ id, name: w.name, description: w.description || "", definition: latest.definition })}>Edit</button>}
+              {canManage && w.status !== "active" && latest && <button className="btn btn-sm btn-primary" onClick={() => { if (window.confirm(`Switch on version ${latest.version}? It will start for new events from now on.`)) act({ action: "activate", version_id: latest.id }, "Switched on."); }}>Switch on v{latest.version}</button>}
+              {canManage && w.status === "active" && latest && latest.id !== w.active_version_id && <button className="btn btn-sm btn-primary" onClick={() => act({ action: "activate", version_id: latest.id }, `Now running v${latest.version}.`)}>Use v{latest.version}</button>}
+              {canManage && w.status === "active" && <button className="btn btn-sm" onClick={() => act({ action: "pause" }, "Paused. Waiting runs hold until switched on again.")}>Pause</button>}
+              {canManage && w.status !== "archived" && <button className="btn btn-sm btn-ghost" onClick={() => { if (window.confirm("Archive this automation and stop its active runs?")) act({ action: "archive" }, "Archived."); }}>Archive</button>}
+            </div></div>
+          {latest && <div className="card-pad stack" style={{ gap: 6 }}>
+            <div className="small"><span className="pill pill-sun">When</span> {TRIGGERS[latest.definition.trigger.type]?.label}{Object.entries(latest.definition.trigger.filters || {}).filter(([, v]) => v !== undefined).map(([k, v]) => ` · ${k.replace("_", " ")}: ${v}`).join("")}</div>
+            {latest.definition.steps.map((s, i) => <div key={i} className="small row" style={{ gap: 8 }}><span className="step-num">{i + 1}</span>{describeStep(s)}</div>)}
