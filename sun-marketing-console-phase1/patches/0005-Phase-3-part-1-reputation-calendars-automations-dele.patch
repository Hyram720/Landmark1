diff --git a/src/app/review/[token]/page.tsx b/src/app/review/[token]/page.tsx
new file mode 100644
index 0000000..e6dfaa8
--- /dev/null
+++ b/src/app/review/[token]/page.tsx
@@ -0,0 +1,63 @@
+"use client";
+import { use, useEffect, useState } from "react";
+import "@/components/public/public.css";
+
+type Info = { business: string; sources: { id: string; platform: string; name: string }[]; rating: number | null };
+
+// Review request landing page. Every public review site is shown to every
+// customer, whatever they rate; private feedback is an extra option, never a
+// filter in front of the public sites (no review gating).
+export default function ReviewRequestPage({ params }: { params: Promise<{ token: string }> }) {
+  const { token } = use(params);
+  const [info, setInfo] = useState<Info | null>(null);
+  const [error, setError] = useState("");
+  const [rating, setRating] = useState(0);
+  const [hover, setHover] = useState(0);
+  const [feedback, setFeedback] = useState("");
+  const [sent, setSent] = useState(false);
+  const [busy, setBusy] = useState(false);
+  useEffect(() => {
+    fetch(`/api/public/review-request/${token}`, { cache: "no-store" })
+      .then(async (r) => { const j = await r.json(); if (!r.ok) throw new Error(j.error || "This link has expired."); setInfo(j); if (j.rating) { setRating(j.rating); setSent(true); } })
+      .catch((e) => setError(e.message));
+  }, [token]);
+  const open = async (sourceId: string) => {
+    const w = window.open("about:blank", "_blank");
+    try {
+      const r = await fetch(`/api/public/review-request/${token}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "click", source_id: sourceId }) });
+      const j = await r.json();
+      if (!r.ok) throw new Error(j.error);
+      if (w) w.location.href = j.url; else window.location.href = j.url;
+    } catch { w?.close(); }
+  };
+  if (error) return <div className="pub"><div className="pub-card narrow"><h1>This link has expired</h1><p className="lead">{error}</p></div></div>;
+  if (!info) return <div className="pub"><div className="pub-card narrow"><p className="lead">Loading…</p></div></div>;
+  const shown = hover || rating;
+  return (
+    <div className="pub"><div className="pub-card narrow">
+      <h1>How did we do?</h1>
+      <p className="lead">Thanks for choosing {info.business}. Your honest feedback helps.</p>
+      <div className="star-row" role="radiogroup" aria-label="Your rating" onMouseLeave={() => setHover(0)}>
+        {[1, 2, 3, 4, 5].map((n) => <button key={n} type="button" role="radio" aria-checked={rating === n} aria-label={`${n} star${n > 1 ? "s" : ""}`} className={`star-btn ${n <= shown ? "on" : ""}`} disabled={sent} onMouseEnter={() => !sent && setHover(n)} onClick={() => setRating(n)}>★</button>)}
+      </div>
+      {rating > 0 && !sent && (
+        <div className="stack">
+          <div className="field"><label htmlFor="fb">Tell us more (optional, private to {info.business})</label><textarea id="fb" className="textarea" rows={3} maxLength={2000} value={feedback} onChange={(e) => setFeedback(e.target.value)} /></div>
+          <button className="btn btn-primary" disabled={busy} onClick={async () => {
+            setBusy(true);
+            try {
+              const r = await fetch(`/api/public/review-request/${token}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "rate", rating, feedback: feedback.trim() || undefined }) });
+              if (r.ok) setSent(true);
+            } finally { setBusy(false); }
+          }}>{busy ? <span className="spin" /> : "Send to the team"}</button>
+        </div>
+      )}
+      {sent && <p className="lead" role="status">Thank you — {info.business} received your feedback{rating <= 3 ? " and will follow up with you" : ""}.</p>}
+      {info.sources.length > 0 && <>
+        <p className="lead" style={{ marginTop: 18, marginBottom: 0 }}>{sent ? "Would you also share your experience publicly?" : "Or leave a public review:"}</p>
+        <div className="sites">{info.sources.map((s) => <button key={s.id} className={`btn ${sent ? "btn-primary" : ""}`} onClick={() => open(s.id)}>Review us on {s.name}</button>)}</div>
+      </>}
+      <p className="foot">You can leave a public review whatever your rating.</p>
+    </div></div>
+  );
+}
