index 0000000..1512f31
--- /dev/null
+++ b/src/lib/reputation/csv.ts
@@ -0,0 +1,70 @@
+// Minimal RFC 4180 CSV reader for review imports (quoted fields, escaped
+// quotes, CRLF). Returns rows of strings; the first row is the header.
+export function parseCsv(text: string, maxRows = 2000): string[][] {
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (quoted) {
+      if (ch === '"') {
+        if (text[i + 1] === '"') { field += '"'; i++; } else quoted = false;
+      } else field += ch;
+      continue;
+    }
+    if (ch === '"' && field === "") quoted = true;
+    else if (ch === ",") { row.push(field); field = ""; }
+    else if (ch === "\n" || ch === "\r") {
+      if (ch === "\r" && text[i + 1] === "\n") i++;
+      row.push(field); field = "";
+      if (row.some((f) => f.trim() !== "")) rows.push(row);
+      row = [];
+      if (rows.length > maxRows) break;
+    } else field += ch;
+  }
+  row.push(field);
+  if (row.some((f) => f.trim() !== "")) rows.push(row);
+  return rows.slice(0, maxRows + 1);
+}
+
+export const PLATFORMS = ["google", "facebook", "yelp", "bbb", "trustpilot", "other"] as const;
+export type Platform = (typeof PLATFORMS)[number];
+
+export type ImportedReview = { platform: Platform; rating: number; author_name: string | null; body: string | null; published_at: string; external_id: string | null };
+
+// Accepts common export headers: rating/stars, author/name/reviewer,
+// text/review/comment/body, date/published/created, id/review_id, platform/source.
+export function reviewsFromCsv(text: string, fallbackPlatform: Platform): { rows: ImportedReview[]; errors: string[] } {
+  const table = parseCsv(text);
+  if (table.length < 2) return { rows: [], errors: ["The file needs a header row and at least one review."] };
+  const header = table[0].map((h) => h.trim().toLowerCase().replace(/[\s-]+/g, "_"));
+  const col = (...names: string[]) => header.findIndex((h) => names.includes(h));
+  const iRating = col("rating", "stars", "star_rating", "score");
+  if (iRating < 0) return { rows: [], errors: ["No rating column found (expected a column named rating or stars)."] };
+  const iAuthor = col("author", "name", "reviewer", "author_name", "reviewer_name");
+  const iBody = col("text", "review", "comment", "body", "review_text", "content");
+  const iDate = col("date", "published", "published_at", "created", "created_at", "review_date", "time");
+  const iId = col("id", "review_id", "external_id");
+  const iPlatform = col("platform", "source", "site");
+  const rows: ImportedReview[] = [];
+  const errors: string[] = [];
+  table.slice(1).forEach((r, n) => {
+    const line = n + 2;
+    const rating = Math.round(Number(String(r[iRating] ?? "").replace(/[^0-9.]/g, "")));
+    if (!(rating >= 1 && rating <= 5)) { errors.push(`Line ${line}: rating must be 1-5.`); return; }
+    const rawDate = iDate >= 0 ? (r[iDate] || "").trim() : "";
+    const date = rawDate ? new Date(rawDate) : new Date();
+    if (Number.isNaN(date.getTime())) { errors.push(`Line ${line}: unreadable date "${rawDate}".`); return; }
+    const p = iPlatform >= 0 ? (r[iPlatform] || "").trim().toLowerCase() : "";
+    rows.push({
+      platform: (PLATFORMS as readonly string[]).includes(p) ? (p as Platform) : fallbackPlatform,
+      rating,
+      author_name: iAuthor >= 0 ? (r[iAuthor] || "").trim().slice(0, 120) || null : null,
+      body: iBody >= 0 ? (r[iBody] || "").trim().slice(0, 10000) || null : null,
+      published_at: date.toISOString(),
+      external_id: iId >= 0 ? (r[iId] || "").trim().slice(0, 200) || null : null,
+    });
+  });
+  return { rows, errors: errors.slice(0, 20) };
+}
