new file mode 100644
index 0000000..7c8edb4
--- /dev/null
+++ b/src/app/api/public/appointment/[token]/route.ts
@@ -0,0 +1,62 @@
+import { NextResponse } from "next/server";
+import { z } from "zod";
+import { systemClient } from "@/lib/supabase/system";
+import { clientIp, takeLimit } from "@/lib/rate-limit";
+import { ApiError, errorResponse, readJson } from "@/lib/tenant/api";
+import { APPOINTMENT_COLUMNS, availability, changeAppointment, loadCalendar, notifyAppointment, todayIn, type Appointment } from "@/lib/calendar/service";
+
+export const dynamic = "force-dynamic";
+type P = { params: Promise<{ token: string }> };
+
+async function load(req: Request, token: string) {
+  if (!(await takeLimit("appointment-manage", clientIp(req), 60, 600))) throw new ApiError("Too many requests. Try again in a few minutes.", 429, "rate_limited");
+  const system = systemClient();
+  if (!system) throw new ApiError("This page is not available right now.", 503, "integration_not_configured");
+  if (!/^[0-9a-f]{36}$/.test(token)) throw new ApiError("This link is not valid.", 404, "not_found");
+  const { data } = await system.from("appointments").select(APPOINTMENT_COLUMNS).eq("manage_token", token).maybeSingle();
+  if (!data) throw new ApiError("This link is not valid.", 404, "not_found");
+  const appt = data as Appointment;
+  const { calendar } = await loadCalendar(system, appt.organization_id, appt.calendar_id);
+  const { data: org } = await system.from("organizations").select("name").eq("id", appt.organization_id).maybeSingle();
+  return { system, appt, calendar, business: org?.name || "" };
+}
+
+const upcoming = (a: Appointment) => ["booked", "confirmed"].includes(a.status) && new Date(a.starts_at).getTime() > Date.now();
+
+export async function GET(req: Request, { params }: P) {
+  try {
+    const { system, appt, calendar, business } = await load(req, (await params).token);
+    const from = new URL(req.url).searchParams.get("from");
+    const slots = from && upcoming(appt) && calendar.is_public && calendar.status === "active"
+      ? (await availability(system, appt.organization_id, calendar.id, from || todayIn(calendar.timezone), 7, new Date(), appt.id)).slots.map((s) => ({ start: s.start, end: s.end }))
+      : undefined;
+    return NextResponse.json({
+      business, status: appt.status, starts_at: appt.starts_at, ends_at: appt.ends_at, location: appt.location,
+      calendar: { name: calendar.name, timezone: calendar.timezone, can_reschedule: calendar.is_public && calendar.status === "active" },
+      can_change: upcoming(appt), slots,
+    });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
+
+const body = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("cancel"), reason: z.string().trim().max(500).optional() }),
+  z.object({ action: z.literal("reschedule"), starts_at: z.string().datetime({ offset: true }) }),
+]);
+
+export async function POST(req: Request, { params }: P) {
+  try {
+    const { system, appt, calendar } = await load(req, (await params).token);
+    if (!upcoming(appt)) throw new ApiError("This appointment can no longer be changed online. Please call us.", 409, "conflict");
+    const input = await readJson(req, body);
+    const ctx = { client: system, orgId: appt.organization_id, userId: null };
+    const updated = input.action === "cancel"
+      ? await changeAppointment(ctx, appt.id, { action: "status", status: "cancelled", reason: input.reason ? `Cancelled online: ${input.reason}` : "Cancelled online by the customer" }, new Date(), "public")
+      : await changeAppointment(ctx, appt.id, { action: "reschedule", starts_at: input.starts_at }, new Date(), "public");
+    await notifyAppointment(ctx, updated, calendar, input.action === "cancel" ? "cancelled" : "rescheduled", { system: true, req }).catch(() => null);
+    return NextResponse.json({ ok: true, status: updated.status, starts_at: updated.starts_at });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
