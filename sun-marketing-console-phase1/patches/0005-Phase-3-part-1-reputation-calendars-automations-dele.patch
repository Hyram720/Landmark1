+
+describe("time zones", () => {
+  it("converts wall-clock time to UTC across daylight saving", () => {
+    expect(zonedToUtc(2030, 1, 7, 9, 0, "America/New_York").toISOString()).toBe("2030-01-07T14:00:00.000Z");
+    expect(zonedToUtc(2030, 7, 8, 9, 0, "America/New_York").toISOString()).toBe("2030-07-08T13:00:00.000Z");
+    expect(zonedToUtc(2030, 7, 8, 9, 0, "America/Los_Angeles").toISOString()).toBe("2030-07-08T16:00:00.000Z");
+    expect(offsetMinutes(new Date("2030-01-07T12:00:00Z"), "America/Chicago")).toBe(-360);
+    expect(localDate(new Date("2030-01-08T03:00:00Z"), "America/New_York")).toBe("2030-01-07");
+    expect(addDays("2030-02-28", 1)).toBe("2030-03-01");
+  });
+});
+
+const rules: CalendarRules = {
+  timezone: "America/New_York", duration_minutes: 60, slot_interval_minutes: 30, buffer_before_minutes: 0, buffer_after_minutes: 0,
+  min_notice_minutes: 0, max_days_ahead: 30, daily_limit: null, working_hours: { mon: [["09:00", "12:00"]] },
+};
+const monday = "2030-01-07";
+const now = new Date("2030-01-06T12:00:00Z");
+
+describe("availability", () => {
+  it("offers start times inside working hours that fit the duration", () => {
+    const slots = computeSlots(rules, ["a"], [], monday, monday, now);
+    expect(slots.map((s) => s.start)).toEqual(["2030-01-07T14:00:00.000Z", "2030-01-07T14:30:00.000Z", "2030-01-07T15:00:00.000Z", "2030-01-07T15:30:00.000Z", "2030-01-07T16:00:00.000Z"]);
+    expect(computeSlots(rules, ["a"], [], "2030-01-08", "2030-01-08", now)).toEqual([]);
+  });
+  it("respects existing bookings per person, and buffers", () => {
+    const busy = [{ who: "a", start: new Date("2030-01-07T15:00:00Z"), end: new Date("2030-01-07T16:00:00Z") }];
+    const slots = computeSlots(rules, ["a", "b"], busy, monday, monday, now);
+    const at10 = slots.find((s) => s.start === "2030-01-07T15:00:00.000Z")!;
+    expect(at10.available).toEqual(["b"]);
+    const onlyA = computeSlots(rules, ["a"], busy, monday, monday, now).map((s) => s.start);
+    expect(onlyA).toEqual(["2030-01-07T14:00:00.000Z", "2030-01-07T16:00:00.000Z"]);
+    // 30 minutes between appointments: 9:00 would end at 10:00 right against the booking; 11:00 starts right after it.
+    expect(computeSlots({ ...rules, buffer_after_minutes: 30 }, ["a"], busy, monday, monday, now)).toEqual([]);
+    expect(computeSlots({ ...rules, buffer_after_minutes: 30, working_hours: { mon: [["08:00", "13:00"]] } }, ["a"], busy, monday, monday, now).map((s) => s.start))
+      .toEqual(["2030-01-07T13:00:00.000Z", "2030-01-07T13:30:00.000Z", "2030-01-07T16:30:00.000Z", "2030-01-07T17:00:00.000Z"]);
+  });
+  it("applies minimum notice, booking horizon and daily limits", () => {
+    const close = new Date("2030-01-07T14:10:00Z");
+    expect(computeSlots({ ...rules, min_notice_minutes: 60 }, ["a"], [], monday, monday, close)[0].start).toBe("2030-01-07T15:30:00.000Z");
+    expect(computeSlots({ ...rules, max_days_ahead: 0 }, ["a"], [], monday, monday, now)).toEqual([]);
+    const full = [{ who: "a", start: new Date("2030-01-07T20:00:00Z"), end: new Date("2030-01-07T21:00:00Z"), calendarDay: monday }];
+    expect(computeSlots({ ...rules, daily_limit: 1 }, ["a"], full, monday, monday, now)).toEqual([]);
+  });
+  it("treats unassigned bookings as holding the calendar", () => {
+    const busy = [{ who: "calendar", start: new Date("2030-01-07T14:00:00Z"), end: new Date("2030-01-07T15:00:00Z") }];
+    expect(computeSlots(rules, [], busy, monday, monday, now)[0].start).toBe("2030-01-07T15:00:00.000Z");
+    expect(computeSlots(rules, ["a", "b"], busy, monday, monday, now)[0].start).toBe("2030-01-07T15:00:00.000Z");
+  });
+  it("skips local times that do not exist on a DST change day", () => {
+    const sunday = { ...rules, working_hours: { sun: [["01:00", "04:00"]] as [string, string][] }, duration_minutes: 30 };
+    const starts = computeSlots(sunday, ["a"], [], "2030-03-10", "2030-03-10", new Date("2030-03-01T00:00:00Z")).map((s) => s.start);
+    expect(starts).toContain("2030-03-10T06:00:00.000Z"); // 01:00 EST
+    expect(starts).toContain("2030-03-10T07:00:00.000Z"); // 03:00 EDT
+    expect(starts).toHaveLength(new Set(starts).size);
+    expect(starts.length).toBe(4); // 01:00, 01:30, 03:00, 03:30 (02:xx does not exist)
+  });
+  it("round robin picks the least-loaded free person", () => {
+    expect(pickAssignee(["a", "b", "c"], ["a", "b", "c"], new Map([["a", 3], ["b", 1], ["c", 1]]))).toBe("b");
+    expect(pickAssignee([], ["a"], new Map())).toBeNull();
+  });
+  it("validates working hours", () => {
+    expect(validWorkingHours({ mon: [["09:00", "17:00"]] })).toBe(true);
+    expect(validWorkingHours({ mon: [["17:00", "09:00"]] })).toBe(false);
+    expect(validWorkingHours({ funday: [] })).toBe(false);
+    expect(validWorkingHours({ mon: [["9am", "5pm"]] })).toBe(false);
