+import { readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { appointmentChange, changeAppointment, loadCalendar, notifyAppointment } from "@/lib/calendar/service";
+import { z } from "zod";
+
+export const dynamic = "force-dynamic";
+
+const body = z.intersection(appointmentChange, z.object({ notify: z.boolean().optional() }));
+
+export const PATCH = tenantRoute<{ id: string }>("crm.write", async (ctx, req, { id }) => {
+  const input = await readJson(req, body);
+  const c = scoped(ctx);
+  const appointment = await changeAppointment(c, uuid.parse(id), input);
+  await audit(ctx.client, ctx.org.id, input.action === "status" ? `appointment.${input.status}` : "appointment.rescheduled", { type: "appointment", id: appointment.id });
+  let notice = null;
+  if (input.notify && (input.action === "reschedule" || input.status === "cancelled")) {
+    const { calendar } = await loadCalendar(c.client, c.orgId, appointment.calendar_id);
+    notice = await notifyAppointment(c, appointment, calendar, input.action === "reschedule" ? "rescheduled" : "cancelled", { req });
+  }
+  return { appointment, notice };
+});
