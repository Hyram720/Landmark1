+// Reputation Health Score (0-100), explained like the lead score: every
+// factor states its weight, the measured value and the points it earned.
+
+export type ReviewFact = { rating: number; published_at: string; status: string; response_status: string; responded_at: string | null };
+export type HealthFactor = { key: string; label: string; weight: number; points: number; detail: string };
+export type Health = { score: number | null; grade: string; factors: HealthFactor[]; stats: Record<string, number | null> };
+
+const DAY = 86_400_000;
+const clamp = (n: number) => Math.max(0, Math.min(1, n));
+const round1 = (n: number) => Math.round(n * 10) / 10;
+
+export function healthScore(reviews: ReviewFact[], now = new Date()): Health {
+  const total = reviews.length;
+  if (!total) {
+    return { score: null, grade: "No reviews yet", factors: [], stats: { total: 0, average: null, last90: 0, negative90: 0, responseRate: null, openComplaints: 0 } };
+  }
+  const avg = reviews.reduce((s, r) => s + r.rating, 0) / total;
+  const recent = reviews.filter((r) => now.getTime() - new Date(r.published_at).getTime() <= 90 * DAY);
+  const prior = reviews.filter((r) => {
+    const age = now.getTime() - new Date(r.published_at).getTime();
+    return age > 90 * DAY && age <= 180 * DAY;
+  });
+  const negatives = recent.filter((r) => r.rating <= 2).length;
+  const responded = reviews.filter((r) => r.response_status === "posted");
+  const responseRate = responded.length / total;
+  const speeds = responded.filter((r) => r.responded_at).map((r) => (new Date(r.responded_at!).getTime() - new Date(r.published_at).getTime()) / DAY);
+  const medianDays = speeds.length ? speeds.sort((a, b) => a - b)[Math.floor(speeds.length / 2)] : null;
+  const openComplaints = reviews.filter((r) => r.rating <= 2 && r.status !== "resolved").length;
+  const recentAvg = recent.length ? recent.reduce((s, r) => s + r.rating, 0) / recent.length : null;
+  const priorAvg = prior.length ? prior.reduce((s, r) => s + r.rating, 0) / prior.length : null;
+
+  const factors: HealthFactor[] = [
+    { key: "rating", label: "Average rating", weight: 30, points: 30 * clamp((avg - 1) / 4), detail: `${round1(avg)} stars across ${total} review${total === 1 ? "" : "s"}` },
+    { key: "volume", label: "Review volume", weight: 10, points: 10 * clamp(Math.log10(total + 1) / 2), detail: `${total} total (100+ earns full points)` },
+    { key: "velocity", label: "Recent reviews (90 days)", weight: 15, points: 15 * clamp(recent.length / 12), detail: `${recent.length} in the last 90 days (12+ earns full points)` },
+    { key: "negative", label: "Negative reviews (90 days)", weight: 10, points: recent.length ? 10 * clamp(1 - (negatives / recent.length) * 4) : 5, detail: recent.length ? `${negatives} of ${recent.length} were 1-2 stars` : "No recent reviews to judge" },
+    { key: "response_rate", label: "Response rate", weight: 15, points: 15 * responseRate, detail: `${Math.round(responseRate * 100)}% of reviews have a posted reply` },
+    { key: "response_speed", label: "Response speed", weight: 5, points: medianDays === null ? 0 : 5 * clamp(1 - (medianDays - 1) / 6), detail: medianDays === null ? "No replies yet" : `Typical reply after ${round1(medianDays)} day(s) (within 1 day earns full points)` },
+    { key: "complaints", label: "Unresolved complaints", weight: 10, points: 10 * clamp(1 - openComplaints / 3), detail: `${openComplaints} negative review(s) not marked resolved` },
+    { key: "trend", label: "Trend", weight: 5, points: recentAvg === null || priorAvg === null ? 2.5 : 5 * clamp(0.5 + (recentAvg - priorAvg) / 2), detail: recentAvg === null || priorAvg === null ? "Not enough history yet" : `Last 90 days ${round1(recentAvg)}★ vs ${round1(priorAvg)}★ the 90 days before` },
+  ].map((f) => ({ ...f, points: round1(f.points) }));
+  const score = Math.round(factors.reduce((s, f) => s + f.points, 0));
+  const grade = score >= 85 ? "Excellent" : score >= 70 ? "Good" : score >= 50 ? "Needs attention" : "At risk";
+  return {
+    score, grade, factors,
+    stats: { total, average: round1(avg), last90: recent.length, negative90: negatives, responseRate: Math.round(responseRate * 100), openComplaints },
+  };
+}
