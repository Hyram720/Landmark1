+import { scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { availability, todayIn, loadCalendar } from "@/lib/calendar/service";
+
+export const dynamic = "force-dynamic";
+
+export const GET = tenantRoute<{ id: string }>("crm.read", async (ctx, req, { id }) => {
+  const url = new URL(req.url);
+  const c = scoped(ctx);
+  const { calendar } = await loadCalendar(c.client, c.orgId, uuid.parse(id));
+  const from = url.searchParams.get("from") || todayIn(calendar.timezone);
+  // When rescheduling, the appointment being moved does not block its own new time.
+  const exclude = url.searchParams.get("exclude");
+  const { slots } = await availability(c.client, c.orgId, calendar.id, from, Number(url.searchParams.get("days")) || 7, new Date(), exclude ? uuid.parse(exclude) : undefined);
+  return { timezone: calendar.timezone, slots };
+});
