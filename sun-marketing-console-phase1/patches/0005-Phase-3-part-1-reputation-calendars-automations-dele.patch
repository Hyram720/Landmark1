@@ -0,0 +1,280 @@
+"use client";
+import { useState } from "react";
+import TenantGate, { ErrorState, Loading } from "@/components/tenant/TenantGate";
+import ContactPicker, { type PickedContact } from "@/components/tenant/ContactPicker";
+import { api, atLeast, Org, personName, relativeTime, useResource } from "@/components/tenant/client";
+import { Copy, useToast } from "@/components/ui";
+
+type Factor = { key: string; label: string; weight: number; points: number; detail: string };
+type Review = {
+  id: string; platform: string; rating: number; author_name: string | null; body: string | null; published_at: string; status: "new" | "acknowledged" | "resolved";
+  response_body: string | null; response_status: "none" | "draft" | "posted"; response_ai_drafted: boolean; contacts: { first_name: string | null; last_name: string | null } | null;
+};
+type Source = { id: string; platform: string; name: string; review_url: string; status: string };
+type Request = { id: string; channel: string; status: string; rating: number | null; feedback: string | null; created_at: string; contacts: { first_name: string | null; last_name: string | null } | null };
+type Data = {
+  health: { score: number | null; grade: string; factors: Factor[]; stats: Record<string, number | null> };
+  requests90: { sent: number; opened: number; rated: number; clickedPublic: number; privateNegative: number };
+  sources: Source[]; reviews: Review[]; totalReviews: number; requests: Request[];
+};
+
+const PLATFORMS = ["google", "facebook", "yelp", "bbb", "trustpilot", "other"];
+const label = (p: string) => (p === "bbb" ? "BBB" : p[0].toUpperCase() + p.slice(1));
+const Stars = ({ n }: { n: number }) => <span className="stars" aria-label={`${n} out of 5 stars`}>{"★".repeat(n)}<span style={{ color: "var(--text-3)", opacity: 0.35 }}>{"★".repeat(5 - n)}</span></span>;
+
+function Health({ data }: { data: Data }) {
+  const h = data.health;
+  return (
+    <div className="card">
+      <div className="card-head"><div><h3>Reputation health</h3><div className="sub">Scored from your reviews and how quickly you respond. Every point is explained.</div></div></div>
+      <div className="card-pad stack">
+        <div className="row" style={{ gap: 18, alignItems: "center", flexWrap: "wrap" }}>
+          <div className="score-ring" style={{ ["--p" as string]: h.score ?? 0 }}><div>{h.score ?? "—"}</div></div>
+          <div className="stack" style={{ gap: 4, flex: 1, minWidth: 180 }}>
+            <strong>{h.grade}</strong>
+            <span className="small muted">{h.stats.total ? `${h.stats.average}★ average across ${h.stats.total} reviews · ${h.stats.responseRate}% replied` : "Add review sites and import or record reviews to start scoring."}</span>
+          </div>
+        </div>
+        {h.factors.map((f) => (
+          <div key={f.key} className="stack" style={{ gap: 4 }}>
+            <div className="factor"><span>{f.label}</span><span className="muted">{f.points} / {f.weight}</span></div>
+            <div className="bar"><span style={{ width: `${(f.points / f.weight) * 100}%` }} /></div>
+            <span className="tiny muted">{f.detail}</span>
+          </div>
+        ))}
+        <div className="stat-row">
+          <div className="mini-stat"><div className="v">{data.requests90.sent}</div><div className="k">Requests sent (90 days)</div></div>
+          <div className="mini-stat"><div className="v">{data.requests90.clickedPublic}</div><div className="k">Opened a review site</div></div>
+          <div className="mini-stat"><div className="v">{data.requests90.privateNegative}</div><div className="k">Unhappy private feedback</div></div>
+          <div className="mini-stat"><div className="v">{h.stats.openComplaints ?? 0}</div><div className="k">Open complaints</div></div>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+function ReviewItem({ r, canWrite, onChanged, toast }: { r: Review; canWrite: boolean; onChanged: () => void; toast: (m: string) => void }) {
+  const [reply, setReply] = useState(r.response_body || "");
+  const [busy, setBusy] = useState(false);
+  const save = async (body: Record<string, unknown>, done: string) => {
+    setBusy(true);
+    try { await api(`/api/reputation/reviews/${r.id}`, { method: "PATCH", body }); toast(done); onChanged(); }
+    catch (e) { toast(e instanceof Error ? e.message : "Could not save."); }
+    finally { setBusy(false); }
+  };
+  return (
+    <div className="review-item">
+      <div className="row" style={{ justifyContent: "space-between", flexWrap: "wrap" }}>
+        <div className="row" style={{ flexWrap: "wrap", gap: 8 }}>
+          <Stars n={r.rating} />
+          <strong className="small">{r.author_name || (r.contacts ? personName(r.contacts) : "Anonymous")}</strong>
+          <span className="tiny muted">{label(r.platform)} · {relativeTime(r.published_at)}</span>
+        </div>
+        <div className="row" style={{ gap: 6 }}>
+          <span className={`pill ${r.status === "resolved" ? "pill-ok" : r.rating <= 2 && r.status === "new" ? "pill-bad" : "pill-neutral"}`}>{r.status}</span>
+          <span className={`pill ${r.response_status === "posted" ? "pill-ok" : r.response_status === "draft" ? "pill-info" : "pill-warn"}`}>{r.response_status === "posted" ? "Replied" : r.response_status === "draft" ? `Draft reply${r.response_ai_drafted ? " (AI)" : ""}` : "No reply"}</span>
+        </div>
+      </div>
+      {r.body && <div className="text">{r.body}</div>}
+      {canWrite && r.response_status !== "posted" && (
+        <div className="stack" style={{ gap: 6 }}>
+          <label className="sr-only" htmlFor={`reply-${r.id}`}>Reply</label>
+          <textarea id={`reply-${r.id}`} className="textarea" rows={3} value={reply} onChange={(e) => setReply(e.target.value)} placeholder="Write a reply. Thank them, be specific, never argue, never share private details." maxLength={4000} />
+          <div className="inline-actions">
+            <button className="btn btn-sm" disabled={busy || !reply.trim()} onClick={() => save({ response_body: reply.trim(), response_status: "draft" }, "Draft saved.")}>Save draft</button>
+            {reply.trim() && <Copy text={reply.trim()} label="Copy reply" />}
+            <button className="btn btn-sm btn-primary" disabled={busy || !reply.trim()} onClick={() => save({ response_body: reply.trim(), response_status: "posted" }, "Marked as replied.")}>I posted it</button>
+            {r.status !== "acknowledged" && r.status !== "resolved" && <button className="btn btn-sm btn-ghost" disabled={busy} onClick={() => save({ status: "acknowledged" }, "Acknowledged.")}>Acknowledge</button>}
+            {r.status !== "resolved" && <button className="btn btn-sm btn-ghost" disabled={busy} onClick={() => save({ status: "resolved" }, "Marked resolved.")}>Resolve</button>}
+          </div>
+          <span className="hint">Post the reply on {label(r.platform)} yourself, then press &ldquo;I posted it&rdquo;. Posting directly from here arrives with the {label(r.platform)} connection in a later update. The AI operator can draft replies for you in the Command Center.</span>
+        </div>
+      )}
+      {r.response_status === "posted" && r.response_body && <div className="small" style={{ borderLeft: "3px solid var(--line)", paddingLeft: 10 }}><span className="tiny muted">Your reply</span><div className="text">{r.response_body}</div>
+        {r.status !== "resolved" && canWrite && <button className="btn btn-sm btn-ghost" style={{ marginTop: 6 }} onClick={() => save({ status: "resolved" }, "Marked resolved.")}>Mark resolved</button>}</div>}
+    </div>
+  );
+}
+
+function AddReview({ onDone, toast, canImport }: { onDone: () => void; toast: (m: string) => void; canImport: boolean }) {
+  const [mode, setMode] = useState<"none" | "manual" | "csv">("none");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  if (mode === "none") return (
+    <div className="row" style={{ padding: 12, gap: 8, flexWrap: "wrap" }}>
+      <button className="btn btn-sm" onClick={() => setMode("manual")}>Record a review</button>
+      {canImport && <button className="btn btn-sm" onClick={() => setMode("csv")}>Import CSV</button>}
+    </div>
+  );
+  return (
