+}
+
+function dbError(error: { code?: string; message?: string } | null) {
+  if (!error) return;
+  if (error.code === "P0002") throw new ApiError(error.message || "This link has expired.", 404, "not_found");
+  if (error.code === "22023") throw new ApiError(error.message || "Invalid request.", 422, "invalid");
+  console.error("[review-request]", error.code, error.message);
+  throw new ApiError("Something went wrong. Please try again.", 500, "server_error");
+}
+
+// Every active review site is always returned, whatever the customer rates.
+export async function GET(req: Request, { params }: P) {
+  try {
+    const token = (await params).token;
+    const system = await setup(req, token);
+    const { data, error } = await system.rpc("review_request_respond", { p_token: token, p_event: "open" });
+    dbError(error);
+    const orgId = (data as { organization_id: string }).organization_id;
+    const [{ data: org }, { data: sources }] = await Promise.all([
+      system.from("organizations").select("name").eq("id", orgId).maybeSingle(),
+      system.from("review_sources").select("id, platform, name").eq("organization_id", orgId).eq("status", "active").order("position").order("created_at"),
+    ]);
+    return NextResponse.json({ business: org?.name || "", sources: sources || [], rating: (data as { rating: number | null }).rating ?? null });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
+
+const body = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("rate"), rating: z.number().int().min(1).max(5), feedback: z.string().trim().max(2000).optional() }),
+  z.object({ action: z.literal("click"), source_id: z.string().uuid() }),
+]);
+
+export async function POST(req: Request, { params }: P) {
+  try {
+    const token = (await params).token;
+    const system = await setup(req, token);
+    const input = await readJson(req, body);
+    if (input.action === "rate") {
+      const { data, error } = await system.rpc("review_request_respond", { p_token: token, p_event: "rate", p_rating: input.rating, p_feedback: input.feedback ?? null });
+      dbError(error);
+      return NextResponse.json({ ok: true, rating: (data as { rating: number }).rating });
+    }
+    const { data, error } = await system.rpc("review_request_respond", { p_token: token, p_event: "click", p_source: input.source_id });
+    dbError(error);
+    const orgId = (data as { organization_id: string }).organization_id;
+    const { data: source } = await system.from("review_sources").select("review_url").eq("organization_id", orgId).eq("id", input.source_id).maybeSingle();
+    if (!source) throw new ApiError("Unknown review site.", 404, "not_found");
+    return NextResponse.json({ ok: true, url: source.review_url });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
