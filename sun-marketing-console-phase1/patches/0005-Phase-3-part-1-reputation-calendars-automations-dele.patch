+/* Customer-facing pages (booking, appointment management, review requests). */
+.pub{min-height:100vh;padding:28px 16px 48px;background:linear-gradient(170deg,var(--sun-50),#fff 42%,var(--ink-50));color:#1d1a16}
+.pub-card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow-lg);max-width:640px;margin:0 auto;padding:26px 24px}
+.pub-card.narrow{max-width:470px;text-align:center}
+.pub h1{font-size:22px;letter-spacing:-.02em;margin-bottom:4px}
+.pub .lead{color:#5d564c;font-size:14.5px;margin-bottom:16px}
+.pub .days{display:flex;gap:6px;overflow-x:auto;padding-bottom:6px;margin-bottom:12px}
+.pub .day{flex:none;border:1px solid var(--line);background:#fff;border-radius:12px;padding:8px 12px;cursor:pointer;text-align:center;min-width:72px;color:inherit}
+.pub .day.on{border-color:var(--sun-500);background:var(--sun-50)}
+.pub .day small{display:block;color:#7a7266;font-size:11.5px}
+.pub .times{display:grid;grid-template-columns:repeat(auto-fill,minmax(98px,1fr));gap:8px}
+.pub .time{border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 6px;font-weight:620;cursor:pointer;color:inherit;font-size:14px}
+.pub .time.on{border-color:var(--sun-600);background:var(--sun-500);color:#fff}
+.pub .field{display:flex;flex-direction:column;gap:5px;text-align:left}
+.pub .field label{font-size:12.5px;font-weight:620;color:#5d564c}
+.pub .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
+.pub .consent{display:flex;gap:9px;align-items:flex-start;font-size:12px;color:#5d564c;text-align:left;line-height:1.45}
+.pub .consent input{margin-top:2px;flex:none}
+.pub .star-row{display:flex;justify-content:center;gap:6px;margin:14px 0}
+.pub .star-btn{font-size:36px;line-height:1;background:none;border:0;cursor:pointer;color:#e3ddd3;padding:2px}
+.pub .star-btn.on{color:#f5a524}
+.pub .sites{display:flex;flex-direction:column;gap:8px;margin-top:12px}
