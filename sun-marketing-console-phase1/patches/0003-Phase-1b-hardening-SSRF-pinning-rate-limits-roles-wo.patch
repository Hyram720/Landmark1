+import { describe, expect, it } from "vitest";
+import { createServer } from "node:http";
+import type { AddressInfo } from "node:net";
+import { Agent, fetch as undiciFetch } from "undici";
+import { assertPublicUrl, createGuardedLookup, isBlockedAddress, BlockedAddressError, publicFetch } from "@/lib/net/public-network";
+
+describe("isBlockedAddress", () => {
+  it.each([
+    "0.0.0.0", "10.1.2.3", "100.64.0.1", "100.127.255.254", "127.0.0.1", "169.254.169.254", "172.16.0.1", "172.31.255.255",
+    "192.0.0.8", "192.0.2.1", "192.88.99.1", "192.168.1.1", "198.18.0.1", "198.51.100.1", "203.0.113.9", "224.0.0.1", "255.255.255.255",
+    "::", "::1", "fc00::1", "fd12:3456::1", "fe80::1", "ff02::1", "2001:db8::1",
+    "::ffff:127.0.0.1", "::ffff:10.0.0.1", "::ffff:172.16.0.1", "::ffff:169.254.169.254", "::ffff:a9fe:a9fe", "::ffff:7f00:1",
+    "::127.0.0.1", "64:ff9b::a9fe:a9fe", "2002:c0a8:0101::1", "fe80::1%eth0",
+    "not-an-ip", "",
+  ])("blocks %s", (ip) => expect(isBlockedAddress(ip)).toBe(true));
+
+  it.each(["8.8.8.8", "1.1.1.1", "100.63.255.255", "100.128.0.1", "172.15.0.1", "172.32.0.1", "2606:4700:4700::1111", "::ffff:8.8.8.8", "64:ff9b::808:808", "2002:0808:0808::1"])(
+    "allows public %s",
+    (ip) => expect(isBlockedAddress(ip)).toBe(false),
+  );
+});
+
+describe("assertPublicUrl", () => {
+  it("rejects non-web schemes, credentials, local names, private literals and odd ports", () => {
+    for (const url of ["ftp://example.com", "file:///etc/passwd", "http://user:pw@example.com", "http://localhost/", "http://printer.local", "http://metadata.google.internal", "http://169.254.169.254/latest", "http://[::1]/", "http://example.com:6379/"]) {
+      expect(() => assertPublicUrl(url), url).toThrow();
+    }
+  });
+  it("accepts normal public URLs", () => {
+    expect(assertPublicUrl("https://example.com/path").hostname).toBe("example.com");
+    expect(assertPublicUrl("http://example.com:8080/").port).toBe("8080");
+  });
+});
+
+describe("connect-time guard", () => {
+  const run = (addresses: { address: string; family: number }[], options: object = {}) =>
+    new Promise<{ err: Error | null; address: unknown; family?: number }>((resolve) => {
+      createGuardedLookup((_host, cb) => cb(null, addresses))("rebind.example", options as never, ((err: Error | null, address: unknown, family?: number) =>
+        resolve({ err, address, family })) as never);
+    });
+
+  it("refuses a hostname that resolves to a private address (DNS rebinding)", async () => {
+    const r = await run([{ address: "127.0.0.1", family: 4 }]);
+    expect(r.err).toBeInstanceOf(BlockedAddressError);
+  });
+  it("refuses if any resolved address is private", async () => {
+    const r = await run([{ address: "93.184.216.34", family: 4 }, { address: "10.0.0.5", family: 4 }]);
+    expect(r.err).toBeInstanceOf(BlockedAddressError);
+  });
+  it("returns public addresses, honoring family and all", async () => {
+    const addrs = [{ address: "2606:4700::1", family: 6 }, { address: "93.184.216.34", family: 4 }];
+    expect(await run(addrs, { family: 4 })).toMatchObject({ err: null, address: "93.184.216.34", family: 4 });
+    expect((await run(addrs, { all: true })).address).toEqual(addrs);
+  });
+
+  it("is enforced by undici at connect time: a hostname that resolves to loopback never reaches the server", async () => {
+    let hits = 0;
+    const server = createServer((_req, res) => { hits++; res.end("secret"); });
+    await new Promise<void>((r) => server.listen(0, "127.0.0.1", r));
+    const port = (server.address() as AddressInfo).port;
+    const agent = new Agent({ connect: { lookup: createGuardedLookup((_h, cb) => cb(null, [{ address: "127.0.0.1", family: 4 }])) } });
+    try {
+      const error = await undiciFetch(`http://rebind.example:${port}/`, { dispatcher: agent }).catch((e) => e);
+      expect(error).toBeInstanceOf(TypeError);
+      expect((error as { cause?: unknown }).cause).toBeInstanceOf(BlockedAddressError);
+      expect(hits).toBe(0);
+    } finally {
+      await agent.close();
+      server.close();
+    }
+  });
+
+  it("publicFetch rejects private literals before any network work", async () => {
+    await expect(publicFetch("http://127.0.0.1/")).rejects.toBeInstanceOf(BlockedAddressError);
+  });
+});
