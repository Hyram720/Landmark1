diff --git a/src/lib/legacy-auth.ts b/src/lib/legacy-auth.ts
new file mode 100644
index 0000000..3802c2c
--- /dev/null
+++ b/src/lib/legacy-auth.ts
@@ -0,0 +1,36 @@
+import "server-only";
+import { NextResponse } from "next/server";
+import { cookies } from "next/headers";
+import { COOKIE, expectedToken, gateEnabled } from "./auth";
+import { db } from "./db";
+import { getUserSession } from "./tenant/session";
+import { sameSecret } from "./rate-limit";
+
+// Who is calling a legacy (single-tenant) route. Middleware already limits
+// these routes to passcode sessions and platform staff; this adds role checks
+// for sensitive operations.
+export type LegacyRole = "owner" | "admin" | "member";
+export type LegacyActor = { kind: "passcode"; role: "owner" } | { kind: "staff"; role: LegacyRole; userId: string };
+
+const RANK: Record<LegacyRole, number> = { member: 1, admin: 2, owner: 3 };
+
+export async function getLegacyActor(): Promise<LegacyActor | null> {
+  const token = (await cookies()).get(COOKIE)?.value;
+  if (gateEnabled() && token && sameSecret(token, expectedToken())) return { kind: "passcode", role: "owner" };
+  const session = await getUserSession();
+  const client = db();
+  if (!session || !client) return null;
+  const { data } = await client.from("team_members").select("role, active").eq("user_id", session.user.id).maybeSingle();
+  if (!data?.active || !(data.role in RANK)) return null;
+  return { kind: "staff", role: data.role as LegacyRole, userId: session.user.id };
+}
+
+// Returns a 401/403 response when the caller lacks the role, otherwise null.
+export async function requireLegacyRole(min: LegacyRole): Promise<NextResponse | null> {
+  const actor = await getLegacyActor();
+  if (!actor) return NextResponse.json({ error: "Sign in first." }, { status: 401 });
+  if (RANK[actor.role] < RANK[min]) {
+    return NextResponse.json({ error: `This requires the ${min} role.` }, { status: 403 });
+  }
+  return null;
+}
diff --git a/src/lib/net/public-network.ts b/src/lib/net/public-network.ts
new file mode 100644
index 0000000..2106131
--- /dev/null
+++ b/src/lib/net/public-network.ts
@@ -0,0 +1,123 @@
+import "server-only";
+import { lookup as dnsLookup, type LookupAddress } from "node:dns";
+import { isIP, type LookupFunction } from "node:net";
+import { Agent, fetch as undiciFetch } from "undici";
+
+// Outbound requests to user-supplied URLs (site scanner, contact enrichment)
+// must only reach the public internet. Addresses are checked inside the
+// socket's own DNS lookup, so the address that is validated is the address
+// that is connected to — a DNS-rebinding server cannot swap in a private IP
+// between a check and the request.
+
+export class BlockedAddressError extends Error {
+  constructor() {
+    super("Private network addresses cannot be reached.");
+  }
+}
+
+function v4Blocked(ip: string) {
+  const [a, b, c] = ip.split(".").map(Number);
+  return (
+    a === 0 || a === 10 || a === 127 || a >= 224 || // this-network, private, loopback, multicast/reserved/broadcast
+    (a === 100 && b >= 64 && b <= 127) || // carrier-grade NAT
+    (a === 169 && b === 254) || // link-local, cloud metadata
+    (a === 172 && b >= 16 && b <= 31) ||
+    (a === 192 && b === 168) ||
+    (a === 192 && b === 0 && (c === 0 || c === 2)) || // IETF protocol assignments, TEST-NET-1
+    (a === 192 && b === 88 && c === 99) || // 6to4 relay
+    (a === 198 && (b === 18 || b === 19)) || // benchmarking
+    (a === 198 && b === 51 && c === 100) || // TEST-NET-2
+    (a === 203 && b === 0 && c === 113) // TEST-NET-3
+  );
+}
+
+// Expands an IPv6 address (including an embedded dotted IPv4 tail) to eight 16-bit groups.
+function v6Groups(ip: string): number[] | null {
+  let text = ip.toLowerCase().split("%")[0];
+  const dotted = text.match(/(\d+\.\d+\.\d+\.\d+)$/);
+  if (dotted) {
+    const [a, b, c, d] = dotted[1].split(".").map(Number);
+    text = text.slice(0, -dotted[1].length) + `${((a << 8) | b).toString(16)}:${((c << 8) | d).toString(16)}`;
+  }
+  const [head, tail] = text.split("::");
+  const parse = (s: string) => (s ? s.split(":").map((g) => parseInt(g, 16)) : []);
+  const h = parse(head);
+  const t = text.includes("::") ? parse(tail) : [];
+  const groups = text.includes("::") ? [...h, ...Array(8 - h.length - t.length).fill(0), ...t] : h;
+  return groups.length === 8 && groups.every((g) => Number.isInteger(g) && g >= 0 && g <= 0xffff) ? groups : null;
+}
+
+const v4From = (hi: number, lo: number) => `${hi >> 8}.${hi & 255}.${lo >> 8}.${lo & 255}`;
+
+export function isBlockedAddress(address: string): boolean {
+  const kind = isIP(address.split("%")[0]);
+  if (kind === 4) return v4Blocked(address);
+  if (kind !== 6) return true; // not an IP literal: never connect to it
+  const g = v6Groups(address);
+  if (!g) return true;
+  const zeroPrefix = (n: number) => g.slice(0, n).every((x) => x === 0);
+  if (g.every((x) => x === 0)) return true; // ::
+  if (zeroPrefix(7) && g[7] === 1) return true; // ::1
+  if (zeroPrefix(5) && g[5] === 0xffff) return v4Blocked(v4From(g[6], g[7])); // ::ffff:a.b.c.d (mapped)
+  if (zeroPrefix(6)) return v4Blocked(v4From(g[6], g[7])); // ::a.b.c.d (compatible, deprecated)
+  if (g[0] === 0x64 && g[1] === 0xff9b) return v4Blocked(v4From(g[6], g[7])); // NAT64
+  if (g[0] === 0x2002) return v4Blocked(v4From(g[1], g[2])); // 6to4 embeds IPv4
+  if ((g[0] & 0xfe00) === 0xfc00) return true; // unique local fc00::/7
+  if ((g[0] & 0xffc0) === 0xfe80) return true; // link-local fe80::/10
+  if ((g[0] & 0xff00) === 0xff00) return true; // multicast
+  if (g[0] === 0x2001 && g[1] === 0x0db8) return true; // documentation
+  return false;
+}
+
+type Resolver = (hostname: string, cb: (err: NodeJS.ErrnoException | null, addresses: LookupAddress[]) => void) => void;
+
+const systemResolver: Resolver = (hostname, cb) => dnsLookup(hostname, { all: true, verbatim: true }, cb);
+
+// A net.connect-compatible lookup that refuses to resolve to blocked addresses.
+export function createGuardedLookup(resolve: Resolver = systemResolver): LookupFunction {
+  return (hostname, options, callback) => {
+    resolve(hostname, (err, addresses) => {
+      if (err) return callback(err, "", 0);
+      if (!addresses.length || addresses.some((a) => isBlockedAddress(a.address))) {
+        return callback(new BlockedAddressError() as NodeJS.ErrnoException, "", 0);
+      }
+      const family = typeof options === "object" && options ? options.family : undefined;
+      const usable = family === 4 || family === 6 ? addresses.filter((a) => a.family === family) : addresses;
+      if (!usable.length) return callback(Object.assign(new Error(`No IPv${family} address for ${hostname}.`), { code: "ENOTFOUND" }), "", 0);
+      if (typeof options === "object" && options?.all) {
+        (callback as unknown as (e: null, a: LookupAddress[]) => void)(null, usable);
+      } else {
+        callback(null, usable[0].address, usable[0].family);
+      }
+    });
+  };
+}
+
+const dispatcher = new Agent({ connect: { lookup: createGuardedLookup() } });
+
+// Fast, friendly validation before any network work. The connect-time guard
+// above is the real enforcement (it also covers hostnames and redirects).
+export function assertPublicUrl(raw: string) {
+  const url = new URL(raw);
+  if (!["http:", "https:"].includes(url.protocol)) throw new Error("Only HTTP and HTTPS websites can be reached.");
+  if (url.username || url.password) throw new Error("Website addresses cannot contain credentials.");
+  const host = url.hostname.toLowerCase().replace(/^\[|\]$/g, "");
+  if (host === "localhost" || host.endsWith(".localhost") || host.endsWith(".local") || host.endsWith(".internal")) throw new BlockedAddressError();
+  if (isIP(host) && isBlockedAddress(host)) throw new BlockedAddressError();
+  if (url.port && !["80", "443", "8080", "8443"].includes(url.port)) throw new Error("Only standard web ports can be reached.");
+  return url;
+}
+
+// fetch() for user-supplied URLs. Redirects are not followed automatically:
+// callers follow them manually so every hop is re-validated.
+export async function publicFetch(raw: string, init: { headers?: Record<string, string>; signal?: AbortSignal; method?: string } = {}): Promise<Response> {
+  assertPublicUrl(raw);
+  try {
+    const response = await undiciFetch(raw, { ...init, redirect: "manual", dispatcher });
+    return response as unknown as Response;
+  } catch (error) {
+    const cause = error instanceof Error ? (error as Error & { cause?: unknown }).cause : undefined;
+    if (cause instanceof BlockedAddressError) throw cause;
+    throw error;
+  }
+}
