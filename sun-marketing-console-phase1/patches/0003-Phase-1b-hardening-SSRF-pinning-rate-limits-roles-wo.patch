+import { describe, expect, it, vi } from "vitest";
+import { settingsPatch } from "@/lib/settings-schema";
+
+vi.mock("@/lib/db", () => ({ db: () => null }));
+const { takeLimit, sameSecret } = await import("@/lib/rate-limit");
+
+describe("settings allow-list", () => {
+  it("drops unknown columns (no mass assignment)", () => {
+    const r = settingsPatch.parse({ agency_name: "Sun", id: 99, is_admin: true, created_at: "x" });
+    expect(r).toEqual({ agency_name: "Sun" });
+  });
+  it("normalizes bare domains and blanks", () => {
+    const r = settingsPatch.parse({ agency_site: "sunmarketing.com", calendar_url: "", agency_phone: "" });
+    expect(r).toEqual({ agency_site: "https://sunmarketing.com/", calendar_url: null, agency_phone: null });
+  });
+  it("rejects dangerous or invalid values", () => {
+    expect(settingsPatch.safeParse({ calendar_url: "javascript:alert(1)" }).success).toBe(false);
+    expect(settingsPatch.safeParse({ agency_site: "data:text/html,hi" }).success).toBe(false);
+    expect(settingsPatch.safeParse({ accent: "red;background:url(x)" }).success).toBe(false);
+    expect(settingsPatch.safeParse({ agency_email: "nope" }).success).toBe(false);
+    expect(settingsPatch.safeParse({ agency_name: "" }).success).toBe(false);
+  });
+});
+
+describe("rate limiting", () => {
+  it("falls back to a per-instance window when the database is unavailable", async () => {
+    const results = [];
+    for (let i = 0; i < 4; i++) results.push(await takeLimit("test", "1.2.3.4", 3, 60));
+    expect(results).toEqual([true, true, true, false]);
+    expect(await takeLimit("test", "5.6.7.8", 3, 60)).toBe(true);
+  });
+  it("compares secrets safely", () => {
+    expect(sameSecret("Bearer abc", "Bearer abc")).toBe(true);
+    expect(sameSecret("Bearer abd", "Bearer abc")).toBe(false);
+    expect(sameSecret("", "Bearer abc")).toBe(false);
+  });
+});
