@@ -0,0 +1,46 @@
+import "server-only";
+import { createHash, timingSafeEqual } from "crypto";
+import { db } from "./db";
+
+// Client IP as reported by the host's edge (Netlify first, then standard proxies).
+export function clientIp(req: Request) {
+  return (
+    req.headers.get("x-nf-client-connection-ip") ||
+    req.headers.get("x-real-ip") ||
+    req.headers.get("x-forwarded-for")?.split(",")[0]?.trim() ||
+    "unknown"
+  );
+}
+
+const memory = new Map<string, { uses: number; reset: number }>();
+
+function memoryTake(key: string, limit: number, seconds: number) {
+  const now = Date.now();
+  const prior = memory.get(key);
+  const state = !prior || prior.reset <= now ? { uses: 0, reset: now + seconds * 1000 } : prior;
+  state.uses += 1;
+  memory.set(key, state);
+  if (memory.size > 5000) for (const [k, v] of memory) if (v.reset <= now) memory.delete(k);
+  return state.uses <= limit;
+}
+
+// Fixed-window limiter shared by every server instance, backed by the atomic
+// public.studio_take_limit() function. Keys are hashed so IPs and emails are
+// not stored in clear text. Falls back to a per-instance window if the
+// database is unavailable, so limits never silently disappear.
+export async function takeLimit(scope: string, subject: string, limit: number, seconds: number): Promise<boolean> {
+  const key = `${scope}:${createHash("sha256").update(subject).digest("hex").slice(0, 32)}`;
+  const client = db();
+  if (client) {
+    const { data, error } = await client.rpc("studio_take_limit", { p_key: key, p_limit: limit, p_seconds: seconds });
+    if (!error && typeof data === "boolean") return data;
+    console.error("[rate-limit] database limiter unavailable", error?.code);
+  }
+  return memoryTake(key, limit, seconds);
+}
+
+export function sameSecret(a: string, b: string) {
+  const left = createHash("sha256").update(a).digest();
+  const right = createHash("sha256").update(b).digest();
+  return timingSafeEqual(left, right) && a.length === b.length;
+}
