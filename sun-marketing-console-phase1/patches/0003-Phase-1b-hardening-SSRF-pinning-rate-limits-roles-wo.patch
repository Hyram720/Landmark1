+import { z } from "zod";
+
+const optionalText = (max: number) => z.string().trim().max(max).nullable().optional().transform((v) => (v === "" ? null : v));
+// Accepts "example.com" or full http(s) links; rejects other schemes (javascript:, data:, …).
+const optionalUrl = z
+  .string()
+  .trim()
+  .max(500)
+  .nullable()
+  .optional()
+  .transform((v, ctx) => {
+    if (!v) return v === undefined ? undefined : null;
+    const withScheme = /^[a-z][a-z0-9+.-]*:/i.test(v) ? v : `https://${v}`;
+    try {
+      const url = new URL(withScheme);
+      if (url.protocol === "http:" || url.protocol === "https:") return url.toString();
+    } catch {
+      /* reported below */
+    }
+    ctx.addIssue({ code: "custom", message: "Enter a valid web address." });
+    return z.NEVER;
+  });
+
+// Only these columns can be changed (no mass assignment).
+export const settingsPatch = z.object({
+  agency_name: z.string().trim().min(1).max(120).optional(),
+  agency_tagline: z.string().trim().max(200).optional(),
+  agency_phone: optionalText(40),
+  agency_email: z.string().trim().max(254).refine((v) => v === "" || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v), "Enter a valid email address").nullable().optional().transform((v) => (v === "" ? null : v)),
+  agency_site: optionalUrl,
+  accent: z.string().regex(/^#[0-9a-fA-F]{6}$/, "Accent must be a hex color like #ff8112").optional(),
+  calendar_url: optionalUrl,
+  default_city: optionalText(100),
+}).strip();
