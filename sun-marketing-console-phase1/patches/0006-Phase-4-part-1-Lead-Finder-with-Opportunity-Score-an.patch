+-- Phase 4 security tests: Lead Finder prospects and outreach.
+-- Run with scripts/test-db.sh.
+\set ON_ERROR_STOP 1
+set client_min_messages = notice;
+
+create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', json_build_object('sub', p_uid, 'role', 'authenticated')::text, false);
+  execute 'set role authenticated';
+end $$;
+create or replace function pg_temp.as_service() returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claims', '{"role":"service_role"}', false);
+  execute 'set role service_role';
+end $$;
+create or replace function pg_temp.reset_user() returns void language plpgsql as $$
+begin
+  execute 'reset role';
+  perform set_config('request.jwt.claims', '', false);
+end $$;
+create or replace function pg_temp.expect_error(p_sql text, p_label text) returns void language plpgsql as $$
+begin
+  begin execute p_sql; exception when others then raise notice 'ok   (denied) %', p_label; return; end;
+  raise exception 'FAIL expected an error: %', p_label;
+end $$;
+create or replace function pg_temp.expect(p_ok boolean, p_label text) returns void language plpgsql as $$
+begin
+  if not coalesce(p_ok, false) then raise exception 'FAIL %', p_label; end if;
+  raise notice 'ok   %', p_label;
+end $$;
+
+-- Users: 1 = owner of agency X (staff), 2 = member of X, 3 = manager of X, 4 = owner of agency Y (staff)
+insert into auth.users values
+  ('40000000-0000-0000-0000-000000000001', 'owner@p4x.test'), ('40000000-0000-0000-0000-000000000002', 'member@p4x.test'),
+  ('40000000-0000-0000-0000-000000000003', 'manager@p4x.test'), ('40000000-0000-0000-0000-000000000004', 'owner@p4y.test');
+insert into public.team_members(user_id, email, active) values
+  ('40000000-0000-0000-0000-000000000001', 'owner@p4x.test', true), ('40000000-0000-0000-0000-000000000004', 'owner@p4y.test', true);
+create temp table ids (k text primary key, v uuid);
+grant all on ids to authenticated, service_role;
+
+select pg_temp.as_user('40000000-0000-0000-0000-000000000001');
+insert into ids select 'x', public.create_organization('Agency P4X', 'agency');
+select public.add_member_by_email((select v from ids where k = 'x'), 'member@p4x.test', 'member');
+select public.add_member_by_email((select v from ids where k = 'x'), 'manager@p4x.test', 'manager');
+select pg_temp.reset_user();
+select pg_temp.as_user('40000000-0000-0000-0000-000000000004');
+insert into ids select 'y', public.create_organization('Agency P4Y', 'agency');
+select pg_temp.reset_user();
+
+-- 1. Prospects are private to the organization
+select pg_temp.as_user('40000000-0000-0000-0000-000000000002');
+with p as (insert into public.prospects(organization_id, source, source_ref, name, website, business_email)
+  values ((select v from ids where k = 'x'), 'openstreetmap', 'node/1', 'Ace Plumbing', 'https://aceplumbing.test', 'office@aceplumbing.test') returning id)
+insert into ids select 'ace', id from p;
+select pg_temp.expect_error($$insert into public.prospects(organization_id, source, source_ref, name) values ((select v from ids where k = 'x'), 'openstreetmap', 'node/1', 'Dup')$$,
+  'a directory listing is saved once per organization');
+select pg_temp.expect_error($$insert into public.prospects(organization_id, source, name, website) values ((select v from ids where k = 'x'), 'manual', 'Bad', 'javascript:alert(1)')$$,
+  'prospect websites must be http(s)');
+select pg_temp.reset_user();
+select pg_temp.as_user('40000000-0000-0000-0000-000000000004');
+select pg_temp.expect((select count(*) = 0 from public.prospects), 'other tenants cannot see prospects');
+insert into public.prospects(organization_id, source, source_ref, name) values ((select v from ids where k = 'y'), 'openstreetmap', 'node/1', 'Ace Plumbing (Y copy)');
+select pg_temp.expect(true, 'another organization can save the same listing');
+select pg_temp.expect_error($$insert into public.outreach_messages(organization_id, prospect_id, to_address, subject, body)
+  values ((select v from ids where k = 'y'), (select v from ids where k = 'ace'), 'office@aceplumbing.test', 'Hi', 'Hello')$$,
+  'outreach cannot target another tenant''s prospect');
+select pg_temp.reset_user();
+
+-- 2. Outreach lifecycle
+select pg_temp.as_user('40000000-0000-0000-0000-000000000002');
+select pg_temp.expect_error($$insert into public.outreach_messages(organization_id, prospect_id, to_address, subject, body, status)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'ace'), 'office@aceplumbing.test', 'Hi', 'Hello', 'sent')$$,
+  'outreach cannot be created as already sent');
+with m as (insert into public.outreach_messages(organization_id, prospect_id, to_address, subject, body)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'ace'), 'office@aceplumbing.test', 'Website idea for Ace', 'Hello Ace team') returning id)
+insert into ids select 'm1', id from m;
+select pg_temp.expect_error($$select unsubscribe_token from public.outreach_messages$$, 'staff cannot read unsubscribe tokens');
+select pg_temp.expect_error($$select public.outreach_unsubscribe_token((select v from ids where k = 'm1'))$$, 'the token is unavailable before sending');
+update public.outreach_messages set body = 'Hello Ace team, edited' where id = (select v from ids where k = 'm1');
+update public.outreach_messages set status = 'sending' where id = (select v from ids where k = 'm1');
+select pg_temp.expect((select length(public.outreach_unsubscribe_token((select v from ids where k = 'm1'))) = 36), 'the sender gets the token while sending');
+select pg_temp.reset_user();
+select pg_temp.as_user('40000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$select public.outreach_unsubscribe_token((select v from ids where k = 'm1'))$$, 'other people cannot get the token');
+select pg_temp.expect_error($$update public.outreach_messages set status = 'sent' where id = (select v from ids where k = 'm1')$$, 'only the sender records the result');
+select pg_temp.reset_user();
+select pg_temp.as_user('40000000-0000-0000-0000-000000000002');
+update public.outreach_messages set status = 'sent', provider = 'resend', provider_message_id = 'em-1' where id = (select v from ids where k = 'm1');
+select pg_temp.expect((select status = 'sent' and sent_at is not null and sent_by = '40000000-0000-0000-0000-000000000002' from public.outreach_messages where id = (select v from ids where k = 'm1')),
+  'sent outreach records sender and time');
+select pg_temp.expect_error($$update public.outreach_messages set body = 'rewritten history' where id = (select v from ids where k = 'm1')$$, 'sent outreach cannot be edited');
+with m as (insert into public.outreach_messages(organization_id, prospect_id, to_address, subject, body)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'ace'), 'office@aceplumbing.test', 'Follow-up', 'Following up') returning id)
+insert into ids select 'm2', id from m;
+select pg_temp.reset_user();
+
+-- 3. Unsubscribe
+select pg_temp.expect_error($$select public.outreach_unsubscribe('nope')$$, 'unknown unsubscribe tokens are rejected');
+select pg_temp.as_user('40000000-0000-0000-0000-000000000002');
+select pg_temp.expect_error($$select public.outreach_unsubscribe('x')$$, 'signed-in users cannot call the unsubscribe function');
+select pg_temp.reset_user();
+select pg_temp.as_service();
+select public.outreach_unsubscribe((select unsubscribe_token from public.outreach_messages where id = (select v from ids where k = 'm1')));
+select pg_temp.reset_user();
+select pg_temp.expect((select do_not_contact and status = 'disqualified' from public.prospects where id = (select v from ids where k = 'ace')), 'unsubscribing flags the prospect');
+select pg_temp.expect((select count(*) = 1 from public.suppressions where organization_id = (select v from ids where k = 'x') and address = 'office@aceplumbing.test'),
+  'unsubscribing suppresses the address for the whole organization');
+select pg_temp.expect((select status = 'cancelled' from public.outreach_messages where id = (select v from ids where k = 'm2')), 'pending drafts are cancelled');
+select pg_temp.as_user('40000000-0000-0000-0000-000000000002');
+with m as (insert into public.outreach_messages(organization_id, prospect_id, to_address, subject, body)
+  values ((select v from ids where k = 'x'), (select v from ids where k = 'ace'), 'office@aceplumbing.test', 'Again', 'Again') returning id)
+insert into ids select 'm3', id from m;
+select pg_temp.expect_error($$update public.outreach_messages set status = 'sending' where id = (select v from ids where k = 'm3')$$, 'unsubscribed businesses cannot be emailed');
+select pg_temp.expect_error($$update public.prospects set do_not_contact = false where id = (select v from ids where k = 'ace')$$, 'members cannot clear do-not-contact');
+delete from public.prospects where id = (select v from ids where k = 'ace');
+select pg_temp.expect((select count(*) = 1 from public.prospects where id = (select v from ids where k = 'ace')), 'members cannot delete prospects');
+select pg_temp.reset_user();
+
+\echo 'ALL PHASE 4 TESTS PASSED'
