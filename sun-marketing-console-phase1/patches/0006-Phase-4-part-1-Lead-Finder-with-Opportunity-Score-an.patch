+++ b/tests/unit/phase4-leads.test.ts
@@ -0,0 +1,131 @@
+import { describe, expect, it } from "vitest";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { FakeDb } from "../support/fake-supabase";
+import { opportunityScore, topFinding, type ProspectSignals } from "@/lib/leads/score";
+import { businessEmails, domainOf } from "@/lib/leads/emails";
+import { auditProspect, draftOutreach, outreachFooter, outreachPreflight, queueAudits } from "@/lib/leads/service";
+import type { AuditResult } from "@/lib/audit-types";
+
+const ORG = "11111111-1111-4111-8111-111111111111";
+const USER = "22222222-2222-4222-8222-222222222222";
+const P = "33333333-3333-4333-8333-333333333333";
+
+const base: ProspectSignals = { website: null, audited: false, website_score: null, mobile_score: null, speed_score: null, seo_score: null, ssl_ok: null, has_booking: null, has_chat: null, rating: null, review_count: null, has_brand: false, business_email: null };
+
+describe("opportunity score", () => {
+  it("rates a business with no website highly and explains why", () => {
+    const r = opportunityScore(base);
+    expect(r.score).toBe(55);
+    expect(r.factors.find((f) => f.key === "no_website")!.points).toBe(50);
+    expect(r.factors.find((f) => f.key === "reputation")!.detail).toMatch(/not verified/);
+    expect(r.readiness[0]).toMatch(/No business email/);
+    expect(topFinding(r.factors)).toMatch(/does not include a website/);
+  });
+  it("does not guess before an audit, then scores the measured gaps", () => {
+    expect(opportunityScore({ ...base, website: "https://a.test" }).score).toBe(5);
+    const weak = opportunityScore({ ...base, website: "https://a.test", audited: true, website_score: 40, mobile_score: 30, speed_score: 50, seo_score: 60, ssl_ok: false, has_booking: false, has_chat: false, rating: 3.8, review_count: 9 });
+    const strong = opportunityScore({ ...base, website: "https://a.test", audited: true, website_score: 95, mobile_score: 95, speed_score: 90, seo_score: 92, ssl_ok: true, has_booking: true, has_chat: true, rating: 4.8, review_count: 230, has_brand: true });
+    expect(weak.score).toBeGreaterThan(60);
+    expect(strong.score).toBeLessThan(5);
+    expect(weak.score).toBeLessThanOrEqual(100);
+    for (const f of weak.factors) expect(f.points).toBeLessThanOrEqual(f.max);
+    expect(topFinding(weak.factors)).toMatch(/website|secure|book/);
+  });
+});
+
+describe("business email selection", () => {
+  it("keeps addresses on the business's domain, drops freemail and junk, prefers role addresses", () => {
+    const picked = businessEmails([
+      { email: "joe.smith@gmail.com", source_url: "u" }, { email: "jane@acmeroof.com", source_url: "u" }, { email: "INFO@AcmeRoof.com", source_url: "u" },
+      { email: "noreply@acmeroof.com", source_url: "u" }, { email: "logo@2x.png", source_url: "u" }, { email: "billing@othervendor.com", source_url: "u" },
+      { email: "info@acmeroof.com", source_url: "dup" },
+    ], domainOf("https://www.acmeroof.com/contact"));
+    expect(picked.map((e) => e.email)).toEqual(["info@acmeroof.com", "jane@acmeroof.com", "billing@othervendor.com"]);
+  });
+});
+
+describe("outreach rules", () => {
+  const ok = { settingsConfigured: true, hasAccount: true, vault: true, baseUrl: "https://x.test", to: "info@acme.test", doNotContact: false, sentToday: 0, dailyLimit: 40, history: [] as Date[], now: new Date("2030-01-10T12:00:00Z") };
+  it("allows a first business email when everything is set up", () => expect(outreachPreflight(ok)).toEqual({ ok: true }));
+  it.each([
+    [{ settingsConfigured: false }, "integration_not_configured"],
+    [{ hasAccount: false }, "integration_not_configured"],
+    [{ baseUrl: null }, "integration_not_configured"],
