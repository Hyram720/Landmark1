diff --git a/supabase/migrations/20261009120000_phase4_lead_engine.sql b/supabase/migrations/20261009120000_phase4_lead_engine.sql
new file mode 100644
index 0000000..502f33f
--- /dev/null
+++ b/supabase/migrations/20261009120000_phase4_lead_engine.sql
@@ -0,0 +1,264 @@
+-- Phase 4: lead generation engine (Lead Finder).
+--
+--   * prospects: businesses found in public directories or added by hand,
+--     private to each organization, with website audit results, an explained
+--     Opportunity Score and business emails found on the business's own site.
+--   * prospect_audits: audit history per prospect.
+--   * outreach_messages: one-to-one business email to prospects. Drafts are
+--     edited freely; sending is claimed by the sender and recorded forever.
+--     Every message carries an unsubscribe token; unsubscribing adds the
+--     address to the organization's suppression list (shared with the CRM)
+--     and flags the prospect do-not-contact. Only email: there is no path for
+--     cold texts or calls to prospects.
+begin;
+
+create table public.prospect_searches (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  category text not null check (length(category) between 1 and 80),
+  location text not null check (length(location) between 1 and 100),
+  source text not null default 'openstreetmap',
+  result_count integer not null default 0,
+  created_by uuid,
+  created_at timestamptz not null default now()
+);
+create index prospect_searches_org_idx on public.prospect_searches(organization_id, created_at desc);
+
+create table public.prospects (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  source text not null check (source in ('openstreetmap', 'manual', 'import')),
+  source_ref text check (length(source_ref) <= 200),
+  name text not null check (length(btrim(name)) between 1 and 160),
+  category text check (length(category) <= 80),
+  address text check (length(address) <= 300),
+  city text check (length(city) <= 100),
+  phone text check (length(phone) <= 40),
+  website text check (website is null or (length(website) <= 500 and website ~* '^https?://')),
+  website_domain text check (length(website_domain) <= 253),
+  has_brand boolean not null default false,
+  rating numeric(2, 1) check (rating between 0 and 5),
+  review_count integer check (review_count >= 0),
+  status text not null default 'new' check (status in ('new', 'qualified', 'contacted', 'replied', 'converted', 'disqualified')),
+  opportunity_score integer not null default 0 check (opportunity_score between 0 and 100),
+  score_factors jsonb not null default '[]'::jsonb check (jsonb_typeof(score_factors) = 'array'),
+  scored_at timestamptz,
+  audit_status text not null default 'none' check (audit_status in ('none', 'queued', 'running', 'done', 'failed')),
+  audit_error text check (length(audit_error) <= 500),
+  audited_at timestamptz,
+  website_score integer check (website_score between 0 and 100),
+  website_grade text check (length(website_grade) <= 4),
+  mobile_score integer check (mobile_score between 0 and 100),
+  speed_score integer check (speed_score between 0 and 100),
+  seo_score integer check (seo_score between 0 and 100),
+  ssl_ok boolean,
+  has_booking boolean,
+  has_chat boolean,
+  -- Addresses found on the business's own website, with where they were seen.
+  emails jsonb not null default '[]'::jsonb check (jsonb_typeof(emails) = 'array'),
+  business_email text check (business_email is null or (length(business_email) <= 254 and business_email ~ '^[^@\s]+@[^@\s]+\.[^@\s]+$')),
+  do_not_contact boolean not null default false,
+  tags text[] not null default '{}',
+  notes text check (length(notes) <= 4000),
+  company_id uuid,
+  contact_id uuid,
+  search_id uuid references public.prospect_searches(id) on delete set null,
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  foreign key (company_id, organization_id) references public.companies(id, organization_id) on delete set null (company_id),
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete set null (contact_id)
+);
+create unique index prospects_source_ref on public.prospects(organization_id, source, source_ref) where source_ref is not null;
+create index prospects_org_score_idx on public.prospects(organization_id, opportunity_score desc);
+create index prospects_org_status_idx on public.prospects(organization_id, status);
+create index prospects_audit_queue_idx on public.prospects(audited_at) where audit_status = 'queued';
+create trigger prospects_updated before update on public.prospects
+  for each row execute function public.tg_set_updated_at();
+
+-- Opting out is permanent from the API's point of view: once a prospect is
+-- do-not-contact, only an admin can clear it.
+create or replace function public.tg_prospects_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    new.created_by := auth.uid();
+    return new;
+  end if;
+  if new.organization_id <> old.organization_id then
+    raise exception 'Prospect organization is immutable.' using errcode = '42501';
+  end if;
+  if old.do_not_contact and not new.do_not_contact and public.org_rank(new.organization_id) < 4 then
+    raise exception 'Only admins can clear do-not-contact.' using errcode = '42501';
+  end if;
+  return new;
+end $$;
+create trigger prospects_guard before insert or update on public.prospects
+  for each row execute function public.tg_prospects_guard();
+
+create table public.prospect_audits (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  prospect_id uuid not null,
+  url text not null check (length(url) <= 500),
+  ok boolean not null,
+  overall integer check (overall between 0 and 100),
+  grade text check (length(grade) <= 4),
+  categories jsonb not null default '[]'::jsonb,
+  findings jsonb not null default '[]'::jsonb,
+  error text check (length(error) <= 500),
+  created_at timestamptz not null default now(),
+  foreign key (prospect_id, organization_id) references public.prospects(id, organization_id) on delete cascade
+);
+create index prospect_audits_prospect_idx on public.prospect_audits(prospect_id, created_at desc);
+
+create table public.outreach_messages (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  prospect_id uuid not null,
+  to_address text not null check (length(to_address) <= 254 and to_address ~ '^[^@\s]+@[^@\s]+\.[^@\s]+$'),
+  subject text not null check (length(btrim(subject)) between 1 and 200),
+  body text not null check (length(btrim(body)) between 1 and 10000),
+  status text not null default 'draft' check (status in ('draft', 'sending', 'sent', 'failed', 'cancelled')),
+  ai_generated boolean not null default false,
+  provider text,
+  provider_account_id uuid,
+  provider_message_id text,
+  from_address text,
+  error text check (length(error) <= 1000),
+  unsubscribe_token text not null unique default encode(extensions.gen_random_bytes(18), 'hex'),
+  created_by uuid,
+  sent_by uuid,
+  sent_at timestamptz,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  foreign key (prospect_id, organization_id) references public.prospects(id, organization_id) on delete cascade,
+  foreign key (provider_account_id, organization_id) references public.provider_accounts(id, organization_id) on delete set null (provider_account_id)
+);
+create index outreach_messages_prospect_idx on public.outreach_messages(prospect_id, created_at desc);
+create index outreach_messages_org_sent_idx on public.outreach_messages(organization_id, sent_at desc) where status = 'sent';
+create trigger outreach_messages_updated before update on public.outreach_messages
+  for each row execute function public.tg_set_updated_at();
+
+-- Drafts are editable; a send is claimed (draft -> sending) by the person
+-- sending it, after the database re-checks do-not-contact and the
+-- suppression list; the record is then frozen.
+create or replace function public.tg_outreach_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then
+    if new.status <> 'draft' then raise exception 'Outreach starts as a draft.' using errcode = '42501'; end if;
+    new.created_by := auth.uid(); new.sent_by := null; new.sent_at := null; new.provider_message_id := null;
+    new.unsubscribe_token := encode(extensions.gen_random_bytes(18), 'hex');
+    return new;
+  end if;
+  if new.organization_id <> old.organization_id or new.prospect_id <> old.prospect_id or new.unsubscribe_token <> old.unsubscribe_token
+     or new.created_by is distinct from old.created_by then
+    raise exception 'Outreach identity is immutable.' using errcode = '42501';
+  end if;
+  if old.status <> 'draft' and (new.subject <> old.subject or new.body <> old.body or new.to_address <> old.to_address) then
+    raise exception 'Sent outreach cannot be edited.' using errcode = '42501';
+  end if;
+  if new.status = old.status then return new; end if;
+  if old.status = 'draft' and new.status = 'sending' then
+    if exists (select 1 from public.prospects p where p.id = new.prospect_id and p.do_not_contact) then
+      raise exception 'This business asked not to be contacted.' using errcode = '42501';
+    end if;
+    if exists (select 1 from public.suppressions s where s.organization_id = new.organization_id and s.channel = 'email' and s.address = lower(new.to_address)) then
+      raise exception 'This address has unsubscribed.' using errcode = '42501';
+    end if;
+    new.sent_by := auth.uid();
+  elsif old.status = 'sending' and new.status in ('sent', 'failed') then
+    if old.sent_by is distinct from auth.uid() then raise exception 'Only the sender records the result.' using errcode = '42501'; end if;
+    if new.status = 'sent' then new.sent_at := now(); end if;
+  elsif old.status = 'draft' and new.status = 'cancelled' then
+    null;
+  else
+    raise exception 'Invalid outreach transition % -> %.', old.status, new.status using errcode = '42501';
+  end if;
+  return new;
+end $$;
+create trigger outreach_messages_guard before insert or update on public.outreach_messages
+  for each row execute function public.tg_outreach_guard();
+
+-- One-click unsubscribe from an outreach email (public page, service role only).
+create or replace function public.outreach_unsubscribe(p_token text) returns jsonb
+language plpgsql security definer set search_path = '' as $$
+declare m public.outreach_messages; v_contact uuid;
+begin
+  select * into m from public.outreach_messages where unsubscribe_token = p_token;
+  if not found then raise exception 'This link is not valid.' using errcode = 'P0002'; end if;
+  select contact_id into v_contact from public.prospects where id = m.prospect_id;
+  if v_contact is not null then
+    perform public.apply_opt_out(m.organization_id, v_contact, 'email', m.to_address, 'Outreach unsubscribe link');
+  else
+    insert into public.suppressions(organization_id, channel, address, reason, source)
+    values (m.organization_id, 'email', lower(btrim(m.to_address)), 'opt_out', 'Outreach unsubscribe link')
+    on conflict (organization_id, channel, address) do nothing;
+    insert into public.audit_log(organization_id, actor_type, action, target_type, target_id, metadata)
+    values (m.organization_id, 'system', 'outreach.unsubscribed', 'prospect', m.prospect_id::text, '{}'::jsonb);
+  end if;
+  update public.prospects set do_not_contact = true,
+         status = case when status in ('new', 'qualified', 'contacted') then 'disqualified' else status end
+   where id = m.prospect_id;
+  update public.outreach_messages set status = 'cancelled' where prospect_id = m.prospect_id and status = 'draft';
+  return jsonb_build_object('business', (select name from public.organizations where id = m.organization_id));
+end $$;
+
+-- The sender gets the unsubscribe token only while their own send is in flight,
+-- to put the link in that one email.
+create or replace function public.outreach_unsubscribe_token(p_message uuid) returns text
+language plpgsql stable security definer set search_path = '' as $$
+declare m public.outreach_messages;
+begin
+  select * into m from public.outreach_messages where id = p_message;
+  if not found or public.org_rank(m.organization_id) < 2 or m.status <> 'sending' or m.sent_by is distinct from auth.uid() then
+    raise exception 'Not available.' using errcode = '42501';
+  end if;
+  return m.unsubscribe_token;
+end $$;
+
+-- --------------------------------------------------------------------- RLS
+alter table public.prospect_searches enable row level security;
+alter table public.prospects enable row level security;
+alter table public.prospect_audits enable row level security;
+alter table public.outreach_messages enable row level security;
+
+create policy prospect_searches_read on public.prospect_searches for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy prospect_searches_insert on public.prospect_searches for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy prospect_searches_update on public.prospect_searches for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+
+create policy prospects_read on public.prospects for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy prospects_insert on public.prospects for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy prospects_update on public.prospects for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+create policy prospects_delete on public.prospects for delete to authenticated using (public.org_rank(organization_id) >= 3);
+
+create policy prospect_audits_read on public.prospect_audits for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy prospect_audits_insert on public.prospect_audits for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+
+create policy outreach_read on public.outreach_messages for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy outreach_insert on public.outreach_messages for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+create policy outreach_update on public.outreach_messages for update to authenticated
+  using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+
+revoke all on public.prospect_searches, public.prospects, public.prospect_audits, public.outreach_messages from anon, authenticated;
+grant all on public.prospect_searches, public.prospects, public.prospect_audits, public.outreach_messages to service_role;
+grant select, insert, update on public.prospect_searches, public.outreach_messages to authenticated;
+grant select, insert, update, delete on public.prospects to authenticated;
+grant select, insert on public.prospect_audits to authenticated;
+-- The unsubscribe token is a capability for the recipient; staff never need it.
+revoke select on public.outreach_messages from authenticated;
+grant select (id, organization_id, prospect_id, to_address, subject, body, status, ai_generated, provider, provider_account_id, provider_message_id,
+  from_address, error, created_by, sent_by, sent_at, created_at, updated_at) on public.outreach_messages to authenticated;
+
+revoke execute on function public.outreach_unsubscribe(text) from public, anon, authenticated;
+grant execute on function public.outreach_unsubscribe(text) to service_role;
+revoke execute on function public.outreach_unsubscribe_token(uuid) from public, anon;
+grant execute on function public.outreach_unsubscribe_token(uuid) to authenticated, service_role;
+
+commit;
diff --git a/supabase/tests/phase4_leads.test.sql b/supabase/tests/phase4_leads.test.sql
new file mode 100644
index 0000000..5cc88eb
