@@ -0,0 +1,125 @@
+import "server-only";
+
+// Free public business directory search (OpenStreetMap via Nominatim, with an
+// Overpass fallback). Shared by the legacy Opportunity Radar and the
+// multi-tenant Lead Finder. Only fixed, well-known hosts are contacted.
+export const ALLOWED_CATEGORIES = new Set(["plumber", "electrician", "roofer", "hvac", "landscaper", "contractor", "handyman", "painter", "flooring contractor", "fence contractor", "garage door service", "appliance repair", "locksmith", "pest control", "pressure washing", "tree service", "pool service", "cleaning service", "moving company", "auto repair", "auto body shop", "towing service", "car detailing", "tire shop", "restaurant", "bakery", "coffee shop", "caterer", "food truck", "barber", "salon", "nail salon", "spa", "massage therapist", "chiropractor", "dentist", "physical therapist", "fitness studio", "daycare", "preschool", "tutoring service", "dance studio", "martial arts school", "pet groomer", "veterinarian", "funeral home", "accountant", "tax preparation", "bookkeeper", "notary", "insurance agency", "real estate attorney", "photographer", "event planner", "travel agency", "florist", "laundromat", "dry cleaner", "tailor", "computer repair", "phone repair", "print shop", "sign shop", "custom"]);
+const OSM_FILTERS: Record<string, string[]> = {
+  plumber: ['["craft"="plumber"]'], electrician: ['["craft"="electrician"]'], roofer: ['["craft"="roofer"]'],
+  hvac: ['["craft"="hvac"]', '["craft"="heating_engineer"]'], landscaper: ['["craft"="landscaper"]', '["craft"="gardener"]'],
+  dentist: ['["amenity"="dentist"]'], chiropractor: ['["healthcare"="chiropractor"]'], restaurant: ['["amenity"="restaurant"]'],
+  barber: ['["shop"="hairdresser"]'], salon: ['["shop"="beauty"]', '["shop"="hairdresser"]'], "auto repair": ['["shop"="car_repair"]'],
+  contractor: ['["craft"="builder"]', '["office"="construction_company"]'], "cleaning service": ['["craft"="cleaning"]'],
+  "funeral home": ['["shop"="funeral_directors"]', '["amenity"="funeral_hall"]'], "real estate attorney": ['["office"="lawyer"]["lawyer"="real_estate"]'],
+  "insurance agency": ['["office"="insurance"]'],
+  handyman: ['["craft"="handyman"]'], painter: ['["craft"="painter"]'], "flooring contractor": ['["craft"="floorer"]'],
+  "fence contractor": ['["craft"="fence_maker"]'], "garage door service": ['["craft"="garage_door"]'], "appliance repair": ['["craft"="appliance_repair"]'],
+  locksmith: ['["craft"="locksmith"]'], "pest control": ['["craft"="pest_control"]'], "pressure washing": ['["craft"="cleaning"]'],
+  "tree service": ['["craft"="arborist"]'], "pool service": ['["craft"="swimming_pool"]'], "moving company": ['["office"="moving_company"]'],
+  "auto body shop": ['["shop"="car_repair"]["service:vehicle:body_repair"="yes"]', '["shop"="car_repair"]["service:vehicle:painting"="yes"]'],
+  "towing service": ['["amenity"="vehicle_inspection"]', '["craft"="towing"]'], "car detailing": ['["shop"="car_repair"]["service:vehicle:car_wash"="yes"]', '["amenity"="car_wash"]'],
+  "tire shop": ['["shop"="tyres"]'], bakery: ['["shop"="bakery"]'], "coffee shop": ['["amenity"="cafe"]'], caterer: ['["craft"="caterer"]'], "food truck": ['["amenity"="fast_food"]["takeaway"="yes"]'],
+  "nail salon": ['["shop"="beauty"]["beauty"="nails"]'], spa: ['["leisure"="spa"]', '["shop"="beauty"]["beauty"="spa"]'],
+  "massage therapist": ['["shop"="massage"]', '["healthcare"="alternative"]["healthcare:speciality"="massage_therapy"]'],
+  "physical therapist": ['["healthcare"="physiotherapist"]'], "fitness studio": ['["leisure"="fitness_centre"]'],
+  daycare: ['["amenity"="childcare"]'], preschool: ['["amenity"="kindergarten"]'], "tutoring service": ['["office"="educational_institution"]'],
+  "dance studio": ['["leisure"="dance"]'], "martial arts school": ['["leisure"="sports_centre"]["sport"="martial_arts"]'],
+  "pet groomer": ['["shop"="pet_grooming"]'], veterinarian: ['["amenity"="veterinary"]'], accountant: ['["office"="accountant"]'],
+  "tax preparation": ['["office"="tax_advisor"]'], bookkeeper: ['["office"="accountant"]'], notary: ['["office"="notary"]'],
+  photographer: ['["craft"="photographer"]'], "event planner": ['["office"="event_management"]'], "travel agency": ['["shop"="travel_agency"]'],
+  florist: ['["shop"="florist"]'], laundromat: ['["shop"="laundry"]["self_service"="yes"]'], "dry cleaner": ['["shop"="dry_cleaning"]'],
+  tailor: ['["craft"="tailor"]'], "computer repair": ['["shop"="computer"]', '["craft"="electronics_repair"]'], "phone repair": ['["shop"="mobile_phone"]'],
+  "print shop": ['["shop"="copyshop"]'], "sign shop": ['["craft"="signmaker"]'],
+};
+type OsmElement = { id: number; type: "node" | "way" | "relation"; tags?: Record<string, string> };
+type NominatimResult = { osm_id: number; osm_type: "node" | "way" | "relation"; name?: string; display_name: string; extratags?: Record<string, string>; namedetails?: Record<string, string> };
+const DIRECTORY_SERVERS = ["https://overpass-api.de/api/interpreter", "https://overpass.kumi.systems/api/interpreter"];
+
+function escapeRegex(value: string) { return value.replace(/[\\^$.*+?()[\]{}|]/g, "\\$&").replace(/[\"\n\r]/g, ""); }
+function address(tags: Record<string, string>) {
+  const street = [tags["addr:housenumber"], tags["addr:street"]].filter(Boolean).join(" ");
+  return [street, tags["addr:city"], tags["addr:state"], tags["addr:postcode"]].filter(Boolean).join(", ") || null;
+}
+async function locate(city: string) {
+  const url = new URL("https://nominatim.openstreetmap.org/search");
+  url.searchParams.set("q", city); url.searchParams.set("format", "jsonv2"); url.searchParams.set("limit", "1"); url.searchParams.set("countrycodes", "us");
+  const response = await fetch(url, { headers: { "User-Agent": "SunMarketingOpportunityFinder/1.0 (sun-marketing-console.netlify.app)" }, signal: AbortSignal.timeout(12000) });
+  if (!response.ok) throw new Error("The free location service is temporarily unavailable. Please try again shortly.");
+  const rows = await response.json();
+  if (!rows[0]) throw new Error("That city or service area could not be located. Try adding the state abbreviation.");
+  return { lat: Number(rows[0].lat), lon: Number(rows[0].lon) };
+}
+
+async function lightweightSearch(category: string, city: string, preferIndependent: boolean) {
+  const url = new URL("https://nominatim.openstreetmap.org/search");
+  url.searchParams.set("q", `${category}, ${city}`);
+  url.searchParams.set("format", "jsonv2"); url.searchParams.set("limit", "30"); url.searchParams.set("countrycodes", "us");
+  url.searchParams.set("addressdetails", "1"); url.searchParams.set("extratags", "1"); url.searchParams.set("namedetails", "1");
+  const response = await fetch(url, { headers: { "User-Agent": "SunMarketingOpportunityFinder/1.0 (sun-marketing-console.netlify.app)" }, signal: AbortSignal.timeout(15000) });
+  if (!response.ok) return [];
+  const results = await response.json() as NominatimResult[];
+  return results.flatMap((result) => {
+    const tags = result.extratags || {};
+    const name = result.name || result.namedetails?.name;
+    if (!name) return [];
+    const rawWebsite = tags.website || tags["contact:website"] || null;
+    const website = rawWebsite && !/^https?:\/\//i.test(rawWebsite) ? `https://${rawWebsite}` : rawWebsite;
+    const hasBrand = Boolean(tags.brand || tags["brand:wikidata"] || tags["operator:wikidata"]);
+    const independentPriority = preferIndependent && !hasBrand ? 8 : 0;
+    const initialSignals = website ? ["Website found — run quality scan"] : ["No website listed", "High-value website opportunity"];
+    if (preferIndependent && !hasBrand) initialSignals.push("No chain-brand indicator listed — verify ownership");
+    return [{ placeId: `osm-${result.osm_type}-${result.osm_id}`, name, address: result.display_name || null, phone: tags.phone || tags["contact:phone"] || null, website, rating: null, reviews: null, mapsUrl: `https://www.openstreetmap.org/${result.osm_type}/${result.osm_id}`, industry: category, source: "OpenStreetMap", initialOpportunity: Math.min(100, (website ? 35 : 92) + independentPriority), initialSignals, hasBrand }];
+  });
+}
+
+
+export type DirectoryRow = {
+  placeId: string; name: string; address: string | null; phone: string | null; website: string | null; rating: null; reviews: null;
+  mapsUrl: string; industry: string; source: string; initialOpportunity: number; initialSignals: string[]; hasBrand: boolean;
+};
+
+export class DirectoryInputError extends Error {}
+
+// Throws DirectoryInputError for bad input; other errors mean the free
+// directory is unavailable.
+export async function searchDirectory(input: { city: string; category: string; customCategory?: string; preferIndependent?: boolean }): Promise<{ rows: DirectoryRow[]; query: string; source: string }> {
+  const city = String(input.city || "").trim().slice(0, 100);
+  const requested = String(input.category || "").trim().toLowerCase().slice(0, 80);
+  const custom = String(input.customCategory || "").trim().toLowerCase().slice(0, 80);
+  const category = requested === "custom" ? custom : requested;
+  const preferIndependent = input.preferIndependent !== false;
+  if (!city || !category || !ALLOWED_CATEGORIES.has(requested)) throw new DirectoryInputError("Choose a business category and enter a city.");
+
+    const lightweightRows = await lightweightSearch(category, city, preferIndependent);
+    if (lightweightRows.length) {
+      lightweightRows.sort((a, b) => (preferIndependent ? Number(a.hasBrand) - Number(b.hasBrand) : 0) || b.initialOpportunity - a.initialOpportunity);
+      return { rows: lightweightRows, query: `${category} in ${city}`, source: "OpenStreetMap" };
+    }
+    const { lat, lon } = await locate(city);
+    const filters = requested === "custom" ? [`["name"~"${escapeRegex(custom)}",i]`] : OSM_FILTERS[requested] || [];
+    const statements = filters.flatMap((filter) => ["node", "way", "relation"].map((type) => `${type}${filter}(around:20000,${lat},${lon});`)).join("\n");
+    const query = `[out:json][timeout:25];(${statements});out tags center 60;`;
+    let elements: OsmElement[] = [];
+    for (const endpoint of DIRECTORY_SERVERS) {
+      try {
+        const response = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded", "User-Agent": "SunMarketingConsole/1.0", "Accept": "application/json" }, body: new URLSearchParams({ data: query }), signal: AbortSignal.timeout(18000) });
+        if (!response.ok) continue;
+        const payload = await response.json(); elements = payload.elements || [];
+        break;
+      } catch { continue; }
+    }
+    const seen = new Set<string>();
+    const rows = elements.flatMap((element) => {
+      const tags = element.tags || {}; const name = tags.name?.trim(); if (!name) return [];
+      const unique = `${name.toLowerCase()}|${tags["addr:street"] || ""}|${tags.phone || tags["contact:phone"] || ""}`; if (seen.has(unique)) return []; seen.add(unique);
+      const rawWebsite = tags.website || tags["contact:website"] || null;
+      const website = rawWebsite && !/^https?:\/\//i.test(rawWebsite) ? `https://${rawWebsite}` : rawWebsite;
+      const hasBrand = Boolean(tags.brand || tags["brand:wikidata"] || tags["operator:wikidata"]);
+      const independentPriority = preferIndependent && !hasBrand ? 8 : 0;
+      const initialSignals = website ? ["Website found — run quality scan"] : ["No website listed", "High-value website opportunity"];
+      if (preferIndependent && !hasBrand) initialSignals.push("No chain-brand indicator listed — verify ownership");
+      return [{ placeId: `osm-${element.type}-${element.id}`, name, address: address(tags), phone: tags.phone || tags["contact:phone"] || null, website, rating: null, reviews: null, mapsUrl: `https://www.openstreetmap.org/${element.type}/${element.id}`, industry: category, source: "OpenStreetMap", initialOpportunity: Math.min(100, (website ? 35 : 92) + independentPriority), initialSignals, hasBrand }];
+    }).slice(0, 30);
+    rows.sort((a, b) => (preferIndependent ? Number(a.hasBrand) - Number(b.hasBrand) : 0) || b.initialOpportunity - a.initialOpportunity);
+    return { rows, query: `${category} in ${city}`, source: "OpenStreetMap" };
+}
