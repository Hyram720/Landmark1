+import { z } from "zod";
+import { readJson, scoped, tenantRoute } from "@/lib/tenant/api";
+import { processAuditQueue, queueAudits } from "@/lib/leads/service";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+// { ids } queues websites for auditing; every call then audits the next two.
+// The page calls again while `remaining` > 0; the scheduler also drains the queue.
+export const POST = tenantRoute("crm.write", async (ctx, req) => {
+  const { ids } = await readJson(req, z.object({ ids: z.array(z.string().uuid()).max(200).optional() }));
+  const queued = ids?.length ? await queueAudits(scoped(ctx), ids) : 0;
+  const result = await processAuditQueue(ctx.client, ctx.org.id, 2);
+  return { queued, ...result };
+});
