@@ -0,0 +1,74 @@
+// Opportunity Score (0-100): how much a business would gain from the
+// agency's help, with every point explained. Signals that have not been
+// checked yet earn nothing and say so, rather than being guessed.
+
+export type ProspectSignals = {
+  website: string | null;
+  audited: boolean;
+  website_score: number | null;
+  mobile_score: number | null;
+  speed_score: number | null;
+  seo_score: number | null;
+  ssl_ok: boolean | null;
+  has_booking: boolean | null;
+  has_chat: boolean | null;
+  rating: number | null;
+  review_count: number | null;
+  has_brand: boolean;
+  business_email: string | null;
+};
+export type OpportunityFactor = { key: string; label: string; points: number; max: number; detail: string };
+
+const gap = (score: number | null, max: number) => (score === null ? 0 : Math.round((max * Math.max(0, 100 - score)) / 100));
+
+export function opportunityScore(p: ProspectSignals): { score: number; factors: OpportunityFactor[]; readiness: string[] } {
+  const f: OpportunityFactor[] = [];
+  if (!p.website) {
+    f.push({ key: "no_website", label: "No website listed", points: 50, max: 50, detail: "The public listing has no website. Customers searching for them find competitors instead." });
+  } else if (!p.audited) {
+    f.push({ key: "website", label: "Website quality", points: 0, max: 35, detail: "Not audited yet. Run an audit to score the website." });
+  } else {
+    f.push({ key: "website", label: "Website quality", points: gap(p.website_score, 20), max: 20, detail: p.website_score === null ? "The site could not be loaded." : `Overall website score ${p.website_score}/100.` });
+    f.push({ key: "mobile", label: "Mobile experience", points: gap(p.mobile_score, 5), max: 5, detail: p.mobile_score === null ? "Not measured." : `Mobile score ${p.mobile_score}/100.` });
+    f.push({ key: "speed", label: "Speed", points: gap(p.speed_score, 5), max: 5, detail: p.speed_score === null ? "Not measured." : `Speed score ${p.speed_score}/100.` });
+    f.push({ key: "seo", label: "Search visibility", points: gap(p.seo_score, 5), max: 5, detail: p.seo_score === null ? "Not measured." : `SEO score ${p.seo_score}/100.` });
+    if (p.website_score === null) f[0].points = 20;
+  }
+  if (p.website && p.audited) {
+    f.push({ key: "ssl", label: "Security warning", points: p.ssl_ok === false ? 10 : 0, max: 10, detail: p.ssl_ok === false ? "Browsers show “Not secure” on this site." : "Loads securely." });
+    f.push({ key: "booking", label: "Online booking", points: p.has_booking === false ? 10 : 0, max: 10, detail: p.has_booking ? "Customers can book online." : "No way to book online." });
+    f.push({ key: "chat", label: "Chat or text option", points: p.has_chat === false ? 5 : 0, max: 5, detail: p.has_chat ? "Visitors can start a chat." : "No chat or text option for visitors." });
+  }
+  if (p.rating === null) {
+    f.push({ key: "reputation", label: "Reputation", points: 0, max: 15, detail: "Reviews not verified (the free directory has no ratings)." });
+  } else {
+    const ratingPts = p.rating < 4 ? 10 : p.rating < 4.5 ? 4 : 0;
+    const countPts = (p.review_count ?? 0) < 20 ? 5 : 0;
+    f.push({ key: "reputation", label: "Reputation", points: ratingPts + countPts, max: 15, detail: `${p.rating.toFixed(1)}★ from ${p.review_count ?? 0} reviews.` });
+  }
+  f.push({ key: "independent", label: "Independent business", points: p.has_brand ? 0 : 5, max: 5, detail: p.has_brand ? "Part of a chain or brand (decisions are made elsewhere)." : "No chain brand listed; the owner likely decides." });
+  const score = Math.min(100, f.reduce((s, x) => s + x.points, 0));
+  const readiness: string[] = [];
+  if (!p.business_email) readiness.push("No business email found yet; outreach needs one.");
+  if (p.website && !p.audited) readiness.push("Audit the website to personalize outreach.");
+  return { score, factors: f, readiness };
+}
+
+// The single most persuasive, factual point for a first email.
+export function topFinding(factors: OpportunityFactor[]): string | null {
+  // Verifiable facts about their own website lead; reviews come last.
+  const priority = ["no_website", "ssl", "booking", "mobile", "website", "speed", "seo", "chat", "reputation"];
+  const best = [...factors].filter((x) => x.points > 0 && priority.includes(x.key)).sort((a, b) => priority.indexOf(a.key) - priority.indexOf(b.key))[0];
+  if (!best) return null;
+  switch (best.key) {
+    case "no_website": return "the public listing I found does not include a website, so people searching online may not find you";
+    case "ssl": return "browsers currently show a “Not secure” warning on your website, which causes many visitors to leave";
+    case "booking": return "there is no way for customers to book online, so after-hours visitors may go elsewhere";
+    case "mobile": return "the website is hard to use on a phone, where most local searches happen";
+    case "speed": return "the website loads slowly, and many visitors leave before it finishes";
+    case "seo": return "the website is missing basics that help Google show it in local searches";
+    case "chat": return "visitors have no quick way to text or chat with you";
+    case "reputation": return "a few more recent reviews would help you stand out in local search";
+    default: return "there are a few practical ways to turn more website visitors into customers";
+  }
+}
diff --git a/src/lib/leads/service.ts b/src/lib/leads/service.ts
