+++ b/src/lib/leads/service.ts
@@ -0,0 +1,457 @@
+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import { ApiError, fromDb } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import type { CrmContext } from "@/lib/crm/service";
+import * as crm from "@/lib/crm/service";
+import { runAudit } from "@/lib/audit";
+import { enrichWebsite } from "@/lib/contact-enrichment";
+import { isFreeEmail } from "@/lib/opportunity-radar";
+import { buildOutreachTemplates } from "@/lib/outreach-templates";
+import { openJson, vaultReady } from "@/lib/crypto/vault";
+import { activeAccounts } from "@/lib/comms/service";
+import { EMAIL_ADAPTERS } from "@/lib/comms/providers";
+import { publicBaseUrl } from "@/lib/supabase/system";
+import { DirectoryInputError, searchDirectory } from "./directory";
+import { opportunityScore, topFinding, type OpportunityFactor } from "./score";
+import { businessEmails, domainOf, type FoundEmail } from "./emails";
+
+// Lead Finder: tenant-scoped prospecting. Prospects are businesses, not CRM
+// contacts, until someone converts them. Outreach is one-to-one business
+// email only, with CAN-SPAM identification, a postal address and a working
+// one-click unsubscribe; no cold texts or calls exist in this module.
+
+export const PROSPECT_COLUMNS =
+  "id, organization_id, source, source_ref, name, category, address, city, phone, website, website_domain, has_brand, rating, review_count, status, opportunity_score, score_factors, scored_at, audit_status, audit_error, audited_at, website_score, website_grade, mobile_score, speed_score, seo_score, ssl_ok, has_booking, has_chat, emails, business_email, do_not_contact, tags, notes, company_id, contact_id, created_at, updated_at";
+export const OUTREACH_COLUMNS = "id, organization_id, prospect_id, to_address, subject, body, status, ai_generated, provider, from_address, error, created_by, sent_by, sent_at, created_at";
+
+export type Prospect = {
+  id: string; organization_id: string; source: string; source_ref: string | null; name: string; category: string | null; address: string | null; city: string | null;
+  phone: string | null; website: string | null; website_domain: string | null; has_brand: boolean; rating: number | null; review_count: number | null;
+  status: "new" | "qualified" | "contacted" | "replied" | "converted" | "disqualified"; opportunity_score: number; score_factors: OpportunityFactor[];
+  audit_status: string; audit_error: string | null; audited_at: string | null; website_score: number | null; website_grade: string | null;
+  mobile_score: number | null; speed_score: number | null; seo_score: number | null; ssl_ok: boolean | null; has_booking: boolean | null; has_chat: boolean | null;
+  emails: FoundEmail[]; business_email: string | null; do_not_contact: boolean; tags: string[]; notes: string | null; company_id: string | null; contact_id: string | null;
+};
+
+export const STATUSES = ["new", "qualified", "contacted", "replied", "converted", "disqualified"] as const;
+const MAX_TOUCHES = 3;
+const MIN_DAYS_BETWEEN = 3;
+
+function rescored(p: Pick<Prospect, "website" | "audited_at" | "website_score" | "mobile_score" | "speed_score" | "seo_score" | "ssl_ok" | "has_booking" | "has_chat" | "rating" | "review_count" | "has_brand" | "business_email">) {
+  const r = opportunityScore({ ...p, audited: !!p.audited_at });
+  return { opportunity_score: r.score, score_factors: r.factors, scored_at: new Date().toISOString() };
+}
+
+// ------------------------------------------------------------------ search
+export const searchInput = z.object({
+  category: z.string().trim().min(1).max(80),
+  custom_category: z.string().trim().max(80).optional(),
+  location: z.string().trim().min(2, "Enter a city and state.").max(100),
+  prefer_independent: z.boolean().optional(),
+});
+
+export async function searchAndSave(ctx: CrmContext, input: z.infer<typeof searchInput>) {
+  let found;
+  try {
+    found = await searchDirectory({ city: input.location, category: input.category, customCategory: input.custom_category, preferIndependent: input.prefer_independent });
+  } catch (e) {
+    if (e instanceof DirectoryInputError) throw new ApiError(e.message, 422, "invalid");
+    throw new ApiError(e instanceof Error ? e.message : "The free business directory is unavailable. Try again shortly.", 502, "directory_unavailable");
+  }
+  const { data: search, error: sErr } = await ctx.client.from("prospect_searches").insert({
+    organization_id: ctx.orgId, category: (input.category === "custom" ? input.custom_category : input.category) || input.category, location: input.location, created_by: ctx.userId,
+  }).select("id").single();
+  fromDb(sErr);
+  let added = 0;
+  let existing = 0;
+  for (const row of found.rows) {
+    const website = row.website && /^https?:\/\//i.test(row.website) ? row.website.slice(0, 500) : null;
+    const base = {
+      organization_id: ctx.orgId, source: "openstreetmap", source_ref: row.placeId.slice(0, 200), name: row.name.slice(0, 160), category: row.industry?.slice(0, 80) ?? null,
+      address: row.address?.slice(0, 300) ?? null, city: input.location.slice(0, 100), phone: row.phone?.slice(0, 40) ?? null, website, website_domain: domainOf(website),
+      has_brand: row.hasBrand, rating: null, review_count: null, search_id: search!.id,
+    };
+    const scoreFields = rescored({ ...base, audited_at: null, website_score: null, mobile_score: null, speed_score: null, seo_score: null, ssl_ok: null, has_booking: null, has_chat: null, business_email: null });
+    const { error } = await ctx.client.from("prospects").insert({ ...base, ...scoreFields });
+    if (error?.code === "23505") existing++;
+    else {
+      fromDb(error);
+      added++;
+    }
+  }
+  await ctx.client.from("prospect_searches").update({ result_count: found.rows.length }).eq("organization_id", ctx.orgId).eq("id", search!.id);
+  await audit(ctx.client, ctx.orgId, "leads.search", { type: "prospect_search", id: search!.id }, { query: found.query, found: found.rows.length, added });
+  return { query: found.query, found: found.rows.length, added, existing, search_id: search!.id };
+}
+
+// ------------------------------------------------------------------- list
+export const listFilters = z.object({
+  q: z.string().trim().max(80).optional(),
+  status: z.enum(STATUSES).optional(),
+  min_score: z.coerce.number().int().min(0).max(100).optional(),
+  no_website: z.coerce.boolean().optional(),
+  ssl_issue: z.coerce.boolean().optional(),
+  no_booking: z.coerce.boolean().optional(),
+  has_email: z.coerce.boolean().optional(),
+  not_audited: z.coerce.boolean().optional(),
+  search_id: z.string().uuid().optional(),
+  limit: z.coerce.number().int().min(1).max(200).optional(),
+  offset: z.coerce.number().int().min(0).optional(),
+});
+
+export async function listProspects(ctx: CrmContext, f: z.infer<typeof listFilters>) {
+  let q = ctx.client.from("prospects").select(PROSPECT_COLUMNS, { count: "exact" }).eq("organization_id", ctx.orgId);
+  const term = crm.searchTerm(f.q || "");
+  if (term) q = q.ilike("name", `%${term}%`);
+  if (f.status) q = q.eq("status", f.status);
+  else q = q.neq("status", "disqualified");
+  if (f.min_score) q = q.gte("opportunity_score", f.min_score as unknown as string);
+  if (f.no_website) q = q.is("website", null);
+  if (f.ssl_issue) q = q.eq("ssl_ok", false);
+  if (f.no_booking) q = q.eq("has_booking", false);
+  if (f.has_email) q = q.not("business_email", "is", null);
+  if (f.not_audited) q = q.neq("audit_status", "done");
+  if (f.search_id) q = q.eq("search_id", f.search_id);
+  const limit = f.limit ?? 100;
+  const offset = f.offset ?? 0;
+  const { data, error, count } = await q.order("opportunity_score", { ascending: false }).order("created_at", { ascending: false }).range(offset, offset + limit - 1);
+  fromDb(error);
+  return { rows: (data || []) as Prospect[], total: count ?? 0 };
+}
+
+export async function getProspect(ctx: { client: SupabaseClient; orgId: string }, id: string) {
+  const { data, error } = await ctx.client.from("prospects").select(PROSPECT_COLUMNS).eq("organization_id", ctx.orgId).eq("id", id).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Prospect not found.", 404, "not_found");
+  return data as Prospect;
+}
+
+export async function prospectDetail(ctx: CrmContext, id: string) {
+  const prospect = await getProspect(ctx, id);
+  const [audits, outreach] = await Promise.all([
+    ctx.client.from("prospect_audits").select("id, url, ok, overall, grade, categories, findings, error, created_at").eq("organization_id", ctx.orgId).eq("prospect_id", id).order("created_at", { ascending: false }).limit(5),
+    ctx.client.from("outreach_messages").select(OUTREACH_COLUMNS).eq("organization_id", ctx.orgId).eq("prospect_id", id).order("created_at", { ascending: false }).limit(20),
+  ]);
+  fromDb(audits.error);
+  fromDb(outreach.error);
+  return { prospect, audits: audits.data || [], outreach: outreach.data || [], readiness: opportunityScore({ ...prospect, audited: !!prospect.audited_at }).readiness };
+}
+
+export const manualInput = z.object({
+  name: z.string().trim().min(1, "Enter the business name.").max(160),
+  website: z.string().trim().max(500).optional().transform((v) => (v ? (/^https?:\/\//i.test(v) ? v : `https://${v}`) : undefined)),
+  phone: z.string().trim().max(40).optional(),
+  category: z.string().trim().max(80).optional(),
+  city: z.string().trim().max(100).optional(),
+  business_email: z.string().trim().toLowerCase().email().max(254).optional(),
+  rating: z.number().min(0).max(5).optional(),
+  review_count: z.number().int().min(0).optional(),
+});
+
+export async function createManual(ctx: CrmContext, input: z.infer<typeof manualInput>) {
+  if (input.business_email && isFreeEmail(input.business_email)) throw new ApiError("Use a business address, not a personal mailbox (Gmail, Yahoo…).", 422, "invalid");
+  const base = {
+    name: input.name, website: input.website ?? null, website_domain: domainOf(input.website ?? null), phone: input.phone ?? null, category: input.category ?? null,
+    city: input.city ?? null, business_email: input.business_email ?? null, rating: input.rating ?? null, review_count: input.review_count ?? null, has_brand: false,
+    emails: input.business_email ? [{ email: input.business_email, source_url: "entered by hand" }] : [],
+  };
+  const { data, error } = await ctx.client.from("prospects").insert({
+    ...base, organization_id: ctx.orgId, source: "manual",
+    ...rescored({ ...base, audited_at: null, website_score: null, mobile_score: null, speed_score: null, seo_score: null, ssl_ok: null, has_booking: null, has_chat: null }),
+  }).select(PROSPECT_COLUMNS).single();
+  fromDb(error);
+  return data as Prospect;
+}
+
+export const prospectPatch = z.object({
+  status: z.enum(STATUSES).optional(),
+  notes: z.string().trim().max(4000).nullable().optional(),
+  tags: z.array(z.string().trim().min(1).max(40)).max(20).optional(),
+  business_email: z.string().trim().toLowerCase().email().max(254).nullable().optional(),
+  do_not_contact: z.boolean().optional(),
+  rating: z.number().min(0).max(5).nullable().optional(),
+  review_count: z.number().int().min(0).nullable().optional(),
+});
+
+export async function updateProspect(ctx: CrmContext, id: string, patch: z.infer<typeof prospectPatch>) {
+  if (patch.business_email && isFreeEmail(patch.business_email)) throw new ApiError("Use a business address, not a personal mailbox (Gmail, Yahoo…).", 422, "invalid");
+  const current = await getProspect(ctx, id);
+  const merged = { ...current, ...patch };
+  const row: Record<string, unknown> = { ...patch };
+  if (patch.rating !== undefined || patch.review_count !== undefined || patch.business_email !== undefined) Object.assign(row, rescored(merged as Prospect));
+  const { data, error } = await ctx.client.from("prospects").update(row).eq("organization_id", ctx.orgId).eq("id", id).select(PROSPECT_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Prospect not found.", 404, "not_found");
+  return data as Prospect;
+}
+
+export async function deleteProspects(ctx: CrmContext, ids: string[]) {
+  const { data, error } = await ctx.client.from("prospects").delete().eq("organization_id", ctx.orgId).in("id", [...new Set(ids)]).select("id");
+  fromDb(error);
+  return (data || []).length;
+}
+
+// ------------------------------------------------------------------ audits
+export type AuditDeps = { audit: typeof runAudit; enrich: typeof enrichWebsite };
+const defaultAuditDeps: AuditDeps = { audit: runAudit, enrich: enrichWebsite };
+
+export async function queueAudits(ctx: CrmContext, ids: string[]) {
+  const { data, error } = await ctx.client.from("prospects").update({ audit_status: "queued", audit_error: null })
+    .eq("organization_id", ctx.orgId).in("id", [...new Set(ids)]).not("website", "is", null).neq("audit_status", "running").select("id");
+  fromDb(error);
+  return (data || []).length;
+}
+
+// Audits one prospect's website: quality scores, SSL, booking and chat
+// detection, and business emails published on the site. Works with the
+// user's client (RLS) or the service role.
+export async function auditProspect(client: SupabaseClient, orgId: string, prospectId: string, deps: AuditDeps = defaultAuditDeps) {
+  const { data: claimed } = await client.from("prospects").update({ audit_status: "running" }).eq("organization_id", orgId).eq("id", prospectId)
+    .in("audit_status", ["queued", "none", "done", "failed"]).select(PROSPECT_COLUMNS).maybeSingle();
+  if (!claimed) return null;
+  const p = claimed as Prospect;
+  if (!p.website) {
+    await client.from("prospects").update({ audit_status: "failed", audit_error: "No website to audit." }).eq("organization_id", orgId).eq("id", p.id);
+    return null;
+  }
+  const result = await deps.audit(p.website);
+  const cat = (key: string) => result.ok ? result.categories.find((c) => c.key === key)?.score ?? null : null;
+  const finding = (id: string) => result.findings.find((f) => f.id === id);
+  let emails: FoundEmail[] = p.emails || [];
+  if (result.ok) {
+    try {
+      const enriched = await deps.enrich(p.website);
+      const found = enriched.evidence.filter((e) => e.kind === "email" && e.source_type === "website").map((e) => ({ email: e.value, source_url: e.source_url }));
+      emails = businessEmails([...emails, ...found], p.website_domain);
+    } catch {
+      /* email discovery is best effort */
+    }
+  }
+  const fields = {
+    audited_at: new Date().toISOString(),
+    audit_status: result.ok ? "done" : "failed",
+    audit_error: result.ok ? null : (result.error || "The website could not be audited.").slice(0, 500),
+    website_score: result.ok ? result.overall : null,
+    website_grade: result.ok ? result.grade : null,
+    mobile_score: cat("mobile"), speed_score: cat("speed"), seo_score: cat("seo"),
+    ssl_ok: result.ok ? finding("https")?.status === "pass" : null,
+    has_booking: result.ok ? finding("online_booking")?.evidence === "detected" : null,
+    has_chat: result.ok ? finding("chat")?.status === "pass" : null,
+    emails,
+    business_email: p.business_email ?? emails[0]?.email ?? null,
+  };
+  const updated = { ...p, ...fields };
+  const { error } = await client.from("prospects").update({ ...fields, ...rescored(updated) }).eq("organization_id", orgId).eq("id", p.id);
+  fromDb(error);
+  await client.from("prospect_audits").insert({
+    organization_id: orgId, prospect_id: p.id, url: p.website.slice(0, 500), ok: result.ok, overall: result.ok ? result.overall : null, grade: result.ok ? result.grade : null,
+    categories: result.ok ? result.categories.map((c) => ({ key: c.key, name: c.name, score: c.score, grade: c.grade })) : [],
+    findings: result.ok ? result.findings.filter((f) => f.status === "fail" || f.status === "warn").sort((a, b) => b.weight - a.weight).slice(0, 12)
+      .map((f) => ({ id: f.id, label: f.label, status: f.status, client: f.client, fix: f.fix ?? null })) : [],
+    error: result.ok ? null : (result.error || "").slice(0, 500),
+  });
+  return { id: p.id, ok: result.ok };
+}
+
+// Runs queued audits, a few at a time (request handlers and the scheduler).
+export async function processAuditQueue(client: SupabaseClient, orgId: string | null, limit = 2, deps: AuditDeps = defaultAuditDeps) {
+  let q = client.from("prospects").select("id, organization_id").eq("audit_status", "queued");
+  if (orgId) q = q.eq("organization_id", orgId);
+  const { data, error } = await q.order("updated_at").limit(limit);
+  fromDb(error);
+  const results = await Promise.all((data || []).map((r) => auditProspect(client, r.organization_id, r.id, deps).catch((e) => {
+    console.error("[leads] audit", r.id, e);
+    return client.from("prospects").update({ audit_status: "failed", audit_error: "Audit error." }).eq("id", r.id).eq("organization_id", r.organization_id).then(() => null);
+  })));
+  let remaining = 0;
+  if (orgId) {
+    const { count } = await client.from("prospects").select("id", { count: "exact", head: true }).eq("organization_id", orgId).eq("audit_status", "queued");
+    remaining = count ?? 0;
+  }
+  return { audited: results.filter(Boolean).length, remaining };
+}
+
+// --------------------------------------------------------------- convert
+export async function convertToCrm(ctx: CrmContext, id: string) {
+  const p = await getProspect(ctx, id);
+  if (p.contact_id) return { contact_id: p.contact_id, duplicate: true };
+  if (!p.business_email && !p.phone) throw new ApiError("Add an email or phone number before adding this business to the CRM.", 422, "invalid");
+  const { contact, duplicate } = await crm.createContact(ctx, crm.contactInput.parse({
+    email: p.business_email ?? undefined, phone: p.phone && /^\+?[0-9() .-]{7,32}$/.test(p.phone) ? p.phone : undefined,
+    company_name: p.name, source: "Lead Finder", lifecycle_stage: "prospect", tags: ["lead-finder"],
+  }));
+  const { data: c } = await ctx.client.from("contacts").select("company_id").eq("organization_id", ctx.orgId).eq("id", contact.id).maybeSingle();
+  const { error } = await ctx.client.from("prospects").update({ status: "converted", contact_id: contact.id, company_id: c?.company_id ?? null }).eq("organization_id", ctx.orgId).eq("id", id);
+  fromDb(error);
+  await crm.addNote(ctx, { contact_id: contact.id, body: `Added from Lead Finder. Opportunity score ${p.opportunity_score}/100.${p.website ? ` Website: ${p.website}` : ""}\n${p.score_factors.filter((f) => f.points > 0).map((f) => `• ${f.label}: ${f.detail}`).join("\n")}` });
+  await audit(ctx.client, ctx.orgId, "leads.converted", { type: "prospect", id }, { contact_id: contact.id });
+  return { contact_id: contact.id, duplicate };
+}
+
+// --------------------------------------------------------------- outreach
+export type OutreachSettings = { sender_name: string; mailing_address: string; phone: string; website: string; daily_limit: number };
+export const settingsInput = z.object({
+  sender_name: z.string().trim().min(1).max(120),
+  mailing_address: z.string().trim().min(10, "Enter a full postal address (street or PO box, city, state, ZIP).").max(300),
+  phone: z.string().trim().max(40).optional().default(""),
+  website: z.string().trim().max(200).optional().default(""),
+  daily_limit: z.number().int().min(1).max(200).default(40),
+});
+
+export async function getOutreachSettings(client: SupabaseClient, orgId: string): Promise<OutreachSettings & { configured: boolean; orgName: string }> {
+  const { data, error } = await client.from("organizations").select("name, settings").eq("id", orgId).maybeSingle();
+  fromDb(error);
+  const s = ((data?.settings || {}) as { outreach?: Partial<OutreachSettings> }).outreach || {};
+  return {
+    sender_name: s.sender_name || data?.name || "", mailing_address: s.mailing_address || "", phone: s.phone || "", website: s.website || "",
+    daily_limit: s.daily_limit || 40, configured: !!s.mailing_address, orgName: data?.name || "",
+  };
+}
+
+export async function saveOutreachSettings(ctx: CrmContext, input: z.infer<typeof settingsInput>) {
+  const { data, error } = await ctx.client.from("organizations").select("settings").eq("id", ctx.orgId).single();
+  fromDb(error);
+  const settings = { ...((data?.settings || {}) as Record<string, unknown>), outreach: input };
+  const { error: e2 } = await ctx.client.from("organizations").update({ settings }).eq("id", ctx.orgId);
+  fromDb(e2);
+  await audit(ctx.client, ctx.orgId, "leads.outreach_settings", null, { daily_limit: input.daily_limit });
+  return input;
+}
+
+async function sentHistory(client: SupabaseClient, orgId: string, prospectId: string) {
+  const { data, error } = await client.from("outreach_messages").select("sent_at").eq("organization_id", orgId).eq("prospect_id", prospectId).eq("status", "sent").order("sent_at", { ascending: false });
+  fromDb(error);
+  return (data || []).map((r) => new Date(r.sent_at));
+}
+
+export const draftInput = z.object({ prospect_id: z.string().uuid(), subject: z.string().trim().min(1).max(200).optional(), body: z.string().trim().min(1).max(10000).optional() });
+
+// Drafts the next email for a prospect from its audit (or saves the given text).
+export async function draftOutreach(ctx: CrmContext, input: z.infer<typeof draftInput>, opts: { aiGenerated?: boolean } = {}) {
+  const p = await getProspect(ctx, input.prospect_id);
+  if (p.do_not_contact) throw new ApiError("This business asked not to be contacted.", 409, "do_not_contact");
+  if (!p.business_email) throw new ApiError("No business email for this prospect yet. Audit the website or add one.", 422, "invalid");
+  const history = await sentHistory(ctx.client, ctx.orgId, p.id);
+  if (history.length >= MAX_TOUCHES) throw new ApiError(`${p.name} has already received ${MAX_TOUCHES} emails. Stop here unless they reply.`, 409, "limit");
+  let subject = input.subject;
+  let body = input.body;
+  if (!subject || !body) {
+    const s = await getOutreachSettings(ctx.client, ctx.orgId);
+    const templates = buildOutreachTemplates({
+      businessName: p.name, city: p.city, website: p.website, finding: topFinding(p.score_factors), agencyName: s.sender_name || s.orgName,
+      agencyPhone: s.phone || null, agencySite: s.website || null,
+    });
+    const pick = history.length === 0 ? (p.website ? "specific_finding" : "no_website_listed") : history.length === 1 ? "report_follow_up" : "close_loop";
+    const t = templates.find((x) => x.id === pick)!;
+    subject = subject || t.subject;
+    body = body || t.body;
+  }
+  const { data, error } = await ctx.client.from("outreach_messages").insert({
+    organization_id: ctx.orgId, prospect_id: p.id, to_address: p.business_email, subject, body, ai_generated: !!opts.aiGenerated,
+  }).select(OUTREACH_COLUMNS).single();
+  fromDb(error);
+  return data!;
+}
+
+export function outreachFooter(s: { sender_name: string; mailing_address: string }, prospectName: string, unsubscribeUrl: string) {
+  return [
+    "",
+    "—",
+    s.sender_name,
+    s.mailing_address,
+    `This is a marketing message from ${s.sender_name} about ${prospectName}'s online presence. To stop receiving these emails, unsubscribe here: ${unsubscribeUrl} or reply "unsubscribe".`,
+  ].join("\n");
+}
+
+export type OutreachPreflight = { ok: true } | { ok: false; reason: string; code: string };
+export function outreachPreflight(input: {
+  settingsConfigured: boolean; hasAccount: boolean; vault: boolean; baseUrl: string | null; to: string; doNotContact: boolean;
+  sentToday: number; dailyLimit: number; history: Date[]; now: Date;
+}): OutreachPreflight {
+  if (!input.settingsConfigured) return { ok: false, code: "integration_not_configured", reason: "Add your sender name and postal mailing address in Lead Finder settings (required by CAN-SPAM)." };
+  if (!input.hasAccount || !input.vault) return { ok: false, code: "integration_not_configured", reason: "Connect an email sender in Channels first." };
+  if (!input.baseUrl) return { ok: false, code: "integration_not_configured", reason: "Set PUBLIC_APP_URL so the unsubscribe link works." };
+  if (input.doNotContact) return { ok: false, code: "do_not_contact", reason: "This business asked not to be contacted." };
+  if (isFreeEmail(input.to)) return { ok: false, code: "personal_address", reason: "Outreach goes only to business addresses, not personal mailboxes." };
+  if (input.history.length >= MAX_TOUCHES) return { ok: false, code: "limit", reason: `Already emailed ${MAX_TOUCHES} times. Stop unless they reply.` };
+  const last = input.history[0];
+  if (last && input.now.getTime() - last.getTime() < MIN_DAYS_BETWEEN * 86_400_000) return { ok: false, code: "too_soon", reason: `Wait at least ${MIN_DAYS_BETWEEN} days between emails to the same business.` };
+  if (input.sentToday >= input.dailyLimit) return { ok: false, code: "daily_limit", reason: `Daily outreach limit reached (${input.dailyLimit}). This protects your sending reputation; continue tomorrow.` };
+  return { ok: true };
+}
+
+export const editInput = z.object({ subject: z.string().trim().min(1).max(200).optional(), body: z.string().trim().min(1).max(10000).optional(), to_address: z.string().trim().toLowerCase().email().max(254).optional() });
+
+export async function updateDraft(ctx: CrmContext, id: string, patch: z.infer<typeof editInput>) {
+  if (patch.to_address && isFreeEmail(patch.to_address)) throw new ApiError("Outreach goes only to business addresses, not personal mailboxes.", 422, "invalid");
+  const { data, error } = await ctx.client.from("outreach_messages").update(patch).eq("organization_id", ctx.orgId).eq("id", id).eq("status", "draft").select(OUTREACH_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Only drafts can be edited.", 409, "conflict");
+  return data;
+}
+
+export async function cancelDraft(ctx: CrmContext, id: string) {
+  const { data, error } = await ctx.client.from("outreach_messages").update({ status: "cancelled" }).eq("organization_id", ctx.orgId).eq("id", id).eq("status", "draft").select("id").maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Only drafts can be discarded.", 409, "conflict");
+}
+
+// Sends one outreach email, as the signed-in person. Always a human action.
+export async function sendOutreach(ctx: CrmContext, id: string, opts: { req?: Request; now?: Date } = {}) {
+  const now = opts.now ?? new Date();
+  const { data: msg, error } = await ctx.client.from("outreach_messages").select(OUTREACH_COLUMNS).eq("organization_id", ctx.orgId).eq("id", id).maybeSingle();
+  fromDb(error);
+  if (!msg || msg.status !== "draft") throw new ApiError("Only drafts can be sent.", 409, "conflict");
+  const p = await getProspect(ctx, msg.prospect_id);
+  const [settings, accounts, history, today] = await Promise.all([
+    getOutreachSettings(ctx.client, ctx.orgId),
+    activeAccounts(ctx.client, ctx.orgId, "email"),
+    sentHistory(ctx.client, ctx.orgId, p.id),
+    ctx.client.from("outreach_messages").select("id", { count: "exact", head: true }).eq("organization_id", ctx.orgId).eq("status", "sent").gte("sent_at", new Date(now.getTime() - 86_400_000).toISOString()),
+  ]);
+  const base = publicBaseUrl(opts.req);
+  const pre = outreachPreflight({
+    settingsConfigured: settings.configured, hasAccount: accounts.length > 0, vault: vaultReady(), baseUrl: base, to: msg.to_address, doNotContact: p.do_not_contact,
+    sentToday: today.count ?? 0, dailyLimit: settings.daily_limit, history, now,
+  });
+  if (!pre.ok) throw new ApiError(pre.reason, pre.code === "integration_not_configured" ? 503 : 409, pre.code);
+
+  const { data: claimed, error: claimErr } = await ctx.client.from("outreach_messages").update({ status: "sending" }).eq("organization_id", ctx.orgId).eq("id", id).eq("status", "draft").select("id").maybeSingle();
+  if (claimErr?.code === "42501") throw new ApiError(claimErr.message, 409, "suppressed");
+  fromDb(claimErr);
+  if (!claimed) throw new ApiError("This email is already being sent.", 409, "conflict");
+  const { data: token, error: tErr } = await ctx.client.rpc("outreach_unsubscribe_token", { p_message: id });
+  fromDb(tErr);
+  const unsubscribeUrl = `${base}/optout/${token}`;
+  const oneClick = `${base}/api/public/outreach-unsubscribe/${token}`;
+  const account = accounts[0];
+  let result: { status: "sent" | "failed"; provider_message_id?: string; error?: string };
+  try {
+    const { data: secret, error: sErr } = await ctx.client.rpc("provider_secret", { p_account: account.id });
+    fromDb(sErr);
+    const adapter = EMAIL_ADAPTERS[account.provider];
+    if (!adapter) throw new Error(`${account.provider} cannot send email.`);
+    const sent = await adapter.send(openJson(String(secret)), account.config, {
+      from: account.address, fromName: settings.sender_name, to: msg.to_address, subject: msg.subject,
+      text: `${msg.body}\n${outreachFooter(settings, p.name, unsubscribeUrl)}`, idempotencyKey: `outreach-${id}`,
+      headers: { "List-Unsubscribe": `<${oneClick}>`, "List-Unsubscribe-Post": "List-Unsubscribe=One-Click" },
+    });
+    result = { status: "sent", provider_message_id: sent.providerMessageId };
+  } catch (e) {
+    result = { status: "failed", error: (e instanceof Error ? e.message : "The provider refused the email.").slice(0, 1000) };
+  }
+  const { data: done, error: dErr } = await ctx.client.from("outreach_messages").update({
+    status: result.status, provider: account.provider, provider_account_id: account.id, provider_message_id: result.provider_message_id ?? null, from_address: account.address, error: result.error ?? null,
+  }).eq("organization_id", ctx.orgId).eq("id", id).select(OUTREACH_COLUMNS).single();
+  fromDb(dErr);
+  if (result.status === "sent") {
+    if (p.status === "new" || p.status === "qualified") await ctx.client.from("prospects").update({ status: "contacted" }).eq("organization_id", ctx.orgId).eq("id", p.id);
+    if (p.contact_id) {
+      await ctx.client.from("activities").insert({ organization_id: ctx.orgId, contact_id: p.contact_id, kind: "email", direction: "outbound", subject: msg.subject.slice(0, 300), body: msg.body, actor_type: "user", actor_id: ctx.userId, metadata: { outreach_id: id } });
+    }
+  }
+  await audit(ctx.client, ctx.orgId, result.status === "sent" ? "outreach.sent" : "outreach.failed", { type: "outreach", id }, { prospect_id: p.id, error: result.error });
+  return done;
+}
