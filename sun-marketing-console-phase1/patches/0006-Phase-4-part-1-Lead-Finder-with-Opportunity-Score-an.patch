+import { z } from "zod";
+import { readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { convertToCrm, prospectDetail, prospectPatch, updateProspect } from "@/lib/leads/service";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const GET = tenantRoute<P>("crm.read", async (ctx, _req, { id }) => prospectDetail(scoped(ctx), uuid.parse(id)));
+
+export const PATCH = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const input = await readJson(req, prospectPatch);
+  const prospect = await updateProspect(scoped(ctx), uuid.parse(id), input);
+  await audit(ctx.client, ctx.org.id, "leads.updated", { type: "prospect", id }, { fields: Object.keys(input) });
+  return { prospect };
+});
+
+// { action: "convert" } adds the business to the CRM as a company + contact.
+export const POST = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  await readJson(req, z.object({ action: z.literal("convert") }));
+  return convertToCrm(scoped(ctx), uuid.parse(id));
+});
