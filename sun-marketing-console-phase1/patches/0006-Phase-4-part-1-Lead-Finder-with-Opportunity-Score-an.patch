+import { z } from "zod";
+import { readJson, scoped, tenantRoute, uuid } from "@/lib/tenant/api";
+import { cancelDraft, editInput, sendOutreach, updateDraft } from "@/lib/leads/service";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const PATCH = tenantRoute<P>("crm.write", async (ctx, req, { id }) => ({ message: await updateDraft(scoped(ctx), uuid.parse(id), await readJson(req, editInput)) }));
+
+// { action: "send" } sends as the signed-in person; { action: "discard" } cancels the draft.
+export const POST = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const { action } = await readJson(req, z.object({ action: z.enum(["send", "discard"]) }));
+  if (action === "discard") {
+    await cancelDraft(scoped(ctx), uuid.parse(id));
+    return { ok: true };
+  }
+  return { message: await sendOutreach(scoped(ctx), uuid.parse(id), { req }) };
+});
