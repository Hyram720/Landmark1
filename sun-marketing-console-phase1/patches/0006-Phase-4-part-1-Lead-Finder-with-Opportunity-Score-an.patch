@@ -0,0 +1,19 @@
+import { NextResponse } from "next/server";
+import { systemClient } from "@/lib/supabase/system";
+import { clientIp, takeLimit } from "@/lib/rate-limit";
+
+export const dynamic = "force-dynamic";
+type P = { params: Promise<{ token: string }> };
+
+// RFC 8058 one-click unsubscribe (mail providers POST here) and the button on
+// /optout/<token>. Always succeeds visibly for a valid token; idempotent.
+export async function POST(req: Request, { params }: P) {
+  const token = (await params).token;
+  if (!/^[0-9a-f]{36}$/.test(token)) return NextResponse.json({ error: "This link is not valid." }, { status: 404 });
+  if (!(await takeLimit("outreach-unsubscribe", clientIp(req), 30, 600))) return NextResponse.json({ error: "Too many requests. Try again shortly." }, { status: 429 });
+  const system = systemClient();
+  if (!system) return NextResponse.json({ error: "Please reply to the email with the word unsubscribe; we will remove you." }, { status: 503 });
+  const { data, error } = await system.rpc("outreach_unsubscribe", { p_token: token });
+  if (error) return NextResponse.json({ error: error.code === "P0002" ? "This link is not valid." : "Something went wrong. Please reply \"unsubscribe\" to the email instead." }, { status: error.code === "P0002" ? 404 : 500 });
+  return NextResponse.json({ ok: true, business: (data as { business: string }).business });
+}
