+import { ApiError, readJson, scoped, tenantRoute } from "@/lib/tenant/api";
+import { takeLimit } from "@/lib/rate-limit";
+import { searchAndSave, searchInput } from "@/lib/leads/service";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+// Searches the free public directory and saves new businesses as prospects.
+// Limited per organization out of respect for the free directory's usage policy.
+export const POST = tenantRoute("crm.write", async (ctx, req) => {
+  const input = await readJson(req, searchInput);
+  if (!(await takeLimit("lead-search", ctx.org.id, 10, 600))) throw new ApiError("Too many searches in a short time. Wait a few minutes.", 429, "rate_limited");
+  return searchAndSave(scoped(ctx), input);
+});
