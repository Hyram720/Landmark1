+import { z } from "zod";
+import { readJson, scoped, tenantRoute } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+import { createManual, deleteProspects, listFilters, listProspects, manualInput } from "@/lib/leads/service";
+import { ALLOWED_CATEGORIES } from "@/lib/leads/directory";
+
+export const dynamic = "force-dynamic";
+
+export const GET = tenantRoute("crm.read", async (ctx, req) => {
+  const params = Object.fromEntries([...new URL(req.url).searchParams.entries()].filter(([, v]) => v !== "" && v !== "0" && v !== "false"));
+  const filters = listFilters.parse(params);
+  const [list, searches] = await Promise.all([
+    listProspects(scoped(ctx), filters),
+    ctx.client.from("prospect_searches").select("id, category, location, result_count, created_at").eq("organization_id", ctx.org.id).order("created_at", { ascending: false }).limit(10),
+  ]);
+  return { ...list, searches: searches.data || [], categories: [...ALLOWED_CATEGORIES] };
+});
+
+// Adds a business by hand.
+export const POST = tenantRoute("crm.write", async (ctx, req) => {
+  const prospect = await createManual(scoped(ctx), await readJson(req, manualInput));
+  await audit(ctx.client, ctx.org.id, "leads.added", { type: "prospect", id: prospect.id });
+  return { prospect };
+});
+
+export const DELETE = tenantRoute("crm.delete", async (ctx, req) => {
+  const { ids } = await readJson(req, z.object({ ids: z.array(z.string().uuid()).min(1).max(200) }));
+  const deleted = await deleteProspects(scoped(ctx), ids);
+  await audit(ctx.client, ctx.org.id, "leads.deleted", null, { count: deleted });
+  return { deleted };
+});
