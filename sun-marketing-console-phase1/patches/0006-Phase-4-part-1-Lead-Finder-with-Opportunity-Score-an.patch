@@ -0,0 +1,31 @@
+import { emailDomain, isFreeEmail } from "@/lib/opportunity-radar";
+
+// Picks addresses that are plausibly the business's own role or work
+// addresses: found on the business's website, on its own domain (or a
+// non-freemail domain), never personal freemail inboxes.
+export type FoundEmail = { email: string; source_url: string };
+
+const ROLE_PREFIX = /^(info|office|hello|contact|sales|service|support|admin|team|book|booking|appointments|estimates|inquiries|enquiries)@/;
+
+export function domainOf(website: string | null): string | null {
+  if (!website) return null;
+  try {
+    return new URL(/^https?:\/\//i.test(website) ? website : `https://${website}`).hostname.toLowerCase().replace(/^www\./, "");
+  } catch {
+    return null;
+  }
+}
+
+export function businessEmails(found: FoundEmail[], websiteDomain: string | null): FoundEmail[] {
+  const seen = new Set<string>();
+  const out: FoundEmail[] = [];
+  for (const f of found) {
+    const email = f.email.trim().toLowerCase().replace(/^mailto:/, "").split("?")[0];
+    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) || email.length > 254 || seen.has(email)) continue;
+    if (isFreeEmail(email) || /noreply|no-reply|donotreply|example\.|wixpress|sentry|@domain\.|\.(png|jpe?g|gif|webp|svg)$/.test(email)) continue;
+    seen.add(email);
+    out.push({ email, source_url: f.source_url });
+  }
+  const rank = (e: string) => (websiteDomain && (emailDomain(e) === websiteDomain || emailDomain(e).endsWith(`.${websiteDomain}`)) ? 0 : 2) + (ROLE_PREFIX.test(e) ? 0 : 1);
+  return out.sort((a, b) => rank(a.email) - rank(b.email)).slice(0, 10);
+}
