+"use client";
+import { use, useState } from "react";
+import "@/components/public/public.css";
+
+// Unsubscribe page for Lead Finder outreach. A visible button (not an
+// automatic GET) so link scanners in mail systems never unsubscribe anyone.
+export default function OptOut({ params }: { params: Promise<{ token: string }> }) {
+  const { token } = use(params);
+  const [state, setState] = useState<{ done?: string; error?: string; busy?: boolean }>({});
+  return (
+    <div className="pub"><div className="pub-card narrow">
+      <h1>Unsubscribe</h1>
+      {state.done ? (
+        <p className="lead" role="status">You&apos;re unsubscribed. {state.done} will not email you again.</p>
+      ) : (<>
+        <p className="lead">Stop receiving these business emails at this address.</p>
+        {state.error && <p className="form-error" role="alert">{state.error}</p>}
+        <button className="btn btn-primary" disabled={state.busy} onClick={async () => {
+          setState({ busy: true });
+          const r = await fetch(`/api/public/outreach-unsubscribe/${token}`, { method: "POST" }).catch(() => null);
+          const j = r ? await r.json().catch(() => ({})) : {};
+          setState(r?.ok ? { done: j.business || "The sender" } : { error: j.error || "Something went wrong. Reply \"unsubscribe\" to the email instead." });
+        }}>{state.busy ? <span className="spin" /> : "Unsubscribe"}</button>
+      </>)}
+    </div></div>
+  );
+}
