+        <p className="hint">Every outreach email adds your sender name, this address, a line saying it is a marketing message, and a one-click unsubscribe link (CAN-SPAM). Emails go only to business addresses found on the business&apos;s own website or entered by you, at most three per business, three days apart. There is no texting or calling of prospects.</p>
+      </form>
+    </details>
+  );
+}
+
+function Draft({ m, onChanged, toast }: { m: Outreach; onChanged: () => void; toast: (s: string) => void }) {
+  const [subject, setSubject] = useState(m.subject);
+  const [body, setBody] = useState(m.body);
+  const [busy, setBusy] = useState(false);
+  const dirty = subject !== m.subject || body !== m.body;
+  const act = async (fn: () => Promise<unknown>, done: string) => { setBusy(true); try { await fn(); toast(done); onChanged(); } catch (e) { toast(e instanceof Error ? e.message : "That did not work."); } finally { setBusy(false); } };
+  return (
+    <div className="step">
+      <div className="step-head"><span className="pill pill-info">Draft{m.ai_generated ? " (AI)" : ""}</span><span className="tiny muted">to {m.to_address}</span></div>
+      <input className="input" aria-label="Subject" value={subject} maxLength={200} onChange={(e) => setSubject(e.target.value)} />
+      <textarea className="textarea" aria-label="Email" rows={9} value={body} maxLength={10000} onChange={(e) => setBody(e.target.value)} />
+      <span className="tiny muted">Your sender name, mailing address and an unsubscribe link are added below the message when it is sent.</span>
+      <div className="inline-actions">
+        {dirty && <button className="btn btn-sm" disabled={busy} onClick={() => act(() => api(`/api/prospecting/outreach/${m.id}`, { method: "PATCH", body: { subject, body } }), "Draft saved.")}>Save changes</button>}
+        <button className="btn btn-sm btn-primary" disabled={busy || dirty} title={dirty ? "Save your changes first" : undefined} onClick={() => { if (window.confirm(`Send this email to ${m.to_address} now?`)) act(() => api(`/api/prospecting/outreach/${m.id}`, { body: { action: "send" } }), "Sent."); }}>{busy ? <span className="spin" /> : "Send"}</button>
+        <button className="btn btn-sm btn-ghost" disabled={busy} onClick={() => act(() => api(`/api/prospecting/outreach/${m.id}`, { body: { action: "discard" } }), "Discarded.")}>Discard</button>
+      </div>
+    </div>
+  );
+}
+
+function ProspectPanel({ id, canManage, onChanged, toast }: { id: string; canManage: boolean; onChanged: () => void; toast: (m: string) => void }) {
+  const { data, error, loading, reload } = useResource<Detail>(`/api/prospecting/${id}`);
+  const [notes, setNotes] = useState<string | null>(null);
+  const [email, setEmail] = useState("");
+  const [busy, setBusy] = useState("");
+  useEffect(() => { setNotes(null); setEmail(""); }, [id]);
+  if (loading && !data) return <div className="card"><Loading /></div>;
+  if (error) return <div className="card"><ErrorState message={error} onRetry={reload} /></div>;
+  if (!data) return null;
+  const p = data.prospect;
+  const refresh = () => { reload(); onChanged(); };
+  const act = async (label: string, fn: () => Promise<unknown>, done: string) => { setBusy(label); try { await fn(); toast(done); refresh(); } catch (e) { toast(e instanceof Error ? e.message : "That did not work."); } finally { setBusy(""); } };
+  const drafts = data.outreach.filter((m) => m.status === "draft");
+  const history = data.outreach.filter((m) => m.status !== "draft");
+  const audit = data.audits[0];
+  return (
+    <div className="card lf-sticky">
+      <div className="card-head"><div style={{ minWidth: 0 }}><h3>{p.name}</h3><div className="sub">{[p.category, p.address || p.city].filter(Boolean).join(" · ")}</div></div>
+        <span className={`pill ${scorePill(p.opportunity_score)}`} title="Opportunity Score">{p.opportunity_score}</span></div>
+      <div className="card-pad stack">
+        {p.do_not_contact && <div className="notice notice-warn small"><strong>Do not contact.</strong> This business unsubscribed or was marked do-not-contact.</div>}
+        <div className="kv small">
+          <dt>Website</dt><dd>{p.website ? <a className="link" href={p.website} target="_blank" rel="noreferrer">{p.website.replace(/^https?:\/\//, "")}</a> : <span className="muted">None listed</span>}</dd>
+          <dt>Phone</dt><dd>{p.phone || <span className="muted">—</span>}</dd>
+          <dt>Business email</dt><dd>{p.business_email || <span className="muted">Not found yet</span>}</dd>
+          <dt>Status</dt><dd><select className="select" aria-label="Status" value={p.status} onChange={(e) => act("status", () => api(`/api/prospecting/${id}`, { method: "PATCH", body: { status: e.target.value } }), "Status updated.")}>{STATUS.map((s) => <option key={s} value={s}>{s}</option>)}</select></dd>
+        </div>
+        <div className="stack" style={{ gap: 4 }}>
+          <strong className="small">Why this score</strong>
+          {p.score_factors.map((f) => <div key={f.key} className="factor"><span className="small">{f.label}<div className="tiny muted">{f.detail}</div></span><span className="small muted" style={{ flex: "none" }}>{f.points}/{f.max}</span></div>)}
+          {data.readiness.map((r) => <span key={r} className="tiny" style={{ color: "var(--warn)" }}>• {r}</span>)}
+        </div>
+        <div className="inline-actions">
+          {p.website && <button className="btn btn-sm" disabled={!!busy || p.audit_status === "running"} onClick={() => act("audit", async () => { await api("/api/prospecting/audit", { body: { ids: [id] } }); }, "Audit finished.")}>{busy === "audit" ? <span className="spin spin-dark" /> : p.audited_at ? "Re-audit website" : "Audit website"}</button>}
+          {!p.contact_id ? <button className="btn btn-sm" disabled={!!busy} onClick={() => act("crm", () => api(`/api/prospecting/${id}`, { body: { action: "convert" } }), "Added to the CRM.")}>Add to CRM</button>
+            : <a className="btn btn-sm" href={`/crm/contacts/${p.contact_id}`}>Open in CRM</a>}
+          {!p.do_not_contact && p.business_email && drafts.length === 0 && <button className="btn btn-sm btn-primary" disabled={!!busy} onClick={() => act("draft", () => api("/api/prospecting/outreach", { body: { prospect_id: id } }), "Draft ready below.")}>Draft email</button>}
+          {!p.do_not_contact && <button className="btn btn-sm btn-ghost" disabled={!!busy} onClick={() => { if (window.confirm(`Never contact ${p.name}? Only an admin can undo this.`)) act("dnc", () => api(`/api/prospecting/${id}`, { method: "PATCH", body: { do_not_contact: true, status: "disqualified" } }), "Marked do-not-contact."); }}>Do not contact</button>}
+          {p.do_not_contact && canManage && <button className="btn btn-sm btn-ghost" onClick={() => act("dnc", () => api(`/api/prospecting/${id}`, { method: "PATCH", body: { do_not_contact: false } }), "Cleared.")}>Allow contact (admin)</button>}
+        </div>
+        {p.audit_status === "failed" && <span className="tiny" style={{ color: "var(--bad)" }}>Last audit failed: {p.audit_error}</span>}
+        {!p.business_email && !p.do_not_contact && (
+          <div className="row"><label className="sr-only" htmlFor="pe-email">Business email</label><input id="pe-email" className="input" placeholder="info@business.com" value={email} onChange={(e) => setEmail(e.target.value)} />
+            <button className="btn btn-sm" disabled={!email.includes("@")} onClick={() => act("email", () => api(`/api/prospecting/${id}`, { method: "PATCH", body: { business_email: email.trim() } }), "Email saved.")}>Save email</button></div>
+        )}
+        {p.emails.length > 1 && <div className="tiny muted">Also found: {p.emails.slice(1).map((e) => e.email).join(", ")}</div>}
+        {audit && <div className="stack" style={{ gap: 4 }}>
+          <strong className="small">Website audit {audit.grade && <span className="pill pill-neutral">Grade {audit.grade}</span>} <span className="tiny muted">{relativeTime(audit.created_at)}</span></strong>
+          {audit.findings.slice(0, 6).map((f, i) => <div key={i} className="small"><span className={`pill ${f.status === "fail" ? "pill-bad" : "pill-warn"}`}>{f.status}</span> {f.label}<div className="tiny muted">{f.client}</div></div>)}
+        </div>}
+        {drafts.map((m) => <Draft key={m.id} m={m} onChanged={refresh} toast={toast} />)}
+        {history.length > 0 && <div className="stack" style={{ gap: 4 }}><strong className="small">Emails</strong>
+          {history.map((m) => <div key={m.id} className="small row" style={{ justifyContent: "space-between" }}><span style={{ minWidth: 0 }}>{m.subject}<div className="tiny muted">{m.error || (m.sent_at ? `Sent ${relativeTime(m.sent_at)} to ${m.to_address}` : m.status)}</div></span><span className={`pill ${m.status === "sent" ? "pill-ok" : m.status === "failed" ? "pill-bad" : "pill-neutral"}`}>{m.status}</span></div>)}
+        </div>}
+        <div className="field"><label htmlFor="pn">Notes</label><textarea id="pn" className="textarea" rows={2} value={notes ?? p.notes ?? ""} maxLength={4000} onChange={(e) => setNotes(e.target.value)} />
+          {notes !== null && notes !== (p.notes ?? "") && <div><button className="btn btn-sm" onClick={() => act("notes", () => api(`/api/prospecting/${id}`, { method: "PATCH", body: { notes: notes.trim() || null } }), "Notes saved.")}>Save notes</button></div>}</div>
+      </div>
+    </div>
+  );
+}
+
+function AddManual({ onAdded, toast }: { onAdded: (id: string) => void; toast: (m: string) => void }) {
+  const [open, setOpen] = useState(false);
+  const [error, setError] = useState("");
+  if (!open) return <button className="btn btn-sm" onClick={() => setOpen(true)}>Add a business</button>;
+  return (
+    <form className="card card-pad stack" noValidate onSubmit={async (e) => {
+      e.preventDefault(); setError("");
+      const f = new FormData(e.currentTarget);
+      const v = (k: string) => String(f.get(k) || "").trim() || undefined;
+      try {
+        const r = await api<{ prospect: { id: string } }>("/api/prospecting", { body: { name: v("name"), website: v("website"), phone: v("phone"), city: v("city"), category: v("category"), business_email: v("email") } });
+        toast("Added."); setOpen(false); onAdded(r.prospect.id);
+      } catch (err) { setError(err instanceof Error ? err.message : "Could not add."); }
+    }}>
+      <div className="field-grid">
+        <div className="field"><label htmlFor="am-name">Business name</label><input id="am-name" name="name" className="input" required maxLength={160} /></div>
+        <div className="field"><label htmlFor="am-web">Website</label><input id="am-web" name="website" className="input" maxLength={500} /></div>
+        <div className="field"><label htmlFor="am-phone">Phone</label><input id="am-phone" name="phone" className="input" maxLength={40} /></div>
+        <div className="field"><label htmlFor="am-email">Business email</label><input id="am-email" name="email" type="email" className="input" maxLength={254} /></div>
+        <div className="field"><label htmlFor="am-cat">Type</label><input id="am-cat" name="category" className="input" maxLength={80} /></div>
+        <div className="field"><label htmlFor="am-city">City</label><input id="am-city" name="city" className="input" maxLength={100} /></div>
+      </div>
+      {error && <p className="form-error" role="alert">{error}</p>}
+      <div className="row"><button className="btn btn-sm btn-primary">Add</button><button type="button" className="btn btn-sm btn-ghost" onClick={() => setOpen(false)}>Cancel</button></div>
+    </form>
+  );
+}
+
+function LeadFinder({ org }: { org: Org }) {
+  const [filters, setFilters] = useState<Record<string, string>>({});
+  const [q, setQ] = useState("");
+  const [debounced, setDebounced] = useState("");
+  useEffect(() => { const t = setTimeout(() => setDebounced(q), 250); return () => clearTimeout(t); }, [q]);
+  const query = new URLSearchParams({ ...filters, ...(debounced ? { q: debounced } : {}) }).toString();
+  const { data, error, loading, reload } = useResource<List>(`/api/prospecting?${query}`);
+  const [selected, setSelected] = useState<Set<string>>(new Set());
+  const [open, setOpen] = useState<string | null>(null);
+  const [auditing, setAuditing] = useState<{ done: number; remaining: number } | null>(null);
+  const { toast, node } = useToast();
+  const canManage = atLeast(org.role, "manager");
+  const toggleFilter = (k: string, v = "1") => setFilters((f) => { const n = { ...f }; if (n[k] === v) delete n[k]; else n[k] = v; return n; });
+  const auditSelected = async () => {
+    let ids: string[] | undefined = [...selected];
+    let done = 0;
+    setAuditing({ done: 0, remaining: ids.length });
+    try {
+      for (let i = 0; i < 100; i++) {
+        const r = await api<{ audited: number; remaining: number }>("/api/prospecting/audit", { body: { ids } });
+        ids = undefined;
+        done += r.audited;
+        setAuditing({ done, remaining: r.remaining });
+        if (!r.remaining || (!r.audited && i > 0)) break;
+      }
+      toast(`Audited ${done} website${done === 1 ? "" : "s"}.`);
+    } catch (e) { toast(e instanceof Error ? e.message : "Audit stopped."); }
+    finally { setAuditing(null); setSelected(new Set()); reload(); }
+  };
+  if (!data && loading) return <Loading />;
+  if (error && !data) return <ErrorState message={error} onRetry={reload} />;
+  if (!data) return null;
+  return (
+    <div className="stack">
+      <Search categories={data.categories} onDone={() => { setFilters({}); reload(); }} toast={toast} />
+      <div className="lf-grid">
+        <div className="stack">
+          <div className="row" style={{ flexWrap: "wrap", gap: 6 }}>
+            <label className="sr-only" htmlFor="lf-q">Search saved businesses</label>
+            <input id="lf-q" className="input" style={{ maxWidth: 220 }} placeholder="Search by name" value={q} onChange={(e) => setQ(e.target.value)} />
+            {FILTERS.map(([k, l]) => <button key={k} className={`chip ${filters[k] ? "on" : ""}`} onClick={() => toggleFilter(k)}>{l}</button>)}
+            <select className="select" aria-label="Minimum score" style={{ width: "auto" }} value={filters.min_score || ""} onChange={(e) => setFilters((f) => { const n = { ...f }; if (e.target.value) n.min_score = e.target.value; else delete n.min_score; return n; })}>
+              <option value="">Any score</option><option value="35">Score 35+</option><option value="60">Score 60+</option></select>
+            <select className="select" aria-label="Status" style={{ width: "auto" }} value={filters.status || ""} onChange={(e) => setFilters((f) => { const n = { ...f }; if (e.target.value) n.status = e.target.value; else delete n.status; return n; })}>
+              <option value="">Active (not disqualified)</option>{STATUS.map((s) => <option key={s} value={s}>{s}</option>)}</select>
+          </div>
+          <div className="card">
+            <div className="card-head"><div><h3>Prospects</h3><div className="sub">{data.total} saved · highest opportunity first</div></div>
+              <div className="row" style={{ gap: 6, flexWrap: "wrap" }}>
+                {selected.size > 0 && <button className="btn btn-sm btn-primary" disabled={!!auditing} onClick={auditSelected}>{auditing ? `Auditing… ${auditing.done} done, ${auditing.remaining} left` : `Audit ${selected.size}`}</button>}
+                {selected.size > 0 && canManage && <button className="btn btn-sm btn-danger" onClick={async () => { if (!window.confirm(`Delete ${selected.size} prospect(s)?`)) return; try { await api("/api/prospecting", { method: "DELETE", body: { ids: [...selected] } }); setSelected(new Set()); if (open && selected.has(open)) setOpen(null); reload(); } catch (e) { toast(e instanceof Error ? e.message : "Failed."); } }}>Delete</button>}
+                <AddManual onAdded={(id) => { reload(); setOpen(id); }} toast={toast} />
+              </div></div>
+            {data.rows.length === 0 ? <div className="empty"><h3>{Object.keys(filters).length || debounced ? "Nothing matches these filters" : "No prospects yet"}</h3><p className="small">Search a business type and city above to fill your list.</p></div> : (
+              <div className="table-wrap"><table>
+                <thead><tr><th style={{ width: 32 }}><input type="checkbox" aria-label="Select all" checked={data.rows.every((r) => selected.has(r.id))} onChange={(e) => setSelected(e.target.checked ? new Set(data.rows.map((r) => r.id)) : new Set())} /></th><th>Business</th><th>Score</th><th>Signals</th><th>Status</th></tr></thead>
+                <tbody>{data.rows.map((p) => (
+                  <tr key={p.id} className={`lf-row ${open === p.id ? "on" : ""}`} onClick={() => setOpen(p.id)}>
+                    <td onClick={(e) => e.stopPropagation()}><input type="checkbox" aria-label={`Select ${p.name}`} checked={selected.has(p.id)} onChange={() => setSelected((s) => { const n = new Set(s); if (n.has(p.id)) n.delete(p.id); else n.add(p.id); return n; })} /></td>
+                    <td className="small"><strong>{p.name}</strong><div className="tiny muted">{[p.category, p.city].filter(Boolean).join(" · ")}</div></td>
+                    <td><span className={`pill ${scorePill(p.opportunity_score)}`}>{p.opportunity_score}</span></td>
+                    <td><span className="sig">
+                      {!p.website && <span className="pill pill-warn">No website</span>}
+                      {p.website_grade && <span className="pill pill-neutral">Site {p.website_grade}</span>}
+                      {p.ssl_ok === false && <span className="pill pill-bad">Not secure</span>}
+                      {p.has_booking === false && <span className="pill pill-neutral">No booking</span>}
+                      {p.website && p.audit_status !== "done" && <span className="pill pill-neutral">{p.audit_status === "queued" || p.audit_status === "running" ? "Auditing…" : p.audit_status === "failed" ? "Audit failed" : "Not audited"}</span>}
+                      {p.business_email && <span className="pill pill-info">Email</span>}
+                      {p.do_not_contact && <span className="pill pill-bad">Do not contact</span>}
+                    </span></td>
+                    <td><span className={`pill ${STATUS_PILL[p.status]}`}>{p.status}</span></td>
+                  </tr>
+                ))}</tbody>
+              </table></div>
+            )}
+          </div>
+          <OutreachSettings canManage={atLeast(org.role, "admin")} toast={toast} />
+        </div>
+        <div>{open ? <ProspectPanel id={open} canManage={atLeast(org.role, "admin")} onChanged={reload} toast={toast} /> : (
+          <div className="card card-pad small muted">Select a business to see why it scored as it did, audit its website, add it to the CRM or draft an email.</div>
+        )}</div>
+      </div>
+      {node}
+    </div>
+  );
+}
+
+export default function LeadFinderPage() {
+  return (
+    <TenantGate title="Lead Finder" subtitle="Find local businesses that need help, see why, and reach out the right way.">
+      {(info) => <LeadFinder org={info.org} />}
+    </TenantGate>
+  );
+}
