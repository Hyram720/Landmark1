diff --git a/supabase/migrations/20261015120000_web_chat.sql b/supabase/migrations/20261015120000_web_chat.sql
new file mode 100644
index 0000000..4e5f22f
--- /dev/null
+++ b/supabase/migrations/20261015120000_web_chat.sql
@@ -0,0 +1,126 @@
+-- Website chat: an embeddable AI chat (the same receptionist rules as the
+-- phone agent) with hand-off to the team.
+--   * Visitors are identified only by a random ID kept in their browser;
+--     the database stores its SHA-256 hash.
+--   * Conversations and AI replies are written by the server; staff reply
+--     as themselves. Each AI reply is metered as an AI request.
+
+create table public.chat_widgets (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  name text not null default 'Website chat' check (length(btrim(name)) between 1 and 80),
+  public_token text not null unique default encode(extensions.gen_random_bytes(12), 'hex'),
+  greeting text not null default 'Hi! How can we help you today?' check (length(btrim(greeting)) between 2 and 300),
+  color text not null default '#f97316' check (color ~ '^#[0-9a-fA-F]{6}$'),
+  position text not null default 'right' check (position in ('right', 'left')),
+  calendar_id uuid,
+  ai_enabled boolean not null default true,
+  status text not null default 'active' check (status in ('active', 'disabled')),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (id, organization_id),
+  foreign key (calendar_id, organization_id) references public.calendars(id, organization_id) on delete set null (calendar_id)
+);
+create trigger chat_widgets_updated before update on public.chat_widgets for each row execute function public.tg_set_updated_at();
+
+create or replace function public.tg_chat_widgets_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user in ('authenticated', 'anon') then
+    if tg_op = 'INSERT' then new.public_token := encode(extensions.gen_random_bytes(12), 'hex');
+    elsif new.public_token <> old.public_token then raise exception 'The chat address cannot be changed; create a new chat widget instead.' using errcode = '42501';
+    end if;
+  end if;
+  return new;
+end $$;
+create trigger chat_widgets_guard before insert or update on public.chat_widgets for each row execute function public.tg_chat_widgets_guard();
+
+create table public.web_chats (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null references public.organizations(id) on delete cascade,
+  widget_id uuid not null,
+  visitor_hash text not null check (visitor_hash ~ '^[0-9a-f]{64}$'),
+  contact_id uuid,
+  status text not null default 'open' check (status in ('open', 'closed')),
+  needs_human boolean not null default false,
+  ai_paused boolean not null default false,
+  page_url text check (length(page_url) <= 500),
+  last_message_at timestamptz not null default now(),
+  last_preview text check (length(last_preview) <= 200),
+  unread_for_staff integer not null default 0 check (unread_for_staff >= 0),
+  created_at timestamptz not null default now(),
+  unique (id, organization_id),
+  foreign key (widget_id, organization_id) references public.chat_widgets(id, organization_id) on delete cascade,
+  foreign key (contact_id, organization_id) references public.contacts(id, organization_id) on delete set null (contact_id)
+);
+create unique index web_chats_open on public.web_chats(widget_id, visitor_hash) where status = 'open';
+create index web_chats_org_idx on public.web_chats(organization_id, last_message_at desc);
+
+-- Staff may close/reopen, take over from the AI and link a contact.
+create or replace function public.tg_web_chats_guard() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  if current_user not in ('authenticated', 'anon') then return new; end if;
+  if tg_op = 'INSERT' then raise exception 'Chats are started by visitors.' using errcode = '42501'; end if;
+  if (to_jsonb(new) - array['status', 'needs_human', 'ai_paused', 'contact_id', 'unread_for_staff']) is distinct from (to_jsonb(old) - array['status', 'needs_human', 'ai_paused', 'contact_id', 'unread_for_staff']) then
+    raise exception 'Only the status, hand-off and contact of a chat can be changed.' using errcode = '42501';
+  end if;
+  if new.unread_for_staff > old.unread_for_staff then raise exception 'Not allowed.' using errcode = '42501'; end if;
+  return new;
+end $$;
+create trigger web_chats_guard before insert or update on public.web_chats for each row execute function public.tg_web_chats_guard();
+
+create table public.web_chat_messages (
+  id uuid primary key default gen_random_uuid(),
+  organization_id uuid not null,
+  chat_id uuid not null,
+  role text not null check (role in ('visitor', 'assistant', 'staff')),
+  body text not null check (length(btrim(body)) between 1 and 4000),
+  created_by uuid,
+  created_at timestamptz not null default now(),
+  foreign key (chat_id, organization_id) references public.web_chats(id, organization_id) on delete cascade
+);
+create index web_chat_messages_chat_idx on public.web_chat_messages(chat_id, created_at);
+
+-- People can only post staff replies as themselves; AI replies are metered.
+create or replace function public.tg_web_chat_messages() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare v_api boolean := coalesce(current_setting('role', true), '') in ('authenticated', 'anon');
+begin
+  if tg_op = 'UPDATE' or tg_op = 'DELETE' then raise exception 'Chat messages cannot be changed.' using errcode = '42501'; end if;
+  if v_api then
+    if new.role <> 'staff' then raise exception 'People can only post staff replies.' using errcode = '42501'; end if;
+    new.created_by := auth.uid();
+  end if;
+  if new.role = 'assistant' then
+    perform public.check_plan_limit(new.organization_id, 'ai_request');
+    insert into public.usage_events(organization_id, metric, ref) values (new.organization_id, 'ai_request', new.chat_id::text);
+  end if;
+  update public.web_chats set last_message_at = now(), last_preview = left(new.body, 200),
+    unread_for_staff = case when new.role = 'visitor' then unread_for_staff + 1 else unread_for_staff end,
+    -- A staff reply takes over the conversation from the AI.
+    ai_paused = ai_paused or new.role = 'staff'
+   where id = new.chat_id;
+  return new;
+end $$;
+create trigger web_chat_messages_write before insert or update or delete on public.web_chat_messages
+  for each row execute function public.tg_web_chat_messages();
+
+alter table public.chat_widgets enable row level security;
+alter table public.web_chats enable row level security;
+alter table public.web_chat_messages enable row level security;
+create policy chat_widgets_read on public.chat_widgets for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy chat_widgets_write on public.chat_widgets for all to authenticated using (public.org_rank(organization_id) >= 3) with check (public.org_rank(organization_id) >= 3);
+create policy web_chats_read on public.web_chats for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy web_chats_update on public.web_chats for update to authenticated using (public.org_rank(organization_id) >= 2) with check (public.org_rank(organization_id) >= 2);
+create policy web_chats_delete on public.web_chats for delete to authenticated using (public.org_rank(organization_id) >= 3);
+create policy web_chat_messages_read on public.web_chat_messages for select to authenticated using (public.org_rank(organization_id) >= 1);
+create policy web_chat_messages_staff on public.web_chat_messages for insert to authenticated with check (public.org_rank(organization_id) >= 2);
+
+revoke all on public.chat_widgets, public.web_chats, public.web_chat_messages from anon, authenticated;
+grant select, insert, update, delete on public.chat_widgets to authenticated;
+grant select (id, organization_id, widget_id, contact_id, status, needs_human, ai_paused, page_url, last_message_at, last_preview, unread_for_staff, created_at) on public.web_chats to authenticated;
+grant update (status, needs_human, ai_paused, contact_id, unread_for_staff), delete on public.web_chats to authenticated;
+grant select, insert on public.web_chat_messages to authenticated;
+grant all on public.chat_widgets, public.web_chats, public.web_chat_messages to service_role;
+revoke execute on function public.tg_web_chat_messages() from public, anon, authenticated;
