+// The one-line website embed: <script src="https://<console>/w/embed/<token>.js" async></script>
+// Adds a chat button that opens the chat in an iframe served from this console.
+import { publicBaseUrl } from "@/lib/supabase/system";
+
+export const dynamic = "force-dynamic";
+
+export async function GET(req: Request, { params }: { params: Promise<{ file: string }> }) {
+  const token = (await params).file.replace(/\.js$/, "");
+  if (!/^[0-9a-f]{24}$/.test(token)) return new Response("// unknown chat", { status: 404, headers: { "Content-Type": "text/javascript" } });
+  const origin = publicBaseUrl(req) || new URL(req.url).origin;
+  const js = `(function(){if(window.__sunChat)return;window.__sunChat=1;var o=${JSON.stringify(origin)},t=${JSON.stringify(token)};
+fetch(o+"/api/public/chat/"+t).then(function(r){return r.ok?r.json():null}).then(function(c){if(!c)return;
+var side=c.position==="left"?"left":"right",color=/^#[0-9a-fA-F]{6}$/.test(c.color)?c.color:"#f97316";
+var b=document.createElement("button");b.type="button";b.setAttribute("aria-label","Chat with us");
+b.style.cssText="position:fixed;bottom:20px;"+side+":20px;width:58px;height:58px;border-radius:50%;border:0;background:"+color+";color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.25);cursor:pointer;z-index:2147483646;display:flex;align-items:center;justify-content:center";
+b.innerHTML='<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H8l-4 4z"/></svg>';
+var f=null;function close(){if(f){f.remove();f=null;b.style.display="flex"}}
+b.onclick=function(){if(f)return close();f=document.createElement("iframe");f.src=o+"/w/chat/"+t+"?embed=1&page="+encodeURIComponent(location.href.slice(0,400));f.title="Chat";
+var m=window.innerWidth<520;f.style.cssText="position:fixed;z-index:2147483647;border:0;background:#fff;box-shadow:0 12px 40px rgba(0,0,0,.25);"+(m?"inset:0;width:100%;height:100%;":"bottom:90px;"+side+":20px;width:380px;height:580px;max-height:calc(100vh - 110px);border-radius:16px;");
+document.body.appendChild(f);if(m)b.style.display="none"};
+window.addEventListener("message",function(e){if(e.origin===o&&e.data&&e.data.type==="sun-chat-close")close()});
+document.body.appendChild(b)})})();`;
+  return new Response(js, { headers: { "Content-Type": "text/javascript; charset=utf-8", "Cache-Control": "public, max-age=300", "Access-Control-Allow-Origin": "*" } });
+}
