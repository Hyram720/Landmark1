+"use client";
+import { use, useEffect, useRef, useState } from "react";
+
+type Msg = { role: "visitor" | "assistant" | "staff"; body: string; created_at: string };
+type Config = { business: string; greeting: string; color: string; messages: Msg[]; waiting: boolean };
+
+function visitorId() {
+  const key = "sun-chat-visitor";
+  try {
+    const have = localStorage.getItem(key);
+    if (have && /^[A-Za-z0-9_-]{22,64}$/.test(have)) return have;
+    const bytes = crypto.getRandomValues(new Uint8Array(24));
+    const id = btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+    localStorage.setItem(key, id);
+    return id;
+  } catch {
+    return Array.from(crypto.getRandomValues(new Uint8Array(24)), (b) => b.toString(16).padStart(2, "0")).join("");
+  }
+}
+
+// The chat window shown inside the website's iframe (or opened directly).
+export default function ChatWindow({ params }: { params: Promise<{ token: string }> }) {
+  const { token } = use(params);
+  const [cfg, setCfg] = useState<Config | null>(null);
+  const [missing, setMissing] = useState(false);
+  const [msgs, setMsgs] = useState<Msg[]>([]);
+  const [text, setText] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [embedded, setEmbedded] = useState(false);
+  const vid = useRef("");
+  const page = useRef("");
+  const end = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    vid.current = visitorId();
+    const q = new URLSearchParams(window.location.search);
+    setEmbedded(q.get("embed") === "1");
+    page.current = q.get("page") || document.referrer || "";
+    document.documentElement.style.background = "#fff";
+    document.body.style.background = "#fff";
+    document.body.style.margin = "0";
+    fetch(`/api/public/chat/${token}?v=${vid.current}`, { cache: "no-store" }).then((r) => (r.ok ? r.json() : Promise.reject())).then((c: Config) => { setCfg(c); setMsgs(c.messages); }).catch(() => setMissing(true));
+  }, [token]);
+  // Picks up replies from the team while the window is open.
+  useEffect(() => {
+    if (!cfg || !msgs.length) return;
+    const t = setInterval(() => {
+      fetch(`/api/public/chat/${token}?v=${vid.current}`, { cache: "no-store" }).then((r) => (r.ok ? r.json() : null)).then((c: Config | null) => { if (c && c.messages.length > msgs.length) setMsgs(c.messages); }).catch(() => undefined);
+    }, 6000);
+    return () => clearInterval(t);
+  }, [cfg, msgs.length, token]);
+  useEffect(() => { end.current?.scrollIntoView({ block: "end" }); }, [msgs, busy]);
+  if (missing) return <div style={{ padding: 20, fontFamily: "system-ui", color: "#555" }}>This chat isn&apos;t available.</div>;
+  if (!cfg) return <div style={{ padding: 20 }} />;
+  const send = async () => {
+    const body = text.trim();
+    if (!body || busy) return;
+    setBusy(true); setText(""); setNotice(null);
+    setMsgs((m) => [...m, { role: "visitor", body, created_at: new Date().toISOString() }]);
+    try {
+      const r = await fetch(`/api/public/chat/${token}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ visitor_id: vid.current, message: body, page_url: page.current.slice(0, 500) || undefined }) });
+      const j = await r.json();
+      if (!r.ok) { setNotice(j.error || "Message not sent. Try again."); return; }
+      setMsgs(j.messages); setNotice(j.notice);
+    } catch { setNotice("Message not sent. Check your connection and try again."); }
+    finally { setBusy(false); }
+  };
+  const bubble = (m: Msg, i: number) => {
+    const mine = m.role === "visitor";
+    return (
+      <div key={i} style={{ display: "flex", justifyContent: mine ? "flex-end" : "flex-start", margin: "6px 0" }}>
+        <div style={{ maxWidth: "82%", padding: "9px 12px", borderRadius: 14, fontSize: 14.5, lineHeight: 1.45, whiteSpace: "pre-wrap", background: mine ? cfg.color : "#f1f0ed", color: mine ? "#fff" : "#1f2328", borderBottomRightRadius: mine ? 4 : 14, borderBottomLeftRadius: mine ? 14 : 4 }}>
+          {m.role === "staff" && <div style={{ fontSize: 11, fontWeight: 700, opacity: 0.7, marginBottom: 2 }}>Team member</div>}
+          {m.body}
+        </div>
+      </div>
+    );
+  };
+  return (
+    <div style={{ fontFamily: "Inter, system-ui, -apple-system, Segoe UI, sans-serif", height: "100vh", display: "flex", flexDirection: "column", background: "#fff", color: "#1f2328" }}>
+      <header style={{ background: cfg.color, color: "#fff", padding: "14px 16px", display: "flex", alignItems: "center", justifyContent: "space-between" }}>
+        <div><div style={{ fontWeight: 700 }}>{cfg.business}</div><div style={{ fontSize: 12, opacity: 0.9 }}>Usually replies in seconds</div></div>
+        {embedded && <button type="button" aria-label="Close chat" onClick={() => window.parent.postMessage({ type: "sun-chat-close" }, "*")} style={{ background: "transparent", border: 0, color: "#fff", fontSize: 22, cursor: "pointer", lineHeight: 1 }}>×</button>}
+      </header>
+      <div role="log" aria-live="polite" style={{ flex: 1, overflowY: "auto", padding: "10px 12px" }}>
+        {bubble({ role: "assistant", body: cfg.greeting, created_at: "" }, -1)}
+        {msgs.map(bubble)}
+        {busy && <div style={{ fontSize: 13, color: "#8a8378", margin: "6px 4px" }}>Typing…</div>}
+        {notice && <div style={{ fontSize: 12.5, color: "#6b6459", background: "#faf7f0", borderRadius: 10, padding: "8px 10px", margin: "8px 0" }}>{notice}</div>}
+        <div ref={end} />
+      </div>
+      <form onSubmit={(e) => { e.preventDefault(); send(); }} style={{ display: "flex", gap: 8, padding: 10, borderTop: "1px solid #ebe7df" }}>
+        <label htmlFor="chat-input" style={{ position: "absolute", left: -9999 }}>Message</label>
+        <input id="chat-input" value={text} onChange={(e) => setText(e.target.value)} maxLength={1000} placeholder="Type a message…" autoComplete="off" style={{ flex: 1, border: "1px solid #ddd8ce", borderRadius: 999, padding: "10px 14px", fontSize: 15, outline: "none" }} />
+        <button type="submit" disabled={busy || !text.trim()} style={{ background: cfg.color, color: "#fff", border: 0, borderRadius: 999, padding: "0 16px", fontWeight: 600, cursor: "pointer", opacity: busy || !text.trim() ? 0.6 : 1 }}>Send</button>
+      </form>
+      <div style={{ textAlign: "center", fontSize: 11, color: "#9a9389", paddingBottom: 8 }}>AI assistant · a person can take over anytime</div>
+    </div>
+  );
+}
