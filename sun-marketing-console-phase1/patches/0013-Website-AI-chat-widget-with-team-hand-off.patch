+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { ApiError } from "@/lib/tenant/api";
+import { availability, book, findOrCreateContact, loadCalendar, notifyAppointment } from "@/lib/calendar/service";
+import { formatInZone, localDate } from "@/lib/time/zones";
+
+// What an AI receptionist (phone or website chat) may do for a business.
+// Shared so both channels follow the same rules: facts only from approved
+// knowledge, bookings only at offered times, messages become call-back tasks.
+type Person = { first_name?: string; last_name?: string; email?: string; phone?: string };
+const LONG: Intl.DateTimeFormatOptions = { weekday: "long", month: "long", day: "numeric", hour: "numeric", minute: "2-digit" };
+
+export async function businessInfo(system: SupabaseClient, orgId: string, question: string) {
+  const { data } = await system.rpc("search_knowledge", { p_org: orgId, p_query: question.slice(0, 300), p_limit: 4 });
+  let items = (data || []) as { title: string; body: string }[];
+  if (!items.length) {
+    const { data: any } = await system.from("knowledge_items").select("title, body").eq("organization_id", orgId).eq("status", "approved").limit(6);
+    items = (any || []) as { title: string; body: string }[];
+  }
+  if (!items.length) return "There is no approved information about that. Don't guess; offer to take a message so the team can answer.";
+  return items.map((i) => `${i.title}: ${i.body}`).join("\n").slice(0, 2000);
+}
+
+export async function calendarFor(system: SupabaseClient, orgId: string, calendarId: string | null) {
+  if (calendarId) return calendarId;
+  const { data } = await system.from("calendars").select("id").eq("organization_id", orgId).eq("status", "active").order("created_at").limit(1).maybeSingle();
+  return (data?.id as string | undefined) ?? null;
+}
+
+export async function openTimes(system: SupabaseClient, orgId: string, calendarId: string | null, date: string, now = new Date()) {
+  const calId = await calendarFor(system, orgId, calendarId);
+  if (!calId) return "Online booking isn't set up. Offer to take a message instead.";
+  const { calendar } = await loadCalendar(system, orgId, calId);
+  const today = localDate(now, calendar.timezone);
+  const day = /^\d{4}-\d{2}-\d{2}$/.test(date) && date >= today ? date : today;
+  const { slots } = await availability(system, orgId, calId, day, 5, now);
+  if (!slots.length) return "No open times in the next few days. Offer to take a message so the team can follow up.";
+  const list = slots.slice(0, 8).map((s) => ({ label: formatInZone(s.start, calendar.timezone, LONG), start: s.start }));
+  return JSON.stringify({ timezone: calendar.timezone, slots: list, note: "Offer two or three labels. When booking, pass the matching start value exactly." });
+}
+
+export async function contactFor(system: SupabaseClient, orgId: string, existing: string | null, p: Person, source: string) {
+  if (existing) return existing;
+  if (!p.phone && !p.email && !p.first_name) return null;
+  return findOrCreateContact({ client: system, orgId, userId: null }, { first_name: p.first_name || "Customer", last_name: p.last_name, email: p.email || "", phone: p.phone }, source);
+}
+
+export async function bookSlot(system: SupabaseClient, orgId: string, calendarId: string | null, contactId: string, start: string, reason: string, now = new Date()) {
+  const calId = await calendarFor(system, orgId, calendarId);
+  if (!calId) return { text: "Online booking isn't set up. Offer to take a message instead.", appointmentId: null };
+  const ctx = { client: system, orgId, userId: null };
+  try {
+    const { appointment, calendar } = await book(ctx, { calendar_id: calId, contact_id: contactId, starts_at: start, notes: reason || undefined }, "ai", now);
+    await notifyAppointment(ctx, appointment, calendar, "booked", { system: true }).catch(() => null);
+    return { text: `Booked for ${formatInZone(appointment.starts_at, calendar.timezone, LONG)}. A confirmation is sent when possible.`, appointmentId: appointment.id as string };
+  } catch (e) {
+    return { text: e instanceof ApiError ? `${e.message} Check open times again and offer others.` : "Booking failed. Offer to take a message instead.", appointmentId: null };
+  }
+}
+
+export async function takeMessage(system: SupabaseClient, orgId: string, contactId: string | null, who: string, contactLine: string | null, reason: string, now = new Date()) {
+  await system.from("tasks").insert({
+    organization_id: orgId, title: `Call back ${who}${contactLine ? ` (${contactLine})` : ""}`.slice(0, 200), description: reason.slice(0, 4000),
+    priority: "high", due_at: new Date(now.getTime() + 2 * 3600e3).toISOString(), contact_id: contactId,
+  });
+  return "Message taken. Tell them the team will get back to them as soon as possible.";
+}
