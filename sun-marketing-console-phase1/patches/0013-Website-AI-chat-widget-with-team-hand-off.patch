+import { describe, expect, it } from "vitest";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { FakeDb } from "../support/fake-supabase";
+import type { ChatModel, Completion } from "@/lib/ai/types";
+import { OFFLINE, systemPrompt, visitorHash, visitorInput, visitorSays, widgetByToken } from "@/lib/chat/service";
+import { chatWidgetInput } from "@/lib/chat/widgets";
+
+const ORG = "11111111-1111-4111-8111-111111111111";
+const db = (d: FakeDb) => d as unknown as SupabaseClient;
+const widget = { id: "w1", organization_id: ORG, name: "Chat", greeting: "Hi!", color: "#f97316", position: "right" as const, calendar_id: null, ai_enabled: true, status: "active" };
+const found = { widget, business: "Acme Roofing" };
+const VISITOR = "AbCdEfGhIjKlMnOpQrStUvWx";
+
+function scripted(...steps: Completion[]): ChatModel & { seen: unknown[] } {
+  const seen: unknown[] = [];
+  return { provider: "test", model: "test", seen, async complete(req) { seen.push(req); const s = steps.shift(); if (!s) throw new Error("no more steps"); return s; } };
+}
+const say = (text: string): Completion => ({ content: text, toolCalls: [] });
+const call = (name: string, args: Record<string, unknown>): Completion => ({ content: null, toolCalls: [{ id: `t-${name}`, name, arguments: JSON.stringify(args) }] });
+
+describe("website chat", () => {
+  it("validates visitors and widget settings", () => {
+    expect(visitorInput.safeParse({ visitor_id: "short", message: "hi" }).success).toBe(false);
+    expect(visitorInput.safeParse({ visitor_id: VISITOR, message: "" }).success).toBe(false);
+    expect(visitorInput.safeParse({ visitor_id: VISITOR, message: "x".repeat(1001) }).success).toBe(false);
+    expect(visitorHash(VISITOR)).toMatch(/^[0-9a-f]{64}$/);
+    expect(chatWidgetInput.safeParse({ color: "orange" }).success).toBe(false);
+    expect(systemPrompt("Acme Roofing", new Date("2026-10-07T00:00:00Z"))).toContain("Only state facts");
+  });
+  it("ignores malformed widget tokens", async () => {
+    expect(await widgetByToken(db(new FakeDb()), "../etc")).toBeNull();
+  });
+  it("answers from approved knowledge and stores the conversation", async () => {
+    const d = new FakeDb();
+    d.rpcHandlers.search_knowledge = () => [{ title: "Gutters", body: "We install seamless gutters." }];
+    const model = scripted(call("business_info", { question: "gutters?" }), say("Yes, we install seamless gutters."));
+    const r = await visitorSays(db(d), found, { visitor_id: VISITOR, message: "Do you do gutters?" }, model);
+    expect(r.notice).toBeNull();
+    expect(d.table("web_chat_messages").map((m) => [m.role, m.body])).toEqual([["visitor", "Do you do gutters?"], ["assistant", "Yes, we install seamless gutters."]]);
+    expect(d.table("web_chats")[0]).toMatchObject({ organization_id: ORG, widget_id: "w1", visitor_hash: visitorHash(VISITOR) });
+    const second = (model.seen[1] as { messages: { role: string; content?: string }[] }).messages;
+    expect(second.find((m) => m.role === "tool")?.content).toBe("Gutters: We install seamless gutters.");
+  });
+  it("needs a way to reach the visitor before taking a message, then hands off", async () => {
+    const d = new FakeDb();
