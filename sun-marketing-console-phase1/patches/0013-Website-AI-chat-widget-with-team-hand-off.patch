+-- 2. Chats are written by the server; staff reply as themselves
+select pg_temp.as_user('64000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$insert into public.web_chats(organization_id, widget_id, visitor_hash) values ((select v from ids where k = 'c'), (select v from ids where k = 'w'), repeat('a', 64))$$, 'people cannot start chats as visitors');
+select pg_temp.reset_user();
+select pg_temp.as_service();
+with ch as (insert into public.web_chats(organization_id, widget_id, visitor_hash) values ((select v from ids where k = 'c'), (select v from ids where k = 'w'), repeat('b', 64)) returning id) insert into ids select 'chat', id from ch;
+select pg_temp.expect_error($$insert into public.web_chats(organization_id, widget_id, visitor_hash) values ((select v from ids where k = 'c'), (select v from ids where k = 'w'), repeat('b', 64))$$, 'one open chat per visitor and widget');
+insert into public.web_chat_messages(organization_id, chat_id, role, body) values ((select v from ids where k = 'c'), (select v from ids where k = 'chat'), 'visitor', 'Do you do gutters?');
+insert into public.web_chat_messages(organization_id, chat_id, role, body) values ((select v from ids where k = 'c'), (select v from ids where k = 'chat'), 'assistant', 'Yes, we install and repair gutters.');
+select pg_temp.expect((select unread_for_staff = 1 and last_preview = 'Yes, we install and repair gutters.' from public.web_chats where id = (select v from ids where k = 'chat')), 'chats track unread visitor messages and the latest preview');
+select pg_temp.expect((select count(*) = 1 from public.usage_events where organization_id = (select v from ids where k = 'c') and metric = 'ai_request' and ref = (select v from ids where k = 'chat')::text), 'AI replies are metered');
+select pg_temp.reset_user();
+select pg_temp.as_user('64000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$select visitor_hash from public.web_chats$$, 'visitor identifiers are not readable');
+select pg_temp.expect_error($$insert into public.web_chat_messages(organization_id, chat_id, role, body) values ((select v from ids where k = 'c'), (select v from ids where k = 'chat'), 'assistant', 'fake AI')$$, 'people cannot post as the AI');
