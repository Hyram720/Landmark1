+select pg_temp.reset_user();
+
+-- 1. Widgets
+select pg_temp.as_user('64000000-0000-0000-0000-000000000003');
+select pg_temp.expect_error($$insert into public.chat_widgets(organization_id) values ((select v from ids where k = 'c'))$$, 'members cannot create chat widgets');
