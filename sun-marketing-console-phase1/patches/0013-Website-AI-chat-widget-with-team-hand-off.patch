+insert into public.web_chat_messages(organization_id, chat_id, role, body, created_by) values ((select v from ids where k = 'c'), (select v from ids where k = 'chat'), 'staff', 'Hi, this is Mike. Want a quote?', '64000000-0000-0000-0000-000000000002');
+select pg_temp.expect((select created_by = '64000000-0000-0000-0000-000000000003' from public.web_chat_messages where role = 'staff'), 'staff replies are signed by the sender');
