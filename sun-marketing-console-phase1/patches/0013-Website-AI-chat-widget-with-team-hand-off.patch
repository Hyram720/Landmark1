+select pg_temp.expect((select public_token <> 'mine' and length(public_token) = 24 from public.chat_widgets where id = (select v from ids where k = 'w')), 'chat addresses are random');
+select pg_temp.expect_error($$update public.chat_widgets set color = 'red'$$, 'colors must be hex');
