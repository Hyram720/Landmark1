+import { ApiError, fromDb, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { CHAT_WIDGET_COLUMNS, chatWidgetInput } from "@/lib/chat/widgets";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+
+export const PATCH = tenantRoute<P>("sites.manage", async (ctx, req, { id }) => {
+  const input = await readJson(req, chatWidgetInput.partial());
+  const { data, error } = await ctx.client.from("chat_widgets").update(input).eq("organization_id", ctx.org.id).eq("id", uuid.parse(id)).select(CHAT_WIDGET_COLUMNS).maybeSingle();
+  fromDb(error);
+  if (!data) throw new ApiError("Chat widget not found.", 404, "not_found");
+  return { widget: data };
+});
