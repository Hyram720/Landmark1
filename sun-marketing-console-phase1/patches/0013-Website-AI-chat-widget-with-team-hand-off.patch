@@ -0,0 +1,43 @@
+import { z } from "zod";
+import { ApiError, fromDb, readJson, tenantRoute, uuid } from "@/lib/tenant/api";
+import { audit } from "@/lib/tenant/audit";
+
+export const dynamic = "force-dynamic";
+type P = { id: string };
+const COLUMNS = "id, widget_id, contact_id, status, needs_human, ai_paused, page_url, last_message_at, unread_for_staff, created_at, contacts(first_name, last_name, email, phone)";
+
+export const GET = tenantRoute<P>("crm.read", async (ctx, _req, { id }) => {
+  const cid = uuid.parse(id);
+  const { data: chat, error } = await ctx.client.from("web_chats").select(COLUMNS).eq("organization_id", ctx.org.id).eq("id", cid).maybeSingle();
+  fromDb(error);
+  if (!chat) throw new ApiError("Chat not found.", 404, "not_found");
+  const { data: messages } = await ctx.client.from("web_chat_messages").select("id, role, body, created_by, created_at").eq("organization_id", ctx.org.id).eq("chat_id", cid).order("created_at").limit(300);
+  if (chat.unread_for_staff) await ctx.client.from("web_chats").update({ unread_for_staff: 0 }).eq("organization_id", ctx.org.id).eq("id", cid);
+  return { chat, messages: messages || [] };
+});
+
+const action = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("reply"), text: z.string().trim().min(1).max(4000) }),
+  z.object({ action: z.enum(["close", "reopen", "resume_ai", "handled"]) }),
+  z.object({ action: z.literal("link_contact"), contact_id: uuid }),
+]);
+
+export const POST = tenantRoute<P>("crm.write", async (ctx, req, { id }) => {
+  const cid = uuid.parse(id);
+  const input = await readJson(req, action);
+  if (input.action === "reply") {
+    const { error } = await ctx.client.from("web_chat_messages").insert({ organization_id: ctx.org.id, chat_id: cid, role: "staff", body: input.text });
+    fromDb(error);
+    await ctx.client.from("web_chats").update({ needs_human: false, unread_for_staff: 0 }).eq("organization_id", ctx.org.id).eq("id", cid);
+    return { ok: true };
+  }
+  const patch: Record<string, unknown> = "contact_id" in input ? { contact_id: input.contact_id }
+    : input.action === "close" ? { status: "closed", needs_human: false, unread_for_staff: 0 } : input.action === "reopen" ? { status: "open" }
+    : input.action === "resume_ai" ? { ai_paused: false } : { needs_human: false, unread_for_staff: 0 };
+  const { data, error } = await ctx.client.from("web_chats").update(patch).eq("organization_id", ctx.org.id).eq("id", cid).select("id").maybeSingle();
+  if (error?.code === "23505") throw new ApiError("This visitor already has an open chat.", 409, "conflict");
+  fromDb(error);
+  if (!data) throw new ApiError("Chat not found.", 404, "not_found");
+  await audit(ctx.client, ctx.org.id, `web_chat.${input.action}`, { type: "web_chat", id: cid });
+  return { ok: true };
+});
