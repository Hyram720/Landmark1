@@ -0,0 +1,49 @@
+import { NextResponse } from "next/server";
+import { ApiError, errorResponse, readJson } from "@/lib/tenant/api";
+import { systemClient } from "@/lib/supabase/system";
+import { clientIp, takeLimit } from "@/lib/rate-limit";
+import { getChatModel } from "@/lib/ai/provider";
+import { openChat, visibleMessages, VISITOR_ID, visitorInput, visitorSays, widgetByToken } from "@/lib/chat/service";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+type P = { params: Promise<{ token: string }> };
+
+async function load(token: string) {
+  const system = systemClient();
+  if (!system) throw new ApiError("Chat is not available right now.", 503, "integration_not_configured");
+  const found = await widgetByToken(system, token);
+  if (!found) throw new ApiError("Chat not found.", 404, "not_found");
+  return { system, found };
+}
+
+// Widget settings, plus the visitor's open conversation when ?v=<visitor id>.
+export async function GET(req: Request, { params }: P) {
+  try {
+    if (!(await takeLimit("chat-view", clientIp(req), 240, 600))) throw new ApiError("Too many requests.", 429, "rate_limited");
+    const { system, found } = await load((await params).token);
+    const v = new URL(req.url).searchParams.get("v") || "";
+    const chat = VISITOR_ID.test(v) ? await openChat(system, found.widget, v) : null;
+    const messages = chat ? (await visibleMessages(system, chat.id)).map(({ role, body, created_at }) => ({ role, body, created_at })) : [];
+    return NextResponse.json({ business: found.business, greeting: found.widget.greeting, color: found.widget.color, position: found.widget.position, messages, waiting: !!chat?.needs_human }, { headers: { "Cache-Control": "no-store" } });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
+
+export async function POST(req: Request, { params }: P) {
+  try {
+    const input = await readJson(req, visitorInput);
+    const ip = clientIp(req);
+    if (!(await takeLimit("chat-ip", ip, 40, 600)) || !(await takeLimit("chat-visitor", input.visitor_id, 20, 600))) {
+      throw new ApiError("You're sending messages very quickly. Please wait a moment.", 429, "rate_limited");
+    }
+    const { system, found } = await load((await params).token);
+    const { model } = await getChatModel();
+    const r = await visitorSays(system, found, input, model);
+    const messages = (await visibleMessages(system, r.chat_id)).map(({ role, body, created_at }) => ({ role, body, created_at }));
+    return NextResponse.json({ messages, notice: r.notice }, { headers: { "Cache-Control": "no-store" } });
+  } catch (e) {
+    return errorResponse(e);
+  }
+}
