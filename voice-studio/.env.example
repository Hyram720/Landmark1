# Copy to .env and fill in. Only OPENAI_API_KEY is needed for studio-quality voices.
PORT=5055

# Which engine the server uses: openai | mock (mock = test tones, no key needed)
TTS_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional: require this key on API calls (set it if the studio is reachable
# from other machines, e.g. when Sun Marketing Console runs on a server).
# Callers send it as the header  x-api-key: <key>  or  ?key=<key>
VOICE_API_KEY=

# Where audio, voice profiles and history are stored
DATA_DIR=./data
