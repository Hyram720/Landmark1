# --- Core ---
BASE_URL=https://custompetportraitstudio.com
BRAND_NAME=Custom Pet Portrait Studio
ADMIN_KEY=change-me-to-a-long-random-string
DATA_DIR=/data                     # mount a persistent volume here in production

# --- Payments (Stripe) ---
# Either a secret key (API checkout) OR Payment Links + webhook secret.
STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET is optional with a secret key (auto-created); required with Payment Links.
STRIPE_WEBHOOK_SECRET=
STRIPE_LINK_DIGITAL=               # https://buy.stripe.com/... (metadata product=digital)
STRIPE_LINK_CANVAS_SMALL=          # metadata product=canvas_small
STRIPE_LINK_CANVAS_LARGE=          # metadata product=canvas_large

# --- Image generation ---
# openai (default, current live behavior) | qwen | mock
# Leave this on openai until the Qwen cutover is approved. GPT Image models shut off Dec 1, 2026.
IMAGE_PROVIDER=openai
OPENAI_API_KEY=sk-...
IMAGE_MODEL=gpt-image-1
IMAGE_VARIANTS=4

# Qwen/Qwen-Image-Edit-2511. Used only when IMAGE_PROVIDER=qwen.
# QWEN_BACKEND=hf    Hugging Face router or a dedicated Inference Endpoint (HF_TOKEN)
# QWEN_BACKEND=http  self-hosted server at QWEN_ENDPOINT_URL
# QWEN_HF_PROVIDER=wavespeed (default; Hub maps this model to wavespeed-ai/qwen-image/edit-2511)
#                  fal-ai     (Hub currently maps this model to fal-ai/qwen-image-edit-plus)
# QWEN_HF_URL=       optional full URL. A non-router host is treated as a dedicated Inference Endpoint.
# QWEN_ENDPOINT_TOKEN=  optional bearer token for the self-hosted server
QWEN_BACKEND=hf
HF_TOKEN=
QWEN_HF_PROVIDER=wavespeed
QWEN_HF_URL=
QWEN_MODEL=Qwen/Qwen-Image-Edit-2511
QWEN_ENDPOINT_URL=
QWEN_ENDPOINT_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM=Custom Pet Portrait Studio <studio@custompetportraitstudio.com>
ALERT_EMAIL=you@example.com        # failures get emailed here

# --- Print-on-demand (Printful) ---
PRINTFUL_TOKEN=...
PRINTFUL_AUTO_CONFIRM=false        # true = fully hands-off; false = approve drafts in Printful
PRINTFUL_VARIANT_CANVAS_SMALL=19299   # Printful 12x18 canvas (2:3, matches portrait shape)
PRINTFUL_VARIANT_CANVAS_LARGE=19303   # Printful 16x24 canvas

# --- Pricing (cents) ---
PRICE_DIGITAL=2900
PRICE_CANVAS_SMALL=8900
PRICE_CANVAS_LARGE=12900

# --- Marketing automation (create these promo codes in Stripe) ---
RECOVERY_CODE=COMEBACK15
REFERRAL_CODE=FRIEND20
REVIEW_URL=                        # e.g. your Google Business / Trustpilot review link
