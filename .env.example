# --- Core ---
BASE_URL=https://custompetportraitstudio.com
BRAND_NAME=Custom Pet Portrait Studio
ADMIN_KEY=change-me-to-a-long-random-string
DATA_DIR=/data                     # mount a persistent volume here in production

# --- Payments (Stripe) ---
# Either a secret key (API checkout) OR Payment Links + webhook secret.
STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET is optional with a secret key (auto-created); required with Payment Links.
STRIPE_WEBHOOK_SECRET=
STRIPE_LINK_DIGITAL=               # https://buy.stripe.com/... (metadata product=digital)
STRIPE_LINK_CANVAS_SMALL=          # metadata product=canvas_small
STRIPE_LINK_CANVAS_LARGE=          # metadata product=canvas_large

# --- Image generation ---
IMAGE_PROVIDER=openai              # or "mock" for testing
OPENAI_API_KEY=sk-...
IMAGE_MODEL=gpt-image-1
IMAGE_VARIANTS=4

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM=Custom Pet Portrait Studio <studio@custompetportraitstudio.com>
ALERT_EMAIL=you@example.com        # failures get emailed here

# --- Print-on-demand (Printful) ---
PRINTFUL_TOKEN=...
PRINTFUL_AUTO_CONFIRM=false        # true = fully hands-off; false = approve drafts in Printful
PRINTFUL_VARIANT_CANVAS_SMALL=19299   # Printful 12x18 canvas (2:3, matches portrait shape)
PRINTFUL_VARIANT_CANVAS_LARGE=19303   # Printful 16x24 canvas

# --- Pricing (cents) ---
PRICE_DIGITAL=2900
PRICE_CANVAS_SMALL=8900
PRICE_CANVAS_LARGE=12900

# --- Marketing automation (create these promo codes in Stripe) ---
RECOVERY_CODE=COMEBACK15
REFERRAL_CODE=FRIEND20
REVIEW_URL=                        # e.g. your Google Business / Trustpilot review link
