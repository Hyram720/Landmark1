# --- Core ---
BASE_URL=https://gamedrop.example
BRAND_NAME=GameDrop
ADMIN_KEY=change-me-to-a-long-random-string
DATA_DIR=/data                     # mount a persistent volume here in production

# --- AI editor (optional: without it, issues use template copy) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=GameDrop <drops@gamedrop.example>
ALERT_EMAIL=you@example.com

# --- Schedule (UTC). Default: Thursday 16:00, an hour after Epic's weekly rotation ---
SEND_WEEKDAY=4
SEND_HOUR_UTC=16

# --- Money ---
SPONSOR_TEXT=                      # e.g. "Try XYZ: the AI coding agent for game devs"
SPONSOR_URL=
DEAL_LINK_TEMPLATE=                # optional affiliate wrapper, {url} = encoded deal URL
