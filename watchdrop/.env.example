# --- Core ---
BASE_URL=https://watchdrop.example
BRAND_NAME=WatchDrop
ADMIN_KEY=change-me-to-a-long-random-string
DATA_DIR=/data                     # mount a persistent volume here in production

# --- Streaming data (required): free key at https://developers.movieofthenight.com ---
STREAMING_API_KEY=
STREAMING_API_VIA_RAPIDAPI=false   # true if your key came from rapidapi.com instead
COUNTRY=us
STREAMING_MONTHLY_BUDGET=900       # hard cap; the free plan is 1,000 requests/month
PREVIEW_HOURS=24                   # midweek preview refresh; each build is ~15 requests

# --- AI editor (optional: without it, issues use template copy) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Email (Resend, required to send) ---
RESEND_API_KEY=
EMAIL_FROM=WatchDrop <weekly@watchdrop.example>
ALERT_EMAIL=you@example.com

# --- Schedule (UTC). Default: Thursday 16:00 ---
SEND_WEEKDAY=4
SEND_HOUR_UTC=16

# --- Money ---
SPONSOR_TEXT=
SPONSOR_URL=
