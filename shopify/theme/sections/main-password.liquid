<section class="page" style="min-height:100vh;display:grid;place-items:center;text-align:center">
  <div class="wrap" style="max-width:560px">
    <h1>{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}<p class="form-success">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      <div class="newsletter" style="display:flex;gap:8px;margin:24px 0">
        <input type="email" name="contact[email]" placeholder="you@example.com" aria-label="{{ 'newsletter.label' | t }}" required>
        <button class="btn" type="submit">{{ 'newsletter.subscribe' | t }}</button>
      </div>
    {%- endform -%}
    <details>
      <summary class="muted" style="cursor:pointer">{{ 'general.password_enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="newsletter" style="display:flex;gap:8px;margin-top:12px">
          <input type="password" name="password" aria-label="{{ 'general.password_label' | t }}" autocomplete="current-password">
          <button class="btn btn--ghost" type="submit">{{ 'general.password_submit' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password page" }
{% endschema %}
