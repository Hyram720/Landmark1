<section class="section">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="lookbook">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <article class="look" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 700px) 33vw, 100vw' }}
          {%- elsif p != blank and p.featured_image -%}
            {{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 700px) 33vw, 100vw' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div class="look__body">
            {%- if block.settings.tag != blank -%}<p class="look__tag">{{ block.settings.tag | escape }}</p>{%- endif -%}
            <h3>{{ block.settings.title | default: p.title | escape }}</h3>
            {%- if p != blank -%}
              <div class="row" style="justify-content:space-between">
                <span class="price">{{ p.price | money }}</span>
                <a class="btn btn--small" href="{{ p.url }}">Shop the look</a>
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pro Model Lookbook" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Top Models, <em>Luxury Bootleg Heat</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Styled with silk durags, tilted snapbacks, and heavy gold Cuban link chains.</p>" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image (defaults to product image)" },
        { "type": "text", "id": "tag", "label": "Tag line", "default": "260 GSM · Zero Logo" },
        { "type": "text", "id": "title", "label": "Title (defaults to product title)" }
      ]
    }
  ],
  "presets": [{ "name": "Lookbook" }]
}
{% endschema %}
