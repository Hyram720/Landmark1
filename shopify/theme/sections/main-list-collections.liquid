<section class="page">
  <div class="wrap">
    <div class="section-head"><h1>{{ section.settings.heading | escape }}</h1></div>
    <div class="grid">
      {%- for collection in collections -%}
        {%- if collection.products_count > 0 -%}
          <article class="card">
            <a class="card__media" href="{{ collection.url }}">
              {%- assign img = collection.featured_image | default: collection.products.first.featured_image -%}
              {%- if img -%}
                {{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 600px) 33vw, 100vw' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <div class="card__body">
              <span class="card__eyebrow">{{ collection.products_count }} pieces</span>
              <h3 class="card__title"><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h3>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop by series" }]
}
{% endschema %}
