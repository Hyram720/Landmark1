{%- if section.settings.text != blank -%}
  <div class="announcement">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="color:inherit">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Street-Atelier Flagship · 260 GSM Luxury Bootleg Tees · Live 300-DPI Design Studio" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
