<section class="section">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="columns">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title | escape }}</h3>
          {{ block.settings.text }}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text columns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Heavyweight blanks · Made to order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the mill to the press to your door" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The blanks" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Heavyweight 260 to 450 GSM blanks.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Text columns" }]
}
{% endschema %}
