{%- assign current = product.selected_or_first_available_variant -%}
<div class="wrap product" data-product>
  <div class="product__gallery">
    {%- assign main = current.featured_image | default: product.featured_image -%}
    {%- if main -%}
      {{ main | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1100, 1400', sizes: '(min-width: 860px) 55vw, 100vw', data-main-image: '', alt: main.alt | default: product.title }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- if product.images.size > 1 -%}
      <div class="product__thumbs">
        {%- for image in product.images -%}
          <button type="button" data-thumb="{{ image | image_url: width: 1400 }}" aria-current="{% if image == main %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}">
            {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'title' -%}
          <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
        {%- when 'price' -%}
          <div class="product__price" data-price {{ block.shopify_attributes }}>
            {{ current.price | money }}
            {%- if current.compare_at_price > current.price -%}<s class="muted" style="font-size:18px;margin-left:8px">{{ current.compare_at_price | money }}</s>{%- endif -%}
          </div>
        {%- when 'buy' -%}
          <div {{ block.shopify_attributes }}>
            {%- form 'product', product, data-product-form: '' -%}
              <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
              {%- unless product.has_only_default_variant -%}
                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index -%}
                  <fieldset class="option">
                    <legend>{{ option.name | escape }}</legend>
                    <div class="swatches">
                      {%- for value in option.values -%}
                        {%- assign oid = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index -%}
                        <input type="radio" id="Opt-{{ oid }}" name="option{{ option_index }}" value="{{ value | escape }}" data-option="{{ option_index | minus: 1 }}" {% if option.selected_value == value %}checked{% endif %}>
                        <label for="Opt-{{ oid }}">{{ value | escape }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              {%- endunless -%}

              {%- if product.tags contains 'Customizable' and block.settings.personalize_label != blank -%}
                <div class="field">
                  <label for="Personalize-{{ section.id }}">{{ block.settings.personalize_label | escape }}</label>
                  <input id="Personalize-{{ section.id }}" type="text" maxlength="{{ block.settings.personalize_max }}" name="properties[{{ block.settings.personalize_label | escape }}]" placeholder="{{ 'products.personalize_placeholder' | t }}">
                </div>
              {%- endif -%}

              <div class="field" style="max-width:120px">
                <label for="Qty-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1">
              </div>
              <button class="btn btn--block" type="submit" name="add" data-add-button {% unless current.available %}disabled{% endunless %}>
                {%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
              </button>
              <p class="note">{{ 'products.made_to_order' | t }}</p>
              {{ form | payment_button }}
            {%- endform -%}
          </div>
        {%- when 'description' -%}
          <div class="product__desc rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
        {%- when 'text' -%}
          <p class="note" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
      {%- endcase -%}
    {%- endfor -%}
  </div>
  <script type="application/json" data-product-json>
    {{ product.variants | json }}
  </script>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "sku": {{ variant.sku | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "buy",
      "name": "Options and buy button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "personalize_label", "label": "Personalization field label", "info": "Shown only on products tagged Customizable.", "default": "Side-stripe text" },
        { "type": "range", "id": "personalize_max", "label": "Max characters", "min": 5, "max": 60, "step": 1, "default": 20 }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "text", "name": "Text", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Free returns on size exchanges within 30 days." }] }
  ]
}
{% endschema %}
