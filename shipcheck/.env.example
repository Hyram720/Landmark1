# --- Core ---
BASE_URL=https://shipcheck.dev
BRAND_NAME=ShipCheck
ADMIN_KEY=change-me-to-a-long-random-string
DATA_DIR=/data                     # mount a persistent volume here in production
SUPPORT_EMAIL=
PRICE_REPORT=1900                  # cents

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=                 # the only Stripe value needed: the webhook + promo code are created on boot
STRIPE_WEBHOOK_SECRET=             # optional: only if you created the webhook by hand
RECOVERY_CODE=SHIPIT20
RECOVERY_PERCENT=20
RESCAN_LIMIT=5
RESCAN_DAYS=30

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=ShipCheck <reports@shipcheck.dev>
ALERT_EMAIL=you@example.com        # failures get emailed here
